	{ "FullWall", "Moving", "Door", "Grid", "Spinner", "Double", "ArmoredGlass", "BobbingPane", "FallingPane", "FallingPane" },
	{ "Moving", "Door", "Grid", "Spinner", "Double", "ArmoredGlass", "BobbingPane", "FallingPane", "RingSpinner", "RingSpinner" },
