		TextSize = 11,
		Sub = "",
		Size = UDim2.new(1, 0, 0, 52),
		OnClick = function()
			local now = os.clock()
			if now - (g.lastRevive or 0) > 0.6 then
				g.lastRevive = now
				self:_fire("onRevive")
