      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">ViewmodelRig</string>
          <string name="Source"><![CDATA[--[[
	The arms you see in first person (shared by the server and the client).

	Server (Server/ViewmodelRigs.server.luau): builds one arms model per player
	from a cleaned-up copy of their avatar and puts it in
	ReplicatedStorage.ViewmodelRigs, named by their UserId.
	Client (Client/Viewmodel.luau): clones it for the run and moves the arms with
	the camera.

	A rig is a Model with exactly:
	  "Left Arm", "Right Arm"  plain R6 arm blocks (anchored, no collisions)
	  Humanoid                 needed for the classic Shirt to show on the arms
	  Shirt                    (optional) the player's classic shirt
	  Body Colors              (optional) the player's skin colours
	Anything else is removed by ViewmodelRig.strip, on the server AND again on
	the client, so a strange avatar can never put anything else on screen.

	ViewmodelRig.strip(model) -> boolean   true when both arms are there
	ViewmodelRig.buildDefault(name) -> Model   plain arms in a neutral skin tone
]]

local ViewmodelRig = {}

ViewmodelRig.FOLDER_NAME = "ViewmodelRigs" -- in ReplicatedStorage
ViewmodelRig.ARM_NAMES = { "Left Arm", "Right Arm" }
ViewmodelRig.ARM_SIZE = Vector3.new(1, 2, 1) -- a standard blocky R6 arm
ViewmodelRig.DEFAULT_COLOR = Color3.fromRGB(234, 184, 146) -- neutral skin tone (default rig)

local function isArm(child)
	return child:IsA("BasePart") and (child.Name == "Left Arm" or child.Name == "Right Arm")
end

-- No collisions, no raycasts / touches, no shadows; moved by script only.
function ViewmodelRig.quietPart(part)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
end

-- A Humanoid that only draws clothing: no name tag, health bar, physics or animations.
local function quietHumanoid(humanoid)
	humanoid:ClearAllChildren() -- Animator, HumanoidDescription...
	pcall(function()
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end)
	pcall(function()
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end)
	pcall(function()
		humanoid.RequiresNeck = false
	end)
	pcall(function()
		humanoid.BreakJointsOnDeath = false
	end)
	pcall(function()
		humanoid.AutomaticScalingEnabled = false
	end)
	pcall(function()
		humanoid.EvaluateStateMachine = false
	end)
end

-- Keeps only the two arms, one Humanoid, one Shirt and one Body Colors.
-- Everything else (head, torso, legs, accessories, meshes, scripts, pants...)
-- is destroyed. Returns true when both arms are there.
function ViewmodelRig.strip(model)
	local kept = {}
	for _, child in model:GetChildren() do
		local kind = nil
		if isArm(child) then
			kind = child.Name
		elseif child:IsA("Humanoid") then
			kind = "Humanoid"
		elseif child:IsA("Shirt") then
			kind = "Shirt"
		elseif child:IsA("BodyColors") then
			kind = "BodyColors"
		end
		if kind and not kept[kind] then
			kept[kind] = child
		else
			child:Destroy()
		end
	end

	for _, armName in ViewmodelRig.ARM_NAMES do
		local arm = kept[armName]
		if arm then
			arm:ClearAllChildren() -- attachments, special meshes, decals
			ViewmodelRig.quietPart(arm)
			arm.Transparency = 0
		end
	end
	if kept.Humanoid then
		quietHumanoid(kept.Humanoid)
	end
	local right = kept["Right Arm"]
	if right then
		model.PrimaryPart = right
	end
	return kept["Left Arm"] ~= nil and right ~= nil
end

-- Plain arms in a neutral skin tone, used when the avatar can't be loaded.
function ViewmodelRig.buildDefault(name)
	local model = Instance.new("Model")
	model.Name = name
	for _, armName in ViewmodelRig.ARM_NAMES do
		local arm = Instance.new("Part")
		arm.Name = armName
		arm.Size = ViewmodelRig.ARM_SIZE
		arm.Color = ViewmodelRig.DEFAULT_COLOR
		arm.Material = Enum.Material.SmoothPlastic
		arm.TopSurface = Enum.SurfaceType.Smooth
		arm.BottomSurface = Enum.SurfaceType.Smooth
		ViewmodelRig.quietPart(arm)
		arm.Parent = model
	end
	local humanoid = Instance.new("Humanoid")
	quietHumanoid(humanoid)
	humanoid.Parent = model
	model.PrimaryPart = model:FindFirstChild("Right Arm")
	model:SetAttribute("Default", true)
	return model
end

return ViewmodelRig
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point: player data, run results (gems, XP, missions) and the
	global leaderboard.
	The runs themselves happen on each player's device (see Client/RunController).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Monetization = require(script.Parent.Monetization)
local Progression = require(script.Parent.Progression)
local Shop = require(script.Parent.Shop)

local Remotes = ReplicatedStorage.Remotes

-- Glass shards and knocked-loose decorations (built on each player's device)
-- bounce off the floor and walls but not off each other, which keeps physics
-- cheap. Collision groups must be registered on the server to work everywhere.
pcall(function()
	if not PhysicsService:IsCollisionGroupRegistered("Shards") then
		PhysicsService:RegisterCollisionGroup("Shards")
	end
	PhysicsService:CollisionGroupSetCollidable("Shards", "Shards", false)
end)
local leaderboardStore = DataStoreService:GetOrderedDataStore("BestDistance_v1")

local LEADERBOARD_SIZE = 10
local LEADERBOARD_REFRESH = 60
local MISSION_CHECK_INTERVAL = 30

-- Anti-cheat ------------------------------------------------------------------
-- Highest distance one run can put on the global leaderboard (a sanity cap far
-- above any realistic run).
local MAX_RUN_METERS = 25000
-- A run only counts toward Stats.runs and the "play N runs" mission after this far.
local MIN_COUNTED_RUN_METERS = 50
-- RunEnded reports closer together than this are ignored (spam).
local MIN_RUN_ENDED_GAP = 0.5
-- The fastest a room can be flown through: at top speed, plus 15% for lag.
local MIN_ROOM_SECONDS = Config.ROOM_LENGTH / (Config.MAX_SPEED * 1.15)
-- How far ahead of that pace a player may be, in rooms, so one late network
-- message doesn't block the rest of the run. Waiting can't bank more than this.
local ROOM_LAG_ALLOWANCE = 2

-- Season info for the UI.
ReplicatedStorage:SetAttribute("SeasonName", Config.SEASON_NAME)
ReplicatedStorage:SetAttribute("SeasonEnds", Config.SEASON_ENDS)

-- player -> {
--   startedAt, pausedAt (set while on the game over screen), pausedTotal,
--   startCheckpoint, startMeters, metersRewarded,
--   reported (run stats already paid for), counted (run added to Stats.runs),
--   boosts ({ [boostId] = true } used on this run), doubleGems,
--   meterGems (gems paid for distance on this run, for 2x Gems back pay),
--   midRunBoosts ({ [boostId] = count } turned on by UseBoostNow, for ReturnBoost),
--   shieldsOn / megaBallsOn (Shields / Mega Balls turned on this run, the most
--   ReturnUnusedBoosts can give back), readyOn ({ [boostId] = count } of the
--   Config.BOOST_BAR boosts RunStarted put in the boost bar, the most that can
--   come back untapped), unusedReturned (already given back),
--   lastUnused ({ shield, megaballThrows, readyMagnet, ... } the device reported
--   with its last RunEnded, given back if they leave from the game over screen),
--   lastRoom (last room index accepted from RoomReached), roomClock (active
--   seconds the next room is measured from), pausedMaxStuds (cached time cap
--   while paused), lastEndedAt (os.clock() of the last RunEnded we handled)
-- }
local activeRuns = {}

-- player -> os.clock() when they joined this server (for the "wait! free gift",
-- which needs some real play time first).
local sessionStarts = {}

-- player -> how many RunStarted events they've sent this session. Sent back with
-- BoostsActivated so the client can ignore a confirmation meant for an older run.
local runCounts = {}

-- The furthest anyone can legitimately travel in `seconds`, following the same
-- speeds as the client (Config.speedForRoom: a warm-up from the start room, and a
-- top speed per zone). Once the speed can't change any more (MAX_SPEED reached
-- in the last zone with its own top speed), longer times are a simple multiplication.
-- Worked out once per start checkpoint: { roomTimes, time, studs, finalSpeed }.
local speedRamps = {}

local function speedRamp(startCheckpoint)
	local ramp = speedRamps[startCheckpoint]
	if ramp then
		return ramp
	end
	ramp = { roomTimes = {}, time = 0, studs = 0, finalSpeed = Config.MAX_SPEED }
	local startRoom = startCheckpoint * Config.ROOMS_PER_CHECKPOINT
	-- After this room every zone runs at MAX_SPEED (zones past the ZoneTopSpeed list).
	local lastSpeedZoneRoom = #Config.ZoneTopSpeed * Config.ROOMS_PER_CHECKPOINT
	local room = startRoom
	while true do
		local speed = Config.speedForRoom(room, startRoom)
		if speed >= Config.MAX_SPEED and room >= lastSpeedZoneRoom then
			break
		end
		if #ramp.roomTimes > 2000 then
			ramp.finalSpeed = Config.MAX_SPEED -- safety net (bad Config): assume top speed from here
			break
		end
		local seconds = Config.ROOM_LENGTH / math.max(speed, 1)
		table.insert(ramp.roomTimes, seconds)
		ramp.time += seconds
		ramp.studs += Config.ROOM_LENGTH
		room += 1
	end
	speedRamps[startCheckpoint] = ramp
	return ramp
end

local function maxStudsIn(seconds, startCheckpoint)
	if seconds <= 0 then
		return 0
	end
	local ramp = speedRamp(startCheckpoint)
	if seconds >= ramp.time then
		return ramp.studs + (seconds - ramp.time) * ramp.finalSpeed
	end
	-- Still speeding up: walk the ramp rooms.
	local studs, time = 0, 0
	for _, roomSeconds in ramp.roomTimes do
		if time + roomSeconds >= seconds then
			local speed = Config.ROOM_LENGTH / roomSeconds
			return studs + (seconds - time) * speed
		end
		studs += Config.ROOM_LENGTH
		time += roomSeconds
	end
	return studs
end

local function activeSeconds(run)
	local now = run.pausedAt or os.clock()
	return now - run.startedAt - run.pausedTotal
end

-- Time cap for the run so far. While paused (game over screen) the run's
-- active time can't change, so it's only worked out once.
local function maxStudsForRun(run)
	if run.pausedAt then
		if not run.pausedMaxStuds then
			run.pausedMaxStuds = maxStudsIn(activeSeconds(run), run.startCheckpoint)
		end
		return run.pausedMaxStuds
	end
	return maxStudsIn(activeSeconds(run), run.startCheckpoint)
end

local function pauseRun(run)
	if not run.pausedAt then
		run.pausedAt = os.clock()
		run.pausedMaxStuds = nil
	end
end

local function resumeRun(run)
	if run.pausedAt then
		run.pausedTotal += os.clock() - run.pausedAt
		run.pausedAt = nil
		run.pausedMaxStuds = nil
	end
end

local function createLeaderstats(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local best = Instance.new("IntValue")
	best.Name = "Best"
	best.Parent = leaderstats

	local gems = Instance.new("IntValue")
	gems.Name = "Gems"
	gems.Parent = leaderstats

	leaderstats.Parent = player
end

-- Unused boosts ------------------------------------------------------------------
-- When the run really ends (PLAY AGAIN / MENU from the game over screen without a
-- revive, or leaving the game from there), these go back to the inventory:
--  * a Shield that never absorbed a crash, and a Mega Ball with all its throws left
--    ("your next crash is free" shouldn't vanish because you ran out of balls),
--  * a boost-bar boost (Config.BOOST_BAR: Magnet, Slow-Mo, Mega Ball) the player
--    never tapped.
-- Capped at what this run actually took from the inventory, and only once per run.

-- Reads a whole, non-negative count from a client table (anything else = 0).
local function readCount(source, name)
	local value = if type(source) == "table" then source[name] else nil
	if type(value) ~= "number" or value ~= value or value == math.huge then
		return 0
	end
	return math.max(0, math.floor(value))
end

-- The order refunds are listed in ("Unused boosts saved: 1 SHIELD + 1 MAGNET").
local REFUND_ORDER = { "Shield", "Magnet", "SlowMo", "MegaBall" }

-- A fresh { [boostId] = 0 } for every boost-bar boost.
local function emptyBarCounts()
	local counts = {}
	for _, boostId in Config.BOOST_BAR do
		counts[boostId] = 0
	end
	return counts
end

-- unused = what the device reported (any of these may be missing or junk = 0):
--   shield         - Shields that never absorbed a crash
--   megaballThrows - giant throws left on Mega Balls that were tapped
--   readyMagnet / readySlowMo / readyMegaBall - boost-bar boosts never tapped
-- Gives them back (capped, once per run) and returns { [boostId] = count given back }.
local function refundUnusedBoosts(player, data, run, unused)
	local refunded = {}
	if run.unusedReturned then
		return refunded
	end
	run.unusedReturned = true

	-- Never tapped: no more than RunStarted put in the bar.
	for _, boostId in Config.BOOST_BAR do
		local count = math.min(readCount(unused, "ready" .. boostId), run.readyOn[boostId] or 0)
		run.readyOn[boostId] = (run.readyOn[boostId] or 0) - count
		refunded[boostId] = count
	end

	local shields = math.min(readCount(unused, "shield"), run.shieldsOn)
	run.shieldsOn -= shields
	refunded.Shield = shields

	-- Mega Balls: whole ones with every throw left, plus the untapped ones counted
	-- above, but never more than this run turned on in total.
	local throwsPerMega = math.max(1, Config.Boosts.MegaBall.Throws)
	local megaBalls = math.min(readCount(unused, "megaballThrows") // throwsPerMega + (refunded.MegaBall or 0), run.megaBallsOn)
	run.megaBallsOn -= megaBalls
	refunded.MegaBall = megaBalls

	local any = false
	for boostId, count in refunded do
		if count > 0 then
			Progression.addBoost(data, boostId, count)
			any = true
		end
	end
	if any then
		PlayerData.publish(player, { "Boosts" })
	end
	return refunded
end

local function onPlayerAdded(player)
	sessionStarts[player] = sessionStarts[player] or os.clock()
	createLeaderstats(player)
	PlayerData.load(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	-- Left from the game over screen: give back unused boosts (the device can't
	-- tell us any more, so use what it reported with its last RunEnded).
	local run = activeRuns[player]
	local data = PlayerData.get(player)
	if run and data and run.pausedAt and run.lastUnused then
		refundUnusedBoosts(player, data, run, run.lastUnused)
	end
	activeRuns[player] = nil
	runCounts[player] = nil
	sessionStarts[player] = nil
	Shop.release(player)
	PlayerData.release(player)
end)

game:BindToClose(function()
	-- Roblox gives us up to 30 seconds to finish saving.
	PlayerData.releaseAll(25)
end)

Monetization.init()
Shop.init()
PlayerData.startAutosave()

-- Shop action "UseBoostNow"(boostId): the device asks this right after buying a
-- boost with Robux mid-run (the purchase always goes to the inventory first).
-- Takes one from the inventory and turns it on for the current run.
-- Returns true only if it's on; otherwise it stays in the inventory.
Shop.addAction("UseBoostNow", function(player, data, boostId)
	if not Progression.isBoost(boostId) then
		return false, "That boost doesn't exist"
	end
	local run = activeRuns[player]
	if not run or run.pausedAt then
		return false, "No run going"
	end
	if boostId == "DoubleGems" and run.doubleGems then
		return false, "2x gems is already on" -- can't stack
	end
	if not Progression.takeBoost(data, boostId) then
		return false, "You don't have that boost"
	end
	run.boosts[boostId] = true
	run.midRunBoosts[boostId] = (run.midRunBoosts[boostId] or 0) + 1
	if boostId == "Shield" then
		run.shieldsOn += 1
	elseif boostId == "MegaBall" then
		run.megaBallsOn += 1
	end
	local changed = { "Boosts" }
	if boostId == "DoubleGems" then
		run.doubleGems = true
		-- "Double gems for one run": also pay the extra 1x for the distance of
		-- this run that was already paid (e.g. before a revive). Only this run's
		-- distance gems, and only once (2x can't stack or be turned on twice).
		local backPay = run.meterGems
		if backPay > 0 then
			run.meterGems += backPay
			data.Gems += backPay
			table.insert(changed, "Gems")
			Progression.fire(player, { type = "Reward", text = "2x gems: +" .. backPay .. " for this run so far" })
		end
	end
	PlayerData.publish(player, changed)
	return true
end)

-- Shop action "ReturnBoost"(boostId): UseBoostNow said yes, but by the time the
-- answer reached the device the run had ended. Puts that boost back in the
-- inventory, but only one UseBoostNow really took on this run.
-- 2x Gems can't be returned: it already doubled this run's gems on the server.
Shop.addAction("ReturnBoost", function(player, data, boostId)
	if not Progression.isBoost(boostId) then
		return false, "That boost doesn't exist"
	end
	if boostId == "DoubleGems" then
		return false, "2x gems already counted for this run"
	end
	local run = activeRuns[player]
	local taken = if run then run.midRunBoosts[boostId] or 0 else 0
	if taken < 1 then
		return false, "Nothing to give back"
	end
	-- Already given back by ReturnUnusedBoosts? Then there's nothing left to return.
	if (boostId == "Shield" and run.shieldsOn < 1) or (boostId == "MegaBall" and run.megaBallsOn < 1) then
		return false, "Nothing to give back"
	end
	run.midRunBoosts[boostId] = taken - 1
	if boostId == "Shield" then
		run.shieldsOn = math.max(0, run.shieldsOn - 1)
	elseif boostId == "MegaBall" then
		run.megaBallsOn = math.max(0, run.megaBallsOn - 1)
	end
	Progression.addBoost(data, boostId, 1)
	PlayerData.publish(player, { "Boosts" })
	return true
end)

-- Shop action "BoostTapped"(boostId): a boost-bar boost was tapped on the
-- device, so it no longer counts as "never tapped" for ReturnUnusedBoosts.
Shop.addAction("BoostTapped", function(player, data, boostId)
	local run = activeRuns[player]
	if not run or type(boostId) ~= "string" or (run.readyOn[boostId] or 0) < 1 then
		return false, "Nothing to tap"
	end
	run.readyOn[boostId] -= 1
	return true
end)

-- Shop action "ReturnUnusedBoosts"({ shield = n, megaballThrows = t, readyMagnet = n,
-- readySlowMo = n, readyMegaBall = n }): the device sends this once when a run
-- really ends (PLAY AGAIN or MENU from the game over screen, no revive). Only
-- while the run is stopped at game over, and only once per run (see
-- refundUnusedBoosts for what each field means and the caps).
Shop.addAction("ReturnUnusedBoosts", function(player, data, unused)
	if type(unused) ~= "table" then
		return false, "Bad request"
	end
	local run = activeRuns[player]
	if not run or not run.pausedAt then
		return false, "No finished run"
	end
	if run.unusedReturned then
		return true -- already done for this run
	end
	local refunded = refundUnusedBoosts(player, data, run, unused)
	local parts = {}
	for _, boostId in REFUND_ORDER do
		local count = refunded[boostId] or 0
		if count > 0 then
			table.insert(parts, count .. " " .. Config.Boosts[boostId].Name)
		end
	end
	if #parts > 0 then
		return true, "Unused boosts saved: " .. table.concat(parts, " + ")
	end
	return true
end)

-- Shop action "UseBonusBalls"(amount): the device used balls from a Revive /
-- Ball Pack right away (mid-run or on the game over screen), so they come back
-- out of the saved BonusBalls (see Monetization). Never below zero.
Shop.addAction("UseBonusBalls", function(player, data, amount)
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount == math.huge then
		return false, "Bad amount"
	end
	local used = math.min(math.floor(amount), data.BonusBalls)
	if used > 0 then
		PlayerData.update(player, { BonusBalls = data.BonusBalls - used })
	end
	return true
end)

-- Shop action "RecheckPasses": the menu opened; picks up a game pass bought
-- outside this server. Rate limited in Monetization.
Shop.addAction("RecheckPasses", function(player)
	return Monetization.recheckPasses(player)
end)

-- Shop action "ResumeRun": the device sends this after it has really revived
-- (Revive or ball pack on the game over screen), so the run's clock runs again.
Shop.addAction("ResumeRun", function(player)
	local run = activeRuns[player]
	if not run then
		return false, "No run going"
	end
	resumeRun(run)
	return true
end)

-- Shop action "ClaimLeaveGift": the "wait! free gift" popup's CLAIM button.
-- Progression.claimLeaveGift checks the cooldown and the play time; the client's
-- own check only decides whether to show the popup.
Shop.addAction("ClaimLeaveGift", function(player, data)
	local started = sessionStarts[player]
	local playedSeconds = if started then os.clock() - started else 0
	local ok, message = Progression.claimLeaveGift(data, os.time(), playedSeconds)
	if ok then
		-- Saved by the autosave (publish marks the data as changed).
		PlayerData.publish(player, Progression.LEAVE_GIFT_FIELDS)
		Progression.fire(player, { type = "Reward", text = message, source = "LeaveGift" })
	end
	return ok, message
end)

-- Picks the boosts the player asked for (boostIds, a list of ids) that are real,
-- not repeated and actually owned, up to Config.MAX_BOOSTS_PER_RUN.
local function chooseBoosts(data, boostIds)
	local chosen = {}
	if type(boostIds) ~= "table" then
		return chosen
	end
	for i = 1, Config.MAX_BOOSTS_PER_RUN do
		local boostId = boostIds[i]
		if
			Progression.isBoost(boostId)
			and not table.find(chosen, boostId)
			and Progression.boostCount(data, boostId) >= 1
		then
			table.insert(chosen, boostId)
		end
	end
	return chosen
end

-- RunStarted(startCheckpoint, boostIds?)
-- startCheckpoint lets Checkpoints pass owners skip ahead to a zone they've reached.
-- boostIds: boosts picked from the inventory for this run (older clients send none).
Remotes.RunStarted.OnServerEvent:Connect(function(player, startCheckpoint, boostIds)
	runCounts[player] = (runCounts[player] or 0) + 1
	local data = PlayerData.get(player)
	if not data then
		return
	end

	local checkpoint = 0
	if
		type(startCheckpoint) == "number"
		and startCheckpoint == math.floor(startCheckpoint)
		and startCheckpoint > 0
		and startCheckpoint <= data.Checkpoint
		and Monetization.ownsPass(player, "Checkpoints")
	then
		checkpoint = startCheckpoint
	end

	local startMeters = math.floor(Config.checkpointMeters(checkpoint))
	local run = {
		startedAt = os.clock(),
		pausedAt = nil,
		pausedTotal = 0,
		startCheckpoint = checkpoint,
		startMeters = startMeters,
		metersRewarded = startMeters, -- no gems for the part you skipped
		reported = { glass = 0, crystals = 0, props = 0, maxMultiball = 0 },
		counted = false,
		boosts = {},
		doubleGems = false,
		meterGems = 0,
		midRunBoosts = {},
		shieldsOn = 0,
		megaBallsOn = 0,
		readyOn = emptyBarCounts(),
		unusedReturned = false,
		lastUnused = nil,
		lastRoom = checkpoint * Config.ROOMS_PER_CHECKPOINT, -- the room the run starts in
		roomClock = 0,
		pausedMaxStuds = nil,
		lastEndedAt = nil,
	}
	activeRuns[player] = run

	-- Bonus balls (from the daily streak) go into this run. The client already
	-- read the attribute when it started the run.
	if data.BonusBalls > 0 then
		PlayerData.update(player, { BonusBalls = 0 })
	end

	-- Boosts: use up one of each, then tell the client which ones really started
	-- (it only turns on what we confirm here). Shield and 2x Gems work by
	-- themselves; boost-bar boosts (Config.BOOST_BAR) wait until the player taps
	-- them, and come back with ReturnUnusedBoosts if they never do.
	local used = {}
	for _, boostId in chooseBoosts(data, boostIds) do
		if Progression.takeBoost(data, boostId) then
			table.insert(used, boostId)
			run.boosts[boostId] = true
			if boostId == "DoubleGems" then
				run.doubleGems = true
			elseif boostId == "Shield" then
				run.shieldsOn += 1
			elseif boostId == "MegaBall" then
				run.megaBallsOn += 1
			end
			if run.readyOn[boostId] then
				run.readyOn[boostId] += 1
			end
		end
	end
	if #used > 0 then
		PlayerData.publish(player, { "Boosts" })
		Progression.fire(player, { type = "BoostsActivated", boosts = used, run = runCounts[player] })
		-- Saved by the autosave (publish marked the data as changed).
	end
end)

-- RoomReached(roomIndex): sent each time the player's camera enters a new room.
-- Rooms must come in order, and no faster than top speed allows (counting only
-- time actually running). RunEnded then pays at most up to the last accepted room.
Remotes.RoomReached.OnServerEvent:Connect(function(player, roomIndex)
	local run = activeRuns[player]
	if not run or type(roomIndex) ~= "number" or roomIndex ~= math.floor(roomIndex) then
		return -- not a whole number (NaN fails this too)
	end
	if roomIndex ~= run.lastRoom + 1 then
		return
	end
	local now = activeSeconds(run)
	local earliest = run.roomClock + MIN_ROOM_SECONDS
	if now < earliest then
		return -- too fast: ignore it (no kick; lag can cause the odd one)
	end
	run.lastRoom = roomIndex
	-- Measure the next room from here, but let a player who is slower than top
	-- speed be up to ROOM_LAG_ALLOWANCE rooms "ahead", so a late message
	-- followed by an on-time one still gets through.
	run.roomClock = math.max(earliest, now - ROOM_LAG_ALLOWANCE * MIN_ROOM_SECONDS)
end)

-- Reads one number from the client's run stats, clamped to what's possible.
local function readStat(runStats, name, maximum)
	local value = runStats[name]
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, math.max(0, math.floor(maximum)))
end

local function gemMultiplier(player)
	local multiplier = 1
	if Monetization.ownsPass(player, "VIP") then
		multiplier = Config.GamePasses.VIP.GemMultiplier
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		multiplier *= 1 + Config.PREMIUM_GEM_BONUS
	end
	return multiplier
end

local function updateLeaderboard(player, meters)
	local ok, err = pcall(leaderboardStore.UpdateAsync, leaderboardStore, tostring(player.UserId), function(old)
		if old and old >= meters then
			return nil -- keep the higher score already stored
		end
		return meters
	end)
	if not ok then
		warn("Could not update leaderboard:", err)
	end
end

-- Sent at every game over: RunEnded(meters, runStats).
-- runStats = { glass, crystals, props, maxMultiball }, counted from the start of
-- the run. A revive continues the same run and reports again with bigger
-- numbers, so we only pay out what was added since the last report.
Remotes.RunEnded.OnServerEvent:Connect(function(player, meters, runStats)
	local run = activeRuns[player]
	local data = PlayerData.get(player)
	if not run or not data or type(meters) ~= "number" or meters ~= meters then
		return
	end
	local now = os.clock()
	if run.lastEndedAt and now - run.lastEndedAt < MIN_RUN_ENDED_GAP then
		return -- spam
	end
	run.lastEndedAt = now
	if type(runStats) ~= "table" then
		runStats = {}
	end
	-- Shields / Mega Ball throws still unused and boost-bar boosts never tapped at
	-- this game over (given back if they leave from the game over screen; see
	-- PlayerRemoving). Same fields as a ReturnUnusedBoosts request.
	local lastUnused = {
		shield = readCount(runStats, "unusedShield"),
		megaballThrows = readCount(runStats, "unusedMegaThrows"),
	}
	for _, boostId in Config.BOOST_BAR do
		lastUnused["ready" .. boostId] = readCount(runStats, "ready" .. boostId)
	end
	run.lastUnused = lastUnused

	-- Anti-cheat: the distance is the smallest of
	--  * what the device says,
	--  * how far the speed ramp allows in the time they actually spent running
	--    (time on the game over screen doesn't count),
	--  * the end of the last room the server accepted from RoomReached.
	pauseRun(run)
	local timeCap = run.startMeters + maxStudsForRun(run) / Config.STUDS_PER_METER * 1.1 + 15
	local roomCap = (run.lastRoom + 1) * Config.ROOM_LENGTH / Config.STUDS_PER_METER
	meters = math.clamp(math.floor(meters), 0, math.floor(math.min(timeCap, roomCap)))

	local newMeters = math.max(0, meters - run.metersRewarded)
	run.metersRewarded = math.max(run.metersRewarded, meters)

	-- Run stats, capped by how many rooms they really flew through
	-- (+2 because balls reach rooms ahead of the camera).
	local flownMeters = math.max(0, meters - run.startMeters)
	local rooms = flownMeters * Config.STUDS_PER_METER // Config.ROOM_LENGTH + 2
	local crystals = readStat(runStats, "crystals", rooms * 2 + 5)
	local minimumMultiball = if Monetization.ownsPass(player, "Multiball") then 2 else 1
	local maxMultiballPossible = math.min(
		Config.MAX_MULTIBALL,
		minimumMultiball + crystals // Config.CRYSTALS_PER_MULTIBALL_LEVEL
	)
	local stats = {
		glass = readStat(runStats, "glass", rooms * 12 + 20),
		crystals = crystals,
		props = readStat(runStats, "props", rooms * 10 + 10),
		maxMultiball = readStat(runStats, "maxMultiball", maxMultiballPossible),
	}

	local deltas = {}
	for name, value in stats do
		deltas[name] = math.max(0, value - run.reported[name])
		run.reported[name] = math.max(run.reported[name], value)
	end
	-- Only a real attempt counts as a run (not tapping PLAY then MENU).
	deltas.runs = 0
	if not run.counted and flownMeters >= MIN_COUNTED_RUN_METERS then
		deltas.runs = 1
		run.counted = true
	end

	-- Gems and XP for what was added since the last report.
	local multiplier = gemMultiplier(player)
	if run.doubleGems then
		multiplier *= 2 -- DoubleGems boost
	end
	local gemsEarned = math.floor(newMeters * Config.GEMS_PER_METER * multiplier)
	run.meterGems += gemsEarned
	local xp = Config.XP
	local xpEarned = math.floor(
		newMeters * xp.PerMeter
			+ deltas.glass * xp.PerGlass
			+ deltas.crystals * xp.PerCrystal
			+ deltas.props * xp.PerProp
	)

	-- Zone counts for missions only if they actually flew into it.
	local reachedZone = math.floor(meters / Config.checkpointMeters(1))
	local best = {
		bestZone = if reachedZone > run.startCheckpoint then reachedZone else 0,
		bestRunMeters = flownMeters,
		bestMultiball = run.reported.maxMultiball,
	}

	local missionsReset = Progression.refreshMissions(data, os.time())
	local completed = Progression.trackRun(data, deltas, best)

	local levelBefore = data.Level
	data.Gems += gemsEarned
	local events = Progression.addXP(data, xpEarned)

	local changed = { "Stats", "Missions" }
	if missionsReset then
		changed = { "Stats", "Missions", "MissionRerolls", "MissionsReset" }
	end
	PlayerData.publish(player, changed)
	PlayerData.publish(player, Progression.XP_FIELDS)

	local changes = {}
	if reachedZone > data.Checkpoint then
		changes.Checkpoint = reachedZone
	end

	-- First-time zone rewards (Config.ZoneRewards), only for zones flown into on
	-- this run. Saved in ZonesRewarded so each one is given once.
	local zoneRewards = Progression.grantZoneRewards(data, run.startCheckpoint, reachedZone)
	if #zoneRewards > 0 then
		PlayerData.publish(player, Progression.REWARD_FIELDS)
	end

	-- Personal best + global leaderboard only count runs from the very start,
	-- so a Checkpoints pass can't buy a higher score.
	-- One run can never put more than MAX_RUN_METERS on the board.
	if run.startCheckpoint == 0 and meters > data.Best then
		changes.Best = meters
		-- Skip if their data didn't load: their real best is unknown.
		if PlayerData.canSave(player) then
			task.spawn(updateLeaderboard, player, math.min(meters, MAX_RUN_METERS))
		end
	end
	PlayerData.update(player, changes)

	for _, text in completed do
		Progression.fire(player, { type = "MissionComplete", text = text })
	end
	for _, event in events do
		Progression.fire(player, event)
	end
	for _, text in zoneRewards do
		Progression.fire(player, { type = "Reward", text = text, source = "Zone" })
	end
	Progression.fire(player, {
		type = "RunSummary",
		xp = xpEarned,
		gems = gemsEarned,
		levelBefore = levelBefore,
		levelAfter = data.Level,
		missionsCompleted = #completed,
	})
end)

-- New daily missions at midnight UTC, even for players who stay in the game.
task.spawn(function()
	while true do
		task.wait(MISSION_CHECK_INTERVAL)
		local now = os.time()
		PlayerData.forEach(function(player, data)
			if Progression.refreshMissions(data, now) then
				PlayerData.publish(player, Progression.MISSION_FIELDS)
			end
		end)
	end
end)

-- Global leaderboard ---------------------------------------------------------

local nameCache = {}

local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok then
		nameCache[userId] = name
		return name
	end
	return "???"
end

local function refreshLeaderboard()
	local ok, pages = pcall(leaderboardStore.GetSortedAsync, leaderboardStore, false, LEADERBOARD_SIZE)
	if not ok then
		warn("Could not load leaderboard:", pages)
		return
	end

	local top = {}
	for rank, entry in pages:GetCurrentPage() do
		table.insert(top, {
			rank = rank,
			name = getName(tonumber(entry.key)),
			meters = entry.value,
		})
	end
	ReplicatedStorage:SetAttribute("TopRuns", HttpService:JSONEncode(top))
end

task.spawn(function()
	while true do
		refreshLeaderboard()
		task.wait(LEADERBOARD_REFRESH)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">ModelLoader</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Loads the uploaded Blender models (Config.Models) into
	ReplicatedStorage.ModelLibrary so every player's device can clone them.
	Premium ball models (Config.BallModels) go into ModelLibrary.Balls.
	Models must be owned by the same account/group that owns the game.
]]

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local library = Instance.new("Folder")
library.Name = "ModelLibrary"
library.Parent = ReplicatedStorage

local balls = Instance.new("Folder")
balls.Name = "Balls"
balls.Parent = library

-- Loads one model asset (in its own thread) and puts it in `folder` as `name`.
local function load(folder, name, assetId)
	if assetId == 0 then
		return
	end
	task.spawn(function()
		local ok, container = pcall(InsertService.LoadAsset, InsertService, assetId)
		if not ok then
			warn("Could not load model", name, assetId, container)
			return
		end

		-- LoadAsset wraps the asset in a Model; unwrap a single inner Model.
		local model = container
		local children = container:GetChildren()
		if #children == 1 and children[1]:IsA("Model") then
			model = children[1]
			model.Parent = nil
			container:Destroy()
		end

		model.Name = name
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
		model.Parent = folder
	end)
end

for name, assetId in Config.Models do
	load(library, name, assetId)
end
for name, assetId in Config.BallModels or {} do
	load(balls, name, assetId)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--[[
	Game passes and developer products.
	IDs come from Shared/Config. Anything with an ID of 0 is ignored.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Progression = require(script.Parent.Progression)

local Remotes = ReplicatedStorage.Remotes

local Monetization = {}

-- Gems given instead when a StreakSaver is bought while the streak is fine.
-- Never less than the same Robux buys as gems (Gem Top-Up: 150 gems for ~15 R$).
local STREAK_SAVER_FALLBACK_GEMS = 150
-- Gems given instead when Season Premium is bought by someone who already has it
-- this season (e.g. bought while their save was still loading). Worth ~199 R$.
local SEASON_PREMIUM_FALLBACK_GEMS = 3200

-- Game pass ownership checks (UserOwnsGamePassAsync) sometimes fail (throttling,
-- web outages), so each one is tried a few times before giving up.
local PASS_CHECK_ATTEMPTS = 4
local PASS_CHECK_WAIT = 2 -- seconds; doubles after each failed try
-- The "RecheckPasses" shop action (menu opened) runs at most this often per player.
local RECHECK_PASSES_COOLDOWN = 60

-- Products with their own rules. Boosts, balls and gem packs are below.
-- Every product is recorded in the save here; the device is also told with
-- PurchaseGranted (balls / boosts can then be used right away mid-run).
-- These must not yield: they run inside ProcessReceipt.
local serverRewards = {
	-- One-time offer. If it's somehow bought twice, the gems are still given
	-- (the skin and effect are already owned), so a purchase is never wasted.
	StarterPack = function(player, data)
		local product = Config.Products.StarterPack
		if data.StarterPackBought then
			-- Bought again (e.g. while their save was loading): the items are
			-- already theirs, so say clearly that the gems are what they got.
			data.Gems += product.Gems
			PlayerData.publish(player, { "Gems" })
			Progression.fire(player, {
				type = "Reward",
				text = "YOU ALREADY OWNED THE STARTER ITEMS: +" .. product.Gems .. " GEMS",
			})
			return
		end
		local text = Progression.grantReward(data, { Gems = product.Gems, Skin = product.Skin, Fx = product.Fx })
		data.StarterPackBought = true
		PlayerData.publish(player, Progression.REWARD_FIELDS)
		PlayerData.publish(player, { "StarterPackBought" })
		Progression.fire(player, { type = "Reward", text = "Starter pack: " .. text })
	end,

	-- Unlocks the premium track of the current season (tiers already reached
	-- become claimable right away).
	-- Already premium this season (bought twice, or while the save was loading):
	-- they get SEASON_PREMIUM_FALLBACK_GEMS instead, so the purchase isn't wasted.
	SeasonPremium = function(player, data)
		Progression.ensureSeason(data)
		if data.SeasonPremium then
			data.Gems += SEASON_PREMIUM_FALLBACK_GEMS
			PlayerData.publish(player, { "Gems" })
			Progression.fire(player, {
				type = "Reward",
				text = "YOU ALREADY HAD PREMIUM: +" .. SEASON_PREMIUM_FALLBACK_GEMS .. " GEMS INSTEAD",
			})
			return
		end
		data.SeasonPremium = true
		PlayerData.publish(player, { "SeasonId", "SeasonTier", "SeasonXP", "SeasonClaimed", "SeasonPremium" })
		Progression.fire(player, { type = "Reward", text = "Premium season pass unlocked" })
	end,

	-- +1 mission reroll. Bought rerolls don't expire at midnight.
	ExtraReroll = function(player, data)
		if Progression.refreshMissions(data, os.time()) then
			PlayerData.publish(player, Progression.MISSION_FIELDS)
		end
		data.ExtraRerolls += 1
		data.MissionRerolls += 1
		PlayerData.publish(player, { "MissionRerolls", "ExtraRerolls" })
		Progression.fire(player, { type = "Reward", text = "+1 mission reroll" })
	end,

	-- Keeps a broken login streak going. If it wasn't broken (bought twice, or
	-- the client was out of date) they get gems instead: a purchase is never wasted.
	StreakSaver = function(player, data)
		local now = os.time()
		if Progression.saveStreak(data, now) then
			PlayerData.publish(player, Progression.DAILY_FIELDS)
			Progression.fire(player, { type = "Reward", text = "Streak saved: day " .. data.StreakDay .. " is waiting" })
		else
			data.Gems += STREAK_SAVER_FALLBACK_GEMS
			PlayerData.publish(player, { "Gems" })
			Progression.fire(player, {
				type = "Reward",
				text = "Your streak was safe: +" .. STREAK_SAVER_FALLBACK_GEMS .. " gems instead",
			})
		end
	end,
}

-- Boost products (BoostShield, BoostMagnet...): always go to the inventory.
-- If the player is mid-run, their device then asks to use it right away with
-- the "UseBoostNow" shop action (only the device knows for sure that it's running).
local function boostReward(boostId)
	return function(player, data)
		Progression.addBoost(data, boostId, 1)
		PlayerData.publish(player, { "Boosts" })
	end
end

-- Ball products (Revive, BallPack): the balls are always saved first as
-- BonusBalls, so they can never be lost (the player leaves, the purchase finishes
-- after a rejoin, the device is back in the menu...). If the device is mid-run or
-- on the game over screen it uses them right away and takes them back out with
-- the "UseBonusBalls" shop action; otherwise the next run starts with them.
local function ballsReward(amount)
	return function(player, data)
		data.BonusBalls += amount
		PlayerData.publish(player, { "BonusBalls" })
	end
end

-- Premium ball products (BallSupernova...): the ball is theirs forever and is
-- equipped right away. Already owned (bought twice, e.g. while an earlier save
-- failed)? They get gems worth what they really paid instead (receipt.CurrencySpent,
-- which follows regional pricing and Creator Hub price changes; Config's Robux is
-- only the fallback, e.g. for Studio test purchases that spend 0), so a purchase
-- is never wasted.
local function premiumBallReward(skin)
	return function(player, data, receipt)
		local name = string.upper(skin.Name)
		if Progression.ownsSkin(data, skin.Id) then
			local spent = tonumber(receipt and receipt.CurrencySpent)
			local robux = if spent and spent > 0 then spent else (tonumber(skin.Robux) or 0)
			local gems = math.floor(robux * Config.PREMIUM_BALL_REFUND_GEMS_PER_ROBUX)
			data.Gems += gems
			PlayerData.publish(player, { "Gems" })
			Progression.fire(player, {
				type = "Reward",
				text = "YOU ALREADY OWN " .. name .. ": +" .. gems .. " GEMS INSTEAD",
			})
			return
		end
		table.insert(data.OwnedSkins, skin.Id)
		data.EquippedSkin = skin.Id
		PlayerData.publish(player, { "OwnedSkins", "EquippedSkin" })
		Progression.fire(player, { type = "Reward", text = name .. " BALL UNLOCKED AND EQUIPPED" })
	end
end

-- Plain gem packs (GemPack, GemPackMedium, GemPackLarge...): any product with
-- Gems that has no special handler above.
local function rewardFor(productKey, product)
	if serverRewards[productKey] then
		return serverRewards[productKey]
	end
	if product.Skin then
		local skin = Progression.findSkin(product.Skin)
		if skin and skin.Premium then
			return premiumBallReward(skin)
		end
		warn("Product", productKey, "sells an unknown premium ball:", product.Skin)
		return nil
	end
	if product.Boost and Progression.isBoost(product.Boost) then
		return boostReward(product.Boost)
	end
	if type(product.Balls) == "number" and product.Balls > 0 then
		return ballsReward(math.floor(product.Balls))
	end
	if product.Gems then
		return function(player, data)
			data.Gems += product.Gems
			PlayerData.publish(player, { "Gems" })
		end
	end
	return nil
end

function Monetization.ownsPass(player, passKey)
	return player:GetAttribute("Pass_" .. passKey) == true
end

-- Asks Roblox whether the player owns one pass, retrying a failed call a few
-- times (with growing waits) so a hiccup doesn't hide a pass they paid for.
-- Yields. Sets Pass_<Key> when they own it.
local function checkPass(player, passKey, pass)
	local wait = PASS_CHECK_WAIT
	for attempt = 1, PASS_CHECK_ATTEMPTS do
		if not player.Parent or Monetization.ownsPass(player, passKey) then
			return
		end
		local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
		if ok then
			if owns then
				player:SetAttribute("Pass_" .. passKey, true)
			end
			return
		end
		warn("Could not check pass", passKey, "for", player.Name, "attempt", attempt, owns)
		if attempt < PASS_CHECK_ATTEMPTS then
			task.wait(wait)
			wait *= 2
		end
	end
end

-- Checks every pass the player doesn't have yet (each one in its own thread,
-- so one slow check doesn't hold up the others).
local function checkPasses(player)
	for passKey, pass in Config.GamePasses do
		if pass.Id ~= 0 and not Monetization.ownsPass(player, passKey) then
			task.spawn(checkPass, player, passKey, pass)
		end
	end
end

-- player -> os.clock() of the last "RecheckPasses".
local lastRecheck = {}

-- Shop action "RecheckPasses" (the menu opened): picks up a pass bought outside
-- this server (website, another server) without rejoining. At most once every
-- RECHECK_PASSES_COOLDOWN seconds per player. Doesn't yield (the checks run in
-- the background and set Pass_<Key> when they finish).
function Monetization.recheckPasses(player)
	local now = os.clock()
	local last = lastRecheck[player]
	if last and now - last < RECHECK_PASSES_COOLDOWN then
		return false, "Checked recently"
	end
	lastRecheck[player] = now
	checkPasses(player)
	return true
end

-- Roblox calls this for every developer product purchase, and keeps retrying
-- until we return PurchaseGranted. Each PurchaseId is only ever paid out once.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not PlayerData.get(player) then
		-- Not here (or still loading). Roblox will retry later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not PlayerData.canSave(player) then
		-- Their data failed to load, so we couldn't keep a record of this. Try again later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Already paid out earlier in this session (an earlier save failed): just retry the save.
	if PlayerData.hasReceipt(player, receipt.PurchaseId) then
		return if PlayerData.save(player)
			then Enum.ProductPurchaseDecision.PurchaseGranted
			else Enum.ProductPurchaseDecision.NotProcessedYet
	end

	for productKey, product in Config.Products do
		if product.Id ~= 0 and product.Id == receipt.ProductId then
			local reward = rewardFor(productKey, product)
			if reward then
				reward(player, PlayerData.get(player), receipt)
			end
			PlayerData.addReceipt(player, receipt.PurchaseId)

			-- Deliver right away so the player isn't left waiting on a slow DataStore.
			-- (A revive no longer restarts the run's clock here: the device sends
			-- the "ResumeRun" shop action once it has really revived.)
			Remotes.PurchaseGranted:FireClient(player, productKey)

			-- Only tell Roblox we're done once the receipt is safely saved (purchases are
			-- the one thing saved right away instead of by the autosave).
			-- If the save fails, Roblox retries and hasReceipt() above stops a double payout.
			return if PlayerData.save(player)
				then Enum.ProductPurchaseDecision.PurchaseGranted
				else Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end

	warn("Unknown product purchased:", receipt.ProductId)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function Monetization.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		for passKey, pass in Config.GamePasses do
			if pass.Id ~= 0 and pass.Id == passId then
				if purchased then
					player:SetAttribute("Pass_" .. passKey, true)
				else
					-- Not bought now, but maybe they already own it and our check on
					-- join failed (Roblox then says "you already own this").
					-- Checking again turns it on right away.
					task.spawn(checkPass, player, passKey, pass)
				end
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		task.spawn(checkPasses, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRecheck[player] = nil
	end)
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	Loads and saves each player's progress (best distance, gems, skins, level,
	missions, season pass...).
	Note: DataStores only work in Studio if "Enable Studio Access to
	API Services" is turned on in Game Settings > Security.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Progression = require(script.Parent.Progression)

local PlayerData = {}

local store = DataStoreService:GetDataStore("PlayerData_v1")

local LOAD_ATTEMPTS = 3
-- Changed profiles are saved about once a minute (spread out over the minute),
-- instead of after every action: DataStores only allow so many writes.
local AUTOSAVE_INTERVAL = 60
local MAX_RECEIPTS = 50 -- remembered purchase IDs, so a retried receipt is never paid twice

-- Every new field needs a default here. Old saves get missing fields filled in.
local DEFAULT_DATA = {
	Best = 0, -- meters (only runs started from the beginning count)
	Gems = 0,
	Checkpoint = 0, -- highest zone reached
	-- ZoneLength: rooms per zone the save's Checkpoint is counted in (missing in old
	-- 10-room saves; Progression.migrateZoneLength converts them once and sets it).
	OwnedSkins = { "Default" },
	EquippedSkin = "Default",
	OwnedFx = { "Classic" },
	EquippedFx = "Classic",
	Receipts = {}, -- recent developer product PurchaseIds

	-- Player level
	Level = 1,
	XP = 0, -- progress inside the current level
	Stats = {
		glass = 0,
		crystals = 0,
		props = 0,
		runs = 0,
		bestZone = 0,
		bestRunMeters = 0,
		bestMultiball = 0,
	},

	-- Daily missions: { { id, progress, claimed } }
	Missions = {},
	MissionRerolls = Config.MISSION_REROLLS_PER_DAY, -- left today (includes ExtraRerolls)
	ExtraRerolls = 0, -- bought with the ExtraReroll product; they don't expire at midnight
	MissionsReset = 0, -- os.time() of the next refresh

	-- Daily login streak
	StreakDay = 1, -- which Config.DailyStreak entry the next claim gives
	NextDaily = 0, -- os.time() when the daily reward can be claimed again
	StreakExpires = 0, -- claiming after this restarts at day 1

	-- Season pass
	SeasonId = Config.SEASON_ID,
	SeasonTier = 0,
	SeasonXP = 0,
	SeasonPremium = false,
	SeasonClaimed = { free = {}, premium = {} },

	StarterPackBought = false,
	-- Added to the next run: daily streak balls, and Revive / Ball Pack balls
	-- (saved here first so a purchase can never be lost; the device takes them
	-- back out with "UseBonusBalls" when it uses them right away).
	BonusBalls = 0,
	Boosts = {}, -- { [boostId] = count }: welcome gift, level ups, streak, season, shop
	WelcomeGiven = false, -- the one-time Config.WELCOME_BOOSTS gift was given
	Settings = table.clone(Config.DefaultSettings), -- volume, vibration, graphics...
	TutorialDone = false, -- finished or skipped the first-run tutorial
	Hints = {}, -- first-time tips already shown (keys of Config.Hints)

	-- "Wait! Free gift" (Config.LeaveGift)
	LeaveGiftNext = 0, -- os.time() when the gift can be claimed again
	LeaveGiftIndex = 0, -- which Config.LeaveGift.Rewards entry is next (counts from 0, cycles)
}

-- player -> {
--   data = {...}, canSave = bool,
--   dirty = bool (changed since the last save started),
--   saving = bool (a save is running right now), released = bool
-- }
local profiles = {}
local pendingSaves = 0

local function key(player)
	return "player_" .. player.UserId
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function isDictionary(t)
	return next(t) ~= nil and #t == 0
end

-- Defaults + whatever was saved. A saved value of the wrong type is ignored,
-- and dictionaries (like Stats) get any missing keys filled in.
local function merge(defaults, saved)
	local data = deepCopy(defaults)
	if type(saved) ~= "table" then
		return data
	end
	for field, value in saved do
		local default = defaults[field]
		if default == nil then
			data[field] = deepCopy(value) -- unknown field: keep it as-is
		elseif type(value) == type(default) then
			if type(default) == "table" and isDictionary(default) then
				data[field] = merge(default, value)
			else
				data[field] = deepCopy(value)
			end
		end
	end
	return data
end

-- Publishing: attributes replicate to the client, which is how the UI reads progress.
-- Only the fields that changed are published, so JSON is only encoded when needed.

local function setJson(player, name, value)
	player:SetAttribute(name, HttpService:JSONEncode(value))
end

local publishers = {
	Best = function(player, data)
		player:SetAttribute("Best", data.Best)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			leaderstats.Best.Value = data.Best
		end
	end,
	Gems = function(player, data)
		player:SetAttribute("Gems", data.Gems)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			leaderstats.Gems.Value = data.Gems
		end
	end,
	Level = function(player, data)
		player:SetAttribute("Level", data.Level)
		player:SetAttribute("XPNeeded", Config.xpForLevel(data.Level))
	end,
	OwnedSkins = function(player, data)
		setJson(player, "OwnedSkins", data.OwnedSkins)
	end,
	OwnedFx = function(player, data)
		setJson(player, "OwnedFx", data.OwnedFx)
	end,
	Stats = function(player, data)
		setJson(player, "Stats", data.Stats)
	end,
	Boosts = function(player, data)
		setJson(player, "Boosts", data.Boosts)
	end,
	Settings = function(player, data)
		setJson(player, "Settings", data.Settings)
	end,
	Hints = function(player, data)
		setJson(player, "Hints", data.Hints)
	end,
	SeasonClaimed = function(player, data)
		setJson(player, "SeasonClaimed", data.SeasonClaimed)
	end,
	Missions = function(player, data)
		setJson(player, "Missions", Progression.publicMissions(data))
	end,
	Receipts = function() end, -- private
}

-- Plain number/bool/string fields are copied straight to an attribute.
local function publishField(player, data, field)
	local publisher = publishers[field]
	if publisher then
		publisher(player, data)
	elseif DEFAULT_DATA[field] ~= nil and type(data[field]) ~= "table" then
		player:SetAttribute(field, data[field])
	end
end

local function publishAll(player, data)
	for field in DEFAULT_DATA do
		publishField(player, data, field)
	end
end

local function defaultData()
	return deepCopy(DEFAULT_DATA)
end

function PlayerData.load(player)
	local ok, saved
	for attempt = 1, LOAD_ATTEMPTS do
		ok, saved = pcall(store.GetAsync, store, key(player))
		if ok then
			break
		end
		warn("Could not load data for", player.Name, "attempt", attempt, saved)
		task.wait(attempt * 2)
	end
	if not player.Parent then
		return -- left while we were loading
	end

	local data = if ok then merge(DEFAULT_DATA, saved) else defaultData()
	Progression.normalize(data, os.time())
	-- Players from before the tutorial existed already know how to play.
	if type(saved) == "table" and saved.TutorialDone == nil and data.Stats.runs > 0 then
		data.TutorialDone = true
	end

	-- If loading failed we never save, so we can't wipe their real data.
	profiles[player] = { data = data, canSave = ok, dirty = false, saving = false }
	publishAll(player, data)
	-- Tells the UI whether it's safe to sell things. Robux buttons stay off until
	-- DataLoaded is true; DataFailed shows "your save didn't load - rejoin".
	-- Set after publishAll, so every other attribute is already there.
	player:SetAttribute("DataFailed", not ok)
	player:SetAttribute("DataLoaded", ok)
end

function PlayerData.get(player)
	local profile = profiles[player]
	return profile and profile.data
end

function PlayerData.canSave(player)
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

-- Marks the player's data as changed, so the next autosave writes it.
-- update/publish/addReceipt do this for you.
function PlayerData.markDirty(player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
	end
end

-- Sets fields and sends them to the client.
function PlayerData.update(player, changes)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.dirty = true
	for field, value in changes do
		profile.data[field] = value
	end
	for field in changes do
		publishField(player, profile.data, field)
	end
end

-- Sends fields to the client after changing the data table directly.
-- fields: a list of field names, e.g. { "Gems", "OwnedSkins" }.
function PlayerData.publish(player, fields)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.dirty = true
	for _, field in fields do
		publishField(player, profile.data, field)
	end
end

function PlayerData.hasReceipt(player, purchaseId)
	local data = PlayerData.get(player)
	return data ~= nil and table.find(data.Receipts, purchaseId) ~= nil
end

function PlayerData.addReceipt(player, purchaseId)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	PlayerData.markDirty(player)
end

-- Returns true only if the data (as it is right now) really reached the DataStore.
-- Only one save per player runs at a time: if one is already running we wait
-- for it, and only save again if something changed after it started.
function PlayerData.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return false
	end

	pendingSaves += 1
	while profile.saving do
		task.wait(0.1)
	end
	if profile.lastSaveOk and not profile.dirty then
		-- The save we waited for already included every change.
		pendingSaves -= 1
		return true
	end

	profile.saving = true
	profile.dirty = false -- changes from now on need another save
	local ok, err = pcall(store.SetAsync, store, key(player), profile.data, { player.UserId })
	profile.saving = false
	profile.lastSaveOk = ok
	pendingSaves -= 1

	if not ok then
		profile.dirty = true -- try again next time
		warn("Could not save data for", player.Name, err)
	end
	return ok
end

function PlayerData.release(player)
	local profile = profiles[player]
	if not profile or profile.released then
		return
	end
	profile.released = true
	profile.dirty = true -- always write once more when they leave
	PlayerData.save(player)
	profiles[player] = nil
end

-- Used when the server shuts down: saves everyone and waits until done.
function PlayerData.releaseAll(timeout)
	for player in profiles do
		task.spawn(PlayerData.release, player)
	end
	local deadline = os.clock() + timeout
	task.wait()
	while pendingSaves > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Saves changed profiles every AUTOSAVE_INTERVAL seconds, spread out over the
-- interval so all players don't hit the DataStore at the same moment.
-- Started once by Main.
local autosaveStarted = false
function PlayerData.startAutosave()
	if autosaveStarted then
		return
	end
	autosaveStarted = true
	task.spawn(function()
		while true do
			local due = {}
			for player, profile in profiles do
				if profile.dirty and profile.canSave and not profile.released and not profile.saving then
					table.insert(due, player)
				end
			end
			if #due == 0 then
				task.wait(AUTOSAVE_INTERVAL)
			else
				local gap = AUTOSAVE_INTERVAL / #due
				for _, player in due do
					local profile = profiles[player]
					if profile and profile.dirty and not profile.released then
						task.spawn(PlayerData.save, player)
					end
					task.wait(gap)
				end
			end
		end
	end)
end

-- Calls fn(player, data) for everyone whose data is loaded.
function PlayerData.forEach(fn)
	for player, profile in profiles do
		if not profile.released then
			fn(player, profile.data)
		end
	end
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--[[
	Progression rules: player levels, the season pass, daily missions and
	rewards. Works directly on a player's data table (from PlayerData) and
	returns what happened, so the caller can publish + save.

	Nothing in here talks to the DataStore. Progression.fire sends a
	Progress event to the player's screen (level up, mission done...).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Progression = {}

local SECONDS_PER_DAY = 24 * 60 * 60
local MAX_TIER = #Config.SeasonTiers
local TIER_XP = math.max(1, Config.SEASON_TIER_XP)
local MAX_LEVEL_UPS_AT_ONCE = 100 -- safety net against a broken xpForLevel

Progression.MAX_TIER = MAX_TIER

local rng = Random.new()

-- The Progress RemoteEvent (created here too in case the Rojo project lacks it).
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local progressRemote = Remotes:FindFirstChild("Progress")
if not progressRemote then
	progressRemote = Instance.new("RemoteEvent")
	progressRemote.Name = "Progress"
	progressRemote.Parent = Remotes
end

function Progression.fire(player, event)
	if player.Parent then
		progressRemote:FireClient(player, event)
	end
end

-- Lookups ----------------------------------------------------------------------

local function findById(list, id)
	for _, item in list do
		if item.Id == id then
			return item
		end
	end
	return nil
end

function Progression.findSkin(skinId)
	return findById(Config.Skins, skinId)
end

function Progression.findFx(fxId)
	return findById(Config.ShatterFx, fxId)
end

function Progression.missionDef(missionId)
	return findById(Config.MissionPool, missionId)
end

-- "Default" skin and "Classic" effect belong to everyone.
function Progression.ownsSkin(data, skinId)
	return skinId == "Default" or table.find(data.OwnedSkins, skinId) ~= nil
end

function Progression.ownsFx(data, fxId)
	return fxId == "Classic" or table.find(data.OwnedFx, fxId) ~= nil
end

-- Boosts -------------------------------------------------------------------------

-- Is this a real boost id from Config.Boosts?
function Progression.isBoost(boostId)
	return type(boostId) == "string" and Config.Boosts[boostId] ~= nil
end

-- Boost inventory: data.Boosts = { [boostId] = count }, picked before a run.
function Progression.boostCount(data, boostId)
	local count = data.Boosts[boostId]
	return if type(count) == "number" then count else 0
end

-- Adds `amount` of a boost to the inventory. Returns false for an unknown id.
function Progression.addBoost(data, boostId, amount)
	if not Progression.isBoost(boostId) then
		return false
	end
	data.Boosts[boostId] = Progression.boostCount(data, boostId) + (amount or 1)
	return true
end

-- Uses up one boost. Returns false (and changes nothing) if they have none.
function Progression.takeBoost(data, boostId)
	if not Progression.isBoost(boostId) then
		return false
	end
	local count = Progression.boostCount(data, boostId)
	if count < 1 then
		return false
	end
	data.Boosts[boostId] = if count > 1 then count - 1 else nil
	return true
end

-- The boost a level up gives: level 2 -> BOOST_ORDER[1], level 3 -> [2]...
function Progression.levelUpBoost(level)
	local order = Config.BOOST_ORDER
	if not Config.LEVEL_UP_BOOST or #order == 0 or level < 2 then
		return nil
	end
	return order[(level - 2) % #order + 1]
end

-- Rewards ------------------------------------------------------------------------

-- Gives a reward table { Gems?, Balls?, Skin?, Fx?, Boost? } (Config format).
-- Returns a short description like "+50 gems, Frost effect".
function Progression.grantReward(data, reward)
	local parts = {}
	if reward.Gems and reward.Gems > 0 then
		data.Gems += reward.Gems
		table.insert(parts, "+" .. reward.Gems .. " gems")
	end
	if reward.Balls and reward.Balls > 0 then
		data.BonusBalls += reward.Balls
		table.insert(parts, "+" .. reward.Balls .. " balls next run")
	end
	if reward.Boost and Progression.addBoost(data, reward.Boost, 1) then
		table.insert(parts, Config.Boosts[reward.Boost].Name .. " boost")
	end
	if reward.Skin then
		local skin = Progression.findSkin(reward.Skin)
		if skin and not Progression.ownsSkin(data, skin.Id) then
			table.insert(data.OwnedSkins, skin.Id)
			table.insert(parts, skin.Name .. " ball")
		end
	end
	if reward.Fx then
		local fx = Progression.findFx(reward.Fx)
		if fx and not Progression.ownsFx(data, fx.Id) then
			table.insert(data.OwnedFx, fx.Id)
			table.insert(parts, fx.Name .. " effect")
		end
	end
	return table.concat(parts, ", ")
end

-- Fields grantReward can touch (for publishing).
Progression.REWARD_FIELDS = { "Gems", "BonusBalls", "OwnedSkins", "OwnedFx", "Boosts" }

-- Zone rewards ---------------------------------------------------------------------

-- First-time zone rewards (Config.ZoneRewards). A run that started in zone
-- `startZone` and flew into zone `reachedZone` earns the reward of every zone
-- after startZone up to reachedZone that this account hasn't had yet
-- (data.ZonesRewarded). The zone a Checkpoints-pass run starts in doesn't count:
-- only zones you actually flew into.
-- Returns the messages to show, e.g. { "ZONE 06 REACHED: +350 GEMS, SHIELD BOOST" }.
function Progression.grantZoneRewards(data, startZone, reachedZone)
	local messages = {}
	for zone = startZone + 1, reachedZone do
		local reward = Config.ZoneRewards[zone]
		if reward and not table.find(data.ZonesRewarded, zone) then
			table.insert(data.ZonesRewarded, zone)
			local given = Progression.grantReward(data, reward)
			local text = string.format("ZONE %02d REACHED", zone)
			if given ~= "" then
				text ..= ": " .. string.upper(given)
			end
			table.insert(messages, text)
		end
	end
	return messages
end

-- Levels + season pass ------------------------------------------------------------

-- Adds XP to both the player level and the season pass.
-- Returns a list of Progress events (LevelUp / SeasonTier) to send.
function Progression.addXP(data, amount)
	local events = {}
	amount = math.floor(amount)
	if amount <= 0 then
		return events
	end

	data.XP += amount
	for _ = 1, MAX_LEVEL_UPS_AT_ONCE do
		local needed = Config.xpForLevel(data.Level)
		if data.XP < needed then
			break
		end
		data.XP -= needed
		data.Level += 1
		data.Gems += Config.LEVEL_UP_GEMS

		local unlock = nil
		local unlockDef = Config.LevelUnlocks[data.Level]
		local boostId = Progression.levelUpBoost(data.Level)
		if unlockDef or boostId then
			unlock = {}
			if unlockDef and unlockDef.Skin and Progression.findSkin(unlockDef.Skin) then
				if not Progression.ownsSkin(data, unlockDef.Skin) then
					table.insert(data.OwnedSkins, unlockDef.Skin)
				end
				unlock.Skin = unlockDef.Skin
			end
			if unlockDef and unlockDef.Fx and Progression.findFx(unlockDef.Fx) then
				if not Progression.ownsFx(data, unlockDef.Fx) then
					table.insert(data.OwnedFx, unlockDef.Fx)
				end
				unlock.Fx = unlockDef.Fx
			end
			-- Every level up also gives one boost (shown with the unlocks).
			if boostId and Progression.addBoost(data, boostId, 1) then
				unlock.Boost = boostId
			end
			if next(unlock) == nil then
				unlock = nil
			end
		end
		table.insert(events, { type = "LevelUp", level = data.Level, gems = Config.LEVEL_UP_GEMS, unlock = unlock })
	end

	if data.SeasonTier < MAX_TIER then
		data.SeasonXP += amount
		while data.SeasonTier < MAX_TIER and data.SeasonXP >= TIER_XP do
			data.SeasonXP -= TIER_XP
			data.SeasonTier += 1
			table.insert(events, { type = "SeasonTier", tier = data.SeasonTier })
		end
	end
	if data.SeasonTier >= MAX_TIER then
		data.SeasonXP = 0
	end

	return events
end

-- Fields addXP can touch (for publishing).
Progression.XP_FIELDS = { "Level", "XP", "Gems", "OwnedSkins", "OwnedFx", "Boosts", "SeasonTier", "SeasonXP" }

-- A new season (Config.SEASON_ID bumped) starts everyone from tier 0.
function Progression.ensureSeason(data)
	if data.SeasonId == Config.SEASON_ID then
		return false
	end
	data.SeasonId = Config.SEASON_ID
	data.SeasonTier = 0
	data.SeasonXP = 0
	data.SeasonPremium = false
	data.SeasonClaimed = { free = {}, premium = {} }
	return true
end

-- Daily missions ----------------------------------------------------------------

-- Next midnight (UTC) after `now`.
function Progression.nextReset(now)
	return (now // SECONDS_PER_DAY + 1) * SECONDS_PER_DAY
end

-- Picks a mission that isn't already on the list, preferring a different stat
-- so the three missions of a day feel different.
local function pickMission(current)
	local usedIds, usedStats = {}, {}
	for _, mission in current do
		usedIds[mission.id] = true
		local def = Progression.missionDef(mission.id)
		if def then
			usedStats[def.Stat] = true
		end
	end

	local fresh, fallback = {}, {}
	for _, def in Config.MissionPool do
		if not usedIds[def.Id] then
			table.insert(fallback, def)
			if not usedStats[def.Stat] then
				table.insert(fresh, def)
			end
		end
	end
	local pool = if #fresh > 0 then fresh else fallback
	if #pool == 0 then
		return nil
	end
	return pool[rng:NextInteger(1, #pool)]
end

local function newMission(def)
	return { id = def.Id, progress = 0, claimed = false }
end

local function missionsValid(missions)
	if type(missions) ~= "table" or #missions == 0 then
		return false
	end
	for _, mission in missions do
		if
			type(mission) ~= "table"
			or type(mission.progress) ~= "number"
			or not Progression.missionDef(mission.id)
		then
			return false
		end
	end
	return true
end

-- New missions every day at midnight UTC. Returns true if they changed.
function Progression.refreshMissions(data, now)
	if now < data.MissionsReset and missionsValid(data.Missions) then
		return false
	end
	local missions = {}
	for _ = 1, Config.MISSIONS_PER_DAY do
		local def = pickMission(missions)
		if not def then
			break
		end
		table.insert(missions, newMission(def))
	end
	data.Missions = missions
	-- Bought rerolls (ExtraRerolls) carry over to the next day.
	data.MissionRerolls = Config.MISSION_REROLLS_PER_DAY + data.ExtraRerolls
	data.MissionsReset = Progression.nextReset(now)
	return true
end

Progression.MISSION_FIELDS = { "Missions", "MissionRerolls", "MissionsReset", "ExtraRerolls" }

-- What the client sees (the Missions attribute).
function Progression.publicMissions(data)
	local list = {}
	for _, mission in data.Missions do
		local def = Progression.missionDef(mission.id)
		if def then
			table.insert(list, {
				id = def.Id,
				text = string.format(def.Text, def.Goal),
				stat = def.Stat,
				goal = def.Goal,
				progress = math.min(mission.progress, def.Goal),
				gems = def.Gems,
				xp = def.XP,
				claimed = mission.claimed == true,
			})
		end
	end
	return list
end

local function findMission(data, missionId)
	for index, mission in data.Missions do
		if mission.id == missionId then
			return mission, index
		end
	end
	return nil
end

function Progression.rerollMission(data, missionId)
	local mission, index = findMission(data, missionId)
	local def = mission and Progression.missionDef(mission.id)
	if not mission or not def then
		return false, "Mission not found"
	end
	if data.MissionRerolls <= 0 then
		return false, "No rerolls left today"
	end
	if mission.claimed or mission.progress >= def.Goal then
		return false, "That mission is already done"
	end

	local others = table.clone(data.Missions)
	local replacement = pickMission(others) -- avoids the current one too
	if not replacement then
		return false, "No other missions available"
	end
	data.Missions[index] = newMission(replacement)
	data.MissionRerolls -= 1
	-- The free daily reroll is used first; bought ones only go once it's gone.
	data.ExtraRerolls = math.min(data.ExtraRerolls, data.MissionRerolls)
	return true, "New mission: " .. string.format(replacement.Text, replacement.Goal)
end

-- Returns ok, message, rewardText, events.
function Progression.claimMission(data, missionId)
	local mission = findMission(data, missionId)
	local def = mission and Progression.missionDef(mission.id)
	if not mission or not def then
		return false, "Mission not found"
	end
	if mission.claimed then
		return false, "Already claimed"
	end
	if mission.progress < def.Goal then
		return false, "Not finished yet"
	end

	mission.claimed = true
	data.Gems += def.Gems
	local events = Progression.addXP(data, def.XP)
	local text = "+" .. def.Gems .. " gems, +" .. def.XP .. " XP"
	return true, text, events
end

-- Run results -------------------------------------------------------------------

local CUMULATIVE = { "glass", "crystals", "props", "runs" }
local BEST = { "bestZone", "bestRunMeters", "bestMultiball" }

-- Adds one run report to lifetime stats and mission progress.
-- deltas: { glass, crystals, props, runs } added since the last report.
-- best: { bestZone, bestRunMeters, bestMultiball } values reached this run.
-- Returns the texts of missions that just got completed.
function Progression.trackRun(data, deltas, best)
	local stats = data.Stats
	for _, stat in CUMULATIVE do
		stats[stat] += deltas[stat] or 0
	end
	for _, stat in BEST do
		stats[stat] = math.max(stats[stat], best[stat] or 0)
	end

	local completed = {}
	for _, mission in data.Missions do
		local def = Progression.missionDef(mission.id)
		if def and not mission.claimed then
			local before = mission.progress
			if def.Max then
				mission.progress = math.max(mission.progress, best[def.Stat] or 0)
			else
				mission.progress += deltas[def.Stat] or 0
			end
			if before < def.Goal and mission.progress >= def.Goal then
				table.insert(completed, string.format(def.Text, def.Goal))
			end
		end
	end
	return completed
end

-- Daily streak ------------------------------------------------------------------

-- Returns ok, message.
function Progression.claimDaily(data, now)
	if now < data.NextDaily then
		return false, "Come back later"
	end

	local day = data.StreakDay
	if now > data.StreakExpires then
		day = 1 -- missed a day: the streak starts over
	end
	day = math.clamp(day, 1, #Config.DailyStreak)

	local text = Progression.grantReward(data, Config.DailyStreak[day])
	data.StreakDay = day % #Config.DailyStreak + 1
	data.NextDaily = now + Config.DAILY_REWARD_COOLDOWN
	data.StreakExpires = now + Config.DAILY_STREAK_RESET
	return true, "Day " .. day .. ": " .. text
end

-- A streak is "broken" when the 48h window ran out partway through it
-- (claiming now would restart at day 1).
function Progression.streakBroken(data, now)
	return now > data.StreakExpires and data.StreakDay > 1
end

-- StreakSaver product: reopens the claim window so the streak continues.
-- Returns false if there was nothing to save (the caller gives something else).
function Progression.saveStreak(data, now)
	if not Progression.streakBroken(data, now) then
		return false
	end
	data.StreakExpires = now + Config.DAILY_STREAK_RESET
	return true
end

Progression.DAILY_FIELDS = { "Gems", "BonusBalls", "OwnedSkins", "OwnedFx", "Boosts", "StreakDay", "NextDaily", "StreakExpires" }

-- "Wait! Free gift" ------------------------------------------------------------
-- Shown when a player comes back from the Roblox menu (see client LeaveGift).
-- One claim per Config.LeaveGift.Cooldown, only after MinPlaySeconds of play
-- this session. The rewards take turns (Config.LeaveGift.Rewards).

-- The reward the next claim gives (or nil if none are set up).
function Progression.nextLeaveGift(data)
	local rewards = Config.LeaveGift and Config.LeaveGift.Rewards
	if type(rewards) ~= "table" or #rewards == 0 then
		return nil
	end
	return rewards[data.LeaveGiftIndex % #rewards + 1]
end

-- playedSeconds: how long the player has been in this server. Returns ok, message.
function Progression.claimLeaveGift(data, now, playedSeconds)
	local settings = Config.LeaveGift
	local reward = Progression.nextLeaveGift(data)
	if not settings or not reward then
		return false, "No gift right now"
	end
	if now < data.LeaveGiftNext then
		return false, "Come back later"
	end
	if playedSeconds < settings.MinPlaySeconds then
		return false, "Play a little longer first"
	end

	local text = Progression.grantReward(data, reward)
	if text == "" then
		text = "Gift claimed"
	end
	data.LeaveGiftIndex = (data.LeaveGiftIndex + 1) % #settings.Rewards
	data.LeaveGiftNext = now + settings.Cooldown
	return true, "Free gift: " .. text
end

Progression.LEAVE_GIFT_FIELDS = { "Gems", "BonusBalls", "OwnedSkins", "OwnedFx", "Boosts", "LeaveGiftNext", "LeaveGiftIndex" }

-- Season tiers ------------------------------------------------------------------

-- Returns ok, message.
function Progression.claimSeasonTier(data, request)
	if type(request) ~= "table" then
		return false, "Bad request"
	end
	local track, tier = request.track, request.tier
	if track ~= "Free" and track ~= "Premium" then
		return false, "Bad request"
	end
	if type(tier) ~= "number" or tier ~= math.floor(tier) or tier < 1 or tier > MAX_TIER then
		return false, "That tier doesn't exist"
	end
	if tier > data.SeasonTier then
		return false, "Reach tier " .. tier .. " first"
	end
	if track == "Premium" and not data.SeasonPremium then
		return false, "Needs the premium pass"
	end

	local reward = Config.SeasonTiers[tier][track]
	if not reward then
		return false, "No reward on this tier"
	end
	local claimedList = if track == "Free" then data.SeasonClaimed.free else data.SeasonClaimed.premium
	if table.find(claimedList, tier) then
		return false, "Already claimed"
	end

	table.insert(claimedList, tier)
	local text = Progression.grantReward(data, reward)
	if text == "" then
		text = "Reward claimed"
	end
	return true, "Tier " .. tier .. ": " .. text
end

-- Loading -----------------------------------------------------------------------

local function wholeNumber(value, minimum)
	if type(value) ~= "number" or value ~= value or value == math.huge then
		return minimum
	end
	return math.max(minimum, math.floor(value))
end

-- Zones used to be 10 rooms long (saves from then have no ZoneLength). When the
-- zone length changes, Checkpoint and Stats.bestZone are converted once to the new
-- zone size by distance, so nobody starts further than they really flew. Zones the
-- player flew through that way get their first-time reward now (ZonesRewarded makes
-- sure each one is only ever given once), so a Checkpoints-pass start never skips them.
local OLD_ZONE_LENGTH = 10

function Progression.migrateZoneLength(data)
	local zoneLength = Config.ROOMS_PER_CHECKPOINT
	local savedLength = tonumber(data.ZoneLength) or OLD_ZONE_LENGTH
	if savedLength == zoneLength then
		return
	end
	if savedLength <= 0 or savedLength ~= math.floor(savedLength) then
		savedLength = OLD_ZONE_LENGTH
	end
	-- Saves already played with the new zone length (before this conversion existed)
	-- have their first-time zone rewards in new zones: those zones were really reached.
	local rewardedUpTo = 0
	for _, zone in data.ZonesRewarded do
		rewardedUpTo = math.max(rewardedUpTo, zone)
	end
	local function convert(zone)
		local rooms = wholeNumber(zone, 0) * savedLength
		return math.max(rooms // zoneLength, rewardedUpTo)
	end
	local oldCheckpoint = wholeNumber(data.Checkpoint, 0)
	data.Checkpoint = convert(oldCheckpoint)
	data.Stats.bestZone = convert(data.Stats.bestZone)
	-- Rewards for zones flown through under the old length (none are given twice).
	if oldCheckpoint > 0 then
		Progression.grantZoneRewards(data, 0, data.Checkpoint)
	end
	data.ZoneLength = zoneLength
end

-- Fixes up data right after it's loaded (old saves, new season, new day).
function Progression.normalize(data, now)
	data.Level = wholeNumber(data.Level, 1)
	data.XP = wholeNumber(data.XP, 0)
	data.Gems = wholeNumber(data.Gems, 0)
	data.BonusBalls = wholeNumber(data.BonusBalls, 0)
	data.StreakDay = math.clamp(wholeNumber(data.StreakDay, 1), 1, #Config.DailyStreak)
	data.MissionRerolls = wholeNumber(data.MissionRerolls, 0)
	data.ExtraRerolls = wholeNumber(data.ExtraRerolls, 0)
	data.LeaveGiftNext = wholeNumber(data.LeaveGiftNext, 0)
	data.LeaveGiftIndex = wholeNumber(data.LeaveGiftIndex, 0)

	-- Boost inventory: only known boosts with a whole, positive count.
	local boosts = {}
	if type(data.Boosts) == "table" then
		for boostId, count in data.Boosts do
			local amount = wholeNumber(count, 0)
			if Progression.isBoost(boostId) and amount > 0 then
				boosts[boostId] = amount
			end
		end
	end
	data.Boosts = boosts

	-- One free set of boosts for every player, once, so they get a taste.
	if not data.WelcomeGiven then
		data.WelcomeGiven = true
		for boostId, amount in Config.WELCOME_BOOSTS do
			if type(amount) == "number" and amount > 0 then
				Progression.addBoost(data, boostId, math.floor(amount))
			end
		end
	end

	if not table.find(data.OwnedSkins, "Default") then
		table.insert(data.OwnedSkins, 1, "Default")
	end
	if not table.find(data.OwnedFx, "Classic") then
		table.insert(data.OwnedFx, 1, "Classic")
	end
	if not Progression.findSkin(data.EquippedSkin) or not Progression.ownsSkin(data, data.EquippedSkin) then
		data.EquippedSkin = "Default"
	end
	if not Progression.findFx(data.EquippedFx) or not Progression.ownsFx(data, data.EquippedFx) then
		data.EquippedFx = "Classic"
	end

	-- Zones whose first-time reward was given: whole numbers, each once.
	local zonesRewarded = {}
	if type(data.ZonesRewarded) == "table" then
		for _, zone in data.ZonesRewarded do
			if type(zone) == "number" and zone == math.floor(zone) and zone > 0 and not table.find(zonesRewarded, zone) then
				table.insert(zonesRewarded, zone)
			end
		end
	end
	data.ZonesRewarded = zonesRewarded

	Progression.migrateZoneLength(data)

	Progression.ensureSeason(data)
	data.SeasonTier = math.clamp(wholeNumber(data.SeasonTier, 0), 0, MAX_TIER)
	data.SeasonXP = wholeNumber(data.SeasonXP, 0)

	Progression.refreshMissions(data, now)
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--[[
	Gem shop (ball skins + shatter effects + boosts), daily streak, mission and season
	pass claims. The client asks through the ShopRequest RemoteFunction:
	ShopRequest:InvokeServer(action, argument) -> (ok, message).
	Every check happens here; the client is never trusted.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Progression = require(script.Parent.Progression)

local Remotes = ReplicatedStorage.Remotes

local Shop = {}

local function fireAll(player, events)
	for _, event in events do
		Progression.fire(player, event)
	end
end

local function reward(player, text)
	Progression.fire(player, { type = "Reward", text = text })
end

-- Items with Price 0 and a Source (level, season, starter pack...) can't be
-- bought: they're unlocked another way.
local function checkBuyable(item, owned)
	if owned then
		return false, "You already own " .. item.Name
	end
	if item.Source and item.Price <= 0 then
		return false, "Unlocked by " .. item.Source
	end
	return true
end

local actions = {}

function actions.BuySkin(player, data, skinId)
	local skin = Progression.findSkin(skinId)
	if not skin then
		return false, "That skin doesn't exist"
	end
	local ok, message = checkBuyable(skin, Progression.ownsSkin(data, skin.Id))
	if not ok then
		return false, message
	end
	-- Premium balls are only sold for Robux (Config.Products.Ball<Id>).
	if skin.Premium or skin.Price <= 0 then
		return false, skin.Name .. " can't be bought with gems"
	end
	if data.Gems < skin.Price then
		return false, "Not enough gems"
	end

	local ownedSkins = table.clone(data.OwnedSkins)
	table.insert(ownedSkins, skin.Id)
	PlayerData.update(player, {
		Gems = data.Gems - skin.Price,
		OwnedSkins = ownedSkins,
		EquippedSkin = skin.Id,
	})
	return true, skin.Name .. " unlocked"
end

function actions.EquipSkin(player, data, skinId)
	local skin = Progression.findSkin(skinId)
	if not skin or not Progression.ownsSkin(data, skin.Id) then
		return false, "You don't own that skin"
	end
	PlayerData.update(player, { EquippedSkin = skin.Id })
	return true
end

function actions.BuyFx(player, data, fxId)
	local fx = Progression.findFx(fxId)
	if not fx then
		return false, "That effect doesn't exist"
	end
	local ok, message = checkBuyable(fx, Progression.ownsFx(data, fx.Id))
	if not ok then
		return false, message
	end
	if data.Gems < fx.Price then
		return false, "Not enough gems"
	end

	local ownedFx = table.clone(data.OwnedFx)
	table.insert(ownedFx, fx.Id)
	PlayerData.update(player, {
		Gems = data.Gems - fx.Price,
		OwnedFx = ownedFx,
		EquippedFx = fx.Id,
	})
	return true, fx.Name .. " unlocked"
end

function actions.EquipFx(player, data, fxId)
	local fx = Progression.findFx(fxId)
	if not fx or not Progression.ownsFx(data, fx.Id) then
		return false, "You don't own that effect"
	end
	PlayerData.update(player, { EquippedFx = fx.Id })
	return true
end

-- One boost into the inventory, paid with gems (Config.Boosts[id].Gems).
function actions.BuyBoost(player, data, boostId)
	if not Progression.isBoost(boostId) then
		return false, "That boost doesn't exist"
	end
	local boost = Config.Boosts[boostId]
	local price = boost.Gems
	if type(price) ~= "number" or price <= 0 then
		return false, "That boost can't be bought with gems"
	end
	if data.Gems < price then
		return false, "Not enough gems"
	end

	data.Gems -= price
	Progression.addBoost(data, boostId, 1)
	PlayerData.publish(player, { "Gems", "Boosts" })
	return true, boost.Name .. " boost added"
end

function actions.ClaimDaily(player, data)
	local ok, message = Progression.claimDaily(data, os.time())
	if ok then
		PlayerData.publish(player, Progression.DAILY_FIELDS)
		reward(player, message)
	end
	return ok, message
end

-- New missions might be due (the player kept the game open past midnight).
local function refreshMissions(player, data)
	if Progression.refreshMissions(data, os.time()) then
		PlayerData.publish(player, Progression.MISSION_FIELDS)
	end
end

function actions.ClaimMission(player, data, missionId)
	if type(missionId) ~= "string" then
		return false, "Mission not found"
	end
	refreshMissions(player, data)
	local ok, message, events = Progression.claimMission(data, missionId)
	if ok then
		PlayerData.publish(player, { "Missions" })
		PlayerData.publish(player, Progression.XP_FIELDS)
		reward(player, message)
		fireAll(player, events)
	end
	return ok, message
end

function actions.RerollMission(player, data, missionId)
	if type(missionId) ~= "string" then
		return false, "Mission not found"
	end
	refreshMissions(player, data)
	local ok, message = Progression.rerollMission(data, missionId)
	if ok then
		PlayerData.publish(player, Progression.MISSION_FIELDS)
	end
	return ok, message
end

-- argument: { track = "Free" | "Premium", tier = number }
-- Settings come from the client: keep only known keys with the right type/range.
function actions.SaveSettings(player, data, incoming)
	if type(incoming) ~= "table" then
		return false
	end
	local clean = table.clone(data.Settings)
	for key, default in Config.DefaultSettings do
		local value = incoming[key]
		if type(value) == type(default) then
			if type(value) == "number" then
				if value == value then -- not NaN
					clean[key] = math.clamp(value, 0, 1)
				end
			elseif key == "graphics" then
				if table.find(Config.GRAPHICS_OPTIONS, value) then
					clean[key] = value
				end
			else
				clean[key] = value
			end
		end
	end
	PlayerData.update(player, { Settings = clean })
	return true
end

function actions.FinishTutorial(player, data)
	if data.TutorialDone then
		return true
	end
	PlayerData.update(player, { TutorialDone = true })
	return true
end

function actions.SeenHint(player, data, hintId)
	if type(hintId) ~= "string" or not Config.Hints[hintId] then
		return false, "Unknown tip"
	end
	if table.find(data.Hints, hintId) then
		return true
	end
	local hints = table.clone(data.Hints)
	table.insert(hints, hintId)
	PlayerData.update(player, { Hints = hints })
	return true
end

function actions.ClaimSeasonTier(player, data, request)
	local ok, message = Progression.claimSeasonTier(data, request)
	if ok then
		PlayerData.publish(player, { "SeasonClaimed" })
		PlayerData.publish(player, Progression.REWARD_FIELDS)
		reward(player, message)
	end
	return ok, message
end

-- Lets Main add actions that need the player's current run
-- (UseBoostNow, ResumeRun). handler(player, data, argument) -> (ok, message).
-- Like every action here, it must not yield.
function Shop.addAction(name, handler)
	actions[name] = handler
end

-- One request at a time per player, so spamming can't double-spend.
local busy = {}

function Shop.init()
	Remotes.ShopRequest.OnServerInvoke = function(player, action, argument)
		local handler = type(action) == "string" and actions[action]
		local data = PlayerData.get(player)
		if not handler or not data then
			return false, "Try again in a moment"
		end
		if busy[player] then
			return false, "Slow down"
		end

		busy[player] = true
		local ok, success, message = pcall(handler, player, data, argument)
		busy[player] = nil

		if not ok then
			warn("Shop error:", success)
			return false, "Something went wrong"
		end
		-- No save here: changes are marked dirty and the autosave writes them
		-- (saving on every click would use up the DataStore's write budget).
		return success == true, message
	end
end

function Shop.release(player)
	busy[player] = nil
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">ViewmodelRigs</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Builds each player's first-person arms from their avatar, made safe.

	Marketplace avatars can be huge, tiny, spiky or covered in accessories, so
	the arms are NOT a copy of the avatar. Instead a brand-new, empty
	HumanoidDescription gets only what we allow (a whitelist):
	  KEPT     the six body colours, the classic Shirt (and Pants, harmless:
	           the legs are removed anyway)
	  RESET    body parts (Head, Torso, arms, legs) = 0 -> standard blocky parts
	           scales: Height / Width / Depth / Head = 1, BodyType = 0, Proportion = 0
	           every accessory, hair, hat, face accessory, layered clothing = none
	           Face = 0, T-shirt = 0, every animation = 0
	From that, Roblox builds a plain R6 model, which is then cut down to just
	the two arms + Humanoid + Shirt + Body Colors (Shared/ViewmodelRig.strip),
	with the arms forced to the standard 1 x 2 x 1 size.

	The result goes into ReplicatedStorage.ViewmodelRigs as a Model named by the
	player's UserId (the client clones it, see Client/Viewmodel.luau). It is
	removed when they leave. If anything fails (avatar service down, Studio test
	player...), the player gets plain default arms instead.

	Players:GetHumanoidDescriptionFromUserId and
	Players:CreateHumanoidModelFromDescription only work on the server, which is
	why this is a server script.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ViewmodelRig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ViewmodelRig"))

local FETCH_ATTEMPTS = 3 -- first try + 2 retries
local RETRY_DELAY = 2 -- seconds between tries

local BODY_COLORS = { "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }
local BODY_PARTS = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }
local ACCESSORIES = {
	"HatAccessory",
	"HairAccessory",
	"FaceAccessory",
	"NeckAccessory",
	"ShouldersAccessory",
	"FrontAccessory",
	"BackAccessory",
	"WaistAccessory",
}
local ANIMATIONS = {
	"ClimbAnimation",
	"FallAnimation",
	"IdleAnimation",
	"JumpAnimation",
	"MoodAnimation",
	"RunAnimation",
	"SwimAnimation",
	"WalkAnimation",
}
local SCALES = {
	HeightScale = 1,
	WidthScale = 1,
	DepthScale = 1,
	HeadScale = 1,
	BodyTypeScale = 0,
	ProportionScale = 0,
}

local folder = ReplicatedStorage:FindFirstChild(ViewmodelRig.FOLDER_NAME)
if not folder then
	folder = Instance.new("Folder")
	folder.Name = ViewmodelRig.FOLDER_NAME
	folder.Parent = ReplicatedStorage
end

-- Sets one property, ignoring properties this Roblox version doesn't have.
local function trySet(instance, property, value)
	pcall(function()
		instance[property] = value
	end)
end

local function tryGet(instance, property)
	local ok, value = pcall(function()
		return instance[property]
	end)
	return if ok then value else nil
end

-- A clothing asset id we can trust: a whole number >= 0.
local function clothingId(value)
	if type(value) ~= "number" or value ~= value or value < 0 or value % 1 ~= 0 then
		return 0
	end
	return value
end

-- The player's avatar description (nil if Roblox couldn't give it).
local function fetchDescription(userId)
	for attempt = 1, FETCH_ATTEMPTS do
		local ok, description = pcall(Players.GetHumanoidDescriptionFromUserId, Players, userId)
		if ok and typeof(description) == "Instance" and description:IsA("HumanoidDescription") then
			return description
		end
		warn("[ViewmodelRigs] avatar for", userId, "not loaded (try " .. attempt .. "):", description)
		if attempt < FETCH_ATTEMPTS then
			task.wait(RETRY_DELAY)
		end
	end
	return nil
end

-- A brand-new description with only the allowed things copied over.
local function cleanDescription(source)
	local clean = Instance.new("HumanoidDescription")

	-- Kept: skin colours and classic clothing.
	for _, property in BODY_COLORS do
		local color = tryGet(source, property)
		if typeof(color) == "Color3" then
			trySet(clean, property, color)
		end
	end
	trySet(clean, "Shirt", clothingId(tryGet(source, "Shirt")))
	trySet(clean, "Pants", clothingId(tryGet(source, "Pants")))

	-- Reset (already the defaults on a new description, set anyway so it's
	-- guaranteed whatever Roblox's defaults are).
	for _, property in BODY_PARTS do
		trySet(clean, property, 0)
	end
	for property, value in SCALES do
		trySet(clean, property, value)
	end
	for _, property in ACCESSORIES do
		trySet(clean, property, "")
	end
	for _, property in ANIMATIONS do
		trySet(clean, property, 0)
	end
	trySet(clean, "Face", 0)
	trySet(clean, "GraphicTShirt", 0)
	-- Layered clothing and any other accessories.
	pcall(function()
		clean:SetAccessories({}, true)
	end)
	return clean
end

-- Arms from the cleaned avatar, or nil if Roblox couldn't build them.
local function buildAvatarRig(description, name)
	local clean = cleanDescription(description)
	local ok, model = pcall(Players.CreateHumanoidModelFromDescription, Players, clean, Enum.HumanoidRigType.R6)
	clean:Destroy()
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		warn("[ViewmodelRigs] could not build arms:", model)
		return nil
	end
	if not ViewmodelRig.strip(model) then
		model:Destroy()
		return nil
	end
	for _, armName in ViewmodelRig.ARM_NAMES do
		model[armName].Size = ViewmodelRig.ARM_SIZE
	end
	model.Name = name
	model:SetAttribute("Default", false)
	return model
end

local function setup(player)
	local userId = player.UserId
	local name = tostring(userId)
	local rig = nil

	-- Studio test players have UserIds <= 0 and no avatar: they get default arms.
	if userId > 0 then
		local description = fetchDescription(userId)
		if description then
			local ok, result = pcall(buildAvatarRig, description, name)
			if ok then
				rig = result
			else
				warn("[ViewmodelRigs] could not build arms:", result)
			end
			description:Destroy()
		end
	end
	if not rig then
		rig = ViewmodelRig.buildDefault(name)
	end

	-- They may have left while the avatar was loading.
	if player.Parent ~= Players then
		rig:Destroy()
		return
	end
	local old = folder:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	rig.Parent = folder
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(setup, player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(setup, player)
end

Players.PlayerRemoving:Connect(function(player)
	local rig = folder:FindFirstChild(tostring(player.UserId))
	if rig then
		rig:Destroy()
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">BallFx</string>
            <string name="Source"><![CDATA[--[[
	What a thrown ball looks like.

	Plain skins (Steel, Gold, Ruby...) are one ball part, like always.
	Premium balls (bought with Robux, Config.Skins entries with Premium = true)
	are little animated models: the Blender model from Config.BallModels once it
	has loaded (ReplicatedStorage.ModelLibrary.Balls), styled and animated by
	Shared.BallStyles. Until then a part-built version (glowing core, see-through
	shell, spinning rings / orbiting shards) so they already look special.

	BallFx.create(skinId, radius, options?) -> BasePart
		The ball to throw. Move it by setting its CFrame (it never needs to turn).
		Everything else (model parts, trail, particles, light) is welded to it /
		parented under it, so it follows on its own and :Destroy() removes it all.
		radius is the collision radius; premium balls are drawn 2.6x that across
		so their details read in flight.
		options = {
			mega = bool,       -- MegaBall boost ball (trail in the boost's color)
			lite = bool,       -- cheap version: no rings / particles / light (extra multiball balls)
			priority = bool,   -- the ball just thrown from the hand: always full detail
			                   -- (if the budget is full, the oldest full ball is toned down instead)
			trailScale = num,  -- trail lifetime multiplier (RunController: longer at high speed)
			parent = Instance,
		}
		Every ball has a trail in its skin's colors (premium ones longer and brighter).
	BallFx.destroy(ball)  -- use this instead of ball:Destroy() (frees its budget)
	BallFx.isPremium(skinId)
	BallFx.hasMesh(skinId) -- the Blender model has loaded
	BallFx.preview(skinId, diameter) -> { model, mesh, step(t), destroy() }
		Anchored copy for the shop's ViewportFrame. step(os.clock()) animates it.
	BallFx.held(skinId, diameter, particleScale?) -> { root, mesh, skinId, place(cframe, scale, t), destroy() }
		A ball in one of the player's hands (HeldBall.luau). Same look and animation
		as a thrown ball, with its particles but no trail / light. All parts are
		anchored and moved together with one BulkMoveTo per frame (it follows the camera).
		diameter = how big it's drawn across (studs); place() scales it (pop-in, mega).
		particleScale (default 1): extra particle-rate multiplier (two hands = two balls).
	BallFx.impactStyle(skinId) -> { id, color, color2, rainbow, premium }
		The skin's colors for Shatter.skinBurst (the splash where a ball hits).

	Keeping phones smooth:
	  - one RenderStepped loop animates every live premium ball (no per-ball connections)
	  - at most MAX_FULL full-detail balls at once; more become lite versions
	  - particle rates are shared: the more full balls, the less each one emits
	  - only the newest MAX_LIGHTS balls get a light (none on Low graphics)
	  - balls far from the camera aren't animated
	  - trails: lifetime capped (TRAIL_MAX_LIFETIME), shorter on Low graphics
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local BallStyles = require(Shared:WaitForChild("BallStyles"))
local Settings = require(script.Parent.Settings)

local BallFx = {}

local VISUAL_SCALE = 2.6 -- premium balls are drawn this many times the collision radius across
local MAX_FULL = { High = 8, Low = 4 } -- full-detail premium balls alive at once
local MAX_LIGHTS = { High = 3, Low = 0 } -- newest balls that get a PointLight
local PARTICLE_SHARE = 3 -- up to this many full balls emit at full rate; more share it
local MIN_RATE_SCALE = 0.15
local LOW_PARTICLE_SCALE = 0.4 -- Low graphics: fewer particles (and only the first emitter)
local ANIMATE_RANGE = 120 -- studs; balls further from the camera stop animating
local TAU = math.pi * 2
local MEGA_COLOR = Config.Boosts.MegaBall.Color

-- Trails: every ball leaves one in its skin's colors, so a skin reads even as a
-- far-away dot. Premium trails are longer and brighter.
local PLAIN_TRAIL_LIFETIME = 0.34 -- seconds (was 0.25, and only some skins had one)
local PLAIN_TRAIL_WIDTH = 0.8 -- x the ball's radius, above and below its center
local PREMIUM_TRAIL_LENGTH = 1.5 -- x the lifetime in BallStyles
local PREMIUM_TRAIL_WIDTH = 0.36 -- x the drawn diameter (was 0.3)
local TRAIL_BRIGHTNESS = { plain = 1.6, premium = 2.4 }
local TRAIL_MAX_LIFETIME = 0.8
local LOW_TRAIL_SCALE = 0.75 -- Low graphics: shorter trails
local HELD_PARTICLE_SCALE = 0.6 -- the ball in your hand sparkles a bit less than a thrown one

local TEXTURES = {
	sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
}

-- Part-built look (no Blender model yet). Colors come from Config.Skins (Color, Shell, Ring).
-- rings: spinning ForceField hoops (a BlackHole "disk" is a flat glowing plate).
local FALLBACK = {
	Frostbite = { shell = Enum.Material.Glass, shellAlpha = 0.45, rings = 0, shards = 5 },
	CyberCore = { shell = Enum.Material.ForceField, shellAlpha = 0, rings = 2, shards = 0 },
	PlasmaCore = { shell = Enum.Material.ForceField, shellAlpha = 0, rings = 1, shards = 3 },
	MagmaHeart = { shell = Enum.Material.Glass, shellAlpha = 0.35, rings = 0, shards = 4 },
	BlackHole = { shell = Enum.Material.ForceField, shellAlpha = 0, rings = 0, disk = true, shards = 0 },
	Supernova = { shell = Enum.Material.ForceField, shellAlpha = 0, rings = 2, shards = 3 },
}
local DEFAULT_FALLBACK = { shell = Enum.Material.ForceField, shellAlpha = 0, rings = 1, shards = 0 }
local EMPTY_STYLE = { Diameter = 2, Parts = {}, Fx = { Particles = {} } }
local CENTER_PARTS = { "Core", "Heart", "Shell" } -- model parts that sit on the ball's center

local camera = workspace.CurrentCamera

-- Helpers -----------------------------------------------------------------------

local function graphicsLevel()
	local ok, level = pcall(Settings.graphicsLevel)
	return if ok and level == "Low" then "Low" else "High"
end

local function styleOf(skinId)
	local style = BallStyles[skinId]
	return if type(style) == "table" then style else EMPTY_STYLE
end

function BallFx.isPremium(skinId)
	local skin = Config.getSkin(skinId)
	return skin.Id == skinId and skin.Premium == true
end

local function meshTemplate(skinId)
	local library = ReplicatedStorage:FindFirstChild("ModelLibrary")
	local folder = library and library:FindFirstChild("Balls")
	return folder and folder:FindFirstChild(skinId)
end

function BallFx.hasMesh(skinId)
	return meshTemplate(skinId) ~= nil
end

-- Every part of a ball: no collisions, no queries (the game's raycasts skip it).
local function quiet(part, anchored)
	part.Anchored = anchored
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
end

local function newPart(name, shape, size, color, material, transparency)
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = material
	part.Transparency = transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	quiet(part, false)
	return part
end

-- Trail.Brightness makes a trail glow brighter than its color alone. pcall: an
-- older client without the property just keeps the normal brightness.
local function setBrightness(trail, brightness)
	pcall(function()
		trail.Brightness = brightness
	end)
end

local function rainbowColors()
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.8, 1)))
	end
	return ColorSequence.new(keys)
end

-- The invisible anchored center every premium ball hangs off.
local function newRoot(diameter)
	local root = Instance.new("Part")
	root.Name = "Ball"
	root.Shape = Enum.PartType.Ball
	root.Size = Vector3.one * math.max(0.2, diameter * 0.5)
	root.Transparency = 1
	quiet(root, true)
	root.CFrame = CFrame.new()
	return root
end

-- Welds `part` to the root at `rest` (its place in the ball's own space) and records
-- its animation, if any. Spins turn around the ball's center; pulses scale.
local function attach(proto, part, rest, spin, pulse)
	local joint = Instance.new("Weld")
	joint.Name = "Joint"
	joint.Part0 = proto.root
	joint.Part1 = part
	joint.C0 = rest
	joint.Parent = part
	part.CFrame = proto.root.CFrame * rest -- already in place (the preview has no welds)
	part.Parent = proto.root
	if spin or pulse then
		local axis = spin and spin.Axis
		table.insert(proto.anims, {
			name = part.Name,
			rest = rest,
			axis = if axis and axis.Magnitude > 1e-3 then axis.Unit else nil,
			rps = spin and tonumber(spin.Rps) or 0,
			pulse = pulse,
			baseSize = part.Size,
			phase = spin and spin.Phase or 0,
		})
	end
end

-- Prototypes ------------------------------------------------------------------------
-- Each look is built once per size and cloned for every throw.

local function buildFallback(proto, skin, style, diameter, lite)
	local look = FALLBACK[skin.Id] or DEFAULT_FALLBACK
	local parts = style.Parts or {}
	local coreStyle = parts.Core
	local core = newPart("Core", Enum.PartType.Ball, Vector3.one * diameter * 0.56, skin.Color, skin.Material or Enum.Material.Neon)
	attach(proto, core, CFrame.new(), nil, if lite or not coreStyle then nil else coreStyle.Pulse)

	local shellColor = skin.Shell or skin.Color
	local shell = newPart("Shell", Enum.PartType.Ball, Vector3.one * diameter * 0.78, shellColor, look.shell, look.shellAlpha)
	attach(proto, shell, CFrame.new())
	if lite then
		return
	end

	local ringColor = skin.Ring or skin.Color
	-- ForceField hoops glow mostly at their rim, so a thin disc reads as a ring.
	-- A cylinder's flat faces point along X; rest tilts it, the spin swings it around.
	local ringSpins = {
		{ tilt = CFrame.Angles(0, 0, math.rad(70)), axis = Vector3.yAxis, rps = 0.45 },
		{ tilt = CFrame.Angles(math.rad(60), math.rad(90), 0), axis = Vector3.new(1, 0.3, 0), rps = -0.6 },
	}
	for i = 1, math.min(look.rings or 0, #ringSpins) do
		local spec = ringSpins[i]
		local ring = newPart("Ring" .. i, Enum.PartType.Cylinder, Vector3.new(diameter * 0.04, diameter, diameter), ringColor, Enum.Material.ForceField)
		attach(proto, ring, spec.tilt, { Axis = spec.axis, Rps = spec.rps, Phase = i * 0.37 })
	end
	if look.disk then
		local disk = newPart("Disk", Enum.PartType.Cylinder, Vector3.new(diameter * 0.03, diameter, diameter), ringColor, Enum.Material.Neon, 0.35)
		attach(proto, disk, CFrame.Angles(0, 0, math.rad(80)), { Axis = Vector3.new(0.17, 1, 0), Rps = 0.8 })
	end
	-- Shards circling the ball on a tilted orbit.
	local count = look.shards or 0
	local orbitAxis = Vector3.new(0.3, 1, 0.15).Unit
	for i = 1, count do
		local angle = (i - 1) / count * TAU
		local shard = newPart(
			"Shard" .. i,
			Enum.PartType.Block,
			Vector3.new(diameter * 0.09, diameter * 0.2, diameter * 0.09),
			ringColor,
			Enum.Material.Neon
		)
		local offset = CFrame.fromAxisAngle(orbitAxis, angle) * CFrame.new(diameter * 0.5, 0, 0)
		attach(proto, shard, offset * CFrame.Angles(math.rad(25), angle, math.rad(35)), { Axis = orbitAxis, Rps = 0.7 })
	end
end

-- "<Id>_<Part>" -> "<Part>" ("Core", "RingA"...).
local function partKey(skinId, part)
	local name = part.Name
	local prefix = skinId .. "_"
	if string.sub(name, 1, #prefix) == prefix then
		return string.sub(name, #prefix + 1)
	end
	return string.match(name, "_(%w+)$") or name
end

local function buildMesh(proto, skinId, style, template, diameter, lite)
	local model = template:Clone()
	if model:IsA("BasePart") then
		local wrapper = Instance.new("Model")
		model.Parent = wrapper
		model = wrapper
	end
	if not model:IsA("Model") then
		model:Destroy()
		return false
	end
	-- Imported FBX units can be off: fit the model's longest side to its real
	-- size from the manifest (style.Size at style.Diameter), drawn at `diameter`.
	local _, size = model:GetBoundingBox()
	local longest = math.max(size.X, size.Y, size.Z)
	if longest < 1e-3 then
		model:Destroy()
		return false
	end
	local target = diameter
	local styleSize = style.Size
	if typeof(styleSize) == "Vector3" then
		local real = math.max(styleSize.X, styleSize.Y, styleSize.Z)
		target = diameter * real / (tonumber(style.Diameter) or 2)
	end
	model:ScaleTo(model:GetScale() * target / longest)

	local parts = {}
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			table.insert(parts, item)
		end
	end
	-- Center on the core / heart / shell (centered on the model's origin), or
	-- else the middle of the whole model.
	local center = nil
	for _, key in CENTER_PARTS do
		for _, part in parts do
			if partKey(skinId, part) == key then
				center = part.Position
				break
			end
		end
		if center then
			break
		end
	end
	if not center then
		center = model:GetBoundingBox().Position
	end

	local partStyles = style.Parts or {}
	-- Lite: only the parts that don't spin (usually the core and shell).
	local keepStatic = false
	if lite then
		for _, part in parts do
			local partStyle = partStyles[partKey(skinId, part)]
			if not (partStyle and partStyle.Spin) then
				keepStatic = true
			end
		end
	end

	for index, part in parts do
		local key = partKey(skinId, part)
		local partStyle = partStyles[key]
		if keepStatic and partStyle and partStyle.Spin then
			continue
		end
		if partStyle then
			part.Color = partStyle.Color
			part.Material = partStyle.Material
			part.Transparency = partStyle.Transparency or 0
		end
		quiet(part, false)
		part.Name = key .. "_" .. index -- unique, so a clone can find its animated parts
		local rest = CFrame.new(part.Position - center) * part.CFrame.Rotation
		if lite or not partStyle then
			attach(proto, part, rest)
		else
			attach(proto, part, rest, partStyle.Spin, partStyle.Pulse)
		end
	end
	model:Destroy()
	return true
end

local function addFx(proto, skin, style, diameter, lite, scale)
	local root = proto.root
	local fx = style.Fx or {}

	-- Trail: two attachments above / below the center (the root never turns).
	local trailStyle = fx.Trail
	local trailColor = if trailStyle then trailStyle.Color else (skin.Trail or skin.Color)
	local trailColor2 = if trailStyle then (trailStyle.Color2 or trailColor) else trailColor
	local width = diameter * PREMIUM_TRAIL_WIDTH * (if trailStyle then (trailStyle.WidthScale or 1) else 1)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = (if trailStyle then (trailStyle.Lifetime or 0.3) else 0.3) * PREMIUM_TRAIL_LENGTH
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(trailColor, trailColor2)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.55, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new(1, 0.25)
	setBrightness(trail, TRAIL_BRIGHTNESS.premium)
	trail.Parent = root
	if lite then
		return
	end

	-- Every emitter is built (prototypes are cached for the whole session, whatever
	-- the graphics level was then); on Low, rebalance() keeps only the first one on.
	local low = graphicsLevel() == "Low"
	for index, spec in fx.Particles or {} do
		local size = spec.Size or { 0.3, 0 }
		local lifetime = spec.Lifetime or { 0.3, 0.6 }
		local speed = spec.Speed or { 1, 3 }
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Particles" .. index
		emitter.Texture = TEXTURES[spec.Texture] or TEXTURES.sparkle
		emitter.Color = ColorSequence.new(spec.Color or skin.Color)
		emitter.Size = NumberSequence.new(size[1] * scale, size[2] * scale)
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(lifetime[1], math.max(lifetime[1], lifetime[2]))
		emitter.Speed = NumberRange.new(speed[1] * scale, math.max(speed[1], speed[2]) * scale)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-120, 120)
		emitter.Drag = 3
		emitter.LightEmission = spec.LightEmission or 1
		emitter.Rate = spec.Rate or 10
		emitter.Enabled = not low or index == 1
		emitter.Parent = root
		table.insert(proto.emitters, { name = emitter.Name, rate = spec.Rate or 10, index = index })
	end

	local light = fx.Light
	if light and MAX_LIGHTS.High > 0 then
		local pointLight = Instance.new("PointLight")
		pointLight.Name = "Glow"
		pointLight.Color = light.Color
		pointLight.Range = math.clamp((light.Range or 8) * math.sqrt(scale), 4, 20)
		pointLight.Brightness = light.Brightness or 1
		pointLight.Shadows = false
		pointLight.Enabled = false -- switched on by the light budget
		pointLight.Parent = root
		proto.hasLight = true
	end
end

local prototypes = {} -- key -> prototype

local function prototypeFor(skin, radius, lite)
	local template = meshTemplate(skin.Id)
	local key = skin.Id .. ":" .. string.format("%.2f", radius) .. (if lite then ":lite" else "") .. (if template then ":mesh" else "")
	local proto = prototypes[key]
	if proto then
		return proto
	end

	local style = styleOf(skin.Id)
	local diameter = radius * VISUAL_SCALE
	local scale = diameter / (tonumber(style.Diameter) or 2)
	proto = { root = newRoot(diameter), anims = {}, emitters = {}, hasLight = false, mesh = false }
	if template then
		local ok, built = pcall(buildMesh, proto, skin.Id, style, template, diameter, lite)
		if ok and built then
			proto.mesh = true
		else
			if not ok then
				warn("[BallFx] could not use the model for", skin.Id, built)
			end
			proto.root:Destroy()
			proto = { root = newRoot(diameter), anims = {}, emitters = {}, hasLight = false, mesh = false }
		end
	end
	if not proto.mesh then
		buildFallback(proto, skin, style, diameter, lite)
	end
	addFx(proto, skin, style, diameter, lite, scale)
	prototypes[key] = proto
	return proto
end

-- Live premium balls + the one animation loop -------------------------------------------

local live = {} -- full-detail premium balls, oldest first
local entries = setmetatable({}, { __mode = "k" }) -- root -> entry

-- Shares particles and lights out over the live balls (newest get the light).
local function rebalance()
	local level = graphicsLevel()
	local count = #live
	local rateScale = math.clamp(PARTICLE_SHARE / math.max(count, 1), MIN_RATE_SCALE, 1)
	if level == "Low" then
		rateScale *= LOW_PARTICLE_SCALE
	end
	local lightsLeft = MAX_LIGHTS[level]
	for i = count, 1, -1 do
		local entry = live[i]
		for _, item in entry.emitters do
			item.emitter.Rate = item.rate * rateScale
			item.emitter.Enabled = level ~= "Low" or item.index == 1 -- Low: first emitter only
		end
		if entry.light then
			entry.light.Enabled = lightsLeft > 0
			lightsLeft -= 1
		end
	end
end

local function animate(entry, t, pulses)
	for _, anim in entry.anims do
		local c0 = anim.rest
		local pulse = anim.pulse
		if pulse and pulses then
			local s = pulse.Min + (pulse.Max - pulse.Min) * (0.5 + 0.5 * math.sin((t * pulse.Hz + entry.phase) * TAU))
			anim.part.Size = anim.baseSize * s
			c0 = CFrame.new(c0.Position * s) * c0.Rotation
		end
		if anim.axis then
			c0 = CFrame.fromAxisAngle(anim.axis, (t * anim.rps + anim.phase + entry.phase) * TAU) * c0
		end
		anim.joint.C0 = c0
	end
end

local function step()
	if #live == 0 then
		return
	end
	local t = os.clock()
	local cameraPosition = camera.CFrame.Position
	local pulses = graphicsLevel() ~= "Low"
	local removed = false
	for i = #live, 1, -1 do
		local entry = live[i]
		local root = entry.root
		if root.Parent == nil then
			table.remove(live, i)
			entries[root] = nil
			removed = true
		elseif (root.Position - cameraPosition).Magnitude < ANIMATE_RANGE then
			animate(entry, t, pulses)
		end
	end
	if removed then
		rebalance()
	end
end

local bound = false
local function ensureLoop()
	if bound then
		return
	end
	bound = true
	-- Right after RunController's step (Camera + 1), which moves the balls.
	RunService:BindToRenderStep("ShatterRunBallFx", Enum.RenderPriority.Camera.Value + 2, step)
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = workspace.CurrentCamera or camera
end)

local function fullCount()
	local count = 0
	for _, entry in live do
		if entry.root.Parent then
			count += 1
		end
	end
	return count
end

-- Plain skins: one ball part (the look the game always had), now always with a
-- trail in the skin's colors. trail = false: no trail (the shop preview).
local function plainBall(skin, radius, mega, trail)
	local part = Instance.new("Part")
	part.Name = if mega then "MegaBall" else "Ball"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * radius * 2
	part.Material = skin.Material
	part.Color = skin.Color
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false

	if skin.Rainbow then
		part.Color = Color3.fromHSV(os.clock() % 1, 0.8, 1)
	end

	if trail ~= false then
		local width = radius * PLAIN_TRAIL_WIDTH
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, width, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -width, 0)
		a1.Parent = part

		local streak = Instance.new("Trail")
		streak.Attachment0 = a0
		streak.Attachment1 = a1
		streak.Lifetime = PLAIN_TRAIL_LIFETIME
		streak.LightEmission = 1
		streak.FaceCamera = true
		if mega then
			streak.Color = ColorSequence.new(MEGA_COLOR)
		elseif skin.Rainbow then
			streak.Color = rainbowColors()
		else
			-- Skin color into its trail color (dark skins like Void glow in their trail color).
			streak.Color = ColorSequence.new(skin.Trail or skin.Color, skin.Color:Lerp(skin.Trail or skin.Color, 0.6))
		end
		streak.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.6, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
		streak.WidthScale = NumberSequence.new(1, 0.3)
		setBrightness(streak, TRAIL_BRIGHTNESS.plain)
		streak.Parent = part
	end
	return part
end

-- Over budget: the oldest full-detail ball stops animating and sparkling (it's
-- far down the corridor by now) so the one just thrown can be full detail.
local function demoteOldest()
	for i = 1, #live do
		local entry = live[i]
		if entry.root.Parent then
			table.remove(live, i)
			entries[entry.root] = nil
			for _, item in entry.emitters do
				item.emitter.Enabled = false
			end
			if entry.light then
				entry.light.Enabled = false
			end
			return true
		end
	end
	return false
end

-- Longer trails at high speed (options.trailScale), shorter on Low graphics.
local function scaleTrail(root, trailScale)
	local trail = root:FindFirstChildOfClass("Trail")
	if not trail then
		return
	end
	local scale = trailScale or 1
	if graphicsLevel() == "Low" then
		scale *= LOW_TRAIL_SCALE
	end
	trail.Lifetime = math.min(trail.Lifetime * scale, TRAIL_MAX_LIFETIME)
end

function BallFx.create(skinId, radius, options)
	options = options or {}
	local skin = Config.getSkin(skinId)
	local root
	if not skin.Premium then
		root = plainBall(skin, radius, options.mega)
		scaleTrail(root, options.trailScale)
		root.Parent = options.parent
		return root
	end

	local lite = options.lite == true
	if not lite then
		local most = MAX_FULL[graphicsLevel()]
		while fullCount() >= most do
			if not (options.priority and demoteOldest()) then
				lite = true
				break
			end
		end
	end
	local proto = prototypeFor(skin, radius, lite)
	root = proto.root:Clone()
	root.Name = if options.mega then "MegaBall" else "Ball"
	scaleTrail(root, options.trailScale)
	if not lite then
		local entry = { root = root, anims = {}, emitters = {}, light = nil, phase = math.random() }
		for _, anim in proto.anims do
			local part = root:FindFirstChild(anim.name)
			local joint = part and part:FindFirstChild("Joint")
			if joint then
				table.insert(entry.anims, {
					part = part,
					joint = joint,
					rest = anim.rest,
					axis = anim.axis,
					rps = anim.rps,
					pulse = anim.pulse,
					baseSize = anim.baseSize,
					phase = anim.phase,
				})
			end
		end
		for _, item in proto.emitters do
			local emitter = root:FindFirstChild(item.name)
			if emitter then
				table.insert(entry.emitters, { emitter = emitter, rate = item.rate, index = item.index })
			end
		end
		entry.light = if proto.hasLight then root:FindFirstChild("Glow") else nil
		table.insert(live, entry)
		entries[root] = entry
		ensureLoop()
		rebalance()
	end
	root.Parent = options.parent
	return root
end

function BallFx.destroy(ball)
	if ball == nil then
		return
	end
	local entry = entries[ball]
	if entry then
		entries[ball] = nil
		local index = table.find(live, entry)
		if index then
			table.remove(live, index)
		end
		ball:Destroy()
		rebalance()
		return
	end
	ball:Destroy()
end

-- Shop preview ----------------------------------------------------------------------------
-- An anchored copy (ViewportFrames have no physics, so the parts are placed directly).

function BallFx.preview(skinId, diameter)
	local skin = Config.getSkin(skinId)
	local radius = diameter / VISUAL_SCALE
	local model = Instance.new("Model")
	model.Name = "BallPreview"
	local anims = {}

	if skin.Premium then
		local proto = prototypeFor(skin, radius, false)
		local root = proto.root:Clone()
		for _, item in root:GetDescendants() do
			if item:IsA("BasePart") then
				item.Anchored = true
			elseif item:IsA("JointInstance") or item:IsA("Trail") or item:IsA("ParticleEmitter") or item:IsA("Light") then
				item:Destroy()
			end
		end
		-- Every part starts at its rest place (the clone keeps the prototype's).
		for _, anim in proto.anims do
			local part = root:FindFirstChild(anim.name)
			if part then
				table.insert(anims, {
					part = part,
					rest = anim.rest,
					axis = anim.axis,
					rps = anim.rps,
					pulse = anim.pulse,
					baseSize = anim.baseSize,
					phase = anim.phase,
				})
			end
		end
		root.Parent = model
		model.PrimaryPart = root
	else
		local part = plainBall(skin, diameter / 2, false, false) -- no trail in a viewport
		part.Parent = model
		model.PrimaryPart = part
	end

	local preview = { model = model, mesh = skin.Premium == true and BallFx.hasMesh(skinId) }
	function preview.step(t)
		for _, anim in anims do
			local c0 = anim.rest
			local pulse = anim.pulse
			if pulse then
				local s = pulse.Min + (pulse.Max - pulse.Min) * (0.5 + 0.5 * math.sin(t * pulse.Hz * TAU))
				anim.part.Size = anim.baseSize * s
				c0 = CFrame.new(c0.Position * s) * c0.Rotation
			end
			if anim.axis then
				c0 = CFrame.fromAxisAngle(anim.axis, (t * anim.rps + anim.phase) * TAU) * c0
			end
			anim.part.CFrame = c0
		end
	end
	function preview.destroy()
		model:Destroy()
	end
	return preview
end

-- The ball in your hand ----------------------------------------------------------------
-- Every part is anchored and placed directly each frame (one BulkMoveTo), so it
-- sticks to the camera exactly, with no physics or weld lag at full speed.

function BallFx.held(skinId, diameter, particleScale)
	local skin = Config.getSkin(skinId)
	local held = { skinId = skin.Id, mesh = false }
	local low = graphicsLevel() == "Low"
	local parts = {} -- BulkMoveTo list (the root is last)
	local cframes = {}
	local items = {} -- one per visible part: { part, rest, baseSize, axis, rps, phase, pulse }
	local root
	local plain = nil

	if skin.Premium then
		local proto = prototypeFor(skin, diameter / VISUAL_SCALE, false)
		held.mesh = proto.mesh
		root = proto.root:Clone()
		local animByName = {}
		for _, anim in proto.anims do
			animByName[anim.name] = anim
		end
		for _, child in root:GetChildren() do
			if child:IsA("BasePart") then
				local joint = child:FindFirstChild("Joint")
				local rest = if joint then joint.C0 else CFrame.new()
				if joint then
					joint:Destroy()
				end
				child.Anchored = true
				local anim = animByName[child.Name]
				table.insert(items, {
					part = child,
					rest = rest,
					baseSize = child.Size,
					axis = anim and anim.axis,
					rps = anim and anim.rps or 0,
					phase = anim and anim.phase or 0,
					pulse = anim and anim.pulse,
				})
				table.insert(parts, child)
			end
		end
		-- No trail (it would smear as the camera moves) and no light (costly this
		-- close to the walls). Particles stay, locked to the ball so they travel with it.
		for _, item in root:GetDescendants() do
			if item:IsA("Trail") or item:IsA("Light") then
				item:Destroy()
			elseif item:IsA("ParticleEmitter") then
				local index = tonumber(string.match(item.Name, "%d+")) or 1
				item.LockedToPart = true
				item.Rate *= HELD_PARTICLE_SCALE * (particleScale or 1) * (if low then LOW_PARTICLE_SCALE else 1)
				item.Enabled = not low or index == 1
			end
		end
	else
		root = plainBall(skin, diameter / 2, false, false)
		plain = root
		table.insert(items, { part = root, rest = CFrame.new(), baseSize = root.Size, rps = 0, phase = 0 })
		table.insert(parts, root)
	end
	root.Name = "HeldBall"
	if skin.Premium then
		table.insert(parts, root) -- the invisible center carries the particles
	end
	held.root = root

	local lastScale = 1
	local pulses = not low
	-- cframe: the ball's center (and how it's turned). scale: 1 = `diameter` across.
	function held.place(cframe, scale, t)
		local resize = scale ~= lastScale
		lastScale = scale
		for i, item in items do
			local rest = item.rest
			local s = scale
			local pulse = item.pulse
			if pulse and pulses then
				s *= pulse.Min + (pulse.Max - pulse.Min) * (0.5 + 0.5 * math.sin(t * pulse.Hz * TAU))
				item.part.Size = item.baseSize * s
			elseif resize then
				item.part.Size = item.baseSize * s
			end
			local c0 = CFrame.new(rest.Position * s) * rest.Rotation
			if item.axis then
				c0 = CFrame.fromAxisAngle(item.axis, (t * item.rps + item.phase) * TAU) * c0
			end
			cframes[i] = cframe * c0
		end
		if plain then
			if skin.Rainbow then
				plain.Color = Color3.fromHSV((t * 0.2) % 1, 0.8, 1)
			end
		else
			cframes[#items + 1] = cframe
		end
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	function held.destroy()
		root:Destroy()
	end
	return held
end

-- Impact colors ---------------------------------------------------------------------------

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- The two colors a ball's impact splash uses: its trail color and its own color
-- (very dark balls like Void / Obsidian use a lighter mix so the splash shows).
function BallFx.impactStyle(skinId)
	local skin = Config.getSkin(skinId)
	local trail = styleOf(skin.Id).Fx and styleOf(skin.Id).Fx.Trail
	local color = if trail then trail.Color else (skin.Trail or skin.Color)
	local color2 = if trail and trail.Color2 then trail.Color2 else skin.Color
	if luminance(color2) < 0.25 then
		color2 = color:Lerp(Color3.new(1, 1, 1), 0.3)
	end
	if luminance(color) < 0.25 then
		color = color2
	end
	return {
		id = skin.Id,
		color = color,
		color2 = color2,
		rainbow = skin.Rainbow == true,
		premium = skin.Premium == true,
	}
end

-- Settings: switching graphics re-shares particles / lights right away.
Settings.changed:Connect(function(key)
	if key == "graphics" then
		rebalance()
	end
end)

return BallFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[--[[
	Room decoration: gives every room details that match its zone (Config.Themes[].Style).
	TrackBuilder builds the bare shell (floor, ceiling, walls, ribs), then calls Decor.decorate.

	Golden rule: nothing here enters the flight path, the box in the middle of the corridor
	between knee and ceiling height (|x| < 6.5, 2 < y < 12 from the floor). Decor hugs the walls,
	lies on the floor or hangs above y = 12, so the player always sees the obstacles clearly.

	Kinds: "Wall" for solid decoration (balls bounce off), "Prop" for breakable glass.
	A breakable made of several parts is a Model with attribute Breakable = true:
	hitting any of its parts shatters the whole thing.

	Props that have a Blender model (Models.luau) use it through Kit:place / Kit:wallProp;
	when the model isn't loaded (ID 0 in Config.Models) those return nil and the
	part-built version below is made instead, exactly as before.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Models = require(script.Parent.Models)
local ModelStyles = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelStyles"))

local Decor = {}

local BAYS = { 5, 15, 25, 35, 45, 55, 65, 75 } -- wall bays between the ribs (depth into the room)
local SIDES = { -1, 1 }
local GATE_DEPTH = 5 -- where the zone entrance showpiece stands
local MIN_BREAKABLES = 3
local GLOBE_SPOTS = { 15, 35, 55 } -- ceiling spots for extra breakables when a room has too few

local Block = Enum.PartType.Block
local BallShape = Enum.PartType.Ball
local CylinderShape = Enum.PartType.Cylinder
local Material = Enum.Material

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder's axis from X to Y
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- turns a cylinder's axis from X to Z
local QUARTER_TURN = math.rad(90)

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local METAL = Color3.fromRGB(150, 158, 170)

-- Simple line drawings, as segments { u1, v1, u2, v2 }: u = depth (positive = further down
-- the corridor), v = up. Used for neon signs, wall runes and floor runes.
local GLYPHS = {
	Arrow = { { -2, 0, 2, 0 }, { 2, 0, 0.8, 1.2 }, { 2, 0, 0.8, -1.2 } },
	Bolt = { { -1.6, 1.4, 0.3, 0.2 }, { 0.3, 0.2, -0.3, -0.2 }, { -0.3, -0.2, 1.6, -1.4 } },
	Diamond = { { 0, 1.4, 1.4, 0 }, { 1.4, 0, 0, -1.4 }, { 0, -1.4, -1.4, 0 }, { -1.4, 0, 0, 1.4 } },
	Chevrons = { { -1.8, 1.2, -0.6, 0 }, { -0.6, 0, -1.8, -1.2 }, { 0.2, 1.2, 1.4, 0 }, { 1.4, 0, 0.2, -1.2 } },
	Star = { { -1.5, 0, 1.5, 0 }, { 0, -1.5, 0, 1.5 }, { -1, -1, 1, 1 }, { -1, 1, 1, -1 } },
	Eye = { { -1.6, 0, 0, 1 }, { 0, 1, 1.6, 0 }, { 1.6, 0, 0, -1 }, { 0, -1, -1.6, 0 }, { 0, 0.35, 0, -0.35 } },
	Hex = {
		{ 1.5, 0, 0.75, 1.3 },
		{ 0.75, 1.3, -0.75, 1.3 },
		{ -0.75, 1.3, -1.5, 0 },
		{ -1.5, 0, -0.75, -1.3 },
		{ -0.75, -1.3, 0.75, -1.3 },
		{ 0.75, -1.3, 1.5, 0 },
	},
}
local GLYPH_NAMES = { "Arrow", "Bolt", "Diamond", "Chevrons", "Star", "Eye" }

-- Drawing kit ----------------------------------------------------------------------
-- Wraps builder.newPart with room coordinates: x across (0 = middle), y up from the floor,
-- d depth into the room (0 = room entrance, 80 = room end).

local Kit = {}
Kit.__index = Kit

local function newKit(builder, room, info)
	return setmetatable({
		newPart = builder.newPart,
		origin = builder.ORIGIN,
		half = builder.WIDTH / 2,
		height = builder.HEIGHT,
		length = builder.LENGTH,
		folder = room.folder,
		startZ = info.startZ,
		rng = info.rng,
		theme = info.theme,
		breakables = 0,
		maxBreakables = info.rng:NextInteger(5, 8),
		low = info.low == true, -- Low graphics: no little animations
	}, Kit)
end

function Kit:pos(x, y, d)
	return Vector3.new(self.origin.X + x, self.origin.Y + y, self.startZ - d)
end

function Kit:at(x, y, d)
	return CFrame.new(self:pos(x, y, d))
end

-- x of a point `inset` studs in front of the wall on `side` (-1 left, 1 right).
function Kit:wallX(side, inset)
	return side * (self.half - inset)
end

function Kit:random(min, max)
	return self.rng:NextNumber(min, max)
end

function Kit:chance(probability)
	return self.rng:NextNumber() < probability
end

function Kit:pick(list)
	return list[self.rng:NextInteger(1, #list)]
end

-- options = { { weight, value }, ... }
function Kit:pickWeighted(options)
	local total = 0
	for _, option in options do
		total += option[1]
	end
	local roll = self.rng:NextNumber() * total
	for _, option in options do
		roll -= option[1]
		if roll <= 0 then
			return option[2]
		end
	end
	return options[#options][2]
end

function Kit:part(parent, kind, shape, size, cframe, color, material, extra)
	local props = {
		Shape = shape,
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material or Material.SmoothPlastic,
	}
	if extra then
		for name, value in extra do
			props[name] = value
		end
	end
	return self.newPart(parent, kind, props)
end

-- Solid decoration ----------------------------------------------------------------

function Kit:block(size, cframe, color, material)
	return self:part(self.folder, "Wall", Block, size, cframe, color, material)
end

function Kit:glow(size, cframe, color)
	return self:part(self.folder, "Wall", Block, size, cframe, color, Material.Neon)
end

function Kit:ball(diameter, cframe, color, material)
	return self:part(self.folder, "Wall", BallShape, Vector3.one * diameter, cframe, color, material)
end

-- A cylinder lying along the X axis of cframe.
function Kit:rod(length, diameter, cframe, color, material)
	return self:part(self.folder, "Wall", CylinderShape, Vector3.new(length, diameter, diameter), cframe, color, material)
end

-- A standing cylinder from height y0 up to y0 + height.
function Kit:post(x, y0, height, diameter, d, color, material)
	return self:rod(height, diameter, self:at(x, y0 + height / 2, d) * UPRIGHT, color, material)
end

-- A straight bar between two world points. `up` must not be parallel to the bar:
-- it sets which way `depth` faces (Vector3.xAxis for drawings on a wall, yAxis on the floor).
function Kit:bar(p1, p2, width, depth, up, color, material, parent, kind)
	local length = (p2 - p1).Magnitude + width -- a little longer so joints close up
	local cframe = CFrame.lookAt((p1 + p2) / 2, p2, up)
	return self:part(parent or self.folder, kind or "Wall", Block, Vector3.new(width, depth, length), cframe, color, material)
end

-- Same settings newPart uses, for the one shape it can't make.
function Kit:wedge(size, cframe, color, material)
	local wedge = Instance.new("WedgePart")
	wedge.Anchored = true
	wedge.CanCollide = false
	wedge.CanTouch = false
	wedge.CastShadow = false
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Material.SmoothPlastic
	wedge:SetAttribute("Kind", "Wall")
	wedge.Parent = self.folder
	return wedge
end

-- Neon line drawing flat against a wall, centered at depth d and height y.
function Kit:wallGlyph(segments, side, inset, d, y, scale, thickness, color, parent, kind)
	local x = self:wallX(side, inset)
	for _, s in segments do
		local p1 = self:pos(x, y + s[2] * scale, d + s[1] * scale)
		local p2 = self:pos(x, y + s[4] * scale, d + s[3] * scale)
		self:bar(p1, p2, thickness, thickness, Vector3.xAxis, color, Material.Neon, parent, kind)
	end
end

-- Neon line drawing lying on the floor (v becomes x).
function Kit:floorGlyph(segments, x, d, scale, color)
	for _, s in segments do
		local p1 = self:pos(x + s[2] * scale, 0.03, d + s[1] * scale)
		local p2 = self:pos(x + s[4] * scale, 0.03, d + s[3] * scale)
		self:bar(p1, p2, 0.22, 0.04, Vector3.yAxis, color, Material.Neon)
	end
end

-- Models -----------------------------------------------------------------------------

-- Places a Blender model in the room folder, or returns nil if it isn't available
-- (the caller then builds its part version). Breakable models count as breakables.
function Kit:place(name, cframe, options)
	local model = Models.place(name, self.folder, cframe, options)
	if model == nil then
		return nil
	end
	local style = ModelStyles[name]
	if style and style.Breakable then
		self.breakables += 1
	end
	return model
end

-- Places a wall model (origin at the center of its back face, front toward -Z in Blender)
-- with its back `inset` studs off the wall on `side` and its front facing into the corridor.
-- y is the model's anchor point (options.anchor: "floor", "ceiling" or "center").
-- The long side of the model ends up running along the corridor.
function Kit:wallProp(name, side, inset, y, d, options)
	local style = ModelStyles[name]
	if style == nil then
		return nil
	end
	options = options or {}
	local depth = style.Size.Z * (options.scale or 1)
	local cframe = self:at(self:wallX(side, inset + depth / 2), y, d) * CFrame.Angles(0, side * QUARTER_TURN, 0)
	return self:place(name, cframe, options)
end

-- Places a Blender model scaled to fit inside `box` (X across the corridor, Y up,
-- Z along it), so it stays in its spot whatever size the model was made at.
-- Returns nil if the model isn't available (the caller builds its part version).
-- options.spin (radians) turns it around its up axis; then the box must hold it at any angle.
function Kit:fitted(name, cframe, box, options)
	local style = ModelStyles[name]
	if style == nil or style.Size == nil or not Models.has(name) then
		return nil
	end
	options = table.clone(options or {})
	local size = style.Size
	local scale
	if options.spin then
		local footprint = math.sqrt(size.X * size.X + size.Z * size.Z)
		scale = math.min(math.min(box.X, box.Z) / footprint, box.Y / size.Y)
		cframe = cframe * CFrame.Angles(0, options.spin, 0)
		options.spin = nil
	else
		scale = math.min(box.X / size.X, box.Y / size.Y, box.Z / size.Z)
	end
	options.scale = scale
	return self:place(name, cframe, options)
end

-- Like Kit:wallProp, but scaled to fit `box` (X along the wall, Y up, Z out of the wall).
function Kit:wallFitted(name, side, inset, y, d, box, options)
	local style = ModelStyles[name]
	if style == nil or style.Size == nil or not Models.has(name) then
		return nil
	end
	local size = style.Size
	options = table.clone(options or {})
	options.scale = math.min(box.X / size.X, box.Y / size.Y, box.Z / size.Z)
	local depth = size.Z * options.scale
	local cframe = self:at(self:wallX(side, inset + depth / 2), y, d) * CFrame.Angles(0, side * QUARTER_TURN, 0)
	return self:place(name, cframe, options)
end

-- Marks a part as fixed in place: balls never knock it loose (moving parts, light strips).
function Kit:fixed(part)
	part:SetAttribute("Shell", true)
	return part
end

-- A small looping animation (TweenService). Skipped on Low graphics.
-- The part is marked fixed, so a ball never knocks it loose mid-animation.
function Kit:animate(part, goal, duration, reverses, style)
	self:fixed(part)
	if self.low then
		return
	end
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverses == true)
	TweenService:Create(part, info, goal):Play()
end

-- Solid see-through decoration (water, light haze).
function Kit:haze(size, cframe, color, transparency, material)
	return self:part(self.folder, "Wall", Block, size, cframe, color, material or Material.Neon, {
		Transparency = transparency,
	})
end

-- Breakables -----------------------------------------------------------------------

function Kit:canBreak()
	return self.breakables < self.maxBreakables
end

-- Starts a breakable made of several parts; fill it with Kit:glass / Kit:inner.
function Kit:breakable(name)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Breakable", true)
	model.Parent = self.folder
	self.breakables += 1
	return model
end

-- Glass piece. With parent = nil it is a breakable of its own.
function Kit:glass(parent, shape, size, cframe, color, transparency)
	if parent == nil then
		self.breakables += 1
	end
	return self:part(parent or self.folder, "Prop", shape, size, cframe, color, Material.Glass, {
		Name = "GlassProp",
		Transparency = transparency or 0.35,
		Reflectance = 0.25,
	})
end

-- Something inside a glass breakable (a glow, a plant, liquid). Shatters with it.
function Kit:inner(parent, shape, size, cframe, color, material)
	return self:part(parent, "Prop", shape, size, cframe, color, material or Material.Neon)
end

-- Glass tinted toward the zone color.
function Kit:tint(amount)
	return self.theme.Accent:Lerp(WHITE, amount or 0.45)
end

-- Shared props -----------------------------------------------------------------------

-- Round glass vase standing with its base at height y.
local function vase(kit, x, y, d, color, scale)
	if kit:place("GlassVase", kit:at(x, y, d), { anchor = "floor", scale = scale * 0.85, colors = { Glass = color } }) then
		return
	end
	local model = kit:breakable("Vase")
	local body = 1.6 * scale
	kit:glass(model, BallShape, Vector3.one * body, kit:at(x, y + body / 2, d), color)
	kit:glass(model, CylinderShape, Vector3.new(0.9, 0.7, 0.7) * scale, kit:at(x, y + body + 0.3 * scale, d) * UPRIGHT, color)
end

-- Wide-bellied urn with a neck and a lip.
local function urn(kit, x, y, d, color, scale)
	if kit:place("GlassUrn", kit:at(x, y, d), { anchor = "floor", scale = scale * 0.9, colors = { Glass = color } }) then
		return
	end
	local model = kit:breakable("Urn")
	kit:glass(model, BallShape, Vector3.one * 1.8 * scale, kit:at(x, y + 0.9 * scale, d), color, 0.25)
	kit:glass(model, CylinderShape, Vector3.new(0.6, 0.9, 0.9) * scale, kit:at(x, y + 1.95 * scale, d) * UPRIGHT, color, 0.25)
	kit:glass(model, CylinderShape, Vector3.new(0.2, 1.3, 1.3) * scale, kit:at(x, y + 2.3 * scale, d) * UPRIGHT, color, 0.25)
end

-- Glass ball with a glowing heart.
local function orb(kit, x, y, d, size, color)
	local placed = kit:place("GlassOrb", kit:at(x, y, d), {
		anchor = "center",
		scale = size / 2.3,
		colors = { Glass = color, Neon = kit.theme.Accent },
	})
	if placed then
		return
	end
	local model = kit:breakable("Orb")
	kit:glass(model, BallShape, Vector3.one * size, kit:at(x, y, d), color, 0.4)
	kit:inner(model, BallShape, Vector3.one * size * 0.35, kit:at(x, y, d), kit.theme.Accent)
end

-- Glass lantern hanging on a chain from the ceiling; y is its bottom.
local function lantern(kit, x, y, d, color)
	local placed = kit:place("GlassLantern", kit:at(x, y, d), {
		anchor = "floor",
		colors = { Glass = color, Neon = kit.theme.Accent },
	})
	if placed then
		local hook = y + ModelStyles.GlassLantern.Size.Y
		kit:post(x, hook, kit.height - hook, 0.12, d, Color3.fromRGB(60, 55, 50), Material.Metal)
		return
	end
	local top = y + 1.6
	kit:post(x, top, kit.height - top, 0.12, d, Color3.fromRGB(60, 55, 50), Material.Metal)
	local model = kit:breakable("Lantern")
	kit:glass(model, Block, Vector3.new(1.1, 1.6, 1.1), kit:at(x, y + 0.8, d), color, 0.3)
	kit:inner(model, BallShape, Vector3.one * 0.55, kit:at(x, y + 0.8, d), kit.theme.Accent)
end

-- Small glass globe lamp right under the ceiling (stays above the flight path anywhere).
local function ceilingGlobe(kit, x, d)
	kit:post(x, kit.height - 0.45, 0.45, 0.15, d, METAL, Material.Metal)
	orb(kit, x, kit.height - 1.05, d, 1.3, kit:tint(0.6))
end

-- Three crystals growing from a point; y is their base.
local function crystalCluster(kit, x, y, d, color)
	local model = kit:breakable("CrystalCluster")
	local spin = kit:random(0, math.pi)
	kit:glass(model, Block, Vector3.new(0.6, 2, 0.6), kit:at(x, y + 1, d) * CFrame.Angles(0, spin, 0), color, 0.2)
	kit:glass(model, Block, Vector3.new(0.45, 1.3, 0.45), kit:at(x, y + 0.6, d - 0.5) * CFrame.Angles(-0.5, 0, 0), color, 0.2)
	kit:glass(model, Block, Vector3.new(0.45, 1.3, 0.45), kit:at(x, y + 0.6, d + 0.5) * CFrame.Angles(0.5, 0, 0), color, 0.2)
end

-- The zone name painted on a sign, facing the player coming down the corridor.
local function nameplate(kit, part, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- +Z, toward the approaching player
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = kit.theme.Name or ""
	label.TextScaled = true
	label.Font = Enum.Font.Michroma
	label.TextColor3 = color
	label.Parent = gui
	gui.Parent = part
end

local function nothing() end

-- Lab: clean white panels, glass partitions, benches with test tubes ---------------------

local LAB_DARK = Color3.fromRGB(55, 62, 75)
local LAB_ROOM = Color3.fromRGB(38, 52, 66) -- the side labs seen through the windows
local LAB_RACK = Color3.fromRGB(35, 38, 45)
local LAB_YELLOW = Color3.fromRGB(255, 205, 40)
local LAB_LIGHT = Color3.fromRGB(235, 248, 255)
local LIQUIDS = {
	Color3.fromRGB(90, 255, 140),
	Color3.fromRGB(255, 90, 170),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(120, 160, 255),
}
local LED_COLORS = { Color3.fromRGB(80, 255, 140), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 170, 60) }

local Lab = {}

function Lab.room(kit)
	local L, H = kit.length, kit.height
	local seam = kit.theme.Wall:Lerp(BLACK, 0.18)
	for _, side in SIDES do
		-- Panel seams along the walls.
		for _, y in { 4.5, 9.5 } do
			kit:block(Vector3.new(0.06, 0.12, L), kit:at(kit:wallX(side, 0.03), y, L / 2), seam)
		end
		-- Pipes along the ceiling corners.
		if kit:chance(0.75) then
			-- Four pipe segments end to end, hanging from the ceiling corner (the part version is two long rods).
			local segment = L / 4
			local pipeScale = segment / ModelStyles.PipeRun.Size.X
			local placed = 0
			for i = 1, 4 do
				local options = { anchor = "ceiling", scale = pipeScale, colors = { Metal = kit.theme.Accent } }
				if kit:wallProp("PipeRun", side, 0, H, (i - 0.5) * segment, options) then
					placed += 1
				end
			end
			if placed == 0 then
				kit:rod(L, 0.7, kit:at(kit:wallX(side, 1.2), H - 0.6, L / 2) * ALONG_Z, METAL, Material.Metal)
				kit:rod(L, 0.35, kit:at(kit:wallX(side, 2.1), H - 0.35, L / 2) * ALONG_Z, kit.theme.Accent)
			end
		end
		-- Warning stripes along the floor edges.
		kit:block(Vector3.new(0.6, 0.04, L), kit:at(side * 8.7, 0.02, L / 2), LAB_YELLOW)
		kit:block(Vector3.new(0.2, 0.05, L), kit:at(side * 8.7, 0.025, L / 2), LAB_DARK)
	end
	-- Ceiling light panels.
	for d = 10, L - 10, 20 do
		-- 1.25x: 5 wide, 1.14 deep, so its underside stays above the flight path (y = 12).
		local light = kit:place("CeilingLight", kit:at(0, H, d), { anchor = "ceiling", scale = 1.25 })
		if not light then
			kit:glow(Vector3.new(5, 0.12, 2.5), kit:at(0, H - 0.06, d), LAB_LIGHT)
		end
	end
end

local function labPoster(kit, side, d)
	local hazard = kit:chance(0.5)
	local y = kit:random(5.5, 7.5)
	kit:block(Vector3.new(0.08, 2.6, 2), kit:at(kit:wallX(side, 0.04), y, d), if hazard then LAB_YELLOW else kit.theme.Accent)
	local mark = CFrame.Angles(math.rad(45), 0, 0) -- a diamond symbol
	kit:block(Vector3.new(0.06, 0.9, 0.9), kit:at(kit:wallX(side, 0.1), y, d) * mark, if hazard then LAB_DARK else WHITE)
end

-- Glass partition looking into a side lab.
local function labWindow(kit, side, d)
	if not kit:canBreak() then
		return labPoster(kit, side, d)
	end
	local frame = kit.theme.Wall:Lerp(BLACK, 0.25)
	kit:block(Vector3.new(0.1, 6, 7), kit:at(kit:wallX(side, 0.07), 6.5, d), LAB_ROOM)
	kit:glow(Vector3.new(0.08, 0.25, 6.6), kit:at(kit:wallX(side, 0.14), 9.1, d), kit:tint(0.5))
	kit:block(Vector3.new(0.7, 0.3, 7.4), kit:at(kit:wallX(side, 0.35), 3.35, d), frame)
	kit:block(Vector3.new(0.7, 0.3, 7.4), kit:at(kit:wallX(side, 0.35), 9.65, d), frame)
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 6, 7), kit:at(kit:wallX(side, 0.45), 6.5, d), kit:tint(0.6), 0.5)
	pane.Name = "LabWindow"
end

-- Rack of colored test tubes; y is the bench top.
local function testTubes(kit, x, y, d, side)
	if Models.has("TestTubeRack") then -- (checked first so the part version draws the same random numbers)
		local rack = kit:place("TestTubeRack", kit:at(x, y, d) * CFrame.Angles(0, side * QUARTER_TURN, 0), {
			anchor = "floor",
			colors = { Neon = kit:pick(LIQUIDS) },
		})
		if rack then
			return
		end
	end
	kit:block(Vector3.new(0.5, 0.25, 2.4), kit:at(x, y + 1.1, d), LAB_DARK)
	local model = kit:breakable("TestTubes")
	for _, offset in { -0.75, 0, 0.75 } do
		kit:glass(model, CylinderShape, Vector3.new(1.6, 0.32, 0.32), kit:at(x, y + 0.8, d + offset) * UPRIGHT, kit:pick(LIQUIDS), 0.2)
	end
end

-- Round flask with colored liquid; y is the bench top.
local function flask(kit, x, y, d)
	if Models.has("Flask") then
		local placed = kit:place("Flask", kit:at(x, y, d), {
			anchor = "floor",
			colors = { Glass = kit:tint(0.7), Neon = kit:pick(LIQUIDS) },
		})
		if placed then
			return
		end
	end
	local model = kit:breakable("Flask")
	kit:glass(model, BallShape, Vector3.one * 1.3, kit:at(x, y + 0.65, d), kit:tint(0.7), 0.5)
	kit:glass(model, CylinderShape, Vector3.new(0.8, 0.32, 0.32), kit:at(x, y + 1.6, d) * UPRIGHT, kit:tint(0.7), 0.5)
	kit:inner(model, BallShape, Vector3.one * 0.9, kit:at(x, y + 0.55, d), kit:pick(LIQUIDS), Material.SmoothPlastic)
end

local function labBench(kit, side, d)
	-- Scaled so the bench top sits at 3.25, where the glassware stands.
	local benchScale = 3.25 / ModelStyles.LabBench.Size.Y
	local bench = kit:wallProp("LabBench", side, 0, 0, d, { anchor = "floor", scale = benchScale })
	if not bench then
		kit:block(Vector3.new(2.2, 3, 6), kit:at(kit:wallX(side, 1.2), 1.5, d), kit.theme.Wall:Lerp(BLACK, 0.1))
		kit:block(Vector3.new(2.6, 0.25, 6.4), kit:at(kit:wallX(side, 1.35), 3.125, d), LAB_DARK)
	end
	if kit:canBreak() then
		testTubes(kit, kit:wallX(side, 1.6), 3.25, d - 1.5, side)
	end
	if kit:canBreak() then
		flask(kit, kit:wallX(side, 1.5), 3.25, d + 1.5)
	end
end

local function serverRacks(kit, side, d)
	local count = kit:pick({ 1, 2 })
	for i = 1, count do
		local rackD = if count == 1 then d else d + (if i == 1 then -1.9 else 1.9)
		local ledColor = kit:pick(LED_COLORS)
		-- 1.2x makes the rack 8.4 tall and 3.6 long, which still fits two per bay.
		local rack = kit:wallProp("ServerRack", side, 0, 0, rackD, { anchor = "floor", scale = 1.2, colors = { Neon = ledColor } })
		if not rack then
			kit:block(Vector3.new(1.8, 9, 3.4), kit:at(kit:wallX(side, 0.9), 4.5, rackD), LAB_RACK)
			kit:glow(Vector3.new(0.05, 7, 0.2), kit:at(kit:wallX(side, 1.83), 4.8, rackD + 0.9), ledColor)
		end
	end
end

-- Glass case on a pedestal with a glowing sample inside.
local function displayCase(kit, side, d)
	if not kit:canBreak() then
		return labPoster(kit, side, d)
	end
	local x = kit:wallX(side, 1.4)
	kit:block(Vector3.new(2, 2.5, 2), kit:at(x, 1.25, d), LAB_DARK)
	local model = kit:breakable("DisplayCase")
	kit:glass(model, Block, Vector3.new(1.8, 2, 1.8), kit:at(x, 3.5, d), kit:tint(0.7), 0.55)
	local sample = CFrame.Angles(math.rad(45), math.rad(45), 0)
	kit:inner(model, Block, Vector3.one * 0.7, kit:at(x, 3.3, d) * sample, kit:pick(LIQUIDS))
end

Lab.features = {
	{ 3, labWindow },
	{ 3, labBench },
	{ 2, serverRacks },
	{ 2, displayCase },
	{ 1, labPoster },
	{ 3, nothing },
}

-- Airlock frame with blinking beacons.
function Lab.gate(kit, d)
	local H = kit.height
	local frame = kit.theme.Wall:Lerp(BLACK, 0.3)
	for _, side in SIDES do
		kit:block(Vector3.new(3, H, 1.6), kit:at(side * 8.5, H / 2, d), frame)
		kit:glow(Vector3.new(0.2, 11.6, 0.3), kit:at(side * 6.9, 6, d - 0.6), kit.theme.Accent)
		kit:ball(0.8, kit:at(side * 7.6, 12.2, d - 1.1), Color3.fromRGB(255, 120, 40), Material.Neon)
	end
	local header = kit:block(Vector3.new(14, 1.6, 1.6), kit:at(0, H - 0.8, d), frame)
	nameplate(kit, header, kit.theme.Accent)
	kit:glow(Vector3.new(14, 0.2, 0.3), kit:at(0, 12.2, d - 0.6), kit.theme.Accent)
	kit:block(Vector3.new(14, 0.04, 1.6), kit:at(0, 0.02, d), LAB_YELLOW)
end

-- Neon city: dark alley, glowing signs, billboards, cables --------------------------------

local NEON_DARK = Color3.fromRGB(18, 18, 26)
local NEON_CABLE = Color3.fromRGB(12, 12, 16)
local NEON_COLORS = {
	Color3.fromRGB(0, 230, 255),
	Color3.fromRGB(255, 220, 60),
	Color3.fromRGB(120, 255, 110),
	Color3.fromRGB(180, 90, 255),
}

local Neon = {}

local function neonColor(kit)
	return if kit:chance(0.35) then kit.theme.Accent else kit:pick(NEON_COLORS)
end

function Neon.room(kit)
	local L, H = kit.length, kit.height
	local accent = kit.theme.Accent
	local grid = accent:Lerp(BLACK, 0.45)
	-- Glowing floor grid.
	for d = 10, L - 10, 20 do
		kit:glow(Vector3.new(18.6, 0.04, 0.15), kit:at(0, 0.02, d), grid)
	end
	for _, x in { -4, 4 } do
		kit:glow(Vector3.new(0.15, 0.04, L), kit:at(x, 0.02, L / 2), grid)
	end
	for _, side in SIDES do
		-- Guide light low on the walls, like a subway tunnel.
		kit:glow(Vector3.new(0.06, 0.2, L), kit:at(kit:wallX(side, 0.03), 1.2, L / 2), accent)
		-- Cables sagging between the ceiling corners.
		local x = kit:wallX(side, 1.1)
		local d = kit:random(2, 14)
		while d < L - 14 do
			local span = kit:random(8, 12)
			local sag = kit:random(0.8, 1.4)
			local a = kit:pos(x, H - 0.2, d)
			local mid = kit:pos(x, H - 0.2 - sag, d + span / 2)
			local b = kit:pos(x, H - 0.2, d + span)
			kit:bar(a, mid, 0.15, 0.15, Vector3.xAxis, NEON_CABLE)
			kit:bar(mid, b, 0.15, 0.15, Vector3.xAxis, NEON_CABLE)
			d += span + kit:random(14, 26)
		end
	end
	-- Ceiling vents.
	for _, d in { 25, 65 } do
		kit:block(Vector3.new(3, 0.1, 2), kit:at(kit:random(-4, 4), H - 0.05, d), NEON_DARK:Lerp(WHITE, 0.15), Material.DiamondPlate)
	end
end

local function billboard(kit, side, d)
	local y = kit:random(5.5, 7.5)
	local main = neonColor(kit)
	local second = main:Lerp(WHITE, 0.6)
	kit:block(Vector3.new(0.2, 4.6, 7), kit:at(kit:wallX(side, 0.1), y, d), NEON_DARK)
	kit:block(Vector3.new(0.1, 4, 6.4), kit:at(kit:wallX(side, 0.25), y, d), main:Lerp(BLACK, 0.25))
	kit:block(Vector3.new(0.08, 1.2, 3), kit:at(kit:wallX(side, 0.33), y + kit:random(-0.8, 0.8), d + kit:random(-1.2, 1.2)), second)
	kit:glow(Vector3.new(0.3, 0.15, 6.6), kit:at(kit:wallX(side, 0.5), y + 2.45, d), WHITE)
end

-- Neon line drawing behind a glass cover, on a dark board.
local function neonSign(kit, side, d)
	if not kit:canBreak() then
		return billboard(kit, side, d)
	end
	local color = neonColor(kit)
	kit:block(Vector3.new(0.15, 4, 6), kit:at(kit:wallX(side, 0.08), 7, d), NEON_DARK)
	local model = kit:breakable("NeonSign")
	kit:wallGlyph(GLYPHS[kit:pick(GLYPH_NAMES)], side, 0.3, d, 7, 1, 0.22, color, model, "Prop")
	kit:glass(model, Block, Vector3.new(0.08, 3.8, 5.8), kit:at(kit:wallX(side, 0.5), 7, d), color:Lerp(WHITE, 0.7), 0.7)
end

local function wallVent(kit, side, d)
	local y = kit:random(3, 10)
	if kit:wallProp("Vent", side, 0.02, y, d, { anchor = "center", scale = 1.25 }) then
		return
	end
	kit:block(Vector3.new(0.4, 2.4, 3), kit:at(kit:wallX(side, 0.2), y, d), NEON_DARK:Lerp(WHITE, 0.1), Material.Metal)
	for _, offset in { -0.45, 0.45 } do
		kit:block(Vector3.new(0.1, 0.18, 2.8), kit:at(kit:wallX(side, 0.45), y + offset, d), NEON_CABLE)
	end
end

-- Upright glass tubes with a glowing gas core.
local function neonTubes(kit, side, d)
	if not kit:canBreak() then
		return wallVent(kit, side, d)
	end
	local count = if kit.breakables + 1 < kit.maxBreakables and kit:chance(0.5) then 2 else 1
	local x = kit:wallX(side, 0.6)
	for i = 1, count do
		local tubeD = if count == 1 then d else d + (if i == 1 then -1.5 else 1.5)
		local color = neonColor(kit)
		-- The model is a horizontal tube on brackets; two of them stack instead of sitting side by side.
		local tubeY = if count == 1 then 6.5 else 6.5 + (if i == 1 then -1.6 else 1.6)
		local tube = kit:wallProp("NeonTube", side, 0.05, tubeY, d, { anchor = "center", scale = 1.4, colors = { Neon = color } })
		if tube then
			continue
		end
		local cframe = kit:at(x, 6.5, tubeD) * UPRIGHT
		local model = kit:breakable("NeonTube")
		kit:glass(model, CylinderShape, Vector3.new(6, 0.6, 0.6), cframe, color:Lerp(WHITE, 0.6), 0.6)
		kit:inner(model, CylinderShape, Vector3.new(5.8, 0.25, 0.25), cframe, color)
	end
end

-- A locked service hatch with a light stripe.
local function serviceHatch(kit, side, d)
	kit:block(Vector3.new(0.1, 7, 4), kit:at(kit:wallX(side, 0.05), 3.5, d), NEON_DARK)
	kit:glow(Vector3.new(0.12, 0.3, 4), kit:at(kit:wallX(side, 0.1), 5, d), neonColor(kit))
end

Neon.features = {
	{ 3, neonSign },
	{ 2, billboard },
	{ 2, wallVent },
	{ 2, neonTubes },
	{ 1, serviceHatch },
	{ 3, nothing },
}

-- Double neon arch with the zone name on a hanging sign.
function Neon.gate(kit, d)
	local colors = { kit.theme.Accent, NEON_COLORS[1] }
	for i, color in colors do
		local archD = d + (i - 1) * 1.5
		for _, side in SIDES do
			kit:glow(Vector3.new(0.4, 12.3, 0.4), kit:at(kit:wallX(side, 0.6), 6.15, archD), color)
		end
		kit:glow(Vector3.new(19.2, 0.4, 0.4), kit:at(0, 12.5, archD), color)
	end
	local board = kit:block(Vector3.new(10, 1.2, 0.3), kit:at(0, 13.3, d), NEON_DARK)
	nameplate(kit, board, kit.theme.Accent)
	kit:glow(Vector3.new(15, 0.04, 0.3), kit:at(0, 0.02, d), kit.theme.Accent)
end

-- Temple: sandstone pillars and arches, carvings, braziers, urns ---------------------------

local PILLAR_DEPTHS = { 20, 40, 60 }
local TEMPLE_RUNNER = Color3.fromRGB(150, 55, 40)
local TEMPLE_GOLD = Color3.fromRGB(230, 180, 60)
local TEMPLE_BRONZE = Color3.fromRGB(150, 95, 45)
local TEMPLE_FLAME = Color3.fromRGB(255, 230, 120)
local URN_COLORS = {
	Color3.fromRGB(60, 170, 170),
	Color3.fromRGB(70, 110, 220),
	Color3.fromRGB(230, 170, 60),
	Color3.fromRGB(200, 80, 60),
}
-- Raised shapes inside carved panels, as { u, v, width, height }.
local CARVINGS = {
	{ { 0, 0, 3.4, 0.5 }, { 0, 0, 1, 1 } }, -- eye
	{ { 0, -1.2, 3.6, 0.5 }, { 0, -0.4, 2.6, 0.5 }, { 0, 0.4, 1.6, 0.5 } }, -- stepped pyramid
	{ { 0, -0.3, 0.5, 3 }, { 0, 0.6, 2.4, 0.5 } }, -- cross
	{ { -1, 0, 0.5, 3 }, { 1, 0, 0.5, 3 }, { 0, 1.25, 2.5, 0.5 } }, -- gateway
}

local Temple = {}

local function stone(kit, amount)
	return kit.theme.Wall:Lerp(BLACK, amount)
end

function Temple.room(kit)
	local L = kit.length
	-- Red runner with gold borders down the middle of the floor.
	kit:block(Vector3.new(7, 0.04, L), kit:at(0, 0.02, L / 2), TEMPLE_RUNNER:Lerp(kit.theme.Accent, 0.2))
	for _, x in { -3.65, 3.65 } do
		kit:block(Vector3.new(0.3, 0.05, L), kit:at(x, 0.025, L / 2), TEMPLE_GOLD)
	end
	for _, d in PILLAR_DEPTHS do
		for _, side in SIDES do
			-- The model is 14 tall; 13/14 makes it end right under the beam (y = 13).
			local pillar = kit:place("Pillar", kit:at(side * 8.6, 0, d), {
				anchor = "floor",
				scale = 13 / ModelStyles.Pillar.Size.Y,
				colors = { Stone = stone(kit, 0.04) },
			})
			if not pillar then
				kit:post(side * 8.6, 0, 10, 2.2, d, stone(kit, 0.04), Material.Sandstone)
				kit:block(Vector3.new(3, 1, 3), kit:at(side * 8.5, 10.5, d), stone(kit, 0.15))
			end
			-- Arch shoulder: a wedge between the capital and the beam, sloping toward the middle.
			-- Its full faces point up (under the beam) and out (against the wall).
			local shoulder = CFrame.fromMatrix(kit:pos(side * 8.3, 12, d), Vector3.new(0, 0, side), Vector3.new(0, -1, 0))
			kit:wedge(Vector3.new(2.4, 2, 3.4), shoulder, stone(kit, 0.15))
		end
		kit:block(Vector3.new(20, 1, 2.4), kit:at(0, 13.5, d), stone(kit, 0.15))
	end
end

local function carving(kit, side, d)
	local y = kit:random(5.5, 7)
	kit:block(Vector3.new(0.1, 4.4, 4.4), kit:at(kit:wallX(side, 0.05), y, d), stone(kit, 0.22))
	local relief = kit.theme.Wall:Lerp(kit.theme.Accent, 0.25)
	for _, r in kit:pick(CARVINGS) do
		kit:block(Vector3.new(0.12, r[4], r[3]), kit:at(kit:wallX(side, 0.15), y + r[2], d + r[1]), relief)
	end
end

local function brazier(kit, side, d)
	local x = kit:wallX(side, 1.8)
	if kit:place("Brazier", kit:at(x, 0, d), { anchor = "floor", colors = { Neon = kit.theme.Accent } }) then
		return
	end
	kit:post(x, 0, 2.6, 0.5, d, TEMPLE_BRONZE, Material.Metal)
	kit:post(x, 2.6, 0.5, 1.8, d, TEMPLE_BRONZE, Material.Metal)
	kit:ball(1.1, kit:at(x, 3.35, d), kit.theme.Accent, Material.Neon)
	kit:ball(0.6, kit:at(x, 3.85, d), TEMPLE_FLAME, Material.Neon)
end

local function urnOnPedestal(kit, side, d)
	if not kit:canBreak() then
		return carving(kit, side, d)
	end
	local x = kit:wallX(side, 1.6)
	kit:block(Vector3.new(1.8, 1.2, 1.8), kit:at(x, 0.6, d), stone(kit, 0.15))
	urn(kit, x, 1.2, d, kit:pick(URN_COLORS), kit:random(0.9, 1.15))
end

local function vaseShelf(kit, side, d)
	if not kit:canBreak() then
		return carving(kit, side, d)
	end
	kit:block(Vector3.new(1.6, 0.3, 5), kit:at(kit:wallX(side, 0.8), 4.5, d), stone(kit, 0.2))
	for _, offset in { -1.5, 1.5 } do
		if kit:canBreak() then
			vase(kit, kit:wallX(side, 1), 4.65, d + offset, kit:pick(URN_COLORS):Lerp(WHITE, 0.2), 0.75)
		end
	end
end

local function templeLantern(kit, side, d)
	if not kit:canBreak() then
		return carving(kit, side, d)
	end
	lantern(kit, kit:wallX(side, 2), kit:random(8.5, 10), d, kit:tint(0.5))
end

Temple.features = {
	{ 3, carving },
	{ 2, brazier },
	{ 3, urnOnPedestal },
	{ 2, vaseShelf },
	{ 2, templeLantern },
	{ 5, nothing },
}

-- Massive stone gate with the zone name on the lintel, flames on either side.
function Temple.gate(kit, d)
	for _, side in SIDES do
		kit:block(Vector3.new(3.4, 12, 3), kit:at(side * 8.3, 6, d), stone(kit, 0.18))
		kit:glow(Vector3.new(0.6, 11, 0.1), kit:at(side * 7.1, 6, d - 1.55), kit.theme.Accent)
		brazier(kit, side, d + 4)
	end
	local lintel = kit:block(Vector3.new(20, 2, 3.6), kit:at(0, 13, d), stone(kit, 0.25))
	nameplate(kit, lintel, TEMPLE_GOLD)
end

-- Greenhouse: glass roof frames, planters, vines, terrariums ------------------------------

local GH_FRAME = Color3.fromRGB(95, 115, 105)
local GH_SKY = Color3.fromRGB(120, 190, 140)
local GH_OUTSIDE = Color3.fromRGB(70, 150, 95)
local GH_POT = Color3.fromRGB(175, 90, 60)
local GH_TRUNK = Color3.fromRGB(100, 70, 45)
local LEAVES = {
	Color3.fromRGB(60, 170, 80),
	Color3.fromRGB(40, 130, 60),
	Color3.fromRGB(110, 200, 90),
}
local FLOWERS = { Color3.fromRGB(255, 120, 180), Color3.fromRGB(255, 220, 70), Color3.fromRGB(180, 130, 255) }

local Greenhouse = {}

local function leaf(kit)
	return kit:pick(LEAVES)
end

function Greenhouse.room(kit)
	local L, H = kit.length, kit.height
	-- Daylight through the roof, crossed by metal frames.
	kit:glow(Vector3.new(19, 0.05, L), kit:at(0, H - 0.04, L / 2), GH_SKY)
	for d = 10, L - 10, 10 do
		kit:block(Vector3.new(20, 0.4, 0.4), kit:at(0, H - 0.3, d), GH_FRAME, Material.Metal)
	end
	for _, x in { -3.3, 3.3 } do
		kit:block(Vector3.new(0.4, 0.4, L), kit:at(x, H - 0.3, L / 2), GH_FRAME, Material.Metal)
	end
	-- Watering pipe with sprinkler heads along one ceiling corner.
	local pipeX = kit:wallX(kit:pick(SIDES), 0.8)
	kit:rod(L, 0.35, kit:at(pipeX, 12.8, L / 2) * ALONG_Z, GH_FRAME, Material.Metal)
	for d = 25, L - 15, 40 do
		kit:post(pipeX, 12.25, 0.55, 0.25, d, GH_FRAME, Material.Metal)
	end
	-- Vines hanging from the ceiling corners.
	for _, side in SIDES do
		for _ = 1, kit.rng:NextInteger(2, 3) do
			local d = kit:random(3, L - 3)
			local length = kit:random(2.5, 5)
			local x = kit:wallX(side, kit:random(0.4, 0.9))
			-- The model hangs 5.43 long; scaled to this vine's length and set against the wall.
			local vineScale = length / ModelStyles.HangingVine.Size.Y
			local vineX = kit:wallX(side, 0.1 + ModelStyles.HangingVine.Size.X * vineScale / 2)
			local vine = nil
			if Models.has("HangingVine") then -- (checked first so the part version draws the same random numbers)
				vine = kit:place("HangingVine", kit:at(vineX, H, d), {
					anchor = "ceiling",
					scale = vineScale,
					colors = { Plant = leaf(kit) },
				})
			end
			if not vine then
				kit:block(Vector3.new(0.15, length, 0.15), kit:at(x, H - length / 2, d), LEAVES[2], Material.Grass)
				if kit:chance(0.6) then
					kit:ball(0.7, kit:at(x, H - length, d), leaf(kit), Material.Grass)
				end
			end
		end
	end
end

-- A leafy Plant model standing on the floor (or a planter); `scale` 1.2 is 3.1 wide, still clear of the flight path.
local function plantModel(kit, x, y, d, scale)
	if not Models.has("Plant") then
		return nil
	end
	return kit:place("Plant", kit:at(x, y, d), { anchor = "floor", scale = scale, colors = { Plant = leaf(kit) } })
end

local function fern(kit, side, d)
	local x = kit:wallX(side, 1.3)
	local plantX = kit:wallX(side, 1.6) -- far enough off the wall for the model's width
	if plantModel(kit, plantX, 0, d - 1, 1.2) then
		plantModel(kit, plantX, 0, d + 1.2, 0.9)
		return
	end
	kit:ball(2.2, kit:at(x, 1, d - 1), leaf(kit), Material.Grass)
	kit:ball(1.6, kit:at(x, 0.7, d + 1.2), leaf(kit), Material.Grass)
	if kit:chance(0.5) then
		kit:ball(0.5, kit:at(x, 2.05, d - 1), kit:pick(FLOWERS), Material.Neon)
	end
end

local function planter(kit, side, d)
	local x = kit:wallX(side, 1.4)
	-- 1.5x: 6 long, 2.4 deep, 1.8 tall, the same footprint as the block version; two plants grow on top.
	if kit:wallProp("Planter", side, 0, 0, d, { anchor = "floor", scale = 1.5 }) then
		local soil = ModelStyles.Planter.Size.Y * 1.5 - 0.1
		local plantX = kit:wallX(side, 1.8)
		plantModel(kit, plantX, soil, d - 1.5, 1.2)
		plantModel(kit, plantX, soil, d + 1.5, 1.2)
		return
	end
	kit:block(Vector3.new(2.4, 1.4, 6), kit:at(x, 0.7, d), GH_POT)
	kit:post(x, 1.4, 2.8, 0.4, d, GH_TRUNK, Material.Wood)
	kit:ball(2.4, kit:at(x, 4.9, d), leaf(kit), Material.Grass)
	kit:ball(1.8, kit:at(x, 2.2, d + kit:pick({ -1.8, 1.8 })), leaf(kit), Material.Grass)
end

-- Glass box with a little plant inside, on a metal stand.
local function terrarium(kit, side, d)
	if not kit:canBreak() then
		return fern(kit, side, d)
	end
	local x = kit:wallX(side, 1.4)
	kit:block(Vector3.new(1.8, 2.4, 1.8), kit:at(x, 1.2, d), GH_FRAME, Material.Metal)
	local model = kit:breakable("Terrarium")
	kit:glass(model, Block, Vector3.new(1.7, 1.7, 1.7), kit:at(x, 3.25, d), kit:tint(0.6), 0.45)
	kit:inner(model, BallShape, Vector3.one * 0.9, kit:at(x, 2.85, d), leaf(kit), Material.Grass)
	kit:inner(model, BallShape, Vector3.one * 0.35, kit:at(x, 3.35, d), kit:pick(FLOWERS))
end

-- Breakable greenhouse wall panel with the garden glowing behind it.
local function wallPane(kit, side, d)
	if not kit:canBreak() then
		return fern(kit, side, d)
	end
	kit:glow(Vector3.new(0.1, 6.6, 6.6), kit:at(kit:wallX(side, 0.05), 6.5, d), GH_OUTSIDE)
	kit:block(Vector3.new(0.2, 6.8, 0.25), kit:at(kit:wallX(side, 0.2), 6.5, d), GH_FRAME, Material.Metal)
	kit:block(Vector3.new(0.2, 0.25, 6.8), kit:at(kit:wallX(side, 0.2), 6.5, d), GH_FRAME, Material.Metal)
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 6.4, 6.4), kit:at(kit:wallX(side, 0.45), 6.5, d), kit:tint(0.55), 0.5)
	pane.Name = "GreenhousePane"
end

local function hangingBasket(kit, side, d)
	local x = kit:wallX(side, 2.2)
	kit:post(x, 11, 3, 0.1, d, GH_FRAME, Material.Metal)
	kit:post(x, 10.4, 0.6, 1.4, d, GH_TRUNK, Material.Wood)
	kit:ball(1.4, kit:at(x, 10.3, d), leaf(kit), Material.Grass)
	kit:block(Vector3.new(0.15, 2, 0.15), kit:at(x + side * 0.4, 9.6, d + 0.3), LEAVES[2], Material.Grass)
end

Greenhouse.features = {
	{ 3, planter },
	{ 2, terrarium },
	{ 2, wallPane },
	{ 2, fern },
	{ 1, hangingBasket },
	{ 3, nothing },
}

-- Leafy trellis arch with the zone name.
function Greenhouse.gate(kit, d)
	for _, side in SIDES do
		kit:block(Vector3.new(0.6, 12.6, 0.6), kit:at(side * 8, 6.3, d), GH_FRAME, Material.Metal)
		for _, y in { 3, 6.5, 10 } do
			kit:ball(1.6, kit:at(side * 8, y, d), leaf(kit), Material.Grass)
		end
		kit:ball(1.4, kit:at(side * 5.5, 13.2, d), leaf(kit), Material.Grass)
	end
	kit:block(Vector3.new(16.6, 0.6, 0.6), kit:at(0, 12.6, d), GH_FRAME, Material.Metal)
	local board = kit:block(Vector3.new(8, 1.2, 0.2), kit:at(0, 13.3, d - 0.5), GH_TRUNK, Material.Wood)
	nameplate(kit, board, Color3.fromRGB(230, 255, 220))
end

-- Void: windows to space, floating glass orbs and shards, glowing runes -------------------

local VOID_SPACE = Color3.fromRGB(12, 6, 24)
local VOID_ROCK = Color3.fromRGB(45, 35, 60)
local VOID_PLANETS = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 170, 70) }

local Void = {}

function Void.room(kit)
	local L, H = kit.length, kit.height
	-- Starry ceiling.
	kit:block(Vector3.new(19, 0.05, L), kit:at(0, H - 0.03, L / 2), VOID_SPACE)
	for _ = 1, 8 do
		local size = kit:random(0.12, 0.25)
		local color = if kit:chance(0.3) then kit.theme.Accent else WHITE
		kit:glow(Vector3.new(size, 0.04, size), kit:at(kit:random(-9, 9), H - 0.07, kit:random(1, L - 1)), color)
	end
	-- Glowing runes on the floor.
	for _, d in { 25, 55 } do
		kit:floorGlyph(GLYPHS[kit:pick(GLYPH_NAMES)], kit:random(-3, 3), d + kit:random(-4, 4), 0.8, kit.theme.Accent)
	end
end

-- A dark "window" into space with a far planet and drifting rocks.
local function spaceWindow(kit, side, d)
	kit:block(Vector3.new(0.1, 6, 6.5), kit:at(kit:wallX(side, 0.06), 6.5, d), VOID_SPACE)
	for _, y in { 3.4, 9.6 } do
		kit:glow(Vector3.new(0.2, 0.2, 6.9), kit:at(kit:wallX(side, 0.15), y, d), kit.theme.Accent)
	end
	kit:ball(0.9, kit:at(kit:wallX(side, 0.55), kit:random(5, 8), d + kit:random(-2, 2)), kit:pick(VOID_PLANETS), Material.Neon)
	local size = kit:random(0.6, 1.1)
	local spin = CFrame.Angles(kit:random(0, math.pi), kit:random(0, math.pi), kit:random(0, math.pi))
	local cframe = kit:at(kit:wallX(side, 1), kit:random(4, 9), d + kit:random(-2.5, 2.5)) * spin
	kit:block(Vector3.new(size, size * 0.7, size), cframe, VOID_ROCK)
end

local function rune(kit, side, d)
	kit:wallGlyph(GLYPHS[kit:pick(GLYPH_NAMES)], side, 0.1, d, kit:random(5, 8), kit:random(0.7, 0.9), 0.2, kit.theme.Accent)
end

local function floatingOrb(kit, side, d)
	if not kit:canBreak() then
		return rune(kit, side, d)
	end
	local size = kit:random(1.4, 2)
	orb(kit, kit:wallX(side, kit:random(1.6, 2.2)), kit:random(4, 10), d, size, kit:pick(VOID_PLANETS):Lerp(WHITE, 0.5))
end

-- Loose glass shards floating near the wall, each one breakable on its own.
local function shards(kit, side, d)
	if not kit:canBreak() then
		return rune(kit, side, d)
	end
	for _ = 1, kit.rng:NextInteger(2, 3) do
		if not kit:canBreak() then
			break
		end
		local size = Vector3.new(0.15, kit:random(1.4, 2.4), kit:random(0.6, 1.1))
		local spin = CFrame.Angles(kit:random(-0.6, 0.6), kit:random(0, math.pi), kit:random(-0.6, 0.6))
		local cframe = kit:at(kit:wallX(side, kit:random(1.3, 1.8)), kit:random(3.5, 10.5), d + kit:random(-3, 3)) * spin
		local shard = kit:glass(nil, Block, size, cframe, kit:tint(0.55), 0.3)
		shard.Name = "Shard"
	end
end

-- Floating rock with a crystal cluster growing on top.
local function crystalRock(kit, side, d)
	if not kit:canBreak() then
		return spaceWindow(kit, side, d)
	end
	local x = kit:wallX(side, 1.7)
	local y = kit:random(2.5, 7)
	kit:block(Vector3.new(2, 1.1, 2), kit:at(x, y, d) * CFrame.Angles(0, kit:random(0, math.pi), kit:random(-0.2, 0.2)), VOID_ROCK)
	crystalCluster(kit, x, y + 0.4, d, kit:tint(0.35))
end

Void.features = {
	{ 3, spaceWindow },
	{ 3, floatingOrb },
	{ 2, shards },
	{ 2, rune },
	{ 2, crystalRock },
	{ 3, nothing },
}

-- Glowing portal frame with the zone name and two guardian crystals.
function Void.gate(kit, d)
	for _, side in SIDES do
		kit:block(Vector3.new(2, kit.height, 1.2), kit:at(side * 9, kit.height / 2, d), VOID_SPACE)
		kit:glow(Vector3.new(0.5, 12.8, 0.5), kit:at(side * 7.6, 6.4, d), kit.theme.Accent)
		if kit:canBreak() then
			crystalCluster(kit, side * 8.3, 0, d + 3.5, kit:tint(0.35))
		end
	end
	kit:glow(Vector3.new(15.7, 0.5, 0.5), kit:at(0, 12.55, d), kit.theme.Accent)
	local top = kit:block(Vector3.new(16, 1.2, 1.2), kit:at(0, 13.4, d), VOID_SPACE)
	nameplate(kit, top, kit.theme.Accent)
	kit:glow(Vector3.new(15.2, 0.04, 0.5), kit:at(0, 0.02, d), kit.theme.Accent)
end

-- Frost caverns: glacier walls, icicles, snow drifts, ice sculptures --------------------

local FROST_ICE = Color3.fromRGB(190, 230, 250)
local FROST_DEEP = Color3.fromRGB(110, 170, 220)
local FROST_SNOW = Color3.fromRGB(240, 247, 255)
local FROST_ROCK = Color3.fromRGB(95, 118, 145)
local FROST_CAVE = Color3.fromRGB(20, 45, 80) -- the dark ice seen through frozen windows

local Frost = {}

-- One icicle hanging from the ceiling at (x, d), `length` long.
-- glassy = true makes it a breakable (glass) icicle on its own.
local function icicle(kit, x, d, length, glassy)
	local H = kit.height
	if not glassy then
		local placed = kit:fitted("Icicle", kit:at(x, H, d), Vector3.new(0.9, length, 0.9), { anchor = "ceiling" })
		if placed then
			return
		end
		kit:block(Vector3.new(0.55, length * 0.6, 0.55), kit:at(x, H - length * 0.3, d), FROST_ICE, Material.Ice)
		kit:block(Vector3.new(0.3, length * 0.45, 0.3), kit:at(x, H - length * 0.775 + 0.05, d) * CFrame.Angles(0, math.rad(45), 0), FROST_ICE, Material.Ice)
		return
	end
	local shard = kit:glass(nil, Block, Vector3.new(0.35, length, 0.35), kit:at(x, H - length / 2, d) * CFrame.Angles(0, math.rad(45), 0), kit:tint(0.7), 0.25)
	shard.Name = "GlassIcicle"
end

-- Snow drift against a wall: a long wedge, tall at the wall and low toward the middle.
local function snowDrift(kit, side, d, length, height, depth)
	local position = kit:pos(kit:wallX(side, depth / 2), height / 2, d)
	local cframe = CFrame.fromMatrix(position, Vector3.new(0, 0, -side), Vector3.yAxis)
	kit:wedge(Vector3.new(length, height, depth), cframe, FROST_SNOW, Material.Snow)
end

function Frost.room(kit)
	local L, H = kit.length, kit.height
	for _, side in SIDES do
		-- Snow drifts along the bottom of the walls.
		local d = kit:random(1, 6)
		while d < L - 8 do
			local length = kit:random(8, 14)
			snowDrift(kit, side, math.min(d + length / 2, L - length / 2), length, kit:random(0.7, 1.5), kit:random(2, 3.2))
			d += length + kit:random(8, 16)
		end
		-- Icy light along the ceiling corners.
		kit:fixed(kit:glow(Vector3.new(0.25, 0.25, L), kit:at(kit:wallX(side, 0.3), H - 0.3, L / 2), kit.theme.Accent:Lerp(WHITE, 0.5)))
		-- Rock and ice bulging out of the walls.
		for _ = 1, 2 do
			local size = Vector3.new(1.2, kit:random(1.5, 3), kit:random(2, 4))
			local cframe = kit:at(kit:wallX(side, 0.6), kit:random(2.5, 11.5), kit:random(4, L - 4)) * CFrame.Angles(kit:random(-0.6, 0.6), 0, 0)
			kit:block(size, cframe, if kit:chance(0.5) then FROST_ROCK else FROST_DEEP, Material.Glacier)
		end
	end
	-- Icicles: long ones near the walls, short ones over the middle (above the flight path).
	for _ = 1, kit.rng:NextInteger(4, 7) do
		local nearWall = kit:chance(0.6)
		if nearWall then
			icicle(kit, kit:pick(SIDES) * kit:random(7.2, 9.2), kit:random(2, L - 2), kit:random(1.5, 4))
		else
			icicle(kit, kit:random(-6, 6), kit:random(2, L - 2), kit:random(0.8, 1.6))
		end
	end
	-- Cracks in the frozen floor.
	for _ = 1, kit.rng:NextInteger(1, 2) do
		local x, d = kit:random(-5, 5), kit:random(8, L - 8)
		for _ = 1, 3 do
			local nx, nd = math.clamp(x + kit:random(-2.5, 2.5), -7, 7), math.clamp(d + kit:random(-3.5, 3.5), 2, L - 2)
			kit:bar(kit:pos(x, 0.03, d), kit:pos(nx, 0.03, nd), 0.12, 0.03, Vector3.yAxis, kit.theme.Accent:Lerp(WHITE, 0.6), Material.Neon)
			x, d = nx, nd
		end
	end
end

-- A clump of ice crystals growing from the floor by the wall.
local function iceCluster(kit, side, d)
	local x = kit:wallX(side, 1.5)
	if kit:fitted("IceCluster", kit:at(x, 0, d), Vector3.new(2.6, 3.2, 3.4), { anchor = "floor", spin = kit:random(0, math.pi) }) then
		return
	end
	for i = 1, 4 do
		local height = kit:random(1.4, 3.2)
		local width = kit:random(0.7, 1.1)
		local tilt = CFrame.Angles(kit:random(-0.2, 0.2), kit:random(0, math.pi), side * kit:random(0.05, 0.2))
		local cframe = kit:at(kit:wallX(side, kit:random(1.3, 1.8)), height / 2 + 0.15, d + (i - 2.5) * 0.8) * tilt
		kit:block(Vector3.new(width, height, width), cframe, if i % 2 == 0 then FROST_ICE else FROST_DEEP, Material.Ice)
	end
	kit:ball(1.4, kit:at(kit:wallX(side, 1.3), 0.6, d), FROST_SNOW, Material.Snow)
end

-- A tall frozen column from floor to ceiling.
local function frozenPillar(kit, side, d)
	local x = kit:wallX(side, 1.5)
	if kit:fitted("FrozenPillar", kit:at(x, 0, d), Vector3.new(2.6, kit.height, 2.6), { anchor = "floor" }) then
		return
	end
	kit:post(x, 0, kit.height, 2.2, d, FROST_ICE, Material.Glacier)
	kit:block(Vector3.new(3, 0.7, 3), kit:at(x, 0.35, d), FROST_SNOW, Material.Snow)
	kit:block(Vector3.new(3, 1, 3), kit:at(x, kit.height - 0.5, d), FROST_DEEP, Material.Ice)
end

-- An ice sculpture (a glowing star of ice) on a snow block. Breakable.
local function iceSculpture(kit, side, d)
	if not kit:canBreak() then
		return iceCluster(kit, side, d)
	end
	local x = kit:wallX(side, 1.6)
	kit:block(Vector3.new(2, 1.2, 2), kit:at(x, 0.6, d), FROST_SNOW, Material.Snow)
	local placed = kit:fitted("IceSculpture", kit:at(x, 1.2, d), Vector3.new(2, 3.4, 2), {
		anchor = "floor",
		spin = kit:random(0, math.pi),
		colors = { Glass = kit:tint(0.7) },
	})
	if placed then
		return
	end
	local model = kit:breakable("IceSculpture")
	local center = kit:at(x, 3.2, d)
	for i = 0, 2 do
		local arm = center * CFrame.Angles(i * math.pi / 3, 0, 0)
		kit:glass(model, Block, Vector3.new(0.4, 2.6, 0.4), arm, kit:tint(0.7), 0.2)
	end
	kit:glass(model, BallShape, Vector3.one * 1.1, kit:at(x, 1.75, d), kit:tint(0.75), 0.25)
	kit:inner(model, BallShape, Vector3.one * 0.5, center, kit.theme.Accent)
end

-- A window of thick ice with a glowing crystal frozen inside. Breakable.
local function frozenWindow(kit, side, d)
	if not kit:canBreak() then
		return iceCluster(kit, side, d)
	end
	kit:block(Vector3.new(0.1, 6, 7), kit:at(kit:wallX(side, 0.07), 6.5, d), FROST_CAVE)
	local spin = CFrame.Angles(kit:random(0, math.pi), 0, 0)
	kit:glow(Vector3.new(0.3, 1.8, 0.9), kit:at(kit:wallX(side, 0.3), kit:random(5.5, 7.5), d + kit:random(-1.5, 1.5)) * spin, kit.theme.Accent)
	for _, y in { 3.35, 9.65 } do
		kit:block(Vector3.new(0.7, 0.35, 7.4), kit:at(kit:wallX(side, 0.35), y, d), FROST_DEEP, Material.Glacier)
	end
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 6, 7), kit:at(kit:wallX(side, 0.45), 6.5, d), kit:tint(0.65), 0.45)
	pane.Name = "IceWindow"
end

-- Glass icicles hanging by the wall, each one breakable.
local function hangingIcicles(kit, side, d)
	if not kit:canBreak() then
		return iceCluster(kit, side, d)
	end
	kit:block(Vector3.new(1.2, 0.4, 5), kit:at(kit:wallX(side, 0.6), kit.height - 0.2, d), FROST_SNOW, Material.Snow)
	for i = 1, kit.rng:NextInteger(2, 3) do
		if not kit:canBreak() then
			break
		end
		icicle(kit, kit:wallX(side, kit:random(0.9, 2.2)), d + (i - 2) * 1.6, kit:random(1.6, 3.5), true)
	end
end

-- Glowing crystal veins in the ice wall.
local function frostVein(kit, side, d)
	kit:wallGlyph(GLYPHS[kit:pick({ "Diamond", "Star", "Bolt" })], side, 0.1, d, kit:random(5, 8), kit:random(0.7, 0.9), 0.18, kit.theme.Accent:Lerp(WHITE, 0.3))
end

Frost.features = {
	{ 3, iceCluster },
	{ 2, frozenPillar },
	{ 3, iceSculpture },
	{ 2, frozenWindow },
	{ 2, hangingIcicles },
	{ 1, frostVein },
	{ 3, nothing },
}

-- Two glacier blocks with an ice beam and the zone name, icicles hanging off it.
function Frost.gate(kit, d)
	local H = kit.height
	for _, side in SIDES do
		kit:block(Vector3.new(3.4, 13, 3), kit:at(side * 8.3, 6.5, d), FROST_DEEP, Material.Glacier)
		kit:fixed(kit:glow(Vector3.new(0.6, 11, 0.1), kit:at(side * 7.1, 6, d - 1.55), kit.theme.Accent))
		for i = 1, 3 do
			icicle(kit, side * (6.9 + i * 0.5), d - 1.8, kit:random(1.5, 3.5))
		end
		snowDrift(kit, side, d + 4, 6, 1.4, 3)
	end
	local beam = kit:block(Vector3.new(20, 1.2, 3.4), kit:at(0, H - 0.6, d), FROST_ICE, Material.Ice)
	nameplate(kit, beam, Color3.fromRGB(20, 60, 110))
	for x = -5, 5, 2.5 do
		icicle(kit, x, d - 1.9, kit:random(0.8, 1.6))
	end
end

-- Magma forge: lava channels, iron girders, anvils, glowing jars ----------------------

local MAGMA_LAVA = Color3.fromRGB(255, 95, 20)
local MAGMA_HOT = Color3.fromRGB(255, 200, 70)
local MAGMA_ROCK = Color3.fromRGB(45, 30, 28)
local MAGMA_IRON = Color3.fromRGB(72, 68, 66)
local MAGMA_WOOD = Color3.fromRGB(80, 50, 35)

local Magma = {}

function Magma.room(kit)
	local L, H = kit.length, kit.height
	for _, side in SIDES do
		-- Lava channel with stone curbs along the floor edge (also the room's main light).
		kit:fixed(kit:glow(Vector3.new(1.2, 0.08, L), kit:at(kit:wallX(side, 1.2), 0.04, L / 2), MAGMA_LAVA))
		for _, inset in { 0.35, 2 } do
			kit:block(Vector3.new(0.4, 0.35, L), kit:at(kit:wallX(side, inset), 0.175, L / 2), MAGMA_ROCK, Material.Basalt)
		end
		-- Chains hanging by the walls.
		local chainD = kit:random(6, L - 6)
		local length = kit:random(2, 5)
		local x = kit:wallX(side, 1.6)
		kit:block(Vector3.new(0.15, length, 0.15), kit:at(x, H - length / 2, chainD), MAGMA_IRON, Material.Metal)
		kit:block(Vector3.new(0.5, 0.5, 0.15), kit:at(x, H - length - 0.2, chainD), MAGMA_IRON, Material.Metal)
	end
	-- Iron girders across the ceiling, between the depths where obstacles go
	-- (20/26.7/40/53.3/60, and 10/30/50/70 in rooms with 4 groups) so they never
	-- hide a FallingPane's edge.
	for _, d in { 15, 35, 45, 65 } do
		kit:block(Vector3.new(20, 0.9, 0.9), kit:at(0, H - 0.45, d), MAGMA_IRON, Material.Metal)
		kit:block(Vector3.new(20, 0.15, 1.3), kit:at(0, H - 0.95, d), MAGMA_IRON:Lerp(BLACK, 0.3), Material.Metal)
	end
	-- Floor grates with lava glowing underneath.
	for _ = 1, 2 do
		local x, d = kit:random(-3, 3), kit:random(10, L - 10)
		kit:glow(Vector3.new(2.8, 0.03, 2), kit:at(x, 0.015, d), MAGMA_LAVA)
		for i = -1, 1 do
			kit:block(Vector3.new(0.25, 0.08, 2.2), kit:at(x + i * 0.9, 0.06, d), MAGMA_IRON, Material.DiamondPlate)
		end
	end
end

-- A lump of cooled lava with glowing cracks.
local function lavaRock(kit, side, d)
	local x = kit:wallX(side, 1.6)
	if kit:fitted("LavaRock", kit:at(x, 0, d), Vector3.new(2.8, 2.6, 3.4), { anchor = "floor", spin = kit:random(0, math.pi), colors = { Neon = MAGMA_LAVA } }) then
		return
	end
	kit:block(Vector3.new(2.2, 1.6, 2.6), kit:at(x, 0.7, d) * CFrame.Angles(0, kit:random(-0.4, 0.4), 0), MAGMA_ROCK, Material.Basalt)
	kit:block(Vector3.new(1.4, 1.1, 1.6), kit:at(kit:wallX(side, 1.4), 1.8, d + 0.3) * CFrame.Angles(kit:random(-0.3, 0.3), 0.6, 0), MAGMA_ROCK, Material.Basalt)
	for _ = 1, 2 do
		local a = kit:pos(kit:wallX(side, kit:random(1, 2.2)), 1.52, d + kit:random(-1.2, 1.2))
		local b = kit:pos(kit:wallX(side, kit:random(1, 2.2)), 1.52, d + kit:random(-1.2, 1.2))
		kit:bar(a, b, 0.14, 0.06, Vector3.yAxis, MAGMA_LAVA, Material.Neon)
	end
end

-- A small volcano vent puffing heat (glowing mouth).
local function magmaVent(kit, side, d)
	local x = kit:wallX(side, 1.5)
	if kit:fitted("MagmaVent", kit:at(x, 0, d), Vector3.new(2.6, 2.4, 2.6), { anchor = "floor", colors = { Neon = MAGMA_LAVA } }) then
		return
	end
	kit:post(x, 0, 1.2, 2.4, d, MAGMA_ROCK, Material.Basalt)
	kit:post(x, 1.2, 0.7, 1.6, d, MAGMA_ROCK, Material.Basalt)
	kit:post(x, 1.9, 0.1, 1.1, d, MAGMA_HOT, Material.Neon)
end

-- An anvil on a wooden stump with a glowing hot bar on it.
local function forgeAnvil(kit, side, d)
	local x = kit:wallX(side, 1.6)
	if kit:fitted("ForgeAnvil", kit:at(x, 0, d), Vector3.new(1.8, 2.4, 3.2), { anchor = "floor", colors = { Neon = MAGMA_HOT } }) then
		return
	end
	kit:post(x, 0, 1.2, 1.6, d, MAGMA_WOOD, Material.Wood)
	kit:block(Vector3.new(1.1, 0.7, 2.4), kit:at(x, 1.55, d), MAGMA_IRON, Material.Metal)
	kit:block(Vector3.new(0.6, 0.45, 0.9), kit:at(x, 1.65, d + 1.6), MAGMA_IRON, Material.Metal)
	kit:glow(Vector3.new(0.25, 0.2, 1.4), kit:at(x, 2, d - 0.2), MAGMA_HOT)
end

-- Glass jars of glowing lava on a stone stand. Breakable.
local function magmaJars(kit, side, d)
	if not kit:canBreak() then
		return lavaRock(kit, side, d)
	end
	local x = kit:wallX(side, 1.5)
	local count = if kit.breakables + 1 < kit.maxBreakables and kit:chance(0.5) then 2 else 1
	kit:block(Vector3.new(1.8, 1.4, if count == 2 then 4.4 else 2), kit:at(x, 0.7, d), MAGMA_ROCK, Material.Basalt)
	for i = 1, count do
		local jarD = if count == 1 then d else d + (if i == 1 then -1.2 else 1.2)
		local placed = kit:fitted("MagmaJar", kit:at(x, 1.4, jarD), Vector3.new(1.6, 2.4, 1.6), {
			anchor = "floor",
			colors = { Neon = MAGMA_LAVA },
		})
		if not placed then
			local model = kit:breakable("MagmaJar")
			kit:glass(model, CylinderShape, Vector3.new(1.8, 1.3, 1.3), kit:at(x, 2.3, jarD) * UPRIGHT, kit:tint(0.5), 0.3)
			kit:inner(model, CylinderShape, Vector3.new(1.1, 1.05, 1.05), kit:at(x, 2, jarD) * UPRIGHT, MAGMA_LAVA)
			kit:inner(model, CylinderShape, Vector3.new(0.25, 1.45, 1.45), kit:at(x, 3.3, jarD) * UPRIGHT, MAGMA_IRON, Material.Metal)
		end
	end
end

-- A furnace window: fire roaring behind a glass pane in an iron frame. Breakable.
local function forgeWindow(kit, side, d)
	if not kit:canBreak() then
		return lavaRock(kit, side, d)
	end
	kit:glow(Vector3.new(0.1, 4.5, 5.5), kit:at(kit:wallX(side, 0.06), 5.5, d), MAGMA_LAVA)
	kit:glow(Vector3.new(0.12, 1.6, 4), kit:at(kit:wallX(side, 0.12), 4.2, d), MAGMA_HOT)
	for _, y in { 3, 8 } do
		kit:block(Vector3.new(0.6, 0.5, 6.4), kit:at(kit:wallX(side, 0.3), y, d), MAGMA_IRON, Material.DiamondPlate)
	end
	for _, offset in { -1.4, 1.4 } do
		kit:block(Vector3.new(0.3, 4.6, 0.25), kit:at(kit:wallX(side, 0.25), 5.5, d + offset), MAGMA_IRON, Material.Metal)
	end
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 4.5, 6), kit:at(kit:wallX(side, 0.5), 5.5, d), MAGMA_HOT:Lerp(WHITE, 0.4), 0.5)
	pane.Name = "FurnaceWindow"
end

-- A wooden board with hammers and tongs.
local function toolRack(kit, side, d)
	kit:block(Vector3.new(0.2, 3, 5), kit:at(kit:wallX(side, 0.1), 7, d), MAGMA_WOOD, Material.Wood)
	for _, offset in { -1.5, 0, 1.5 } do
		local length = kit:random(1.6, 2.4)
		kit:block(Vector3.new(0.18, length, 0.18), kit:at(kit:wallX(side, 0.35), 7.6 - length / 2, d + offset), MAGMA_WOOD:Lerp(WHITE, 0.15), Material.Wood)
		kit:block(Vector3.new(0.4, 0.4, 0.9), kit:at(kit:wallX(side, 0.4), 7.6 - length, d + offset), MAGMA_IRON, Material.Metal)
	end
end

-- Lava pouring down the wall into a little pool.
local function lavaFall(kit, side, d)
	kit:fixed(kit:glow(Vector3.new(0.1, 12, 1.4), kit:at(kit:wallX(side, 0.06), 6.5, d), MAGMA_LAVA))
	kit:block(Vector3.new(0.8, 0.6, 2.2), kit:at(kit:wallX(side, 0.4), 12.4, d), MAGMA_ROCK, Material.Basalt)
	kit:glow(Vector3.new(1.6, 0.06, 2.6), kit:at(kit:wallX(side, 0.9), 0.03, d), MAGMA_HOT)
end

Magma.features = {
	{ 3, lavaRock },
	{ 2, magmaVent },
	{ 2, forgeAnvil },
	{ 3, magmaJars },
	{ 2, forgeWindow },
	{ 1, toolRack },
	{ 1, lavaFall },
	{ 3, nothing },
}

-- Iron forge gate with glowing seams and the zone name, vents on either side.
function Magma.gate(kit, d)
	local H = kit.height
	for _, side in SIDES do
		kit:block(Vector3.new(2.6, H, 2.6), kit:at(side * 8.7, H / 2, d), MAGMA_IRON, Material.DiamondPlate)
		kit:fixed(kit:glow(Vector3.new(0.3, 11, 0.2), kit:at(side * 7.35, 6, d - 1.2), MAGMA_LAVA))
		magmaVent(kit, side, d + 4)
	end
	local lintel = kit:block(Vector3.new(20, 1.6, 2.4), kit:at(0, H - 0.8, d), MAGMA_IRON:Lerp(BLACK, 0.3), Material.Metal)
	nameplate(kit, lintel, MAGMA_HOT)
	kit:fixed(kit:glow(Vector3.new(14.4, 0.2, 0.3), kit:at(0, 12.3, d - 1.2), MAGMA_LAVA))
end

-- Deep aquarium: tank windows, coral, kelp, jellyfish lamps, light rippling on the sand ----

local AQ_WATER = Color3.fromRGB(45, 160, 180)
local AQ_DEEP = Color3.fromRGB(12, 45, 70)
local AQ_HATCH = Color3.fromRGB(70, 82, 90)
local AQ_RUST = Color3.fromRGB(120, 72, 48)
local AQ_KELP = { Color3.fromRGB(50, 130, 70), Color3.fromRGB(80, 150, 60), Color3.fromRGB(35, 105, 75) }
local AQ_PEBBLES = { Color3.fromRGB(150, 140, 120), Color3.fromRGB(110, 115, 120), Color3.fromRGB(180, 165, 140) }
local AQ_FISH = { Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 230, 80), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 90, 140) }
local AQ_CORAL = { Color3.fromRGB(255, 110, 120), Color3.fromRGB(255, 160, 80), Color3.fromRGB(200, 110, 255), Color3.fromRGB(255, 220, 120) }
local HAZARD_YELLOW = Color3.fromRGB(255, 205, 40)

local Aquarium = {}

function Aquarium.room(kit)
	local L, H = kit.length, kit.height
	-- The water surface glowing above (the room's main light), with ripples shimmering across it.
	kit:fixed(kit:haze(Vector3.new(19, 0.05, L), kit:at(0, H - 0.03, L / 2), AQ_WATER:Lerp(kit.theme.Accent, 0.25), 0.25))
	for _ = 1, 2 do
		local ripple = kit:haze(Vector3.new(19, 0.04, kit:random(0.4, 0.9)), kit:at(0, H - 0.08, kit:random(4, L - 4)), AQ_WATER:Lerp(WHITE, 0.6), 0.5)
		ripple.CanQuery = false
		kit:animate(ripple, { Transparency = 0.95 }, kit:random(0.9, 1.6), true, Enum.EasingStyle.Sine)
	end
	-- Rippling light (caustics) on the sand.
	for _ = 1, 4 do
		local size = kit:random(1.2, 2.4)
		local cframe = kit:at(kit:random(-7.5, 7.5), 0.02, kit:random(3, L - 3)) * CFrame.Angles(0, kit:random(0, math.pi), 0)
		local patch = kit:haze(Vector3.new(size, 0.03, size * kit:random(0.6, 1)), cframe, kit.theme.Accent:Lerp(WHITE, 0.7), 0.55)
		patch.CanQuery = false
		kit:animate(patch, { Transparency = 0.92 }, kit:random(0.8, 1.8), true, Enum.EasingStyle.Sine)
	end
	-- Pebbles by the walls.
	for _ = 1, 3 do
		local size = kit:random(0.4, 0.9)
		kit:ball(size, kit:at(kit:pick(SIDES) * kit:random(7, 9), size / 2 - 0.1, kit:random(2, L - 2)), kit:pick(AQ_PEBBLES), Material.Pebble)
	end
	-- A big pipe along one ceiling corner.
	local pipeSide = kit:pick(SIDES)
	kit:rod(L, 0.9, kit:at(kit:wallX(pipeSide, 0.8), H - 0.8, L / 2) * ALONG_Z, AQ_HATCH, Material.Metal)
	for d = 15, L - 15, 25 do
		kit:rod(0.5, 1.15, kit:at(kit:wallX(pipeSide, 0.8), H - 0.8, d) * ALONG_Z, AQ_RUST, Material.Metal)
	end
	-- Bubbles rising by the walls (they pass through balls).
	for _ = 1, kit.rng:NextInteger(1, 2) do
		local x = kit:wallX(kit:pick(SIDES), kit:random(1, 1.6))
		local d = kit:random(5, L - 5)
		for i = 1, 3 do
			local size = kit:random(0.3, 0.6)
			local y = 1 + i * 3
			local bubble = kit:part(kit.folder, "Wall", BallShape, Vector3.one * size, kit:at(x, y, d), AQ_WATER:Lerp(WHITE, 0.8), Material.Glass, {
				Transparency = 0.5,
				CanQuery = false,
			})
			kit:animate(bubble, { CFrame = kit:at(x, H - 0.6, d + kit:random(-0.4, 0.4)) }, (H - 0.6 - y) / 3, false)
		end
	end
end

-- Coral growing on a rock.
local function coral(kit, side, d)
	local x = kit:wallX(side, 1.6)
	local color = kit:pick(AQ_CORAL)
	if kit:fitted("Coral", kit:at(x, 0, d), Vector3.new(2.6, 3.2, 3), { anchor = "floor", spin = kit:random(0, math.pi), colors = { Coral = color, Body = color } }) then
		return
	end
	kit:block(Vector3.new(2, 0.6, 2.4), kit:at(x, 0.3, d), AQ_PEBBLES[2], Material.Rock)
	for _ = 1, 3 do
		local length = kit:random(1.4, 2.6)
		local bx, bd = x + kit:random(-0.5, 0.5), d + kit:random(-0.9, 0.9)
		local tilt = kit:random(-0.4, 0.4)
		local base = kit:at(bx, 0.6, bd) * CFrame.Angles(tilt, 0, 0)
		kit:rod(length, 0.35, base * CFrame.new(0, length / 2, 0) * UPRIGHT, color)
		kit:ball(0.6, base * CFrame.new(0, length, 0), color:Lerp(WHITE, 0.3))
	end
end

-- Tall kelp swaying up from the sand.
local function seaweed(kit, side, d)
	local x = kit:wallX(side, 1.2)
	local color = kit:pick(AQ_KELP)
	if kit:fitted("Seaweed", kit:at(x, 0, d - 1), Vector3.new(1.6, 9, 1.6), { anchor = "floor", colors = { Plant = color } }) then
		kit:fitted("Seaweed", kit:at(x, 0, d + 1.5), Vector3.new(1.4, 6, 1.4), { anchor = "floor", colors = { Plant = kit:pick(AQ_KELP) } })
		return
	end
	for strand = 1, 2 do
		local sx = kit:wallX(side, kit:random(1, 1.4))
		local sd = d + (strand - 1.5) * 2
		for segment = 0, 2 do
			local lean = if segment % 2 == 0 then 0.15 else -0.15
			kit:block(Vector3.new(0.15, 3, 0.7), kit:at(sx, 1.5 + segment * 2.9, sd) * CFrame.Angles(lean, 0, 0), color, Material.Grass)
		end
	end
end

-- A rusty ship anchor leaning on the wall.
local function anchor(kit, side, d)
	if kit:wallFitted("Anchor", side, 0, 0, d, Vector3.new(3.2, 4.5, 1.2), { anchor = "floor", colors = { Metal = AQ_RUST } }) then
		return
	end
	local x = kit:wallX(side, 0.8)
	kit:block(Vector3.new(0.4, 4, 0.4), kit:at(x, 2.2, d), AQ_RUST, Material.Metal)
	kit:block(Vector3.new(0.3, 0.3, 2.6), kit:at(x, 3.9, d), AQ_RUST, Material.Metal)
	for _, s in { -1, 1 } do
		kit:block(Vector3.new(0.35, 0.35, 1.7), kit:at(x, 0.75, d + s * 0.55) * CFrame.Angles(s * -0.7, 0, 0), AQ_RUST, Material.Metal)
	end
	kit:rod(0.2, 0.9, kit:at(x, 4.6, d), AQ_RUST, Material.Metal)
end

-- A little fish tank on a cabinet. Breakable.
local function fishTank(kit, side, d)
	if not kit:canBreak() then
		return coral(kit, side, d)
	end
	local x = kit:wallX(side, 1.1)
	kit:block(Vector3.new(2, 2.2, 3.4), kit:at(x, 1.1, d), AQ_HATCH, Material.Metal)
	if kit:fitted("FishTank", kit:at(x, 2.2, d), Vector3.new(1.8, 2.2, 3.2), { anchor = "floor", colors = { Glass = kit:tint(0.7) } }) then
		return
	end
	local model = kit:breakable("FishTank")
	kit:glass(model, Block, Vector3.new(1.7, 1.8, 3), kit:at(x, 3.1, d), kit:tint(0.7), 0.55)
	kit:inner(model, Block, Vector3.new(1.6, 0.3, 2.9), kit:at(x, 2.35, d), Color3.fromRGB(215, 195, 140), Material.Sand)
	for _, offset in { -0.7, 0.8 } do
		kit:inner(model, Block, Vector3.new(0.15, 0.3, 0.55), kit:at(x, kit:random(3, 3.6), d + offset), kit:pick(AQ_FISH))
	end
	kit:inner(model, Block, Vector3.new(0.15, 1, 0.35), kit:at(x, 3, d - 1.1), kit:pick(AQ_KELP), Material.Grass)
end

-- A big aquarium window in the wall, fish swimming behind it. Breakable.
local function tankWindow(kit, side, d)
	if not kit:canBreak() then
		return seaweed(kit, side, d)
	end
	kit:glow(Vector3.new(0.1, 6.4, 7.2), kit:at(kit:wallX(side, 0.06), 6.5, d), AQ_DEEP:Lerp(AQ_WATER, 0.45))
	for _ = 1, 2 do
		local height = kit:random(3, 5)
		kit:block(Vector3.new(0.08, height, 0.4), kit:at(kit:wallX(side, 0.14), 3.3 + height / 2, d + kit:random(-3, 3)), AQ_KELP[3])
	end
	for _ = 1, 2 do
		kit:glow(Vector3.new(0.08, 0.35, 0.7), kit:at(kit:wallX(side, 0.2), kit:random(4.5, 8.5), d + kit:random(-2.8, 2.8)), kit:pick(AQ_FISH))
	end
	for _, y in { 3.15, 9.85 } do
		kit:block(Vector3.new(0.6, 0.35, 7.6), kit:at(kit:wallX(side, 0.3), y, d), AQ_HATCH, Material.Metal)
	end
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 6.2, 7), kit:at(kit:wallX(side, 0.5), 6.5, d), kit:tint(0.7), 0.5)
	pane.Name = "TankWindow"
end

-- A glowing glass jellyfish lamp hanging from the ceiling. Breakable.
local function jellyLamp(kit, side, d)
	if not kit:canBreak() then
		return anchor(kit, side, d)
	end
	local H = kit.height
	local x = kit:wallX(side, 2.2)
	kit:post(x, H - 0.5, 0.5, 0.1, d, AQ_HATCH, Material.Metal)
	if kit:fitted("JellyLamp", kit:at(x, H - 0.5, d), Vector3.new(1.6, 3, 1.6), { anchor = "ceiling", colors = { Glass = kit:tint(0.6), Neon = kit.theme.Accent } }) then
		return
	end
	local model = kit:breakable("JellyLamp")
	kit:glass(model, BallShape, Vector3.one * 1.4, kit:at(x, H - 1.2, d), kit:tint(0.6), 0.4)
	kit:inner(model, BallShape, Vector3.one * 0.6, kit:at(x, H - 1.2, d), kit.theme.Accent)
	for _, offset in { -0.35, 0, 0.35 } do
		kit:inner(model, Block, Vector3.new(0.08, 1.4, 0.08), kit:at(x, H - 2.5, d + offset), kit.theme.Accent:Lerp(WHITE, 0.4))
	end
end

Aquarium.features = {
	{ 3, coral },
	{ 2, seaweed },
	{ 1, anchor },
	{ 2, fishTank },
	{ 3, tankWindow },
	{ 2, jellyLamp },
	{ 3, nothing },
}

-- A submarine hatch frame with hazard stripes, a valve wheel and the zone name.
function Aquarium.gate(kit, d)
	local H = kit.height
	for _, side in SIDES do
		kit:block(Vector3.new(1.4, H, 1.6), kit:at(side * 9.3, H / 2, d), AQ_HATCH, Material.Metal)
		for i = 0, 4 do
			kit:block(Vector3.new(0.06, 0.8, 1.2), kit:at(side * 8.57, 1.5 + i * 2.4, d), if i % 2 == 0 then HAZARD_YELLOW else AQ_DEEP)
		end
		local brace = CFrame.fromMatrix(kit:pos(side * 7.7, 11, d), Vector3.new(0, 0, side), Vector3.new(0, -1, 0))
		kit:wedge(Vector3.new(1.6, 2, 2), brace, AQ_HATCH, Material.Metal)
		kit:rod(0.25, 1.4, kit:at(side * 8.9, 6, d - 1) * ALONG_Z, AQ_RUST, Material.Metal)
	end
	local beam = kit:block(Vector3.new(20, 1.6, 1.6), kit:at(0, H - 0.8, d), AQ_HATCH, Material.Metal)
	nameplate(kit, beam, kit.theme.Accent)
	for x = -8, 8, 4 do
		kit:ball(0.35, kit:at(x, 12.55, d - 0.8), AQ_HATCH:Lerp(WHITE, 0.2), Material.Metal)
	end
	kit:block(Vector3.new(17.2, 0.4, 1.6), kit:at(0, 0.2, d), AQ_HATCH, Material.DiamondPlate)
	kit:fixed(kit:glow(Vector3.new(14, 0.15, 0.3), kit:at(0, 12.1, d - 0.85), kit.theme.Accent))
end

-- Sky citadel: white marble, gold trim, windows open to the sky, wind turbines, banners ----

local SKY_GOLD = Color3.fromRGB(235, 190, 75)
local SKY_BLUE = Color3.fromRGB(125, 195, 255)
local SKY_CLOUD = Color3.fromRGB(250, 252, 255)
local SKY_LANTERN = Color3.fromRGB(255, 220, 150)
local SKY_FLAME = Color3.fromRGB(255, 170, 60)
local SKY_FABRICS = { Color3.fromRGB(70, 110, 220), Color3.fromRGB(220, 70, 90), Color3.fromRGB(250, 250, 250) }

local Sky = {}

function Sky.room(kit)
	local L, H = kit.length, kit.height
	local beam = kit.theme.Wall:Lerp(BLACK, 0.1)
	-- Gold inlay lines and stars on the marble floor.
	for _, x in { -4, 4 } do
		kit:block(Vector3.new(0.25, 0.04, L), kit:at(x, 0.02, L / 2), SKY_GOLD, Material.Metal)
	end
	kit:floorGlyph(GLYPHS.Star, 0, L / 2, 0.8, SKY_GOLD)
	-- Coffered ceiling with two skylights (the room's main lights).
	for d = 10, L - 10, 20 do
		kit:block(Vector3.new(20, 0.6, 0.6), kit:at(0, H - 0.3, d), beam, Material.Marble)
	end
	for _, d in { 20, 60 } do
		kit:fixed(kit:glow(Vector3.new(6, 0.06, 6), kit:at(0, H - 0.03, d), SKY_BLUE:Lerp(WHITE, 0.6)))
		for _, s in { -1, 1 } do
			kit:block(Vector3.new(6.6, 0.12, 0.3), kit:at(0, H - 0.06, d + s * 3.15), SKY_GOLD, Material.Metal)
			kit:block(Vector3.new(0.3, 0.12, 6.6), kit:at(s * 3.15, H - 0.06, d), SKY_GOLD, Material.Metal)
		end
	end
	for _, side in SIDES do
		kit:block(Vector3.new(0.3, 0.3, L), kit:at(kit:wallX(side, 0.15), H - 0.15, L / 2), SKY_GOLD, Material.Metal)
		kit:block(Vector3.new(0.4, 0.6, L), kit:at(kit:wallX(side, 0.2), 0.3, L / 2), beam, Material.Marble)
	end
end

-- A window open to the bright sky, clouds drifting past. Glazed (breakable) when the room has room for it.
local function skyWindow(kit, side, d)
	kit:fixed(kit:glow(Vector3.new(0.1, 7, 6), kit:at(kit:wallX(side, 0.06), 6.5, d), SKY_BLUE))
	local cloudY, cloudD = kit:random(4.5, 8.5), d + kit:random(-1.5, 1.5)
	for i = -1, 1 do
		local size = if i == 0 then 1.8 else 1.2
		kit:rod(0.1, size, kit:at(kit:wallX(side, 0.15), cloudY + (if i == 0 then 0.3 else 0), cloudD + i * 0.9), SKY_CLOUD)
	end
	for _, s in { -1, 1 } do
		kit:block(Vector3.new(0.5, 7.4, 0.5), kit:at(kit:wallX(side, 0.25), 6.5, d + s * 3.2), SKY_GOLD, Material.Metal)
	end
	kit:block(Vector3.new(0.5, 0.5, 6.9), kit:at(kit:wallX(side, 0.25), 10.2, d), SKY_GOLD, Material.Metal)
	kit:block(Vector3.new(0.8, 0.3, 6.9), kit:at(kit:wallX(side, 0.4), 2.85, d), kit.theme.Wall:Lerp(BLACK, 0.08), Material.Marble)
	if kit:canBreak() then
		local pane = kit:glass(nil, Block, Vector3.new(0.15, 7, 6), kit:at(kit:wallX(side, 0.45), 6.5, d), SKY_BLUE:Lerp(WHITE, 0.7), 0.6)
		pane.Name = "SkyWindow"
	end
end

-- Fluffy clouds that drifted in and settled on the floor.
local function cloudCluster(kit, side, d)
	local x = kit:wallX(side, 1.6)
	if kit:fitted("CloudCluster", kit:at(x, 0, d), Vector3.new(2.8, 2.4, 4), { anchor = "floor", spin = kit:random(0, math.pi) }) then
		return
	end
	for i = 1, 4 do
		local size = kit:random(1.4, 2.2)
		kit:ball(size, kit:at(kit:wallX(side, kit:random(1.4, 1.7)), size / 2 - 0.1 + kit:random(0, 0.5), d + (i - 2.5) * 1.1), SKY_CLOUD)
	end
end

-- A little wind turbine on the wall, blades turning.
local function windTurbine(kit, side, d)
	local y = kit:random(7, 9)
	if kit:wallFitted("WindTurbine", side, 0, y, d, Vector3.new(3.6, 3.6, 1.4), { anchor = "center" }) then
		return
	end
	local hubX = kit:wallX(side, 0.9)
	kit:rod(0.9, 0.7, kit:at(kit:wallX(side, 0.45), y, d), METAL, Material.Metal)
	kit:ball(0.7, kit:at(hubX, y, d), SKY_GOLD, Material.Metal)
	local spinTime = kit:random(0.6, 1)
	for i = 0, 1 do
		-- Two crossed blades; turning a quarter turn and starting over looks like nonstop spinning.
		local cframe = kit:at(hubX, y, d) * CFrame.Angles(i * QUARTER_TURN, 0, 0)
		local blade = kit:block(Vector3.new(0.12, 0.6, 5), cframe, WHITE)
		kit:animate(blade, { CFrame = cframe * CFrame.Angles(QUARTER_TURN, 0, 0) }, spinTime, false)
	end
end

-- A long banner hanging from a gold rod, with a star on it.
local function banner(kit, side, d)
	local H = kit.height
	local color = kit:pick(SKY_FABRICS)
	if kit:wallFitted("Banner", side, 0.1, H - 0.4, d, Vector3.new(2.6, 6.5, 0.5), { anchor = "ceiling", colors = { Fabric = color, Cloth = color } }) then
		return
	end
	kit:rod(3, 0.25, kit:at(kit:wallX(side, 0.5), H - 1.4, d) * ALONG_Z, SKY_GOLD, Material.Metal)
	kit:block(Vector3.new(0.1, 6, 2.4), kit:at(kit:wallX(side, 0.35), H - 4.5, d), color, Material.Fabric)
	kit:block(Vector3.new(0.12, 0.3, 2.4), kit:at(kit:wallX(side, 0.36), H - 7.4, d), SKY_GOLD, Material.Metal)
	kit:wallGlyph(GLYPHS.Star, side, 0.42, d, H - 4, 0.55, 0.15, SKY_GOLD)
end

-- A paper-style glass lantern hanging on a gold string. Breakable.
local function skyLantern(kit, side, d)
	if not kit:canBreak() then
		return banner(kit, side, d)
	end
	local H = kit.height
	local x = kit:wallX(side, 2.2)
	local hang = kit:random(0.4, 1.4)
	kit:post(x, H - hang, hang, 0.08, d, SKY_GOLD, Material.Metal)
	if kit:fitted("SkyLantern", kit:at(x, H - hang, d), Vector3.new(1.4, 2, 1.4), { anchor = "ceiling", colors = { Glass = SKY_LANTERN, Neon = SKY_FLAME } }) then
		return
	end
	local model = kit:breakable("SkyLantern")
	kit:glass(model, Block, Vector3.new(1.1, 1.5, 1.1), kit:at(x, H - hang - 0.75, d), SKY_LANTERN, 0.3)
	kit:inner(model, BallShape, Vector3.one * 0.5, kit:at(x, H - hang - 0.9, d), SKY_FLAME)
end

-- A marble pedestal with a glass orb on top. Breakable.
local function orbPedestal(kit, side, d)
	if not kit:canBreak() then
		return cloudCluster(kit, side, d)
	end
	local x = kit:wallX(side, 1.4)
	kit:block(Vector3.new(1.4, 3, 1.4), kit:at(x, 1.5, d), kit.theme.Wall:Lerp(BLACK, 0.05), Material.Marble)
	kit:block(Vector3.new(1.8, 0.25, 1.8), kit:at(x, 3.125, d), SKY_GOLD, Material.Metal)
	orb(kit, x, 4.1, d, 1.5, SKY_BLUE:Lerp(WHITE, 0.6))
end

Sky.features = {
	{ 3, skyWindow },
	{ 2, cloudCluster },
	{ 2, windTurbine },
	{ 2, skyLantern },
	{ 2, banner },
	{ 2, orbPedestal },
	{ 3, nothing },
}

-- A grand marble arch with gold capitals, clouds around its feet.
function Sky.gate(kit, d)
	local H = kit.height
	local marble = kit.theme.Wall:Lerp(BLACK, 0.06)
	for _, side in SIDES do
		kit:block(Vector3.new(2.4, 11.6, 2.4), kit:at(side * 8.5, 5.8, d), marble, Material.Marble)
		for _, y in { 0.3, 11.9 } do
			kit:block(Vector3.new(3, 0.6, 3), kit:at(side * 8.5, y, d), SKY_GOLD, Material.Metal)
		end
		for i = 1, 3 do
			local size = kit:random(1.2, 1.8)
			kit:ball(size, kit:at(side * kit:random(7.6, 8.6), size / 2 - 0.1, d + 2 + i), SKY_CLOUD)
		end
	end
	local arch = kit:block(Vector3.new(20, 1.8, 3), kit:at(0, H - 0.9, d), marble, Material.Marble)
	nameplate(kit, arch, SKY_GOLD:Lerp(BLACK, 0.3))
	kit:fixed(kit:glow(Vector3.new(14, 0.2, 0.3), kit:at(0, 12.3, d - 1.5), SKY_GOLD))
end

-- Crystal core: dark machinery, purple energy, glowing crystals in glass cells -----------

local CORE_DARK = Color3.fromRGB(26, 18, 42)
local CORE_METAL = Color3.fromRGB(64, 58, 86)
local CORE_WHITE = Color3.fromRGB(245, 236, 255)
local CORE_COLORS = {
	Color3.fromRGB(215, 140, 255),
	Color3.fromRGB(160, 120, 255),
	Color3.fromRGB(255, 170, 240),
	Color3.fromRGB(240, 230, 255),
}

local Core = {}

function Core.room(kit)
	local L, H = kit.length, kit.height
	local accent = kit.theme.Accent
	for _, side in SIDES do
		-- Energy conduits low and high on the walls.
		for _, y in { 2.5, 11.5 } do
			kit:fixed(kit:glow(Vector3.new(0.12, 0.2, L), kit:at(kit:wallX(side, 0.06), y, L / 2), accent))
		end
		kit:block(Vector3.new(0.2, 0.8, L), kit:at(kit:wallX(side, 0.1), 7, L / 2), CORE_DARK, Material.Metal)
	end
	-- An energy beam along the ceiling, on brackets.
	kit:fixed(kit:rod(L, 0.5, kit:at(0, H - 0.7, L / 2) * ALONG_Z, accent:Lerp(WHITE, 0.4), Material.Neon))
	for d = 10, L - 10, 20 do
		kit:block(Vector3.new(2, 0.6, 0.6), kit:at(0, H - 0.3, d), CORE_METAL, Material.Metal)
	end
	-- A hexagon on the floor.
	kit:floorGlyph(GLYPHS.Hex, kit:random(-3, 3), kit:random(25, 55), 1.1, accent:Lerp(BLACK, 0.35))
	-- Crystals stuck in the ceiling corners.
	for _ = 1, 2 do
		local side = kit:pick(SIDES)
		local cframe = kit:at(kit:wallX(side, 1.2), H - 1.2, kit:random(4, L - 4)) * CFrame.Angles(kit:random(-0.5, 0.5), kit:random(0, math.pi), side * 0.6)
		kit:block(Vector3.new(0.5, 1.6, 0.5), cframe, kit:pick(CORE_COLORS), Material.Glass)
	end
end

-- An energy pylon with glowing rings and a crystal tip.
local function energyPylon(kit, side, d)
	local x = kit:wallX(side, 1.4)
	if kit:fitted("EnergyPylon", kit:at(x, 0, d), Vector3.new(2, 9, 2), { anchor = "floor", colors = { Neon = kit.theme.Accent } }) then
		return
	end
	kit:block(Vector3.new(2, 0.8, 2), kit:at(x, 0.4, d), CORE_METAL, Material.Metal)
	kit:post(x, 0.8, 6.6, 0.7, d, CORE_DARK, Material.Metal)
	for _, y in { 2.6, 4.6, 6.6 } do
		kit:post(x, y, 0.15, 1.4, d, kit.theme.Accent, Material.Neon)
	end
	kit:glow(Vector3.new(0.8, 1.6, 0.8), kit:at(x, 8.2, d) * CFrame.Angles(0, math.rad(45), 0), CORE_WHITE)
end

-- A big glowing crystal on a metal base. Breakable.
local function coreCrystal(kit, side, d)
	if not kit:canBreak() then
		return energyPylon(kit, side, d)
	end
	local x = kit:wallX(side, 1.6)
	kit:post(x, 0, 0.5, 2.2, d, CORE_METAL, Material.Metal)
	local spin = kit:random(0, math.pi)
	if kit:fitted("CoreCrystal", kit:at(x, 0.5, d), Vector3.new(2, 3.6, 2), { anchor = "floor", spin = spin, colors = { Glass = kit:tint(0.4), Neon = CORE_WHITE } }) then
		return
	end
	local model = kit:breakable("CoreCrystal")
	local color = kit:tint(0.35)
	kit:glass(model, Block, Vector3.new(0.8, 2.8, 0.8), kit:at(x, 1.9, d) * CFrame.Angles(0, spin, 0), color, 0.2)
	kit:glass(model, Block, Vector3.new(0.55, 1.7, 0.55), kit:at(x, 1.3, d - 0.6) * CFrame.Angles(-0.45, spin, 0), color, 0.2)
	kit:glass(model, Block, Vector3.new(0.55, 1.7, 0.55), kit:at(x, 1.3, d + 0.6) * CFrame.Angles(0.45, spin, 0), color, 0.2)
	kit:inner(model, Block, Vector3.one * 0.5, kit:at(x, 1.9, d) * CFrame.Angles(math.rad(45), spin, math.rad(45)), CORE_WHITE)
end

-- A glowing ring floating by the wall with a spinning crystal in the middle.
local function floatingRing(kit, side, d)
	local y = kit:random(5.5, 8.5)
	if kit:wallFitted("FloatingRing", side, 0.6, y, d, Vector3.new(3.4, 3.4, 0.8), { anchor = "center", colors = { Neon = kit.theme.Accent } }) then
		return
	end
	local x = kit:wallX(side, 1.2)
	local radius = 1.5
	local previous = nil
	for i = 0, 8 do
		local a = i * math.pi / 4
		local point = kit:pos(x, y + radius * math.sin(a), d + radius * math.cos(a))
		if previous then
			kit:fixed(kit:bar(previous, point, 0.22, 0.22, Vector3.xAxis, kit.theme.Accent, Material.Neon))
		end
		previous = point
	end
	-- A cube turned a quarter turn looks the same, so this loops without a jump.
	local cframe = kit:at(x, y, d) * CFrame.Angles(math.rad(45), math.rad(45), 0)
	local crystal = kit:glow(Vector3.one * 0.6, cframe, CORE_WHITE)
	kit:animate(crystal, { CFrame = cframe * CFrame.Angles(0, QUARTER_TURN, 0) }, 1.2, false)
end

-- Wall panel with glowing circuit lines.
local function circuitPanel(kit, side, d)
	local y = kit:random(5.5, 7.5)
	local x = kit:wallX(side, 0.15)
	kit:block(Vector3.new(0.12, 4, 5), kit:at(kit:wallX(side, 0.06), y, d), CORE_DARK, Material.Metal)
	for _ = 1, 3 do
		local u1, v1 = kit:random(-2, 2), kit:random(-1.6, 1.6)
		local horizontal = kit:chance(0.5)
		local u2 = if horizontal then kit:random(-2, 2) else u1
		local v2 = if horizontal then v1 else kit:random(-1.6, 1.6)
		if math.abs(u2 - u1) + math.abs(v2 - v1) > 0.4 then
			kit:bar(kit:pos(x, y + v1, d + u1), kit:pos(x, y + v2, d + u2), 0.1, 0.06, Vector3.xAxis, kit.theme.Accent, Material.Neon)
		end
	end
	kit:ball(0.35, kit:at(kit:wallX(side, 0.2), y + 1.6, d + 2), CORE_WHITE, Material.Neon)
end

-- A glass containment cell with a glowing crystal inside. Breakable.
local function containmentCell(kit, side, d)
	if not kit:canBreak() then
		return circuitPanel(kit, side, d)
	end
	local x = kit:wallX(side, 1.3)
	kit:post(x, 0, 2.6, 2.2, d, CORE_METAL, Material.Metal)
	kit:post(x, 8.6, 0.6, 2.2, d, CORE_METAL, Material.Metal)
	kit:block(Vector3.new(0.6, 6.6, 0.6), kit:at(kit:wallX(side, 0.3), 5.9, d), CORE_DARK, Material.Metal)
	local model = kit:breakable("ContainmentCell")
	kit:glass(model, CylinderShape, Vector3.new(6, 1.8, 1.8), kit:at(x, 5.6, d) * UPRIGHT, kit:tint(0.65), 0.55)
	kit:inner(model, Block, Vector3.new(0.6, 1.4, 0.6), kit:at(x, 5.6, d) * CFrame.Angles(0, math.rad(45), 0), CORE_WHITE)
	kit:inner(model, CylinderShape, Vector3.new(5.8, 0.15, 0.15), kit:at(x, 5.6, d) * UPRIGHT, kit.theme.Accent)
end

Core.features = {
	{ 3, energyPylon },
	{ 3, coreCrystal },
	{ 2, floatingRing },
	{ 2, containmentCell },
	{ 2, circuitPanel },
	{ 1, shards },
	{ 3, nothing },
}

-- Reactor gate: dark frame, energy pillars, a glowing core above the zone name.
function Core.gate(kit, d)
	local H = kit.height
	for _, side in SIDES do
		kit:block(Vector3.new(2, H, 1.6), kit:at(side * 9, H / 2, d), CORE_DARK, Material.Metal)
		kit:fixed(kit:glow(Vector3.new(0.5, 12.6, 0.5), kit:at(side * 7.6, 6.3, d), kit.theme.Accent))
		local brace = CFrame.fromMatrix(kit:pos(side * 7.6, 11.4, d), Vector3.new(0, 0, side), Vector3.new(0, -1, 0))
		kit:wedge(Vector3.new(1.4, 1.6, 1.8), brace, CORE_METAL, Material.Metal)
		coreCrystal(kit, side, d + 4)
	end
	local header = kit:block(Vector3.new(16, 1.2, 1.2), kit:at(0, H - 0.6, d), CORE_DARK, Material.Metal)
	nameplate(kit, header, kit.theme.Accent)
	kit:ball(1.6, kit:at(0, 12.9, d - 1.4), CORE_WHITE, Material.Neon)
	kit:fixed(kit:glow(Vector3.new(15.2, 0.04, 0.5), kit:at(0, 0.02, d), kit.theme.Accent))
end

-- Dispatch --------------------------------------------------------------------------

local STYLES = {
	Lab = Lab,
	Neon = Neon,
	Temple = Temple,
	Greenhouse = Greenhouse,
	Void = Void,
	Frost = Frost,
	Magma = Magma,
	Aquarium = Aquarium,
	Sky = Sky,
	Core = Core,
}

function Decor.decorate(builder, room, info)
	local kit = newKit(builder, room, info)
	local style = STYLES[info.theme.Style] or STYLES.Lab

	style.room(kit)
	if info.isZoneStart then
		style.gate(kit, GATE_DEPTH)
	end

	-- One feature per wall bay, never the same twice in a row on one wall.
	local previous = {}
	for _, d in BAYS do
		if info.isZoneStart and d < GATE_DEPTH + 5 then
			continue -- the gate stands here
		end
		for _, side in SIDES do
			local feature = kit:pickWeighted(style.features)
			if feature == previous[side] then
				feature = kit:pickWeighted(style.features)
			end
			previous[side] = feature
			feature(kit, side, d)
		end
	end

	-- Every room gets a few things to smash.
	for _, d in GLOBE_SPOTS do
		if kit.breakables >= MIN_BREAKABLES then
			break
		end
		ceilingGlobe(kit, kit:random(-4, 4), d)
	end
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">GamepadAim</string>
            <string name="Source"><![CDATA[--[[
	Aiming with a controller (Xbox / PlayStation / a gamepad on PC).

	While the player's last input was a gamepad and a run is going, a crosshair
	shows on screen. Either thumbstick moves it (slowly at first, faster the
	longer the stick is held), and it drifts back to the middle when the stick
	is let go. RunController throws at it when R2 or A is pressed.

	The crosshair's ScreenGui covers the whole screen (no insets), so its
	position is in the same pixels as camera.ViewportSize: throw with
	camera:ViewportPointToRay, NOT ScreenPointToRay (that one expects positions
	measured below the Roblox top bar, like mouse/touch input).
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local GamepadAim = {}

-- Look (same "glass lab" palette as UI.luau)
local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local DISPLAY_ORDER = 18 -- above the main UI (10), below the tutorial (19/20)

local RETICLE_SIZE = 48 -- pixels
local TICK_LENGTH = 13
local TICK_WIDTH = 3
local CENTER_SIZE = 8

-- Feel
local DEADZONE = 0.18 -- stick movement smaller than this is ignored (worn sticks drift)
local SPEED = 0.95 -- full stick = this many screen-heights per second (before acceleration)
local CURVE = 1.7 -- > 1: small pushes move very slowly, for fine aiming
local ACCEL_START = 0.5 -- speed multiplier when the stick is first pushed...
local ACCEL_MAX = 1.7 -- ...growing to this...
local ACCEL_TIME = 0.6 -- ...after holding it this many seconds
local RECENTER_DELAY = 0.5 -- seconds after letting go before drifting back
local RECENTER_RATE = 1.2 -- how fast it drifts back (higher = faster)
local EDGE_MARGIN = 24 -- the crosshair stays this far inside the screen

local camera = workspace.CurrentCamera
local accentColor = Color3.fromRGB(90, 200, 255) -- replaced by setAccent with the zone color

local gui
local reticle
local reticleScale
local accentParts = {} -- frames tinted with the zone accent color

local usingGamepad = false
local activeGamepad = Enum.UserInputType.Gamepad1
local position -- Vector2, viewport pixels (nil until the first update)
local lastViewport = Vector2.zero
local holdTime = 0 -- seconds the stick has been pushed
local idleTime = 0 -- seconds since the stick was let go
local shown = false

local function isGamepad(inputType)
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

local function isPointer(inputType)
	return inputType == Enum.UserInputType.Touch
		or inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseButton3
		or inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.MouseWheel
end

local function onInputType(inputType)
	if isGamepad(inputType) then
		usingGamepad = true
		activeGamepad = inputType
	elseif isPointer(inputType) then
		usingGamepad = false
	end
	-- Keyboard / text input / focus changes leave it as it was.
end

local function new(className, props)
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	instance.Parent = props.Parent
	return instance
end

-- One crosshair arm: an ink bar with a paper outline, so it reads on bright
-- glass and on dark walls alike.
local function tick(size, anchor, offset)
	local bar = new("Frame", {
		AnchorPoint = anchor,
		Position = UDim2.new(0.5, offset.X, 0.5, offset.Y),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Parent = reticle,
	})
	new("UIStroke", { Color = PAPER, Thickness = 1, Parent = bar })
	return bar
end

-- Hard ink corner bracket (blueprint registration mark).
local function bracket(anchor, where)
	local holder = new("Frame", {
		AnchorPoint = anchor,
		Position = where,
		Size = UDim2.fromOffset(9, 9),
		BackgroundTransparency = 1,
		Parent = reticle,
	})
	local horizontal = new("Frame", {
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.fromScale(0, anchor.Y),
		AnchorPoint = Vector2.new(0, anchor.Y),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Parent = holder,
	})
	local vertical = new("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.fromScale(anchor.X, 0),
		AnchorPoint = Vector2.new(anchor.X, 0),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Parent = holder,
	})
	horizontal.BackgroundColor3 = accentColor
	vertical.BackgroundColor3 = accentColor
	table.insert(accentParts, horizontal)
	table.insert(accentParts, vertical)
end

local function buildGui()
	gui = Instance.new("ScreenGui")
	gui.Name = "GamepadAim"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = DISPLAY_ORDER
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	-- Whole screen, top bar included: offsets here are viewport pixels.
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.Enabled = false

	reticle = new("Frame", {
		Name = "Reticle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(RETICLE_SIZE, RETICLE_SIZE),
		BackgroundTransparency = 1,
		Active = false,
		Parent = gui,
	})
	reticleScale = new("UIScale", { Parent = reticle })

	-- Four arms with a gap in the middle so the target stays visible.
	local gap = CENTER_SIZE / 2 + 4
	tick(Vector2.new(TICK_WIDTH, TICK_LENGTH), Vector2.new(0.5, 1), Vector2.new(0, -gap))
	tick(Vector2.new(TICK_WIDTH, TICK_LENGTH), Vector2.new(0.5, 0), Vector2.new(0, gap))
	tick(Vector2.new(TICK_LENGTH, TICK_WIDTH), Vector2.new(1, 0.5), Vector2.new(-gap, 0))
	tick(Vector2.new(TICK_LENGTH, TICK_WIDTH), Vector2.new(0, 0.5), Vector2.new(gap, 0))

	-- Zone-colored corner brackets.
	bracket(Vector2.new(0, 0), UDim2.fromScale(0, 0))
	bracket(Vector2.new(1, 0), UDim2.fromScale(1, 0))
	bracket(Vector2.new(0, 1), UDim2.fromScale(0, 1))
	bracket(Vector2.new(1, 1), UDim2.fromScale(1, 1))

	-- Center: small accent square with an ink hairline.
	local center = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(CENTER_SIZE, CENTER_SIZE),
		BackgroundColor3 = accentColor,
		BorderSizePixel = 0,
		Parent = reticle,
	})
	new("UIStroke", { Color = INK, Thickness = 1.5, Parent = center })
	table.insert(accentParts, center)

	-- Annotation tag: which button throws.
	local tag = new("TextLabel", {
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(1, 4, 1, 2),
		Size = UDim2.fromOffset(52, 14),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		Font = Enum.Font.RobotoMono,
		Text = "R2 THROW",
		TextColor3 = INK,
		TextSize = 9,
		Parent = reticle,
	})
	new("UIStroke", { Color = INK, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tag })

	gui.Parent = player:WaitForChild("PlayerGui")
end

local function viewportSize()
	local size = camera.ViewportSize
	if size.X < 1 or size.Y < 1 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function clampToScreen(point, size)
	local margin = math.min(EDGE_MARGIN, size.X / 4, size.Y / 4)
	return Vector2.new(math.clamp(point.X, margin, size.X - margin), math.clamp(point.Y, margin, size.Y - margin))
end

-- The strongest thumbstick push right now (screen direction: y grows downward),
-- with the deadzone taken out. Zero vector when both sticks rest.
local function readSticks()
	local best = Vector2.zero
	local ok, state = pcall(UserInputService.GetGamepadState, UserInputService, activeGamepad)
	if not ok then
		return best
	end
	for _, input in state do
		if input.KeyCode == Enum.KeyCode.Thumbstick1 or input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local stick = Vector2.new(input.Position.X, -input.Position.Y)
			if stick.Magnitude > best.Magnitude then
				best = stick
			end
		end
	end
	local magnitude = best.Magnitude
	if magnitude <= DEADZONE then
		return Vector2.zero
	end
	-- Rescale so movement starts smoothly at the deadzone edge.
	local strength = math.min(1, (magnitude - DEADZONE) / (1 - DEADZONE))
	return best.Unit * strength
end

-- Called once per frame by RunController. running: a run is going (throws allowed).
function GamepadAim.update(dt, running)
	if not gui then
		return
	end
	local size = viewportSize()
	local centre = size / 2
	if not position then
		position = centre
	elseif size ~= lastViewport and lastViewport.X > 0 then
		-- Screen rotated / resized: keep the same relative spot.
		position = Vector2.new(position.X / lastViewport.X * size.X, position.Y / lastViewport.Y * size.Y)
	end
	lastViewport = size

	local visible = running and usingGamepad
	if visible ~= shown then
		shown = visible
		gui.Enabled = visible
		if visible then
			-- Every run starts aiming straight ahead.
			position = centre
			holdTime, idleTime = 0, 0
		end
	end
	if not visible then
		return
	end

	local stick = readSticks()
	if stick.Magnitude > 0 then
		holdTime += dt
		idleTime = 0
		local accel = ACCEL_START + (ACCEL_MAX - ACCEL_START) * math.min(1, holdTime / ACCEL_TIME)
		local pixelsPerSecond = SPEED * size.Y * accel * stick.Magnitude ^ CURVE
		position += stick.Unit * pixelsPerSecond * dt
	else
		holdTime = 0
		idleTime += dt
		if idleTime > RECENTER_DELAY then
			-- Frame-rate independent ease back to the middle.
			position = position:Lerp(centre, 1 - math.exp(-RECENTER_RATE * dt))
		end
	end
	position = clampToScreen(position, size)
	reticle.Position = UDim2.fromOffset(position.X, position.Y)
end

-- Is the crosshair on screen (gamepad player, run going)?
function GamepadAim.isShown()
	return shown
end

-- Was the last input from a gamepad?
function GamepadAim.usingGamepad()
	return usingGamepad
end

-- Where to throw, in viewport pixels (use camera:ViewportPointToRay).
function GamepadAim.viewportPosition()
	return clampToScreen(position or viewportSize() / 2, viewportSize())
end

-- Little kick on the crosshair when a ball is thrown.
function GamepadAim.pulse()
	if not reticleScale then
		return
	end
	reticleScale.Scale = 1.3
	TweenService:Create(reticleScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
end

-- Zone accent color for the corner brackets and center (RunController's applyTheme).
function GamepadAim.setAccent(color)
	accentColor = color
	for _, part in accentParts do
		part.BackgroundColor3 = color
	end
end

local started = false
function GamepadAim.start()
	if started then
		return
	end
	started = true
	buildGui()

	onInputType(UserInputService:GetLastInputType())
	-- Consoles have no mouse or touch: start in gamepad mode even before any press.
	if
		UserInputService.GamepadEnabled
		and not UserInputService.TouchEnabled
		and not UserInputService.MouseEnabled
	then
		usingGamepad = true
	end
	UserInputService.LastInputTypeChanged:Connect(onInputType)

	-- The camera object can be replaced (rare); keep following the current one.
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		camera = workspace.CurrentCamera or camera
	end)
end

return GamepadAim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Haptics</string>
            <string name="Source"><![CDATA[--[[
	Vibration ("haptics") for phones and controllers.

	Haptics.play(kind) with kind:
	  "throw"      tiny tap
	  "shatter"    sharp, short
	  "bigShatter" stronger (full walls, mega ball, door burst)
	  "crash"      heavy, about a quarter second
	  "crystal"    soft pulse
	  "levelUp"    celebration pattern
	  "boost"      a boost from the boost bar switched on (double pop)
	  "gift"       celebration pattern

	Where it buzzes: the controller the player is using (gamepad), or the phone
	itself when the player is on touch. Keyboard / mouse players get nothing.

	Everything is checked at runtime and wrapped in pcall, so devices without
	vibration (most PCs, some phones) simply do nothing - never an error.
	Respects Settings "vibration" (turning it off stops the motors right away).

	Phones: Roblox drives phone vibration through HapticService with the Touch
	input type when the device reports support. If it doesn't, we try the newer
	HapticEffect object (preset effects) when this Roblox version has it.
]]

local HapticService = game:GetService("HapticService")
local UserInputService = game:GetService("UserInputService")

local Settings = require(script.Parent.Settings)

local Haptics = {}

local LARGE = Enum.VibrationMotor.Large
local SMALL = Enum.VibrationMotor.Small
local TOUCH = Enum.UserInputType.Touch

-- Light effects (throw / shatter / crystal) can come many times a second with
-- multiball. They're dropped if one played less than this long ago (~15/s).
local MIN_LIGHT_INTERVAL = 1 / 15
local LIGHT_KINDS = { throw = true, shatter = true, crystal = true }

-- Each pattern is a list of pulses: { at = delay, large = 0..1, small = 0..1, time = seconds }.
-- "large" is the heavy rumble motor, "small" the quick buzzy one.
local PATTERNS = {
	throw = { { at = 0, large = 0, small = 0.22, time = 0.035 } },
	shatter = { { at = 0, large = 0.15, small = 0.55, time = 0.05 } },
	bigShatter = { { at = 0, large = 0.7, small = 0.8, time = 0.12 } },
	crash = { { at = 0, large = 1, small = 0.75, time = 0.25 } },
	crystal = { { at = 0, large = 0, small = 0.35, time = 0.07 } },
	levelUp = {
		{ at = 0, large = 0.3, small = 0.5, time = 0.07 },
		{ at = 0.13, large = 0.4, small = 0.6, time = 0.07 },
		{ at = 0.26, large = 0.8, small = 0.8, time = 0.18 },
	},
}
PATTERNS.gift = PATTERNS.levelUp
PATTERNS.boost = {
	{ at = 0, large = 0.2, small = 0.6, time = 0.05 },
	{ at = 0.08, large = 0.55, small = 0.7, time = 0.1 },
}

-- Preset effects used for the HapticEffect fallback (names are Roblox enum items;
-- an item this Roblox version doesn't have is just skipped).
local EFFECT_TYPES = {
	throw = "UIClick",
	shatter = "GameplayCollision",
	bigShatter = "GameplayExplosion",
	crash = "GameplayExplosion",
	crystal = "UIHover",
	levelUp = "UINotification",
	gift = "UINotification",
	boost = "UINotification",
}

-- Support checks -------------------------------------------------------------------

-- inputType -> { [motor] = true } (nil = not checked yet). Gamepads can be plugged
-- in later, so the cache is cleared when one connects / disconnects.
local supportCache = {}

local function supportedMotors(inputType)
	local cached = supportCache[inputType]
	if cached then
		return cached
	end
	local motors = {}
	local ok, vibrates = pcall(HapticService.IsVibrationSupported, HapticService, inputType)
	if ok and vibrates then
		for _, motor in { LARGE, SMALL } do
			local okMotor, supported = pcall(HapticService.IsMotorSupported, HapticService, inputType, motor)
			if okMotor and supported then
				motors[motor] = true
			end
		end
	end
	supportCache[inputType] = motors
	return motors
end

local function isGamepad(inputType)
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

-- The controller / phone to buzz right now (nil = nothing to buzz).
local lastGamepad = Enum.UserInputType.Gamepad1
local function currentTarget()
	local lastInput = UserInputService:GetLastInputType()
	if isGamepad(lastInput) then
		lastGamepad = lastInput
		return lastInput
	end
	if lastInput == TOUCH or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
		return TOUCH
	end
	-- Console before any button press reports no "last input" worth trusting.
	if UserInputService.GamepadEnabled and not UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return lastGamepad
	end
	return nil
end

-- Motors ---------------------------------------------------------------------------

-- What each motor is doing: motorState[inputType][motor] = { value, untilTime, token }.
local motorState = {}

local function setMotor(inputType, motor, value)
	pcall(HapticService.SetMotor, HapticService, inputType, motor, value)
end

local function stateFor(inputType, motor)
	motorState[inputType] = motorState[inputType] or {}
	local state = motorState[inputType][motor]
	if not state then
		state = { value = 0, untilTime = 0, token = nil }
		motorState[inputType][motor] = state
	end
	return state
end

-- Runs one motor at `value` for `duration` seconds. A weaker pulse that arrives
-- while a stronger one is still running is skipped (you couldn't feel it anyway);
-- a stronger one takes over and switches the motor off at its own end time.
local function pulseMotor(inputType, motor, value, duration)
	if value <= 0 then
		return
	end
	local now = os.clock()
	local state = stateFor(inputType, motor)
	if state.untilTime > now and state.value >= value then
		return
	end
	local token = {}
	state.token = token
	state.value = value
	state.untilTime = now + duration
	setMotor(inputType, motor, value)
	task.delay(duration, function()
		if state.token == token then
			state.token = nil
			state.value = 0
			setMotor(inputType, motor, 0)
		end
	end)
end

local function stopAll()
	for inputType, motors in motorState do
		for motor, state in motors do
			state.token = nil
			state.value = 0
			state.untilTime = 0
			setMotor(inputType, motor, 0)
		end
	end
end

-- Plays one pulse of a pattern on the target's motors. If the device has only
-- one motor, that motor gets the stronger of the two values.
local function playPulse(inputType, motors, pulse)
	if motors[LARGE] and motors[SMALL] then
		pulseMotor(inputType, LARGE, pulse.large, pulse.time)
		pulseMotor(inputType, SMALL, pulse.small, pulse.time)
	elseif motors[LARGE] then
		pulseMotor(inputType, LARGE, math.max(pulse.large, pulse.small), pulse.time)
	elseif motors[SMALL] then
		pulseMotor(inputType, SMALL, math.max(pulse.large, pulse.small), pulse.time)
	end
end

-- HapticEffect fallback (phones) -----------------------------------------------------

local effectsAvailable = nil -- nil = not checked yet
local effects = {} -- kind -> HapticEffect (false = this preset isn't available)

local function effectFor(kind)
	if effectsAvailable == false then
		return nil
	end
	if effects[kind] ~= nil then
		return effects[kind] or nil
	end
	local ok, effect = pcall(function()
		local instance = Instance.new("HapticEffect")
		instance.Type = (Enum :: any).HapticEffectType[EFFECT_TYPES[kind]]
		instance.Parent = workspace
		return instance
	end)
	if not ok or not effect then
		-- No HapticEffect class at all: stop trying. A missing preset: skip just that kind.
		local classOk = pcall(function()
			Instance.new("HapticEffect"):Destroy()
		end)
		if not classOk then
			effectsAvailable = false
		end
		effects[kind] = false
		return nil
	end
	effectsAvailable = true
	effects[kind] = effect
	return effect
end

-- Public ---------------------------------------------------------------------------

local lastLight = 0

function Haptics.isEnabled()
	return Settings.get("vibration") ~= false
end

function Haptics.play(kind)
	local pattern = PATTERNS[kind]
	if not pattern or not Haptics.isEnabled() then
		return
	end
	local target = currentTarget()
	if not target then
		return
	end

	local now = os.clock()
	if LIGHT_KINDS[kind] then
		if now - lastLight < MIN_LIGHT_INTERVAL then
			return
		end
		lastLight = now
	end

	local motors = supportedMotors(target)
	if next(motors) == nil then
		-- No motor control: phones may still have preset haptic effects.
		if target == TOUCH then
			local effect = effectFor(kind)
			if effect then
				pcall(effect.Play, effect)
			end
		end
		return
	end

	for _, pulse in pattern do
		if pulse.at <= 0 then
			playPulse(target, motors, pulse)
		else
			task.delay(pulse.at, function()
				-- Turned off (or switched device) in the meantime: skip the rest.
				if Haptics.isEnabled() and currentTarget() == target then
					playPulse(target, motors, pulse)
				end
			end)
		end
	end
end

-- Stops every motor right now.
Haptics.stop = stopAll

Settings.changed:Connect(function(key, value)
	if key == "vibration" and value == false then
		stopAll()
	end
end)

-- A motor must never keep buzzing: stop when the window loses focus, and forget
-- cached support when controllers come and go.
UserInputService.WindowFocusReleased:Connect(stopAll)
UserInputService.GamepadConnected:Connect(function(gamepad)
	supportCache[gamepad] = nil
end)
UserInputService.GamepadDisconnected:Connect(function(gamepad)
	supportCache[gamepad] = nil
	if motorState[gamepad] then
		for _, state in motorState[gamepad] do
			state.token = nil
			state.value = 0
			state.untilTime = 0
		end
	end
end)
-- Switching from controller to touch (or another controller) stops the old one.
UserInputService.LastInputTypeChanged:Connect(function(inputType)
	if isGamepad(inputType) and inputType ~= lastGamepad then
		local old = motorState[lastGamepad]
		if old then
			for motor, state in old do
				state.token = nil
				state.value = 0
				state.untilTime = 0
				setMotor(lastGamepad, motor, 0)
			end
		end
		lastGamepad = inputType
	end
end)

return Haptics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">HeldBall</string>
            <string name="Source"><![CDATA[--[[
	A ball held in one hand.

	Viewmodel.luau owns two of these (one per hand) and tells each one where to
	be every frame. This file only deals with the ball itself: building the
	equipped skin's look (BallFx.held, premium skins included), swapping in the
	Blender model once it has loaded, rebuilding when the graphics setting
	changes, and drawing it at a given spot and size.

	It's a real 3D ball, lit by the zone's lights, placed relative to the camera
	every frame.

	local ball = HeldBall.new(particleShare)
		particleShare = { High = number, Low = number }: premium balls' particle
		rate for this ball at each graphics level (two hands = two balls, so each
		sparkles a bit less to keep phones smooth).
	ball.attach(folder)        -- the run's world folder (call after building a new one)
	ball.setSkin(skinId)
	ball.draw(cframe, scale, now)
		Draws the ball centered on cframe (which also turns it). scale 1 = the
		normal held size (HeldBall.DIAMETER across for plain balls, a bit more
		for premium ones). scale <= 0 hides it.
	ball.hide()
	ball.radius() -> studs     -- drawn radius at scale 1
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local BallFx = require(script.Parent.BallFx)
local Settings = require(script.Parent.Settings)

local HeldBall = {}

-- Look
HeldBall.DIAMETER = 0.9 -- studs across for a plain ball (the arms are sized around this)
local PREMIUM_DIAMETER = 1.25 -- premium balls have rings / flares around the core
local PREMIUM_SHARE = 1.2 -- ...so they're drawn a little bigger to keep the core readable
local MIN_SCALE = 0.02 -- smaller than this = hidden
local MESH_CHECK = 1 -- seconds between "has the Blender model loaded yet?" checks

local function graphicsLow()
	local ok, level = pcall(Settings.graphicsLevel)
	return ok and level == "Low"
end

function HeldBall.new(particleShare)
	local ball = {}

	local folder = nil
	local skinId = "Default"
	local held = nil -- BallFx.held object
	local heldLow = nil -- graphics level it was built for
	local shown = false
	local lastMeshCheck = 0
	local failedSkin = nil -- a skin whose ball couldn't be built (not retried every frame)
	local meshTried = false -- already rebuilt once for the loaded Blender model (don't loop if it still fails)

	local function destroyHeld()
		if held then
			held.destroy()
			held = nil
		end
		shown = false
	end

	local function build()
		destroyHeld()
		if not folder or folder.Parent == nil then
			return
		end
		local premium = BallFx.isPremium(skinId)
		local diameter = if premium then PREMIUM_DIAMETER else HeldBall.DIAMETER
		local low = graphicsLow()
		local particleScale = if particleShare then particleShare[if low then "Low" else "High"] else 1
		local ok, result = pcall(BallFx.held, skinId, diameter, particleScale)
		if ok and result then
			held = result
			heldLow = low
			held.diameter = diameter
			held.share = if premium then PREMIUM_SHARE else 1
		else
			failedSkin = skinId
			warn("[HeldBall] could not build the ball:", result)
		end
	end

	function ball.hide()
		if held and shown then
			held.root.Parent = nil
		end
		shown = false
	end

	function ball.attach(newFolder)
		folder = newFolder
		destroyHeld() -- the old one went with the old world
	end

	function ball.setSkin(newSkinId)
		newSkinId = Config.getSkin(newSkinId).Id
		if newSkinId ~= skinId then
			skinId = newSkinId
			failedSkin = nil
			meshTried = false
			destroyHeld()
		end
	end

	function ball.radius()
		local share = if BallFx.isPremium(skinId) then PREMIUM_SHARE else 1
		return HeldBall.DIAMETER * share / 2
	end

	function ball.draw(cframe, scale, now)
		if scale <= MIN_SCALE or not folder or folder.Parent == nil then
			ball.hide()
			return
		end
		if (held == nil and failedSkin ~= skinId) or (held and heldLow ~= graphicsLow()) then
			build()
		elseif held and not held.mesh and not meshTried and BallFx.isPremium(skinId) and now - lastMeshCheck > MESH_CHECK then
			lastMeshCheck = now
			if BallFx.hasMesh(skinId) then
				meshTried = true -- one try: if the model still can't be used, keep the stand-in
				build() -- the Blender model finished loading: swap the stand-in for it
			end
		end
		if held == nil then
			return
		end
		if not shown then
			shown = true
			held.root.Parent = folder
		end
		-- scale 1 = HeldBall.DIAMETER (x the premium share) across.
		local size = scale * HeldBall.DIAMETER * held.share / held.diameter
		held.place(cframe, size, now)
	end

	return ball
end

return HeldBall
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">LeaveGift</string>
            <string name="Source"><![CDATA[--[[
	"Wait! A free gift for you."

	When a player opens the Roblox menu (Esc / the Roblox button / Start on a
	controller), they might be about to leave. If they close it again and come
	back, we surprise them with a free gift (Config.LeaveGift.Rewards, taking
	turns).

	Rules:
	  * Nothing happens while the menu is open, so leaving is never blocked or slowed.
	  * Only after Config.LeaveGift.MinPlaySeconds of play this session, and only
	    when the server's cooldown (LeaveGiftNext attribute) has run out.
	  * At most once per cooldown window (declining means no more popups this session).
	  * Never in the middle of a run: it waits for the menu / game over screen.
	The server checks everything again when CLAIM is pressed (Shop "ClaimLeaveGift").
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Haptics = require(script.Parent.Haptics)
local Sounds = require(script.Parent.Sounds)

local player = Players.LocalPlayer

local LeaveGift = {}

-- Look (same "glass lab" palette as UI.luau)
local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local GREY = Color3.fromRGB(112, 108, 100)
local WHITE = Color3.new(1, 1, 1)
local FONT_NUM = Enum.Font.Michroma
local FONT_LABEL = Enum.Font.RobotoMono

local DISPLAY_ORDER = 50 -- above the main UI (10) and the tutorial (20)
local REF_W, REF_H = 600, 340 -- same reference sheet as UI.luau
local SCALE_MIN, SCALE_MAX = 0.8, 2
local CARD_W, CARD_H = 320, 228
local SHADOW = 6
local SHARDS = 28
local CHECK_INTERVAL = 0.5 -- seconds between checks while a gift is waiting for the run to end

local settings = Config.LeaveGift
local sessionStart = os.clock()

local options = {} -- { claim = function() -> (ok, message), canShow = function() -> bool }
local accentColor = Config.Themes[1].Accent
local accentTargets = {} -- instance -> property

local gui, wash, fitScale, popScale, burstLayer
local rewardLabel, claimButton, claimLabel, claimPulseScale, noThanksButton, statusLabel

local menuWasOpened = false
local pending = false -- came back from the menu during a run: show when it ends
local showing = false
local busy = false
local shownWindow = nil -- LeaveGiftNext value when we last showed it (once per window)
local pulseTween = nil

-- Helpers ------------------------------------------------------------------------

local function new(className, props)
	local instance = Instance.new(className)
	if instance:IsA("GuiObject") then
		instance.BorderSizePixel = 0
	end
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	instance.Parent = props.Parent
	return instance
end

local function stroke(parent, thickness, color)
	return new("UIStroke", {
		Thickness = thickness,
		Color = color or INK,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = parent,
	})
end

local function label(props)
	local merged = {
		BackgroundTransparency = 1,
		Font = FONT_LABEL,
		TextColor3 = INK,
		TextSize = 10,
		Text = "",
	}
	for key, value in props do
		merged[key] = value
	end
	return new("TextLabel", merged)
end

local function accent(instance, property)
	instance[property] = accentColor
	accentTargets[instance] = property
	return instance
end

local function tween(instance, time, props, style, direction)
	local t = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function isGamepad(inputType)
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

-- Eligibility --------------------------------------------------------------------

local function rewards()
	return if settings and type(settings.Rewards) == "table" then settings.Rewards else {}
end

local function nextReward()
	local list = rewards()
	local index = tonumber(player:GetAttribute("LeaveGiftIndex"))
	if #list == 0 or not index then
		return nil
	end
	return list[math.floor(index) % #list + 1]
end

local function isEligible()
	if not settings or showing then
		return false
	end
	local nextTime = tonumber(player:GetAttribute("LeaveGiftNext"))
	if not nextTime or not nextReward() then
		return false -- data not loaded yet, or no rewards set up
	end
	if shownWindow == nextTime then
		return false -- already offered in this window (claimed windows move LeaveGiftNext on)
	end
	if os.clock() - sessionStart < settings.MinPlaySeconds then
		return false
	end
	return workspace:GetServerTimeNow() >= nextTime
end

-- Popup --------------------------------------------------------------------------

-- Confetti: little glass shards (triangles) flying out of the card.
local function burst(count)
	local colors = { accentColor, INK, WHITE, accentColor }
	for i = 1, count do
		local size = math.random(6, 14)
		local shard = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size * (0.6 + math.random() * 0.8)),
			Rotation = math.random(0, 359),
			BackgroundColor3 = colors[i % #colors + 1],
			ZIndex = 5,
			Parent = burstLayer,
		})
		-- A diagonal hard-edged gradient turns the square into a triangle.
		new("UIGradient", {
			Rotation = 45,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.499, 0),
				NumberSequenceKeypoint.new(0.501, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = shard,
		})

		local angle = (i / count) * math.pi * 2 + (math.random() - 0.5) * 0.5
		local distance = 140 + math.random() * 140
		local target = Vector2.new(math.cos(angle) * distance, math.sin(angle) * distance * 0.75 - 30)
		local time = 0.7 + math.random() * 0.4
		tween(shard, time, {
			Position = UDim2.new(0.5, target.X, 0.5, target.Y),
			Rotation = shard.Rotation + math.random(-360, 360),
		}, Enum.EasingStyle.Quad)
		task.delay(time * 0.5, function()
			if shard.Parent then
				tween(shard, time * 0.5, { BackgroundTransparency = 1 }, Enum.EasingStyle.Linear)
			end
		end)
		task.delay(time + 0.05, function()
			shard:Destroy()
		end)
	end
end

local function refit()
	if not gui then
		return
	end
	local size = gui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return
	end
	fitScale.Scale = math.clamp(math.min(size.X / REF_W, size.Y / REF_H), SCALE_MIN, SCALE_MAX)
end

local function stopPulse()
	if pulseTween then
		pulseTween:Cancel()
		pulseTween = nil
	end
	if claimPulseScale then
		claimPulseScale.Scale = 1
	end
end

local function hide()
	if not showing then
		return
	end
	showing = false
	busy = false
	stopPulse()
	-- Give gamepad selection back if it was on our buttons.
	local selected = GuiService.SelectedObject
	if selected and gui and selected:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
	tween(wash, 0.2, { BackgroundTransparency = 1 })
	local closing = tween(popScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	closing.Completed:Once(function()
		if not showing then
			gui.Enabled = false
		end
	end)
end

local function show()
	local reward = nextReward()
	if not reward or not gui then
		return
	end
	showing = true
	busy = false
	shownWindow = tonumber(player:GetAttribute("LeaveGiftNext"))

	rewardLabel.Text = string.upper(tostring(reward.Text or "FREE GIFT"))
	claimLabel.Text = "CLAIM"
	statusLabel.Text = ""
	gui.Enabled = true
	refit()

	-- Punchy pop-in: overshoot, a little wobble, then shards everywhere.
	-- The backdrop only ever fades in once (no flashing, see Settings "flashes").
	wash.BackgroundTransparency = 1
	tween(wash, 0.25, { BackgroundTransparency = 0.3 })
	popScale.Scale = 0.3
	tween(popScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	local pop = popScale.Parent
	pop.Rotation = -6
	tween(pop, 0.5, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	Sounds.play("Gift")
	Haptics.play("crystal") -- a soft nudge: "look at this"
	burst(SHARDS)

	-- The CLAIM button breathes to draw the eye.
	stopPulse()
	pulseTween = TweenService:Create(
		claimPulseScale,
		TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 0.45),
		{ Scale = 1.06 }
	)
	pulseTween:Play()

	if isGamepad(UserInputService:GetLastInputType()) then
		GuiService.SelectedObject = claimButton
	end
end

local function claim()
	if not showing or busy then
		return
	end
	busy = true
	stopPulse()
	claimLabel.Text = "..."
	local ok, message = false, "Try again later"
	if options.claim then
		ok, message = options.claim()
	end
	if not showing then
		return -- closed while we were waiting
	end
	if ok then
		-- The server's "Reward" toast says what was given.
		claimLabel.Text = "CLAIMED!"
		Haptics.play("gift")
		burst(SHARDS)
		task.delay(0.7, hide)
	else
		claimLabel.Text = "CLAIM"
		statusLabel.Text = string.upper(tostring(message or "Try again later"))
		task.delay(1.8, hide)
	end
end

local function buildGui()
	gui = new("ScreenGui", {
		Name = "LeaveGift",
		ResetOnSpawn = false,
		DisplayOrder = DISPLAY_ORDER,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		Enabled = false,
	})
	gui.ScreenInsets = Enum.ScreenInsets.None -- the wash covers the whole screen

	-- Paper wash over the game (also stops taps going through to throws).
	wash = new("TextButton", {
		Name = "Wash",
		AutoButtonColor = false,
		Selectable = false,
		Text = "",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.3,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})

	local fitHolder = new("Frame", {
		Name = "Fit",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	fitScale = new("UIScale", { Parent = fitHolder })

	burstLayer = new("Frame", {
		Name = "Burst",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = fitHolder,
	})

	local popHolder = new("Frame", {
		Name = "Pop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = fitHolder,
	})
	popScale = new("UIScale", { Parent = popHolder })

	-- Hard ink shadow + the paper card.
	new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(SHADOW, SHADOW),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = INK,
		Parent = popHolder,
	})
	local card = new("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PAPER,
		Active = true,
		Parent = popHolder,
	})
	stroke(card, 2)

	-- Header strip.
	local header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = INK,
		Parent = card,
	})
	label({
		Text = "FIG. 00 / SPECIAL DELIVERY",
		TextSize = 9,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(0.7, -10, 1, 0),
		Parent = header,
	})
	accent(label({
		Text = "FREE",
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromScale(0.7, 0),
		Size = UDim2.new(0.3, -10, 1, 0),
		Parent = header,
	}), "TextColor3")

	-- Title.
	label({
		Text = "WAIT!",
		Font = FONT_NUM,
		TextSize = 32,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 36),
		Parent = card,
	})
	label({
		Text = "A FREE GIFT FOR YOU",
		Font = FONT_NUM,
		TextSize = 12,
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = card,
	})

	-- The reward plate: paper with an ink hairline and a zone-accent edge.
	local plate = new("Frame", {
		Name = "Reward",
		Position = UDim2.fromOffset(20, 94),
		Size = UDim2.new(1, -40, 0, 42),
		BackgroundColor3 = PAPER,
		Parent = card,
	})
	stroke(plate, 1.5)
	accent(new("Frame", {
		Name = "Edge",
		Size = UDim2.new(0, 8, 1, 0),
		Parent = plate,
	}), "BackgroundColor3")
	label({
		Text = "ITEM 01",
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.fromOffset(60, 10),
		Parent = plate,
	})
	rewardLabel = label({
		Font = FONT_NUM,
		TextSize = 14,
		TextWrapped = true,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -22, 1, -10),
		Parent = plate,
	})

	-- Big CLAIM button: zone-accent face on a hard ink shadow, breathing.
	local claimHolder = new("Frame", {
		Name = "Claim",
		Position = UDim2.fromOffset(20, 146),
		Size = UDim2.new(1, -40, 0, 46),
		BackgroundTransparency = 1,
		Parent = card,
	})
	claimPulseScale = new("UIScale", { Parent = claimHolder })
	new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = INK,
		Parent = claimHolder,
	})
	claimButton = accent(new("TextButton", {
		Name = "Face",
		AutoButtonColor = false,
		Selectable = true,
		Text = "",
		Size = UDim2.new(1, -4, 1, -4),
		Parent = claimHolder,
	}), "BackgroundColor3")
	stroke(claimButton, 2)
	claimLabel = label({
		Text = "CLAIM",
		Font = FONT_NUM,
		TextSize = 20,
		TextColor3 = INK,
		Size = UDim2.fromScale(1, 1),
		Parent = claimButton,
	})
	claimButton.MouseButton1Down:Connect(function()
		claimButton.Position = UDim2.fromOffset(2, 2)
	end)
	claimButton.MouseButton1Up:Connect(function()
		claimButton.Position = UDim2.new()
	end)
	claimButton.MouseLeave:Connect(function()
		claimButton.Position = UDim2.new()
	end)
	claimButton.Activated:Connect(function()
		claimButton.Position = UDim2.new()
		task.spawn(claim)
	end)

	-- Small "no thanks" (a comfortable tap area, quiet text).
	noThanksButton = new("TextButton", {
		Name = "NoThanks",
		AutoButtonColor = false,
		Selectable = true,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 196),
		Size = UDim2.fromOffset(140, 26),
		Font = FONT_LABEL,
		Text = "NO THANKS",
		TextSize = 10,
		TextColor3 = GREY,
		Parent = card,
	})
	noThanksButton.Activated:Connect(function()
		if not busy then
			hide()
		end
	end)
	claimButton.NextSelectionDown = noThanksButton
	noThanksButton.NextSelectionUp = claimButton

	-- Error line (e.g. "COME BACK LATER") under the plate.
	statusLabel = label({
		Text = "",
		TextSize = 8,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(0, 136),
		Size = UDim2.new(1, 0, 0, 10),
		Parent = card,
	})

	gui.Parent = player:WaitForChild("PlayerGui")
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	refit()
end

-- Shows the gift now if everything allows it; otherwise keeps it waiting
-- (pending) only while it's still deserved.
local function tryShow()
	if not pending then
		return
	end
	if not isEligible() then
		pending = false
		return
	end
	if GuiService.MenuIsOpen then
		return -- never while the Roblox menu is up
	end
	if options.canShow and not options.canShow() then
		return -- mid-run: wait for the menu / game over screen
	end
	pending = false
	show()
end

-- Public -------------------------------------------------------------------------

-- Zone accent color (RunController's applyTheme).
function LeaveGift.setAccent(color)
	accentColor = color
	for instance, property in accentTargets do
		if instance.Parent then
			instance[property] = color
		else
			accentTargets[instance] = nil
		end
	end
end

-- opts.claim(): asks the server (Shop "ClaimLeaveGift"), returns ok, message.
-- opts.canShow(): false while a run is going.
local started = false
function LeaveGift.start(opts)
	if started then
		return
	end
	started = true
	options = opts or {}
	if not settings then
		return
	end
	buildGui()

	-- Opening the menu does nothing at all (leaving stays instant).
	GuiService.MenuOpened:Connect(function()
		menuWasOpened = true
	end)
	GuiService.MenuClosed:Connect(function()
		if not menuWasOpened then
			return
		end
		menuWasOpened = false
		if isEligible() then
			pending = true
			-- Next frame, so the menu has fully gone.
			task.defer(tryShow)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			if pending then
				tryShow()
			end
		end
	end)
end

return LeaveGift
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">LightingFx</string>
            <string name="Source"><![CDATA[--[[
	Realistic lighting for each zone, plus real lights inside every room.

	- Each zone style has its own time of day, ambient light, atmosphere haze,
	  color grading and bloom. Crossing a checkpoint fades smoothly to the next.
	- lightRoom() turns a room's biggest glowing (Neon) parts into actual light
	  sources and lets decorations cast shadows, so nothing looks flat.
	- Shadow-casting lights are expensive, so only the room the camera is in
	  and the next one get one (setShadowRooms, called by TrackBuilder when the
	  camera enters a new room). All other room lights have no shadows.
	Requires Lighting.Technology = Future in the place (set in place.project.json).
	Everything here runs on the player's own device only.

	Graphics setting (Settings.graphicsLevel(), changes apply right away):
	  High - everything above.
	  Low  - no room lights, no shadows at all, softer bloom and sun rays.
	         Switching to Low also switches off lights/shadows in rooms already
	         built; switching back to High lights them up again.
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Settings = require(script.Parent.Settings)

local LightingFx = {}

local FADE = TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local LIGHTS_PER_ROOM = 4
local PARTS_PER_PAUSE_CHECK = 16 -- lightRoom checks the build time budget this often
local SHADOW_CASTER_MAX_SIZE = 15 -- the room shell (80 studs long) never casts
local SHADOW_CASTER_MIN_SIZE = 1.5 -- tiny details (seams, trim, glyph bars) never cast either
-- Phones and tablets: no shadow-casting lights (too heavy for their GPUs).
local TOUCH_ONLY = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Low graphics: a small, faint bloom (a big bloom is several full-screen blur
-- passes, the heaviest thing for a phone's GPU) and no sun rays at all.
local LOW_BLOOM_INTENSITY = 0.5 -- multiplier...
local LOW_BLOOM_MAX_INTENSITY = 0.4 -- ...but never more than this
local LOW_BLOOM_MAX_SIZE = 12
local SUNRAYS_INTENSITY = 0.04 -- High only (switched off on Low)

-- Per zone style. Colors are Color3, numbers are the Lighting/effect properties.
local PRESETS = {
	Lab = {
		ClockTime = 14,
		Brightness = 2.4,
		Ambient = Color3.fromRGB(105, 112, 125),
		OutdoorAmbient = Color3.fromRGB(150, 158, 170),
		ExposureCompensation = 0.1,
		Atmosphere = { Density = 0.38, Offset = 0.1, Haze = 1, Glare = 0 },
		Grade = { Brightness = 0.02, Contrast = 0.08, Saturation = 0.05, TintColor = Color3.fromRGB(240, 248, 255) },
		Bloom = { Intensity = 0.55, Size = 24, Threshold = 1.1 },
		LightBrightness = 1.4,
		LightRange = 16,
	},
	Neon = {
		ClockTime = 0,
		Brightness = 0.4,
		Ambient = Color3.fromRGB(38, 36, 58),
		OutdoorAmbient = Color3.fromRGB(50, 45, 75),
		ExposureCompensation = 0.2,
		Atmosphere = { Density = 0.45, Offset = 0.05, Haze = 2, Glare = 0.3 },
		Grade = { Brightness = 0, Contrast = 0.18, Saturation = 0.22, TintColor = Color3.fromRGB(255, 235, 250) },
		Bloom = { Intensity = 1.1, Size = 30, Threshold = 0.85 },
		LightBrightness = 2.2,
		LightRange = 18,
	},
	Temple = {
		ClockTime = 17.6,
		Brightness = 2,
		Ambient = Color3.fromRGB(120, 88, 60),
		OutdoorAmbient = Color3.fromRGB(165, 125, 90),
		ExposureCompensation = 0,
		Atmosphere = { Density = 0.42, Offset = 0.15, Haze = 2.2, Glare = 0.6 },
		Grade = { Brightness = 0.01, Contrast = 0.12, Saturation = 0.12, TintColor = Color3.fromRGB(255, 236, 214) },
		Bloom = { Intensity = 0.8, Size = 28, Threshold = 0.95 },
		LightBrightness = 1.8,
		LightRange = 16,
	},
	Greenhouse = {
		ClockTime = 12.5,
		Brightness = 3,
		Ambient = Color3.fromRGB(95, 120, 95),
		OutdoorAmbient = Color3.fromRGB(150, 175, 145),
		ExposureCompensation = 0,
		Atmosphere = { Density = 0.4, Offset = 0.2, Haze = 2.5, Glare = 0.2 },
		Grade = { Brightness = 0.02, Contrast = 0.06, Saturation = 0.15, TintColor = Color3.fromRGB(245, 255, 235) },
		Bloom = { Intensity = 0.5, Size = 26, Threshold = 1.15 },
		LightBrightness = 1.2,
		LightRange = 14,
	},
	Void = {
		ClockTime = 0,
		Brightness = 0.25,
		Ambient = Color3.fromRGB(48, 30, 70),
		OutdoorAmbient = Color3.fromRGB(60, 40, 90),
		ExposureCompensation = 0.25,
		Atmosphere = { Density = 0.5, Offset = 0, Haze = 1.5, Glare = 0.4 },
		Grade = { Brightness = 0, Contrast = 0.2, Saturation = 0.18, TintColor = Color3.fromRGB(240, 225, 255) },
		Bloom = { Intensity = 1.3, Size = 34, Threshold = 0.8 },
		LightBrightness = 2.4,
		LightRange = 18,
	},
	-- Icy blue cave: cold morning light, crisp contrast, a little desaturated.
	Frost = {
		ClockTime = 9.5,
		Brightness = 2.2,
		Ambient = Color3.fromRGB(92, 118, 150),
		OutdoorAmbient = Color3.fromRGB(150, 180, 212),
		ExposureCompensation = 0.15,
		Atmosphere = { Density = 0.42, Offset = 0.12, Haze = 1.6, Glare = 0.2 },
		Grade = { Brightness = 0.03, Contrast = 0.12, Saturation = -0.05, TintColor = Color3.fromRGB(222, 238, 255) },
		Bloom = { Intensity = 0.75, Size = 28, Threshold = 1 },
		LightBrightness = 1.6,
		LightRange = 16,
	},
	-- Forge: dark dusk outside, everything lit red-orange by the lava.
	Magma = {
		ClockTime = 19.6,
		Brightness = 0.7,
		Ambient = Color3.fromRGB(105, 45, 26),
		OutdoorAmbient = Color3.fromRGB(135, 60, 32),
		ExposureCompensation = 0.1,
		Atmosphere = { Density = 0.5, Offset = 0.05, Haze = 2.6, Glare = 0.8 },
		Grade = { Brightness = 0, Contrast = 0.2, Saturation = 0.2, TintColor = Color3.fromRGB(255, 222, 196) },
		Bloom = { Intensity = 1.2, Size = 32, Threshold = 0.85 },
		LightBrightness = 2.6,
		LightRange = 18,
	},
	-- Deep teal water: thick haze, soft light from above (the caustic ripples are in Decor).
	Aquarium = {
		ClockTime = 13,
		Brightness = 1.2,
		Ambient = Color3.fromRGB(28, 84, 96),
		OutdoorAmbient = Color3.fromRGB(40, 112, 124),
		ExposureCompensation = 0.12,
		Atmosphere = { Density = 0.56, Offset = 0.1, Haze = 2.8, Glare = 0 },
		Grade = { Brightness = 0, Contrast = 0.12, Saturation = 0.1, TintColor = Color3.fromRGB(200, 245, 238) },
		Bloom = { Intensity = 0.95, Size = 30, Threshold = 0.9 },
		LightBrightness = 2,
		LightRange = 18,
	},
	-- Bright, airy midday high above the clouds.
	Sky = {
		ClockTime = 12,
		Brightness = 3.2,
		Ambient = Color3.fromRGB(150, 164, 190),
		OutdoorAmbient = Color3.fromRGB(190, 205, 232),
		ExposureCompensation = 0.2,
		Atmosphere = { Density = 0.3, Offset = 0.25, Haze = 1.2, Glare = 0.5 },
		Grade = { Brightness = 0.04, Contrast = 0.05, Saturation = 0.06, TintColor = Color3.fromRGB(252, 252, 255) },
		Bloom = { Intensity = 0.6, Size = 26, Threshold = 1.1 },
		LightBrightness = 1.2,
		LightRange = 14,
	},
	-- Purple-white crystal core: dark room, glowing crystals, strong bloom.
	Core = {
		ClockTime = 0,
		Brightness = 0.3,
		Ambient = Color3.fromRGB(70, 46, 96),
		OutdoorAmbient = Color3.fromRGB(90, 62, 122),
		ExposureCompensation = 0.3,
		Atmosphere = { Density = 0.46, Offset = 0, Haze = 1.8, Glare = 0.5 },
		Grade = { Brightness = 0, Contrast = 0.22, Saturation = 0.25, TintColor = Color3.fromRGB(246, 232, 255) },
		Bloom = { Intensity = 1.4, Size = 36, Threshold = 0.78 },
		LightBrightness = 2.6,
		LightRange = 20,
	},
}

local atmosphere
local grade
local bloom
local sunRays
local currentTheme = nil
local bloomTween = nil -- the zone fade, cancelled if the graphics level changes mid-fade
local low = Settings.graphicsLevel() == "Low"

-- Rooms that went through lightRoom: roomFolder -> { theme, lights = { PointLight }, casters = { BasePart }, shadowLight }.
-- Weak keys: a room deleted behind the camera just drops out.
local rooms = setmetatable({}, { __mode = "k" })
-- Room folders allowed a shadow-casting light right now (at most 2, see setShadowRooms).
local shadowRooms = setmetatable({}, { __mode = "k" })

local function presetFor(theme)
	return PRESETS[theme and theme.Style or "Lab"] or PRESETS.Lab
end

function LightingFx.isLow()
	return low
end

local function bloomGoal(preset)
	if not low then
		return preset.Bloom
	end
	return {
		Intensity = math.min(preset.Bloom.Intensity * LOW_BLOOM_INTENSITY, LOW_BLOOM_MAX_INTENSITY),
		Size = math.min(preset.Bloom.Size, LOW_BLOOM_MAX_SIZE),
		Threshold = preset.Bloom.Threshold,
	}
end

-- Global switches that depend on the graphics level.
local function applyQuality()
	Lighting.GlobalShadows = not low
	if sunRays then
		-- A full-screen pass that barely shows indoors (and not at all in the night zones).
		sunRays.Intensity = SUNRAYS_INTENSITY
		sunRays.Enabled = not low
	end
end

-- Replaces whatever the place had (the Baseplate template ships its own
-- Atmosphere/Bloom) with our own effects.
function LightingFx.setup()
	for _, child in Lighting:GetChildren() do
		if
			child:IsA("Atmosphere")
			or child:IsA("BloomEffect")
			or child:IsA("ColorCorrectionEffect")
			or child:IsA("SunRaysEffect")
			or child:IsA("DepthOfFieldEffect")
		then
			child:Destroy()
		end
	end

	Lighting.ShadowSoftness = 0.25
	Lighting.EnvironmentDiffuseScale = 1 -- PBR ambient from the sky
	Lighting.EnvironmentSpecularScale = 1 -- reflections on glass, metal, marble

	atmosphere = Instance.new("Atmosphere")
	atmosphere.Parent = Lighting

	grade = Instance.new("ColorCorrectionEffect")
	grade.Parent = Lighting

	bloom = Instance.new("BloomEffect")
	bloom.Parent = Lighting

	sunRays = Instance.new("SunRaysEffect")
	sunRays.Spread = 0.6
	sunRays.Parent = Lighting

	applyQuality()
	LightingFx.applyTheme(nil, true)
end

-- Fades the whole look to a zone's preset (instant = true skips the fade).
function LightingFx.applyTheme(theme, instant)
	if not atmosphere then
		return
	end
	currentTheme = theme
	local preset = presetFor(theme)

	local fogColor = if theme then theme.Fog else Color3.fromRGB(215, 230, 245)
	local function set(object, goal)
		if object == bloom and bloomTween then
			bloomTween:Cancel()
			bloomTween = nil
		end
		if instant then
			for property, value in goal do
				object[property] = value
			end
		else
			local fade = TweenService:Create(object, FADE, goal)
			fade:Play()
			if object == bloom then
				bloomTween = fade
			end
		end
	end

	set(Lighting, {
		ClockTime = preset.ClockTime,
		Brightness = preset.Brightness,
		Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient,
		ExposureCompensation = preset.ExposureCompensation,
	})
	set(atmosphere, {
		Density = preset.Atmosphere.Density,
		Offset = preset.Atmosphere.Offset,
		Haze = preset.Atmosphere.Haze,
		Glare = preset.Atmosphere.Glare,
		Color = fogColor,
		Decay = fogColor:Lerp(Color3.new(0, 0, 0), 0.35),
	})
	set(grade, preset.Grade)
	set(bloom, bloomGoal(preset))
end

-- Gives the room's main light shadows only if it's one of the shadow rooms.
local function applyShadow(roomFolder, record)
	local light = record.shadowLight
	if light then
		local wanted = shadowRooms[roomFolder] == true and not low and not TOUCH_ONLY
		if light.Shadows ~= wanted then
			light.Shadows = wanted
		end
	end
end

-- Only these rooms (the camera's room and the next one) get a shadow-casting light.
function LightingFx.setShadowRooms(roomFolder, nextRoomFolder)
	table.clear(shadowRooms)
	if roomFolder then
		shadowRooms[roomFolder] = true
	end
	if nextRoomFolder then
		shadowRooms[nextRoomFolder] = true
	end
	for folder, record in rooms do
		applyShadow(folder, record)
	end
end

-- Switches a lit room's lights and shadows off (Low graphics).
local function darkenRoom(record)
	for _, light in record.lights do
		light:Destroy()
	end
	for _, part in record.casters do
		if part.Parent then
			part.CastShadow = false
		end
	end
	table.clear(record.lights)
	table.clear(record.casters)
	record.shadowLight = nil
	record.lit = false
end

-- Adds the real lights and shadows to a room (High graphics).
-- pause (optional): called every few parts so a room build can wait for the
-- next frame when its time is up (TrackBuilder's time slicing).
local function lightUp(roomFolder, record, pause)
	local preset = presetFor(record.theme)
	local glowing = {}
	for index, part in roomFolder:GetDescendants() do
		if pause and index % PARTS_PER_PAUSE_CHECK == 0 then
			pause()
		end
		if not part:IsA("BasePart") then
			continue
		end
		local size = part.Size
		local kind = part:GetAttribute("Kind")

		if part.Material == Enum.Material.Neon and part.Transparency < 0.8 then
			local area = size.X * size.Y + size.Y * size.Z + size.X * size.Z
			if area > 1.5 and kind ~= "Glass" and kind ~= "Crystal" then
				table.insert(glowing, { part = part, area = area })
			end
		elseif
			(kind == "Wall" or kind == "Prop")
			and math.max(size.X, size.Y, size.Z) < SHADOW_CASTER_MAX_SIZE
			and size.Magnitude > SHADOW_CASTER_MIN_SIZE
			and part.Transparency < 0.5
		then
			part.CastShadow = true
			table.insert(record.casters, part)
		end
	end

	-- While this room build was paused the graphics setting may have changed
	-- (and lit the room already, or switched to Low): nothing more to do then.
	if record.lit or low then
		return
	end

	table.sort(glowing, function(a, b)
		return a.area > b.area
	end)

	-- Spread lights out: skip glowing parts too close to one already lit.
	local lit = {}
	for _, entry in glowing do
		if #lit >= LIGHTS_PER_ROOM then
			break
		end
		local position = entry.part.Position
		local tooClose = false
		for _, other in lit do
			if (other.Position - position).Magnitude < 12 then
				tooClose = true
				break
			end
		end
		if not tooClose then
			local light = Instance.new("PointLight")
			light.Name = "RoomLight"
			light.Color = entry.part.Color
			light.Brightness = preset.LightBrightness
			light.Range = preset.LightRange
			light.Shadows = false -- see applyShadow
			light.Parent = entry.part
			table.insert(lit, entry.part)
			table.insert(record.lights, light)
		end
	end
	-- The biggest light is the one that may cast shadows (when the camera is near).
	record.shadowLight = record.lights[1]
	record.lit = true
	applyShadow(roomFolder, record)
end

-- Turns the room's biggest glowing parts into real lights and lets decorations
-- cast shadows. Call after the room (and its decorations) are built.
-- On Low graphics it only remembers the room (so switching to High can light it).
-- pause: optional, see lightUp.
function LightingFx.lightRoom(roomFolder, theme, pause)
	local record = rooms[roomFolder]
	if not record then
		record = { theme = theme, lights = {}, casters = {}, lit = false }
		rooms[roomFolder] = record
	end
	record.theme = theme
	if low then
		if record.lit then
			darkenRoom(record)
		end
	elseif not record.lit then
		lightUp(roomFolder, record, pause)
	end
end

-- Graphics setting changed: re-apply everything to match.
local function onGraphicsChanged()
	local nowLow = Settings.graphicsLevel() == "Low"
	if nowLow == low then
		return
	end
	low = nowLow
	applyQuality()
	if bloom then
		if bloomTween then
			bloomTween:Cancel()
			bloomTween = nil
		end
		local preset = presetFor(currentTheme)
		for property, value in bloomGoal(preset) do
			bloom[property] = value
		end
	end
	for roomFolder, record in rooms do
		if not roomFolder.Parent then
			rooms[roomFolder] = nil
		elseif low then
			if record.lit then
				darkenRoom(record)
			end
		elseif not record.lit then
			lightUp(roomFolder, record)
		end
	end
end

Settings.changed:Connect(function(key)
	if key == "graphics" then
		onGraphicsChanged()
	end
end)

return LightingFx
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="33">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point. Everything interesting is in RunController.
]]

local RunController = require(script.Parent.RunController)

RunController.start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Models</string>
            <string name="Source"><![CDATA[--[[
	Places the Blender models loaded by the server (ReplicatedStorage.ModelLibrary).
	If a model isn't uploaded yet (ID 0 in Config.Models) or hasn't loaded,
	Models.place returns nil and the caller builds its block version instead.

	Model parts are named <Model>_<Role> (Glass, Metal, Wood, Stone, Neon, Plant, Body).
	Each role gets its color/material from Shared.ModelStyles, overridable per call.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModelStyles = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelStyles"))

local Models = {}

local function library()
	return ReplicatedStorage:FindFirstChild("ModelLibrary")
end

function Models.has(name)
	local folder = library()
	return folder ~= nil and folder:FindFirstChild(name) ~= nil
end

local function roleOf(part)
	return part.Name:match("_(%w+)$") or "Body"
end

--[[
	options = {
		kind = "Wall" | "Prop",            -- Prop = breakable decoration
		anchor = "floor" | "ceiling" | "center",  -- which point of the model sits at `cframe`
		scale = number?,
		colors = { [Role] = Color3 }?,     -- e.g. tint glass with the zone accent
	}
]]
function Models.place(name, parent, cframe, options)
	local folder = library()
	local template = folder and folder:FindFirstChild(name)
	if not template then
		return nil
	end
	options = options or {}

	local model = template:Clone()
	local style = ModelStyles[name] or {}
	local kind = options.kind or (if style.Breakable then "Prop" else "Wall")

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local role = roleOf(part)
			local roleStyle = style[role]
			if type(roleStyle) == "table" and roleStyle.Material then
				part.Color = roleStyle.Color
				part.Material = roleStyle.Material
				part.Transparency = roleStyle.Transparency
			end
			if options.colors and options.colors[role] then
				part.Color = options.colors[role]
			end
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CastShadow = false
			part:SetAttribute("Kind", kind)
		end
	end
	if kind == "Prop" then
		model:SetAttribute("Breakable", true)
	end

	-- Imported FBX units can come in at the wrong scale; fit the model to its
	-- true height from the manifest, then apply any extra scale asked for.
	local scale = options.scale or 1
	if style.Size then
		local _, importedSize = model:GetBoundingBox()
		if importedSize.Y > 0.01 then
			scale *= style.Size.Y / importedSize.Y
		end
	end
	if math.abs(scale - 1) > 0.001 then
		model:ScaleTo(model:GetScale() * scale)
	end

	-- Line the chosen anchor point of the bounding box up with `cframe`.
	model:PivotTo(CFrame.new(model:GetPivot().Position) * cframe.Rotation)
	local boxCFrame, boxSize = model:GetBoundingBox()
	local anchorOffset = Vector3.zero
	local anchor = options.anchor or style.Anchor
	if anchor == "floor" then
		anchorOffset = Vector3.new(0, boxSize.Y / 2, 0)
	elseif anchor == "ceiling" then
		anchorOffset = Vector3.new(0, -boxSize.Y / 2, 0)
	end
	local target = cframe.Position + anchorOffset
	model:PivotTo(model:GetPivot() + (target - boxCFrame.Position))

	model.Parent = parent
	return model
end

return Models
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PerfOverlay</string>
            <string name="Source"><![CDATA[--[[
	Playtest helper: a tiny label in the bottom-left corner showing
	  FPS     - frames per second (smoothed)
	  MAX     - the slowest single frame in the last ~2 seconds, in milliseconds
	            (16.7 = still 60 fps; a stutter shows up here even if FPS looks fine)
	  PARTS   - parts in the current run's world (rooms, decorations, balls)
	  SHARDS  - shard / chip pieces flying or lying around right now
	Only shown when Config.SHOW_PERF is true. Turn it off before release.

	PerfOverlay.start(getShardCount) once; PerfOverlay.watch(runFolder) each time
	a new run world is built.

	Cheap on purpose: frame times go into two 1-second buckets (no lists), the
	part count follows DescendantAdded / DescendantRemoving instead of counting
	every frame, and the text is rewritten 4 times a second.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local PerfOverlay = {}

local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local TEXT_INTERVAL = 0.25 -- seconds between label updates
local BUCKET_SECONDS = 1 -- worst frame = max of this bucket and the previous one (1-2 s)

local label
local started = false
local getShards = function()
	return 0
end

local partCount = 0
local connections = {}

local smoothedDt = 1 / 60
local lastFrame = os.clock()
local bucketStart = os.clock()
local bucketWorst = 0
local previousWorst = 0
local nextText = 0

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "PerfOverlay"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50 -- above the game UI, but it never takes input
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- A paper strip with an ink hairline, hugging the bottom-left corner of the
	-- safe area, below where the HUD's corner button sits.
	local plate = Instance.new("TextLabel")
	plate.Name = "Stats"
	plate.Active = false
	plate.AnchorPoint = Vector2.new(0, 1)
	plate.Position = UDim2.new(0, 4, 1, -1)
	plate.Size = UDim2.fromOffset(0, 12)
	plate.AutomaticSize = Enum.AutomaticSize.X
	plate.BackgroundColor3 = PAPER
	plate.BackgroundTransparency = 0.1
	plate.BorderSizePixel = 0
	plate.Font = Enum.Font.RobotoMono
	plate.TextSize = 10
	plate.TextColor3 = INK
	plate.TextXAlignment = Enum.TextXAlignment.Left
	plate.Text = "-- FPS"
	pcall(function()
		plate.Interactable = false -- never blocks taps or clicks (newer property)
	end)

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 4)
	padding.Parent = plate

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = INK
	stroke.Thickness = 1
	stroke.Parent = plate

	plate.Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return plate
end

local function onFrame()
	local now = os.clock()
	local dt = now - lastFrame
	lastFrame = now

	smoothedDt += (dt - smoothedDt) * 0.08
	if now - bucketStart >= BUCKET_SECONDS then
		previousWorst = bucketWorst
		bucketWorst = 0
		bucketStart = now
	end
	if dt > bucketWorst then
		bucketWorst = dt
	end

	if now >= nextText then
		nextText = now + TEXT_INTERVAL
		local worst = math.max(bucketWorst, previousWorst)
		label.Text = string.format(
			"%d FPS  MAX %.1f MS  PARTS %d  SHARDS %d",
			math.floor(1 / math.max(smoothedDt, 1e-4) + 0.5),
			worst * 1000,
			partCount,
			getShards()
		)
		label.TextColor3 = if worst > 1 / 30 then Color3.fromRGB(200, 30, 30) else INK
	end
end

-- getShardCount: function returning how many shard pieces are live.
function PerfOverlay.start(getShardCount)
	if started or not Config.SHOW_PERF then
		return
	end
	started = true
	if getShardCount then
		getShards = getShardCount
	end
	label = build()
	RunService.RenderStepped:Connect(onFrame)
end

-- Counts the parts in a run's world folder from now on.
function PerfOverlay.watch(folder)
	if not started then
		return
	end
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	partCount = 0
	if not folder then
		return
	end
	for _, descendant in folder:GetDescendants() do
		if descendant:IsA("BasePart") then
			partCount += 1
		end
	end
	table.insert(
		connections,
		folder.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("BasePart") then
				partCount += 1
			end
		end)
	)
	table.insert(
		connections,
		folder.DescendantRemoving:Connect(function(descendant)
			if descendant:IsA("BasePart") then
				partCount -= 1
			end
		end)
	)
end

return PerfOverlay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RunController</string>
            <string name="Source"><![CDATA[--[[
	The game itself: moves the camera down the corridor, throws balls,
	smashes glass, counts crystals and handles game over / revive.
	Runs entirely on the player's device. The server only gets the distance and
	a few run stats (glass smashed, crystals, props, best multiball), and works
	out gems / XP / missions itself.

	Boosts (Config.Boosts): picked in the menu or bought mid-run. The server
	confirms which ones really started (Progress "BoostsActivated", or the
	"UseBoostNow" answer for a Robux boost bought mid-run) and only those count.
	  Shield     - the next crash costs no balls (buying more stacks: one per crash)
	  Magnet     - crystals near the camera fly to you for a few seconds
	  MegaBall   - the next few throws are giant balls that smash through everything
	  SlowMo     - the world (camera, balls) runs slower for a few seconds
	  DoubleGems - handled by the server, only shown here
	Picked Shield and 2x Gems work by themselves from the start. Picked Magnet,
	Slow-Mo and Mega Ball (Config.BOOST_BAR) wait "ready" in the HUD boost bar
	until the player taps them (or D-pad Left / Up / Right, or keys 1 / 2 / 3);
	any never tapped go back to the inventory when the run really ends. A boost
	bought with Robux mid-run is switched on straight away.

	Game feel (section "Feel" below): hit-stop (a split-second freeze) on big
	smashes, a field-of-view punch on every smash, a kick + shake on crashes, a
	tiny recoil on throws, and phone / controller vibration (Haptics.luau).
	Camera effects follow Settings "shake", the shield tint follows "flashes".

	Your arms (Viewmodel.luau): your avatar's arms come up from the bottom
	corners of the view, each hand holding the equipped ball. Throws alternate
	right, left, right, left; a multiball throw uses both hands at once. A throw
	launches from the hand toward the aim point (what the screen ray hits),
	steered so it lands exactly where you aimed even with the camera's forward
	speed added. Then that hand grabs a new ball from the pocket. Each hit
	splashes the skin's colors (Shatter.skinBurst).

	Destruction: balls knock solid decorations loose (Shatter.knockLoose) and kick
	up dust + chips where they hit walls and floor (Shatter.impact). Knocked
	pieces can't be hit again and never block glass.

	Smoothness: nothing in the frame loop builds new tables (the HUD tables are
	reused), crash checks read TrackBuilder's cached hazard list, and
	PerfOverlay (Config.SHOW_PERF) shows FPS / worst frame / part counts.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local BallFx = require(script.Parent.BallFx)
local GamepadAim = require(script.Parent.GamepadAim)
local Haptics = require(script.Parent.Haptics)
local LeaveGift = require(script.Parent.LeaveGift)
local Shatter = require(script.Parent.Shatter)
local Sounds = require(script.Parent.Sounds)
local TrackBuilder = require(script.Parent.TrackBuilder)
local LightingFx = require(script.Parent.LightingFx)
local PerfOverlay = require(script.Parent.PerfOverlay)
local Settings = require(script.Parent.Settings)
local Tutorial = require(script.Parent.Tutorial)
local UI = require(script.Parent.UI)
local Viewmodel = require(script.Parent.Viewmodel)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local ORIGIN = Config.TRACK_ORIGIN
local FORWARD = Vector3.new(0, 0, -1)
local CRASH_MARGIN = 0.25 -- small allowance only: if it looks like you missed the glass, you missed it
local GRAVITY = Vector3.new(0, -Config.BALL_GRAVITY, 0)
local BALL_STEPS = 3 -- collision checks per ball per frame
local BEHIND_CAMERA = 15 -- normal balls this far behind the camera are removed
local TUTORIAL_MIN_BALL_SPEED = 0.5 -- balls still fly at least half speed while the tutorial slows time
local MEGA_STEPS = 8 -- mega balls can smash through several things in one frame
local KNOCK_SPLASH = 1.2 -- a ball knocking a decoration loose also knocks parts this close (multi-part decorations come apart)
local KNOCK_OUT = 0.8 -- knocked parts fly along the ball, plus this much straight out of the surface
local MEGA_KNOCK_REACH = 1 -- mega balls knock loose everything within their radius plus this
local MEGA_STRENGTH = 1.5 -- ...and knock it harder
local DECOR_DEPTH = 3 -- decorations stick out this far from the walls / floor / ceiling

-- Throwing from the hands (Viewmodel.luau)
local HAND_BLEND_TIME = 0.08 -- seconds a thrown ball's drawing takes to join its real path from the hand
local MEGA_HAND_BLEND_TIME = 0.15 -- the same for giant balls (slower, so the big ball reads as thrown)
local TRAIL_SPEED_BONUS = 0.6 -- trails last up to this much longer at top speed

-- Boosts
local BOOSTS = Config.Boosts
local MAGNET = BOOSTS.Magnet
local MEGA = BOOSTS.MegaBall
local SLOWMO = BOOSTS.SlowMo
local SHIELD = BOOSTS.Shield
local MEGA_RADIUS = Config.BALL_RADIUS * MEGA.Scale
local MEGA_PUSH = 1.6 -- mega balls blast glass shards harder
local MAGNET_PULL_SPEED = 60 -- studs per second a crystal flies at (plus the camera's speed)
local MAGNET_PICKUP = 1.5 -- this close to the camera = collected
local SLOWMO_EASE = 0.35 -- seconds to slow down / speed back up
local WHITE = Color3.new(1, 1, 1)
local SHIELD_FLASH = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
-- Boost bar: picked boosts that wait until tapped, and the controller / keyboard
-- keys that use them (same order as Config.BOOST_BAR: Magnet, Slow-Mo, Mega Ball).
local BOOST_BAR = Config.BOOST_BAR
local BOOST_PAD_KEYS = { Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadRight }
local BOOST_NUMBER_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three }
local BOOST_KEYS_ACTION = "ShatterRunBoostKeys" -- ContextActionService name (bound only during a run)
local BOOST_TIP_RETRY = 0.5 -- seconds between tries at the one-time boost bar tip
local BASE_SATURATION = 0 -- zone grading already sets saturation; this layer stays neutral

-- Feel
local BASE_FOV = 70
local SPEED_FOV = 15 -- extra field of view at top speed
local HITSTOP_TIME = 0.06 -- seconds the world freezes on a big smash
local HITSTOP_BIG_TIME = 0.07 -- mega ball breaking several things at once
local HITSTOP_MAX = 0.1 -- a burst of big smashes never freezes longer than this in total...
local HITSTOP_COOLDOWN = 0.35 -- ...and the next freeze waits this long after one ends
local HITSTOP_SCALE = 0.03 -- world speed while frozen (not quite 0, so it never looks stuck)
local BIG_PANE_AREA = 150 -- panes at least this big (square studs) count as a big smash (full walls)
local FOV_PUNCH_SHATTER = 3
local FOV_PUNCH_BIG = 5
local FOV_PUNCH_CRASH = 6
local FOV_PUNCH_MAX = 7
local FOV_PUNCH_RETURN = 15 -- how fast the punch eases back (gone after ~0.2 s)
local KICK_RETURN = 12 -- how fast camera kicks / recoil settle
local THROW_RECOIL = math.rad(0.5) -- camera tips up this much on a throw
local CRASH_KICK = math.rad(3.5) -- camera snaps up this much on a crash...
local CRASH_ROLL = math.rad(2.5) -- ...and tilts sideways up to this much
local KICK_MAX = math.rad(6)

-- Roblox's own UI we hide (the game has its own leaderboard, and the player
-- list would cover the distance readout). Chat stays on.
local HIDDEN_CORE_GUI = {
	Enum.CoreGuiType.Backpack,
	Enum.CoreGuiType.Health,
	Enum.CoreGuiType.PlayerList,
	Enum.CoreGuiType.EmotesMenu,
}
local CORE_GUI_ATTEMPTS = 10

local RunController = {}

-- State ----------------------------------------------------------------------

local state = "Menu" -- "Menu" | "Running" | "GameOver"
local world -- Folder holding everything for the current run
local shardFolder
local track
local raycastParams
local overlapParams -- the track only, for knocking decorations loose

local cameraZ = ORIGIN.Z
local speed = Config.START_SPEED
local balls = 0
local multiball = 1
local streak = 0
local lastThrow = 0
local lastRoom = 0
local lastReportedRoom = 0 -- last room index sent to the server with RoomReached
local startCheckpoint = 0
local shake = 0
local activeBalls = {}
local reportedMeters = 0
local runFx -- shatter effect equipped for this run (Config.ShatterFx entry)
local runSkinStyle = nil -- the equipped ball's impact colors (BallFx.impactStyle)
-- Counted from the start of the run (a revive continues it). Sent with RunEnded.
local runStats = { glass = 0, crystals = 0, props = 0, maxMultiball = 1 }
local ui

-- Boosts running in this run (only what the server confirmed).
-- shield = crashes it still absorbs, magnet / slowmo = seconds left,
-- megaball = giant throws left.
local boost = { shield = 0, magnet = 0, slowmo = 0, megaball = 0, doubleGems = false }
-- Boost-bar boosts the server confirmed but the player hasn't tapped yet:
-- { [boostId] = count } for every id in Config.BOOST_BAR. The UI reads this table.
local ready = {}
for _, boostId in BOOST_BAR do
	ready[boostId] = 0
end
local boostKeysBound = false
local boostTipDone = false -- the "tap a boost" tip was shown (or seen in an earlier session)
local boostTipWait = 0
local timeScale = 1 -- 1 = normal speed, lower while SlowMo is on
local slowLook = 0 -- how much of the slow-mo color effect is showing (0..1)
local magnetized = {} -- crystals currently flying to the camera

-- Feel (see the "Feel" section)
local hitStopLeft = 0 -- real seconds of freeze still to go
local hitStopUsed = 0 -- seconds frozen in the current burst (capped at HITSTOP_MAX)
local hitStopCooldown = 0
local lastTutorialScale = 1 -- the tutorial's slow-down last frame (no hit-stop while it slows time)
local fovPunch = 0 -- extra degrees of field of view, easing back to 0
local kickPitch = 0 -- radians, camera tipped up (recoil / crash), easing back to 0
local kickRoll = 0 -- radians, camera tilted sideways (crash), easing back to 0
local shakeOn = Settings.get("shake") ~= false
local flashesOn = Settings.get("flashes") ~= false
local runSerial = 0 -- RunStarted events sent; the server echoes it with BoostsActivated
local unusedBoostsSent = true -- ReturnUnusedBoosts already sent for this run (none before the first run)

-- Purchases
-- A Robux prompt opened during a run freezes the run until it closes, so the
-- player can't crash while reading it. Safety net: never frozen longer than this.
local PROMPT_FREEZE_MAX = 120
local promptFreezeUntil = 0 -- os.clock() the freeze ends at (0 = not frozen)
local rerollAfterPurchase = nil -- mission id to reroll once an ExtraReroll purchase arrives

-- Helpers --------------------------------------------------------------------

local function ownsPass(passKey)
	return player:GetAttribute("Pass_" .. passKey) == true
end

local function minimumMultiball()
	return if ownsPass("Multiball") then 2 else 1
end

local function meters()
	return math.max(0, math.floor((ORIGIN.Z - cameraZ) / Config.STUDS_PER_METER))
end

local function currentRoom()
	return math.max(0, (ORIGIN.Z - cameraZ) // Config.ROOM_LENGTH)
end

local function cameraPosition()
	return Vector3.new(ORIGIN.X, ORIGIN.Y + Config.CAMERA_HEIGHT, cameraZ)
end

-- One table reused every frame (the UI only reads it).
local hudState = { balls = 0, multiball = 1, streak = 0, meters = 0, zone = 0 }

local function updateHud()
	hudState.balls = balls
	hudState.multiball = multiball
	hudState.streak = (streak % Config.CRYSTALS_PER_MULTIBALL_LEVEL) / Config.CRYSTALS_PER_MULTIBALL_LEVEL
	hudState.meters = meters()
	hudState.zone = currentRoom() // Config.ROOMS_PER_CHECKPOINT
	ui:setHud(hudState)
end

-- Lighting -------------------------------------------------------------------

-- Zone lighting lives in LightingFx. This extra color layer is only for
-- gameplay effects (slow-mo desaturation, shield flash), stacked on top.
local colorCorrection

local function setupLighting()
	LightingFx.setup()

	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "GameplayGrade"
	colorCorrection.Saturation = BASE_SATURATION
	colorCorrection.Parent = Lighting
end

local function applyTheme(zone)
	local theme = TrackBuilder.themeFor(zone * Config.ROOMS_PER_CHECKPOINT)
	LightingFx.applyTheme(theme)
	ui:setTheme(theme)
	GamepadAim.setAccent(theme.Accent)
	LeaveGift.setAccent(theme.Accent)
end

-- Feel -----------------------------------------------------------------------

-- Freezes the world for a split second (balls, camera, crystals). Real-time
-- things (boost timers, the UI, the tutorial) keep going. Several big smashes
-- in a row never add up to more than HITSTOP_MAX, and never while the tutorial
-- is slowing time down.
local function hitStop(duration)
	if state ~= "Running" or hitStopCooldown > 0 or lastTutorialScale < 0.999 then
		return
	end
	local extra = math.min(duration - hitStopLeft, HITSTOP_MAX - hitStopUsed)
	if extra > 0 then
		hitStopLeft += extra
		hitStopUsed += extra
	end
end

-- Counts the freeze down in real time. Returns the world speed multiplier.
local function tickHitStop(dt)
	if hitStopLeft > 0 then
		hitStopLeft -= dt
		if hitStopLeft <= 0 then
			hitStopLeft = 0
			hitStopUsed = 0
			hitStopCooldown = HITSTOP_COOLDOWN
		end
		return HITSTOP_SCALE
	end
	hitStopCooldown = math.max(0, hitStopCooldown - dt)
	return 1
end

-- Camera effects (all skipped when the player turned camera shake off).
local function punchFov(amount)
	if shakeOn then
		fovPunch = math.min(FOV_PUNCH_MAX, math.max(fovPunch, amount))
	end
end

local function kickCamera(pitch, roll)
	if shakeOn then
		kickPitch = math.clamp(kickPitch + pitch, -KICK_MAX, KICK_MAX)
		kickRoll = math.clamp(kickRoll + roll, -KICK_MAX, KICK_MAX)
	end
end

local function shakeCamera(amount)
	if shakeOn then
		shake = math.max(shake, amount)
	end
end

local function resetFeel()
	hitStopLeft, hitStopUsed, hitStopCooldown = 0, 0, 0
	fovPunch, kickPitch, kickRoll, shake = 0, 0, 0, 0
end

-- One smash's feedback. big = full wall, mega multi-break or door burst.
local function smashFeedback(big)
	if big then
		hitStop(HITSTOP_TIME)
		punchFov(FOV_PUNCH_BIG)
		Haptics.play("bigShatter")
	else
		punchFov(FOV_PUNCH_SHATTER)
		Haptics.play("shatter")
	end
end

Settings.changed:Connect(function(key, value)
	if key == "shake" then
		shakeOn = value ~= false
		if not shakeOn then
			fovPunch, kickPitch, kickRoll, shake = 0, 0, 0, 0
		end
	elseif key == "flashes" then
		flashesOn = value ~= false
	end
end)

-- Balls ----------------------------------------------------------------------

-- mega: a giant MegaBall boost ball (bigger, always has a trail).
-- lite: a cheaper look for the extra balls of a multiball throw (premium balls
-- only: no rings, particles or light). The look itself is in BallFx.luau.
-- priority: the ball just thrown from the hand (always full detail; it's big
-- and close for its first moments). trailScale: longer trails at high speed.
local function makeBallPart(mega, lite, priority, trailScale)
	local radius = if mega then MEGA_RADIUS else Config.BALL_RADIUS
	return BallFx.create(player:GetAttribute("EquippedSkin"), radius, {
		mega = mega,
		lite = lite,
		priority = priority,
		trailScale = trailScale,
		parent = shardFolder,
	})
end

-- The equipped ball's colors splash out wherever one of your balls hits.
local function skinImpact(position, normal, big)
	if runSkinStyle then
		Shatter.skinBurst(position, normal, runSkinStyle, big)
	end
end

-- Draws a ball where it is (balls thrown from the hand are drawn a little
-- toward the hand for their first moment, see throwAlong).
local function placeBall(ball)
	local offset = ball.renderOffset
	if offset then
		local left = 1 - ball.age / (if ball.mega then MEGA_HAND_BLEND_TIME else HAND_BLEND_TIME)
		if left > 0 then
			ball.part.CFrame = CFrame.new(ball.position + offset * (left * left))
			return
		end
		ball.renderOffset = nil
	end
	ball.part.CFrame = CFrame.new(ball.position)
end

local function collectCrystal(crystal)
	Shatter.crystal(crystal, shardFolder)
	balls += Config.CRYSTAL_REWARD
	streak += 1
	runStats.crystals += 1
	if streak % Config.CRYSTALS_PER_MULTIBALL_LEVEL == 0 and multiball < Config.MAX_MULTIBALL then
		multiball += 1
		runStats.maxMultiball = math.max(runStats.maxMultiball, multiball)
		ui:toast("MULTIBALL x" .. multiball, "multiball")
		Tutorial.tip("Multiball")
	end
	Sounds.play("Crystal", 1 + math.min(streak, 10) * 0.03)
	Haptics.play("crystal")
	updateHud()
end

-- fx: the player's shatter effect (only for balls they throw), nil = plain glass.
-- feedback: true for the player's own smashes (punch, vibration, hit-stop on big
-- panes); crashes and revives have their own feedback.
-- Returns true when it was a big pane.
local function smashGlass(glass, hitPoint, push, fx, feedback)
	local size = glass.Size
	local big = glass:GetAttribute("Pattern") == "FullWall" or size.X * size.Y >= BIG_PANE_AREA
	Shatter.glass(glass, hitPoint, push, shardFolder, fx)
	track:markHazardsChanged()
	Sounds.play("Shatter", 0.85 + math.random() * 0.3)
	if feedback then
		smashFeedback(big)
	end
	return big
end

-- Bounces a ball off a wall/floor/door it just touched. Returns the rest of
-- this frame's movement.
local function bounce(ball, hit, remaining)
	local normal = hit.Normal
	ball.velocity = (ball.velocity - 2 * ball.velocity:Dot(normal) * normal) * 0.6
	ball.position += normal * 0.05
	return ball.velocity.Unit * remaining * 0.6
end

-- Which way a knocked-loose decoration flies: along the ball, and out of the
-- surface it was hit on (so it falls into the corridor instead of into the wall).
local function knockDirection(ballDirection, normal)
	local direction = ballDirection + normal * KNOCK_OUT
	return if direction.Magnitude > 0.01 then direction.Unit else normal
end

-- A ball hit a decoration: it comes loose, and so do its parts right next to it.
local function knockDecoration(part, hitPoint, direction, radius, strength)
	Shatter.knockLoose(part, direction, strength)
	Shatter.knockAround(hitPoint, radius, direction, strength, overlapParams)
end

-- Mega balls: anything within reach comes loose. Decorations only sit near
-- the walls, floor and ceiling, so the (more costly) area check only runs there.
local function megaKnockNearby(ball, direction)
	local p = ball.position
	local reach = MEGA_RADIUS + MEGA_KNOCK_REACH
	local nearEdge = math.abs(p.X - ORIGIN.X) > Config.CORRIDOR_WIDTH / 2 - DECOR_DEPTH - reach
		or p.Y < ORIGIN.Y + DECOR_DEPTH + reach
		or p.Y > ORIGIN.Y + Config.CORRIDOR_HEIGHT - DECOR_DEPTH - reach
	if nearEdge then
		Shatter.knockAround(p, reach, direction, MEGA_STRENGTH, overlapParams)
	end
end

-- MegaBall boost: a giant ball swept as a sphere (workspace:Spherecast), so it
-- hits everything its whole body touches. It smashes glass and decorations,
-- collects crystals and opens doors without slowing down; only walls stop it.
local function stepMegaBall(ball, travel)
	local broken = 0 -- glass / props smashed this frame
	local bigHit = false
	for _ = 1, MEGA_STEPS do
		local distance = travel.Magnitude
		if distance < 1e-3 then
			break
		end
		local hit = workspace:Spherecast(ball.position, MEGA_RADIUS, travel, raycastParams)
		if not hit then
			ball.position += travel
			break
		end

		-- hit.Distance is how far the sphere's center got before touching.
		local direction = travel / distance
		local remaining = distance - hit.Distance
		ball.position += direction * hit.Distance
		local part = hit.Instance
		local kind = part:GetAttribute("Kind")

		if kind == "Glass" then
			runStats.glass += 1
			broken += 1
			if smashGlass(part, hit.Position, direction * MEGA_PUSH, runFx, false) then
				bigHit = true
			end
			skinImpact(hit.Position, hit.Normal, true)
			travel = direction * remaining
		elseif kind == "Prop" then
			runStats.props += 1
			broken += 1
			Tutorial.tip("Props")
			Shatter.prop(part, hit.Position, direction * MEGA_PUSH, shardFolder, runFx)
			skinImpact(hit.Position, hit.Normal, true)
			Sounds.play("Shatter", 0.8 + math.random() * 0.2)
			travel = direction * remaining
		elseif kind == "Crystal" then
			collectCrystal(part)
			travel = direction * remaining
		elseif Shatter.canKnock(part) then
			-- Decorations don't stop a giant ball: they're knocked flying.
			knockDecoration(part, hit.Position, knockDirection(direction, hit.Normal), MEGA_RADIUS + MEGA_KNOCK_REACH, MEGA_STRENGTH)
			Shatter.impact(hit.Position, hit.Normal, part)
			skinImpact(hit.Position, hit.Normal, true)
			travel = direction * remaining
		else
			local door = if kind == "Door" or kind == "Button" then track:doorFor(part) else nil
			if door and not door.open then
				-- Bursts the door open. The panels slide away, so skip collisions
				-- for the rest of this frame instead of hitting them again.
				track:openDoor(door)
				Sounds.play("Checkpoint")
				ball.position += direction * remaining
				bigHit = true
				break
			end
			Shatter.impact(hit.Position, hit.Normal, part)
			skinImpact(hit.Position, hit.Normal, true)
			travel = bounce(ball, hit, remaining)
		end
	end

	if ball.velocity.Magnitude > 1e-3 then
		megaKnockNearby(ball, ball.velocity.Unit)
	end

	-- One feedback per frame for everything this giant ball broke.
	if bigHit or broken >= 2 then
		hitStop(if broken >= 2 then HITSTOP_BIG_TIME else HITSTOP_TIME)
		punchFov(FOV_PUNCH_BIG)
		Haptics.play("bigShatter")
	elseif broken == 1 then
		smashFeedback(false)
	end
end

-- Moves one ball forward, bouncing off walls and breaking what it hits.
-- Returns false when the ball should be removed.
local function stepBall(ball, dt)
	ball.age += dt
	if ball.age > Config.BALL_LIFETIME then
		return false
	end

	-- Normal balls that bounced back well behind the camera can't hit anything useful.
	if not ball.mega and ball.position.Z > cameraZ + BEHIND_CAMERA then
		return false
	end

	ball.velocity += GRAVITY * dt
	local travel = ball.velocity * dt

	if ball.mega then
		stepMegaBall(ball, travel)
		placeBall(ball)
		return true
	end

	-- A few iterations so a fast ball can break glass and still bounce this frame.
	for _ = 1, BALL_STEPS do
		local hit = workspace:Raycast(ball.position, travel, raycastParams)
		if not hit then
			ball.position += travel
			break
		end

		local kind = hit.Instance:GetAttribute("Kind")
		local remaining = travel.Magnitude - hit.Distance
		ball.position = hit.Position

		if kind == "Glass" and track:crackArmor(hit.Instance, hit.Position) then
			-- Armored glass: the first hit only cracks it and the ball bounces off.
			Shatter.impact(hit.Position, hit.Normal, hit.Instance)
			skinImpact(hit.Position, hit.Normal, false)
			Sounds.play("Shatter", 0.55)
			smashFeedback(false)
			travel = bounce(ball, hit, remaining)
		elseif kind == "Glass" then
			runStats.glass += 1
			local big = smashGlass(hit.Instance, hit.Position, ball.velocity.Unit, runFx, true)
			skinImpact(hit.Position, hit.Normal, big)
			ball.velocity *= 0.7 -- the ball keeps going, a bit slower
			travel = ball.velocity.Unit * remaining * 0.7
		elseif kind == "Prop" then
			-- Breakable decoration: just for fun, the ball smashes straight through.
			runStats.props += 1
			Tutorial.tip("Props")
			Shatter.prop(hit.Instance, hit.Position, ball.velocity.Unit, shardFolder, runFx)
			skinImpact(hit.Position, hit.Normal, false)
			Sounds.play("Shatter", 1.1 + math.random() * 0.3)
			smashFeedback(false)
			ball.velocity *= 0.85
			travel = ball.velocity.Unit * remaining * 0.85
		elseif kind == "Crystal" then
			collectCrystal(hit.Instance)
			travel = travel.Unit * remaining
		elseif kind == "Button" then
			track:openDoor(track:doorFor(hit.Instance))
			skinImpact(hit.Position, hit.Normal, false)
			Sounds.play("Checkpoint")
			smashFeedback(false)
			ball.velocity = -ball.velocity * 0.4
			travel = ball.velocity.Unit * remaining * 0.4
		else
			-- Walls, floor, doors: bounce, with a puff of dust and a few chips.
			-- Decorations (not the room itself) are knocked loose too.
			local part = hit.Instance
			if Shatter.canKnock(part) then
				knockDecoration(part, hit.Position, knockDirection(ball.velocity.Unit, hit.Normal), KNOCK_SPLASH, 1)
			end
			Shatter.impact(hit.Position, hit.Normal, part)
			skinImpact(hit.Position, hit.Normal, false)
			travel = bounce(ball, hit, remaining)
		end
	end

	placeBall(ball)
	return true
end

local function stepBalls(dt)
	for i = #activeBalls, 1, -1 do
		local ball = activeBalls[i]
		if not stepBall(ball, dt) then
			BallFx.destroy(ball.part)
			table.remove(activeBalls, i)
		end
	end
end

local function clearBalls()
	for _, ball in activeBalls do
		BallFx.destroy(ball.part)
	end
	table.clear(activeBalls)
end

-- preSweep (mega balls only): the ball starts at the camera and is swept this
-- far before its first frame. A sphere cast can't hit something the sphere
-- already overlaps at its start, so starting a giant ball out in front would
-- miss glass, crystals and buttons right in front of the camera.
-- drawFrom (optional): where the ball is drawn at first (the hand); the drawing
-- joins the real path over HAND_BLEND_TIME (MEGA_HAND_BLEND_TIME). Returns the ball.
local function spawnBall(origin, velocity, mega, preSweep, lite, trailScale, drawFrom)
	-- Too many balls slows phones down: the oldest ones disappear first.
	while #activeBalls >= Config.MAX_LIVE_BALLS do
		local oldest = table.remove(activeBalls, 1)
		BallFx.destroy(oldest.part)
	end

	local part = makeBallPart(mega, lite, not lite, trailScale)
	local ball = { part = part, position = origin, velocity = velocity, age = 0, mega = mega }
	table.insert(activeBalls, ball)
	if mega and preSweep then
		stepMegaBall(ball, preSweep)
	end
	if drawFrom then
		ball.renderOffset = drawFrom - ball.position
	end
	placeBall(ball)
	return ball
end

-- True while a Robux prompt opened mid-run is on screen (the run is frozen).
local function promptFrozen()
	return promptFreezeUntil > 0 and os.clock() < promptFreezeUntil
end

-- Balls are thrown at BALL_SPEED and keep the camera's forward momentum (carry).
-- This picks the throw so the ball's real path runs exactly along `direction`
-- (a unit vector), i.e. it goes where you aimed even at top speed.
local function velocityAlong(direction, carry)
	local along = direction:Dot(carry)
	local speedSquared = Config.BALL_SPEED * Config.BALL_SPEED
	return direction * (along + math.sqrt(math.max(0, along * along - carry:Dot(carry) + speedSquared)))
end

-- Throws along a ray from the camera (see throw / throwAtViewport below).
-- Every ball really flies straight out from the middle of the view along your
-- aim, so it goes exactly where you tapped. It's only *drawn* leaving your hand
-- (Viewmodel) and joins that path within a split second.
-- Returns true if a ball was thrown.
local function throwAlong(ray)
	if state ~= "Running" or balls <= 0 or promptFrozen() then
		return false
	end
	local now = os.clock()
	if now - lastThrow < Config.THROW_COOLDOWN then
		return false
	end
	lastThrow = now
	balls -= 1

	-- MegaBall boost: this whole throw (every ball of the multiball fan) is giant.
	local mega = boost.megaball > 0
	if mega then
		boost.megaball -= 1
	end
	-- Giant balls end up a bit further out so they don't fill the screen.
	local startDistance = if mega then 1.5 + MEGA_RADIUS else 1.5

	local aimDirection = ray.Direction.Unit
	-- The hand whose turn it is throws; with multiball the other hand throws
	-- too (if it has a ball). Spots are nil for a hand that isn't showing.
	local firstSpot, secondSpot, firstSide, bothHands = Viewmodel.launch(multiball >= 2)

	local carry = FORWARD * speed -- balls keep the camera's forward momentum
	local speedShare = math.clamp((speed - Config.START_SPEED) / (Config.MAX_SPEED - Config.START_SPEED), 0, 1)
	local trailScale = 1 + speedShare * TRAIL_SPEED_BONUS
	-- Only the middle ball of a multiball fan gets the full premium look (perf).
	local hero = math.ceil(multiball / 2)
	for i = 1, multiball do
		-- Spread extra balls out in a small fan around the aim.
		local offset = i - (multiball + 1) / 2
		local fan = CFrame.fromAxisAngle(Vector3.yAxis, offset * 0.05)
		local direction = fan:VectorToWorldSpace(aimDirection)
		local lite = i ~= hero
		-- Both hands throwing: the balls fanning right are drawn from the right
		-- hand, the ones fanning left from the left hand, the middle one from the first.
		local fanSide = if offset < 0 then 1 else -1
		local useSecond = bothHands and offset ~= 0 and fanSide ~= firstSide
		local handSpot = if useSecond then secondSpot else firstSpot
		if mega then
			-- Giant balls are swept from the camera: a sphere cast can't hit what it
			-- already overlaps at its start.
			spawnBall(ray.Origin, direction * Config.BALL_SPEED + carry, true, direction * startDistance, lite, trailScale, handSpot)
		else
			spawnBall(ray.Origin + direction * startDistance, velocityAlong(direction, carry), false, nil, lite, trailScale, handSpot)
		end
	end

	Sounds.play("Throw", 0.95 + math.random() * 0.1)
	Haptics.play("throw")
	kickCamera(THROW_RECOIL, 0)
	updateHud()
	return true
end

-- Mouse / touch: input.Position is measured below the Roblox top bar, which is
-- what ScreenPointToRay expects.
local function throw(screenPosition)
	if state ~= "Running" then
		return false
	end
	return throwAlong(camera:ScreenPointToRay(screenPosition.X, screenPosition.Y))
end

-- Gamepad crosshair: its position is in full-screen (viewport) pixels, which
-- is what ViewportPointToRay expects.
local function throwAtViewport(viewportPosition)
	if state ~= "Running" then
		return false
	end
	return throwAlong(camera:ViewportPointToRay(viewportPosition.X, viewportPosition.Y))
end

-- Boosts ---------------------------------------------------------------------

local function boostName(boostId)
	local info = BOOSTS[boostId]
	return if info then info.Name else "BOOST"
end

-- The player's boost inventory ({ [boostId] = count }) from the server.
local function ownedBoosts()
	local raw = player:GetAttribute("Boosts")
	if type(raw) ~= "string" then
		return {}
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(decoded) == "table" then decoded else {}
end

-- True if the player already owns this skin (OwnedSkins is a JSON list or set).
local function ownsSkin(skinId)
	local raw = player:GetAttribute("OwnedSkins")
	if type(raw) ~= "string" then
		return false
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or type(decoded) ~= "table" then
		return false
	end
	if decoded[skinId] then
		return true
	end
	return table.find(decoded, skinId) ~= nil
end

-- The boosts picked in the menu that the player really has (distinct, max
-- Config.MAX_BOOSTS_PER_RUN). The server checks again; this just avoids
-- asking for boosts they don't own.
local function pickBoosts(boostIds)
	local picked = {}
	if type(boostIds) ~= "table" then
		return picked
	end
	local owned = ownedBoosts()
	for _, boostId in ipairs(boostIds) do
		if #picked >= Config.MAX_BOOSTS_PER_RUN then
			break
		end
		if
			type(boostId) == "string"
			and BOOSTS[boostId]
			and not table.find(picked, boostId)
			and (tonumber(owned[boostId]) or 0) >= 1
		then
			table.insert(picked, boostId)
		end
	end
	return picked
end

-- Switches one boost on for this run. Buying the same timed boost again adds
-- time; each Shield absorbs one more crash.
local function activateBoost(boostId)
	if boostId == "Shield" then
		boost.shield += 1
	elseif boostId == "Magnet" then
		boost.magnet += MAGNET.Duration
	elseif boostId == "SlowMo" then
		boost.slowmo += SLOWMO.Duration
	elseif boostId == "MegaBall" then
		boost.megaball += MEGA.Throws
	elseif boostId == "DoubleGems" then
		boost.doubleGems = true
	else
		return false
	end
	return true
end

local function setSlowLook(amount)
	if amount ~= slowLook and colorCorrection then
		slowLook = amount
		colorCorrection.Saturation = BASE_SATURATION - 0.45 * amount
	end
end

-- Everything off (new run or back to the menu).
local function resetBoosts()
	boost.shield = 0
	boost.magnet = 0
	boost.slowmo = 0
	boost.megaball = 0
	boost.doubleGems = false
	for boostId in ready do
		ready[boostId] = 0
	end
	timeScale = 1
	setSlowLook(0)
	table.clear(magnetized)
end

-- Counts boost timers down (real seconds, so slow-mo doesn't make them last longer)
-- and eases the world's time scale in and out of slow-mo.
local function tickBoosts(dt)
	boost.magnet = math.max(0, boost.magnet - dt)
	boost.slowmo = math.max(0, boost.slowmo - dt)

	local slowest = SLOWMO.TimeScale
	local target = if boost.slowmo > 0 then slowest else 1
	local change = (1 - slowest) / SLOWMO_EASE * dt
	if timeScale > target then
		timeScale = math.max(target, timeScale - change)
	elseif timeScale < target then
		timeScale = math.min(target, timeScale + change)
	end
	setSlowLook(if slowest < 1 then (1 - timeScale) / (1 - slowest) else 0)
end

-- Magnet boost: crystals within range of the camera fly to it and are collected
-- (exactly like hitting them with a ball). Crystals already flying keep going
-- after the magnet runs out.
local function updateMagnet(dt)
	local eye = cameraPosition()
	if boost.magnet > 0 and track then
		local range = MAGNET.Range
		for _, room in track.rooms do
			for _, crystal in room.crystals do
				-- CanQuery is turned off once a crystal is collected or already flying.
				if crystal.CanQuery and crystal.Parent and (crystal.Position - eye).Magnitude <= range then
					crystal.CanQuery = false
					table.insert(magnetized, crystal)
				end
			end
		end
	end

	local pull = (MAGNET_PULL_SPEED + speed) * dt -- how far a crystal flies this frame
	for i = #magnetized, 1, -1 do
		local crystal = magnetized[i]
		if not crystal.Parent then
			table.remove(magnetized, i)
		else
			local offset = eye - crystal.Position
			local distance = offset.Magnitude
			if distance <= pull + MAGNET_PICKUP then
				table.remove(magnetized, i)
				collectCrystal(crystal)
			else
				crystal.Position += offset * (pull / distance)
			end
		end
	end
end

-- Shield boost used up: a burst of blue shards around the view and a quick tint.
local function shieldBreak()
	Shatter.shieldBreak(camera.CFrame, SHIELD.Color, shardFolder, FORWARD * speed * timeScale)
	-- The blue tint is a full-screen flash: skipped when flashes are turned off.
	if colorCorrection and flashesOn then
		colorCorrection.TintColor = WHITE:Lerp(SHIELD.Color, 0.6)
		TweenService:Create(colorCorrection, SHIELD_FLASH, { TintColor = WHITE }):Play()
	end
	Sounds.play("Shatter", 0.6)
	ui:toast("SHIELD BROKEN", "info")
end

-- What the HUD shows for boosts (sent every frame; the UI only redraws changes).
-- One table reused every frame (the UI only reads it). ready = boost-bar counts.
local boostState = { shield = false, magnet = 0, slowmo = 0, megaball = 0, doubleGems = false, ready = ready }

local function updateBoostHud()
	if ui.setBoosts then
		boostState.shield = boost.shield > 0 -- the UI only shows on / off
		boostState.magnet = boost.magnet
		boostState.slowmo = boost.slowmo
		boostState.megaball = boost.megaball
		boostState.doubleGems = boost.doubleGems
		ui:setBoosts(boostState)
	end
end

local function anyReady()
	for _, count in ready do
		if count > 0 then
			return true
		end
	end
	return false
end

-- The player tapped a ready boost in the boost bar (or pressed its D-pad / number
-- key): switch it on now. The server already took it from the inventory at the
-- start of the run, so nothing is sent. Returns true if it switched on.
local function useReadyBoost(boostId)
	if state ~= "Running" or promptFrozen() or (ready[boostId] or 0) <= 0 then
		return false
	end
	ready[boostId] -= 1
	-- Tell the server it was used, so it isn't handed back as "never tapped" later.
	task.spawn(pcall, function()
		Remotes.ShopRequest:InvokeServer("BoostTapped", boostId)
	end)
	activateBoost(boostId)
	-- A quick pop: chime, buzz and a small camera punch (the UI pops the button).
	Sounds.play("Checkpoint", 1.3)
	Haptics.play("boost")
	punchFov(FOV_PUNCH_SHATTER)
	updateBoostHud()
	return true
end

-- First run with a boost waiting in the bar: a one-time tip. Tutorial.tip can
-- be busy (another tip showing, save not loaded yet), so it's retried now and then.
local function updateBoostTip(dt)
	if boostTipDone or not anyReady() then
		return
	end
	boostTipWait -= dt
	if boostTipWait > 0 then
		return
	end
	boostTipWait = BOOST_TIP_RETRY
	boostTipDone = Tutorial.tip("BoostBar") == true
end

-- D-pad Left / Up / Right and keys 1 / 2 / 3 use the boost-bar boosts. Bound only
-- while a run is going (high priority, so nothing else in the run takes them);
-- the game over screen and menus get the D-pad back for moving between buttons.
local function onBoostKey(_, inputState, input)
	-- The Roblox menu, a Robux prompt or a UI selection is using the controller.
	if GuiService.MenuIsOpen or promptFrozen() or GuiService.SelectedObject ~= nil then
		return Enum.ContextActionResult.Pass
	end
	if inputState == Enum.UserInputState.Begin then
		local slot = table.find(BOOST_PAD_KEYS, input.KeyCode) or table.find(BOOST_NUMBER_KEYS, input.KeyCode)
		local boostId = slot and BOOST_BAR[slot]
		if boostId then
			useReadyBoost(boostId)
		end
	end
	return Enum.ContextActionResult.Sink
end

local function syncBoostKeys()
	local wanted = state == "Running"
	if wanted == boostKeysBound then
		return
	end
	boostKeysBound = wanted
	if wanted then
		local keys = table.clone(BOOST_PAD_KEYS)
		for _, keyCode in BOOST_NUMBER_KEYS do
			table.insert(keys, keyCode)
		end
		ContextActionService:BindActionAtPriority(
			BOOST_KEYS_ACTION,
			onBoostKey,
			false,
			Enum.ContextActionPriority.High.Value,
			table.unpack(keys)
		)
	else
		ContextActionService:UnbindAction(BOOST_KEYS_ACTION)
	end
end

-- Run lifecycle ----------------------------------------------------------------

local function gameOver()
	if state ~= "Running" then
		return
	end
	state = "GameOver"

	local distance = meters()
	local best = player:GetAttribute("Best") or 0
	local gemMultiplier = if ownsPass("VIP") then Config.GamePasses.VIP.GemMultiplier else 1
	if player.MembershipType == Enum.MembershipType.Premium then
		gemMultiplier *= 1 + Config.PREMIUM_GEM_BONUS
	end
	if boost.doubleGems then
		gemMultiplier *= 2 -- the server doubles them too
	end
	local newMeters = math.max(0, distance - reportedMeters)
	reportedMeters = math.max(reportedMeters, distance)
	local report = table.clone(runStats)
	-- Unused boosts: the server gives them back if the player leaves from here.
	report.unusedShield = boost.shield
	report.unusedMegaThrows = boost.megaball
	for boostId, count in ready do
		report["ready" .. boostId] = count -- never tapped (e.g. readyMagnet)
	end
	Remotes.RunEnded:FireServer(distance, report)
	Tutorial.setPaused(true)

	-- Personal best only counts runs started from the beginning (same as the server).
	local countsForBest = startCheckpoint == 0
	ui:showGameOver({
		meters = distance,
		best = if countsForBest then math.max(best, distance) else best,
		isNewBest = countsForBest and distance > best,
		gemsEarned = math.floor(newMeters * Config.GEMS_PER_METER * gemMultiplier),
		canRevive = Config.Products.Revive.Id ~= 0,
	})
end

local function crash(hazard)
	local door = track:doorFor(hazard)
	if door then
		track:openDoor(door)
	else
		smashGlass(hazard, cameraPosition(), FORWARD)
	end

	local roll = (if math.random() < 0.5 then -1 else 1) * CRASH_ROLL

	-- Crashing while learning is free.
	if Tutorial.crashIsFree() then
		shakeCamera(0.2)
		kickCamera(CRASH_KICK * 0.6, roll * 0.6)
		punchFov(FOV_PUNCH_SHATTER)
		Haptics.play("crash")
		Sounds.play("Crash")
		return
	end

	-- Shield boost: this crash is free (no balls lost, multiball kept).
	if boost.shield > 0 then
		boost.shield -= 1
		shakeCamera(0.2)
		kickCamera(CRASH_KICK * 0.5, roll * 0.5)
		punchFov(FOV_PUNCH_BIG)
		Haptics.play("bigShatter")
		shieldBreak()
		return
	end

	balls = math.max(0, balls - Config.CRASH_PENALTY)
	multiball = minimumMultiball()
	streak = 0
	shakeCamera(0.35)
	kickCamera(CRASH_KICK, roll)
	punchFov(FOV_PUNCH_CRASH)
	Haptics.play("crash")
	Sounds.play("Crash")
	ui:flashDamage()
	updateHud()

	if balls <= 0 then
		gameOver()
	end
end

-- Did the camera fly through any pane between prevZ and newZ?
local function checkCrashes(prevZ, newZ)
	local position = cameraPosition()
	for _, hazard in track:hazards() do
		-- The list was built before the loop, so skip anything an earlier crash already cleared
		-- (both panels of a door would otherwise each cost a crash).
		local door = track:doorFor(hazard)
		if not hazard.Parent or (door and door.open) then
			continue
		end
		local z = hazard.Position.Z
		if prevZ > z and newZ <= z then
			local localPoint = hazard.CFrame:PointToObjectSpace(Vector3.new(position.X, position.Y, z))
			local size = hazard.Size
			if
				math.abs(localPoint.X) <= size.X / 2 + CRASH_MARGIN
				and math.abs(localPoint.Y) <= size.Y / 2 + CRASH_MARGIN
			then
				crash(hazard)
				if state ~= "Running" then
					return
				end
			end
		end
	end
end

-- Throws away the old track and builds a fresh one starting at a checkpoint.
local function resetWorld(checkpoint, tutorial)
	if world then
		world:Destroy()
	end
	clearBalls()
	resetBoosts()
	resetFeel()
	Shatter.reset()

	world = Instance.new("Folder")
	world.Name = "LocalRun"
	world.Parent = workspace

	shardFolder = Instance.new("Folder")
	shardFolder.Name = "Effects"
	shardFolder.Parent = world
	Viewmodel.attach(world)

	local firstRoom = checkpoint * Config.ROOMS_PER_CHECKPOINT
	track = TrackBuilder.new(world, firstRoom, tutorial)
	cameraZ = TrackBuilder.roomStartZ(firstRoom) + 4
	-- The first two rooms are built completely now; the rest a little per frame.
	track:warmUp(cameraZ)

	raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	raycastParams.FilterDescendantsInstances = { track.folder }

	overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Include
	overlapParams.FilterDescendantsInstances = { track.folder }
	overlapParams.MaxParts = 24

	PerfOverlay.watch(world)

	lastRoom = firstRoom
	lastReportedRoom = firstRoom
	applyTheme(checkpoint)
end

local shopRequest -- defined in the Purchases section below

-- The run is really over (PLAY AGAIN or MENU from the game over screen, without
-- a revive): unused Shields and Mega Ball throws, and boost-bar boosts never
-- tapped, go back to the inventory.
-- Sent once per run; the server checks it against what the run really turned on.
local function returnUnusedBoosts()
	if state ~= "GameOver" or unusedBoostsSent then
		return
	end
	unusedBoostsSent = true
	local shield, throws = boost.shield, boost.megaball
	if shield <= 0 and throws < MEGA.Throws and not anyReady() then
		return -- nothing that could be given back
	end
	local unused = { shield = shield, megaballThrows = throws }
	for boostId, count in ready do
		unused["ready" .. boostId] = count -- e.g. readyMagnet
	end
	-- Sent now (before RunStarted / resetWorld), answered in the background.
	task.spawn(function()
		local ok, message = shopRequest("ReturnUnusedBoosts", unused)
		if ok and type(message) == "string" then
			ui:toast(message, "reward")
		end
	end)
end

-- The equipped ball: in your hands, on the HUD swatch and in the hit splashes.
local function applyEquippedSkin()
	local skinId = player:GetAttribute("EquippedSkin")
	Viewmodel.setSkin(skinId)
	runSkinStyle = BallFx.impactStyle(skinId)
	if ui and ui.setBallSkin then
		ui:setBallSkin(Config.getSkin(skinId).Id)
	end
end

-- boostIds: boosts picked in the menu (may be nil/empty). They only switch on
-- once the server confirms them (see onBoostsActivated).
local function startRun(checkpoint, boostIds)
	checkpoint = if type(checkpoint) == "number" then math.max(0, math.floor(checkpoint)) else 0
	if checkpoint > 0 and not ownsPass("Checkpoints") then
		checkpoint = 0
	end
	checkpoint = math.min(checkpoint, player:GetAttribute("Checkpoint") or 0)
	startCheckpoint = checkpoint

	returnUnusedBoosts() -- PLAY AGAIN from the game over screen
	unusedBoostsSent = false

	-- Brand-new players get the guided first run.
	local tutorialRun = checkpoint == 0 and Tutorial.isNeeded()
	Tutorial.reset()
	resetWorld(checkpoint, tutorialRun)
	if tutorialRun then
		Tutorial.start(track)
	end

	-- Bonus balls from the daily streak, and Revive / Ball Pack balls bought
	-- outside a run (the server saved them and resets them when the run starts).
	local bonusBalls = math.max(0, math.floor(tonumber(player:GetAttribute("BonusBalls")) or 0))

	balls = Config.START_BALLS + bonusBalls
	if ownsPass("VIP") then
		balls += Config.GamePasses.VIP.ExtraStartBalls
	end
	multiball = minimumMultiball()
	streak = 0
	speed = Config.START_SPEED
	reportedMeters = math.floor(Config.checkpointMeters(checkpoint))
	runFx = Config.getFx(player:GetAttribute("EquippedFx"))
	applyEquippedSkin()
	runStats = { glass = 0, crystals = 0, props = 0, maxMultiball = multiball }
	state = "Running"

	-- The guided first run teaches the basics without boosts: anything picked
	-- stays in the inventory for the next run.
	local picked = if tutorialRun then {} else pickBoosts(boostIds)
	runSerial += 1
	if #picked > 0 then
		Remotes.RunStarted:FireServer(checkpoint, picked)
	else
		Remotes.RunStarted:FireServer(checkpoint)
	end
	ui:showHud()
	updateHud()
	Sounds.startMusic()
	if bonusBalls > 0 then
		ui:toast("+" .. bonusBalls .. " BONUS BALLS", "reward")
	end
end

local function revive(extraBalls)
	if state ~= "GameOver" then
		return false
	end

	-- Clear everything right in front of the player so they don't crash instantly.
	for _, hazard in track:hazards() do
		local ahead = cameraZ - hazard.Position.Z
		if hazard.Parent and ahead > -2 and ahead < 40 then
			local door = track:doorFor(hazard)
			if door then
				track:openDoor(door)
			else
				smashGlass(hazard, hazard.Position, FORWARD)
			end
		end
	end

	balls = extraBalls
	multiball = minimumMultiball()
	streak = 0
	state = "Running"
	Tutorial.setPaused(false)
	ui:hideRevive()
	ui:showHud()
	updateHud()
	return true
end

local function showMenu()
	-- Leaving mid-run still reports it, so the server doesn't think it's still going.
	if state == "Running" then
		gameOver()
	end
	returnUnusedBoosts() -- MENU from the game over screen
	state = "Menu"
	Tutorial.reset()
	resetWorld(0)
	ui:showMenu()
	-- A game pass bought outside this server (website, another server) shows up
	-- without rejoining. The server limits how often this really checks.
	task.spawn(shopRequest, "RecheckPasses")
end

-- Frame loop -----------------------------------------------------------------

local function onRoomEntered(room)
	if room > 0 and room % Config.ROOMS_PER_CHECKPOINT == 0 then
		local zone = room // Config.ROOMS_PER_CHECKPOINT
		applyTheme(zone)
		ui:toast(string.format("ZONE %02d", zone), "checkpoint")
		Sounds.play("Checkpoint")
	end
end

-- Tells the server each new room the camera reaches (it checks the distance
-- against these, so it must be every room, in order).
local function reportRoom(roomIndex)
	local remote = Remotes:FindFirstChild("RoomReached")
	if remote then
		remote:FireServer(roomIndex)
	end
end

local menuTime = 0
-- What Viewmodel.update needs (one table reused every frame).
local viewState = { show = false, balls = 0, mega = false, avoid = nil, avoidRadius = nil, speedShare = 0, worldRate = 1 }

local function step(dt)
	-- worldDt: game time, slower than real time while SlowMo is on.
	local worldDt = dt
	local ballDt = dt -- balls ignore most of the tutorial's slow-down
	if state == "Running" then
		-- A Robux prompt is on screen: everything in the run stands still
		-- (boost timers too) until it closes.
		local runDt = if promptFrozen() then 0 else dt
		tickBoosts(runDt)
		-- The tutorial slows time while it waits for the player to act.
		local tutorialScale = Tutorial.update(runDt, cameraZ)
		lastTutorialScale = tutorialScale
		-- Hit-stop: a split-second freeze after a big smash.
		local freeze = tickHitStop(runDt)
		worldDt = runDt * timeScale * tutorialScale * freeze
		ballDt = runDt * timeScale * math.max(tutorialScale, TUTORIAL_MIN_BALL_SPEED) * freeze
		Tutorial.scanForTips(runDt, cameraZ, track)

		-- Same rule the server's anti-cheat uses (each zone has its own top speed).
		speed = Config.speedForRoom(currentRoom(), startCheckpoint * Config.ROOMS_PER_CHECKPOINT)

		local prevZ = cameraZ
		cameraZ -= speed * worldDt
		checkCrashes(prevZ, cameraZ)

		local room = currentRoom()
		if room ~= lastRoom and state == "Running" then
			lastRoom = room
			onRoomEntered(room)
		end
		while state == "Running" and room > lastReportedRoom do
			lastReportedRoom += 1
			reportRoom(lastReportedRoom)
		end
	end

	if track then
		track:update(cameraZ, worldDt)
	end
	stepBalls(ballDt)
	-- After the balls, so shards from this frame's smashes are placed this frame.
	Shatter.update(cameraZ)

	if state == "Running" then
		updateMagnet(worldDt)
		updateBoostTip(dt)
		if balls <= 0 and #activeBalls == 0 then
			gameOver()
		end
		updateHud()
	end

	-- Camera: gentle sway, wider view at high speed, plus the feel effects
	-- (shake on crash, kick / recoil, field-of-view punch). Real time, so they
	-- still settle during slow-mo and hit-stop.
	menuTime += dt
	shake = math.max(0, shake - dt)
	local settle = 1 - math.exp(-KICK_RETURN * dt)
	kickPitch -= kickPitch * settle
	kickRoll -= kickRoll * settle
	fovPunch -= fovPunch * (1 - math.exp(-FOV_PUNCH_RETURN * dt))
	local sway = Vector3.new(math.sin(menuTime * 0.7) * 0.15, math.sin(menuTime * 1.3) * 0.1, 0)
	local jitter = Vector3.zero
	if shake > 0 then
		jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake * 2
	end
	local position = cameraPosition() + sway + jitter
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(position, position + FORWARD) * CFrame.Angles(kickPitch, 0, kickRoll)
	camera.FieldOfView = BASE_FOV
		+ (speed - Config.START_SPEED) / (Config.MAX_SPEED - Config.START_SPEED) * SPEED_FOV
		+ fovPunch

	-- Your arms and the balls in your hands follow the camera that was just placed.
	local avoid, avoidRadius = Tutorial.pointerTarget()
	viewState.show = state == "Running"
	viewState.balls = balls
	viewState.mega = boost.megaball > 0
	viewState.avoid = avoid
	viewState.avoidRadius = avoidRadius
	viewState.speedShare = math.clamp((speed - Config.START_SPEED) / (Config.MAX_SPEED - Config.START_SPEED), 0, 1)
	viewState.worldRate = if state == "Running" and dt > 0 then worldDt / dt else 0
	Viewmodel.update(dt, viewState)

	updateBoostHud()
	syncBoostKeys()
	GamepadAim.update(dt, state == "Running")
end

-- Purchases ------------------------------------------------------------------

-- Robux purchases are only allowed once the server has loaded the player's save
-- (otherwise the server can't record them, or sells something already owned).
local function canBuy()
	if player:GetAttribute("DataFailed") == true then
		ui:toast("YOUR SAVE DIDN'T LOAD - REJOIN BEFORE BUYING", "error")
		return false
	end
	if player:GetAttribute("DataLoaded") ~= true then
		ui:toast("STILL LOADING YOUR SAVE - TRY AGAIN IN A MOMENT", "info")
		return false
	end
	return true
end

-- Freezes the run while a Robux prompt opened mid-run is on screen.
local function freezeForPrompt()
	if state == "Running" then
		promptFreezeUntil = os.clock() + PROMPT_FREEZE_MAX
	end
end

local function onPromptClosed()
	promptFreezeUntil = 0
end

-- context: extra info from the UI. For "ExtraReroll" it's the mission id, which
-- is rerolled automatically once the purchase arrives.
local function promptProduct(productKey, context)
	local product = Config.Products[productKey]
	if not product or product.Id == 0 then
		return
	end
	if not canBuy() then
		return
	end
	-- Don't let anyone pay twice for something they already have.
	if productKey == "StarterPack" and player:GetAttribute("StarterPackBought") == true then
		ui:toast("ALREADY OWNED", "reward")
		return
	end
	if productKey == "SeasonPremium" and player:GetAttribute("SeasonPremium") == true then
		ui:toast("ALREADY UNLOCKED", "reward")
		return
	end
	-- Premium balls: never prompt for one that's already unlocked.
	local skin = if type(product.Skin) == "string" then Config.getSkin(product.Skin) else nil
	if skin and skin.Id == product.Skin and skin.Premium and ownsSkin(skin.Id) then
		ui:toast("ALREADY OWNED", "reward")
		return
	end
	-- A streak saver only does its real job right after the streak breaks
	-- (the server still gives gems if it's bought anyway).
	if productKey == "StreakSaver" then
		local expires = tonumber(player:GetAttribute("StreakExpires")) or 0
		local day = tonumber(player:GetAttribute("StreakDay")) or 1
		if workspace:GetServerTimeNow() <= expires or day <= 1 then
			ui:toast("YOUR STREAK IS SAFE", "info")
			return
		end
	end
	if productKey == "ExtraReroll" then
		rerollAfterPurchase = if type(context) == "string" then context else nil
	end
	local ok = pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, product.Id)
	if ok then
		freezeForPrompt()
	end
end

local function promptPass(passKey)
	local pass = Config.GamePasses[passKey]
	if not pass or pass.Id == 0 then
		return
	end
	if not canBuy() then
		return
	end
	local ok = pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, pass.Id)
	if ok then
		freezeForPrompt()
	end
end

shopRequest = function(action, argument)
	local ok, success, message = pcall(function()
		return Remotes.ShopRequest:InvokeServer(action, argument)
	end)
	if not ok then
		return false, "Connection problem"
	end
	return success == true, message
end

-- A Robux boost always goes to the boost inventory first. Bought during a run,
-- we ask the server to use it right away; it's only switched on if the server says yes.
-- If the run ended while we waited for the answer, it goes back to the inventory.
local function useBoostNow(boostId)
	local ok = shopRequest("UseBoostNow", boostId)
	if not ok then
		ui:toast(boostName(boostId) .. " ADDED TO YOUR BOOSTS", "reward")
		return
	end
	if boostId == "DoubleGems" then
		-- Already counted on the server for this run's gems, even if it just ended.
		activateBoost(boostId)
		ui:toast(boostName(boostId) .. " ON", "reward")
		return
	end
	if state == "Running" then
		activateBoost(boostId)
		ui:toast(boostName(boostId) .. " ON", "reward")
		return
	end
	-- The run ended in the meantime: put it back.
	if shopRequest("ReturnBoost", boostId) then
		ui:toast(boostName(boostId) .. " ADDED TO YOUR BOOSTS", "reward")
	elseif state == "GameOver" then
		-- Couldn't give it back (very unlikely): use it on this run instead,
		-- so it still helps if they revive.
		activateBoost(boostId)
		ui:toast(boostName(boostId) .. " ON", "reward")
	end
end

-- ExtraReroll bought from a mission row: swap that mission right away.
local function rerollBoughtMission()
	local missionId = rerollAfterPurchase
	rerollAfterPurchase = nil
	if not missionId then
		return
	end
	local ok, message = shopRequest("RerollMission", missionId)
	if ok then
		ui:toast(if type(message) == "string" then message else "MISSION SWAPPED", "reward")
	else
		ui:toast(
			(if type(message) == "string" then message .. " - " else "") .. "YOUR REROLL IS SAVED",
			"info"
		)
	end
end

local function onPurchaseGranted(productKey)
	local product = Config.Products[productKey]
	if product and product.Boost then
		if state == "Running" then
			task.spawn(useBoostNow, product.Boost)
		else
			ui:toast(boostName(product.Boost) .. " ADDED TO YOUR BOOSTS", "reward")
		end
		return
	end
	if productKey == "ExtraReroll" then
		task.spawn(rerollBoughtMission)
		return
	end
	-- Starter pack / season pass are announced by the server's Progress "Reward" event.
	if product and product.Gems and productKey ~= "StarterPack" then
		ui:toast("+" .. product.Gems .. " GEMS", "reward")
		return
	end
	if not product or type(product.Balls) ~= "number" then
		return
	end

	-- The server already saved these balls as BonusBalls. Used right away here,
	-- they're taken back out of the save ("UseBonusBalls"); in the menu they
	-- simply wait for the next run.
	local amount = product.Balls
	if state == "GameOver" then
		if revive(amount) then
			task.spawn(function()
				shopRequest("UseBonusBalls", amount)
				-- The server paused the run's clock at game over; start it again.
				shopRequest("ResumeRun")
			end)
		end
		ui:toast("+" .. amount .. " BALLS", "reward")
	elseif state == "Running" then
		balls += amount
		updateHud()
		task.spawn(shopRequest, "UseBonusBalls", amount)
		ui:toast("+" .. amount .. " BALLS", "reward")
	else
		ui:toast("SAVED: +" .. amount .. " BALLS AT THE START OF YOUR NEXT RUN", "reward")
	end
end

-- The server confirmed which picked boosts started (and used them up).
-- event = { type = "BoostsActivated", boosts = { ids }, run = number }
local function onBoostsActivated(event)
	if state == "Menu" or type(event.boosts) ~= "table" then
		return
	end
	-- Meant for an earlier run (the player restarted before it arrived).
	if event.run ~= nil and event.run ~= runSerial then
		return
	end
	-- The UI shows the "... ON" / "... READY" toast for BoostsActivated itself.
	-- Boost-bar boosts wait in the bar until tapped; the rest switch on now.
	for _, boostId in ipairs(event.boosts) do
		if ready[boostId] then
			ready[boostId] += 1
		else
			activateBoost(boostId)
		end
	end
end

-- Startup --------------------------------------------------------------------

-- SetCoreGuiEnabled can fail if called before Roblox's UI has loaded, so retry a few times.
local function hideCoreGui()
	for _ = 1, CORE_GUI_ATTEMPTS do
		local allHidden = true
		for _, coreGuiType in HIDDEN_CORE_GUI do
			local ok = pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreGuiType, false)
			if not ok then
				allHidden = false
			end
		end
		if allHidden then
			return
		end
		task.wait(1)
	end
end

-- Controller throw buttons: R2 (the trigger) or A, aimed with the crosshair.
-- A also presses UI buttons, so it only throws when no button is selected.
local function onGamepadThrowButton(keyCode, gameProcessed)
	if state ~= "Running" or GuiService.MenuIsOpen then
		return
	end
	if keyCode == Enum.KeyCode.ButtonA and (gameProcessed or GuiService.SelectedObject ~= nil) then
		return
	end
	if throwAtViewport(GamepadAim.viewportPosition()) then
		GamepadAim.pulse()
	end
end

local function disableCharacterControls()
	local playerScripts = player:WaitForChild("PlayerScripts")
	local ok, playerModule = pcall(function()
		return require(playerScripts:WaitForChild("PlayerModule"))
	end)
	if ok then
		playerModule:GetControls():Disable()
	end
end

function RunController.start()
	task.spawn(hideCoreGui)
	PerfOverlay.start(Shatter.liveCount)
	GamepadAim.start()
	Viewmodel.start()
	LeaveGift.start({
		claim = function()
			return shopRequest("ClaimLeaveGift")
		end,
		-- Never pops up in the middle of a run (it waits for the menu / game over).
		canShow = function()
			return state ~= "Running"
		end,
	})

	ui = UI.new({
		-- boostIds: boosts picked in the menu (may be empty).
		onPlay = function(checkpoint, boostIds)
			startRun(checkpoint, boostIds)
		end,
		onPlayAgain = function(boostIds)
			startRun(startCheckpoint, boostIds)
		end,
		onMenu = showMenu,
		onRevive = function()
			promptProduct("Revive")
		end,
		-- onBuyProduct(productKey, context): context is the mission id for "ExtraReroll".
		onBuyProduct = promptProduct,
		onBuyPass = promptPass,
		onBuySkin = function(skinId)
			return shopRequest("BuySkin", skinId)
		end,
		onEquipSkin = function(skinId)
			return shopRequest("EquipSkin", skinId)
		end,
		onClaimDaily = function()
			return shopRequest("ClaimDaily")
		end,
		-- Generic: onShop("BuyFx", id), onShop("BuyBoost", id), onShop("ClaimMission", id),
		-- onShop("ClaimSeasonTier", { track, tier })...
		onShop = shopRequest,
		-- A ready boost tapped in the HUD boost bar.
		onUseBoost = useReadyBoost,
	})

	setupLighting()
	applyEquippedSkin()
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(applyEquippedSkin)
	showMenu()
	-- Music plays from the moment you join, not only once a run starts.
	Sounds.startMusic()
	task.spawn(disableCharacterControls)

	Remotes.PurchaseGranted.OnClientEvent:Connect(onPurchaseGranted)
	-- These fire on this device when a Robux prompt closes (bought or not).
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		if userId ~= player.UserId then
			return
		end
		onPromptClosed()
		-- Cancelled: forget which mission the reroll was for.
		if not purchased and productId == Config.Products.ExtraReroll.Id then
			rerollAfterPurchase = nil
		end
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who)
		if who == player then
			onPromptClosed()
		end
	end)

	-- Level ups, missions done, season tiers, run summaries, rewards.
	task.spawn(function()
		local progress = Remotes:WaitForChild("Progress")
		progress.OnClientEvent:Connect(function(event)
			if type(event) ~= "table" then
				return
			end
			if event.type == "BoostsActivated" then
				onBoostsActivated(event)
			elseif event.type == "LevelUp" then
				Haptics.play("levelUp")
			end
			if ui.showProgress then
				ui:showProgress(event)
			end
		end)
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		local keyCode = input.KeyCode
		if keyCode == Enum.KeyCode.ButtonR2 or keyCode == Enum.KeyCode.ButtonA then
			onGamepadThrowButton(keyCode, gameProcessed)
			return
		end
		if gameProcessed then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			throw(input.Position)
		end
	end)

	RunService:BindToRenderStep("ShatterRun", Enum.RenderPriority.Camera.Value + 1, step)
end

return RunController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--[[
	Player settings (volume, vibration, graphics, camera shake, flashes).

	One place every module reads from. Changing a setting applies it right away
	(Settings.changed fires) and saves it to the player's account a moment later,
	so settings follow the player to any device.

	Settings.get(key) / Settings.set(key, value) / Settings.all()
	Settings.changed: RBXScriptSignal (key, value)
	Settings.graphicsLevel(): "Low" | "High" (resolves "Auto" from the device)
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Settings = {}

local SAVE_DELAY = 1.5 -- seconds of no changes before saving (sliders change a lot)

local values = table.clone(Config.DefaultSettings)
local changedEvent = Instance.new("BindableEvent")
Settings.changed = changedEvent.Event

local saveToken

local function valid(key, value)
	local default = Config.DefaultSettings[key]
	if default == nil or type(value) ~= type(default) then
		return false
	end
	if key == "graphics" then
		return table.find(Config.GRAPHICS_OPTIONS, value) ~= nil
	end
	if type(value) == "number" then
		return value >= 0 and value <= 1
	end
	return true
end

local function scheduleSave()
	local token = {}
	saveToken = token
	task.delay(SAVE_DELAY, function()
		if saveToken ~= token then
			return
		end
		pcall(function()
			Remotes.ShopRequest:InvokeServer("SaveSettings", table.clone(values))
		end)
	end)
end

function Settings.get(key)
	return values[key]
end

function Settings.all()
	return table.clone(values)
end

function Settings.set(key, value)
	if not valid(key, value) or values[key] == value then
		return
	end
	values[key] = value
	changedEvent:Fire(key, value)
	scheduleSave()
end

-- "Auto" picks Low on phones/tablets, High elsewhere.
function Settings.graphicsLevel()
	local choice = values.graphics
	if choice ~= "Auto" then
		return choice
	end
	local phoneLike = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	return if phoneLike then "Low" else "High"
end

-- Loads the saved settings once the server publishes them.
local function loadFromAttribute()
	local raw = player:GetAttribute("Settings")
	if type(raw) ~= "string" then
		return
	end
	local ok, saved = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or type(saved) ~= "table" then
		return
	end
	for key, value in saved do
		if valid(key, value) and values[key] ~= value then
			values[key] = value
			changedEvent:Fire(key, value)
		end
	end
end

loadFromAttribute()
-- Only the first load matters; afterwards the client is the source of truth.
local connection
connection = player:GetAttributeChangedSignal("Settings"):Connect(function()
	loadFromAttribute()
	connection:Disconnect()
end)

return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Shatter</string>
            <string name="Source"><![CDATA[--[[
	Breaking effects.

	Glass panes crack outward from the point the ball hit: cracks run from the
	impact to the edges, a ring of cracks crosses them, and every piece in between
	becomes a real triangle shard. Shards near the impact burst out (some fly
	back past the camera), pop up and spin; the rest drop. All of them land on
	the floor, slide and pile up, then fade out (Config.SHARD_LIFETIME).

	Shatter.shieldBreak is the burst shown when a Shield boost absorbs a crash.
	Shatter.impact is the dust puff + chips when a ball hits a wall or the floor.
	Shatter.skinBurst is the splash in the ball skin's colors wherever a ball hits
	(premium balls get a themed one: Supernova flare, Black Hole implosion...).
	Shatter.knockLoose / knockAround knock solid decorations off their spot.

	Smoothness (why it looks like this):
	  - Pooling: every shard part is made once and reused. Creating and
	    deleting parts is one of the most expensive things a game can do in a
	    frame; moving an existing part is cheap. Idle pool parts wait anchored,
	    invisible and non-colliding far above the track (PARK). That's cheaper
	    than parenting them to nil, because taking a part out of the world and
	    putting it back costs about as much as creating it. The pool fills up a
	    few parts per frame while you're in the menu (Config.SHARD_POOL_WARM).
	  - Spawn queue: a break only computes where its shards go; the shards
	    are placed by Shatter.update, a fixed time per frame
	    (Config.SHARD_SPAWN_BUDGET). Usually that's the same frame; a huge
	    multi-pane mega ball smash spreads over 2-3 frames.
	  - "Shards" collision group: shards and loose decorations hit the floor
	    and walls but not each other, so a pile costs the physics engine little.
	  - Shards that end up behind the camera are recycled early (nobody sees
	    them), so at top speed only a few dozen are ever live.
	  - Budget: above Config.MAX_LIVE_SHARDS live shard parts new breaks use
	    fewer cracks, only the small pieces around the impact and no glitter.

	Shatter.glass / Shatter.prop take an optional shatter effect (an entry of
	Config.ShatterFx) that tints the shards. nil or "Classic" = normal glass.
	Their `parent` argument is ignored now (pooled parts live in the
	workspace folder "ShatterPool"); it's kept so callers don't change.

	Low graphics (Settings): smaller shard and loose-decoration caps, fewer
	cracks per pane, fewer prop pieces, no glitter or glass dust.

	RunController must call Shatter.update(cameraZ) every frame and
	Shatter.reset() when a new run's world is built.
]]

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Settings = require(script.Parent.Settings)

local Shatter = {}

local rng = Random.new()
local TAU = math.pi * 2
local UP = Vector3.yAxis
local SMALL_PANE_AREA = 20 -- panes smaller than this (square studs) use few cracks
local BIG_PANE_AREA = 150 -- panes at least this big get a glass dust burst
local FEW_RAYS = 5
local LOW_MAX_RAYS = 7 -- Low graphics: at most this many cracks per pane
local LOW_PROP_PIECES = 5 -- Low graphics: at most this many shards per prop part
local SHARD_JITTER = 0.6 -- extra random lifetime so a pane's shards don't all vanish together

local PARK = CFrame.new(0, 5000, 0) -- idle pool parts wait here (anchored, invisible)
local RELEASES_PER_FRAME = 40 -- shards put back into the pool per frame, at most
local BEHIND_CHECK_INTERVAL = 0.25 -- seconds between checks for shards behind the camera
local BEHIND_DISTANCE = 8 -- shards this far behind the camera are recycled
local WARM_BUDGET = 0.0003 -- seconds per frame spent filling the pool
local WEDGE_WARM, CHIP_WARM = 40, 24 -- single wedges / chips made ahead of time
local MAX_WEDGES, LOW_MAX_WEDGES = 160, 80 -- single wedges (prop pieces, shield burst)
local MAX_CHIPS, LOW_MAX_CHIPS = 60, 30 -- small blocks (impact chips, crystal pop)
local SHARDS_GROUP = "Shards"

-- Knocked-loose decorations
local KNOCK_UP = 6 -- upward pop (studs per second)
local KNOCK_SPIN = 7 -- spin (radians per second, roughly)
local KNOCK_NUDGE = 0.06 -- studs a knocked part is moved off the wall / floor so it doesn't start stuck
local KNOCK_FULL_SIZE = 2.5 -- parts up to this size (studs) get the full knock; bigger ones less

-- Low graphics (kept up to date when the setting changes).
local low = Settings.graphicsLevel() == "Low"
Settings.changed:Connect(function(key)
	if key == "graphics" then
		low = Settings.graphicsLevel() == "Low"
	end
end)

-- Collision group -------------------------------------------------------------
-- Shards and loose decorations collide with the floor and walls (Default group)
-- but not with each other. If the group can't be set up from here, everything
-- still works; pieces just also bump into each other (more physics work).

local function setupCollisionGroup()
	local okCheck, registered = pcall(PhysicsService.IsCollisionGroupRegistered, PhysicsService, SHARDS_GROUP)
	if not okCheck then
		registered = false
	end
	if not registered then
		local ok, err = pcall(PhysicsService.RegisterCollisionGroup, PhysicsService, SHARDS_GROUP)
		if not ok then
			warn("[Shatter] could not register the Shards collision group: " .. tostring(err))
			return nil
		end
	end
	local ok, err = pcall(PhysicsService.CollisionGroupSetCollidable, PhysicsService, SHARDS_GROUP, SHARDS_GROUP, false)
	if not ok then
		warn("[Shatter] Shards collision group: " .. tostring(err))
	end
	return SHARDS_GROUP
end

local shardsGroup = setupCollisionGroup()

-- Pool ---------------------------------------------------------------------------
-- Kinds: "Pair" = triangle shard (two wedges + a weld), "Wedge" = one wedge,
-- "Chip" = small block. An entry is reused forever:
-- { kind, a, b?, weld?, parts, expires, fadeStart, baseT, spawnZ }

local poolFolder = Instance.new("Folder")
poolFolder.Name = "ShatterPool"
poolFolder.Parent = workspace

local free = { Pair = {}, Wedge = {}, Chip = {} }
local made = { Pair = 0, Wedge = 0, Chip = 0 }
local live = {} -- entries in use (any order)
local liveParts = 0

local function shardCap()
	return if low then Config.LOW_MAX_LIVE_SHARDS else Config.MAX_LIVE_SHARDS
end

local function maxMade(kind)
	if kind == "Pair" then
		return math.ceil(shardCap() / 2 * 1.25)
	elseif kind == "Wedge" then
		return if low then LOW_MAX_WEDGES else MAX_WEDGES
	end
	return if low then LOW_MAX_CHIPS else MAX_CHIPS
end

local function warmTarget(kind)
	if kind == "Pair" then
		return if low then Config.SHARD_POOL_WARM // 2 else Config.SHARD_POOL_WARM
	elseif kind == "Wedge" then
		return WEDGE_WARM
	end
	return CHIP_WARM
end

local function newPoolPart(className)
	local part = Instance.new(className)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.CFrame = PARK
	if shardsGroup then
		part.CollisionGroup = shardsGroup
	end
	part.Parent = poolFolder
	return part
end

local function createEntry(kind)
	local entry = { kind = kind, parts = 1, expires = 0, fadeStart = 0, baseT = 0, spawnZ = 0 }
	if kind == "Pair" then
		entry.a = newPoolPart("WedgePart")
		entry.b = newPoolPart("WedgePart")
		-- A classic Weld with an explicit offset (C0), set every time the pair is
		-- reused, so the two halves always line up exactly.
		local weld = Instance.new("Weld")
		weld.Part0 = entry.a
		weld.Part1 = entry.b
		weld.Parent = entry.a
		entry.weld = weld
		entry.parts = 2
	elseif kind == "Wedge" then
		entry.a = newPoolPart("WedgePart")
	else
		entry.a = newPoolPart("Part")
	end
	made[kind] += 1
	return entry
end

-- Takes a live entry out of the live list (swap with the last one).
local function removeLive(index)
	local entry = live[index]
	local last = #live
	live[index] = live[last]
	live[last] = nil
	liveParts -= entry.parts
	return entry
end

-- Puts a piece back: anchored, invisible, out of the way.
local function park(entry)
	local a = entry.a
	a.Anchored = true
	a.CanCollide = false
	a.Transparency = 1
	a.CFrame = PARK
	local b = entry.b
	if b then
		b.Anchored = true
		b.CanCollide = false
		b.Transparency = 1
		b.CFrame = PARK * entry.weld.C0
	end
	table.insert(free[entry.kind], entry)
end

-- A free piece of this kind: from the pool, newly made (pool not full yet), or
-- the oldest live one when everything is in use. nil if there's none at all.
local function acquire(kind)
	local entry = table.remove(free[kind])
	if entry then
		return entry
	end
	if made[kind] < maxMade(kind) then
		return createEntry(kind)
	end
	local oldestIndex, oldestTime = nil, math.huge
	for index, other in live do
		if other.kind == kind and other.expires < oldestTime then
			oldestIndex, oldestTime = index, other.expires
		end
	end
	if oldestIndex then
		return removeLive(oldestIndex)
	end
	return nil
end

-- Marks a placed piece as live; it fades over the last `fade` seconds of `lifetime`.
local function addLive(entry, baseTransparency, lifetime, fade, z)
	local now = os.clock()
	entry.expires = now + lifetime
	entry.fadeStart = entry.expires - math.min(fade, lifetime)
	entry.baseT = baseTransparency
	entry.spawnZ = z
	table.insert(live, entry)
	liveParts += entry.parts
end

local function applyStyle(part, style, collide)
	part.Material = style.Material
	part.Color = style.Color
	part.Transparency = style.Transparency
	part.Reflectance = style.Reflectance
	part.CanCollide = collide
end

function Shatter.liveCount()
	return liveParts
end

-- Particle bursts ------------------------------------------------------------------
-- A few emitters per effect, each on its own little anchored holder part. A burst
-- moves the next holder to the spot and calls Emit; particles already flying stay
-- where they are. Round robin, so a new burst rarely recolors a fresh one.

-- holderSize: only matters for emitters that spawn on a shape (BlackHole's implosion).
local function newEmitterSet(count, setup, holderSize)
	local set = { next = 1 }
	for i = 1, count do
		local holder = Instance.new("Part")
		holder.Name = "Emitter"
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.CastShadow = false
		holder.Transparency = 1
		holder.Size = Vector3.one * (holderSize or 0.2)
		holder.CFrame = PARK
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		setup(emitter)
		emitter.Parent = holder
		holder.Parent = poolFolder
		set[i] = { holder = holder, emitter = emitter }
	end
	set.count = count
	return set
end

local function nextEmitter(set)
	local slot = set[set.next]
	set.next = set.next % set.count + 1
	return slot
end

local glitter = newEmitterSet(4, function(emitter)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.3, 0.7)
	emitter.Speed = NumberRange.new(8, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Drag = 2
	emitter.Rotation = NumberRange.new(0, 360)
end)

local dust = newEmitterSet(3, function(emitter)
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.LightEmission = 0
	emitter.LightInfluence = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 1.8),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.35, 0.7)
	emitter.Speed = NumberRange.new(2, 6)
	emitter.SpreadAngle = Vector2.new(55, 55)
	emitter.Acceleration = Vector3.new(0, -2, 0)
	emitter.Drag = 4
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-40, 40)
end)

local glassDust = newEmitterSet(2, function(emitter)
	emitter.LightEmission = 0.6
	emitter.Color = ColorSequence.new(Color3.fromRGB(235, 248, 255))
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.16),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(0.1, 1)
	emitter.Lifetime = NumberRange.new(0.5, 1.1)
	emitter.Speed = NumberRange.new(4, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -12, 0)
	emitter.Drag = 3
	emitter.Rotation = NumberRange.new(0, 360)
end)

-- A short burst of glitter at the impact point.
local function sparkle(position, color, amount)
	if low then
		return -- Low graphics: no glitter
	end
	local slot = nextEmitter(glitter)
	slot.holder.CFrame = CFrame.new(position)
	slot.emitter.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.5))
	slot.emitter:Emit(amount)
end

-- Fine glass dust hanging in the air after a big pane goes.
local function glassDustBurst(position, amount)
	if low then
		return
	end
	local slot = nextEmitter(glassDust)
	slot.holder.CFrame = CFrame.new(position)
	slot.emitter:Emit(amount)
end

-- Shatter effects -----------------------------------------------------------

local function hasFx(fx)
	return fx ~= nil and fx.Id ~= "Classic"
end

-- The look of one shard as a plain table (read once, so the original part can
-- be deleted right away). Rainbow effects get a new random hue for every shard.
local function styledTemplate(template, fx)
	local style = {
		Material = template.Material,
		Color = template.Color,
		Transparency = template.Transparency,
		Reflectance = template.Reflectance,
	}
	if not hasFx(fx) then
		return style
	end
	if fx.Rainbow then
		style.Color = Color3.fromHSV(rng:NextNumber(), 0.75, 1)
	elseif fx.Color then
		style.Color = fx.Color
	end
	if fx.Neon then
		style.Material = Enum.Material.Neon
		style.Transparency = math.min(style.Transparency, 0.2)
	elseif fx.Metal then
		style.Material = Enum.Material.Foil
		style.Transparency = 0
		style.Reflectance = 0.35
	end
	return style
end

-- Color and amount of the glitter burst.
local function sparkleStyle(baseColor, amount, fx)
	if not hasFx(fx) then
		return baseColor, amount
	end
	local color = fx.Color or baseColor
	if fx.Rainbow then
		color = Color3.fromHSV(rng:NextNumber(), 0.6, 1)
	end
	if fx.Sparkle then
		amount = math.floor(amount * 2.5)
	end
	return color, amount
end

-- How a shard flies: through the pane along `push`, outward from the impact,
-- popping up and spinning. Pieces right at the impact fly hardest, and some of
-- them burst back toward the player instead (Config.SHARD_BACK_BURST).
local function launchVelocity(center, hitPoint, push, reach)
	local away = center - hitPoint
	local distance = away.Magnitude
	local closeness = math.clamp(1 - distance / reach, 0, 1)
	local radial = if distance > 0.01 then away / distance else rng:NextUnitVector()

	local through = push * (4 + 26 * closeness ^ 1.5)
	if rng:NextNumber() < Config.SHARD_BACK_BURST * closeness then
		through = -push * rng:NextNumber(6, 16)
	end
	local linear = through
		+ radial * (3 + 20 * closeness)
		+ UP * (2 + 10 * closeness * rng:NextNumber(0.5, 1))
		+ rng:NextUnitVector() * 2
	local angular = rng:NextUnitVector() * rng:NextNumber(3, 8 + 16 * closeness)
	return linear, angular
end

-- Triangles ----------------------------------------------------------------

-- A flat triangle a-b-c as two wedge parts: returns their sizes and CFrames,
-- or nil for a sliver too thin to draw.
local function triangleShape(a, b, c, thickness)
	-- Make b-c the longest edge.
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b

	local normal = ac:Cross(ab)
	if normal.Magnitude < 0.05 or bc.Magnitude < 0.05 then
		return nil
	end
	local right = normal.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 0.05 then
		return nil
	end

	local size1 = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	local cframe1 = CFrame.fromMatrix((a + b) / 2, right, up, back)
	local size2 = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	local cframe2 = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
	return size1, cframe1, size2, cframe2
end

-- Spawn queue ---------------------------------------------------------------
-- Jobs: { triangle = true, a, b, c, thickness, style, hit, push, reach }
--    or { size, cframe, style, hit, push, reach } (one prop piece)

local queue = {}
local queueHead = 1
local queuedParts = 0

local function enqueue(job, parts)
	table.insert(queue, job)
	queuedParts += parts
end

local function spawnTriangle(job)
	queuedParts -= 2
	local size1, cframe1, size2, cframe2 = triangleShape(job.a, job.b, job.c, job.thickness)
	if not size1 then
		return
	end
	local entry = acquire("Pair")
	if not entry then
		return
	end
	local a, b = entry.a, entry.b
	applyStyle(a, job.style, true)
	applyStyle(b, job.style, true)
	a.Size = size1
	b.Size = size2
	entry.weld.C0 = cframe1:ToObjectSpace(cframe2)
	a.CFrame = cframe1
	b.CFrame = cframe2
	a.Anchored = false
	b.Anchored = false
	local center = (job.a + job.b + job.c) / 3
	local linear, angular = launchVelocity(center, job.hit, job.push, job.reach)
	a.AssemblyLinearVelocity = linear
	a.AssemblyAngularVelocity = angular
	addLive(entry, job.style.Transparency, Config.SHARD_LIFETIME + rng:NextNumber(0, SHARD_JITTER), Config.SHARD_FADE_TIME, center.Z)
end

local function spawnPiece(job)
	queuedParts -= 1
	local entry = acquire("Wedge")
	if not entry then
		return
	end
	local part = entry.a
	applyStyle(part, job.style, true)
	part.Size = job.size
	part.CFrame = job.cframe
	part.Anchored = false
	local position = job.cframe.Position
	local linear, angular = launchVelocity(position, job.hit, job.push, job.reach)
	part.AssemblyLinearVelocity = linear
	part.AssemblyAngularVelocity = angular
	addLive(entry, job.style.Transparency, Config.SHARD_LIFETIME + rng:NextNumber(0, SHARD_JITTER), Config.SHARD_FADE_TIME, position.Z)
end

-- Places queued shards until this frame's spawn time is used up (at least one).
local function processQueue()
	local deadline = os.clock() + (if low then Config.LOW_SHARD_SPAWN_BUDGET else Config.SHARD_SPAWN_BUDGET)
	while queue[queueHead] do
		local job = queue[queueHead]
		queue[queueHead] = false -- keeps the array dense until it's cleared below
		queueHead += 1
		if job.triangle then
			spawnTriangle(job)
		else
			spawnPiece(job)
		end
		if os.clock() > deadline then
			break
		end
	end
	if queue[queueHead] == nil then
		table.clear(queue)
		queueHead = 1
		queuedParts = 0
	end
end

local function overBudget()
	return liveParts + queuedParts >= shardCap()
end

-- Crack pattern ------------------------------------------------------------

-- Where a ray from p in direction d leaves the rectangle [-hx,hx] x [-hy,hy].
local function toEdge(p, d, hx, hy)
	local t = math.huge
	if d.X > 1e-6 then
		t = math.min(t, (hx - p.X) / d.X)
	elseif d.X < -1e-6 then
		t = math.min(t, (-hx - p.X) / d.X)
	end
	if d.Y > 1e-6 then
		t = math.min(t, (hy - p.Y) / d.Y)
	elseif d.Y < -1e-6 then
		t = math.min(t, (-hy - p.Y) / d.Y)
	end
	return p + d * t, t
end

local function angleOf(p, q)
	return math.atan2(q.Y - p.Y, q.X - p.X) % TAU
end

-- Returns a list of 2D triangles { {a, b, c, inner = bool}, ... } covering the
-- pane, in the pane's local X/Y plane, with the impact point p. Inner pieces
-- come first. innerOnly = true: just the small fan around the impact (shard budget).
local function crackPattern(p, hx, hy, rays, innerOnly)
	local start = rng:NextNumber(0, TAU)
	local angles = {}
	for i = 0, rays - 1 do
		local jitter = rng:NextNumber(-0.35, 0.35) * TAU / rays
		table.insert(angles, (start + i * TAU / rays + jitter) % TAU)
	end
	table.sort(angles)

	local edges, rings = {}, {}
	for i, angle in angles do
		local d = Vector2.new(math.cos(angle), math.sin(angle))
		local edge, length = toEdge(p, d, hx, hy)
		edges[i] = edge
		rings[i] = p + d * length * rng:NextNumber(0.25, 0.55)
	end

	local corners = {
		Vector2.new(hx, hy),
		Vector2.new(-hx, hy),
		Vector2.new(-hx, -hy),
		Vector2.new(hx, -hy),
	}

	local triangles = {}
	-- Inner fan: the small, fast pieces around the impact.
	for i = 1, rays do
		local j = i % rays + 1
		table.insert(triangles, { p, rings[i], rings[j], inner = true })
	end
	if innerOnly then
		return triangles
	end

	for i = 1, rays do
		local j = i % rays + 1
		local a1, a2 = angles[i], angles[j]
		local span = (a2 - a1) % TAU

		-- Outer piece: ring crack -> edge, including any pane corners in between.
		local boundary = { edges[i] }
		local between = {}
		for _, corner in corners do
			local offset = (angleOf(p, corner) - a1) % TAU
			if offset > 0 and offset < span then
				table.insert(between, { offset = offset, point = corner })
			end
		end
		table.sort(between, function(x, y)
			return x.offset < y.offset
		end)
		for _, entry in between do
			table.insert(boundary, entry.point)
		end
		table.insert(boundary, edges[j])

		for k = 1, #boundary - 1 do
			table.insert(triangles, { rings[i], boundary[k], boundary[k + 1] })
		end
		table.insert(triangles, { rings[i], edges[j], rings[j] })
	end
	return triangles
end

-- Public -------------------------------------------------------------------

function Shatter.glass(panel, hitPoint, push, _parent, fx)
	local size = panel.Size
	local cf = panel.CFrame
	local hx, hy = size.X / 2, size.Y / 2
	local thickness = math.min(size.Z, 0.4)

	-- Impact point in the pane's own 2D space (clamped just inside the edges).
	local localHit = cf:PointToObjectSpace(hitPoint)
	local p = Vector2.new(math.clamp(localHit.X, -hx * 0.95, hx * 0.95), math.clamp(localHit.Y, -hy * 0.95, hy * 0.95))

	-- Bigger panes get a few more cracks, small ones (grid tiles) only a few.
	-- Too many shards already: few cracks, inner pieces only, no glitter.
	local area = size.X * size.Y
	local busy = overBudget()
	local rays = math.clamp(Config.SHARD_RAYS + math.floor(area / 120), 5, 12)
	if low then
		rays = math.min(rays, LOW_MAX_RAYS)
	end
	if busy or area < SMALL_PANE_AREA then
		rays = FEW_RAYS
	end
	local reach = math.max(size.X, size.Y) * 0.6
	local worldHit = cf * Vector3.new(p.X, p.Y, 0)

	local plainStyle = if fx and fx.Rainbow then nil else styledTemplate(panel, fx)
	for _, tri in crackPattern(p, hx, hy, rays, busy) do
		enqueue({
			triangle = true,
			a = cf * Vector3.new(tri[1].X, tri[1].Y, 0),
			b = cf * Vector3.new(tri[2].X, tri[2].Y, 0),
			c = cf * Vector3.new(tri[3].X, tri[3].Y, 0),
			thickness = thickness,
			style = plainStyle or styledTemplate(panel, fx),
			hit = worldHit,
			push = push,
			reach = reach,
		}, 2)
	end

	if not busy then
		local sparkleColor, sparkleAmount = sparkleStyle(panel.Color, 25, fx)
		sparkle(worldHit, sparkleColor, sparkleAmount)
		if area >= BIG_PANE_AREA then
			glassDustBurst(worldHit, 30)
		end
	end
	panel:Destroy()
end

-- Breakable decorations (vases, bottles, lamps...). Each part bursts into
-- small random shards. Hitting any part of a breakable Model breaks all of it.
function Shatter.prop(part, hitPoint, push, _parent, fx)
	-- Walk up to the breakable model this part belongs to (if any).
	local root = part
	local ancestor = part.Parent
	while ancestor and ancestor ~= workspace do
		if ancestor:IsA("Model") and ancestor:GetAttribute("Breakable") then
			root = ancestor
			break
		end
		ancestor = ancestor.Parent
	end

	local pieces = if root:IsA("BasePart") then { root } else {}
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(pieces, descendant)
		end
	end

	local busy = overBudget()
	for _, piece in pieces do
		local size = piece.Size
		local volume = size.X * size.Y * size.Z
		local most = if busy then 3 elseif low then LOW_PROP_PIECES else 10
		local count = math.clamp(math.floor(volume / 1.5), 3, most)
		local reach = math.max(size.X, size.Y, size.Z) * 2
		local plainStyle = if fx and fx.Rainbow then nil else styledTemplate(piece, fx)
		for _ = 1, count do
			local shardSize = Vector3.new(
				math.max(0.1, size.X * rng:NextNumber(0.15, 0.4)),
				math.max(0.1, size.Y * rng:NextNumber(0.15, 0.4)),
				math.max(0.1, size.Z * rng:NextNumber(0.1, 0.3))
			)
			local offset = Vector3.new(
				rng:NextNumber(-0.5, 0.5) * size.X,
				rng:NextNumber(-0.5, 0.5) * size.Y,
				rng:NextNumber(-0.5, 0.5) * size.Z
			)
			local cframe = piece.CFrame
				* CFrame.new(offset)
				* CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), rng:NextNumber(0, TAU))
			enqueue({
				size = shardSize,
				cframe = cframe,
				style = plainStyle or styledTemplate(piece, fx),
				hit = hitPoint,
				push = push * 0.5,
				reach = reach,
			}, 1)
		end
		if not busy then
			local sparkleColor, sparkleAmount = sparkleStyle(piece.Color, 10, fx)
			sparkle(piece.Position, sparkleColor, sparkleAmount)
		end
	end

	root:Destroy()
end

-- Shield boost breaking: a ring of glowing shards bursts outward around the
-- player's view. cameraCFrame = where the camera is, carry = the camera's
-- velocity (so the burst travels along instead of being left behind).
local SHIELD_SHARDS = 16
local SHIELD_DISTANCE = 3.5
local SHIELD_RADIUS = 2.6

function Shatter.shieldBreak(cameraCFrame, color, _parent, carry)
	local style = {
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.25,
		Reflectance = 0,
	}
	local center = cameraCFrame * Vector3.new(0, 0, -SHIELD_DISTANCE)
	for i = 1, SHIELD_SHARDS do
		local entry = acquire("Wedge")
		if not entry then
			break
		end
		local angle = (i / SHIELD_SHARDS) * TAU + rng:NextNumber(-0.15, 0.15)
		local outward = cameraCFrame:VectorToWorldSpace(Vector3.new(math.cos(angle), math.sin(angle), 0))
		local shard = entry.a
		applyStyle(shard, style, false)
		shard.Size = Vector3.new(0.08, rng:NextNumber(0.4, 0.9), rng:NextNumber(0.3, 0.7))
		shard.CFrame = CFrame.lookAt(center + outward * SHIELD_RADIUS, center + outward * (SHIELD_RADIUS + 1))
			* CFrame.Angles(0, 0, rng:NextNumber(0, TAU))
		shard.Anchored = false
		shard.AssemblyLinearVelocity = carry + outward * rng:NextNumber(14, 24)
		shard.AssemblyAngularVelocity = rng:NextUnitVector() * rng:NextNumber(4, 10)
		addLive(entry, style.Transparency, 0.7, 0.25, center.Z)
	end
	sparkle(center, color, 30)
end

function Shatter.crystal(crystal, _parent)
	crystal.CanQuery = false

	-- A pop of glowing chips plus the crystal shrinking away.
	local style = {
		Material = crystal.Material,
		Color = crystal.Color,
		Transparency = crystal.Transparency,
		Reflectance = crystal.Reflectance,
	}
	for _ = 1, 6 do
		local entry = acquire("Chip")
		if not entry then
			break
		end
		local chip = entry.a
		applyStyle(chip, style, false)
		chip.Size = Vector3.one * rng:NextNumber(0.2, 0.45)
		chip.CFrame = crystal.CFrame * CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), 0)
		chip.Anchored = false
		chip.AssemblyLinearVelocity = rng:NextUnitVector() * rng:NextNumber(10, 20)
		addLive(entry, style.Transparency, 0.6, 0.2, crystal.Position.Z)
	end
	sparkle(crystal.Position, crystal.Color, 18)

	local tween = TweenService:Create(crystal, TweenInfo.new(0.25), {
		Size = Vector3.zero,
		Transparency = 1,
	})
	tween.Completed:Connect(function()
		crystal:Destroy()
	end)
	tween:Play()
end

-- Ball impacts -----------------------------------------------------------------

local lastImpact = 0

-- A ball hit a wall, the floor or a decoration: a small dust puff and a few
-- chips of that surface. Rate limited (Config.IMPACT_FX_INTERVAL).
function Shatter.impact(position, normal, surface)
	local now = os.clock()
	if now - lastImpact < Config.IMPACT_FX_INTERVAL then
		return
	end
	lastImpact = now

	local color = surface.Color
	local up = if math.abs(normal.Y) > 0.9 then Vector3.xAxis else UP
	local slot = nextEmitter(dust)
	slot.holder.CFrame = CFrame.lookAt(position, position + normal, up)
	slot.emitter.Color = ColorSequence.new(color:Lerp(Color3.fromRGB(150, 150, 150), 0.4))
	slot.emitter:Emit(if low then 3 else 6)

	local style = {
		Material = surface.Material,
		Color = color:Lerp(Color3.new(0, 0, 0), 0.15),
		Transparency = math.min(surface.Transparency, 0.3),
		Reflectance = 0,
	}
	for _ = 1, if low then 2 else rng:NextInteger(2, 4) do
		local entry = acquire("Chip")
		if not entry then
			break
		end
		local chip = entry.a
		applyStyle(chip, style, true)
		chip.Size = Vector3.new(rng:NextNumber(0.12, 0.3), rng:NextNumber(0.1, 0.22), rng:NextNumber(0.12, 0.3))
		chip.CFrame = CFrame.new(position + normal * 0.25)
			* CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), rng:NextNumber(0, TAU))
		chip.Anchored = false
		chip.AssemblyLinearVelocity = normal * rng:NextNumber(8, 16) + rng:NextUnitVector() * 5 + UP * 4
		chip.AssemblyAngularVelocity = rng:NextUnitVector() * rng:NextNumber(5, 15)
		addLive(entry, style.Transparency, Config.IMPACT_CHIP_LIFETIME, 0.3, position.Z)
	end
end

-- Ball skin splash ---------------------------------------------------------------
-- Wherever a ball hits glass, a prop or a wall, a short burst in its skin's colors
-- sprays out of the surface, so you see your skin at the moment that matters.
-- style = BallFx.impactStyle(skinId). Pooled emitters (round robin, made once;
-- the themed ones only the first time that ball is used). Rate limited; smaller
-- on Low graphics and while the shard budget is busy; the bright Supernova flare
-- follows the "flashes" setting.

local SKIN_BURST_INTERVAL = 0.05 -- at most one splash this often (a multiball fan hits at once)
local SKIN_BURST_COUNT = 14 -- sparks in a normal splash (Low: 40%)
local lastSkinBurst = 0
local flashesOn = Settings.get("flashes") ~= false
Settings.changed:Connect(function(key, value)
	if key == "flashes" then
		flashesOn = value ~= false
	end
end)

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE_TEXTURE = "rbxasset://textures/particles/fire_main.dds"

local function fading(startSize, endSize)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, startSize),
		NumberSequenceKeypoint.new(1, endSize),
	})
end

-- Every skin: sparks thrown out of the surface (the emitter faces along the normal).
local skinSparks = newEmitterSet(4, function(emitter)
	emitter.Texture = SPARKLE_TEXTURE
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.LightEmission = 1
	emitter.Size = fading(0.4, 0)
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.25, 0.5)
	emitter.Speed = NumberRange.new(8, 20)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Acceleration = Vector3.new(0, -25, 0)
	emitter.Drag = 4
	emitter.Rotation = NumberRange.new(0, 360)
end)

-- Premium themes, made the first time they're needed.
local THEMES = {
	Supernova = {
		count = 22,
		setup = function(emitter) -- gold sparks flying hard
			emitter.Texture = FIRE_TEXTURE
			emitter.EmissionDirection = Enum.NormalId.Front
			emitter.LightEmission = 1
			emitter.Color = ColorSequence.new(Color3.fromRGB(255, 240, 180), Color3.fromRGB(255, 140, 30))
			emitter.Size = fading(0.6, 0)
			emitter.Transparency = NumberSequence.new(0, 1)
			emitter.Lifetime = NumberRange.new(0.25, 0.55)
			emitter.Speed = NumberRange.new(14, 30)
			emitter.SpreadAngle = Vector2.new(85, 85)
			emitter.Drag = 5
			emitter.Rotation = NumberRange.new(0, 360)
		end,
		flare = function(emitter) -- one big gold glow that blooms and fades
			emitter.Texture = SPARKLE_TEXTURE
			emitter.LightEmission = 1
			emitter.Color = ColorSequence.new(Color3.fromRGB(255, 225, 140))
			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1.5),
				NumberSequenceKeypoint.new(0.3, 4.5),
				NumberSequenceKeypoint.new(1, 0.5),
			})
			emitter.Transparency = NumberSequence.new(0.1, 1)
			emitter.Lifetime = NumberRange.new(0.22)
			emitter.Speed = NumberRange.new(0)
			emitter.Rotation = NumberRange.new(0, 360)
		end,
	},
	BlackHole = {
		count = 26,
		holderSize = 3.2,
		setup = function(emitter) -- purple sparks pulled in from a sphere around the hit
			emitter.Texture = SPARKLE_TEXTURE
			emitter.Shape = Enum.ParticleEmitterShape.Sphere
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
			emitter.LightEmission = 1
			emitter.Color = ColorSequence.new(Color3.fromRGB(215, 180, 255), Color3.fromRGB(130, 50, 255))
			emitter.Size = fading(0.3, 0.05)
			emitter.Transparency = NumberSequence.new(0.1, 0.6)
			emitter.Lifetime = NumberRange.new(0.2, 0.26)
			emitter.Speed = NumberRange.new(6, 7.5) -- reaches the middle as it fades
			emitter.Rotation = NumberRange.new(0, 360)
		end,
	},
	MagmaHeart = {
		count = 18,
		setup = function(emitter) -- glowing embers drifting up
			emitter.Texture = SPARKLE_TEXTURE
			emitter.EmissionDirection = Enum.NormalId.Front
			emitter.LightEmission = 1
			emitter.Color = ColorSequence.new(Color3.fromRGB(255, 190, 60), Color3.fromRGB(230, 50, 10))
			emitter.Size = fading(0.28, 0.05)
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.7, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			emitter.Lifetime = NumberRange.new(0.7, 1.3)
			emitter.Speed = NumberRange.new(4, 11)
			emitter.SpreadAngle = Vector2.new(80, 80)
			emitter.Acceleration = Vector3.new(0, 7, 0)
			emitter.Drag = 2.5
			emitter.Rotation = NumberRange.new(0, 360)
			emitter.RotSpeed = NumberRange.new(-90, 90)
		end,
	},
	PlasmaCore = {
		count = 20,
		setup = function(emitter) -- fast violet sparks
			emitter.Texture = SPARKLE_TEXTURE
			emitter.EmissionDirection = Enum.NormalId.Front
			emitter.LightEmission = 1
			emitter.Color = ColorSequence.new(Color3.fromRGB(255, 150, 255), Color3.fromRGB(140, 80, 255))
			emitter.Size = fading(0.35, 0)
			emitter.Transparency = NumberSequence.new(0, 1)
			emitter.Lifetime = NumberRange.new(0.15, 0.35)
			emitter.Speed = NumberRange.new(20, 34)
			emitter.SpreadAngle = Vector2.new(90, 90)
			emitter.Drag = 7
			emitter.Rotation = NumberRange.new(0, 360)
			emitter.RotSpeed = NumberRange.new(-300, 300)
		end,
	},
	Frostbite = {
		count = 24,
		setup = function(emitter) -- soft snow sparkle settling down
			emitter.Texture = SPARKLE_TEXTURE
			emitter.EmissionDirection = Enum.NormalId.Front
			emitter.LightEmission = 0.7
			emitter.Color = ColorSequence.new(Color3.fromRGB(240, 250, 255), Color3.fromRGB(150, 215, 255))
			emitter.Size = fading(0.22, 0.06)
			emitter.Transparency = NumberSequence.new(0.05, 1)
			emitter.Lifetime = NumberRange.new(0.8, 1.4)
			emitter.Speed = NumberRange.new(3, 7)
			emitter.SpreadAngle = Vector2.new(90, 90)
			emitter.Acceleration = Vector3.new(0, -4, 0)
			emitter.Drag = 2
			emitter.Rotation = NumberRange.new(0, 360)
			emitter.RotSpeed = NumberRange.new(-60, 60)
		end,
	},
	-- CyberCore: glowing cyan bits (pooled chips, see below) + the normal sparks.
}
local themeSets = {} -- id -> { sparks = set, flare = set? }

local function themeSet(id)
	local theme = THEMES[id]
	if not theme then
		return nil
	end
	local sets = themeSets[id]
	if not sets then
		sets = { sparks = newEmitterSet(2, theme.setup, theme.holderSize) }
		if theme.flare then
			sets.flare = newEmitterSet(2, theme.flare)
		end
		themeSets[id] = sets
	end
	return sets, theme
end

local CYBER_BIT_STYLE = {
	Material = Enum.Material.Neon,
	Color = Color3.fromRGB(0, 235, 255),
	Transparency = 0,
	Reflectance = 0,
}

-- position: where the ball hit. normal: the surface's normal there (toward the ball).
-- style: BallFx.impactStyle(skinId). big: a big pane or a mega ball (bigger splash).
function Shatter.skinBurst(position, normal, style, big)
	if not style then
		return
	end
	local now = os.clock()
	if now - lastSkinBurst < SKIN_BURST_INTERVAL then
		return
	end
	lastSkinBurst = now

	local scale = (if big then 1.6 else 1) * (if low then 0.4 else 1)
	if overBudget() then
		scale *= 0.5 -- lots of glass flying already
	end
	local up = if math.abs(normal.Y) > 0.9 then Vector3.xAxis else UP
	local facing = CFrame.lookAt(position, position + normal, up)

	local slot = nextEmitter(skinSparks)
	slot.holder.CFrame = facing
	if style.rainbow then
		local hue = rng:NextNumber()
		slot.emitter.Color = ColorSequence.new(Color3.fromHSV(hue, 0.75, 1), Color3.fromHSV((hue + 0.3) % 1, 0.75, 1))
	else
		slot.emitter.Color = ColorSequence.new(style.color, style.color2)
	end
	slot.emitter:Emit(math.max(3, math.floor(SKIN_BURST_COUNT * scale + 0.5)))

	if not style.premium then
		return
	end
	-- Premium: a bigger, themed splash on top.
	local sets, theme = themeSet(style.id)
	if sets then
		local themed = nextEmitter(sets.sparks)
		-- A shape emitter (the implosion sphere) sits a little out of the surface.
		themed.holder.CFrame = if theme.holderSize then facing + normal * theme.holderSize * 0.25 else facing
		themed.emitter:Emit(math.max(4, math.floor(theme.count * scale + 0.5)))
		if sets.flare and flashesOn and not low then
			local flare = nextEmitter(sets.flare)
			flare.holder.CFrame = CFrame.new(position + normal * 0.3)
			flare.emitter:Emit(if big then 2 else 1)
		end
	elseif style.id == "CyberCore" then
		for _ = 1, if low then 2 else 5 do
			local entry = acquire("Chip")
			if not entry then
				break
			end
			local bit = entry.a
			applyStyle(bit, CYBER_BIT_STYLE, true)
			bit.Size = Vector3.one * rng:NextNumber(0.12, 0.24)
			bit.CFrame = CFrame.new(position + normal * 0.3)
				* CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), 0)
			bit.Anchored = false
			bit.AssemblyLinearVelocity = normal * rng:NextNumber(8, 16) + rng:NextUnitVector() * 6 + UP * 3
			bit.AssemblyAngularVelocity = rng:NextUnitVector() * rng:NextNumber(6, 14)
			addLive(entry, 0, 0.7, 0.3, position.Z)
		end
	end
end

-- Knock-loose decorations ------------------------------------------------------
-- Solid decorations (kind "Wall", not part of the room shell) that a ball hits
-- come off their spot and tumble. They stop being hittable (CanQuery = false),
-- so balls fly through them and never get blocked from reaching glass. They
-- never count as hazards. After LOOSE_DECOR_SETTLE seconds, or when too many
-- are loose, they freeze where they lie. Deleting the room removes them.

local loose = {} -- knocked parts, oldest first
local looseTime = {} -- os.clock() each one was knocked

local function looseCap()
	return if low then Config.LOW_LOOSE_DECOR_MAX else Config.LOOSE_DECOR_MAX
end

local function freezeOldest()
	local part = table.remove(loose, 1)
	table.remove(looseTime, 1)
	if part.Parent then
		part.Anchored = true
		part.CanCollide = false
	end
end

-- Can a ball knock this part loose?
function Shatter.canKnock(part)
	if not part:IsA("BasePart") or not part.Anchored or not part.CanQuery then
		return false
	end
	if part:GetAttribute("Kind") ~= "Wall" or part:GetAttribute("Shell") then
		return false
	end
	local size = part.Size
	if math.max(size.X, size.Y, size.Z) > Config.LOOSE_DECOR_MAX_SIZE then
		return false
	end
	-- Parts carrying a room light or a zone name sign stay put.
	if part:FindFirstChildWhichIsA("Light") or part:FindFirstChildWhichIsA("SurfaceGui") then
		return false
	end
	return true
end

-- Knocks one part loose, flying along `direction` (a unit vector).
-- strength: 1 = normal ball, more = harder.
function Shatter.knockLoose(part, direction, strength)
	while #loose >= looseCap() do
		freezeOldest()
	end
	local track = Config.TRACK_ORIGIN
	-- Nudge it off the wall / floor it was touching so it doesn't start stuck inside.
	local position = part.Position
	local towardMiddle = Vector3.new(track.X - position.X, 0, 0)
	local nudge = UP * KNOCK_NUDGE
	if towardMiddle.Magnitude > 0.01 then
		nudge += towardMiddle.Unit * KNOCK_NUDGE
	end
	part.CFrame += nudge

	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false -- moving shadow casters are costly; it's moving fast anyway
	part.CanCollide = true
	if shardsGroup then
		part.CollisionGroup = shardsGroup
	end
	part.Anchored = false
	-- Small things fly, big things (a sign board, a bench top) mostly topple over,
	-- so nothing large sails across the view in front of the glass.
	local size = part.Size
	local heft = math.clamp(KNOCK_FULL_SIZE / math.max(size.X, size.Y, size.Z), 0.35, 1)
	local speed = Config.LOOSE_DECOR_SPEED * strength * heft * rng:NextNumber(0.75, 1.15)
	part.AssemblyLinearVelocity = direction * speed + UP * KNOCK_UP * rng:NextNumber(0.6, 1.4) + rng:NextUnitVector() * 2
	part.AssemblyAngularVelocity = rng:NextUnitVector() * KNOCK_SPIN * heft * rng:NextNumber(0.5, 1.5)

	table.insert(loose, part)
	table.insert(looseTime, os.clock())
end

-- Knocks loose every knockable part touching a sphere (mega ball, or a normal
-- ball splashing a decoration made of several parts). params: OverlapParams
-- limited to the track. Returns how many parts came loose.
function Shatter.knockAround(position, radius, direction, strength, params)
	local count = 0
	for _, part in workspace:GetPartBoundsInRadius(position, radius, params) do
		if Shatter.canKnock(part) then
			Shatter.knockLoose(part, direction, strength)
			count += 1
		end
	end
	return count
end

-- Per frame ----------------------------------------------------------------------

local nextBehindCheck = 0
local KINDS = { "Pair", "Wedge", "Chip" }

-- Makes a few pool pieces ahead of time (a little per frame).
local function warmPool()
	local deadline = os.clock() + WARM_BUDGET
	for _, kind in KINDS do
		local list = free[kind]
		while made[kind] < warmTarget(kind) and made[kind] < maxMade(kind) do
			table.insert(list, createEntry(kind))
			if os.clock() > deadline then
				return
			end
		end
	end
end

local warmDone = false

-- Call every frame with the camera's Z position.
function Shatter.update(cameraZ)
	processQueue()

	local now = os.clock()
	local releases = 0

	-- Fade out, then return to the pool.
	for index = #live, 1, -1 do
		local entry = live[index]
		if now >= entry.expires then
			if releases < RELEASES_PER_FRAME then
				releases += 1
				park(removeLive(index))
			end
		elseif now >= entry.fadeStart then
			local t = (now - entry.fadeStart) / (entry.expires - entry.fadeStart)
			local transparency = entry.baseT + (1 - entry.baseT) * t
			entry.a.Transparency = transparency
			if entry.b then
				entry.b.Transparency = transparency
			end
		end
	end

	-- Shards behind the camera: nobody can see them, recycle them now.
	if now >= nextBehindCheck then
		nextBehindCheck = now + BEHIND_CHECK_INTERVAL
		local limit = cameraZ + BEHIND_DISTANCE
		for index = #live, 1, -1 do
			if releases >= RELEASES_PER_FRAME then
				break
			end
			local entry = live[index]
			if entry.spawnZ > cameraZ and entry.a.Position.Z > limit then
				releases += 1
				park(removeLive(index))
			end
		end
	end

	-- Loose decorations that tumbled long enough freeze where they lie.
	while looseTime[1] and now - looseTime[1] > Config.LOOSE_DECOR_SETTLE do
		freezeOldest()
	end

	if not warmDone then
		warmPool()
		warmDone = made.Pair >= warmTarget("Pair") and made.Wedge >= WEDGE_WARM and made.Chip >= CHIP_WARM
	end
end

-- New run: everything back into the pool, nothing queued, no loose decorations
-- (those were deleted with the old run's world).
function Shatter.reset()
	for index = #live, 1, -1 do
		park(removeLive(index))
	end
	table.clear(queue)
	queueHead = 1
	queuedParts = 0
	table.clear(loose)
	table.clear(looseTime)
	warmDone = false
end

return Shatter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Plays the sound IDs from Config.Sounds. IDs left at 0 are silently skipped,
	so the game works before any audio is uploaded.

	Every sound belongs to one of two SoundGroups under SoundService:
	  "Music" - the background music, volume = Settings "music"
	  "SFX"   - everything else,       volume = Settings "sfx"
	Moving a volume slider changes the group right away (even mid-sound).
	Each sound keeps its own volume inside its group, so the gift sound stays
	louder than a shatter at any slider position.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Settings = require(script.Parent.Settings)

local Sounds = {}

-- Volume per sound (Roblox's Sound.Volume, 0-10) before the group volume is
-- applied. Sounds not listed use DEFAULT_VOLUME. The gift sound is meant to grab attention.
local DEFAULT_VOLUME = 0.6
local VOLUMES = {
	Gift = 1.4,
	Music = 0.6,
	Swing = 0.45, -- plays on every throw, so a bit softer
	Reload = 0.3, -- quiet: it's a background detail
}
local MUSIC_SOUNDS = { Music = true }
local CLEANUP_AFTER = 20 -- seconds: safety net for copies whose Ended never fires (failed to load)

-- Sound groups ---------------------------------------------------------------------

local function makeGroup(name)
	local group = SoundService:FindFirstChild(name)
	if not (group and group:IsA("SoundGroup")) then
		group = Instance.new("SoundGroup")
		group.Name = name
		group.Parent = SoundService
	end
	return group
end

local musicGroup = makeGroup("Music")
local sfxGroup = makeGroup("SFX")

local function volumeSetting(key)
	local value = tonumber(Settings.get(key))
	return math.clamp(value or Config.DefaultSettings[key] or 1, 0, 1)
end

local function applyVolumes()
	musicGroup.Volume = volumeSetting("music")
	sfxGroup.Volume = volumeSetting("sfx")
end
applyVolumes()

Settings.changed:Connect(function(key)
	if key == "music" or key == "sfx" then
		applyVolumes()
	end
end)

-- Sounds ---------------------------------------------------------------------------

local cache = {}

local function getSound(name)
	local id = Config.Sounds[name]
	if not id or id == 0 then
		return nil
	end
	if not cache[name] then
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = VOLUMES[name] or DEFAULT_VOLUME
		sound.SoundGroup = if MUSIC_SOUNDS[name] then musicGroup else sfxGroup
		sound.Parent = SoundService
		cache[name] = sound
	end
	return cache[name]
end

-- pitch: optional playback speed (a little random variety).
-- volume: optional, overrides the sound's usual volume for this one play.
function Sounds.play(name, pitch, volume)
	-- Effects muted: don't even make the copy.
	if not MUSIC_SOUNDS[name] and sfxGroup.Volume <= 0 then
		return
	end
	local sound = getSound(name)
	if not sound then
		return
	end
	-- Always a fresh copy (it keeps its SoundGroup), so the same sound can overlap
	-- itself and the group volume always applies. Varying the pitch a little keeps
	-- repeated shatters from sounding robotic.
	local copy = sound:Clone()
	copy.PlaybackSpeed = pitch or 1
	copy.Volume = volume or sound.Volume
	copy.Parent = SoundService
	copy.Ended:Once(function()
		copy:Destroy()
	end)
	Debris:AddItem(copy, CLEANUP_AFTER)
	copy:Play()
end

function Sounds.startMusic()
	local music = getSound("Music")
	if music and not music.IsPlaying then
		music.Looped = true
		music:Play()
	end
end

-- For the settings menu, if it wants them (e.g. a preview blip).
Sounds.musicGroup = musicGroup
Sounds.sfxGroup = sfxGroup

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">TrackBuilder</string>
            <string name="Source"><![CDATA[--[[
	Builds the corridor rooms in front of the camera and deletes the ones behind it.
	Everything here is created on the player's device only, so nobody else sees it.

	Smoothness: building or deleting a whole room in one frame makes phones
	stutter (a room is 150-300 parts), and at top speed a new room comes every
	~1.5 seconds. So nothing here ever does a whole room in one frame:

	  Building - each room is built by its own coroutine (a function that can
	    pause and continue later). Every part goes through newPart, and newPart
	    pauses the coroutine as soon as this frame's build time is used up
	    (Config.ROOM_BUILD_BUDGET, LOW_ROOM_BUILD_BUDGET on Low graphics). The
	    next frame it carries on exactly where it stopped. Order inside a room:
	      1. shell (floor, walls, trim) AND all glass, doors and crystals
	      2. decorations (Decor.luau, through builder.newPart)
	      3. lights (LightingFx.lightRoom)
	    Rooms are started one room earlier than they become visible
	    (Config.ROOMS_AHEAD + 1), so a room is long finished before the camera
	    gets there. Safety net: a room still unfinished when the camera is
	    Config.ROOM_FORCE_DISTANCE away is finished at once (Studio warns,
	    because that means the budget is too small for this device).
	    The room folder goes into the world right away and its parts arrive a few
	    per frame. That is on purpose: adding a part to the world has a cost too,
	    and parenting a finished 300-part folder in one go would be one big
	    spike again. Half-built rooms are a whole room past the fog, so nobody
	    sees them.

	  Deleting - rooms behind the camera go to a trash list and lose a few
	    parts per frame (Config.ROOM_TEARDOWN_BUDGET). They're out of view.

	Room shell parts carry the attribute Shell = true. Everything else of
	kind "Wall" is decoration that a ball can knock loose (see Shatter.knockLoose).

	Zones 6-10 add four obstacles (Config.ZonePatterns): ArmoredGlass (2 hits,
	see crackArmor), BobbingPane (tween), FallingPane (drops when you get close)
	and RingSpinner (a turning wheel of panes). The last two are moved by
	updateMovers every frame, only for finished rooms near the camera.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Decor = require(script.Parent.Decor)
local Models = require(script.Parent.Models)
local LightingFx = require(script.Parent.LightingFx)

local WIDTH = Config.CORRIDOR_WIDTH
local HEIGHT = Config.CORRIDOR_HEIGHT
local LENGTH = Config.ROOM_LENGTH
local ORIGIN = Config.TRACK_ORIGIN
local EYE_Y = ORIGIN.Y + Config.CAMERA_HEIGHT
local BUILD_AHEAD = (Config.ROOMS_AHEAD + 1) * LENGTH -- rooms start building this far ahead (studs)
local CATCH_UP_DISTANCE = 1.5 * LENGTH -- the room being built is this close: build twice as fast
local IS_STUDIO = RunService:IsStudio()

local TrackBuilder = {}
TrackBuilder.__index = TrackBuilder

-- Time slicing -------------------------------------------------------------
-- The coroutine building a room right now, and when this frame's build time ends.
local buildThread = nil
local buildDeadline = math.huge

-- Called before every part is made: if this frame's build time is used up,
-- pause the room's coroutine until the next frame. Does nothing outside a
-- room build (or when a room is being finished right away).
local function pauseIfOverBudget()
	if buildThread ~= nil and os.clock() > buildDeadline and coroutine.running() == buildThread then
		coroutine.yield()
	end
end

-- kind: "Wall" (balls bounce), "Glass" (hazard), "Crystal", "Door", "Button", "Prop" (breakable decoration)
local function newPart(parent, kind, props)
	pauseIfOverBudget()
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for name, value in props do
		part[name] = value
	end
	part:SetAttribute("Kind", kind)
	part.Parent = parent
	return part
end

-- Shell materials per zone style (floor gets its own material and a darker tint).
local SURFACES = {
	Lab = { Wall = Enum.Material.SmoothPlastic, Ceiling = Enum.Material.SmoothPlastic, Floor = Enum.Material.Marble, FloorTint = Color3.fromRGB(120, 125, 135), FloorTintAmount = 0.25 },
	Neon = { Wall = Enum.Material.DiamondPlate, Ceiling = Enum.Material.Metal, Floor = Enum.Material.Slate, FloorTint = Color3.fromRGB(10, 10, 18), FloorTintAmount = 0.5 },
	Temple = { Wall = Enum.Material.Sandstone, Ceiling = Enum.Material.Sandstone, Floor = Enum.Material.Limestone, FloorTint = Color3.fromRGB(150, 110, 70), FloorTintAmount = 0.3 },
	Greenhouse = { Wall = Enum.Material.Concrete, Ceiling = Enum.Material.Glass, Floor = Enum.Material.WoodPlanks, FloorTint = Color3.fromRGB(120, 80, 45), FloorTintAmount = 0.6 },
	Void = { Wall = Enum.Material.Basalt, Ceiling = Enum.Material.Basalt, Floor = Enum.Material.Slate, FloorTint = Color3.fromRGB(10, 5, 20), FloorTintAmount = 0.4 },
	Frost = { Wall = Enum.Material.Glacier, Ceiling = Enum.Material.Ice, Floor = Enum.Material.Glacier, FloorTint = Color3.fromRGB(150, 190, 225), FloorTintAmount = 0.3 },
	Magma = { Wall = Enum.Material.Basalt, Ceiling = Enum.Material.Basalt, Floor = Enum.Material.CrackedLava, FloorTint = Color3.fromRGB(35, 18, 12), FloorTintAmount = 0.35 },
	Aquarium = { Wall = Enum.Material.Slate, Ceiling = Enum.Material.Metal, Floor = Enum.Material.Sand, FloorTint = Color3.fromRGB(200, 180, 130), FloorTintAmount = 0.6 },
	Sky = { Wall = Enum.Material.Marble, Ceiling = Enum.Material.Marble, Floor = Enum.Material.Marble, FloorTint = Color3.fromRGB(225, 195, 135), FloorTintAmount = 0.25 },
	Core = { Wall = Enum.Material.Slate, Ceiling = Enum.Material.Basalt, Floor = Enum.Material.Marble, FloorTint = Color3.fromRGB(14, 8, 28), FloorTintAmount = 0.5 },
}

-- New obstacles (zones 6+) ----------------------------------------------------------
local ARMOR_COLOR = Color3.fromRGB(105, 150, 185) -- thick tinted glass
local ARMOR_CRACKED_COLOR = Color3.fromRGB(70, 100, 130)
local ARMOR_EDGE_COLOR = Color3.fromRGB(45, 52, 62)
local CRACK_COLOR = Color3.fromRGB(225, 245, 255)
local WARNING_COLOR = Color3.fromRGB(255, 170, 30)
local FALL_TRIGGER_DISTANCE = 70 -- a FallingPane drops when the camera is this close (studs)
local FALL_TIME = 0.4 -- seconds the drop takes
local RING_SLOTS = 8 -- RingSpinner: 8 places around the wheel, 6 have a pane (a 2-slot gap)
local RING_PANES = 6
local RING_CENTER_HEIGHT = 9.5 -- above the floor; the wheel turns above the middle of the corridor
local RING_INNER, RING_OUTER = 1, 4.4 -- each pane runs from this far from the center to this far
local SPIN_RANGE = 260 -- RingSpinners further ahead than this (studs) stand still (past the fog)
-- The wheel turns with the distance you fly, not with time: whatever your speed
-- (slow-mo, a pause...) the marked pane is exactly at the bottom when you get there.
-- Radians turned per stud flown (at 55 studs/s that is a slow 0.5-0.77 radians per second).
local RING_TURN_PER_STUD = { 0.009, 0.014 }
local RING_TARGET_TINT = 0.45 -- how orange the marked pane is

-- Groups of obstacles in one room are spread evenly, but never closer than this (studs).
local MIN_GROUP_SPACING = 20

-- Glass visibility: less see-through than before, plus a glowing outline.
local GLASS_TRANSPARENCY = 0.2
local GLASS_OUTLINE_THICKNESS = 0.07
local GLASS_OUTLINE_SURFACE = 0.82 -- the light tint inside the outline (Low graphics: edges only)
-- Outlines only show in the camera's room and the next OUTLINE_ROOMS rooms (a
-- room switches them on as it becomes the 2nd room ahead, 160+ studs away, so
-- glass always has its outline long before it's close). Further rooms are past the fog.
local OUTLINE_ROOMS = 2
-- Small "extra" panes (the far parts of a Grid) only get an outline while the
-- room has fewer than this many; the panes that matter always get one.
local OUTLINE_CAP_PER_ROOM = 12

-- Shared with Decor.luau.
TrackBuilder.newPart = newPart
TrackBuilder.WIDTH = WIDTH
TrackBuilder.HEIGHT = HEIGHT
TrackBuilder.LENGTH = LENGTH
TrackBuilder.ORIGIN = ORIGIN
TrackBuilder.EYE_Y = EYE_Y
TrackBuilder.Models = Models

function TrackBuilder.themeFor(roomIndex)
	local checkpoint = roomIndex // Config.ROOMS_PER_CHECKPOINT
	return Config.Themes[checkpoint % #Config.Themes + 1]
end

function TrackBuilder.roomStartZ(roomIndex)
	return ORIGIN.Z - roomIndex * LENGTH
end

-- tutorial = true builds the scripted first-run rooms (see buildTutorialRoom).
function TrackBuilder.new(parent, firstRoom, tutorial)
	local self = setmetatable({}, TrackBuilder)
	self.tutorial = tutorial == true
	self.tutorialTargets = {} -- step number -> part the player must break/collect
	self.folder = Instance.new("Folder")
	self.folder.Name = "Track"
	self.folder.Parent = parent
	self.rooms = {} -- roomIndex -> { folder, glass = { Part }, doors = { door }, crystals = { Part } }
	self.doorOf = setmetatable({}, { __mode = "k" }) -- door panel / button -> door
	self.nextRoom = firstRoom or 0
	self.rng = Random.new()
	self.buildQueue = {} -- rooms still being built, nearest first: { roomIndex, thread, done }
	self.trash = {} -- rooms behind the camera, deleted a few parts per frame: { folder, children, index }
	self.hazardList = {} -- cached result of hazards()
	self.hazardsDirty = true
	self.shadowRoom = nil -- room index the shadow lights were last set for
	self.warmedUp = false
	return self
end

-- optional = true: a small extra pane (part of a Grid) that only gets an outline
-- while the room is under OUTLINE_CAP_PER_ROOM outlines.
function TrackBuilder:addGlass(room, position, size, optional)
	local glass = newPart(room.folder, "Glass", {
		Name = "Glass",
		Size = size,
		CFrame = CFrame.new(position),
		Material = Enum.Material.Glass,
		Color = Config.GLASS_COLOR,
		Transparency = GLASS_TRANSPARENCY,
		Reflectance = 0.15,
	})

	-- Glowing outline + light tint so glass is always easy to see, even far
	-- away in the fog or against pale walls. It follows moving/spinning panes
	-- and disappears with the pane when it shatters. Hidden until the room is
	-- near (setOutlinesNear), and edges only on Low graphics.
	if not optional or #room.outlines < OUTLINE_CAP_PER_ROOM then
		local accent = if room.theme and room.theme.Accent then room.theme.Accent else Color3.fromRGB(90, 200, 255)
		local outline = Instance.new("SelectionBox")
		outline.Name = "Outline"
		outline.Adornee = glass
		outline.Color3 = accent:Lerp(Color3.new(1, 1, 1), 0.25)
		outline.LineThickness = GLASS_OUTLINE_THICKNESS
		outline.SurfaceColor3 = accent
		outline.SurfaceTransparency = if LightingFx.isLow() then 1 else GLASS_OUTLINE_SURFACE
		outline.Visible = room.outlinesOn == true
		outline.Parent = glass
		table.insert(room.outlines, outline)
	end

	table.insert(room.glass, glass)
	return glass
end

-- Switches a room's glass outlines on (it's one of the rooms near the camera).
local function showOutlines(room)
	if room.outlinesOn then
		return
	end
	room.outlinesOn = true
	local surface = if LightingFx.isLow() then 1 else GLASS_OUTLINE_SURFACE
	for _, outline in room.outlines do
		if outline.Parent then
			outline.SurfaceTransparency = surface
			outline.Visible = true
		end
	end
end

-- The camera moved into another room: outlines on for it and the next OUTLINE_ROOMS.
-- (Rooms behind are deleted; rooms further ahead still have theirs hidden.)
function TrackBuilder:setOutlinesNear(cameraZ)
	local current = TrackBuilder.roomAt(cameraZ)
	if current == self.outlineRoom then
		return
	end
	self.outlineRoom = current
	for roomIndex = current, current + OUTLINE_ROOMS do
		local room = self.rooms[roomIndex]
		if room then
			showOutlines(room)
		end
	end
end

-- Uses the Blender gem when it's uploaded, a rotated neon cube otherwise.
local function meshCrystal(parent, position)
	local model = Models.place("Crystal", parent, CFrame.new(position), { anchor = "center", kind = "Crystal" })
	if not model then
		return nil
	end
	local gem = model:FindFirstChildWhichIsA("BasePart", true)
	if not gem then
		model:Destroy()
		return nil
	end
	gem.Parent = parent
	model:Destroy()
	gem.Name = "Crystal"
	gem.Material = Enum.Material.Neon
	gem.Color = Config.CRYSTAL_COLOR
	return gem
end

function TrackBuilder:addCrystal(room, position)
	local gem = meshCrystal(room.folder, position)
	if gem then
		table.insert(room.crystals, gem)
		return
	end
	local crystal = newPart(room.folder, "Crystal", {
		Name = "Crystal",
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Material = Enum.Material.Neon,
		Color = Config.CRYSTAL_COLOR,
	})
	table.insert(room.crystals, crystal)
end

local function patternsForZone(zone)
	return Config.ZonePatterns[math.min(zone + 1, #Config.ZonePatterns)]
end

-- Loops a part between two CFrames forever. Destroying the part stops it.
local function animate(part, goal, duration, reverses)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverses)
	TweenService:Create(part, info, { CFrame = goal }):Play()
end

TrackBuilder.Patterns = {}
local Patterns = TrackBuilder.Patterns

-- A pane right in front of you, slightly off center.
function Patterns.Window(self, room, z)
	local x = ORIGIN.X + self.rng:NextNumber(-2, 2)
	self:addGlass(room, Vector3.new(x, EYE_Y, z), Vector3.new(8, 8, 0.4))
end

-- Tall panes across the corridor, one always in the middle.
function Patterns.Pillars(self, room, z)
	for _, x in { -7, 0, 7 } do
		self:addGlass(room, Vector3.new(ORIGIN.X + x, ORIGIN.Y + HEIGHT / 2, z), Vector3.new(4, HEIGHT, 0.4))
	end
end

-- A wide horizontal pane at eye level.
function Patterns.Beam(self, room, z)
	self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, z), Vector3.new(WIDTH, 3, 0.4))
end

-- Blocks the whole corridor.
function Patterns.FullWall(self, room, z)
	self:addGlass(room, Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT / 2, z), Vector3.new(WIDTH, HEIGHT, 0.4))
end

-- Two panes close together: one throw won't clear both.
function Patterns.Double(self, room, z)
	self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, z), Vector3.new(10, 8, 0.4))
	self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, z - 6), Vector3.new(10, 8, 0.4))
end

-- A pane sliding side to side.
function Patterns.Moving(self, room, z)
	local rng = self.rng
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	local from = CFrame.new(ORIGIN.X + 6 * side, EYE_Y, z)
	local to = CFrame.new(ORIGIN.X - 6 * side, EYE_Y, z)
	local glass = self:addGlass(room, from.Position, Vector3.new(7, 8, 0.4))
	animate(glass, to, rng:NextNumber(1.4, 2.4), true)
end

-- Spinning glass blades, like a fan.
function Patterns.Spinner(self, room, z)
	local center = CFrame.new(ORIGIN.X, EYE_Y, z)
	local duration = self.rng:NextNumber(2, 3.2)
	for _, startAngle in { 0, math.pi / 2 } do
		local from = center * CFrame.Angles(0, 0, startAngle)
		local blade = self:addGlass(room, from.Position, Vector3.new(HEIGHT - 1, 2.5, 0.4))
		blade.CFrame = from
		-- A blade turned half a circle looks identical, so the loop is seamless.
		animate(blade, from * CFrame.Angles(0, 0, math.pi), duration, false)
	end
end

-- A wall of small panes. You need several throws (or multiball) to clear a hole.
-- The eye-level and bottom rows always get an outline; the top row only while
-- the room has few outlines (it's above your head, the rows below show the wall).
function Patterns.Grid(self, room, z)
	for _, x in { -5, 0, 5 } do
		for _, y in { 2.5, 6.5, 10.5 } do
			self:addGlass(room, Vector3.new(ORIGIN.X + x, ORIGIN.Y + y, z), Vector3.new(4.6, 3.8, 0.4), y > 10)
		end
	end
end

-- A see-through detail that belongs to a pane: never hit by balls or crashes
-- (CanQuery off) and gone when the pane shatters (it's parented to the pane).
local function paneDetail(pane, size, cframe, color, material)
	local part = newPart(pane, "Detail", {
		Name = "Detail",
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material,
		CanQuery = false,
	})
	return part
end

-- Thick tinted glass with a metal edge. The first hit only cracks it
-- (TrackBuilder:crackArmor), the second one breaks it. Mega balls and crashing
-- into it break it right away. Sometimes a bonus crystal hides behind it.
function Patterns.ArmoredGlass(self, room, z)
	local rng = self.rng
	local width = rng:NextNumber(9, 11)
	local height = 9
	local x = ORIGIN.X + rng:NextNumber(-1.5, 1.5)
	local center = Vector3.new(x, ORIGIN.Y + 1.5 + height / 2, z)
	local glass = self:addGlass(room, center, Vector3.new(width, height, 0.8))
	glass.Name = "ArmoredGlass"
	glass.Color = ARMOR_COLOR
	glass.Transparency = 0.2
	glass.Reflectance = 0.3
	glass:SetAttribute("Armor", 1) -- extra hits it can take
	-- Metal edge on the side facing the player.
	local front = z + 0.45
	for _, sx in { -1, 1 } do
		paneDetail(glass, Vector3.new(0.35, height, 0.12), CFrame.new(x + sx * (width / 2 - 0.175), center.Y, front), ARMOR_EDGE_COLOR, Enum.Material.DiamondPlate)
	end
	for _, sy in { -1, 1 } do
		paneDetail(glass, Vector3.new(width, 0.35, 0.12), CFrame.new(x, center.Y + sy * (height / 2 - 0.175), front), ARMOR_EDGE_COLOR, Enum.Material.DiamondPlate)
	end
	if rng:NextNumber() < Config.ARMOR_BONUS_CRYSTAL_CHANCE then
		self:addCrystal(room, Vector3.new(x + rng:NextNumber(-2, 2), EYE_Y + rng:NextNumber(-1, 2), z - 3))
	end
end

-- Armored glass was hit: the first hit cracks it (darker, with glowing crack
-- lines from the hit point) and returns true, so the ball bounces off.
-- Returns false when the pane should shatter now (plain glass, or already cracked).
function TrackBuilder:crackArmor(glass, hitPoint)
	local armor = glass:GetAttribute("Armor")
	if type(armor) ~= "number" or armor <= 0 then
		return false
	end
	glass:SetAttribute("Armor", armor - 1)
	glass.Color = ARMOR_CRACKED_COLOR
	glass.Transparency = 0.25
	local cf = glass.CFrame
	local half = glass.Size / 2
	local hit = cf:PointToObjectSpace(hitPoint)
	local hx = math.clamp(hit.X, -half.X * 0.8, half.X * 0.8)
	local hy = math.clamp(hit.Y, -half.Y * 0.8, half.Y * 0.8)
	local front = half.Z + 0.03
	for i = 1, 6 do
		local angle = (i + self.rng:NextNumber(-0.35, 0.35)) * math.pi / 3
		local length = self.rng:NextNumber(1.8, 3.6)
		local endX = math.clamp(hx + math.cos(angle) * length, -half.X, half.X)
		local endY = math.clamp(hy + math.sin(angle) * length, -half.Y, half.Y)
		local a, b = Vector3.new(hx, hy, front), Vector3.new(endX, endY, front)
		local mid = (a + b) / 2
		local span = (b - a).Magnitude
		if span > 0.2 then
			local line = cf * CFrame.new(mid) * CFrame.Angles(0, 0, math.atan2(b.Y - a.Y, b.X - a.X))
			paneDetail(glass, Vector3.new(span, 0.08, 0.05), line, CRACK_COLOR, Enum.Material.Neon)
		end
	end
	return true
end

-- A pane that bobs up and down across your path.
function Patterns.BobbingPane(self, room, z)
	local rng = self.rng
	local x = ORIGIN.X + rng:NextNumber(-1.5, 1.5)
	-- Low: from 2 to 7 studs up, so its top edge is a full stud above your eyes
	-- (it clearly covers them, and the crash check agrees with what you see).
	local low = CFrame.new(x, ORIGIN.Y + 4.5, z)
	local high = CFrame.new(x, ORIGIN.Y + 10.5, z) -- you fly under it
	local startHigh = rng:NextNumber() < 0.5
	local glass = self:addGlass(room, (if startHigh then high else low).Position, Vector3.new(rng:NextNumber(10, 12), 5, 0.4))
	local info = TweenInfo.new(rng:NextNumber(1.1, 1.8), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	TweenService:Create(glass, info, { CFrame = if startHigh then low else high }):Play()
end

-- A pane waiting in a slot in the ceiling (its bottom edge shows, with blinking
-- warning lights and a stripe on the floor). It drops into your path when you
-- get close (TrackBuilder:update). Smash the edge early to stop it.
function Patterns.FallingPane(self, room, z)
	local rng = self.rng
	local width = rng:NextNumber(10, 13)
	local height = 9
	local x = ORIGIN.X + rng:NextNumber(-1, 1)
	local downY = ORIGIN.Y + 1.5 + height / 2
	local upY = ORIGIN.Y + 12.6 + height / 2 -- only the bottom 1.4 studs show below the ceiling
	local glass = self:addGlass(room, Vector3.new(x, upY, z), Vector3.new(width, height, 0.4))
	table.insert(room.fallers, { glass = glass, goal = CFrame.new(x, downY, z), dropped = false })

	-- Warning: blinking lights hanging beside the pane's edge (below anything a
	-- zone hangs on its ceiling, so decor can never hide them) and a dashed
	-- stripe on the floor.
	local blink = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local lightY = upY - height / 2 + 0.15 -- level with the pane's bottom edge
	for _, side in { -1, 1 } do
		local lightX = x + side * (width / 2 + 0.7)
		local rod = newPart(room.folder, "Wall", {
			Name = "WarningRod",
			Size = Vector3.new(0.15, ORIGIN.Y + HEIGHT - lightY, 0.15),
			CFrame = CFrame.new(lightX, (ORIGIN.Y + HEIGHT + lightY) / 2, z),
			Color = Color3.fromRGB(60, 64, 74),
			Material = Enum.Material.Metal,
		})
		rod:SetAttribute("Shell", true)
		local light = newPart(room.folder, "Wall", {
			Name = "Warning",
			Size = Vector3.new(0.8, 0.3, 0.8),
			CFrame = CFrame.new(lightX, lightY, z),
			Color = WARNING_COLOR,
			Material = Enum.Material.Neon,
		})
		light:SetAttribute("Shell", true)
		TweenService:Create(light, blink, { Transparency = 0.85 }):Play()
	end
	for i = -2, 2 do
		local stripe = newPart(room.folder, "Wall", {
			Name = "WarningStripe",
			Size = Vector3.new(width / 6, 0.04, 0.6),
			CFrame = CFrame.new(x + i * width / 5, ORIGIN.Y + 0.03, z),
			Color = WARNING_COLOR,
			Material = Enum.Material.Neon,
		})
		stripe:SetAttribute("Shell", true)
	end
end

-- Six panes on a wheel turning slowly above the middle of the corridor.
-- One pane is marked orange: the wheel turns with the distance you fly, so that
-- pane is always exactly at the bottom, in your way, when you get there. Smash
-- it early (then the empty slot passes over you). Turned by updateMovers.
function Patterns.RingSpinner(self, room, z)
	local rng = self.rng
	local center = CFrame.new(ORIGIN.X, ORIGIN.Y + RING_CENTER_HEIGHT, z)
	local direction = if rng:NextNumber() < 0.5 then -1 else 1
	local target = rng:NextInteger(0, RING_PANES - 1) -- the pane that ends up at the bottom
	local firstSlot = rng:NextInteger(0, RING_SLOTS - 1)
	local targetSlotAngle = (firstSlot + target) * 2 * math.pi / RING_SLOTS
	local ring = {
		center = center,
		-- Ring angle when the camera reaches the wheel: the target pane points down
		-- (a pane at angle 0 points up, so down is pi).
		arrivalAngle = math.pi - targetSlotAngle,
		turnPerStud = rng:NextNumber(RING_TURN_PER_STUD[1], RING_TURN_PER_STUD[2]) * direction,
		lastDistance = nil,
		panes = {},
	}
	ring.angle = ring.arrivalAngle + ring.turnPerStud * SPIN_RANGE -- standing still until in range
	local length = RING_OUTER - RING_INNER
	local offset = CFrame.new(0, RING_INNER + length / 2, 0)
	for i = 0, RING_PANES - 1 do
		local slotAngle = (firstSlot + i) * 2 * math.pi / RING_SLOTS
		local glass = self:addGlass(room, center.Position, Vector3.new(1.6, length, 0.4))
		glass.CFrame = center * CFrame.Angles(0, 0, ring.angle + slotAngle) * offset
		if i == target then
			glass.Color = Config.GLASS_COLOR:Lerp(WARNING_COLOR, RING_TARGET_TINT)
			local outline = glass:FindFirstChild("Outline")
			if outline then
				outline.Color3 = WARNING_COLOR
				outline.SurfaceColor3 = WARNING_COLOR
			end
		end
		table.insert(ring.panes, { glass = glass, slotAngle = slotAngle, offset = offset })
	end
	-- Hub the panes hang on (above your head, so it never gets in the way).
	local hub = newPart(room.folder, "Wall", {
		Name = "RingHub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.4, 1.4),
		CFrame = center * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(60, 64, 74),
		Material = Enum.Material.Metal,
	})
	hub:SetAttribute("Shell", true)
	table.insert(room.rings, ring)
end

-- Metal doors you can't break. Hit the red button to open them.
function Patterns.Door(self, room, z)
	local half = WIDTH / 2
	local doorSize = Vector3.new(half, HEIGHT, 1)
	local y = ORIGIN.Y + HEIGHT / 2
	local door = { open = false, panels = {} }

	for _, side in { -1, 1 } do
		local panel = newPart(room.folder, "Door", {
			Name = "Door",
			Size = doorSize,
			CFrame = CFrame.new(ORIGIN.X + side * half / 2, y, z),
			Material = Enum.Material.DiamondPlate,
			Color = Config.DOOR_COLOR,
		})
		panel:SetAttribute("Side", side)
		table.insert(door.panels, panel)
		self.doorOf[panel] = door
	end

	local buttonX = ORIGIN.X + self.rng:NextNumber(-5, 5)
	local buttonY = ORIGIN.Y + self.rng:NextNumber(4, HEIGHT - 4)
	door.button = newPart(room.folder, "Button", {
		Name = "Button",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 3, 3),
		CFrame = CFrame.new(buttonX, buttonY, z + 0.7) * CFrame.Angles(0, math.rad(90), 0),
		Material = Enum.Material.Neon,
		Color = Config.BUTTON_COLOR,
	})
	self.doorOf[door.button] = door
	table.insert(room.doors, door)
end

function TrackBuilder:openDoor(door)
	if door.open then
		return
	end
	door.open = true
	self.hazardsDirty = true
	-- The button pops (quick swell, then shrinks away) so it doesn't stay
	-- floating in the middle of the path once the doors slide open.
	local button = door.button
	button.Color = Color3.fromRGB(80, 255, 120)
	button.CanQuery = false
	local swell = TweenService:Create(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = button.Size * 1.4,
	})
	local vanish = TweenService:Create(button, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
		Size = Vector3.new(0.05, 0.05, 0.05),
		Transparency = 1,
	})
	swell.Completed:Connect(function()
		vanish:Play()
	end)
	vanish.Completed:Connect(function()
		button:Destroy()
	end)
	swell:Play()

	for _, panel in door.panels do
		local side = panel:GetAttribute("Side")
		local goal = panel.CFrame + Vector3.new(side * WIDTH / 2, 0, 0)
		TweenService:Create(panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { CFrame = goal }):Play()
	end
end

-- Returns the door a button or door panel belongs to.
function TrackBuilder:doorFor(part)
	return self.doorOf[part]
end

-- One group of obstacles at depth z, picked from what this zone allows.
function TrackBuilder:addObstacle(room, z, zone)
	local patterns = patternsForZone(zone)
	local name = patterns[self.rng:NextInteger(1, #patterns)]
	local glassBefore, doorsBefore = #room.glass, #room.doors
	Patterns[name](self, room, z)

	-- Label what was just built so first-time tips know what they're looking at.
	for i = glassBefore + 1, #room.glass do
		room.glass[i]:SetAttribute("Pattern", name)
	end
	for i = doorsBefore + 1, #room.doors do
		for _, panel in room.doors[i].panels do
			panel:SetAttribute("Pattern", name)
		end
	end
end

-- The first-run tutorial: one simple lesson per room. Each lesson's target is
-- remembered so the Tutorial module can slow time and point at it.
function TrackBuilder:buildTutorialRoom(room, roomIndex, startZ)
	local step = table.find(Config.TUTORIAL_ROOMS, roomIndex)
	if step == 1 then
		-- Lesson 1: a single pane right in front of you.
		self.tutorialTargets[1] = self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, startZ - 40), Vector3.new(8, 8, 0.4))
	elseif step == 2 then
		-- Lesson 2: a crystal, then an easy pane.
		self:addCrystal(room, Vector3.new(ORIGIN.X + 2, EYE_Y + 1, startZ - 30))
		self.tutorialTargets[2] = room.crystals[#room.crystals]
		self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, startZ - 62), Vector3.new(8, 8, 0.4))
	elseif step == 3 then
		-- Lesson 3: a full wall you must break or crash into.
		self.tutorialTargets[3] =
			self:addGlass(room, Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT / 2, startZ - 40), Vector3.new(WIDTH, HEIGHT, 0.4))
		self:addCrystal(room, Vector3.new(ORIGIN.X - 4, EYE_Y - 1, startZ - 55))
	end
end

-- Step 1: the room's shell plus everything you can crash into or collect.
function TrackBuilder:buildShell(roomIndex)
	local theme = TrackBuilder.themeFor(roomIndex)
	local startZ = TrackBuilder.roomStartZ(roomIndex)
	local centerZ = startZ - LENGTH / 2
	local rng = self.rng

	local zone = roomIndex // Config.ROOMS_PER_CHECKPOINT
	local isZoneStart = roomIndex % Config.ROOMS_PER_CHECKPOINT == 0

	-- The folder goes into the world now and fills up over the next frames
	-- (see the notes at the top).
	local folder = Instance.new("Folder")
	folder.Name = "Room" .. roomIndex
	folder.Parent = self.folder
	-- fallers: FallingPanes still waiting to drop; rings: RingSpinners to turn (both in update).
	-- outlines: the glass outlines (SelectionBoxes), shown once the room is near (setOutlinesNear).
	local room = {
		folder = folder,
		theme = theme,
		glass = {},
		doors = {},
		crystals = {},
		fallers = {},
		rings = {},
		outlines = {},
		outlinesOn = self.outlineRoom ~= nil and roomIndex <= self.outlineRoom + OUTLINE_ROOMS,
		finished = false,
	}
	self.rooms[roomIndex] = room

	-- Shell parts collide so glass shards can bounce off the floor and walls.
	-- Real surface materials per zone instead of flat plastic.
	local surfaces = SURFACES[theme.Style] or SURFACES.Lab
	local wallProps = { Color = theme.Wall, Material = surfaces.Wall, CanCollide = true }
	-- Shell parts are marked so balls never knock them loose.
	local function shellPart(props)
		newPart(folder, "Wall", props):SetAttribute("Shell", true)
	end
	local function wall(size, position, material, color)
		local props = table.clone(wallProps)
		props.Size = size
		props.CFrame = CFrame.new(position)
		props.Material = material or props.Material
		props.Color = color or props.Color
		shellPart(props)
	end
	local floorColor = theme.Wall:Lerp(surfaces.FloorTint, surfaces.FloorTintAmount)
	wall(Vector3.new(WIDTH, 1, LENGTH), Vector3.new(ORIGIN.X, ORIGIN.Y - 0.5, centerZ), surfaces.Floor, floorColor)
	wall(Vector3.new(WIDTH, 1, LENGTH), Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT + 0.5, centerZ), surfaces.Ceiling)
	wall(Vector3.new(1, HEIGHT, LENGTH), Vector3.new(ORIGIN.X - WIDTH / 2 - 0.5, ORIGIN.Y + HEIGHT / 2, centerZ))
	wall(Vector3.new(1, HEIGHT, LENGTH), Vector3.new(ORIGIN.X + WIDTH / 2 + 0.5, ORIGIN.Y + HEIGHT / 2, centerZ))

	-- Glowing door frame at the start of each room gives a sense of speed.
	local accent = { Color = theme.Accent, Material = Enum.Material.Neon }
	local function trim(size, position)
		local props = table.clone(accent)
		props.Size = size
		props.CFrame = CFrame.new(position)
		shellPart(props)
	end
	trim(Vector3.new(WIDTH, 0.4, 0.4), Vector3.new(ORIGIN.X, ORIGIN.Y + 0.2, startZ))
	trim(Vector3.new(WIDTH, 0.4, 0.4), Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT - 0.2, startZ))
	trim(Vector3.new(0.4, HEIGHT, 0.4), Vector3.new(ORIGIN.X - WIDTH / 2 + 0.2, ORIGIN.Y + HEIGHT / 2, startZ))
	trim(Vector3.new(0.4, HEIGHT, 0.4), Vector3.new(ORIGIN.X + WIDTH / 2 - 0.2, ORIGIN.Y + HEIGHT / 2, startZ))

	-- Glowing strips along the floor edges.
	for _, side in { -1, 1 } do
		trim(Vector3.new(0.3, 0.15, LENGTH), Vector3.new(ORIGIN.X + side * (WIDTH / 2 - 0.4), ORIGIN.Y + 0.08, centerZ))
	end

	-- Ribs along the walls every 10 studs.
	for ribZ = startZ - 10, startZ - LENGTH + 1, -10 do
		for _, side in { -1, 1 } do
			local props = table.clone(wallProps)
			props.Size = Vector3.new(0.6, HEIGHT, 1.2)
			props.CFrame = CFrame.new(ORIGIN.X + side * (WIDTH / 2 - 0.3), ORIGIN.Y + HEIGHT / 2, ribZ)
			props.Color = theme.Wall:Lerp(Color3.new(0, 0, 0), 0.12)
			shellPart(props)
		end
	end

	-- Big double gate marks the start of every new zone.
	if isZoneStart then
		for _, offset in { 0, -2 } do
			trim(Vector3.new(WIDTH, 1, 1), Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT - 0.5, startZ + offset))
			trim(Vector3.new(1, HEIGHT, 1), Vector3.new(ORIGIN.X - WIDTH / 2 + 0.5, ORIGIN.Y + HEIGHT / 2, startZ + offset))
			trim(Vector3.new(1, HEIGHT, 1), Vector3.new(ORIGIN.X + WIDTH / 2 - 0.5, ORIGIN.Y + HEIGHT / 2, startZ + offset))
		end
	end

	if self.tutorial and table.find(Config.TUTORIAL_ROOMS, roomIndex) then
		self:buildTutorialRoom(room, roomIndex, startZ)
	elseif roomIndex >= Config.SAFE_ROOMS and not isZoneStart then
		-- Difficulty climbs inside each zone and keeps climbing zone to zone
		-- (Config.difficultyFor). More difficulty = more obstacle groups, up to 4.
		-- The 4th only comes in the endless zones after the designed ones (ZONE 10+),
		-- and then the groups are 20 studs apart (MIN_GROUP_SPACING), never closer.
		local difficulty = Config.difficultyFor(zone, roomIndex % Config.ROOMS_PER_CHECKPOINT)

		local groups = 1
		if rng:NextNumber() < difficulty then
			groups += 1
		end
		if rng:NextNumber() < difficulty * 0.6 then
			groups += 1
		end
		if zone >= #Config.ZoneDifficulty and rng:NextNumber() < (difficulty - 1) * 0.6 then
			groups += 1
		end
		-- Evenly spread (1 group: the middle; 3 groups: 20/40/60), centered in the room.
		local spacing = math.max(LENGTH / (groups + 1), MIN_GROUP_SPACING)
		local first = (LENGTH - spacing * (groups - 1)) / 2
		for group = 1, groups do
			self:addObstacle(room, startZ - (first + spacing * (group - 1)), zone)
		end

		-- Fewer crystals in later zones (Config.ZoneCrystals), so every ball counts.
		local crystalRange = Config.ZoneCrystals[math.min(zone + 1, #Config.ZoneCrystals)]
		for _ = 1, rng:NextInteger(crystalRange[1], crystalRange[2]) do
			local position = Vector3.new(
				ORIGIN.X + rng:NextNumber(-7, 7),
				ORIGIN.Y + rng:NextNumber(3, HEIGHT - 3),
				startZ - rng:NextNumber(10, LENGTH - 10)
			)
			self:addCrystal(room, position)
		end
	end

	-- Glass, doors and crystals all exist now: crash checks can see them.
	self.hazardsDirty = true

	return room,
		{
			roomIndex = roomIndex,
			zone = zone,
			theme = theme,
			startZ = startZ,
			isZoneStart = isZoneStart,
			rng = rng,
			low = LightingFx.isLow(), -- Low graphics: Decor skips its little animations
		}
end

-- The whole build of one room, run inside its coroutine (pauses in newPart).
function TrackBuilder:buildRoomSteps(roomIndex)
	local room, info = self:buildShell(roomIndex)
	Decor.decorate(self, room, info)
	-- Real lights from the room's glowing parts, shadows from decorations.
	LightingFx.lightRoom(room.folder, info.theme, pauseIfOverBudget)
	room.finished = true
end

-- Adds a room to the build queue (rooms are queued in order, nearest first).
function TrackBuilder:queueRoom(roomIndex)
	local job = { roomIndex = roomIndex, done = false }
	job.thread = coroutine.create(function()
		self:buildRoomSteps(roomIndex)
	end)
	table.insert(self.buildQueue, job)
end

-- Continues a room's build until it finishes or `deadline` (os.clock time) passes.
function TrackBuilder:resumeJob(job, deadline)
	buildThread, buildDeadline = job.thread, deadline
	local ok, err = coroutine.resume(job.thread)
	buildThread, buildDeadline = nil, math.huge
	if not ok then
		-- A bug in the build code: report it and move on (the room stays half built).
		warn("[TrackBuilder] room " .. job.roomIndex .. " failed to build: " .. debug.traceback(job.thread, tostring(err)))
	end
	if coroutine.status(job.thread) == "dead" then
		job.done = true
	end
end

-- Builds a whole room right now.
function TrackBuilder:buildRoom(roomIndex)
	self:queueRoom(roomIndex)
	self:finishRoomsUpTo(roomIndex)
end

-- Finishes every queued room up to lastRoomIndex, right now (no time limit).
function TrackBuilder:finishRoomsUpTo(lastRoomIndex)
	local queue = self.buildQueue
	while queue[1] and queue[1].roomIndex <= lastRoomIndex do
		self:resumeJob(queue[1], math.huge)
		table.remove(queue, 1)
	end
end

-- Queues every room that should be building by now.
function TrackBuilder:queueAhead(cameraZ)
	while TrackBuilder.roomStartZ(self.nextRoom) > cameraZ - BUILD_AHEAD do
		self:queueRoom(self.nextRoom)
		self.nextRoom += 1
	end
end

-- Call once right after new(): the room the camera starts in and the next one
-- are built completely now (it's the start of a run, a short pause is fine).
function TrackBuilder:warmUp(cameraZ)
	self:queueAhead(cameraZ)
	self:finishRoomsUpTo(TrackBuilder.roomAt(cameraZ) + 1)
	self.warmedUp = true
	self:update(cameraZ, 0)
end

function TrackBuilder.roomAt(z)
	return math.max(0, (ORIGIN.Z - z) // LENGTH)
end

-- Removes a few parts of the rooms in the trash, within `budget` seconds.
function TrackBuilder:emptyTrash(budget)
	local trash = self.trash
	local deadline = os.clock() + budget
	while trash[1] and os.clock() < deadline do
		local entry = trash[1]
		if not entry.children then
			entry.children = entry.folder:GetChildren()
			entry.index = 0
		end
		local children = entry.children
		-- A handful at a time between clock checks.
		for _ = 1, 4 do
			local i = entry.index + 1
			local child = children[i]
			if child == nil then
				break
			end
			entry.index = i
			child:Destroy()
		end
		if entry.index >= #children then
			entry.folder:Destroy() -- empty now, so this is cheap
			table.remove(trash, 1)
		end
	end
end

-- Shadow-casting lights only in the room the camera is in and the next one.
function TrackBuilder:updateShadowRooms(cameraZ, force)
	local current = TrackBuilder.roomAt(cameraZ)
	if current == self.shadowRoom and not force then
		return
	end
	self.shadowRoom = current
	local here = self.rooms[current]
	local nextRoom = if Config.SHADOW_LIGHT_ROOMS >= 2 then self.rooms[current + 1] else nil
	LightingFx.setShadowRooms(here and here.folder, nextRoom and nextRoom.folder)
end

-- FallingPanes drop when the camera gets close; RingSpinners in view turn.
-- Only finished rooms: a pane still being built has no final CFrame yet.
function TrackBuilder:updateMovers(cameraZ, dt)
	for roomIndex, room in self.rooms do
		if not room.finished then
			continue
		end
		local startZ = TrackBuilder.roomStartZ(roomIndex)
		if startZ - LENGTH > cameraZ or startZ < cameraZ - SPIN_RANGE then
			continue -- behind the camera, or too far ahead to see
		end
		for _, faller in room.fallers do
			local glass = faller.glass
			if not faller.dropped and glass.Parent and cameraZ - glass.Position.Z < FALL_TRIGGER_DISTANCE then
				faller.dropped = true
				local info = TweenInfo.new(FALL_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				TweenService:Create(glass, info, { CFrame = faller.goal }):Play()
			end
		end
		for _, ring in room.rings do
			-- Angle from the distance still to fly (0 = the camera is at the wheel).
			local distance = math.clamp(cameraZ - ring.center.Position.Z, 0, SPIN_RANGE)
			if distance ~= ring.lastDistance then
				ring.lastDistance = distance
				ring.angle = ring.arrivalAngle + ring.turnPerStud * distance
				for _, pane in ring.panes do
					local glass = pane.glass
					if glass.Parent then
						glass.CFrame = ring.center * CFrame.Angles(0, 0, ring.angle + pane.slotAngle) * pane.offset
					end
				end
			end
		end
	end
end

-- Call every frame with the camera's Z position.
function TrackBuilder:update(cameraZ, dt)
	local frameStart = os.clock()
	local low = LightingFx.isLow()

	-- Spin the crystals close enough to see (rooms ahead, within CRYSTAL_SPIN_RANGE).
	if dt > 0 then
		local spin = CFrame.Angles(0, dt * 2, 0)
		local spinRange = Config.CRYSTAL_SPIN_RANGE
		for roomIndex, room in self.rooms do
			local startZ = TrackBuilder.roomStartZ(roomIndex)
			if startZ - LENGTH < cameraZ and startZ > cameraZ - spinRange then
				for _, crystal in room.crystals do
					if crystal.Parent and crystal.CanQuery then
						crystal.CFrame = crystal.CFrame * spin
					end
				end
			end
		end
	end

	self:updateMovers(cameraZ, dt)

	self:queueAhead(cameraZ)
	self:setOutlinesNear(cameraZ)

	-- Safety net: never let the camera reach an unfinished room.
	local queue = self.buildQueue
	while queue[1] and TrackBuilder.roomStartZ(queue[1].roomIndex) > cameraZ - Config.ROOM_FORCE_DISTANCE do
		if IS_STUDIO and self.warmedUp then
			warn(
				"[TrackBuilder] room "
					.. queue[1].roomIndex
					.. " was not finished in time and was built in one frame (raise ROOM_BUILD_BUDGET?)"
			)
		end
		self:resumeJob(queue[1], math.huge)
		table.remove(queue, 1)
	end

	-- Rooms ahead: only while this frame's build time lasts. Twice the time
	-- when the room being built is getting close (slow device).
	local budget = if low then Config.LOW_ROOM_BUILD_BUDGET else Config.ROOM_BUILD_BUDGET
	if queue[1] and TrackBuilder.roomStartZ(queue[1].roomIndex) > cameraZ - CATCH_UP_DISTANCE then
		budget *= 2
	end
	local deadline = frameStart + budget
	while queue[1] and os.clock() < deadline do
		self:resumeJob(queue[1], deadline)
		if queue[1].done then
			table.remove(queue, 1)
		end
	end

	-- Rooms behind the camera go to the trash...
	for roomIndex, room in self.rooms do
		local endZ = TrackBuilder.roomStartZ(roomIndex) - LENGTH
		if endZ > cameraZ + 10 then
			self.rooms[roomIndex] = nil
			self.hazardsDirty = true
			table.insert(self.trash, { folder = room.folder })
		end
	end
	-- ...which is emptied a little every frame.
	self:emptyTrash(if low then Config.LOW_ROOM_TEARDOWN_BUDGET else Config.ROOM_TEARDOWN_BUDGET)

	self:updateShadowRooms(cameraZ, false)
end

-- Something you can crash into changed (glass broken). hazards() rebuilds its list next time.
function TrackBuilder:markHazardsChanged()
	self.hazardsDirty = true
end

-- Everything you can crash into: unbroken glass and closed doors.
-- The list is cached and only rebuilt when something changed (a room was
-- added or removed, glass broke, a door opened), so calling this every frame
-- costs nothing. Don't change the returned table. Entries can go stale within
-- a frame (glass broken mid-loop): check hazard.Parent / door.open as before.
function TrackBuilder:hazards()
	local result = self.hazardList
	if not self.hazardsDirty then
		return result
	end
	self.hazardsDirty = false
	table.clear(result)
	for _, room in self.rooms do
		for _, glass in room.glass do
			if glass.Parent then
				table.insert(result, glass)
			end
		end
		for _, door in room.doors do
			if not door.open then
				for _, panel in door.panels do
					table.insert(result, panel)
				end
			end
		end
	end
	return result
end

function TrackBuilder:destroy()
	self.folder:Destroy()
end

return TrackBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--[[
	First-run tutorial and first-time tips.

	Tutorial (first run only): rooms 1-3 each teach one thing. As the lesson's
	target gets close, time slows almost to a stop, a card explains what to do
	and a ring points at the target. Doing it resumes the run. Crashes during
	the tutorial are free. A SKIP button ends it at any time.

	Tips: the first time a new obstacle type shows up (doors, moving glass...),
	a short card explains it once, ever. Seen tips are saved on the server.

	Drawn in the game's blueprint style: paper card, ink outline, hard shadow.

	Layout follows UI.luau: the ScreenGui uses CoreUISafeInsets (nothing under
	Roblox's top bar or a notch). The SKIP button sits under the HUD's distance
	plate; the card sits under the balls plate when the screen is tall enough,
	otherwise (phones) at the bottom between the corner buttons, so it never
	covers the middle of the screen where the targets are.
	On a controller, Y skips (and SKIP is selectable like any other button).
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Tutorial = {}

local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local ACCENT = Color3.fromRGB(90, 200, 255)
local DANGER = Color3.fromRGB(235, 60, 60)

local SLOW_DISTANCE = 34 -- studs before the target where time starts slowing
local FROZEN_DISTANCE = 18 -- closest the camera gets while waiting
local SLOWEST = 0.08
local TIP_SECONDS = 3.2
local TIP_SCAN_INTERVAL = 0.25
local TIP_DISTANCE = 45

-- Mirrors of UI.luau's HUD layout numbers (600x340 sheet, HUD plates at 0.85),
-- so the card and SKIP button can sit just under the HUD plates.
local REF_W, REF_H = 600, 340
local SCALE_MIN, SCALE_MAX = 0.8, 2
local HUD_SCALE = 0.85
local EDGE = 12
local HUD_TOP = EDGE - 4
local BALLS_BLOCK_H = 144 -- balls plate + controller hint + boost rail
local DISTANCE_PLATE_H = 62
local CORNER_BUTTON_W = 122 -- ball pack (bottom-right) / shield (bottom-left)
local CARD_H = 74
local CARD_SHADOW = 5
local SKIP_ACTION = "ShatterRunSkipTutorial"

-- How the player is playing right now: "gamepad", "touch" or "mouse".
-- Asked at lesson time (not at load), so plugging in a controller mid-session counts.
local function inputKind()
	local last = UserInputService:GetLastInputType()
	if string.sub(last.Name, 1, 7) == "Gamepad" then
		return "gamepad"
	elseif last == Enum.UserInputType.Touch then
		return "touch"
	elseif
		last == Enum.UserInputType.Keyboard
		or last == Enum.UserInputType.MouseMovement
		or last == Enum.UserInputType.MouseButton1
		or last == Enum.UserInputType.MouseButton2
		or last == Enum.UserInputType.MouseWheel
	then
		return "mouse"
	end
	-- No telling input yet (or gyro etc.): guess from the device.
	if GuiService:IsTenFootInterface() then
		return "gamepad"
	elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return "touch"
	end
	return "mouse"
end

local THROW_TITLES = { gamepad = "PRESS R2 TO THROW", touch = "TAP TO THROW", mouse = "CLICK TO THROW" }

local LESSONS = {
	{
		title = function()
			return THROW_TITLES[inputKind()]
		end,
		body = "AIM AT THE GLASS AND SMASH IT",
	},
	{ title = "HIT THE CRYSTAL", body = "EVERY CRYSTAL GIVES YOU +" .. Config.CRYSTAL_REWARD .. " BALLS" },
	{ title = "DON'T CRASH!", body = "FLYING INTO GLASS COSTS " .. Config.CRASH_PENALTY .. " BALLS - BREAK IT FIRST" },
}

-- State --------------------------------------------------------------------

local active = false
local step = 0
local track
local scale = 1
local finishedThisSession = false
local seenThisSession = {}
local tipCooldown = 0
local tipScan = 0
local tipToken
local cardHoldUntil = 0 -- os.clock() time until which the card must stay up
local cardRest = UDim2.new(0.5, 0, 0, 92) -- where the card sits (set by layoutUi)
local cardSlide = -22 -- it slides in from this many px above (top) or below (bottom)
local skipBound = false

-- UI -------------------------------------------------------------------------

local gui, pointerGui, card, cardTitle, cardBody, ring, skipButton

local function new(className, props, children)
	local instance = Instance.new(className)
	for name, value in props do
		if name ~= "Parent" then
			instance[name] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

-- Puts the SKIP button under the distance plate and the card where it covers
-- the least: under the balls plate when there is room, else at the bottom.
local function layoutUi()
	local size = gui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return
	end
	local sheet = math.clamp(math.min(size.X / REF_W, size.Y / REF_H), SCALE_MIN, SCALE_MAX)
	local hud = sheet * HUD_SCALE

	skipButton.Position = UDim2.new(1, -EDGE, 0, math.floor(HUD_TOP + DISTANCE_PLATE_H * hud + 8))

	local top = math.floor(HUD_TOP + BALLS_BLOCK_H * hud + 10)
	local width
	if top + CARD_H <= size.Y * 0.4 then
		width = math.clamp(size.X * 0.7, 260, 460)
		card.AnchorPoint = Vector2.new(0.5, 0)
		cardRest = UDim2.new(0.5, 0, 0, top)
		cardSlide = -22
	else
		local corner = EDGE + CORNER_BUTTON_W * sheet + 8
		width = math.clamp(size.X - corner * 2 - CARD_SHADOW, 240, 460)
		card.AnchorPoint = Vector2.new(0.5, 1)
		cardRest = UDim2.new(0.5, 0, 1, -(EDGE + CARD_SHADOW))
		cardSlide = 22
	end
	card.Size = UDim2.fromOffset(math.floor(width), CARD_H)
	card.Position = cardRest
end

local function refreshSkipLabel()
	if skipButton then
		skipButton.Text = if inputKind() == "gamepad" then "Y  SKIP TUTORIAL" else "SKIP TUTORIAL"
	end
end

-- SKIP is shown (and Y bound to it) only while the tutorial is running and not paused.
local function setSkipShown(shown)
	skipButton.Visible = shown
	if shown then
		refreshSkipLabel()
	end
	if shown ~= skipBound then
		skipBound = shown
		if shown then
			ContextActionService:BindAction(SKIP_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					Tutorial.finish(true)
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.KeyCode.ButtonY)
		else
			ContextActionService:UnbindAction(SKIP_ACTION)
		end
	end
end

local function buildUi()
	-- CoreUISafeInsets keeps the card and SKIP clear of Roblox's top bar and notches.
	gui = new("ScreenGui", {
		Name = "TutorialHints",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- The pointer covers the whole screen (no insets), so its coordinates are
	-- exactly what camera:WorldToViewportPoint returns.
	pointerGui = new("ScreenGui", {
		Name = "TutorialPointer",
		ResetOnSpawn = false,
		DisplayOrder = 19,
		ScreenInsets = Enum.ScreenInsets.None,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Instruction card: placed by layoutUi, clear of the middle of the screen.
	local holder = new("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = cardRest,
		Size = UDim2.fromOffset(400, CARD_H),
		BackgroundTransparency = 1,
		Active = false,
		Visible = false,
		Parent = gui,
	})
	-- Hard ink shadow, then the paper card on top.
	new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(CARD_SHADOW, CARD_SHADOW),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Active = false,
		Parent = holder,
	})
	card = new("Frame", {
		Name = "Paper",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		Active = false,
		Parent = holder,
	}, {
		new("UIStroke", { Thickness = 2, Color = INK }),
		new("Frame", {
			Name = "Accent",
			Size = UDim2.new(0, 6, 1, 0),
			BackgroundColor3 = ACCENT,
			BorderSizePixel = 0,
		}),
	})
	cardTitle = new("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(18, 8),
		Size = UDim2.new(1, -30, 0, 32),
		BackgroundTransparency = 1,
		Font = Enum.Font.Michroma,
		TextColor3 = INK,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { new("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 12 }) })
	cardBody = new("TextLabel", {
		Name = "Body",
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -30, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.RobotoMono,
		TextColor3 = INK,
		TextTransparency = 0.15,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { new("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8 }) })
	card = holder

	-- Pointer ring over the target (square ring = blueprint style, not a circle).
	ring = new("Frame", {
		Name = "Pointer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(84, 84),
		Rotation = 45,
		BackgroundTransparency = 1,
		Active = false,
		Visible = false,
		Parent = pointerGui,
	}, {
		new("UIStroke", { Thickness = 4, Color = ACCENT }),
	})

	-- 150x44: a full-size tap target; selectable so a controller can reach it too
	-- (it uses the blueprint selection box UI.luau sets on PlayerGui).
	skipButton = new("TextButton", {
		Name = "Skip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -EDGE, 0, 70),
		Size = UDim2.fromOffset(150, 44),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Selectable = true,
		Font = Enum.Font.RobotoMono,
		Text = "SKIP TUTORIAL",
		TextColor3 = INK,
		TextScaled = true,
		Visible = false,
		Parent = gui,
	}, {
		new("UIStroke", { Thickness = 2, Color = INK, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		new("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8 }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
	skipButton.Activated:Connect(function()
		Tutorial.finish(true)
	end)

	layoutUi()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutUi)
	UserInputService.LastInputTypeChanged:Connect(function()
		if skipButton.Visible then
			refreshSkipLabel()
		end
	end)
end

local function showCard(title, body, color)
	cardTitle.Text = title
	cardBody.Text = body
	card.Paper.Accent.BackgroundColor3 = color or ACCENT
	if not card.Visible then
		card.Visible = true
		card.Position = cardRest + UDim2.fromOffset(0, cardSlide)
		TweenService:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = cardRest }):Play()
	end
end

local function hideCard()
	card.Visible = false
	ring.Visible = false
end

-- Cards that hide themselves later (tips, "YOU'RE READY!") use this token so
-- an old timer never hides a newer card.
local function hideLater(seconds)
	local token = {}
	tipToken = token
	task.delay(seconds, function()
		if tipToken == token and not active then
			hideCard()
		end
	end)
end

local function remember(action, argument)
	task.spawn(function()
		pcall(function()
			Remotes.ShopRequest:InvokeServer(action, argument)
		end)
	end)
end

-- Tutorial -----------------------------------------------------------------

-- Only when the server has loaded the player and says they haven't done it.
function Tutorial.isNeeded()
	return not finishedThisSession and player:GetAttribute("TutorialDone") == false
end

function Tutorial.start(trackBuilder)
	if not gui then
		buildUi()
	end
	track = trackBuilder
	active = true
	step = 1
	scale = 1
	setSkipShown(true)
end

function Tutorial.isActive()
	return active
end

-- Where the lesson's pointer ring is right now (viewport pixels) and how far it
-- reaches from its center, or nil when it isn't showing. The ball in the
-- player's hand (HeldBall.luau) steps aside rather than cover the target.
function Tutorial.pointerTarget()
	if not active or not ring or not ring.Visible then
		return nil
	end
	local position = ring.Position
	-- The ring is a square turned 45 degrees: its corners reach ~0.71 x its size.
	return Vector2.new(position.X.Offset, position.Y.Offset), ring.Size.X.Offset * 0.71
end

function Tutorial.finish(skipped)
	if not active then
		return
	end
	active = false
	finishedThisSession = true
	scale = 1
	setSkipShown(false)
	ring.Visible = false
	remember("FinishTutorial")

	if skipped then
		hideCard()
	else
		showCard("YOU'RE READY!", "GO AS FAR AS YOU CAN. GOOD LUCK!", Color3.fromRGB(80, 220, 120))
		tipCooldown = 2.5 -- don't cover it with a tip straight away
		hideLater(2)
	end
end

-- Game over screen: hide the tutorial (the SKIP button would sit on top of
-- the game over buttons). A revive shows it again.
function Tutorial.setPaused(paused)
	if not gui or not active then
		return
	end
	setSkipShown(not paused)
	if paused then
		hideCard()
	end
end

-- A lesson is done once its target is broken (gone) or collected.
local function targetDone(target)
	return target == nil or target.Parent == nil or not target.CanQuery
end

-- Call every frame while running. Returns the world time multiplier.
function Tutorial.update(dt, cameraZ)
	if not active then
		return 1
	end

	local target = track.tutorialTargets[step]
	-- Done (broken/collected), or missed and already behind the camera: next lesson.
	if step <= #LESSONS and target ~= nil then
		local passed = target.Parent ~= nil and cameraZ - target.Position.Z < -2
		if targetDone(target) or passed then
			step += 1
			target = track.tutorialTargets[step]
		end
	end
	if step > #LESSONS then
		Tutorial.finish(false)
		return 1
	end

	local wanted = 1
	local showing = false
	if target and target.Parent then
		local ahead = cameraZ - target.Position.Z
		if ahead > 0 and ahead < SLOW_DISTANCE then
			showing = true
			local lesson = LESSONS[step]
			local title = if type(lesson.title) == "function" then lesson.title() else lesson.title
			showCard(title, lesson.body, if step == 3 then DANGER else ACCENT)

			-- Ease toward almost-frozen; fully slow once close.
			local t = math.clamp((SLOW_DISTANCE - ahead) / (SLOW_DISTANCE - FROZEN_DISTANCE), 0, 1)
			wanted = 1 + (SLOWEST - 1) * t

			-- Point at the target.
			local screen, onScreen = camera:WorldToViewportPoint(target.Position)
			ring.Visible = onScreen
			if onScreen then
				ring.Position = UDim2.fromOffset(screen.X, screen.Y)
				local pulse = 1 + math.sin(os.clock() * 6) * 0.12
				ring.Size = UDim2.fromOffset(84 * pulse, 84 * pulse)
			end
		end
	end
	-- No lesson target close: hide the card and pointer (an "OOPS!" card stays
	-- up for a moment first).
	if not showing then
		ring.Visible = false
		if card.Visible and os.clock() >= cardHoldUntil then
			card.Visible = false
		end
	end

	-- Smooth so the slow-down never snaps.
	scale += (wanted - scale) * math.min(1, dt * 8)
	return scale
end

-- Crashes during the tutorial don't cost balls.
function Tutorial.crashIsFree()
	if not active then
		return false
	end
	showCard("OOPS!", "THAT WOULD HAVE COST " .. Config.CRASH_PENALTY .. " BALLS - THROW EARLIER", DANGER)
	cardHoldUntil = os.clock() + 1.5
	return true
end

-- Tips -----------------------------------------------------------------------

local function seenHints()
	local ok, list = pcall(function()
		return game:GetService("HttpService"):JSONDecode(player:GetAttribute("Hints") or "[]")
	end)
	return if ok and type(list) == "table" then list else {}
end

-- Shows a first-time tip if this player has never seen it.
-- Returns true once there's nothing left to do (shown now, or seen before), false
-- if it couldn't show yet (lesson or another tip on screen, save not loaded).
function Tutorial.tip(hintId)
	local text = Config.Hints[hintId]
	if not text or seenThisSession[hintId] then
		return true
	end
	if active or tipCooldown > 0 or player:GetAttribute("Hints") == nil then
		return false
	end
	if table.find(seenHints(), hintId) then
		seenThisSession[hintId] = true
		return true
	end
	if not gui then
		buildUi()
	end
	seenThisSession[hintId] = true
	tipCooldown = TIP_SECONDS + 0.5
	remember("SeenHint", hintId)

	showCard("NEW!", text, ACCENT)
	hideLater(TIP_SECONDS)
	return true
end

-- Looks ahead for obstacle types the player hasn't been told about yet.
function Tutorial.scanForTips(dt, cameraZ, trackBuilder)
	tipCooldown = math.max(0, tipCooldown - dt)
	tipScan -= dt
	if tipScan > 0 or active or tipCooldown > 0 then
		return
	end
	tipScan = TIP_SCAN_INTERVAL

	for _, hazard in trackBuilder:hazards() do
		local pattern = hazard:GetAttribute("Pattern")
		if pattern and Config.Hints[pattern] and not seenThisSession[pattern] then
			local ahead = cameraZ - hazard.Position.Z
			if ahead > 0 and ahead < TIP_DISTANCE then
				Tutorial.tip(pattern)
				return
			end
		end
	end
end

-- Hides everything (e.g. when going back to the menu).
function Tutorial.reset()
	active = false
	scale = 1
	tipToken = nil
	if gui then
		hideCard()
		setSkipShown(false)
	end
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	All on-screen UI: menu, HUD, game over, toasts and damage effects.

	Look: "Glass Lab" technical annotation laid over the world. Paper panels,
	ink hairlines, sharp corners, hard offset shadows, and one accent color that
	follows the current zone theme (see setTheme). Red is reserved for damage
	and revive.

	Layout is drawn on a 600x340 reference sheet. Every block carries a UIScale
	that is refit whenever the screen changes size, so a 640x360 phone and a
	1080p monitor get the same composition.

	Safe area: the ScreenGui uses CoreUISafeInsets, so nothing we draw can sit
	under Roblox's own top bar (menu / chat / "more" buttons, ~58px tall) or a
	phone notch. Full-screen washes still bleed edge to edge (see `bleed`).
	On a 640x360 phone that leaves about 640x302, so the sheet scales to ~0.89
	and every tappable thing is drawn at least 50 units tall (>= 44px there).

	Gamepad: while the last input is a controller, every screen puts the
	selection on its main button (PLAY, PLAY AGAIN / REVIVE, CLAIM...), B closes
	popovers, and small "A SELECT" style hints appear. The HUD clears the
	selection so the controller's buttons go to the game instead of the UI.

	Settings (gear button on the menu and the run report): sliders, toggles and
	a segmented control that write straight to Settings.luau, which every other
	module listens to. The UI itself follows "flashes" (no red flash / pulsing
	alarm / shield burst when off) and "shake" (no HUD shake when off).

	Robux: the server sets the DataLoaded attribute only after the player's save
	really loaded (DataFailed when it couldn't). Until DataLoaded, every Robux
	button is drawn pressed-flat and a tap only explains why, offers that depend
	on the save (starter pack, season premium, revive, gem top-up) stay hidden,
	and a DataFailed banner asks the player to rejoin before buying.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local BallFx = require(script.Parent.BallFx)
local Settings = require(script.Parent.Settings)

local player = Players.LocalPlayer

local UI = {}
UI.__index = UI

-- Look -----------------------------------------------------------------------
local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local GREY = Color3.fromRGB(112, 108, 100)
local DANGER = Color3.fromRGB(240, 38, 38)

local FONT_NUM = Enum.Font.Michroma -- numbers, titles, buttons
local FONT_LABEL = Enum.Font.RobotoMono -- small uppercase annotation

local REF_W, REF_H = 600, 340
local SCALE_MIN, SCALE_MAX = 0.8, 2
local HUD_SCALE = 0.85 -- HUD plates are drawn a bit smaller than menus
local SHADOW = 4 -- hard shadow offset behind buttons
local EDGE = 12 -- distance from the safe-area edge
local LOW_BALLS = 5
local TAB_H = 50
local FOOTER_H = 18
local MENU_H = 340 -- height of the left menu column (the full reference sheet)
local ZONE_CARD_Y = 0.3 -- zone / level card top, as a fraction of the screen (clear of the HUD plates)
local BACK_ACTION = "ShatterRunUIBack" -- ContextActionService name for gamepad B (only bound while a popover is open)

local ZONE_CARD_TIME = 0.9 -- short: the next glass is already coming
local LEVEL_CARD_TIME = 2.4 -- only away from a run (during one, a level up is a side toast)
local TOAST_TIME = 2
local MAX_TOASTS = 3

local TAB_NAMES = { "PLAY", "MISSIONS", "SEASON", "ZONES", "SHOP" }
local TAB_MISSIONS, TAB_SEASON = 2, 3
local GEM_PACKS = { "GemPack", "GemPackMedium", "GemPackLarge" }
local TAB_SHOP = 5
-- Premium (Robux) balls at the top of SHOP: a spinning 3D preview + picker.
local PREMIUM_CARD_H = 170
local PREMIUM_VIEW = 132 -- the preview square
local PREMIUM_PREVIEW_DIAMETER = 2 -- studs; the camera is placed to fit this
local PREMIUM_CAMERA_DISTANCE = 4.6
local PREMIUM_ORBIT_SPEED = 0.45 -- radians per second the preview camera circles the ball
local PREMIUM_MESH_CHECK = 1 -- seconds between "has the Blender model loaded yet?" checks
-- The equipped ball at the end of the PLAY button.
local MENU_BALL_VIEW = 42 -- the window square (PLAY's face is 50 tall)
local MENU_BALL_SPIN = 0.9 -- radians per second the camera circles it
local MENU_BALL_FLOAT = 0.12 -- studs it bobs up and down
-- The starter offer pops up once per session, the first time the menu opens
-- after a run (never on the very first screen, and never again once closed).
local OFFER_AFTER_MENU_OPENS = 2
local SUMMARY_TIMEOUT = 10 -- game over stops saying "TALLYING" after this
local SEASON_COLUMN_W = 56
local SEASON_COLUMN_GAP = 4
local PASS_ORDER = { "VIP", "Multiball", "Checkpoints" }
local PASS_INFO = {
	VIP = {
		code = "VIP",
		title = "VIP PASS",
		copy = string.format(
			"%dX GEMS + %d EXTRA BALLS EVERY RUN",
			Config.GamePasses.VIP.GemMultiplier or 2,
			Config.GamePasses.VIP.ExtraStartBalls or 0
		),
	},
	Multiball = { code = "x2", title = "MULTIBALL", copy = "NEVER DROP BELOW x2 MULTIBALL" },
	Checkpoints = { code = "CP", title = "CHECKPOINTS", copy = "START FROM ANY ZONE YOU'VE REACHED" },
}

-- Boosts (picked before a run, shown on the HUD while active).
local BOOST_ORDER = Config.BOOST_ORDER or {}
local MAX_PICKS = Config.MAX_BOOSTS_PER_RUN or 3
local LOW_BALLS_OFFER = Config.LOW_BALLS_OFFER or 8
local BOOST_CHIP_H = 50
local BOOST_CHIP_GAP = 1
local BOOST_POP_H = 110
local POP_CLOSE = 50 -- the popover's X is a 50x50 tap area in its top-right corner
local TOPUP_H = 56
local TOPUP_BUY_W = 84
local TOPUP_CLOSE_W = 50
local SHIELD_USED_HOLD = 0.9 -- seconds the HUD shield plate reads USED after a crash
-- HUD boost bar (Config.BOOST_BAR): a column of tap-to-use boosts hanging from
-- the distance plate down the right edge. Clear of the plates, the Ball Pack
-- button (bottom right), the toasts (left) and the hands: those sit lower and
-- further in (Viewmodel LAYOUT), even with Mega Ball's bigger balls on a 4:3
-- tablet, where a column centered at mid height would touch the right hand.
-- Slots are 52 units tall, so >= 44px on a 640x360 phone.
local DIST_PLATE_H = 62 -- the distance plate's height (the bar hangs under it)
local BAR_IDS = Config.BOOST_BAR or {}
local BAR_SLOT_W = 66
local BAR_SLOT_H = 52
local BAR_GAP = 6
local BAR_BLOCK_W = 18 -- the colored mark block on the left of each slot
local BAR_HIDE_TIME = 0.18
local BAR_SHORT = { Magnet = "MAGNET", SlowMo = "SLOW-MO", MegaBall = "MEGA" }
local BAR_NUMBER_KEYS = { "1", "2", "3" } -- keyboard keys, in BAR_IDS order (RunController binds them)
local BAR_PAD_DIRECTIONS = { "Left", "Up", "Right" } -- D-pad, in BAR_IDS order
local TIMED_BOOSTS = { { "Magnet", "magnet" }, { "SlowMo", "slowmo" } } -- { id, setBoosts field }
local EMPTY = table.freeze({})

-- Save state gate for Robux buttons (see the note at the top).
local SAVE_FAILED_TEXT = "YOUR SAVE DIDN'T LOAD - REJOIN BEFORE BUYING"
local SAVE_LOADING_TEXT = "STILL LOADING YOUR SAVE - TRY AGAIN IN A MOMENT"
local SAVE_BANNER_H = 36 -- the DataFailed strip at the bottom of the menu panel
local ROBUX_CALLBACKS = { onBuyProduct = true, onBuyPass = true, onRevive = true }

-- Season premium stops being sold in the last days of a season.
local SEASON_LAST_SALE = 3 * 86400

-- Daily streak: a broken streak's CLAIM asks twice before restarting at day 1,
-- and stays off while a streak saver purchase is on its way.
local RESTART_CONFIRM_TIME = 4 -- seconds the "TAP AGAIN" confirm stays armed
local SAVER_PROMPT_WAIT = 30 -- longest we wait for the Robux prompt to close
local SAVER_GRANT_WAIT = 15 -- after paying, longest we wait for the server to save the streak
local PREMIUM_GRANT_WAIT = 15 -- after paying for a premium ball, longest we wait for the server to unlock it

-- Settings sheet (drawn on the same 600x340 sheet as everything else).
local SETTINGS_W = 520
local SETTINGS_HEADER = 24
local SETTINGS_BODY_H = 296 -- everything under the header; the body scrolls if the screen is shorter
local SETTINGS_ROW = 50 -- every control is a full 50-unit touch target
local SETTINGS_LABEL_W = 96 -- label column on the left of sliders / graphics
local SETTINGS_PCT_W = 52 -- "100%" readout on the right of sliders
local SETTINGS_GEAR_W = 62 -- the gear button next to DAILY / MENU
local SETTINGS_ACTION = "ShatterRunSettingsAdjust" -- gamepad left/right on a slider (only bound while open)
local SLIDER_STEP = 0.1 -- one D-pad press
local SLIDER_REPEAT_DELAY = 0.4 -- holding the D-pad / stick: first repeat...
local SLIDER_REPEAT_EVERY = 0.12 -- ...then this often
local STICK_THRESHOLD = 0.6

local TOAST_KINDS = {
	boost = { tag = "BOOSTS ACTIVE", accent = true },
	gift = { tag = "WELCOME GIFT", accent = true },
	multiball = { tag = "MULTIBALL", accent = true },
	reward = { tag = "REWARD", accent = true },
	level = { tag = "LEVEL UP", accent = true },
	info = { tag = "NOTE", accent = false },
	error = { tag = "ERROR", accent = false, hatch = true },
}

local rng = Random.new()

-- Shared registries (one UI per client) ---------------------------------------

local accentColor = Config.Themes[1].Accent
local accentTargets = {} -- instance -> property (pruned in setTheme once unparented)
local scalers = {} -- { uiScale, multiplier }
local textCaps = {} -- { constraint, label, max, min }
local currentScale = 1

-- Small helpers ----------------------------------------------------------------

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function commas(n)
	local s = tostring(math.floor(tonumber(n) or 0))
	local sign, digits = string.match(s, "^(-?)(%d+)$")
	if not digits then
		return s
	end
	local out = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return sign .. out
end

local function twoDigits(n)
	return string.format("%02d", math.max(0, math.floor(tonumber(n) or 0)))
end

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

local function themeFor(zone)
	return Config.Themes[zone % #Config.Themes + 1]
end

local function ownedSkins()
	local owned = { Default = true, Classic = true }
	local raw = player:GetAttribute("OwnedSkins")
	if type(raw) == "string" then
		local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(list) == "table" then
			for _, id in list do
				if type(id) == "string" then
					owned[id] = true
				end
			end
		end
	end
	return owned
end

local function hasPass(key)
	return player:GetAttribute("Pass_" .. key) == true
end

-- True only once the server says the save really loaded (never on a failed load).
local function saveLoaded()
	return player:GetAttribute("DataLoaded") == true and player:GetAttribute("DataFailed") ~= true
end

local function saveFailed()
	return player:GetAttribute("DataFailed") == true
end

-- When the season ends (0 = no end date set).
local function seasonEnds()
	return tonumber(ReplicatedStorage:GetAttribute("SeasonEnds")) or tonumber(Config.SEASON_ENDS) or 0
end

-- Premium isn't sold once less than SEASON_LAST_SALE is left (or the season is over).
local function seasonSaleClosed(now)
	local ends = seasonEnds()
	return ends > 0 and ends - now < SEASON_LAST_SALE
end

-- Progression data ------------------------------------------------------------------
-- The server mirrors progress to attributes (some as JSON). Any of them may be
-- missing before data loads, so every reader falls back to something safe.

local function decodeJson(raw)
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok then
		return value
	end
	return nil
end

local function attrNumber(name, default)
	local value = tonumber(player:GetAttribute(name))
	if value == nil or value ~= value then
		return default
	end
	return value
end

local function ownedFx()
	local owned = { Classic = true }
	local decoded = decodeJson(player:GetAttribute("OwnedFx"))
	if type(decoded) == "table" then
		for _, id in decoded do
			if type(id) == "string" then
				owned[id] = true
			end
		end
	end
	return owned
end

local function levelInfo()
	local level = math.max(1, math.floor(attrNumber("Level", 1)))
	local needed = math.max(1, math.floor(attrNumber("XPNeeded", Config.xpForLevel(level))))
	local xp = math.clamp(math.floor(attrNumber("XP", 0)), 0, needed)
	return level, xp, needed
end

local function skinName(id)
	local skin = Config.getSkin(id)
	return string.upper(if skin and skin.Id == id then skin.Name else tostring(id))
end

local function fxName(id)
	local fx = Config.getFx(id)
	return string.upper(if fx and fx.Id == id then fx.Name else tostring(id))
end

local function boostInfo(id)
	local boosts = Config.Boosts
	return if type(boosts) == "table" then boosts[id] else nil
end

local function boostName(id)
	local boost = boostInfo(id)
	return if boost and boost.Name then string.upper(boost.Name) else string.upper(tostring(id))
end

-- Boost inventory from the Boosts attribute: { [boostId] = count } (unknown ids dropped).
local function ownedBoosts()
	local counts = {}
	local decoded = decodeJson(player:GetAttribute("Boosts"))
	if type(decoded) == "table" then
		for id, count in decoded do
			if type(id) == "string" and boostInfo(id) then
				local n = tonumber(count)
				counts[id] = if n and n == n then math.max(0, math.floor(n)) else 0
			end
		end
	end
	return counts
end

-- A developer product's id, or 0 when it isn't set up (0 hides that offer).
local function productId(key)
	local product = Config.Products[key]
	return if type(product) == "table" and tonumber(product.Id) then product.Id else 0
end

-- "+70 GEMS", "NEONITE SKIN", "SHATTERBORN SKIN + SUPERNOVA FX"...
local function rewardText(reward)
	if type(reward) ~= "table" then
		return ""
	end
	local parts = {}
	if reward.Gems then
		table.insert(parts, "+" .. commas(reward.Gems) .. " GEMS")
	end
	if reward.Skin then
		table.insert(parts, skinName(reward.Skin) .. " SKIN")
	end
	if reward.Fx then
		table.insert(parts, fxName(reward.Fx) .. " FX")
	end
	if reward.Boost then
		table.insert(parts, boostName(reward.Boost) .. " BOOST")
	end
	if reward.Balls then
		table.insert(parts, "+" .. commas(reward.Balls) .. " BALLS")
	end
	return table.concat(parts, " + ")
end

-- The first level unlock above `level`, or nil once they are all earned.
local function nextUnlock(level)
	local best = nil
	for unlockLevel, reward in Config.LevelUnlocks do
		if unlockLevel > level and (best == nil or unlockLevel < best) then
			best = unlockLevel
		end
	end
	return best, best and Config.LevelUnlocks[best]
end

-- "3D 04H", or hh:mm:ss under a day.
local function longClock(seconds)
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 86400 then
		return string.format("%dD %02dH", seconds // 86400, (seconds % 86400) // 3600)
	end
	return clock(seconds)
end

local function rainbowSequence()
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)))
	end
	return ColorSequence.new(keys)
end

-- Prices are fetched once per id and cached; waiters are called when it lands.
local priceCache = {}
local priceWaiters = {}

local function withPrice(id, infoType, onPrice)
	if not id or id == 0 then
		return
	end
	local key = tostring(infoType) .. ":" .. tostring(id)
	local cached = priceCache[key]
	if cached ~= nil then
		if cached then
			onPrice(cached)
		end
		return
	end
	if priceWaiters[key] then
		table.insert(priceWaiters[key], onPrice)
		return
	end
	priceWaiters[key] = { onPrice }
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
		local price = ok and type(info) == "table" and info.PriceInRobux or false
		priceCache[key] = price
		local waiters = priceWaiters[key]
		priceWaiters[key] = nil
		if price then
			for _, waiter in waiters do
				task.spawn(waiter, price)
			end
		end
	end)
end

-- Builders -------------------------------------------------------------------------

-- Creates an instance. Non-button GuiObjects are never Active, so nothing but
-- real buttons can swallow a tap meant for throwing.
local function new(className, props, children)
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
		if not inst:IsA("GuiButton") then
			inst.Active = false
		end
	end
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function text(props)
	local merged = {
		BackgroundTransparency = 1,
		Font = FONT_LABEL,
		TextColor3 = INK,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}
	for key, value in props do
		merged[key] = value
	end
	return new("TextLabel", merged)
end

local function setAccent(inst, prop)
	inst[prop] = accentColor
	accentTargets[inst] = prop
	return inst
end

local function clearAccent(inst)
	accentTargets[inst] = nil
end

local function fit(guiObject, multiplier)
	local s = new("UIScale", { Scale = currentScale * (multiplier or 1), Parent = guiObject })
	table.insert(scalers, { s, multiplier or 1 })
	return s
end

local function effectiveScale(inst)
	local s = 1
	local node = inst
	while node and not node:IsA("LayerCollector") do
		local scale = node:FindFirstChildOfClass("UIScale")
		if scale then
			s *= scale.Scale
		end
		node = node.Parent
	end
	return s
end

local function applyCap(entry)
	local constraint, label, max, min = entry[1], entry[2], entry[3], entry[4]
	if constraint.Parent == nil then
		return
	end
	constraint.MaxTextSize = math.clamp(math.floor(max * effectiveScale(label) + 0.5), min, 100)
end

-- TextScaled that stops at the designed size (scaled with the sheet), so text
-- only ever shrinks to fit and never balloons on big screens.
local function capText(label, max, min)
	label.TextScaled = true
	local constraint = new("UITextSizeConstraint", { MaxTextSize = max, MinTextSize = min or 7, Parent = label })
	local entry = { constraint, label, max, min or 7 }
	-- Menus rebuild rows often; drop entries for labels that were destroyed.
	if #textCaps > 200 then
		local alive = {}
		for _, existing in textCaps do
			if existing[1].Parent ~= nil then
				table.insert(alive, existing)
			end
		end
		textCaps = alive
	end
	table.insert(textCaps, entry)
	task.defer(applyCap, entry)
	return label
end

local function stroke(parent, thickness, color, transparency)
	return new("UIStroke", {
		Thickness = thickness or 1,
		Color = color or INK,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = parent,
	})
end

local function rule(parent, props)
	local merged = { BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 1) }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	return new("Frame", merged)
end

-- Registration ticks just outside each corner, like print crop marks.
local function cropMarks(parent, len, gap, transparency)
	for _, corner in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local sx, sy = corner[1], corner[2]
		local dx, dy = sx * 2 - 1, sy * 2 - 1
		rule(parent, {
			Name = "Crop",
			BackgroundTransparency = transparency or 0,
			AnchorPoint = Vector2.new(1 - sx, 0.5),
			Position = UDim2.new(sx, dx * gap, sy, 0),
			Size = UDim2.fromOffset(len, 1),
		})
		rule(parent, {
			Name = "Crop",
			BackgroundTransparency = transparency or 0,
			AnchorPoint = Vector2.new(0.5, 1 - sy),
			Position = UDim2.new(sx, 0, sy, dy * gap),
			Size = UDim2.fromOffset(1, len),
		})
	end
end

-- L-shaped viewfinder brackets inside each corner.
local function brackets(parent, len, thickness, transparency)
	for _, corner in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local anchor = Vector2.new(corner[1], corner[2])
		local position = UDim2.fromScale(corner[1], corner[2])
		for _, size in { UDim2.fromOffset(len, thickness), UDim2.fromOffset(thickness, len) } do
			rule(parent, {
				Name = "Bracket",
				BackgroundTransparency = transparency or 0,
				AnchorPoint = anchor,
				Position = position,
				Size = size,
			})
		end
	end
end

-- A solid triangle filling one corner (cx, cy in {0, 1}): the chamfered/cut-corner mark.
-- Built from a square with a hard-stepped diagonal gradient, so it needs no image.
local function notch(parent, size, cx, cy, color)
	local frame = new("Frame", {
		Name = "Notch",
		AnchorPoint = Vector2.new(cx, cy),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or INK,
		Parent = parent,
	})
	if color == nil then
		setAccent(frame, "BackgroundColor3")
	end
	new("UIGradient", {
		Rotation = math.deg(math.atan2(cy * 2 - 1, cx * 2 - 1)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.499, 1),
			NumberSequenceKeypoint.new(0.501, 0),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = frame,
	})
	return frame
end

-- Diagonal hazard hatching from a striped transparency gradient.
local function hatch(parent, props, color, transparency, stripes)
	local frame = new("Frame", props)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Parent = parent
	local keys = {}
	local count = stripes or 4
	local e = 0.001
	for i = 0, count - 1 do
		local a = i / count
		local m = a + 0.5 / count
		table.insert(keys, NumberSequenceKeypoint.new(a, 0))
		table.insert(keys, NumberSequenceKeypoint.new(m - e, 0))
		table.insert(keys, NumberSequenceKeypoint.new(m, 1))
		table.insert(keys, NumberSequenceKeypoint.new((i + 1) / count - e, 1))
	end
	table.insert(keys, NumberSequenceKeypoint.new(1, 0))
	new("UIGradient", { Rotation = 60, Transparency = NumberSequence.new(keys), Parent = frame })
	return frame
end

-- The gem mark: an accent diamond with an ink outline.
local function gemIcon(parent, size, position)
	local diamond = new("Frame", {
		Name = "Gem",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		Rotation = 45,
		Parent = parent,
	})
	setAccent(diamond, "BackgroundColor3")
	stroke(diamond, 1)
	return diamond
end

local function blueprintGrid(parent, columns, rows, transparency)
	local grid = new("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = parent })
	for i = 1, columns - 1 do
		rule(grid, { BackgroundTransparency = transparency, Position = UDim2.fromScale(i / columns, 0), Size = UDim2.new(0, 1, 1, 0) })
	end
	for i = 1, rows - 1 do
		rule(grid, { BackgroundTransparency = transparency, Position = UDim2.fromScale(0, i / rows), Size = UDim2.new(1, 0, 0, 1) })
	end
	return grid
end

-- A full-bleed frame that also covers the notch / home-bar areas outside the safe insets.
local function bleed(parent, props)
	local merged = { Position = UDim2.fromOffset(-200, -200), Size = UDim2.new(1, 400, 1, 400) }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	return new("Frame", merged)
end

-- Ruler strip: ticks every `spacing` px, taller every `major` ticks.
local function rulerTicks(parent, width, height, spacing, major, transparency)
	local count = math.floor(width / spacing)
	for i = 0, count do
		local isMajor = i % major == 0
		rule(parent, {
			BackgroundTransparency = transparency or 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, i * spacing, 1, 0),
			Size = UDim2.fromOffset(1, if isMajor then height else math.floor(height * 0.45)),
		})
	end
end

local FILLS = {
	accent = { text = INK },
	paper = { bg = PAPER, text = INK },
	ink = { bg = INK, text = PAPER },
	danger = { bg = DANGER, text = PAPER },
}

--[[
	Poster-style button: a face with a 2px ink outline sitting on a solid ink
	block offset by SHADOW px. It presses down 2px while held.
	The holder itself is the (invisible) button, so the tap area and the gamepad
	selection cover the face *and* its shadow: a 50-tall button stays >= 44px
	even on the smallest phone sheet.
	opts: Name, Size, Position, AnchorPoint, LayoutOrder, Fill, Text, TextSize,
	Align, Index (small label top-left), Sub (small second line), OnClick
	A disabled button ignores taps, except that it calls button.onBlocked if set.
]]
local function hardButton(parent, opts)
	local holder = new("TextButton", {
		Name = opts.Name or "Button",
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundTransparency = 1,
		Size = opts.Size,
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = parent,
	})
	local shadow = new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = INK,
		Position = UDim2.fromOffset(SHADOW, SHADOW),
		Size = UDim2.new(1, -SHADOW, 1, -SHADOW),
		Parent = holder,
	})
	local face = new("Frame", {
		Name = "Face",
		BackgroundColor3 = PAPER,
		Size = UDim2.new(1, -SHADOW, 1, -SHADOW),
		Parent = holder,
	})
	stroke(face, 2)

	local align = opts.Align or Enum.TextXAlignment.Center
	local top = if opts.Index then 11 else 0
	local split = if opts.Sub then 0.6 else 1

	local index = nil
	if opts.Index then
		index = text({
			Name = "Index",
			Text = opts.Index,
			TextSize = 8,
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.new(1, -16, 0, 9),
			Parent = face,
		})
	end
	local label = text({
		Name = "Label",
		Font = FONT_NUM,
		Text = opts.Text or "",
		TextXAlignment = align,
		TextYAlignment = if opts.Sub then Enum.TextYAlignment.Bottom else Enum.TextYAlignment.Center,
		Position = UDim2.new(0, 8, 0, top),
		Size = UDim2.new(1, -16, split, -top),
		Parent = face,
	})
	capText(label, opts.TextSize or 13, 7)
	local sub = nil
	if opts.Sub then
		sub = text({
			Name = "Sub",
			Text = opts.Sub,
			TextSize = 9,
			TextXAlignment = align,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.new(0, 8, split, 1),
			Size = UDim2.new(1, -16, 1 - split, -2),
			Parent = face,
		})
	end

	local button = { holder = holder, face = face, label = label, sub = sub, index = index, enabled = true }

	function button.setFill(kind)
		local fill = FILLS[kind] or FILLS.paper
		if kind == "accent" then
			setAccent(face, "BackgroundColor3")
		else
			clearAccent(face)
			face.BackgroundColor3 = fill.bg
		end
		label.TextColor3 = fill.text
		if sub then
			sub.TextColor3 = fill.text
		end
		if index then
			index.TextColor3 = fill.text
		end
	end

	function button.setEnabled(enabled)
		button.enabled = enabled
		shadow.Visible = enabled
		face.Position = if enabled then UDim2.new() else UDim2.fromOffset(2, 2)
		label.TextTransparency = if enabled then 0 else 0.35
	end

	function button.setText(value)
		label.Text = value
	end

	local function release()
		if button.enabled then
			tween(face, 0.18, { Position = UDim2.new() }, Enum.EasingStyle.Back)
		end
	end

	holder.MouseButton1Down:Connect(function()
		if button.enabled then
			tween(face, 0.06, { Position = UDim2.fromOffset(2, 2) })
		end
	end)
	holder.MouseButton1Up:Connect(release)
	holder.MouseLeave:Connect(release)
	holder.Activated:Connect(function()
		release()
		if button.enabled then
			if opts.OnClick then
				opts.OnClick()
			end
		elseif button.onBlocked then
			button.onBlocked() -- e.g. a Robux button before the save loaded says why
		end
	end)

	button.setFill(opts.Fill or "paper")
	return button
end

local function sectionHeader(parent, order, index, title)
	local row = new("Frame", {
		Name = title,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = order,
		Parent = parent,
	})
	text({ Text = index .. "  " .. title, TextSize = 10, Size = UDim2.new(0.6, 0, 1, -3), Parent = row })
	local right = text({
		Text = "",
		TextSize = 9,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromScale(0.35, 0),
		Size = UDim2.new(0.65, 0, 1, -3),
		Parent = row,
	})
	rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	local tick = new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(18, 3),
		Parent = row,
	})
	setAccent(tick, "BackgroundColor3")
	return row, right
end

local function list(parent, padding)
	return new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, padding or 0),
		Parent = parent,
	})
end

local function clearRows(container)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Thin measurement bar: faint ink track with an accent fill (0..1).
local function meter(parent, props, height)
	local merged = { BackgroundColor3 = INK, BackgroundTransparency = 0.82, Size = UDim2.new(1, 0, 0, height or 4) }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local track = new("Frame", merged)
	local fill = new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), Parent = track })
	setAccent(fill, "BackgroundColor3")
	return track, fill
end

-- Rubber stamp: outlined slab with double rules, like NEW BEST on the run report.
local function stamp(parent, label, props, fill)
	local merged = { Name = "Stamp", AnchorPoint = Vector2.new(0.5, 0.5), Rotation = -8 }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local frame = new("Frame", merged)
	if fill == "accent" then
		setAccent(frame, "BackgroundColor3")
	else
		frame.BackgroundColor3 = PAPER
		frame.BackgroundTransparency = if fill == "clear" then 1 else 0
	end
	stroke(frame, 1.5)
	rule(frame, { Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 0, 1) })
	rule(frame, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 3, 1, -3), Size = UDim2.new(1, -6, 0, 1) })
	local textLabel = capText(text({
		Name = "Label",
		Text = label,
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -8, 1, 0),
		Parent = frame,
	}), 11, 6)
	return frame, textLabel
end

-- Small ink tag with paper (or accent) text: "LOCKED", "BEST VALUE"...
local function tag(parent, label, props, accentText)
	local merged = { Name = "Tag", BackgroundColor3 = INK }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local frame = new("Frame", merged)
	local textLabel = text({
		Text = label,
		TextSize = 8,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = frame,
	})
	if accentText then
		setAccent(textLabel, "TextColor3")
	end
	return frame, textLabel
end

-- One triangular glass shard (hard-stepped diagonal gradient, no image).
local function shard(parent, x, y, size, rotation, color)
	local frame = new("Frame", {
		Name = "Shard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(size, size),
		Rotation = rotation,
		BackgroundColor3 = color,
		Parent = parent,
	})
	new("UIGradient", {
		Rotation = 45,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.499, 0),
			NumberSequenceKeypoint.new(0.501, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = frame,
	})
	return frame
end

local SHARD_LAYOUT = {
	{ 0.5, 0.52, 16, 10 },
	{ 0.3, 0.32, 11, 70 },
	{ 0.7, 0.3, 10, -40 },
	{ 0.24, 0.72, 9, 150 },
	{ 0.76, 0.7, 12, 200 },
	{ 0.52, 0.16, 7, 120 },
	{ 0.12, 0.46, 6, 30 },
	{ 0.88, 0.48, 7, -110 },
	{ 0.5, 0.88, 7, 260 },
}

-- Ink sample plate showing shards in an effect's color.
local function fxSwatch(parent, fx, props, scale)
	local merged = { Name = "Swatch", BackgroundColor3 = INK }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local plate = new("Frame", merged)
	plate.ClipsDescendants = true
	scale = scale or 1
	for i, spec in SHARD_LAYOUT do
		local color = fx.Color or Config.GLASS_COLOR
		if fx.Rainbow then
			color = Color3.fromHSV((i - 1) / #SHARD_LAYOUT, 0.7, 1)
		end
		shard(plate, spec[1], spec[2], math.floor(spec[3] * scale + 0.5), spec[4], color)
	end
	if fx.Sparkle then
		for _, spot in { { 0.38, 0.5 }, { 0.62, 0.42 }, { 0.42, 0.22 }, { 0.66, 0.8 }, { 0.2, 0.2 } } do
			new("Frame", {
				BackgroundColor3 = PAPER,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(spot[1], spot[2]),
				Size = UDim2.fromOffset(2, 2),
				Parent = plate,
			})
		end
	end
	return plate
end

-- Tiny color sample for a reward (skin color, fx color, or the gem mark).
local function rewardChip(parent, reward, size, position)
	if type(reward) ~= "table" then
		return nil
	end
	if reward.Skin or reward.Fx then
		local item = if reward.Skin then Config.getSkin(reward.Skin) else Config.getFx(reward.Fx)
		local chip = new("Frame", {
			Name = "Chip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = item.Color or Config.GLASS_COLOR,
			Parent = parent,
		})
		stroke(chip, 1)
		if item.Rainbow then
			new("UIGradient", { Color = rainbowSequence(), Rotation = 20, Parent = chip })
		end
		if reward.Fx and not reward.Skin then
			chip.Rotation = 45 -- effects read as diamonds, skins as squares
		end
		return chip
	end
	if reward.Boost then
		local boost = boostInfo(reward.Boost)
		local chip = new("Frame", {
			Name = "Chip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = boost and boost.Color or INK,
			Parent = parent,
		})
		stroke(chip, 1)
		-- Boosts read as a square with an ink bar through it (a "capsule" mark).
		rule(chip, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 1) })
		return chip
	end
	return gemIcon(parent, math.floor(size * 0.8), position)
end

-- Shield mark: a flat top half over a diamond, which reads as a pointed crest.
local function shieldGlyph(parent, size, position, color)
	local holder = new("Frame", {
		Name = "ShieldGlyph",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	new("Frame", { BackgroundColor3 = color, Size = UDim2.new(1, 0, 0.5, 0), Parent = holder })
	local tip = math.floor(size * 0.707 + 0.5)
	new("Frame", {
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(tip, tip),
		Rotation = 45,
		Parent = holder,
	})
	return holder
end

-- Boost-bar marks, drawn in `color` inside a size x size square:
-- Magnet = a U with paper pole tips, Slow-Mo = an hourglass (caps + diamond),
-- Mega Ball = a big block with a small hole (a "giant ball").
local function boostGlyph(parent, id, size, position, color)
	local holder = new("Frame", {
		Name = "Glyph",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	local bar = math.max(2, math.floor(size * 0.3 + 0.5))
	if id == "Magnet" then
		new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0, bar, 1, 0), Parent = holder })
		new("Frame", { BackgroundColor3 = color, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, bar, 1, 0), Parent = holder })
		new("Frame", { BackgroundColor3 = color, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, bar), Parent = holder })
		for _, x in { 0, 1 } do
			new("Frame", { BackgroundColor3 = PAPER, AnchorPoint = Vector2.new(x, 0), Position = UDim2.fromScale(x, 0), Size = UDim2.fromOffset(bar, bar), Parent = holder })
		end
	elseif id == "SlowMo" then
		local cap = math.max(2, math.floor(size * 0.18 + 0.5))
		new("Frame", { BackgroundColor3 = color, Size = UDim2.new(1, 0, 0, cap), Parent = holder })
		new("Frame", { BackgroundColor3 = color, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, cap), Parent = holder })
		local tip = math.floor(size * 0.5 + 0.5)
		new("Frame", {
			BackgroundColor3 = color,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(tip, tip),
			Rotation = 45,
			Parent = holder,
		})
	else
		local block = new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), Parent = holder })
		new("Frame", {
			BackgroundColor3 = PAPER,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(bar, bar),
			Parent = block,
		})
	end
	return holder
end

-- A tiny D-pad: a grey cross with the arm to press (direction "Left" / "Up" /
-- "Right" / "Down") in solid ink.
local function padGlyph(parent, direction, size, props)
	local holder = new("Frame", { Name = "PadHint", BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Visible = false })
	for key, value in props do
		(holder :: any)[key] = value
	end
	local arm = math.max(3, math.floor(size / 3 + 0.5))
	new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, arm), Parent = holder })
	new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, arm, 1, 0), Parent = holder })
	local spots = {
		Left = { Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5) },
		Right = { Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5) },
		Up = { Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0) },
		Down = { Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1) },
	}
	local spot = spots[direction] or spots.Up
	new("Frame", { BackgroundColor3 = INK, AnchorPoint = spot[1], Position = spot[2], Size = UDim2.fromOffset(arm, arm), Parent = holder })
	holder.Parent = parent
	return holder
end

-- Settings mark: a sharp-cornered cog. Four bars make eight teeth, two squares
-- make the octagonal body, and a paper square punches the hole.
local function gearGlyph(parent, size, position, color, holeColor)
	local holder = new("Frame", {
		Name = "Gear",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	local center = UDim2.fromScale(0.5, 0.5)
	local half = Vector2.new(0.5, 0.5)
	local tooth = math.max(2, math.floor(size * 0.24 + 0.5))
	for _, rotation in { 0, 45, 90, 135 } do
		new("Frame", { BackgroundColor3 = color, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(size, tooth), Rotation = rotation, Parent = holder })
	end
	local body = math.floor(size * 0.7 + 0.5)
	for _, rotation in { 0, 45 } do
		new("Frame", { BackgroundColor3 = color, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(body, body), Rotation = rotation, Parent = holder })
	end
	local hole = math.max(2, math.floor(size * 0.28 + 0.5))
	new("Frame", { Name = "Hole", BackgroundColor3 = holeColor or PAPER, AnchorPoint = half, Position = center, Size = UDim2.fromOffset(hole, hole), Rotation = 45, Parent = holder })
	return holder
end

-- Gamepad helpers ------------------------------------------------------------------------

-- "gamepad", "pointer" (mouse / keyboard / touch), or nil for inputs that say
-- nothing about how the player is playing (gyro, focus, text input...).
local function inputKind(inputType)
	if string.sub(inputType.Name, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	if
		inputType == Enum.UserInputType.Touch
		or inputType == Enum.UserInputType.Keyboard
		or inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseButton3
		or inputType == Enum.UserInputType.MouseWheel
	then
		return "pointer"
	end
	return nil
end

local function gamepadAtStart()
	local kind = inputKind(UserInputService:GetLastInputType())
	if kind then
		return kind == "gamepad" and UserInputService.GamepadEnabled
	end
	return GuiService:IsTenFootInterface() -- console with no input yet
end

-- Visible on screen: itself and every ancestor up to an enabled ScreenGui.
local function onScreen(inst)
	if inst == nil or inst.Parent == nil then
		return false
	end
	local node = inst
	while node do
		if node:IsA("LayerCollector") then
			return node.Enabled
		end
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return false
end

-- The first selectable button under `container` that is showing, or nil.
local function firstSelectable(container)
	if container == nil then
		return nil
	end
	for _, inst in container:GetDescendants() do
		if inst:IsA("GuiButton") and inst.Selectable and onScreen(inst) then
			return inst
		end
	end
	return nil
end

-- Gamepad selection outline: a thick accent box with an ink hairline inside,
-- sharp corners, a few px outside the selected button.
local function selectionBox()
	local box = Instance.new("Frame")
	box.Name = "Selection"
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Position = UDim2.fromOffset(-5, -5)
	box.Size = UDim2.new(1, 10, 1, 10)
	local accentStroke = stroke(box, 3, accentColor)
	local inner = new("Frame", {
		Name = "Hairline",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		Parent = box,
	})
	stroke(inner, 1, INK)
	return box, accentStroke
end

-- Small controller hint row: ink keycap + label per pair, e.g. { {"A", "SELECT"}, {"B", "BACK"} }.
-- Hidden unless the player is on a gamepad (see _refreshHints).
local function inputHint(parent, entries, props, alignment)
	local merged = { Name = "InputHint", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Visible = false }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local row = new("Frame", merged)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = alignment or Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = row,
	})
	for i, pair in entries do
		local cap = new("Frame", {
			Name = "Key",
			BackgroundColor3 = INK,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 14, 1, 0),
			LayoutOrder = i * 2 - 1,
			Parent = row,
		})
		new("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = cap })
		text({
			Text = pair[1],
			TextSize = 8,
			TextColor3 = PAPER,
			TextXAlignment = Enum.TextXAlignment.Center,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 8, 1, 0),
			Parent = cap,
		})
		local word = text({
			Name = "Action",
			Text = pair[2],
			TextSize = 8,
			BackgroundColor3 = PAPER,
			BackgroundTransparency = 0.1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 8, 1, 0),
			LayoutOrder = i * 2,
			Parent = row,
		})
		new("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 5), Parent = word })
	end
	return row
end

-- Explicit gamepad neighbours for a grid of buttons (row-major, `columns` wide).
-- Links left as nil fall back to Roblox's automatic choice.
local function linkGrid(buttons, columns)
	local count = #buttons
	for i, button in buttons do
		local column = (i - 1) % columns
		button.NextSelectionLeft = if column > 0 then buttons[i - 1] else nil
		button.NextSelectionRight = if column < columns - 1 and i < count then buttons[i + 1] else nil
		button.NextSelectionUp = if i > columns then buttons[i - columns] else nil
		local below = buttons[i + columns]
		if below == nil and i + columns - column <= count then
			below = buttons[count] -- short last row: drop to its last button
		end
		button.NextSelectionDown = below
	end
end

-- Menu ---------------------------------------------------------------------------------

function UI._buildMenu(self)
	local m = {}
	self._menu = m

	local root = new("Frame", { Name = "Menu", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	m.root = root

	-- Paper wash on the left so the logotype reads; the corridor stays visible on the right.
	local wash = bleed(root, { Name = "Wash", BackgroundColor3 = PAPER })
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.32, 0.2),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = wash,
	})
	blueprintGrid(root, 12, 8, 0.93)

	-- Vanishing-point crosshair over the track preview.
	local cross = new("Frame", {
		Name = "Crosshair",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 22),
		Parent = root,
	})
	fit(cross)
	rule(cross, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 0.3 })
	rule(cross, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundTransparency = 0.3 })
	text({ Text = "VP / 0 M", TextSize = 8, Position = UDim2.fromOffset(14, 13), Size = UDim2.fromOffset(60, 10), TextTransparency = 0.3, Parent = cross })

	self:_buildMenuLeft(root)
	self:_buildMenuPanel(root)
	self:_buildTopUp(root)
	self:_buildModal(root)
end

function UI._buildMenuLeft(self, root)
	local m = self._menu
	local left = new("Frame", {
		Name = "Left",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, EDGE + 4, 0.5, 0),
		Size = UDim2.fromOffset(256, MENU_H),
		Parent = root,
	})
	fit(left)
	m.left = left

	-- Index line
	local chip = new("Frame", { Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(6, 6), Parent = left })
	setAccent(chip, "BackgroundColor3")
	text({ Text = "SR-01 / GLASS LAB / FIELD TEST", TextSize = 8, Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(244, 12), Parent = left })

	-- Logotype: SHATTER is split along a crack, the right shard knocked out of
	-- register, with an accent misprint behind it. RUN sits in a solid ink block.
	local logo = new("Frame", { Name = "Logo", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 16), Size = UDim2.fromOffset(256, 50), Parent = left })
	local function word(parent, props)
		local merged = { Text = "SHATTER", Font = FONT_NUM, TextYAlignment = Enum.TextYAlignment.Center }
		for key, value in props do
			merged[key] = value
		end
		merged.Parent = parent
		return capText(text(merged), 46, 20)
	end
	local ghost = word(logo, { Position = UDim2.fromOffset(3, 3), Size = UDim2.fromScale(1, 1) })
	setAccent(ghost, "TextColor3")
	local SPLIT = 0.57
	local leftShard = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.fromScale(SPLIT, 1), Parent = logo })
	word(leftShard, { Size = UDim2.fromScale(1 / SPLIT, 1) })
	local rightShard = new("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.new(SPLIT, 2, 0, 3),
		Size = UDim2.fromScale(1 - SPLIT, 1),
		Parent = logo,
	})
	word(rightShard, { Position = UDim2.fromScale(-SPLIT / (1 - SPLIT), 0), Size = UDim2.fromScale(1 / (1 - SPLIT), 1) })
	new("Frame", {
		Name = "Crack",
		BackgroundColor3 = PAPER,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(SPLIT, 1, 0.5, 0),
		Size = UDim2.fromOffset(3, 62),
		Rotation = 16,
		Parent = logo,
	})
	rule(logo, {
		Name = "CrackLine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(SPLIT, 5, 0.5, 6),
		Size = UDim2.fromOffset(1, 78),
		Rotation = 16,
	})

	local runBlock = new("Frame", { Name = "Run", BackgroundColor3 = INK, Position = UDim2.fromOffset(0, 70), Size = UDim2.fromOffset(112, 40), Parent = left })
	capText(text({ Text = "RUN", Font = FONT_NUM, TextColor3 = PAPER, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = runBlock }), 28, 12)
	notch(runBlock, 10, 1, 0)
	text({
		Text = "GLIDE.\nTHROW.\nSHATTER.",
		TextSize = 9,
		LineHeight = 1.05,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = UDim2.fromOffset(122, 70),
		Size = UDim2.fromOffset(134, 40),
		Parent = left,
	})

	-- Stats strip
	-- Stats strip: BEST | GEMS | LEVEL badge, with the XP bar along the bottom edge.
	local stats = new("Frame", { Name = "Stats", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 120), Size = UDim2.fromOffset(256, 46), Parent = left })
	rule(stats, {})
	rule(stats, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	rule(stats, { Position = UDim2.fromOffset(92, 8), Size = UDim2.new(0, 1, 1, -18) })
	rule(stats, { Position = UDim2.fromOffset(176, 8), Size = UDim2.new(0, 1, 1, -18) })
	text({ Text = "BEST / M", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(0, 5), Size = UDim2.fromOffset(88, 10), Parent = stats })
	m.best = capText(text({ Text = "0", Font = FONT_NUM, Position = UDim2.fromOffset(0, 17), Size = UDim2.fromOffset(88, 22), Parent = stats }), 16, 8)
	gemIcon(stats, 7, UDim2.fromOffset(104, 10))
	text({ Text = "GEMS", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(114, 5), Size = UDim2.fromOffset(60, 10), Parent = stats })
	m.gems = capText(text({ Text = "0", Font = FONT_NUM, Position = UDim2.fromOffset(100, 17), Size = UDim2.fromOffset(72, 22), Parent = stats }), 16, 8)

	local badge = new("Frame", { Name = "Level", BackgroundColor3 = INK, Position = UDim2.fromOffset(184, 6), Size = UDim2.fromOffset(72, 32), Parent = stats })
	notch(badge, 8, 1, 0)
	text({ Text = "LEVEL", TextSize = 7, TextColor3 = PAPER, TextTransparency = 0.35, Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(50, 9), Parent = badge })
	m.level = capText(text({ Text = "LV 01", Font = FONT_NUM, TextColor3 = PAPER, Position = UDim2.fromOffset(6, 11), Size = UDim2.fromOffset(62, 18), Parent = badge }), 13, 7)
	m.levelBump = new("UIScale", { Parent = badge })
	local _, xpFill = meter(stats, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -1) }, 3)
	m.xpFill = xpFill
	m.xpNote = text({
		Text = "",
		TextSize = 7,
		TextColor3 = GREY,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(0, 167),
		Size = UDim2.fromOffset(256, 9),
		Parent = left,
	})

	-- Boost picker: one chip per boost, right above PLAY.
	self:_buildBoostPicker(left, 178)

	-- PLAY
	local play = hardButton(left, {
		Name = "Play",
		Fill = "accent",
		Text = "PLAY",
		TextSize = 26,
		Align = Enum.TextXAlignment.Left,
		Index = "A / START RUN / 0 M",
		Position = UDim2.fromOffset(0, 232),
		Size = UDim2.fromOffset(256, 54),
		OnClick = function()
			self:_fire("onPlay", 0, self:_pickedBoosts())
		end,
	})
	m.play = play
	self:_buildMenuBall(play.face)
	-- Text stops short of the ball window.
	play.index.Size = UDim2.new(1, -(16 + MENU_BALL_VIEW), 0, 9)
	play.index.TextTruncate = Enum.TextTruncate.AtEnd
	play.label.Size = UDim2.new(1, -(16 + MENU_BALL_VIEW), 1, -11)

	-- DAILY: opens the 7-day streak sheet. The pips on the right show the streak at a glance.
	-- It shares the bottom row with the SETTINGS gear, so PLAY stays the one big button.
	local daily = hardButton(left, {
		Name = "Daily",
		Fill = "paper",
		Text = "--:--:--",
		TextSize = 13,
		Align = Enum.TextXAlignment.Left,
		Index = "B / DAILY",
		Position = UDim2.fromOffset(0, 290),
		Size = UDim2.fromOffset(256 - SETTINGS_GEAR_W, 50),
		OnClick = function()
			self:_openDaily()
		end,
	})
	daily.label.Size = UDim2.new(1, -104, 1, -11)
	local pipRow = new("Frame", {
		Name = "Streak",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 4),
		Size = UDim2.fromOffset(#Config.DailyStreak * 12 - 2, 12),
		Parent = daily.face,
	})
	m.dailyPips = {}
	for day = 1, #Config.DailyStreak do
		local isBig = day == #Config.DailyStreak
		local pip = new("Frame", {
			Name = "Day" .. day,
			BackgroundColor3 = INK,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((day - 1) * 12 + 5, 6),
			Size = if isBig then UDim2.fromOffset(9, 9) else UDim2.fromOffset(8, 8),
			Rotation = if isBig then 45 else 0,
			Parent = pipRow,
		})
		local pipStroke = stroke(pip, 1)
		m.dailyPips[day] = { frame = pip, stroke = pipStroke }
	end
	m.daily = daily

	local gear = self:_gearButton(left, {
		Position = UDim2.fromOffset(256 - SETTINGS_GEAR_W, 290),
	})
	m.settingsButton = gear
	daily.holder.NextSelectionRight = gear.holder
	gear.holder.NextSelectionLeft = daily.holder
	gear.holder.NextSelectionUp = play.holder
end

-- The equipped ball, floating and turning in a small ink window at the end of
-- PLAY (where the button's hatch used to be). Same 3D preview as the shop.
function UI._buildMenuBall(self, face)
	local m = self._menu
	local plate = new("Frame", {
		Name = "Ball",
		BackgroundColor3 = INK,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -5, 0.5, 0),
		Size = UDim2.fromOffset(MENU_BALL_VIEW, MENU_BALL_VIEW),
		Parent = face,
	})
	local view = new("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(150, 150, 165),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -2, -1),
		Parent = plate,
	})
	brackets(plate, 5, 1, 0.2)
	for _, item in plate:GetChildren() do
		if item.Name == "Bracket" then
			item.BackgroundColor3 = PAPER
			item.ZIndex = 2
		end
	end
	local viewCamera = new("Camera", { FieldOfView = 40, Parent = view })
	view.CurrentCamera = viewCamera
	m.ball = { view = view, camera = viewCamera, preview = nil, skinId = nil }

	-- Animated only while the menu is on screen.
	local lastMeshCheck = 0
	table.insert(self._connections, RunService.RenderStepped:Connect(function()
		local ball = m.ball
		local preview = ball.preview
		if not preview or not m.root.Visible then
			return
		end
		local now = os.clock()
		if now - lastMeshCheck > PREMIUM_MESH_CHECK then
			lastMeshCheck = now
			-- meshTriedFor: one swap per skin, so a model that still can't be used doesn't rebuild every second.
			if not preview.mesh and ball.meshTriedFor ~= ball.skinId and BallFx.isPremium(ball.skinId) and BallFx.hasMesh(ball.skinId) then
				ball.meshTriedFor = ball.skinId
				self:_showMenuBall(ball.skinId, true) -- the Blender model has loaded
				preview = ball.preview
			end
		end
		preview.step(now)
		if ball.rainbow and preview.model.PrimaryPart then
			preview.model.PrimaryPart.Color = Color3.fromHSV((now * 0.2) % 1, 0.8, 1)
		end
		local angle = now * MENU_BALL_SPIN
		local eye = Vector3.new(math.sin(angle), 0.35, math.cos(angle)) * PREMIUM_CAMERA_DISTANCE
		local float = Vector3.new(0, math.sin(now * 2) * MENU_BALL_FLOAT, 0)
		ball.camera.CFrame = CFrame.lookAt(eye - float, -float)
	end))
	self:_showMenuBall(player:GetAttribute("EquippedSkin"))
end

function UI._showMenuBall(self, skinId, force)
	local ball = self._menu and self._menu.ball
	if not ball then
		return
	end
	skinId = Config.getSkin(skinId).Id
	if ball.skinId == skinId and ball.preview and not force then
		return
	end
	if ball.preview then
		ball.preview.destroy()
		ball.preview = nil
	end
	ball.skinId = skinId
	ball.rainbow = Config.getSkin(skinId).Rainbow == true
	local ok, preview = pcall(BallFx.preview, skinId, PREMIUM_PREVIEW_DIAMETER)
	if ok and preview then
		preview.model.Parent = ball.view
		ball.preview = preview
	else
		warn("[UI] menu ball preview failed:", preview)
	end
end

-- The SETTINGS gear: a small square hard button (50 tall, like everything tappable).
function UI._gearButton(self, parent, opts)
	local button
	button = hardButton(parent, {
		Name = "Settings",
		Fill = "paper",
		Text = "",
		Index = "SETTINGS",
		Position = opts.Position,
		AnchorPoint = opts.AnchorPoint,
		LayoutOrder = opts.LayoutOrder,
		Size = UDim2.fromOffset(SETTINGS_GEAR_W, 50),
		OnClick = function()
			self:_openSettings(button.holder)
		end,
	})
	button.index.TextXAlignment = Enum.TextXAlignment.Center
	capText(button.index, 8, 5)
	button.gear = gearGlyph(button.face, 18, UDim2.new(0.5, 0, 0.5, 5), INK, PAPER)
	return button
end

-- Boost picker ------------------------------------------------------------------------------
-- Chips toggle which owned boosts go into the next run (up to MAX_PICKS). A chip
-- with none owned shows a "+" and opens a small buy popover above the strip.

function UI._buildBoostPicker(self, left, y)
	local m = self._menu
	m.boostPicks = {}
	m.boostChips = {}
	m.boostChipList = {}
	local count = #BOOST_ORDER
	if count == 0 then
		return
	end
	local width = 256
	local gap = BOOST_CHIP_GAP -- tight, so 5 chips stay >= 50 wide (44px on a phone)
	local chipW = math.floor((width - gap * (count - 1)) / count)
	local strip = new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.fromOffset(width, BOOST_CHIP_H),
		Parent = left,
	})
	m.boostStrip = strip
	m.boostChipW = chipW

	for i, id in BOOST_ORDER do
		if boostInfo(id) then
			-- The holder is the button, so the whole chip (shadow included) is the tap / selection area.
			local holder = new("TextButton", {
				Name = id,
				AutoButtonColor = false,
				Text = "",
				Selectable = true,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset((i - 1) * (chipW + gap), 0),
				Size = UDim2.fromOffset(chipW, BOOST_CHIP_H),
				Parent = strip,
			})
			local bump = new("UIScale", { Parent = holder })
			local shadow = new("Frame", {
				Name = "Shadow",
				BackgroundColor3 = INK,
				Position = UDim2.fromOffset(2, 2),
				Size = UDim2.new(1, -2, 1, -2),
				Visible = false,
				Parent = holder,
			})
			local face = new("Frame", {
				Name = "Face",
				BackgroundColor3 = PAPER,
				Size = UDim2.new(1, -2, 1, -2),
				Parent = holder,
			})
			local outline = stroke(face, 1, INK, 0.5)
			rewardChip(face, { Boost = id }, 7, UDim2.fromOffset(8, 8))
			local countLabel = text({
				Name = "Count",
				Text = "x0",
				TextSize = 8,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.fromOffset(14, 2),
				Size = UDim2.new(1, -17, 0, 11),
				Parent = face,
			})
			local plus = new("Frame", {
				Name = "Plus",
				BackgroundColor3 = INK,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -3, 0, 3),
				Size = UDim2.fromOffset(11, 11),
				Visible = false,
				Parent = face,
			})
			setAccent(text({
				Text = "+",
				Font = FONT_NUM,
				TextSize = 9,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = plus,
			}), "TextColor3")
			local name = capText(text({
				Name = "Name",
				Text = boostName(id),
				Font = FONT_NUM,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(2, 18),
				Size = UDim2.new(1, -4, 0, 22),
				Parent = face,
			}), 8, 5)
			local chip = {
				id = id,
				order = i,
				holder = holder,
				bump = bump,
				shadow = shadow,
				face = face,
				outline = outline,
				count = countLabel,
				plus = plus,
				name = name,
			}
			holder.Activated:Connect(function()
				self:_tapBoostChip(chip)
			end)
			m.boostChips[id] = chip
			table.insert(m.boostChipList, chip)
		end
	end

	self:_buildBoostPop(left, y)
end

-- The small "buy one" popover that sits above the chip strip.
function UI._buildBoostPop(self, left, chipY)
	local m = self._menu
	local pop = {}
	m.boostPop = pop
	local frame = new("Frame", {
		Name = "BoostPop",
		BackgroundColor3 = PAPER,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromOffset(0, chipY - 6),
		Size = UDim2.fromOffset(256, BOOST_POP_H),
		ZIndex = 3,
		Visible = false,
		Parent = left,
	})
	frame.Active = true -- taps on the popover don't fall through
	-- Gamepad selection stays inside the popover until it closes (B or X).
	frame.SelectionGroup = true
	frame.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
	frame.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
	frame.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
	frame.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
	pop.frame = frame
	pop.y = chipY - 6
	stroke(frame, 1.5)
	cropMarks(frame, 6, 3)

	local header = new("Frame", { Name = "Header", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 24), Parent = frame })
	pop.title = text({
		Text = "",
		TextSize = 8,
		TextColor3 = PAPER,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -(POP_CLOSE + 68), 1, 0),
		Parent = header,
	})
	setAccent(text({
		Text = "BUY 1",
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -(POP_CLOSE + 60), 0, 0),
		Size = UDim2.fromOffset(54, 24),
		Parent = header,
	}), "TextColor3")
	rule(header, { BackgroundColor3 = PAPER, BackgroundTransparency = 0.6, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -POP_CLOSE, 0, 5), Size = UDim2.new(0, 1, 1, -10) })
	-- The X is drawn in the header, but its tap area is a full 50x50 corner
	-- (reaching down past the copy line, which stops short of it).
	local close = new("TextButton", {
		Name = "Close",
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(POP_CLOSE, POP_CLOSE),
		ZIndex = 2,
		Parent = frame,
	})
	text({
		Text = "X",
		Font = FONT_NUM,
		TextSize = 10,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = close,
	})
	close.Activated:Connect(function()
		self:_closeBoostPop()
	end)
	pop.close = close

	pop.copy = text({
		Text = "",
		TextSize = 8,
		TextColor3 = GREY,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(8, 28),
		Size = UDim2.new(1, -(POP_CLOSE + 12), 0, 11),
		Parent = frame,
	})

	-- Leader line from the popover down to the chip it belongs to.
	pop.pointer = rule(frame, { Name = "Pointer", Position = UDim2.new(0, 24, 1, 0), Size = UDim2.fromOffset(1, 6) })

	pop.gems = hardButton(frame, {
		Name = "Gems",
		Fill = "ink",
		Text = "",
		TextSize = 11,
		Align = Enum.TextXAlignment.Left,
		Index = "PAY / GEMS",
		Position = UDim2.fromOffset(8, 54),
		Size = UDim2.fromOffset(120, 50),
		OnClick = function()
			self:_buyBoostWithGems()
		end,
	})
	pop.robux = hardButton(frame, {
		Name = "Robux",
		Fill = "accent",
		Text = "R$ --",
		TextSize = 11,
		Align = Enum.TextXAlignment.Left,
		Index = "PAY / ROBUX",
		Position = UDim2.fromOffset(132, 54),
		Size = UDim2.fromOffset(120, 50),
		OnClick = function()
			if pop.id then
				self:_fire("onBuyProduct", "Boost" .. pop.id)
			end
		end,
	})
	self:_robuxButton(pop.robux)
	pop.gems.holder.NextSelectionUp = close
	pop.robux.holder.NextSelectionUp = close
	pop.gems.holder.NextSelectionRight = pop.robux.holder
	pop.robux.holder.NextSelectionLeft = pop.gems.holder
	close.NextSelectionDown = pop.robux.holder
end

function UI._pickedBoosts(self)
	local picks = self._menu.boostPicks
	return if picks then table.clone(picks) else {}
end

function UI._tapBoostChip(self, chip)
	local m = self._menu
	local owned = ownedBoosts()[chip.id] or 0
	local index = table.find(m.boostPicks, chip.id)
	if index then
		table.remove(m.boostPicks, index)
	elseif owned <= 0 then
		if m.boostPop.frame.Visible and m.boostPop.id == chip.id then
			self:_closeBoostPop()
		else
			self:_openBoostPop(chip)
		end
		return
	elseif #m.boostPicks >= MAX_PICKS then
		self:toast("MAX " .. MAX_PICKS .. " BOOSTS PER RUN", "info")
		return
	else
		table.insert(m.boostPicks, chip.id)
		chip.bump.Scale = 1.12
		tween(chip.bump, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	self:_closeBoostPop()
	self:_refreshBoosts()
end

-- Chip looks; each chip only re-styles when its state or count changes.
function UI._refreshBoosts(self)
	local m = self._menu
	if not m or not m.boostChips then
		return
	end
	local counts = ownedBoosts()
	-- Drop picks that are no longer owned (spent, or inventory not loaded yet).
	for i = #m.boostPicks, 1, -1 do
		if (counts[m.boostPicks[i]] or 0) <= 0 then
			table.remove(m.boostPicks, i)
		end
	end

	-- A boost just bought from the open popover gets picked for the next run.
	local pop = m.boostPop
	if pop and pop.id and (counts[pop.id] or 0) > 0 then
		local id = pop.id
		self:_closeBoostPop()
		if not table.find(m.boostPicks, id) and #m.boostPicks < MAX_PICKS then
			table.insert(m.boostPicks, id)
		end
	end

	local full = #m.boostPicks >= MAX_PICKS
	for id, chip in m.boostChips do
		local owned = counts[id] or 0
		local picked = table.find(m.boostPicks, id) ~= nil
		local state = if picked then "picked" elseif owned <= 0 then "empty" elseif full then "full" else "owned"
		local key = state .. owned
		if key ~= chip.key then
			chip.key = key
			if picked then
				setAccent(chip.face, "BackgroundColor3")
			else
				clearAccent(chip.face)
				chip.face.BackgroundColor3 = PAPER
			end
			chip.face.BackgroundTransparency = if state == "empty" then 0.35 else 0
			chip.shadow.Visible = picked
			chip.outline.Thickness = if picked then 2 else 1
			chip.outline.Transparency = if picked then 0 elseif state == "empty" then 0.7 else 0.5
			chip.name.TextTransparency = if state == "empty" or state == "full" then 0.45 else 0
			chip.count.Visible = owned > 0
			chip.count.Text = "x" .. owned
			chip.count.TextColor3 = if picked then INK else GREY
			chip.plus.Visible = owned <= 0
		end
	end
	self:_refreshBoostPop()
	self:_refreshPlayIndex()
	self:_checkWelcome(counts)
end

function UI._openBoostPop(self, chip)
	local m = self._menu
	local pop = m.boostPop
	local boost = boostInfo(chip.id)
	if not pop or not boost then
		return
	end
	self:_hideTopUp()
	pop.id = chip.id
	pop.busy = false
	pop.gems.setEnabled(true)
	pop.title.Text = "C-" .. twoDigits(chip.order) .. " / " .. boostName(chip.id) .. " BOOST"
	pop.copy.Text = string.upper(tostring(boost.Text or ""))
	pop.pointer.Position = UDim2.new(0, chip.holder.Position.X.Offset + math.floor((m.boostChipW or 48) / 2) - 1, 1, 0)

	-- Robux option only when that boost's product is set up.
	local key = "Boost" .. chip.id
	local id = productId(key)
	pop.robux.holder.Visible = id ~= 0
	pop.gems.holder.Size = if id ~= 0 then UDim2.fromOffset(120, 50) else UDim2.fromOffset(244, 50)
	pop.close.NextSelectionDown = if id ~= 0 then pop.robux.holder else pop.gems.holder
	pop.robux.setText("R$ --")
	withPrice(id, Enum.InfoType.Product, function(price)
		if pop.id == chip.id and pop.robux.label.Parent then
			pop.robux.setText("R$ " .. commas(price))
		end
	end)

	pop.frame.Visible = true
	pop.frame.Position = UDim2.fromOffset(0, pop.y + 8)
	tween(pop.frame, 0.2, { Position = UDim2.fromOffset(0, pop.y) })
	pop.returnTo = chip.holder
	self:_refreshBoostPop()
	self:_syncBack()
	self:_focus(pop.gems.holder)
end

function UI._closeBoostPop(self)
	local pop = self._menu and self._menu.boostPop
	if not pop then
		return
	end
	if self._topUp and self._topUp.host == pop.frame then
		self:_hideTopUp()
	end
	local wasOpen = pop.frame.Visible
	pop.id = nil
	pop.frame.Visible = false
	if wasOpen then
		self:_syncBack()
		self:_returnFocus(pop.frame, pop.returnTo)
	end
end

-- Gem button: price, or how many gems are missing.
function UI._refreshBoostPop(self)
	local pop = self._menu and self._menu.boostPop
	if not pop or not pop.id or pop.busy then
		return
	end
	local boost = boostInfo(pop.id)
	local price = math.floor(tonumber(boost and boost.Gems) or 0)
	local short = price - math.floor(attrNumber("Gems", 0))
	local key = pop.id .. "|" .. short
	if key == pop.key then
		return
	end
	pop.key = key
	if short > 0 then
		pop.gems.setFill("paper")
		pop.gems.index.Text = "PAY / " .. commas(price) .. " GEMS"
		pop.gems.setText("NEED " .. commas(short) .. " GEMS")
	else
		pop.gems.setFill("ink")
		pop.gems.index.Text = "PAY / GEMS"
		pop.gems.setText(commas(price) .. " GEMS")
	end
end

function UI._buyBoostWithGems(self)
	local pop = self._menu.boostPop
	local id = pop.id
	local boost = id and boostInfo(id)
	if not boost or pop.busy then
		return
	end
	local price = math.floor(tonumber(boost.Gems) or 0)
	local short = price - math.floor(attrNumber("Gems", 0))
	if short > 0 then
		-- Not enough: offer the small gem top-up instead of a doomed request.
		if not self:_offerTopUp(price, pop.frame) then
			self:toast("NEED " .. commas(short) .. " MORE GEMS", "error")
		end
		return
	end
	pop.busy = true
	pop.key = nil
	pop.gems.setEnabled(false)
	pop.gems.setText("BUYING")
	task.spawn(function()
		local ok, message = self:_ask("onShop", "BuyBoost", id)
		pop.busy = false
		pop.gems.setEnabled(true)
		if ok then
			self:toast("+1 " .. boostName(id) .. " BOOST", "reward")
		else
			self:toast(message or "PURCHASE FAILED", "error")
			if pop.id == id then
				self:_offerTopUp(price, pop.frame)
			end
		end
		self:_refreshBoosts()
	end)
end

-- "A / START RUN / +10 BONUS BALLS / 2/3 BOOSTS"
function UI._refreshPlayIndex(self)
	local m = self._menu
	if not m.play then
		return
	end
	local parts = { "A / START RUN" }
	local bonus = math.max(0, math.floor(attrNumber("BonusBalls", 0)))
	if bonus > 0 then
		table.insert(parts, "+" .. bonus .. " BONUS BALLS")
	end
	local picks = if m.boostPicks then #m.boostPicks else 0
	if picks > 0 then
		table.insert(parts, picks .. "/" .. MAX_PICKS .. " BOOSTS")
	end
	if #parts == 1 then
		table.insert(parts, "0 M")
	end
	m.play.index.Text = table.concat(parts, " / ")
end

-- New players arrive with a starter set of boosts: say so once per session.
function UI._checkWelcome(self, counts)
	if self._welcomeDone then
		return
	end
	local stats = decodeJson(player:GetAttribute("Stats"))
	if player:GetAttribute("Level") == nil or type(stats) ~= "table" then
		return -- progress not loaded yet
	end
	local level = levelInfo()
	if level > 1 or (tonumber(stats.runs) or 0) > 0 then
		self._welcomeDone = true
		return
	end
	local total = 0
	for _, n in counts or ownedBoosts() do
		total += n
	end
	if total <= 0 then
		return
	end
	self._welcomeDone = true
	self:toast(total .. (if total == 1 then " FREE BOOST" else " FREE BOOSTS") .. " / PICK ABOVE PLAY", "gift")
	for i, chip in self._menu.boostChipList or {} do
		task.delay(0.08 * i, function()
			if chip.holder.Parent then
				chip.bump.Scale = 1.18
				tween(chip.bump, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
end

-- Gem top-up ------------------------------------------------------------------------------
-- One small inline strip, moved next to whatever purchase just came up short
-- (shop panel or boost popover). No modal and no timer; it closes with X, once
-- the player can afford the item, or when the context goes away.

function UI._buildTopUp(self, root)
	local product = Config.Products.GemTopUp
	local id = productId("GemTopUp")
	if id == 0 or not tonumber(product.Gems) then
		return
	end
	local t = {}
	self._topUp = t
	local strip = new("Frame", {
		Name = "TopUp",
		BackgroundColor3 = INK,
		Size = UDim2.new(1, 0, 0, TOPUP_H),
		ZIndex = 6,
		Visible = false,
		Parent = root,
	})
	strip.Active = true
	t.strip = strip
	notch(strip, 8, 0, 0)
	local textW = -(12 + TOPUP_CLOSE_W + 2 + TOPUP_BUY_W + 8)
	t.short = setAccent(text({ Text = "", TextSize = 8, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, textW, 0, 10), Parent = strip }), "TextColor3")
	t.offer = capText(text({
		Text = "GET +" .. commas(product.Gems) .. " GEMS",
		Font = FONT_NUM,
		TextColor3 = PAPER,
		Position = UDim2.fromOffset(12, 20),
		Size = UDim2.new(1, textW, 0, 26),
		Parent = strip,
	}), 12, 7)
	t.buy = hardButton(strip, {
		Name = "Buy",
		Fill = "accent",
		Text = "GET",
		TextSize = 11,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(TOPUP_CLOSE_W + 2), 0.5, 2),
		Size = UDim2.fromOffset(TOPUP_BUY_W, 50),
		OnClick = function()
			self:_fire("onBuyProduct", "GemTopUp")
		end,
	})
	self:_robuxButton(t.buy)
	withPrice(id, Enum.InfoType.Product, function(price)
		t.buy.sub.Text = "R$ " .. commas(price)
	end)
	rule(strip, { BackgroundColor3 = PAPER, BackgroundTransparency = 0.7, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -TOPUP_CLOSE_W, 0, 8), Size = UDim2.new(0, 1, 1, -16) })
	local dismiss = new("TextButton", {
		Name = "Dismiss",
		AutoButtonColor = false,
		Text = "X",
		Font = FONT_NUM,
		TextSize = 10,
		TextColor3 = PAPER,
		Selectable = true,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, TOPUP_CLOSE_W, 1, 0),
		Parent = strip,
	})
	dismiss.Activated:Connect(function()
		self:_hideTopUp()
	end)
	t.buy.holder.NextSelectionRight = dismiss
	dismiss.NextSelectionLeft = t.buy.holder
end

-- Shows the top-up if the player is short for `price` by no more than the pack
-- gives. Returns whether it is showing.
function UI._offerTopUp(self, price, host)
	local t = self._topUp
	if not t or not host or not saveLoaded() then
		return false -- never push a Robux offer before the save loaded
	end
	local short = math.floor((tonumber(price) or 0) - attrNumber("Gems", 0))
	if short <= 0 or short > Config.Products.GemTopUp.Gems then
		return false
	end
	t.price = price
	t.host = host
	t.strip.Parent = host
	local y
	if host == self._menu.panel then
		-- Bottom of the panel, just above the footer.
		t.strip.AnchorPoint = Vector2.new(0.5, 1)
		y = -(FOOTER_H + 4)
		t.strip.Position = UDim2.new(0.5, 0, 1, y + 8)
		t.strip.Size = UDim2.new(1, -12, 0, TOPUP_H)
		tween(t.strip, 0.2, { Position = UDim2.new(0.5, 0, 1, y) })
	else
		-- Stacked on top of the boost popover.
		t.strip.AnchorPoint = Vector2.new(0, 1)
		t.strip.Position = UDim2.new(0, 0, 0, 2)
		t.strip.Size = UDim2.new(1, 0, 0, TOPUP_H)
		tween(t.strip, 0.2, { Position = UDim2.new(0, 0, 0, -6) })
	end
	t.shown = nil
	local selected = GuiService.SelectedObject
	if selected == nil or not selected:IsDescendantOf(t.strip) then
		t.returnTo = selected
	end
	t.strip.Visible = true
	self:_refreshTopUp()
	if t.strip.Visible then
		self:_syncBack()
		self:_focus(t.buy.holder)
	end
	return t.strip.Visible
end

function UI._refreshTopUp(self)
	local t = self._topUp
	if not t or not t.strip.Visible or not t.price then
		return
	end
	local short = math.floor(t.price - attrNumber("Gems", 0))
	if short <= 0 or short > Config.Products.GemTopUp.Gems then
		self:_hideTopUp()
		return
	end
	if short ~= t.shown then
		t.shown = short
		t.short.Text = "SHORT BY " .. commas(short) .. " GEMS"
	end
end

function UI._hideTopUp(self)
	local t = self._topUp
	if t then
		local wasOpen = t.strip.Visible
		t.host = nil
		t.price = nil
		t.strip.Visible = false
		if wasOpen then
			self:_syncBack()
			self:_returnFocus(t.strip, t.returnTo)
		end
	end
end

function UI._buildMenuPanel(self, root)
	local m = self._menu
	local panel = new("Frame", {
		Name = "Panel",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.03,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(EDGE + 4), 0.5, 0),
		Size = UDim2.fromOffset(290, 300),
		Parent = root,
	})
	fit(panel)
	stroke(panel, 1.5)
	cropMarks(panel, 8, 4)
	notch(panel, 14, 1, 1)
	m.panel = panel

	-- Tabs
	m.tabs = {}
	local names = TAB_NAMES
	for i, name in names do
		local button = new("TextButton", {
			Name = "Tab" .. name,
			AutoButtonColor = false,
			Text = "",
			Selectable = true,
			BackgroundColor3 = INK,
			BackgroundTransparency = 1,
			Position = UDim2.new((i - 1) / #names, 0, 0, 0),
			Size = UDim2.new(1 / #names, 0, 0, TAB_H),
			Parent = panel,
		})
		local index = text({ Text = twoDigits(i), TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(5, 5), Size = UDim2.fromOffset(30, 9), Parent = button })
		local label = capText(text({
			Text = name,
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(3, 16),
			Size = UDim2.new(1, -6, 0, 20),
			Parent = button,
		}), 11, 5)
		local bar = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3), Visible = false, Parent = button })
		setAccent(bar, "BackgroundColor3")
		-- "Something to claim here" marker.
		local pip = new("Frame", {
			Name = "Pip",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(7, 7),
			Rotation = 45,
			Visible = false,
			Parent = button,
		})
		setAccent(pip, "BackgroundColor3")
		stroke(pip, 1)
		if i > 1 then
			rule(button, { Size = UDim2.new(0, 1, 1, 0), BackgroundTransparency = 0.6 })
		end
		local page = new("ScrollingFrame", {
			Name = name .. "Page",
			Active = true,
			Selectable = false, -- gamepad selection goes to the buttons inside; the page scrolls to follow it
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, TAB_H + 1),
			Size = UDim2.new(1, 0, 1, -(TAB_H + 1 + FOOTER_H)),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = INK,
			VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
			Visible = false,
			Parent = panel,
		})
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 9),
			PaddingRight = UDim.new(0, 6),
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 10),
			Parent = page,
		})
		list(page, 6)
		button.Activated:Connect(function()
			self:_selectTab(i)
		end)
		m.tabs[i] = { button = button, index = index, label = label, bar = bar, pip = pip, page = page, name = name }
	end
	rule(panel, { Position = UDim2.fromOffset(0, TAB_H) })
	-- Gamepad: the tabs row is one straight line; LEFT off the first tab goes back to PLAY.
	for i, tab in m.tabs do
		tab.button.NextSelectionLeft = if i > 1 then m.tabs[i - 1].button else m.play and m.play.holder
		tab.button.NextSelectionRight = if i < #m.tabs then m.tabs[i + 1].button else nil
	end

	-- Footer
	local footer = new("Frame", { Name = "Footer", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, FOOTER_H), Parent = panel })
	rule(footer, { BackgroundTransparency = 0.5 })
	m.footer = text({ Text = "SHEET 01 / " .. twoDigits(#names), TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(9, 1), Size = UDim2.new(0.5, -9, 1, -1), Parent = footer })
	m.footerSpec = text({
		Text = "SHATTER RUN / SPEC",
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 1),
		Size = UDim2.new(0.5, -22, 1, -1),
		Parent = footer,
	})
	-- Same spot, controller only.
	m.footerHint = inputHint(footer, { { "A", "SELECT" }, { "B", "BACK" } }, {
		Position = UDim2.new(0.4, 0, 0, 2),
		Size = UDim2.new(0.6, -22, 1, -4),
	}, Enum.HorizontalAlignment.Right)

	-- Save didn't load: a strip above the footer (pages shrink to make room,
	-- see _refreshSaveState). Robux buttons are off until they rejoin.
	local banner = new("Frame", {
		Name = "SaveBanner",
		BackgroundColor3 = INK,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -FOOTER_H),
		Size = UDim2.new(1, 0, 0, SAVE_BANNER_H),
		Visible = false,
		Parent = panel,
	})
	hatch(banner, { Name = "Hatch", Size = UDim2.new(0, 8, 1, 0) }, PAPER, 0.45, 3)
	capText(setAccent(text({
		Text = "YOUR SAVE DIDN'T LOAD",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(16, 4),
		Size = UDim2.new(1, -24, 0, 16),
		Parent = banner,
	}), "TextColor3"), 11, 7)
	text({
		Text = "REJOIN BEFORE BUYING / ROBUX SHOP IS OFF UNTIL THEN",
		TextSize = 8,
		TextColor3 = PAPER,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(16, 21),
		Size = UDim2.new(1, -24, 0, 11),
		Parent = banner,
	})
	m.saveBanner = banner

	-- 01 PLAY: global top runs + upgrades
	local playPage = m.tabs[1].page
	local _, runsRight = sectionHeader(playPage, 1, "01.1", "TOP RUNS")
	runsRight.Text = "GLOBAL / TOP 10"
	m.runs = new("Frame", { Name = "Runs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = playPage })
	list(m.runs, 0)
	m.passHeader = sectionHeader(playPage, 3, "01.2", "UPGRADES")
	m.passes = new("Frame", { Name = "Passes", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = playPage })
	list(m.passes, 8)

	-- 02 MISSIONS
	self:_buildMissionsPage(m.tabs[TAB_MISSIONS].page)

	-- 03 SEASON
	self:_buildSeasonPage(m.tabs[TAB_SEASON].page)

	-- 04 ZONES
	local zonesPage = m.tabs[4].page
	local _, zonesRight = sectionHeader(zonesPage, 1, "04.1", "ZONES")
	m.zonesRight = zonesRight
	m.zones = new("Frame", { Name = "Zones", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = zonesPage })
	list(m.zones, 0)

	-- 05 SHOP
	local shopPage = m.tabs[5].page
	if #(Config.PremiumBalls or {}) > 0 then
		self:_buildPremiumBalls(shopPage, -20)
	end
	local starter = Config.Products.StarterPack
	if starter and starter.Id ~= 0 then
		m.starterHeader = sectionHeader(shopPage, 1, "05.0", "STARTER PACK")
		m.starterCard = self:_buildStarterCard(shopPage, 2)
	end
	local _, gemsRight = sectionHeader(shopPage, 3, "05.1", "GEMS")
	m.shopGems = gemsRight
	for i, key in GEM_PACKS do
		local product = Config.Products[key]
		if product and product.Id ~= 0 then
			self:_buildGemPack(shopPage, 3 + i, key)
		end
	end
	local _, skinsRight = sectionHeader(shopPage, 10, "05.2", "BALL SKINS")
	m.skinsRight = skinsRight
	local grid = new("Frame", { Name = "Skins", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 11, Parent = shopPage })
	new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 162),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	m.skinCards = {}
	local skinButtons = {}
	for order, skin in Config.Skins do
		if not skin.Premium then -- premium balls have their own section (Robux only)
			local entry = self:_buildSkinCard(grid, skin, order)
			m.skinCards[skin.Id] = entry
			table.insert(skinButtons, entry.button.holder)
		end
	end
	linkGrid(skinButtons, 2)

	local _, fxRight = sectionHeader(shopPage, 12, "05.3", "SHATTER FX")
	m.fxRight = fxRight
	text({
		Text = "THE COLOR YOUR GLASS SHARDS TURN WHEN YOU BREAK THEM",
		TextSize = 8,
		TextColor3 = GREY,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 12),
		LayoutOrder = 13,
		Parent = shopPage,
	})
	local fxGrid = new("Frame", { Name = "Fx", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 14, Parent = shopPage })
	new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 142),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = fxGrid,
	})
	m.fxCards = {}
	local fxButtons = {}
	for order, fx in Config.ShatterFx do
		local entry = self:_buildFxCard(fxGrid, fx, order)
		m.fxCards[fx.Id] = entry
		table.insert(fxButtons, entry.button.holder)
	end
	linkGrid(fxButtons, 2)
	-- Between the two grids: straight down from the last skins to the first effects and back.
	if #skinButtons > 0 and #fxButtons > 0 then
		local lastRowStart = #skinButtons - (#skinButtons - 1) % 2
		for i = lastRowStart, #skinButtons do
			skinButtons[i].NextSelectionDown = fxButtons[math.min(i - lastRowStart + 1, #fxButtons)]
		end
		for i = 1, math.min(2, #fxButtons) do
			fxButtons[i].NextSelectionUp = skinButtons[math.min(lastRowStart + i - 1, #skinButtons)]
		end
	end
end

function UI._buildGemPack(self, parent, order, key)
	key = key or "GemPack"
	local product = Config.Products[key]
	local card = new("Frame", { Name = key, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = order, Parent = parent })
	stroke(card, 1, INK, if product.Badge then 0 else 0.5)
	notch(card, 10, 0, 0)
	if product.Badge then
		stamp(card, string.upper(product.Badge), {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -92, 0, 1),
			Size = UDim2.fromOffset(78, 17),
			Rotation = -4,
		}, "accent")
	end
	gemIcon(card, 20, UDim2.fromOffset(28, 30))
	capText(text({
		Text = "+" .. commas(product.Gems) .. " GEMS",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(52, 12),
		Size = UDim2.new(1, -140, 0, 20),
		Parent = card,
	}), 14, 8)
	text({ Text = "GEM PACK / INSTANT", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(52, 34), Size = UDim2.new(1, -140, 0, 10), Parent = card })
	local buy = hardButton(card, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY",
		TextSize = 12,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(78, 50),
		OnClick = function()
			self:_fire("onBuyProduct", key)
		end,
	})
	self:_robuxButton(buy)
	withPrice(product.Id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
end

-- What the starter pack contains, as three annotated lines.
local function starterLines(product)
	local lines = {}
	if product.Gems then
		table.insert(lines, { reward = { Gems = product.Gems }, text = "+" .. commas(product.Gems) .. " GEMS" })
	end
	if product.Skin then
		table.insert(lines, { reward = { Skin = product.Skin }, text = skinName(product.Skin) .. " BALL SKIN" })
	end
	if product.Fx then
		table.insert(lines, { reward = { Fx = product.Fx }, text = fxName(product.Fx) .. " SHATTER FX" })
	end
	return lines
end

-- Shop card for the one-time starter pack. Hidden once bought.
function UI._buildStarterCard(self, parent, order)
	local product = Config.Products.StarterPack
	local card = new("Frame", { Name = "StarterPack", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 92), LayoutOrder = order, Parent = parent })
	notch(card, 12, 1, 0)
	setAccent(text({ Text = "ONE-TIME PACK / NEW PLAYERS", TextSize = 8, Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -110, 0, 10), Parent = card }), "TextColor3")
	for i, line in starterLines(product) do
		local y = 22 + (i - 1) * 22
		rewardChip(card, line.reward, 10, UDim2.fromOffset(16, y + 8))
		capText(text({ Text = line.text, Font = FONT_NUM, TextColor3 = PAPER, Position = UDim2.fromOffset(28, y), Size = UDim2.new(1, -124, 0, 16), Parent = card }), 10, 6)
	end
	local buy = hardButton(card, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY",
		TextSize = 12,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 4),
		Size = UDim2.fromOffset(84, 56),
		OnClick = function()
			self:_fire("onBuyProduct", "StarterPack")
		end,
	})
	self:_robuxButton(buy)
	withPrice(product.Id, Enum.InfoType.Product, function(price)
		if buy.sub.Parent then
			buy.sub.Text = "R$ " .. commas(price)
		end
	end)
	return card
end

-- Shop card for a shatter effect: same anatomy as the ball skin cards.
function UI._buildFxCard(self, parent, fx, order)
	local card = new("Frame", { Name = fx.Id, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local outline = stroke(card, 1, INK, 0.5)
	local swatch = fxSwatch(card, fx, { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 42) })
	text({ Text = "FX-" .. twoDigits(order), TextSize = 8, TextColor3 = PAPER, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(40, 10), Parent = swatch })
	local finish = if fx.Rainbow then "PRISM" elseif fx.Neon then "NEON" elseif fx.Metal then "METAL" elseif fx.Sparkle then "SPARKLE" else "GLASS"
	text({
		Text = finish,
		TextSize = 8,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -64, 0, 2),
		Size = UDim2.fromOffset(60, 10),
		Parent = swatch,
	})
	capText(text({ Text = string.upper(fx.Name), Font = FONT_NUM, Position = UDim2.fromOffset(6, 53), Size = UDim2.new(1, -12, 0, 16), Parent = card }), 12, 7)
	local price = text({
		Text = if fx.Price > 0 then commas(fx.Price) .. " GEMS" else "STANDARD ISSUE",
		TextSize = 9,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(6, 70),
		Size = UDim2.new(1, -12, 0, 12),
		Parent = card,
	})
	local entry = { fx = fx, outline = outline, price = price, busy = false }
	entry.button = hardButton(card, {
		Name = "Action",
		Fill = "ink",
		Text = "BUY",
		TextSize = 11,
		Position = UDim2.fromOffset(6, 86),
		Size = UDim2.new(1, -12, 0, 50),
		OnClick = function()
			self:_fxAction(entry)
		end,
	})
	return entry
end

function UI._buildSkinCard(self, parent, skin, order)
	local card = new("Frame", { Name = skin.Id, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local outline = stroke(card, 1, INK, 0.5)

	local swatch = new("Frame", { Name = "Swatch", BackgroundColor3 = skin.Color, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 58), Parent = card })
	stroke(swatch, 1)
	if skin.Rainbow then
		local keys = {}
		for i = 0, 6 do
			table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)))
		end
		new("UIGradient", { Color = ColorSequence.new(keys), Rotation = 20, Parent = swatch })
	end
	if skin.Trail then
		new("Frame", { Name = "Trail", BackgroundColor3 = skin.Trail, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 6), Parent = swatch })
	end
	-- Sample crosshair
	local dark = (skin.Color.R + skin.Color.G + skin.Color.B) < 1.2
	local markColor = if dark then PAPER else INK
	rule(swatch, { BackgroundColor3 = markColor, BackgroundTransparency = 0.55, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 1) })
	rule(swatch, { BackgroundColor3 = markColor, BackgroundTransparency = 0.55, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1, 14) })
	text({ Text = "S-" .. twoDigits(order), TextSize = 8, TextColor3 = markColor, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(40, 10), Parent = swatch })
	text({
		Text = string.upper(skin.Material.Name),
		TextSize = 8,
		TextColor3 = markColor,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -64, 0, 2),
		Size = UDim2.fromOffset(60, 10),
		Parent = swatch,
	})

	capText(text({ Text = string.upper(skin.Name), Font = FONT_NUM, Position = UDim2.fromOffset(6, 70), Size = UDim2.new(1, -12, 0, 16), Parent = card }), 12, 7)
	local price = text({
		Text = if skin.Price > 0 then commas(skin.Price) .. " GEMS" elseif skin.Source then "LOCKED" else "STANDARD ISSUE",
		TextSize = 9,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(6, 88),
		Size = UDim2.new(1, -12, 0, 12),
		Parent = card,
	})

	local entry = { skin = skin, outline = outline, price = price, busy = false }
	entry.button = hardButton(card, {
		Name = "Action",
		Fill = "ink",
		Text = "BUY",
		TextSize = 11,
		Position = UDim2.fromOffset(6, 106),
		Size = UDim2.new(1, -12, 0, 50),
		OnClick = function()
			self:_skinAction(entry)
		end,
	})
	return entry
end

function UI._selectTab(self, index)
	local m = self._menu
	m.tab = index
	for i, tab in m.tabs do
		local active = i == index
		tab.button.BackgroundTransparency = if active then 0 else 1
		tab.label.TextColor3 = if active then PAPER else INK
		if active then
			setAccent(tab.index, "TextColor3")
		else
			clearAccent(tab.index)
			tab.index.TextColor3 = GREY
		end
		tab.bar.Visible = active
		tab.page.Visible = active
		if active then
			tab.page.CanvasPosition = Vector2.zero
			tab.page.Position = UDim2.fromOffset(14, TAB_H + 1)
			tween(tab.page, 0.22, { Position = UDim2.fromOffset(0, TAB_H + 1) })
			m.footer.Text = "SHEET " .. twoDigits(i) .. " / " .. twoDigits(#m.tabs) .. " / " .. tab.name
		end
	end
	if index == TAB_SEASON then
		self:_scrollSeasonTrack()
	end
	if self._topUp and self._topUp.host == m.panel then
		self:_hideTopUp()
	end
end

-- Popovers (daily streak, starter offer) ------------------------------------------------

-- A centered sheet with an ink header, like the run report. Active so taps on it
-- don't fall through to the wash (which closes the popover).
local function modalSheet(layer, name, width, height, index, title)
	local sheet = new("Frame", {
		Name = name,
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.02,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		Visible = false,
		Parent = layer,
	})
	sheet.Active = true
	-- Gamepad selection can't wander off the sheet to the menu underneath.
	sheet.SelectionGroup = true
	sheet.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
	sheet.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
	sheet.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
	sheet.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
	fit(sheet)
	stroke(sheet, 1.5)
	cropMarks(sheet, 10, 5)
	notch(sheet, 14, 1, 1, INK)
	local header = new("Frame", { Name = "Header", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 24), Parent = sheet })
	text({ Text = index .. " / " .. title, TextSize = 9, TextColor3 = PAPER, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.6, -10, 1, 0), Parent = header })
	local right = setAccent(text({
		Text = "",
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.4, 0, 0, 0),
		Size = UDim2.new(0.6, -10, 1, 0),
		Parent = header,
	}), "TextColor3")
	return sheet, right
end

function UI._buildModal(self, root)
	local m = self._menu
	local layer = new("Frame", { Name = "Modal", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	local wash = new("TextButton", {
		Name = "Wash",
		AutoButtonColor = false,
		Text = "",
		Selectable = false, -- tap-outside-to-close only; never a gamepad stop
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.25,
		Position = UDim2.fromOffset(-200, -200),
		Size = UDim2.new(1, 400, 1, 400),
		Parent = layer,
	})
	wash.Activated:Connect(function()
		self:_closeModal()
	end)
	blueprintGrid(layer, 12, 8, 0.9)
	m.modal = layer
	m.modalWash = wash
	m.sheets = {}
	self:_buildDailySheet(layer)
	self:_buildOfferSheet(layer)
end

function UI._openModal(self, name)
	local m = self._menu
	local sheet = m.sheets[name]
	if not sheet then
		return
	end
	for key, other in m.sheets do
		other.Visible = key == name
	end
	local selected = GuiService.SelectedObject
	if selected == nil or not selected:IsDescendantOf(m.modal) then
		m.modalReturn = selected
	end
	m.modalOpen = name
	m.modal.Visible = true
	m.modalWash.BackgroundTransparency = 1
	tween(m.modalWash, 0.25, { BackgroundTransparency = 0.25 })
	sheet.Position = UDim2.new(0.5, 0, 0.5, 16)
	tween(sheet, 0.3, { Position = UDim2.fromScale(0.5, 0.5) })
	self:_syncBack()
	self:_focus(self:_modalPrimary())
end

function UI._closeModal(self)
	local m = self._menu
	if not m.modalOpen then
		return
	end
	m.modalOpen = nil
	m.modal.Visible = false
	self:_syncBack()
	self:_returnFocus(m.modal, m.modalReturn)
end

-- The button a popover's gamepad selection starts on.
function UI._modalPrimary(self)
	local m = self._menu
	if m.modalOpen == "daily" then
		local d = self._dailySheet
		return if d.claim.enabled then d.claim.holder else d.close.holder
	elseif m.modalOpen == "offer" then
		return m.offerBuy and m.offerBuy.holder
	end
	return nil
end

function UI._openDaily(self)
	self._menu.dailyKey = nil
	self:_refreshDaily()
	self:_openModal("daily")
end

function UI._buildDailySheet(self, layer)
	local m = self._menu
	local days = #Config.DailyStreak
	local width, height = 400, 216
	local sheet, right = modalSheet(layer, "Daily", width, height, "06", "DAILY STREAK")
	m.sheets.daily = sheet
	local d = { sheet = sheet, right = right, cells = {} }
	self._dailySheet = d

	local gap = 6
	local cellW = math.floor((width - 24 - gap * (days - 1)) / days)
	local startX = math.floor((width - (cellW * days + gap * (days - 1))) / 2)
	for day = 1, days do
		local reward = Config.DailyStreak[day] or {}
		local cell = new("Frame", {
			Name = "Day" .. day,
			BackgroundColor3 = PAPER,
			Position = UDim2.fromOffset(startX + (day - 1) * (cellW + gap), 34),
			Size = UDim2.fromOffset(cellW, 96),
			Parent = sheet,
		})
		local outline = stroke(cell, 1, INK, 0.5)
		local bump = new("UIScale", { Parent = cell })
		local texts = {}
		table.insert(texts, text({ Text = "DAY " .. day, TextSize = 8, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 10), Parent = cell }))
		if reward.Fx then
			fxSwatch(cell, Config.getFx(reward.Fx), { Position = UDim2.fromOffset(4, 17), Size = UDim2.new(1, -8, 0, 26) }, 0.6)
		else
			gemIcon(cell, 12, UDim2.new(0.5, 0, 0, 30))
		end
		table.insert(texts, capText(text({
			Text = "+" .. commas(reward.Gems or 0),
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(2, 46),
			Size = UDim2.new(1, -4, 0, 16),
			Parent = cell,
		}), 11, 6))
		local extra = if reward.Fx
			then fxName(reward.Fx) .. " FX"
			elseif reward.Boost then "+" .. boostName(reward.Boost)
			elseif reward.Balls then "+" .. reward.Balls .. " BALLS"
			else "GEMS"
		table.insert(texts, text({
			Text = extra,
			TextSize = 7,
			TextColor3 = if reward.Fx or reward.Balls or reward.Boost then INK else GREY,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 63),
			Size = UDim2.new(1, 0, 0, 9),
			Parent = cell,
		}))
		local stateTag, stateLabel = tag(cell, "", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 14) })
		d.cells[day] = { frame = cell, outline = outline, bump = bump, tag = stateTag, tagLabel = stateLabel, texts = texts }
	end

	d.note = text({
		Text = "STREAK RESETS IF YOU MISS A DAY",
		TextSize = 8,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(12, 136),
		Size = UDim2.new(1, -24, 0, 10),
		Parent = sheet,
	})
	d.height = height
	d.close = hardButton(sheet, {
		Name = "Close",
		Fill = "paper",
		Text = "CLOSE",
		TextSize = 11,
		Position = UDim2.fromOffset(12, 152),
		Size = UDim2.fromOffset(96, 52),
		OnClick = function()
			self:_closeModal()
		end,
	})
	d.claim = hardButton(sheet, {
		Name = "Claim",
		Fill = "accent",
		Text = "CLAIM",
		TextSize = 13,
		Align = Enum.TextXAlignment.Left,
		Index = "CLAIM",
		Position = UDim2.fromOffset(116, 152),
		Size = UDim2.new(1, -128, 0, 52),
		OnClick = function()
			self:_claimDaily()
		end,
	})
	self:_buildStreakSaver(sheet)
end

-- Shown inside the daily sheet only while a broken streak can still be saved.
-- The sheet grows to make room; the claim row moves down under it.
local SAVER_H = 58

function UI._buildStreakSaver(self, sheet)
	local d = self._dailySheet
	local id = productId("StreakSaver")
	if id == 0 then
		return
	end
	local saver = new("Frame", {
		Name = "StreakSaver",
		BackgroundColor3 = INK,
		Position = UDim2.fromOffset(12, 150),
		Size = UDim2.new(1, -24, 0, SAVER_H - 4),
		Visible = false,
		Parent = sheet,
	})
	-- Text block is vertically centred in the taller strip.
	local textTop = math.floor((SAVER_H - 4 - 32) / 2)
	hatch(saver, { Name = "Hatch", Size = UDim2.new(0, 8, 1, 0) }, PAPER, 0.45, 3)
	notch(saver, 8, 1, 0)
	d.saverTitle = capText(setAccent(text({
		Text = "",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(18, textTop),
		Size = UDim2.new(1, -118, 0, 20),
		Parent = saver,
	}), "TextColor3"), 12, 7)
	text({
		Text = "YOU MISSED A DAY / KEEP YOUR STREAK GOING",
		TextSize = 7,
		TextColor3 = PAPER,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, textTop + 22),
		Size = UDim2.new(1, -118, 0, 10),
		Parent = saver,
	})
	local buy = hardButton(saver, {
		Name = "Save",
		Fill = "accent",
		Text = "SAVE",
		TextSize = 11,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -2, 0.5, 0),
		Size = UDim2.fromOffset(92, 50),
		OnClick = function()
			-- CLAIM stays off until this purchase is done (see _saverPending), so a
			-- tap on CLAIM can't restart the streak before the saver lands.
			self._saverPendingUntil = os.clock() + SAVER_PROMPT_WAIT
			self:_refreshDaily()
			self:_fire("onBuyProduct", "StreakSaver")
		end,
	})
	self:_robuxButton(buy)
	d.saverBuy = buy
	withPrice(id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
	d.saver = saver
end

function UI._layoutStreakSaver(self, saveDay)
	local d = self._dailySheet
	local show = saveDay ~= nil and d.saver ~= nil
	if d.saver then
		d.saver.Visible = show
		if show then
			d.saverTitle.Text = "SAVE YOUR DAY " .. saveDay .. " STREAK"
		end
	end
	local extra = if show then SAVER_H else 0
	d.sheet.Size = UDim2.fromOffset(d.sheet.Size.X.Offset, d.height + extra)
	d.close.holder.Position = UDim2.fromOffset(12, 152 + extra)
	d.claim.holder.Position = UDim2.fromOffset(116, 152 + extra)
	-- Gamepad: UP from the bottom row reaches the SAVE button while it shows.
	local saverButton = if show then d.saverBuy.holder else nil
	d.close.holder.NextSelectionUp = saverButton
	d.claim.holder.NextSelectionUp = saverButton
	if d.saverBuy then
		d.saverBuy.holder.NextSelectionDown = d.claim.holder
	end
	if not show then
		d.restartArmedUntil = nil
	end
end

-- True while a streak saver purchase is on its way (prompt open, or paid and
-- waiting for the server). CLAIM stays off meanwhile; see _tickDailySheet.
function UI._saverPending(self)
	local untilTime = self._saverPendingUntil
	if untilTime and os.clock() < untilTime then
		return true
	end
	self._saverPendingUntil = nil
	return false
end

-- Day cell states; only runs when the streak day / readiness changes.
function UI._refreshDailySheet(self, state)
	local d = self._dailySheet
	if not d then
		return
	end
	for day, cell in d.cells do
		local done = day < state.day
		local today = day == state.day
		if today then
			setAccent(cell.frame, "BackgroundColor3")
		else
			clearAccent(cell.frame)
			cell.frame.BackgroundColor3 = PAPER
		end
		cell.outline.Thickness = if today then 2 else 1
		cell.outline.Transparency = if today or done then 0 else 0.5
		for _, label in cell.texts do
			label.TextTransparency = if done then 0.55 else 0
		end
		cell.tag.Visible = done or today
		cell.tagLabel.Text = if done then "DONE" elseif state.ready then "TODAY" else "NEXT"
	end
	d.right.Text = "DAY " .. state.day .. " OF " .. #Config.DailyStreak
	d.note.Text = if state.saveDay
		then "STREAK BROKEN / SAVE IT, OR CLAIMING RESTARTS AT DAY 1"
		elseif state.broken then "STREAK RESTARTED AT DAY 1 / CLAIM EVERY DAY TO KEEP IT"
		else "STREAK RESETS IF YOU MISS A DAY"
	self:_layoutStreakSaver(state.saveDay)
end

-- Claim button / countdown; runs every second while the menu is open.
function UI._tickDailySheet(self, state)
	local d = self._dailySheet
	if not d or self._dailyBusy then
		return
	end
	local reward = Config.DailyStreak[state.day] or {}
	local gems = commas(reward.Gems or 0)
	-- While the streak can still be saved, claiming would restart it at day 1,
	-- so the button says exactly that and asks twice.
	local restart = state.ready and state.saveDay ~= nil
	local mode
	if not state.ready then
		mode = "wait"
	elseif restart and self:_saverPending() then
		mode = "pending"
	elseif restart and d.restartArmedUntil and os.clock() < d.restartArmedUntil then
		mode = "confirm"
	elseif restart then
		mode = "restart"
	else
		mode = "claim"
	end
	if mode ~= d.mode then
		d.mode = mode
		d.claim.setFill(if mode == "claim" or mode == "confirm" then "accent" else "paper")
		d.claim.setEnabled(mode ~= "wait" and mode ~= "pending")
	end
	if mode == "wait" then
		d.claim.index.Text = "NEXT CLAIM IN"
		d.claim.setText(if state.wait then clock(state.wait) else "--:--:--")
	elseif mode == "pending" then
		d.claim.index.Text = "STREAK SAVER / ON ITS WAY"
		d.claim.setText("SAVING STREAK...")
	elseif mode == "confirm" then
		d.claim.index.Text = "SURE? YOUR STREAK GOES BACK TO DAY 1"
		d.claim.setText("TAP AGAIN TO RESTART")
	elseif mode == "restart" then
		d.claim.index.Text = "SKIP THE SAVER / CLAIM +" .. gems .. " GEMS"
		d.claim.setText("RESTART AT DAY 1")
	else
		d.claim.index.Text = "CLAIM / DAY " .. state.day
		d.claim.setText("CLAIM +" .. gems .. " GEMS")
	end
end

function UI._buildOfferSheet(self, layer)
	local product = Config.Products.StarterPack
	if not product or product.Id == 0 then
		return
	end
	local m = self._menu
	local sheet, right = modalSheet(layer, "Offer", 400, 218, "07", "STARTER PACK")
	right.Text = "ONE-TIME PACK"
	m.sheets.offer = sheet

	text({ Text = "A HEAD START FOR NEW PLAYERS / ONCE PER ACCOUNT", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(12, 30), Size = UDim2.fromOffset(240, 10), Parent = sheet })
	for i, line in starterLines(product) do
		local row = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 44 + (i - 1) * 30), Size = UDim2.fromOffset(236, 28), Parent = sheet })
		rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.6 })
		rewardChip(row, line.reward, 14, UDim2.fromOffset(10, 14))
		capText(text({ Text = line.text, Font = FONT_NUM, Position = UDim2.fromOffset(26, 4), Size = UDim2.new(1, -26, 0, 20), Parent = row }), 12, 7)
	end

	-- Previews: the skin as a sample plate, the effect as shards.
	local skin = product.Skin and Config.getSkin(product.Skin)
	if skin then
		local plate = new("Frame", { Name = "SkinPreview", BackgroundColor3 = skin.Color, Position = UDim2.fromOffset(260, 34), Size = UDim2.fromOffset(128, 58), Parent = sheet })
		stroke(plate, 1)
		if skin.Trail then
			new("Frame", { BackgroundColor3 = skin.Trail, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 6), Parent = plate })
		end
		tag(plate, "SKIN", { Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(34, 12) })
	end
	if product.Fx then
		local swatch = fxSwatch(sheet, Config.getFx(product.Fx), { Position = UDim2.fromOffset(260, 96), Size = UDim2.fromOffset(128, 40) })
		local _, fxLabel = tag(swatch, "FX", { BackgroundColor3 = PAPER, Size = UDim2.fromOffset(24, 12) })
		fxLabel.TextColor3 = INK
	end

	text({ Text = "YOU CAN ALSO FIND THIS IN THE SHOP", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(12, 140), Size = UDim2.new(1, -24, 0, 10), Parent = sheet })
	hardButton(sheet, {
		Name = "Close",
		Fill = "paper",
		Text = "CLOSE",
		TextSize = 11,
		Position = UDim2.fromOffset(12, 156),
		Size = UDim2.fromOffset(96, 52),
		OnClick = function()
			self:_closeModal()
		end,
	})
	local buy = hardButton(sheet, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY PACK",
		TextSize = 13,
		Align = Enum.TextXAlignment.Left,
		Sub = "",
		Position = UDim2.fromOffset(116, 156),
		Size = UDim2.new(1, -128, 0, 52),
		OnClick = function()
			self:_fire("onBuyProduct", "StarterPack")
		end,
	})
	self:_robuxButton(buy)
	withPrice(product.Id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
	m.offerBuy = buy
end

-- Once per session, after the player's first run, if they haven't bought it.
function UI._maybeShowOffer(self)
	local m = self._menu
	if self._offerShown or not m.sheets.offer or m.modalOpen then
		return
	end
	if self._menuOpens < OFFER_AFTER_MENU_OPENS then
		return
	end
	if not saveLoaded() then
		return -- save not loaded (or failed to): we don't know if they own it
	end
	if player:GetAttribute("StarterPackBought") == true then
		self._offerShown = true
		return
	end
	self._offerShown = true
	self:_openModal("offer")
end

function UI._refreshStarter(self)
	local m = self._menu
	local bought = player:GetAttribute("StarterPackBought") == true
	-- Until the save loads we can't know whether they already bought it.
	local show = not bought and saveLoaded()
	if m.starterCard then
		m.starterCard.Visible = show
		m.starterHeader.Visible = show
	end
	if not show and m.modalOpen == "offer" then
		self:_closeModal()
	end
end

function UI._setTabPip(self, index, on)
	local tab = self._menu.tabs[index]
	if tab then
		tab.pip.Visible = on
	end
end

-- Missions ---------------------------------------------------------------------------------

function UI._buildMissionsPage(self, page)
	local m = self._menu
	local _, right = sectionHeader(page, 1, "02.1", "DAILY MISSIONS")
	m.missionsRight = right
	m.missions = new("Frame", { Name = "Missions", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = page })
	list(m.missions, 6)
	m.missionsReset = text({ Text = "", TextSize = 9, TextColor3 = GREY, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 3, Parent = page })
	local _, roadRight = sectionHeader(page, 4, "02.2", "LEVEL ROAD")
	m.roadRight = roadRight
	m.levelRoad = new("Frame", { Name = "LevelRoad", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = page })
	list(m.levelRoad, 0)
end

local function readMissions()
	local raw = player:GetAttribute("Missions")
	local decoded = decodeJson(raw)
	if type(decoded) ~= "table" then
		return nil, raw
	end
	local missions = {}
	for _, entry in decoded do
		if type(entry) == "table" and entry.id ~= nil then
			local goal = math.max(1, math.floor(tonumber(entry.goal) or 1))
			table.insert(missions, {
				id = entry.id,
				text = string.upper(tostring(entry.text or "MISSION")),
				goal = goal,
				progress = math.clamp(math.floor(tonumber(entry.progress) or 0), 0, goal),
				gems = math.floor(tonumber(entry.gems) or 0),
				xp = math.floor(tonumber(entry.xp) or 0),
				claimed = entry.claimed == true,
			})
		end
	end
	return missions, raw
end

-- Rebuilds only when the Missions JSON or the reroll count actually changed.
function UI._rebuildMissions(self, force)
	local m = self._menu
	local missions, raw = readMissions()
	local rerolls = math.max(0, math.floor(attrNumber("MissionRerolls", 0)))
	local key = tostring(raw) .. "|" .. rerolls
	if not force and key == m.missionsKey then
		return
	end
	m.missionsKey = key
	local focusPath = self:_captureFocus(m.missions)
	clearRows(m.missions)
	m.missionsRight.Text = rerolls .. (if rerolls == 1 then " REROLL" else " REROLLS") .. " LEFT"

	local claimable = 0
	if missions == nil or #missions == 0 then
		text({
			Text = if missions == nil then "LOADING" else "NO MISSIONS / CHECK BACK SOON",
			TextSize = 9,
			TextColor3 = GREY,
			Size = UDim2.new(1, 0, 0, 28),
			Parent = m.missions,
		})
	else
		for i, mission in missions do
			if mission.progress >= mission.goal and not mission.claimed then
				claimable += 1
			end
			self:_buildMissionRow(m.missions, i, mission, rerolls)
		end
	end
	self:_setTabPip(TAB_MISSIONS, claimable > 0)
	self:_restoreFocus(m.missions, focusPath, m.tabs[TAB_MISSIONS].button)
end

function UI._buildMissionRow(self, parent, index, mission, rerolls)
	local complete = mission.progress >= mission.goal
	local ready = complete and not mission.claimed
	local row = new("Frame", { Name = "Mission" .. index, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 72), LayoutOrder = index, Parent = parent })
	stroke(row, if ready then 1.5 else 1, INK, if mission.claimed then 0.75 elseif ready then 0 else 0.5)
	if ready then
		local bar = new("Frame", { Size = UDim2.new(0, 4, 1, 0), Parent = row })
		setAccent(bar, "BackgroundColor3")
	end
	local fade = if mission.claimed then 0.5 else 0

	text({ Text = "M-" .. twoDigits(index), TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(10, 5), Size = UDim2.fromOffset(40, 10), Parent = row })
	text({
		Text = commas(mission.progress) .. " / " .. commas(mission.goal),
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(50, 5),
		Size = UDim2.new(1, -152, 0, 10),
		Parent = row,
	})
	capText(text({
		Text = mission.text,
		Font = FONT_NUM,
		TextTransparency = fade,
		Position = UDim2.fromOffset(10, 16),
		Size = UDim2.new(1, -112, 0, 18),
		Parent = row,
	}), 11, 6)
	local _, fill = meter(row, { Position = UDim2.fromOffset(10, 39), Size = UDim2.new(1, -112, 0, 5) })
	fill.Size = UDim2.fromScale(mission.progress / mission.goal, 1)
	if mission.claimed then
		clearAccent(fill)
		fill.BackgroundColor3 = INK
		fill.BackgroundTransparency = 0.6
	end
	gemIcon(row, 7, UDim2.fromOffset(14, 57))
	text({
		Text = "+" .. commas(mission.gems) .. " GEMS   +" .. commas(mission.xp) .. " XP",
		TextSize = 9,
		TextTransparency = fade,
		Position = UDim2.fromOffset(24, 50),
		Size = UDim2.new(1, -126, 0, 14),
		Parent = row,
	})

	if mission.claimed then
		stamp(row, "CLAIMED", { Position = UDim2.new(1, -50, 0.5, 0), Size = UDim2.fromOffset(82, 24) }, "clear")
	elseif complete then
		local button
		button = hardButton(row, {
			Name = "Claim",
			Fill = "accent",
			Text = "CLAIM",
			TextSize = 12,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 52),
			OnClick = function()
				self:_missionAction("ClaimMission", mission, button, "CLAIMING")
			end,
		})
	elseif rerolls > 0 then
		local button
		button = hardButton(row, {
			Name = "Reroll",
			Fill = "paper",
			Text = "REROLL",
			TextSize = 10,
			Sub = "SWAP MISSION",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 50),
			OnClick = function()
				self:_missionAction("RerollMission", mission, button, "...")
			end,
		})
		button.sub.TextSize = 7
	elseif productId("ExtraReroll") ~= 0 then
		-- Out of free rerolls: one more can be bought.
		local button = hardButton(row, {
			Name = "BuyReroll",
			Fill = "paper",
			Text = "REROLL",
			TextSize = 10,
			Sub = "R$ --",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 50),
			OnClick = function()
				-- The mission id rides along so the controller can swap this
				-- mission as soon as the reroll is granted.
				self:_fire("onBuyProduct", "ExtraReroll", mission.id)
			end,
		})
		self:_robuxButton(button)
		button.sub.TextSize = 7
		withPrice(productId("ExtraReroll"), Enum.InfoType.Product, function(price)
			if button.sub.Parent then
				button.sub.Text = "R$ " .. commas(price)
			end
		end)
	else
		capText(text({
			Text = math.floor(mission.progress / mission.goal * 100) .. "%",
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 30),
			Parent = row,
		}), 16, 8)
	end
end

function UI._missionAction(self, action, mission, button, busyText)
	local m = self._menu
	if m.missionBusy then
		return
	end
	m.missionBusy = true
	button.setEnabled(false)
	button.setText(busyText)
	task.spawn(function()
		local ok, message = self:_ask("onShop", action, mission.id)
		m.missionBusy = false
		if not ok then
			self:toast(message or (if action == "ClaimMission" then "COULD NOT CLAIM" else "COULD NOT REROLL"), "error")
		end
		self:_rebuildMissions(true)
	end)
end

-- Every level unlock in order, with how far away it is.
function UI._rebuildLevelRoad(self)
	local m = self._menu
	if not m.levelRoad then
		return
	end
	clearRows(m.levelRoad)
	local level = levelInfo()
	m.roadRight.Text = "+" .. Config.LEVEL_UP_GEMS .. " GEMS EVERY LEVEL"
	local levels = {}
	for unlockLevel in Config.LevelUnlocks do
		table.insert(levels, unlockLevel)
	end
	table.sort(levels)
	local upcoming = nextUnlock(level)
	for i, unlockLevel in levels do
		local reward = Config.LevelUnlocks[unlockLevel]
		local reached = level >= unlockLevel
		local row = new("Frame", { Name = "Lv" .. unlockLevel, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = i, Parent = m.levelRoad })
		rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.8 })
		if unlockLevel == upcoming then
			local bar = new("Frame", { Size = UDim2.new(0, 3, 1, -6), Position = UDim2.fromOffset(0, 3), Parent = row })
			setAccent(bar, "BackgroundColor3")
		end
		capText(text({
			Text = "LV " .. twoDigits(unlockLevel),
			Font = FONT_NUM,
			TextTransparency = if reached or unlockLevel == upcoming then 0 else 0.45,
			Position = UDim2.fromOffset(8, 6),
			Size = UDim2.fromOffset(52, 18),
			Parent = row,
		}), 10, 7)
		rewardChip(row, reward, 10, UDim2.fromOffset(70, 15))
		text({
			Text = rewardText(reward),
			TextSize = 9,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextTransparency = if reached or unlockLevel == upcoming then 0 else 0.45,
			Position = UDim2.fromOffset(82, 0),
			Size = UDim2.new(1, -164, 1, 0),
			Parent = row,
		})
		local status = if reached then "UNLOCKED" elseif unlockLevel == upcoming then (unlockLevel - level) .. " LV TO GO" else "LOCKED"
		local statusTag, statusLabel = tag(row, status, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(76, 16) }, reached)
		if not reached then
			statusTag.BackgroundTransparency = 1
			statusLabel.TextColor3 = if unlockLevel == upcoming then INK else GREY
		end
	end
end

-- Season pass ------------------------------------------------------------------------------

function UI._buildSeasonPage(self, page)
	local m = self._menu
	local s = {}
	m.season = s
	local _, right = sectionHeader(page, 1, "03.1", "SEASON PASS")
	s.right = right

	local info = new("Frame", { Name = "Info", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 2, Parent = page })
	s.name = capText(text({ Text = Config.SEASON_NAME, Font = FONT_NUM, Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, 0, 0, 18), Parent = info }), 12, 7)
	s.tier = text({ Text = "TIER 00", TextSize = 9, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(0.5, 0, 0, 12), Parent = info })
	s.xp = text({
		Text = "",
		TextSize = 9,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 24),
		Size = UDim2.new(0.5, 0, 0, 12),
		Parent = info,
	})
	local _, fill = meter(info, { Position = UDim2.fromOffset(0, 39), Size = UDim2.new(1, 0, 0, 6) })
	s.fill = fill
	text({ Text = "EVERY RUN FILLS THE PASS / FREE ROW IS FOR EVERYONE", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(0, 49), Size = UDim2.new(1, 0, 0, 10), Parent = info })

	-- Premium unlock card (hidden once owned, or when the product isn't set up).
	local product = Config.Products.SeasonPremium
	local unlock = new("Frame", { Name = "Premium", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 3, Visible = false, Parent = page })
	notch(unlock, 10, 1, 0)
	capText(setAccent(text({ Text = "PREMIUM TRACK", Font = FONT_NUM, Position = UDim2.fromOffset(10, 7), Size = UDim2.new(1, -112, 0, 16), Parent = unlock }), "TextColor3"), 11, 7)
	text({
		Text = "UNLOCKS THE PREMIUM ROW FOR THIS SEASON: SKINS, FX AND MORE GEMS. TIERS YOU ALREADY REACHED CAN BE CLAIMED RIGHT AWAY.",
		TextSize = 7,
		TextColor3 = PAPER,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(10, 26),
		Size = UDim2.new(1, -112, 0, 36),
		Parent = unlock,
	})
	local buy = hardButton(unlock, {
		Name = "Unlock",
		Fill = "accent",
		Text = "UNLOCK",
		TextSize = 11,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 2),
		Size = UDim2.fromOffset(92, 54),
		OnClick = function()
			self:_fire("onBuyProduct", "SeasonPremium")
		end,
	})
	self:_robuxButton(buy)
	withPrice(product and product.Id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
	s.unlock = unlock
	s.active = tag(page, "PREMIUM TRACK ACTIVE", { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Visible = false }, true)
	-- Last days of a season: premium isn't sold any more, and this says why.
	s.closed, s.closedLabel = tag(page, "PREMIUM CLOSED / SEASON ENDS SOON", { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Visible = false })

	local _, trackRight = sectionHeader(page, 4, "03.2", "REWARDS")
	s.trackRight = trackRight
	local holder = new("Frame", { Name = "Track", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 146), LayoutOrder = 5, Parent = page })
	for _, rowInfo in { { "FREE", 23 }, { "PREMIUM", 81 } } do
		local label = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, rowInfo[2]), Size = UDim2.fromOffset(40, 53), Parent = holder })
		rule(label, { Size = UDim2.new(0, 2, 1, 0) })
		text({ Text = rowInfo[1], TextSize = 7, Position = UDim2.fromOffset(5, 0), Size = UDim2.new(1, -5, 1, 0), Parent = label })
	end
	local scroll = new("ScrollingFrame", {
		Name = "Tiers",
		Active = true,
		Selectable = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -42, 1, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = INK,
		HorizontalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = holder,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, SEASON_COLUMN_GAP),
		Parent = scroll,
	})
	s.scroll = scroll
end

local function readSeasonClaimed()
	local decoded = decodeJson(player:GetAttribute("SeasonClaimed"))
	local claimed = { Free = {}, Premium = {} }
	if type(decoded) == "table" then
		for field, trackName in { free = "Free", premium = "Premium" } do
			local tiers = decoded[field]
			if type(tiers) == "table" then
				for _, tier in tiers do
					local n = tonumber(tier)
					if n then
						claimed[trackName][math.floor(n)] = true
					end
				end
			end
		end
	end
	return claimed
end

local function seasonProgress()
	local maxTier = #Config.SeasonTiers
	local tier = math.clamp(math.floor(attrNumber("SeasonTier", 0)), 0, maxTier)
	local need = math.max(1, Config.SEASON_TIER_XP)
	local xp = math.clamp(math.floor(attrNumber("SeasonXP", 0)), 0, need)
	return tier, xp, need, maxTier
end

function UI._refreshSeasonProgress(self)
	local s = self._menu.season
	local tier, xp, need, maxTier = seasonProgress()
	s.name.Text = string.upper(tostring(ReplicatedStorage:GetAttribute("SeasonName") or Config.SEASON_NAME))
	s.tier.Text = "TIER " .. twoDigits(tier) .. " / " .. maxTier
	local fraction = if tier >= maxTier then 1 else xp / need
	s.xp.Text = if tier >= maxTier then "PASS COMPLETE" else commas(xp) .. " / " .. commas(need) .. " XP TO TIER " .. (tier + 1)
	tween(s.fill, 0.4, { Size = UDim2.fromScale(fraction, 1) })
	if s.nextFill and s.nextFill.Parent then
		s.nextFill.Size = UDim2.fromScale(fraction, 1)
	end
end

-- Premium UNLOCK card: only once the save loaded (we must know they don't own
-- it), and never in the last SEASON_LAST_SALE of a season. Runs every second
-- with the countdowns, so the card goes away on time.
function UI._refreshSeasonUnlock(self)
	local s = self._menu.season
	local premium = player:GetAttribute("SeasonPremium") == true
	local product = Config.Products.SeasonPremium
	local onSale = product ~= nil and product.Id ~= 0 and not premium and saveLoaded()
	local now = math.floor(workspace:GetServerTimeNow())
	local closed = seasonSaleClosed(now)
	local showUnlock = onSale and not closed
	local showClosed = onSale and closed
	if s.unlock.Visible ~= showUnlock then
		s.unlock.Visible = showUnlock
	end
	if s.closed.Visible ~= showClosed then
		s.closed.Visible = showClosed
	end
	if showClosed then
		s.closedLabel.Text = if seasonEnds() > now then "PREMIUM CLOSED / SEASON ENDS SOON" else "SEASON ENDED / NEW SEASON SOON"
	end
	s.active.Visible = premium
end

-- Rebuilds the 30-tier track only when tier, ownership or claims change.
function UI._rebuildSeason(self, force)
	local m = self._menu
	local s = m.season
	self:_refreshSeasonProgress()
	local tier, _, _, maxTier = seasonProgress()
	local premium = player:GetAttribute("SeasonPremium") == true
	local key = tier .. "|" .. tostring(premium) .. "|" .. tostring(player:GetAttribute("SeasonClaimed"))
	if not force and key == s.key then
		return
	end
	s.key = key
	local claimed = readSeasonClaimed()
	self:_refreshSeasonUnlock()

	local focusPath = self:_captureFocus(s.scroll)
	clearRows(s.scroll)
	local faces = { Free = {}, Premium = {} }
	s.nextFill = nil
	local claimable, firstClaimable = 0, nil
	for t = 1, maxTier do
		local rewards = Config.SeasonTiers[t] or {}
		local reached = t <= tier
		local column = new("Frame", { Name = "Tier" .. t, BackgroundTransparency = 1, Size = UDim2.fromOffset(SEASON_COLUMN_W, 138), LayoutOrder = t, Parent = s.scroll })
		local head = new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = if reached then 0 else 1, Size = UDim2.new(1, -3, 0, 18), Parent = column })
		if not reached then
			stroke(head, 1, INK, 0.6)
		end
		text({
			Text = "T" .. twoDigits(t),
			Font = FONT_NUM,
			TextSize = 9,
			TextColor3 = if reached then PAPER else INK,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = head,
		})
		if t == tier + 1 then
			local _, fill = meter(column, { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, -3, 0, 3) })
			s.nextFill = fill
		end
		for _, trackName in { "Free", "Premium" } do
			local reward = rewards[trackName]
			local state
			if reward == nil then
				state = "empty"
			elseif claimed[trackName][t] then
				state = "claimed"
			elseif trackName == "Premium" and not premium then
				state = "premiumLocked"
			elseif reached then
				state = "claimable"
			else
				state = "locked"
			end
			if state == "claimable" then
				claimable += 1
				firstClaimable = firstClaimable or t
			end
			faces[trackName][t] = self:_buildSeasonCell(column, if trackName == "Free" then 23 else 81, trackName, t, reward, state)
		end
	end
	self:_linkSeasonTrack(faces, maxTier)
	self:_restoreFocus(s.scroll, focusPath, m.tabs[TAB_SEASON].button)
	self:_refreshSeasonProgress()
	s.trackRight.Text = if claimable > 0 then claimable .. " TO CLAIM" else "SWIPE FOR ALL " .. maxTier .. " TIERS"
	s.focusTier = firstClaimable or math.min(tier + 1, maxTier)
	self:_setTabPip(TAB_SEASON, claimable > 0)
	self:_scrollSeasonTrack()
end

function UI._buildSeasonCell(self, column, y, trackName, tier, reward, state)
	local holder = new("Frame", { Name = trackName, BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 56), Parent = column })
	if state == "empty" then
		local blank = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -3, 1, -3), Parent = holder })
		stroke(blank, 1, INK, 0.85)
		text({ Text = "--", TextSize = 9, TextColor3 = GREY, TextTransparency = 0.4, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = blank })
		return nil
	end
	local claimable = state == "claimable"
	local locked = state == "locked" or state == "premiumLocked"
	if claimable then
		new("Frame", { Name = "Shadow", BackgroundColor3 = INK, Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -3, 1, -3), Parent = holder })
	end
	local face = new("TextButton", {
		Name = "Face",
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundColor3 = PAPER,
		BackgroundTransparency = if locked then 0.4 else 0,
		Size = UDim2.new(1, -3, 1, -3),
		Parent = holder,
	})
	stroke(face, if claimable then 1.5 else 1, INK, if claimable or state == "claimed" then 0 else 0.5)
	if claimable then
		setAccent(face, "BackgroundColor3")
	end
	if state == "premiumLocked" then
		hatch(face, { Name = "Hatch", Size = UDim2.new(0, 5, 1, 0) }, INK, 0.3, 3)
	end
	local dim = if claimable then 0 elseif state == "claimed" then 0.55 else 0.4
	rewardChip(face, reward, 9, UDim2.fromOffset(11, 9))

	local big, small
	if reward.Skin then
		big, small = skinName(reward.Skin), if reward.Fx then "SKIN + FX" else "SKIN"
	elseif reward.Fx then
		big, small = fxName(reward.Fx), "FX"
	elseif reward.Boost and not reward.Gems then
		big, small = boostName(reward.Boost), "BOOST"
	else
		big, small = "+" .. commas(reward.Gems or 0), if reward.Boost then "GEMS + BOOST" else "GEMS"
	end
	capText(text({
		Text = big,
		Font = FONT_NUM,
		TextTransparency = dim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(3, 16),
		Size = UDim2.new(1, -6, 0, 14),
		Parent = face,
	}), 10, 5)
	text({
		Text = small,
		TextSize = 7,
		TextTransparency = dim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 9),
		Parent = face,
	})
	local status = if claimable then "CLAIM" elseif state == "claimed" then "CLAIMED" elseif state == "premiumLocked" then "PREMIUM" else "LOCKED"
	local statusTag, statusLabel = tag(face, status, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -3), Size = UDim2.new(1, -6, 0, 11) })
	statusLabel.TextSize = 7
	if not claimable then
		statusTag.BackgroundTransparency = 1
		statusLabel.TextColor3 = if state == "claimed" then INK else GREY
	end

	face.Activated:Connect(function()
		if state == "claimable" then
			self:_claimSeasonTier(trackName, tier, statusLabel)
		elseif state == "premiumLocked" then
			self:toast("PREMIUM TRACK REWARD", "info")
		elseif state == "locked" then
			self:toast("REACH TIER " .. tier .. " TO CLAIM", "info")
		end
	end)
	return face
end

-- Gamepad: LEFT / RIGHT walk along a row (skipping empty slots), UP / DOWN hop
-- between the free and premium rows. The track scrolls to follow the selection.
function UI._linkSeasonTrack(self, faces, maxTier)
	local function nearest(row, from, step)
		local t = from + step
		while t >= 1 and t <= maxTier do
			if row[t] then
				return row[t]
			end
			t += step
		end
		return nil
	end
	local function closest(row, t)
		if row[t] then
			return row[t]
		end
		return nearest(row, t, -1) or nearest(row, t, 1)
	end
	for trackName, row in faces do
		local other = if trackName == "Free" then faces.Premium else faces.Free
		for t, face in row do
			face.NextSelectionLeft = nearest(row, t, -1)
			face.NextSelectionRight = nearest(row, t, 1)
			if trackName == "Free" then
				face.NextSelectionDown = closest(other, t)
			else
				face.NextSelectionUp = closest(other, t)
			end
		end
	end
end

function UI._claimSeasonTier(self, trackName, tier, statusLabel)
	local s = self._menu.season
	if s.busy then
		return
	end
	s.busy = true
	statusLabel.Text = "..."
	task.spawn(function()
		local ok, message = self:_ask("onShop", "ClaimSeasonTier", { track = trackName, tier = tier })
		s.busy = false
		if not ok then
			self:toast(message or "COULD NOT CLAIM", "error")
		end
		self:_rebuildSeason(true)
	end)
end

-- Bring the first claimable (or next) tier into view, one column of context on the left.
function UI._scrollSeasonTrack(self)
	local s = self._menu.season
	if not s or not s.focusTier then
		return
	end
	local focus = s.focusTier
	task.delay(0.1, function()
		if s.scroll.Parent then
			s.scroll.CanvasPosition = Vector2.new(math.max(0, (focus - 2) * (SEASON_COLUMN_W + SEASON_COLUMN_GAP)), 0)
		end
	end)
end

-- Missions reset + season end countdowns (ticked once a second while the menu is open).
function UI._refreshCountdowns(self)
	local m = self._menu
	local now = math.floor(workspace:GetServerTimeNow()) -- server clock, not the device clock
	local reset = tonumber(player:GetAttribute("MissionsReset"))
	if reset and reset > now then
		m.missionsReset.Text = "NEW MISSIONS IN " .. clock(reset - now)
	elseif reset then
		m.missionsReset.Text = "NEW MISSIONS ARRIVING"
	else
		m.missionsReset.Text = ""
	end
	local ends = seasonEnds()
	if ends > 0 then
		m.season.right.Text = if ends > now then "ENDS IN " .. longClock(ends - now) else "SEASON ENDED"
	else
		m.season.right.Text = ""
	end
	self:_refreshSeasonUnlock()
end

-- Menu data ---------------------------------------------------------------------------------

function UI._refreshStats(self)
	local m = self._menu
	m.best.Text = commas(player:GetAttribute("Best") or 0)
	local gems = commas(player:GetAttribute("Gems") or 0)
	m.gems.Text = gems
	m.shopGems.Text = "BALANCE " .. gems
	self:_refreshPlayIndex()
	self:_refreshSkins()
	self:_refreshFx()
	self:_refreshBoostPop()
	self:_refreshTopUp()
end

-- Level badge, XP bar and the "next unlock" note under the stats strip.
function UI._refreshLevel(self)
	local m = self._menu
	local level, xp, needed = levelInfo()
	m.level.Text = "LV " .. twoDigits(level)
	tween(m.xpFill, 0.4, { Size = UDim2.fromScale(xp / needed, 1) })
	local note = "XP " .. commas(xp) .. " / " .. commas(needed)
	local unlockLevel, reward = nextUnlock(level)
	if unlockLevel then
		note ..= " / NEXT: " .. rewardText(reward) .. " AT LV " .. unlockLevel
	end
	m.xpNote.Text = note
	if m.levelValue and level > m.levelValue and m.root.Visible then
		m.levelBump.Scale = 1.25
		tween(m.levelBump, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if level ~= m.levelValue then
		m.levelValue = level
		self:_rebuildLevelRoad()
	end
end

-- Streak state as the UI shows it. Claiming after StreakExpires restarts at day 1.
local function dailyState()
	local now = math.floor(workspace:GetServerTimeNow()) -- server clock, not the device clock
	local nextDaily = tonumber(player:GetAttribute("NextDaily"))
	local expires = tonumber(player:GetAttribute("StreakExpires"))
	local day = math.clamp(math.floor(attrNumber("StreakDay", 1)), 1, #Config.DailyStreak)
	local broken = expires ~= nil and expires > 0 and now > expires
	-- The streak saver only makes sense while the lost streak is still on record.
	-- If the server already reset StreakDay to 1 there is nothing left to save.
	local lostDay = math.floor(attrNumber("StreakDay", 1))
	local saveDay = nil
	if broken and lostDay > 1 and productId("StreakSaver") ~= 0 then
		saveDay = math.min(lostDay, #Config.DailyStreak)
	end
	if broken then
		day = 1
	end
	return {
		now = now,
		day = day,
		broken = broken,
		saveDay = saveDay,
		ready = nextDaily ~= nil and now >= nextDaily,
		wait = if nextDaily then nextDaily - now else nil,
	}
end

function UI._refreshDaily(self)
	local m = self._menu
	local daily = m.daily
	local state = dailyState()
	local reward = Config.DailyStreak[state.day] or {}

	-- Streak pips: done days ink, today accent, the rest outlined.
	local key = state.day .. (if state.ready then "R" else "W") .. (if state.broken then "B" else "") .. (state.saveDay or 0)
	if key ~= m.dailyKey then
		m.dailyKey = key
		for day, pip in m.dailyPips do
			local done = day < state.day
			local today = day == state.day
			if today then
				setAccent(pip.frame, "BackgroundColor3")
				pip.frame.BackgroundTransparency = 0
			else
				clearAccent(pip.frame)
				pip.frame.BackgroundColor3 = INK
				pip.frame.BackgroundTransparency = if done then 0 else 1
			end
			pip.stroke.Transparency = if done or today then 0 else 0.5
		end
		self:_refreshDailySheet(state)
	end

	if not self._dailyBusy then
		if state.ready ~= self._dailyReady then
			self._dailyReady = state.ready
			daily.setFill(if state.ready then "accent" else "paper")
		end
		daily.index.Text = if state.saveDay
			then "B / DAILY / STREAK BROKEN / SAVE IT"
			else "B / DAILY / DAY " .. state.day .. " OF " .. #Config.DailyStreak
		if state.ready then
			daily.setText("CLAIM +" .. commas(reward.Gems or 0))
		elseif state.wait then
			daily.setText(clock(state.wait))
		else
			daily.setText("--:--:--")
		end
	end
	self:_tickDailySheet(state)
end

function UI._claimDaily(self)
	local state = dailyState()
	if self._dailyBusy or not state.ready then
		return
	end
	local d = self._dailySheet
	if state.saveDay then
		-- Claiming now restarts a streak that could still be saved: never while
		-- a saver is being bought, and only on a second tap.
		if self:_saverPending() then
			return
		end
		if not (d.restartArmedUntil and os.clock() < d.restartArmedUntil) then
			d.restartArmedUntil = os.clock() + RESTART_CONFIRM_TIME
			self:_tickDailySheet(state)
			return
		end
	end
	d.restartArmedUntil = nil
	self._dailyBusy = true
	d.claim.setEnabled(false)
	d.claim.setText("CLAIMING")
	self._menu.daily.setText("CLAIMING")
	local claimedDay = dailyState().day
	task.spawn(function()
		local ok, message
		if type(self._callbacks.onClaimDaily) == "function" then
			ok, message = self:_ask("onClaimDaily")
		else
			ok, message = self:_ask("onShop", "ClaimDaily")
		end
		self._dailyBusy = false
		self._dailyReady = nil
		self._menu.dailyKey = nil
		d.mode = nil
		if ok then
			-- The server's Reward event toasts the amount; here the day gets stamped.
			local cell = d.cells[claimedDay]
			if cell then
				cell.bump.Scale = 1.2
				tween(cell.bump, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		else
			self:toast(message or "COULD NOT CLAIM", "error")
		end
		self:_refreshDaily()
	end)
end

function UI._rebuildTopRuns(self)
	local container = self._menu.runs
	clearRows(container)

	local raw = ReplicatedStorage:GetAttribute("TopRuns")
	local runs = nil
	if type(raw) == "string" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(decoded) == "table" then
			runs = decoded
		end
	end

	if runs == nil or #runs == 0 then
		text({
			Text = if runs == nil then "LOADING" else "NO RUNS YET / BE THE FIRST",
			TextSize = 9,
			TextColor3 = GREY,
			Size = UDim2.new(1, 0, 0, 28),
			Parent = container,
		})
		return
	end

	for i, run in runs do
		if i > 10 then
			break
		end
		local name = string.upper(tostring(run.name or "???"))
		local isMe = run.name == player.Name
		local row = new("Frame", {
			Name = "Run" .. i,
			BackgroundColor3 = INK,
			BackgroundTransparency = if isMe then 0 else 1,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = i,
			Parent = container,
		})
		local ink = if isMe then PAPER else INK
		if (tonumber(run.rank) or i) == 1 then
			local bar = new("Frame", { Size = UDim2.new(0, 3, 1, 0), Parent = row })
			setAccent(bar, "BackgroundColor3")
		end
		local rank = text({ Text = twoDigits(run.rank or i), TextSize = 9, TextColor3 = if isMe then PAPER else GREY, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0, 22, 1, 0), Parent = row })
		if isMe then
			setAccent(rank, "TextColor3")
		end
		text({
			Text = name,
			TextSize = 10,
			TextColor3 = ink,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(34, 0),
			Size = UDim2.new(1, -124, 1, 0),
			Parent = row,
		})
		capText(text({
			Text = commas(run.meters or 0) .. " M",
			Font = FONT_NUM,
			TextColor3 = ink,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 0),
			Size = UDim2.new(0, 86, 1, 0),
			Parent = row,
		}), 10, 7)
		if not isMe then
			rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.85 })
		end
	end
end

function UI._rebuildPasses(self)
	local m = self._menu
	local focusPath = self:_captureFocus(m.passes)
	clearRows(m.passes)
	local shown = 0
	-- Checkpoints only matters once there is a zone to start from.
	local reached = math.max(0, math.floor(tonumber(player:GetAttribute("Checkpoint")) or 0))
	for order, key in PASS_ORDER do
		local pass = Config.GamePasses[key]
		local useful = key ~= "Checkpoints" or reached > 0
		if pass and pass.Id ~= 0 and not hasPass(key) and useful then
			shown += 1
			local info = PASS_INFO[key]
			local card = new("Frame", { Name = key, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = order, Parent = m.passes })
			stroke(card, 1, INK, 0.5)
			local code = new("Frame", { BackgroundColor3 = INK, Position = UDim2.fromOffset(6, 8), Size = UDim2.fromOffset(44, 44), Parent = card })
			capText(setAccent(text({
				Text = info.code,
				Font = FONT_NUM,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = code,
			}), "TextColor3"), 12, 7)
			capText(text({ Text = info.title, Font = FONT_NUM, Position = UDim2.fromOffset(58, 8), Size = UDim2.new(1, -146, 0, 16), Parent = card }), 11, 7)
			text({
				Text = info.copy,
				TextSize = 8,
				TextColor3 = GREY,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Position = UDim2.fromOffset(58, 26),
				Size = UDim2.new(1, -146, 0, 28),
				Parent = card,
			})
			local buy = hardButton(card, {
				Name = "Buy",
				Fill = "accent",
				Text = "GET",
				TextSize = 12,
				Sub = "",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6, 0.5, 0),
				Size = UDim2.fromOffset(78, 50),
				OnClick = function()
					self:_fire("onBuyPass", key)
				end,
			})
			self:_robuxButton(buy)
			withPrice(pass.Id, Enum.InfoType.GamePass, function(price)
				if buy.sub.Parent then
					buy.sub.Text = "R$ " .. commas(price)
				end
			end)
		end
	end
	m.passHeader.Visible = shown > 0
	m.passes.Visible = shown > 0
	self:_restoreFocus(m.passes, focusPath, m.tabs[1].button)
end

function UI._rebuildZones(self)
	local m = self._menu
	local focusPath = self:_captureFocus(m.zones)
	clearRows(m.zones)
	local reached = math.max(0, math.floor(tonumber(player:GetAttribute("Checkpoint")) or 0))
	local unlocked = hasPass("Checkpoints")
	m.zonesRight.Text = "REACHED " .. twoDigits(reached)

	local passId = Config.GamePasses.Checkpoints.Id
	if not unlocked and reached > 0 and passId ~= 0 then
		local holder = new("Frame", { Name = "Unlock", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 0, Parent = m.zones })
		local unlock = hardButton(holder, {
			Name = "UnlockAll",
			Fill = "accent",
			Text = "START FROM ZONES YOU REACHED",
			TextSize = 12,
			Sub = "",
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.new(1, 0, 0, 50),
			OnClick = function()
				self:_fire("onBuyPass", "Checkpoints")
			end,
		})
		self:_robuxButton(unlock)
		withPrice(passId, Enum.InfoType.GamePass, function(price)
			if unlock.sub.Parent then
				unlock.sub.Text = "R$ " .. commas(price)
			end
		end)
	end

	local function zoneRow(i, locked, uncharted)
		local theme = themeFor(i)
		local row = new("Frame", { Name = "Zone" .. i, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = i + 1, Parent = m.zones })
		rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.8 })

		-- Two-tone chip: zone accent over its wall color.
		local chip = new("Frame", {
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = if uncharted then 0.7 else 0,
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.fromOffset(36, 36),
			Parent = row,
		})
		stroke(chip, 1.5, INK, if uncharted then 0.6 else 0)
		new("Frame", {
			BackgroundColor3 = theme.Wall,
			BackgroundTransparency = if uncharted then 0.7 else 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 11),
			Parent = chip,
		})

		local title = if i == 0 then "START" else "ZONE " .. twoDigits(i)
		capText(text({
			Text = title,
			Font = FONT_NUM,
			TextTransparency = if uncharted then 0.55 else 0,
			Position = UDim2.fromOffset(46, 12),
			Size = UDim2.new(1, -130, 0, 18),
			Parent = row,
		}), 13, 7)
		text({
			Text = (if uncharted then "UNCHARTED / " else "FROM ") .. commas(math.floor(Config.checkpointMeters(i) + 0.5)) .. " M",
			TextSize = 9,
			TextColor3 = GREY,
			Position = UDim2.fromOffset(46, 32),
			Size = UDim2.new(1, -130, 0, 12),
			Parent = row,
		})

		if uncharted then
			return
		elseif locked then
			local tag = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(70, 24), Parent = row })
			stroke(tag, 1, INK, 0.3)
			text({ Text = "LOCKED", TextSize = 9, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = tag })
		else
			hardButton(row, {
				Name = "Go",
				Fill = if i == 0 then "paper" else "accent",
				Text = "GO",
				TextSize = 12,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(74, 50),
				OnClick = function()
					self:_fire("onPlay", i, self:_pickedBoosts())
				end,
			})
		end
	end

	for i = 0, reached do
		zoneRow(i, i > 0 and not unlocked, false)
	end
	zoneRow(reached + 1, true, true)
	if reached > 0 then
		text({
			Name = "Note",
			Text = "CHECKPOINT RUNS DON'T COUNT FOR BEST",
			TextSize = 8,
			TextColor3 = GREY,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = reached + 10,
			Parent = m.zones,
		})
	end
	self:_restoreFocus(m.zones, focusPath, m.tabs[4].button)
end

function UI._refreshSkins(self)
	self:_refreshPremium()
	local m = self._menu
	if not m or not m.skinCards then
		return
	end
	local owned = ownedSkins()
	local equipped = player:GetAttribute("EquippedSkin") or "Default"
	local gems = tonumber(player:GetAttribute("Gems")) or 0
	local ownedCount = 0
	local total = 0
	for _, skin in Config.Skins do
		if skin.Premium then
			continue
		end
		total += 1
		if owned[skin.Id] then
			ownedCount += 1
		end
		local card = m.skinCards[skin.Id]
		if card and not card.busy then
			local button = card.button
			if equipped == skin.Id then
				card.state = "equipped"
				button.setFill("accent")
				button.setText("EQUIPPED")
				button.setEnabled(false)
				card.outline.Thickness = 2
				card.outline.Transparency = 0
			elseif owned[skin.Id] then
				card.state = "owned"
				button.setFill("paper")
				button.setText("EQUIP")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			elseif skin.Price <= 0 and skin.Source then
				-- Earned through levels / streak / season / offers, never sold for gems.
				card.state = "locked"
				button.setFill("paper")
				button.setText(skin.Source)
				button.setEnabled(false)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			else
				card.state = "buy"
				button.setFill("ink")
				button.setText("BUY")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			end
			if skin.Price > 0 then
				local short = skin.Price - gems
				card.price.Text = commas(skin.Price)
					.. " GEMS"
					.. (if card.state == "buy" and short > 0 then " / -" .. commas(short) else "")
			elseif skin.Source then
				card.price.Text = if card.state == "locked" then "LOCKED / EARN IT" else "EARNED / " .. skin.Source
			end
		end
	end
	m.skinsRight.Text = ownedCount .. " / " .. total .. " OWNED"
end

-- Premium balls (Robux) ---------------------------------------------------------------
-- Top of SHOP: an ink card with a slowly orbiting 3D preview of the picked ball
-- (animated like in a run), its name, what it is and its live Robux price, then a
-- 3x2 picker. BUY is a Robux button (off until the save loads, like every other);
-- owned balls show EQUIP / EQUIPPED instead. Never sold for gems.

function UI._buildPremiumBalls(self, parent, order)
	local m = self._menu
	local p = { chips = {}, prices = {}, busy = false }
	m.premium = p

	local _, right = sectionHeader(parent, order, "05.P", "PREMIUM BALLS")
	p.right = right

	local card = new("Frame", {
		Name = "PremiumBalls",
		BackgroundColor3 = INK,
		Size = UDim2.new(1, 0, 0, PREMIUM_CARD_H),
		LayoutOrder = order + 1,
		Parent = parent,
	})
	notch(card, 12, 1, 0)

	-- 3D preview: a camera circles the ball while the shop is on screen. The
	-- viewport is see-through, so the faint blueprint grid behind it shows.
	local backing = new("Frame", {
		Name = "PreviewBacking",
		BackgroundColor3 = INK,
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(PREMIUM_VIEW, PREMIUM_VIEW),
		Parent = card,
	})
	local grid = blueprintGrid(backing, 6, 6, 0.88)
	for _, line in grid:GetChildren() do
		line.BackgroundColor3 = PAPER
	end
	stroke(backing, 1, PAPER, 0.6)
	local view = new("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(150, 150, 165),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -2, -1),
		Parent = backing,
	})
	brackets(backing, 8, 1, 0.2)
	for _, item in backing:GetChildren() do
		if item.Name == "Bracket" then
			item.BackgroundColor3 = PAPER
			item.ZIndex = 2
		end
	end
	local viewCamera = new("Camera", { FieldOfView = 40, Parent = view })
	view.CurrentCamera = viewCamera
	p.view = view
	p.camera = viewCamera
	p.tagLabel = text({
		Text = "P-01 / LIVE",
		TextSize = 8,
		TextColor3 = PAPER,
		Position = UDim2.fromOffset(6, PREMIUM_VIEW + 9),
		Size = UDim2.fromOffset(PREMIUM_VIEW, 10),
		Parent = card,
	})

	-- Right column: name, what it is, price, action.
	local x = PREMIUM_VIEW + 14
	setAccent(text({
		Text = "PREMIUM BALL / YOURS FOREVER",
		TextSize = 8,
		Position = UDim2.fromOffset(x, 8),
		Size = UDim2.new(1, -(x + 22), 0, 10),
		Parent = card,
	}), "TextColor3")
	p.name = capText(text({
		Name = "BallName",
		Font = FONT_NUM,
		TextColor3 = PAPER,
		Position = UDim2.fromOffset(x, 22),
		Size = UDim2.new(1, -(x + 8), 0, 20),
		Parent = card,
	}), 15, 8)
	p.desc = text({
		Name = "Desc",
		TextSize = 8,
		TextColor3 = PAPER,
		TextTransparency = 0.15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(x, 46),
		Size = UDim2.new(1, -(x + 8), 0, 34),
		Parent = card,
	})
	p.price = setAccent(capText(text({
		Name = "Price",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(x, 84),
		Size = UDim2.new(1, -(x + 8), 0, 18),
		Parent = card,
	}), 12, 7), "TextColor3")

	local buttonSize = UDim2.new(1, -(x + 6), 0, 56)
	local buttonPosition = UDim2.fromOffset(x, PREMIUM_CARD_H - 62)
	p.buy = hardButton(card, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY",
		TextSize = 13,
		Sub = "",
		Position = buttonPosition,
		Size = buttonSize,
		OnClick = function()
			self:_buyPremium()
		end,
	})
	self:_robuxButton(p.buy)
	p.buy.onBlocked = function()
		if p.selected and self:_premiumPending(p.selected) then
			self:toast("UNLOCKING " .. string.upper(Config.getSkin(p.selected).Name) .. "...", "info")
		else
			self:_robuxRefused()
		end
	end
	p.equip = hardButton(card, {
		Name = "Equip",
		Fill = "paper",
		Text = "EQUIP",
		TextSize = 13,
		Position = buttonPosition,
		Size = buttonSize,
		OnClick = function()
			self:_equipPremium()
		end,
	})
	p.equip.holder.Visible = false

	-- Picker: 3 x 2 chips, each with the ball's colors along the bottom.
	local picker = new("Frame", {
		Name = "PremiumPicker",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order + 2,
		Parent = parent,
	})
	new("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -6, 0, 54),
		CellPadding = UDim2.fromOffset(8, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = picker,
	})
	local holders = {}
	for index, id in Config.PremiumBalls do
		local skin = Config.getSkin(id)
		local chip = hardButton(picker, {
			Name = id,
			Fill = "paper",
			Text = string.upper(skin.Name),
			TextSize = 9,
			Sub = "",
			LayoutOrder = index,
			OnClick = function()
				self:_selectPremium(id)
			end,
		})
		local bar = new("Frame", {
			Name = "Colors",
			BackgroundColor3 = skin.Color,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 2, 1, -2),
			Size = UDim2.new(1, -4, 0, 4),
			Parent = chip.face,
		})
		new("UIGradient", {
			Color = ColorSequence.new(skin.Color, skin.Ring or skin.Trail or skin.Color),
			Parent = bar,
		})
		p.chips[id] = chip
		table.insert(holders, chip.holder)

		local product = Config.Products[skin.ProductKey or ""]
		withPrice(product and product.Id, Enum.InfoType.Product, function(price)
			p.prices[id] = price
			self:_refreshPremium()
		end)
	end
	linkGrid(holders, 3)
	p.holders = holders

	-- One frame loop: animates the preview, only while the SHOP page is on screen.
	local lastMeshCheck = 0
	table.insert(self._connections, RunService.RenderStepped:Connect(function()
		local preview = p.preview
		if not preview or not m.root.Visible or m.tab ~= TAB_SHOP then
			return
		end
		local now = os.clock()
		if now - lastMeshCheck > PREMIUM_MESH_CHECK then
			lastMeshCheck = now
			-- The Blender model finished loading: swap the part-built stand-in for it.
			-- Once per ball, so a model that still can't be used doesn't rebuild every second.
			if not preview.mesh and p.meshTriedFor ~= p.selected and BallFx.hasMesh(p.selected) then
				p.meshTriedFor = p.selected
				self:_showPremiumPreview(p.selected)
				preview = p.preview
			end
		end
		preview.step(now)
		local angle = now * PREMIUM_ORBIT_SPEED
		local eye = Vector3.new(math.sin(angle), 0.35, math.cos(angle)) * PREMIUM_CAMERA_DISTANCE
		p.camera.CFrame = CFrame.lookAt(eye, Vector3.zero)
	end))

	-- Start on the first one they don't own (or the first).
	local owned = ownedSkins()
	local first = Config.PremiumBalls[1]
	for _, id in Config.PremiumBalls do
		if not owned[id] then
			first = id
			break
		end
	end
	self:_selectPremium(first)
end

function UI._showPremiumPreview(self, id)
	local p = self._menu.premium
	if p.preview then
		p.preview.destroy()
		p.preview = nil
	end
	local ok, preview = pcall(BallFx.preview, id, PREMIUM_PREVIEW_DIAMETER)
	if ok and preview then
		preview.model.Parent = p.view
		p.preview = preview
	else
		warn("[UI] ball preview failed:", preview)
	end
end

function UI._selectPremium(self, id)
	local p = self._menu and self._menu.premium
	if not p or not p.chips[id] then
		return
	end
	if p.selected ~= id then
		p.selected = id
		self:_showPremiumPreview(id)
	end
	self:_refreshPremium()
end

-- "R$ 199" from the live price (Config's price until it has loaded).
local function premiumPrice(p, skin)
	local price = p.prices[skin.Id] or skin.Robux
	return if price then "R$ " .. commas(price) else ""
end

-- True while a paid premium ball is on its way from the server (the Robux prompt
-- closed with "purchased", but OwnedSkins hasn't got it yet). BUY stays off
-- meanwhile so a second tap can't charge the player twice.
function UI._premiumPending(self, id)
	local pending = self._premiumPendingUntil
	local untilTime = pending and pending[id]
	if not untilTime then
		return false
	end
	if os.clock() < untilTime and not ownedSkins()[id] then
		return true
	end
	pending[id] = nil
	return false
end

function UI._refreshPremium(self)
	local p = self._menu and self._menu.premium
	if not p or not p.selected then
		return
	end
	local owned = ownedSkins()
	local equipped = player:GetAttribute("EquippedSkin") or "Default"
	local ownedCount = 0
	for _, id in Config.PremiumBalls do
		local skin = Config.getSkin(id)
		local chip = p.chips[id]
		if owned[id] then
			ownedCount += 1
		end
		chip.setFill(if id == p.selected then "ink" else "paper")
		chip.sub.Text = if equipped == id
			then "EQUIPPED"
			elseif owned[id] then "OWNED"
			elseif self:_premiumPending(id) then "UNLOCKING"
			else premiumPrice(p, skin)
	end
	p.right.Text = ownedCount .. " / " .. #Config.PremiumBalls .. " OWNED"

	local skin = Config.getSkin(p.selected)
	local product = Config.Products[skin.ProductKey or ""]
	local forSale = product ~= nil and (tonumber(product.Id) or 0) ~= 0
	local index = table.find(Config.PremiumBalls, skin.Id) or 1
	p.name.Text = string.upper(skin.Name)
	p.desc.Text = skin.Text or ""
	p.tagLabel.Text = "P-" .. twoDigits(index) .. " / " .. (if BallFx.hasMesh(skin.Id) then "3D MODEL" else "LIVE")

	local isOwned = owned[skin.Id] == true
	p.buy.holder.Visible = not isOwned
	p.equip.holder.Visible = isOwned
	if isOwned then
		p.price.Text = "OWNED / ALL RUNS"
		if not p.busy then
			if equipped == skin.Id then
				p.equip.setFill("accent")
				p.equip.setText("EQUIPPED")
				p.equip.setEnabled(false)
			else
				p.equip.setFill("paper")
				p.equip.setText("EQUIP")
				p.equip.setEnabled(true)
			end
		end
	else
		local pending = self:_premiumPending(skin.Id)
		p.price.Text = if forSale then premiumPrice(p, skin) else "COMING SOON"
		p.buy.setText(if pending then "UNLOCKING..." elseif forSale then "BUY" else "SOON")
		p.buy.sub.Text = if forSale and not pending then premiumPrice(p, skin) else ""
		local enabled = saveLoaded() and not pending
		if p.buy.enabled ~= enabled then
			p.buy.setEnabled(enabled)
		end
	end

	-- Gamepad: action button <-> first row of chips.
	local action = if isOwned then p.equip.holder else p.buy.holder
	action.NextSelectionDown = p.holders[1]
	for i = 1, math.min(3, #p.holders) do
		p.holders[i].NextSelectionUp = action
	end
end

function UI._buyPremium(self)
	local p = self._menu.premium
	local skin = Config.getSkin(p.selected)
	local product = Config.Products[skin.ProductKey or ""]
	if ownedSkins()[skin.Id] then
		self:toast("YOU ALREADY OWN " .. string.upper(skin.Name), "info")
		self:_refreshPremium()
		return
	end
	if self:_premiumPending(skin.Id) then
		self:toast("UNLOCKING " .. string.upper(skin.Name) .. "...", "info")
		return
	end
	if not product or (tonumber(product.Id) or 0) == 0 then
		self:toast(string.upper(skin.Name) .. " IS COMING SOON", "info")
		return
	end
	self:_fire("onBuyProduct", skin.ProductKey)
end

function UI._equipPremium(self)
	local p = self._menu.premium
	if p.busy then
		return
	end
	local id = p.selected
	p.busy = true
	p.equip.setEnabled(false)
	p.equip.setText("EQUIPPING")
	task.spawn(function()
		local ok, message = self:_ask("onEquipSkin", id)
		p.busy = false
		if ok then
			self:toast(string.upper(Config.getSkin(id).Name) .. " EQUIPPED", "reward")
		else
			self:toast(message or "COULD NOT EQUIP", "error")
		end
		self:_refreshSkins()
	end)
end

function UI._skinAction(self, card)
	if card.busy or card.state == "equipped" or card.state == "locked" then
		return
	end
	local buying = card.state == "buy"
	card.busy = true
	card.button.setEnabled(false)
	card.button.setText(if buying then "BUYING" else "EQUIPPING")
	task.spawn(function()
		local ok, message = self:_ask(if buying then "onBuySkin" else "onEquipSkin", card.skin.Id)
		card.busy = false
		if ok and buying then
			self:toast(string.upper(card.skin.Name) .. " UNLOCKED", "reward")
		elseif not ok then
			self:toast(message or (if buying then "PURCHASE FAILED" else "COULD NOT EQUIP"), "error")
			if buying then
				self:_offerTopUp(card.skin.Price, self._menu.panel)
			end
		end
		self:_refreshSkins()
	end)
end

function UI._refreshFx(self)
	local m = self._menu
	if not m or not m.fxCards then
		return
	end
	local owned = ownedFx()
	local equipped = player:GetAttribute("EquippedFx")
	if type(equipped) ~= "string" or equipped == "" then
		equipped = "Classic"
	end
	local gems = tonumber(player:GetAttribute("Gems")) or 0
	local ownedCount = 0
	for _, fx in Config.ShatterFx do
		if owned[fx.Id] then
			ownedCount += 1
		end
		local card = m.fxCards[fx.Id]
		if card and not card.busy then
			local button = card.button
			if equipped == fx.Id then
				card.state = "equipped"
				button.setFill("accent")
				button.setText("EQUIPPED")
				button.setEnabled(false)
				card.outline.Thickness = 2
				card.outline.Transparency = 0
			elseif owned[fx.Id] then
				card.state = "owned"
				button.setFill("paper")
				button.setText("EQUIP")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			elseif fx.Price <= 0 then
				card.state = "locked"
				button.setFill("paper")
				button.setText(fx.Source or "LOCKED")
				button.setEnabled(false)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			else
				card.state = "buy"
				button.setFill("ink")
				button.setText("BUY")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			end
			if fx.Price > 0 then
				local short = fx.Price - gems
				card.price.Text = commas(fx.Price) .. " GEMS" .. (if card.state == "buy" and short > 0 then " / -" .. commas(short) else "")
			elseif fx.Source then
				card.price.Text = if card.state == "locked" then "LOCKED / EARN IT" else "EARNED / " .. fx.Source
			end
		end
	end
	m.fxRight.Text = ownedCount .. " / " .. #Config.ShatterFx .. " OWNED"
end

function UI._fxAction(self, card)
	if card.busy or card.state == "equipped" or card.state == "locked" then
		return
	end
	local buying = card.state == "buy"
	card.busy = true
	card.button.setEnabled(false)
	card.button.setText(if buying then "BUYING" else "EQUIPPING")
	task.spawn(function()
		local ok, message = self:_ask("onShop", if buying then "BuyFx" else "EquipFx", card.fx.Id)
		card.busy = false
		if ok and buying then
			self:toast(string.upper(card.fx.Name) .. " FX UNLOCKED", "reward")
		elseif not ok then
			self:toast(message or (if buying then "PURCHASE FAILED" else "COULD NOT EQUIP"), "error")
			if buying then
				self:_offerTopUp(card.fx.Price, self._menu.panel)
			end
		end
		self:_refreshFx()
	end)
end

-- HUD -----------------------------------------------------------------------------

function UI._buildHud(self)
	local h = { cells = {}, pips = {} }
	self._hud = h

	local layer = new("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	h.layer = layer
	-- Everything that shakes lives in `root`; the layer itself never moves.
	local root = new("Frame", { Name = "Shake", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = layer })
	h.root = root

	-- Balls odometer -------------------------------------------------------
	local plate = new("Frame", {
		Name = "Balls",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, EDGE - 4),
		Size = UDim2.fromOffset(176, 92),
		Parent = root,
	})
	fit(plate, HUD_SCALE)
	h.plateStroke = stroke(plate, 1.5)
	h.alarm = new("Frame", { Name = "Alarm", BackgroundColor3 = DANGER, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = plate })
	cropMarks(plate, 6, 3)
	local chip = new("Frame", { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(5, 5), Parent = plate })
	setAccent(chip, "BackgroundColor3")
	text({ Text = "BALLS", TextSize = 9, Position = UDim2.fromOffset(17, 2), Size = UDim2.fromOffset(80, 12), Parent = plate })
	-- Equipped ball: a tiny two-tone swatch (ball color | trail color) + its name. See setBallSkin.
	local swatch = new("Frame", { Name = "Skin", BackgroundColor3 = PAPER, Position = UDim2.fromOffset(50, 4), Size = UDim2.fromOffset(8, 8), Parent = plate })
	stroke(swatch, 1)
	h.skinSwatch = swatch
	h.skinSwatchTrail = new("Frame", { Name = "Trail", BackgroundColor3 = PAPER, Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.5, 1), Parent = swatch })
	h.skinGradient = new("UIGradient", { Color = rainbowSequence(), Enabled = false, Parent = swatch })
	h.skinName = text({
		Name = "SkinName",
		Text = "",
		TextSize = 8,
		TextColor3 = GREY,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(62, 2),
		Size = UDim2.fromOffset(64, 12),
		Parent = plate,
	})
	text({ Text = "01", TextSize = 8, TextColor3 = GREY, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -48, 0, 2), Size = UDim2.fromOffset(40, 12), Parent = plate })

	local digits = new("Frame", { Name = "Digits", BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 16), Size = UDim2.fromOffset(160, 44), Parent = plate })
	h.bump = new("UIScale", { Parent = digits })
	for i = 1, 4 do
		local cell = new("Frame", {
			Name = "Cell" .. i,
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Position = UDim2.fromOffset((i - 1) * 40, 0),
			Size = UDim2.fromOffset(40, 44),
			Parent = digits,
		})
		if i > 1 then
			rule(cell, { Size = UDim2.new(0, 1, 1, -8), Position = UDim2.fromOffset(0, 4), BackgroundTransparency = 0.82 })
		end
		local label = capText(text({
			Text = "0",
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 0.82,
			Size = UDim2.fromScale(1, 1),
			Parent = cell,
		}), 34, 10)
		h.cells[i] = { label = label, char = "0" }
	end
	rule(plate, { Position = UDim2.fromOffset(8, 62), Size = UDim2.new(1, -16, 0, 1), BackgroundTransparency = 0.6 })

	-- Multiball pips + streak bar
	text({ Text = "MULTI", TextSize = 9, Position = UDim2.fromOffset(8, 65), Size = UDim2.fromOffset(44, 16), Parent = plate })
	for i = 1, Config.MAX_MULTIBALL do
		local pip = new("Frame", {
			Name = "Pip" .. i,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(60 + (i - 1) * 16, 73),
			Size = UDim2.fromOffset(11, 11),
			Parent = plate,
		})
		setAccent(pip, "BackgroundColor3")
		stroke(pip, 1)
		h.pips[i] = pip
	end
	h.level = capText(text({
		Text = "x1",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 65),
		Size = UDim2.fromOffset(36, 16),
		Parent = plate,
	}), 12, 7)
	local track = new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = 0.82, Position = UDim2.fromOffset(8, 84), Size = UDim2.new(1, -16, 0, 3), Parent = plate })
	h.streak = new("Frame", { Size = UDim2.fromScale(0, 1), Parent = track })
	setAccent(h.streak, "BackgroundColor3")

	-- Controller hint under the odometer during the first run ("R2 THROW").
	h.throwHint = inputHint(plate, { { "R2", "THROW" } }, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 5),
		Size = UDim2.new(1, 0, 0, 14),
	})

	-- Active boosts hang under the odometer (children of the plate, so they share its scale).
	self:_buildBoostRail(plate)

	-- Zone (top-left) -------------------------------------------------------
	local zone = new("Frame", { Name = "Zone", BackgroundColor3 = PAPER, BackgroundTransparency = 0.1, Position = UDim2.fromOffset(EDGE, EDGE - 4), Size = UDim2.fromOffset(88, 46), Parent = root })
	fit(zone, HUD_SCALE)
	stroke(zone, 1.5)
	local zoneBar = new("Frame", { Size = UDim2.new(0, 4, 1, 0), Parent = zone })
	setAccent(zoneBar, "BackgroundColor3")
	notch(zone, 9, 1, 0, INK)
	text({ Text = "03 / ZONE", TextSize = 8, Position = UDim2.fromOffset(12, 3), Size = UDim2.fromOffset(70, 10), Parent = zone })
	h.zone = capText(text({ Text = "00", Font = FONT_NUM, Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(70, 28), Parent = zone }), 22, 9)

	-- Distance + ruler (top-right) -----------------------------------------
	local dist = new("Frame", {
		Name = "Distance",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -EDGE, 0, EDGE - 4),
		Size = UDim2.fromOffset(150, DIST_PLATE_H),
		Parent = root,
	})
	fit(dist, HUD_SCALE)
	stroke(dist, 1.5)
	text({ Text = "02 / DISTANCE", TextSize = 8, Position = UDim2.fromOffset(8, 3), Size = UDim2.fromOffset(120, 10), Parent = dist })
	h.meters = capText(text({
		Text = "0",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(8, 13),
		Size = UDim2.fromOffset(116, 26),
		Parent = dist,
	}), 22, 9)
	text({ Text = "M", TextSize = 11, TextYAlignment = Enum.TextYAlignment.Bottom, Position = UDim2.fromOffset(128, 13), Size = UDim2.fromOffset(14, 22), Parent = dist })
	local ruler = new("Frame", { Name = "Ruler", BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(8, 43), Size = UDim2.fromOffset(134, 14), Parent = dist })
	h.tickPx, h.tickPeriod = 6, 30
	h.ticks = new("Frame", { Name = "Ticks", BackgroundTransparency = 1, Size = UDim2.fromOffset(134 + 36, 14), Parent = ruler })
	rulerTicks(h.ticks, 134 + 36, 12, h.tickPx, 5, 0)
	rule(ruler, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	local marker = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 2, 1, 0), Parent = ruler })
	setAccent(marker, "BackgroundColor3")

	-- Ball pack (bottom-right) ---------------------------------------------
	local pack = Config.Products.BallPack
	if pack.Id ~= 0 then
		local buy = hardButton(root, {
			Name = "BallPack",
			Fill = "accent",
			Text = "+" .. pack.Balls .. " BALLS",
			TextSize = 12,
			Sub = "",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -EDGE, 1, -EDGE),
			Size = UDim2.fromOffset(122, 52),
			OnClick = function()
				self:_fire("onBuyProduct", "BallPack")
			end,
		})
		fit(buy.holder)
		self:_robuxButton(buy)
		withPrice(pack.Id, Enum.InfoType.Product, function(price)
			buy.sub.Text = "R$ " .. commas(price)
		end)
	end

	-- Shield quick-buy (bottom-left, away from the aim area): only while low on
	-- balls and not already shielded. See _refreshQuickShield.
	local shieldId = productId("BoostShield")
	if shieldId ~= 0 then
		local shieldBoost = boostInfo("Shield")
		local quick = hardButton(root, {
			Name = "QuickShield",
			Fill = "accent",
			Text = "SHIELD",
			TextSize = 12,
			Sub = "R$ --",
			Align = Enum.TextXAlignment.Left,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, EDGE, 1, -EDGE),
			Size = UDim2.fromOffset(122, 52),
			OnClick = function()
				self:_fire("onBuyProduct", "BoostShield")
			end,
		})
		quick.label.Size = UDim2.new(1, -40, 0.6, 0)
		quick.sub.Size = UDim2.new(1, -40, 0.4, -2)
		local block = new("Frame", {
			Name = "Mark",
			BackgroundColor3 = INK,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(26, 34),
			Parent = quick.face,
		})
		shieldGlyph(block, 14, UDim2.fromScale(0.5, 0.5), shieldBoost and shieldBoost.Color or PAPER)
		fit(quick.holder)
		quick.bump = new("UIScale", { Parent = quick.face })
		quick.holder.Visible = false
		self:_robuxButton(quick)
		withPrice(shieldId, Enum.InfoType.Product, function(price)
			quick.sub.Text = "R$ " .. commas(price)
		end)
		h.quickShield = quick
	end

	self:_buildBoostBar(root)
end

-- Boost bar ---------------------------------------------------------------------------
-- One slot per Config.BOOST_BAR boost (Magnet, Slow-Mo, Mega Ball), stacked down
-- the right edge under the distance plate. A slot shows while that boost is ready (picked for
-- this run, not tapped yet): colored mark + short name + USE (+ a count when
-- more than one). Tapping it calls onUseBoost(id); the slot pops and turns into
-- that boost's countdown (seconds / throws left), then folds away when it runs
-- out. While a slot shows, the same boost's plate under the odometer stays
-- hidden so it never shows twice. See setBoosts.
function UI._buildBoostBar(self, root)
	local h = self._hud
	local count = #BAR_IDS
	if count == 0 then
		return
	end
	local column = new("Frame", {
		Name = "BoostBar",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -EDGE, 0, EDGE + 60), -- placed by _layoutBoostBar
		Size = UDim2.fromOffset(BAR_SLOT_W, count * BAR_SLOT_H + (count - 1) * BAR_GAP),
		Parent = root,
	})
	fit(column) -- full sheet scale (not HUD_SCALE): every slot stays a >= 44px touch target
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, BAR_GAP),
		Parent = column,
	})
	local bar = { column = column, slots = {} }
	h.boostBar = bar
	for order, id in BAR_IDS do
		local boost = boostInfo(id)
		if boost then
			bar.slots[id] = self:_buildBarSlot(column, id, order, boost)
		end
	end
end

-- Keeps the bar just under the distance plate (which is drawn at HUD_SCALE).
function UI._layoutBoostBar(self)
	local bar = self._hud and self._hud.boostBar
	if bar then
		local top = EDGE - 4 + math.ceil(DIST_PLATE_H * HUD_SCALE * currentScale) + 8
		bar.column.Position = UDim2.new(1, -EDGE, 0, top)
	end
end

function UI._buildBarSlot(self, column, id, order, boost)
	local color = boost.Color or accentColor
	-- The holder is the (invisible) button and the layout's fixed-size cell; the
	-- body inside it does the popping, so the column never reflows mid-animation.
	-- Not Selectable: a controller's A / R2 throw during a run, and the D-pad
	-- (RunController) uses these instead.
	local holder = new("TextButton", {
		Name = id,
		AutoButtonColor = false,
		Text = "",
		Selectable = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(BAR_SLOT_W, BAR_SLOT_H),
		LayoutOrder = order,
		Visible = false,
		Parent = column,
	})
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	})
	local pop = new("UIScale", { Parent = body })
	new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = INK,
		Position = UDim2.fromOffset(SHADOW, SHADOW),
		Size = UDim2.new(1, -SHADOW, 1, -SHADOW),
		Parent = body,
	})
	local face = new("Frame", { Name = "Face", BackgroundColor3 = PAPER, Size = UDim2.new(1, -SHADOW, 1, -SHADOW), Parent = body })
	stroke(face, 2)

	-- Colored mark block on the left, ink hairline on its right edge.
	local block = new("Frame", { Name = "Mark", BackgroundColor3 = color, Size = UDim2.new(0, BAR_BLOCK_W, 1, 0), Parent = face })
	rule(block, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0) })
	boostGlyph(block, id, 10, UDim2.fromScale(0.5, 0.5), INK)

	local left = BAR_BLOCK_W + 4
	capText(text({
		Name = "Name",
		Text = BAR_SHORT[id] or boostName(id),
		TextSize = 8,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(left, 3),
		Size = UDim2.new(1, -(left + 3), 0, 10),
		Parent = face,
	}), 8, 6)
	local value = capText(text({
		Name = "Value",
		Text = "USE",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(left, 13),
		Size = UDim2.new(1, -(left + 3), 0, 20),
		Parent = face,
	}), 13, 7)

	-- Countdown bar along the bottom (only while running).
	local track = new("Frame", {
		Name = "Track",
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.82,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, BAR_BLOCK_W, 1, 0),
		Size = UDim2.new(1, -BAR_BLOCK_W, 0, 4),
		Visible = false,
		Parent = face,
	})
	local fill = new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), Parent = track })

	-- Count tag stuck on the top-right corner ("x2" ready, "+1" more waiting while one runs).
	local countTag = text({
		Name = "Count",
		Text = "",
		Font = FONT_NUM,
		TextSize = 8,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundColor3 = INK,
		BackgroundTransparency = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -2, 0, -2),
		Size = UDim2.fromOffset(18, 11),
		Visible = false,
		Parent = face,
	})

	-- Input hints in the bottom-right corner: a tiny D-pad (controller) or a
	-- keycap (keyboard). Touch shows neither. See _refreshBarHints.
	local hintSpot = { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -7) }
	local padHint = padGlyph(face, BAR_PAD_DIRECTIONS[order] or "Up", 11, hintSpot)
	local keyHint = new("Frame", {
		Name = "KeyHint",
		BackgroundColor3 = INK,
		AnchorPoint = hintSpot.AnchorPoint,
		Position = hintSpot.Position,
		Size = UDim2.fromOffset(11, 11),
		Visible = false,
		Parent = face,
	})
	text({
		Text = BAR_NUMBER_KEYS[order] or "",
		TextSize = 8,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = keyHint,
	})

	-- Tap burst: a ring in the boost's color that grows and fades.
	local ring = new("Frame", {
		Name = "Burst",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = holder,
	})
	local ringStroke = stroke(ring, 3, color)

	local slot = {
		id = id,
		holder = holder,
		pop = pop,
		face = face,
		value = value,
		track = track,
		fill = fill,
		countTag = countTag,
		padHint = padHint,
		keyHint = keyHint,
		ring = ring,
		ringStroke = ringStroke,
		color = color,
		shown = false,
		ready = nil, -- ready count last frame (nil = nothing seen yet this run)
		tapped = false, -- one was tapped from this slot and is still running
		mode = nil, -- "ready" | "active"
	}
	-- Pressed, not released: the boost should fire the instant the finger lands.
	-- The button sinks the tap, so it never throws a ball too.
	holder.MouseButton1Down:Connect(function()
		if not slot.shown then
			return
		end
		if (slot.ready or 0) > 0 then
			self:_fire("onUseBoost", id)
		end
	end)
	return slot
end

-- The boost was just tapped: pop the slot and burst a ring around it.
function UI._popBarSlot(self, slot)
	slot.pop.Scale = 1.3
	tween(slot.pop, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local ring = slot.ring
	ring.Visible = true
	ring.Size = UDim2.fromScale(1, 1)
	slot.ringStroke.Transparency = 0
	tween(ring, 0.35, { Size = UDim2.new(1, 34, 1, 34) })
	local fade = tween(slot.ringStroke, 0.35, { Transparency = 1 })
	fade.Completed:Once(function()
		if slot.ringStroke.Transparency >= 0.99 then
			ring.Visible = false
		end
	end)
end

--[[
	One boost-bar slot for this frame. readyCount = boosts waiting to be tapped,
	running = the boost is on right now (number / fraction / label describe its
	countdown, like _setIndicator). Returns true while the slot shows (the
	odometer rail then hides the same boost). Only touches instances that change.
]]
function UI._setBarSlot(self, slot, readyCount, running, number, fraction, label)
	if not slot then
		return false
	end
	readyCount = math.max(0, math.floor(tonumber(readyCount) or 0))
	local previous = slot.ready
	slot.ready = readyCount
	if previous ~= nil and readyCount < previous then
		slot.tapped = true -- runs from this slot now (RunController switched it on)
		self:_popBarSlot(slot)
	end
	if not running then
		slot.tapped = false -- used up
	end
	local show = readyCount > 0 or (slot.tapped and running)
	-- Only catches taps while there's one to use; a countdown-only (or folding)
	-- slot lets the tap through so it throws a ball like anywhere else.
	local tappable = show and readyCount > 0
	if slot.holder.Interactable ~= tappable then
		slot.holder.Interactable = tappable
	end

	if show ~= slot.shown then
		slot.shown = show
		slot.hideToken = nil
		if show then
			slot.holder.Visible = true
			slot.pop.Scale = 0.6
			tween(slot.pop, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			-- Fold away, then hide (unless it came back meanwhile).
			slot.mode = nil
			local token = {}
			slot.hideToken = token
			tween(slot.pop, BAR_HIDE_TIME, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(BAR_HIDE_TIME, function()
				if slot.hideToken == token then
					slot.hideToken = nil
					slot.holder.Visible = false
				end
			end)
		end
	end
	if not show then
		return false
	end

	local mode = if running then "active" else "ready"
	if mode ~= slot.mode then
		slot.mode = mode
		slot.number = nil
		slot.fraction = nil
		slot.track.Visible = running
		slot.face.BackgroundColor3 = if running then PAPER:Lerp(slot.color, 0.22) else PAPER
		if not running then
			slot.value.Text = "USE"
		end
	end
	if running then
		if number ~= slot.number then
			slot.number = number
			slot.value.Text = label
		end
		local rounded = math.floor(math.clamp(fraction or 0, 0, 1) * 100 + 0.5) / 100
		if rounded ~= slot.fraction then
			slot.fraction = rounded
			slot.fill.Size = UDim2.fromScale(rounded, 1)
		end
	end

	-- "x2" = two waiting; "+1" = one more waiting behind the one running.
	local tag = if running and readyCount > 0 then "+" .. readyCount elseif readyCount > 1 then "x" .. readyCount else ""
	if tag ~= slot.tag then
		slot.tag = tag
		slot.countTag.Text = tag
		slot.countTag.Visible = tag ~= ""
	end
	return true
end

-- D-pad hints while on a controller, number keycaps on keyboard / mouse, none on touch.
function UI._refreshBarHints(self)
	local bar = self._hud and self._hud.boostBar
	if not bar then
		return
	end
	local gamepad = self._gamepad == true
	local keys = not gamepad and not self._touch
	for _, slot in bar.slots do
		slot.padHint.Visible = gamepad
		slot.keyHint.Visible = keys
	end
end

-- One small plate per boost; hidden until setBoosts says it is running.
function UI._buildBoostRail(self, plate)
	local h = self._hud
	local rail = new("Frame", {
		Name = "BoostRail",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.fromOffset(340, 30),
		Parent = plate,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = rail,
	})
	local b = { items = {}, rail = rail }
	h.boostRail = b

	-- { id, small label, has a countdown bar }
	local specs = {
		{ "Shield", "SHIELD", false },
		{ "Magnet", "MAGNET", true },
		{ "SlowMo", "SLOW-MO", true },
		{ "MegaBall", "MEGA BALL", true },
		{ "DoubleGems", "THIS RUN", false },
	}
	for order, spec in specs do
		local id = spec[1]
		local boost = boostInfo(id)
		if boost then
			local color = boost.Color or accentColor
			local frame = new("Frame", {
				Name = id,
				BackgroundColor3 = PAPER,
				BackgroundTransparency = 0.1,
				Size = UDim2.fromOffset(64, 30),
				LayoutOrder = order,
				Visible = false,
				Parent = rail,
			})
			stroke(frame, 1)
			local scale = new("UIScale", { Parent = frame })
			-- Ink icon block on the left.
			local block = new("Frame", { Name = "Mark", BackgroundColor3 = INK, Size = UDim2.new(0, 16, 1, 0), Parent = frame })
			if id == "Shield" then
				shieldGlyph(block, 10, UDim2.fromScale(0.5, 0.5), color)
			elseif id == "DoubleGems" then
				local gem = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(7, 7),
					Rotation = 45,
					BackgroundColor3 = color,
					Parent = block,
				})
				stroke(gem, 1, PAPER, 0.3)
			else
				local swatch = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(8, 8),
					BackgroundColor3 = color,
					Parent = block,
				})
				rule(swatch, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 1) })
			end
			text({ Text = spec[2], TextSize = 7, TextColor3 = GREY, Position = UDim2.fromOffset(20, 2), Size = UDim2.new(1, -22, 0, 9), Parent = frame })
			local value = capText(text({
				Text = "",
				Font = FONT_NUM,
				Position = UDim2.fromOffset(20, 11),
				Size = UDim2.new(1, -22, 0, 14),
				Parent = frame,
			}), 11, 6)
			local fill = nil
			if spec[3] then
				local track = new("Frame", {
					BackgroundColor3 = INK,
					BackgroundTransparency = 0.82,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 16, 1, 0),
					Size = UDim2.new(1, -16, 0, 3),
					Parent = frame,
				})
				fill = new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), Parent = track })
			end
			b.items[id] = { frame = frame, value = value, fill = fill, scale = scale }
		end
	end
end

-- Only touches instances when something visible actually changed.
function UI._setIndicator(self, item, visible, number, fraction, label)
	if not item then
		return
	end
	if visible ~= item.visible then
		item.visible = visible
		item.frame.Visible = visible
		if visible then
			item.scale.Scale = 1.25
			tween(item.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	if not visible then
		return
	end
	if number ~= item.number then
		item.number = number
		item.value.Text = label
	end
	if item.fill and fraction then
		local rounded = math.floor(math.clamp(fraction, 0, 1) * 100 + 0.5) / 100
		if rounded ~= item.fraction then
			item.fraction = rounded
			item.fill.Size = UDim2.fromScale(rounded, 1)
		end
	end
end

function UI._refreshQuickShield(self)
	local h = self._hud
	local quick = h.quickShield
	if not quick then
		return
	end
	local shielded = h.boostRail ~= nil and h.boostRail.shield == true
	local show = h.balls ~= nil and h.balls <= LOW_BALLS_OFFER and not shielded
	if show ~= quick.shown then
		quick.shown = show
		quick.holder.Visible = show
		if show then
			quick.bump.Scale = 0.8
			tween(quick.bump, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
end

-- Forget what the rail showed; the next setBoosts redraws it from scratch.
function UI._resetBoostRail(self)
	local h = self._hud
	local b = h.boostRail
	if b then
		b.shield = nil
		b.shieldUsedAt = nil
		for _, item in b.items do
			item.visible = false
			item.number = nil
			item.fraction = nil
			item.frame.Visible = false
		end
	end
	if h.quickShield then
		h.quickShield.shown = nil
	end
	local bar = h.boostBar
	if bar then
		for _, slot in bar.slots do
			-- `tapped` stays: after a revive, a boost tapped before the crash is
			-- still counting down in its slot (a new run clears it on its first frame).
			slot.shown = false
			slot.ready = nil
			slot.mode = nil
			slot.number = nil
			slot.fraction = nil
			slot.tag = nil
			slot.hideToken = nil
			slot.holder.Visible = false
			slot.pop.Scale = 1
			slot.ring.Visible = false
			slot.countTag.Visible = false
		end
	end
end

function UI._setDigits(self, balls, rising)
	local h = self._hud
	local s = string.format("%04d", math.clamp(balls, 0, 9999))
	local firstSignificant = 4
	for i = 1, 4 do
		if string.sub(s, i, i) ~= "0" then
			firstSignificant = i
			break
		end
	end
	for i, cell in h.cells do
		local char = string.sub(s, i, i)
		if char ~= cell.char then
			cell.char = char
			cell.label.Text = char
			cell.label.Position = UDim2.fromOffset(0, if rising then 16 else -16)
			tween(cell.label, 0.18, { Position = UDim2.new() })
		end
		cell.label.TextTransparency = if i < firstSignificant then 0.82 else 0
	end
end

function UI._setLow(self, low)
	local h = self._hud
	if h.pulse then
		h.pulse:Cancel()
		h.pulse = nil
	end
	for _, cell in h.cells do
		cell.label.TextColor3 = if low then DANGER else INK
	end
	h.plateStroke.Color = if low then DANGER else INK
	h.alarm.BackgroundTransparency = 1
	if low and Settings.get("flashes") == false then
		h.alarm.BackgroundTransparency = 0.85 -- steady tint instead of a blinking alarm
	elseif low then
		h.pulse = TweenService:Create(
			h.alarm,
			TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ BackgroundTransparency = 0.78 }
		)
		h.pulse:Play()
	end
end

-- Game over ---------------------------------------------------------------------------

function UI._buildGameOver(self)
	local g = {}
	self._over = g

	local root = new("Frame", { Name = "GameOver", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	g.root = root
	g.wash = bleed(root, { Name = "Wash", BackgroundColor3 = PAPER, BackgroundTransparency = 0.35 })
	blueprintGrid(root, 12, 8, 0.9)

	local sheet = new("Frame", {
		Name = "Sheet",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.02,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.05, 0, 0.5, 0),
		Size = UDim2.fromOffset(540, 282),
		Parent = root,
	})
	fit(sheet)
	stroke(sheet, 1.5)
	cropMarks(sheet, 10, 5)
	notch(sheet, 16, 1, 1, INK)
	g.sheet = sheet

	local header = new("Frame", { Name = "Header", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 24), Parent = sheet })
	text({ Text = "04 / RUN REPORT", TextSize = 9, TextColor3 = PAPER, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.5, 0, 1, 0), Parent = header })
	setAccent(text({
		Text = "SHATTER RUN / GLASS LAB",
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.5, -10, 1, 0),
		Parent = header,
	}), "TextColor3")

	-- Left: the measurement
	text({ Text = "DISTANCE / METERS", TextSize = 9, TextColor3 = GREY, Position = UDim2.fromOffset(12, 32), Size = UDim2.fromOffset(200, 12), Parent = sheet })
	local numberRow = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 44), Size = UDim2.fromOffset(300, 60), Parent = sheet })
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = numberRow,
	})
	g.distance = text({
		Text = "0",
		Font = FONT_NUM,
		TextSize = 48,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 60),
		LayoutOrder = 1,
		Parent = numberRow,
	})
	text({ Text = "M", TextSize = 16, TextYAlignment = Enum.TextYAlignment.Bottom, Size = UDim2.fromOffset(16, 46), LayoutOrder = 2, Parent = numberRow })

	-- Ruler: scale from 0 to a bit past max(run, best) with markers for both.
	local ruler = new("Frame", { Name = "Ruler", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 118), Size = UDim2.fromOffset(300, 30), Parent = sheet })
	local tickBand = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 8), Size = UDim2.fromOffset(300, 12), Parent = ruler })
	rulerTicks(tickBand, 300, 12, 15, 5, 0.2)
	rule(tickBand, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	g.scaleLabels = {}
	for i = 0, 4 do
		g.scaleLabels[i] = text({
			Text = "0",
			TextSize = 7,
			TextColor3 = GREY,
			TextXAlignment = if i == 4 then Enum.TextXAlignment.Right elseif i == 0 then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(if i == 4 then 1 elseif i == 0 then 0 else 0.5, 0),
			Position = UDim2.new(i / 4, 0, 0, 21),
			Size = UDim2.fromOffset(50, 9),
			Parent = ruler,
		})
	end
	g.bestMarker = new("Frame", { BackgroundColor3 = INK, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromOffset(1, 20), Parent = ruler })
	text({ Text = "BEST", TextSize = 7, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(3, -2), Size = UDim2.fromOffset(30, 8), Parent = g.bestMarker })
	g.runMarker = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromOffset(3, 20), Parent = ruler })
	setAccent(g.runMarker, "BackgroundColor3")

	-- Data table
	local function dataRow(y, label, withGem)
		rule(sheet, { Position = UDim2.fromOffset(12, y), Size = UDim2.fromOffset(300, 1), BackgroundTransparency = 0.6 })
		local x = 12
		if withGem then
			gemIcon(sheet, 7, UDim2.fromOffset(17, y + 14))
			x = 26
		end
		text({ Text = label, TextSize = 9, Position = UDim2.fromOffset(x, y + 1), Size = UDim2.fromOffset(150, 26), Parent = sheet })
		return capText(text({
			Text = "0",
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.fromOffset(162, y + 4),
			Size = UDim2.fromOffset(150, 20),
			Parent = sheet,
		}), 13, 8)
	end
	g.best = dataRow(162, "BEST")
	g.gems = dataRow(190, "GEMS EARNED", true)
	rule(sheet, { Position = UDim2.fromOffset(12, 218), Size = UDim2.fromOffset(300, 1), BackgroundTransparency = 0.6 })

	-- XP tally: filled in when the server's RunSummary arrives.
	text({ Text = "XP EARNED", TextSize = 9, Position = UDim2.fromOffset(12, 219), Size = UDim2.fromOffset(100, 26), Parent = sheet })
	g.xpValue = capText(text({
		Text = "TALLYING...",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(192, 223),
		Size = UDim2.fromOffset(120, 20),
		Parent = sheet,
	}), 13, 7)
	g.xpLevel = capText(text({ Text = "LV 01", Font = FONT_NUM, Position = UDim2.fromOffset(12, 246), Size = UDim2.fromOffset(44, 12), Parent = sheet }), 9, 6)
	local _, xpFill = meter(sheet, { Position = UDim2.fromOffset(60, 250), Size = UDim2.fromOffset(252, 5) })
	g.xpFill = xpFill
	g.xpProgress = text({ Text = "", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(60, 258), Size = UDim2.fromOffset(130, 10), Parent = sheet })
	g.xpMissions = text({
		Text = "",
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(190, 258),
		Size = UDim2.fromOffset(122, 10),
		Parent = sheet,
	})
	rule(sheet, { Position = UDim2.fromOffset(12, 272), Size = UDim2.fromOffset(300, 1), BackgroundTransparency = 0.6 })
	g.levelStamp = stamp(sheet, "LEVEL UP", { Position = UDim2.fromOffset(148, 232), Size = UDim2.fromOffset(84, 22), Rotation = -6, Visible = false }, "accent")
	g.levelStampScale = new("UIScale", { Parent = g.levelStamp })

	-- NEW BEST rubber stamp
	local stamp = new("Frame", {
		Name = "NewBest",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(262, 52),
		Size = UDim2.fromOffset(112, 32),
		Rotation = -9,
		Visible = false,
		Parent = sheet,
	})
	setAccent(stamp, "BackgroundColor3")
	stroke(stamp, 2)
	rule(stamp, { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, 1) })
	rule(stamp, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 4, 1, -4), Size = UDim2.new(1, -8, 0, 1) })
	capText(text({ Text = "NEW BEST", Font = FONT_NUM, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = stamp }), 13, 8)
	g.stamp = stamp
	g.stampScale = new("UIScale", { Parent = stamp })

	-- Divider + right column: actions
	rule(sheet, { Position = UDim2.fromOffset(328, 34), Size = UDim2.new(0, 1, 1, -44), BackgroundTransparency = 0.4 })
	text({ Text = "05 / NEXT", TextSize = 9, TextColor3 = GREY, Position = UDim2.fromOffset(340, 32), Size = UDim2.fromOffset(188, 12), Parent = sheet })
	local actions = new("Frame", { Name = "Actions", BackgroundTransparency = 1, Position = UDim2.fromOffset(340, 48), Size = UDim2.fromOffset(188, 180), Parent = sheet })
	list(actions, 6)

	-- Save didn't load: said here instead of offering a revive.
	local warning = new("Frame", { Name = "SaveWarning", BackgroundColor3 = INK, Size = UDim2.new(1, -SHADOW, 0, 52), LayoutOrder = 0, Visible = false, Parent = actions })
	hatch(warning, { Name = "Hatch", Size = UDim2.new(0, 8, 1, 0) }, PAPER, 0.45, 3)
	capText(setAccent(text({
		Text = "YOUR SAVE DIDN'T LOAD",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(16, 9),
		Size = UDim2.new(1, -22, 0, 16),
		Parent = warning,
	}), "TextColor3"), 11, 7)
	text({
		Text = "REJOIN BEFORE BUYING ANYTHING",
		TextSize = 8,
		TextColor3 = PAPER,
		Position = UDim2.fromOffset(16, 29),
		Size = UDim2.new(1, -22, 0, 12),
		Parent = warning,
	})
	g.saveWarning = warning

	local revive = Config.Products.Revive
	local reviveGroup = new("Frame", { Name = "Revive", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 1, Visible = false, Parent = actions })
	g.reviveButton = hardButton(reviveGroup, {
		Name = "ReviveButton",
		Fill = "danger",
		Text = "REVIVE +" .. revive.Balls .. " BALLS",
		TextSize = 11,
		Sub = "",
		Size = UDim2.new(1, 0, 0, 52),
		OnClick = function()
			local now = os.clock()
			if now - (g.lastRevive or 0) > 0.6 then
				g.lastRevive = now
				self:_fire("onRevive")
			end
		end,
	})
	hatch(g.reviveButton.face, { AnchorPoint = Vector2.new(1, 0), Size = UDim2.new(0, 14, 1, 0), Position = UDim2.fromScale(1, 0) }, PAPER, 0.55, 3)
	local reviveTrack = new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = 0.82, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, -SHADOW, 0, 5), Parent = reviveGroup })
	g.reviveBar = new("Frame", { BackgroundColor3 = DANGER, Size = UDim2.fromScale(1, 1), Parent = reviveTrack })
	g.reviveGroup = reviveGroup
	self:_robuxButton(g.reviveButton)
	withPrice(revive.Id, Enum.InfoType.Product, function(price)
		g.reviveButton.sub.Text = "R$ " .. commas(price)
	end)

	g.playAgain = hardButton(actions, {
		Name = "PlayAgain",
		Fill = "accent",
		Text = "PLAY AGAIN",
		TextSize = 14,
		Size = UDim2.new(1, 0, 0, 54),
		LayoutOrder = 2,
		OnClick = function()
			self:_fire("onPlayAgain", self:_pickedBoosts())
		end,
	})
	-- MENU and the SETTINGS gear share the last row.
	local menuRow = new("Frame", { Name = "MenuRow", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 3, Parent = actions })
	g.menuButton = hardButton(menuRow, {
		Name = "Menu",
		Fill = "paper",
		Text = "MENU",
		TextSize = 12,
		Size = UDim2.new(1, -SETTINGS_GEAR_W, 1, 0),
		OnClick = function()
			self:_fire("onMenu")
		end,
	})
	g.settingsButton = self:_gearButton(menuRow, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
	})
	g.menuButton.holder.NextSelectionRight = g.settingsButton.holder
	g.settingsButton.holder.NextSelectionLeft = g.menuButton.holder
	g.settingsButton.holder.NextSelectionUp = g.playAgain.holder
end

-- Settings ------------------------------------------------------------------------------
-- One sheet over whatever is showing (menu or run report). Every control writes
-- straight to Settings, and everything is redrawn from Settings.changed, so a
-- value changed anywhere (or loaded from the account a moment late) shows here.
--
-- Body (under the 24-unit header), top to bottom:
--   01 MUSIC slider / 02 SOUND FX slider (full width, 50 tall)
--   graphics hint line, then 03 GRAPHICS  AUTO | LOW | HIGH
--   04 VIBRATION | 05 CAMERA SHAKE | 06 FLASHES toggles
--   note (or controller hints) and CLOSE
-- On a short screen the sheet is cut to fit and the body scrolls.

local GRAPHICS_LABELS = { Auto = "AUTO", Low = "LOW", High = "HIGH" }
local SETTINGS_TOGGLES = {
	{ key = "vibration", label = "04 / VIBRATION" },
	{ key = "shake", label = "05 / CAMERA SHAKE" },
	{ key = "flashes", label = "06 / FLASHES" },
}

-- Small index + name block on the left of a settings row (sliders, graphics).
local function settingsLabel(face, index, label)
	local chip = new("Frame", { Position = UDim2.fromOffset(8, 7), Size = UDim2.fromOffset(5, 5), Parent = face })
	setAccent(chip, "BackgroundColor3")
	text({ Text = index, TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(17, 4), Size = UDim2.fromOffset(40, 10), Parent = face })
	capText(text({
		Text = label,
		Font = FONT_NUM,
		Position = UDim2.fromOffset(8, 17),
		Size = UDim2.fromOffset(SETTINGS_LABEL_W - 14, 24),
		Parent = face,
	}), 11, 6)
end

function UI._buildSettings(self)
	local s = { sliders = {}, toggles = {}, toggleList = {}, segments = {}, open = false }
	self._settings = s

	local layer = new("Frame", { Name = "Settings", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	s.layer = layer
	local wash = new("TextButton", {
		Name = "Wash",
		AutoButtonColor = false,
		Text = "",
		Selectable = false, -- tap-outside-to-close only; never a gamepad stop
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.25,
		Position = UDim2.fromOffset(-200, -200),
		Size = UDim2.new(1, 400, 1, 400),
		Parent = layer,
	})
	wash.Activated:Connect(function()
		self:_closeSettings()
	end)
	s.wash = wash
	blueprintGrid(layer, 12, 8, 0.9)

	local sheet, right = modalSheet(layer, "Sheet", SETTINGS_W, SETTINGS_HEADER + SETTINGS_BODY_H, "08", "SETTINGS")
	sheet.Visible = true -- the layer shows / hides it
	right.Text = "SAVED TO YOUR ACCOUNT"
	s.sheet = sheet

	local body = new("ScrollingFrame", {
		Name = "Body",
		Active = true,
		Selectable = false, -- gamepad selection goes to the controls; the body scrolls to follow it
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, SETTINGS_HEADER),
		Size = UDim2.new(1, 0, 1, -SETTINGS_HEADER),
		CanvasSize = UDim2.fromOffset(0, SETTINGS_BODY_H),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = INK,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = sheet,
	})
	s.body = body

	self:_buildSettingsSlider(body, "music", "01", "MUSIC", 6)
	self:_buildSettingsSlider(body, "sfx", "02", "SOUND FX", 60)

	text({
		Text = "LOW = SMOOTHER ON OLD PHONES",
		TextSize = 9,
		Position = UDim2.fromOffset(12, 114),
		Size = UDim2.new(0.55, -12, 0, 12),
		Parent = body,
	})
	s.graphicsAuto = text({
		Text = "",
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.55, 0, 0, 114),
		Size = UDim2.new(0.45, -12, 0, 12),
		Parent = body,
	})
	self:_buildSettingsSegments(body, 128)

	local toggleRow = new("Frame", {
		Name = "Toggles",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 184),
		Size = UDim2.new(1, -24, 0, SETTINGS_ROW),
		Parent = body,
	})
	for order, spec in SETTINGS_TOGGLES do
		self:_buildSettingsToggle(toggleRow, spec.key, spec.label, order)
	end

	-- Bottom row: a note (touch / mouse) or controller hints, and CLOSE.
	s.note = text({
		Text = "CHANGES APPLY RIGHT AWAY",
		TextSize = 8,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(12, 258),
		Size = UDim2.new(1, -190, 0, 12),
		Parent = body,
	})
	s.hint = inputHint(body, { { "D-PAD", "ADJUST" }, { "B", "CLOSE" } }, {
		Position = UDim2.fromOffset(12, 257),
		Size = UDim2.new(1, -190, 0, 14),
	}, Enum.HorizontalAlignment.Left)
	s.close = hardButton(body, {
		Name = "Close",
		Fill = "accent",
		Text = "CLOSE",
		TextSize = 13,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 240),
		Size = UDim2.fromOffset(150, SETTINGS_ROW),
		OnClick = function()
			self:_closeSettings()
		end,
	})

	-- Gamepad neighbours: straight lines down the sheet. Sliders have nothing to
	-- their left or right (they are full width and the sheet stops selection at
	-- its edges), so left / right on a slider only ever changes its value.
	-- Edges point at the control itself, so selection stays put there instead
	-- of jumping diagonally (and a slider never loses the selection sideways,
	-- even if the engine also reads the D-pad we sink).
	local music, sfx = s.sliders.music.holder, s.sliders.sfx.holder
	for _, holder in { music, sfx } do
		holder.NextSelectionLeft = holder
		holder.NextSelectionRight = holder
	end
	music.NextSelectionUp = music
	music.NextSelectionDown = sfx
	sfx.NextSelectionUp = music
	sfx.NextSelectionDown = s.segments[1] and s.segments[1].button -- then follows the chosen option
	local toggles = s.toggleList
	for i, segment in s.segments do
		local button = segment.button
		button.NextSelectionUp = sfx
		button.NextSelectionLeft = if i > 1 then s.segments[i - 1].button else button
		button.NextSelectionRight = if i < #s.segments then s.segments[i + 1].button else button
		local below = toggles[math.min(i, #toggles)]
		button.NextSelectionDown = below and below.button.holder
	end
	for i, entry in toggles do
		local holder = entry.button.holder
		local above = s.segments[math.min(i, #s.segments)]
		holder.NextSelectionUp = above and above.button
		holder.NextSelectionLeft = if i > 1 then toggles[i - 1].button.holder else holder
		holder.NextSelectionRight = if i < #toggles then toggles[i + 1].button.holder else holder
		holder.NextSelectionDown = s.close.holder
	end
	local close = s.close.holder
	close.NextSelectionUp = if #toggles > 0 then toggles[#toggles].button.holder else sfx
	close.NextSelectionDown = close
	close.NextSelectionLeft = close
	close.NextSelectionRight = close

	-- Dragging keeps following the finger / mouse even when it leaves the row.
	table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
		local drag = s.drag
		if drag and (input == drag.input or (drag.mouse and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			self:_slideTo(drag.slider, input.Position.X)
		end
	end))
	table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
		local drag = s.drag
		if drag and (input == drag.input or (drag.mouse and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			self:_endSliderDrag(drag)
		end
	end))

	self:_refreshSettings()
end

-- A full-width slider row: label | ruler track with accent fill and ink thumb | percent.
-- Touch / mouse: press anywhere on the track (or just beside it) and drag.
-- Gamepad: select the row, then left / right steps 10% (see _onSettingsAdjust).
function UI._buildSettingsSlider(self, parent, key, index, label, y)
	local s = self._settings
	local holder = new("TextButton", {
		Name = key,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, y),
		Size = UDim2.new(1, -24, 0, SETTINGS_ROW),
		Parent = parent,
	})
	local face = new("Frame", { Name = "Face", BackgroundColor3 = PAPER, Size = UDim2.fromScale(1, 1), Parent = holder })
	stroke(face, 1, INK, 0.5)
	settingsLabel(face, index, label)
	rule(face, { Position = UDim2.fromOffset(SETTINGS_LABEL_W, 8), Size = UDim2.new(0, 1, 1, -16), BackgroundTransparency = 0.6 })
	rule(face, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(SETTINGS_PCT_W + 4), 0, 8), Size = UDim2.new(0, 1, 1, -16), BackgroundTransparency = 0.6 })

	local trackLeft = SETTINGS_LABEL_W + 18
	local trackRight = SETTINGS_PCT_W + 22
	local track = new("Frame", {
		Name = "Track",
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.82,
		Position = UDim2.fromOffset(trackLeft, 19),
		Size = UDim2.new(1, -(trackLeft + trackRight), 0, 6),
		Parent = face,
	})
	local fill = new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), Parent = track })
	setAccent(fill, "BackgroundColor3")
	-- Ruler ticks every 10% (one D-pad step), longer at 0 / 50 / 100.
	for i = 0, 10 do
		local major = i % 5 == 0
		rule(track, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(i / 10, 0, 1, 5),
			Size = UDim2.fromOffset(1, if major then 7 else 4),
			BackgroundTransparency = if major then 0.2 else 0.5,
		})
	end
	local thumb = new("Frame", {
		Name = "Thumb",
		BackgroundColor3 = INK,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 24),
		Parent = track,
	})
	rule(thumb, { BackgroundColor3 = PAPER, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, -10) })
	local bump = new("UIScale", { Parent = thumb })
	local pct = capText(text({
		Text = "",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 0),
		Size = UDim2.new(0, SETTINGS_PCT_W - 8, 1, 0),
		Parent = face,
	}), 13, 7)

	local slider = { key = key, holder = holder, track = track, fill = fill, thumb = thumb, bump = bump, pct = pct }
	s.sliders[key] = slider

	holder.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		if s.drag or not s.open then
			return -- one finger at a time
		end
		local left, width = track.AbsolutePosition.X, track.AbsoluteSize.X
		local margin = 20 * effectiveScale(track)
		local x = input.Position.X
		if width < 1 or x < left - margin or x > left + width + margin then
			return -- a tap on the label or the readout doesn't move the slider
		end
		self:_beginSliderDrag(slider, input)
	end)
	return slider
end

-- 03 GRAPHICS: label cell + AUTO | LOW | HIGH on one hard-shadowed strip. Each
-- option's tap area is the full 50 units (face and shadow), like hardButton.
function UI._buildSettingsSegments(self, parent, y)
	local s = self._settings
	local strip = new("Frame", {
		Name = "Graphics",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, y),
		Size = UDim2.new(1, -24, 0, SETTINGS_ROW),
		Parent = parent,
	})
	new("Frame", { Name = "Shadow", BackgroundColor3 = INK, Position = UDim2.fromOffset(SHADOW, SHADOW), Size = UDim2.new(1, -SHADOW, 1, -SHADOW), Parent = strip })
	local face = new("Frame", { Name = "Face", BackgroundColor3 = PAPER, Size = UDim2.new(1, -SHADOW, 1, -SHADOW), Parent = strip })
	stroke(face, 2)
	settingsLabel(face, "03", "GRAPHICS")
	rule(face, { Position = UDim2.fromOffset(SETTINGS_LABEL_W, 0), Size = UDim2.new(0, 1, 1, 0) })

	local options = new("Frame", {
		Name = "Options",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(SETTINGS_LABEL_W + 1, 0),
		Size = UDim2.new(1, -(SETTINGS_LABEL_W + 1 + SHADOW), 1, 0),
		Parent = strip,
	})
	local count = #Config.GRAPHICS_OPTIONS
	for i, option in Config.GRAPHICS_OPTIONS do
		local button = new("TextButton", {
			Name = option,
			AutoButtonColor = false,
			Text = "",
			Selectable = true,
			BackgroundTransparency = 1,
			Position = UDim2.fromScale((i - 1) / count, 0),
			Size = UDim2.fromScale(1 / count, 1),
			Parent = options,
		})
		local fill = new("Frame", { Name = "Fill", BackgroundColor3 = INK, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -SHADOW), Parent = button })
		if i > 1 then
			rule(button, { Size = UDim2.new(0, 1, 1, -SHADOW), BackgroundTransparency = 0.5 })
		end
		local label = capText(text({
			Text = GRAPHICS_LABELS[option] or string.upper(option),
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(4, 0),
			Size = UDim2.new(1, -8, 1, -SHADOW),
			Parent = button,
		}), 12, 7)
		local bar = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -SHADOW), Size = UDim2.new(1, 0, 0, 3), Visible = false, Parent = button })
		setAccent(bar, "BackgroundColor3")
		button.Activated:Connect(function()
			Settings.set("graphics", option)
		end)
		table.insert(s.segments, { option = option, button = button, fill = fill, label = label, bar = bar })
	end
end

-- An ON / OFF hard button with a small switch drawn on its right.
function UI._buildSettingsToggle(self, row, key, label, order)
	local s = self._settings
	local count = #SETTINGS_TOGGLES
	local button = hardButton(row, {
		Name = key,
		Fill = "paper",
		Text = "ON",
		TextSize = 12,
		Align = Enum.TextXAlignment.Left,
		Index = label,
		Position = UDim2.new((order - 1) / count, (order - 1) * 2, 0, 0),
		Size = UDim2.new(1 / count, -4, 1, 0),
		OnClick = function()
			Settings.set(key, Settings.get(key) ~= true)
		end,
	})
	button.label.Size = UDim2.new(1, -58, 1, -11)
	local switch = new("Frame", {
		Name = "Switch",
		BackgroundColor3 = PAPER,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 5),
		Size = UDim2.fromOffset(32, 16),
		Parent = button.face,
	})
	stroke(switch, 1.5)
	local knob = new("Frame", {
		Name = "Knob",
		BackgroundColor3 = INK,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(13, 10),
		Parent = switch,
	})
	local entry = { key = key, button = button, switch = switch, knob = knob }
	s.toggles[key] = entry
	table.insert(s.toggleList, entry)
	return entry
end

-- Fits the sheet to the safe area (called on every resize). Phones in landscape
-- get the full 340-unit sheet height, so it fits without scrolling; anything
-- shorter cuts the sheet and lets the body scroll. Crop marks only show when
-- there is room for them outside the sheet.
function UI._layoutSettings(self)
	local s = self._settings
	if not s then
		return
	end
	local size = self.gui.AbsoluteSize
	if size.X < 1 or size.Y < 1 or currentScale <= 0 then
		return
	end
	local availW = size.X / currentScale
	local availH = size.Y / currentScale
	local width = math.floor(math.min(SETTINGS_W, availW - 8))
	local height = math.floor(math.min(SETTINGS_HEADER + SETTINGS_BODY_H, availH - 8))
	height = math.max(height, SETTINGS_HEADER + SETTINGS_ROW)
	s.sheet.Size = UDim2.fromOffset(width, height)
	local roomy = availH >= height + 30 and availW >= width + 30
	for _, child in s.sheet:GetChildren() do
		if child.Name == "Crop" and child:IsA("GuiObject") then
			child.Visible = roomy
		end
	end
end

-- Redraws every control from Settings (cheap; runs on every change).
function UI._refreshSettings(self)
	local s = self._settings
	if not s then
		return
	end
	local values = Settings.all()
	local instant = s.drag ~= nil or not s.open
	for key, slider in s.sliders do
		self:_showSliderValue(slider, values[key], instant)
	end
	for _, entry in s.toggleList do
		local on = values[entry.key] == true
		entry.button.setText(if on then "ON" else "OFF")
		entry.button.label.TextColor3 = if on then INK else GREY
		entry.knob.AnchorPoint = Vector2.new(if on then 1 else 0, 0.5)
		entry.knob.Position = if on then UDim2.new(1, -2, 0.5, 0) else UDim2.new(0, 2, 0.5, 0)
		entry.switch.BackgroundColor3 = if on then INK else PAPER
		if on then
			setAccent(entry.knob, "BackgroundColor3")
		else
			clearAccent(entry.knob)
			entry.knob.BackgroundColor3 = INK
		end
	end
	for _, segment in s.segments do
		local active = segment.option == values.graphics
		segment.fill.BackgroundTransparency = if active then 0 else 1
		segment.label.TextColor3 = if active then PAPER else INK
		segment.bar.Visible = active
		if active and s.sliders.sfx then
			s.sliders.sfx.holder.NextSelectionDown = segment.button
		end
	end
	local ok, level = pcall(Settings.graphicsLevel)
	s.graphicsAuto.Text = if values.graphics == "Auto" and ok and type(level) == "string"
		then "AUTO = " .. string.upper(level) .. " ON THIS DEVICE"
		else ""
end

function UI._showSliderValue(self, slider, value, instant)
	value = math.clamp(tonumber(value) or 0, 0, 1)
	local percent = math.floor(value * 100 + 0.5)
	slider.pct.Text = if percent == 0 then "OFF" else percent .. "%"
	for _, running in slider.tweens or {} do
		running:Cancel()
	end
	slider.tweens = nil
	local fillSize = UDim2.fromScale(value, 1)
	local thumbPosition = UDim2.fromScale(value, 0.5)
	if instant then
		slider.fill.Size = fillSize
		slider.thumb.Position = thumbPosition
	else
		slider.tweens = {
			tween(slider.fill, 0.12, { Size = fillSize }),
			tween(slider.thumb, 0.12, { Position = thumbPosition }),
		}
	end
end

function UI._slideTo(self, slider, x)
	local track = slider.track
	local width = track.AbsoluteSize.X
	if width < 1 then
		return
	end
	local value = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
	Settings.set(slider.key, math.floor(value * 100 + 0.5) / 100)
end

function UI._beginSliderDrag(self, slider, input)
	local s = self._settings
	local drag = { slider = slider, input = input, mouse = input.UserInputType == Enum.UserInputType.MouseButton1 }
	s.drag = drag
	s.body.ScrollingEnabled = false -- the finger moves the slider, not the page
	self:_stopHold()
	drag.changed = input.Changed:Connect(function()
		local state = input.UserInputState
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			self:_endSliderDrag(drag)
		end
	end)
	slider.bump.Scale = 1.2
	self:_slideTo(slider, input.Position.X)
end

function UI._endSliderDrag(self, drag)
	local s = self._settings
	drag = drag or s.drag
	if drag == nil or s.drag ~= drag then
		return
	end
	s.drag = nil
	if drag.changed then
		drag.changed:Disconnect()
	end
	s.body.ScrollingEnabled = true
	tween(drag.slider.bump, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- The slider the gamepad selection is on, or nil.
function UI._selectedSlider(self)
	local s = self._settings
	local selected = GuiService.SelectedObject
	if not s or not s.open or selected == nil then
		return nil
	end
	for _, slider in s.sliders do
		if slider.holder == selected then
			return slider
		end
	end
	return nil
end

-- One gamepad step: to the next 10% mark in that direction (63% -> 70% / 60%).
function UI._stepSlider(self, slider, dir)
	local value = math.clamp(tonumber(Settings.get(slider.key)) or 0, 0, 1)
	local target
	if dir > 0 then
		target = math.floor(value * 10 + 1e-6) / 10 + SLIDER_STEP
	else
		target = math.ceil(value * 10 - 1e-6) / 10 - SLIDER_STEP
	end
	target = math.clamp(math.floor(target * 100 + 0.5) / 100, 0, 1)
	if target ~= value then
		Settings.set(slider.key, target)
		slider.bump.Scale = 1.25
		tween(slider.bump, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

-- Holding the D-pad (or the stick) keeps stepping after a short pause.
function UI._startHold(self, source, dir)
	local s = self._settings
	local slider = self:_selectedSlider()
	if slider == nil then
		self:_stopHold(source)
		return false
	end
	local hold = { source = source, dir = dir }
	s.hold = hold
	self:_stepSlider(slider, dir)
	task.delay(SLIDER_REPEAT_DELAY, function()
		while s.hold == hold and s.open do
			local current = self:_selectedSlider()
			if current == nil then
				break
			end
			self:_stepSlider(current, dir)
			task.wait(SLIDER_REPEAT_EVERY)
		end
	end)
	return true
end

function UI._stopHold(self, source)
	local s = self._settings
	if s and s.hold and (source == nil or s.hold.source == source) then
		s.hold = nil
	end
end

-- Gamepad left / right while the sheet is open. On a slider the D-pad is
-- sunk (so it changes the value instead of moving the selection); anywhere else
-- it passes through to normal navigation. Up / down are never bound, so they
-- always move between rows. The stick always passes through: on a slider the
-- navigation has nowhere to go sideways anyway.
function UI._onSettingsAdjust(self, inputState, input)
	local s = self._settings
	if not s or not s.open then
		return Enum.ContextActionResult.Pass
	end
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		local position = input.Position
		local dir = 0
		local ended = inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel
		if not ended and math.abs(position.X) > STICK_THRESHOLD and math.abs(position.X) > math.abs(position.Y) then
			dir = if position.X > 0 then 1 else -1
		end
		local holding = s.hold and s.hold.source == "stick" and s.hold.dir or 0
		if dir == 0 then
			self:_stopHold("stick")
		elseif dir ~= holding then
			self:_startHold("stick", dir)
		end
		return Enum.ContextActionResult.Pass
	end
	local dir = if input.KeyCode == Enum.KeyCode.DPadLeft then -1 else 1
	if inputState == Enum.UserInputState.Begin then
		if self:_startHold(input.KeyCode, dir) then
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		local held = s.hold ~= nil and s.hold.source == input.KeyCode
		self:_stopHold(input.KeyCode)
		return if held then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass
	end
	return Enum.ContextActionResult.Pass
end

function UI._bindSettingsAdjust(self, on)
	local s = self._settings
	if on == (s.adjustBound == true) then
		return
	end
	s.adjustBound = on
	if on then
		ContextActionService:BindActionAtPriority(SETTINGS_ACTION, function(_, inputState, input)
			return self:_onSettingsAdjust(inputState, input)
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight, Enum.KeyCode.Thumbstick1)
	else
		ContextActionService:UnbindAction(SETTINGS_ACTION)
	end
end

-- Opens the sheet over the menu or the run report. `opener` gets the gamepad
-- selection back when it closes.
function UI._openSettings(self, opener)
	local s = self._settings
	if not s or s.open or self._hud.layer.Visible then
		return
	end
	s.open = true
	s.returnTo = opener or GuiService.SelectedObject
	s.layer.Visible = true
	self:_layoutSettings()
	self:_refreshSettings()
	s.body.CanvasPosition = Vector2.zero
	s.wash.BackgroundTransparency = 1
	tween(s.wash, 0.25, { BackgroundTransparency = 0.25 })
	s.sheet.Position = UDim2.new(0.5, 0, 0.5, 16)
	tween(s.sheet, 0.3, { Position = UDim2.fromScale(0.5, 0.5) })
	-- The gear on the button turns a quarter (it looks the same at rest).
	local face = opener and opener:FindFirstChild("Face")
	local gear = face and face:FindFirstChild("Gear")
	if gear and gear:IsA("GuiObject") then
		gear.Rotation = 0
		tween(gear, 0.45, { Rotation = 90 }, Enum.EasingStyle.Back)
	end
	self:_bindSettingsAdjust(true)
	self:_syncBack()
	self:_refreshHints()
	self:_focus(s.sliders.music.holder)
end

-- `quiet`: the screen underneath is changing anyway, so don't move the selection.
function UI._closeSettings(self, quiet)
	local s = self._settings
	if not s or not s.open then
		return
	end
	s.open = false
	self:_endSliderDrag()
	self:_stopHold()
	s.layer.Visible = false
	self:_bindSettingsAdjust(false)
	self:_syncBack()
	self:_refreshHints()
	local returnTo = s.returnTo
	s.returnTo = nil
	if not quiet then
		self:_returnFocus(s.layer, returnTo)
	end
end

-- Toasts and zone card ------------------------------------------------------------------

function UI._buildToasts(self)
	local layer = new("Frame", { Name = "Toasts", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = self.gui })

	local stack = new("Frame", { Name = "Stack", BackgroundTransparency = 1, Position = UDim2.fromScale(0, 0.32), Size = UDim2.fromOffset(270, 160), Parent = layer })
	fit(stack, HUD_SCALE)
	list(stack, 6)
	self._toastStack = stack

	-- Checkpoint title card
	local card = new("CanvasGroup", {
		Name = "ZoneCard",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, ZONE_CARD_Y),
		Size = UDim2.fromOffset(360, 106),
		GroupTransparency = 1,
		Visible = false,
		Parent = layer,
	})
	fit(card, HUD_SCALE)
	local label = text({ Text = "CHECKPOINT", TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(110, 14), Parent = card })
	label.BackgroundTransparency = 0.1
	label.BackgroundColor3 = PAPER
	local ruleLeft = rule(card, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.5, -60, 0, 7), Size = UDim2.fromOffset(0, 1) })
	local ruleRight = rule(card, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 60, 0, 7), Size = UDim2.fromOffset(0, 1) })
	local slab = new("Frame", { BackgroundColor3 = PAPER, BackgroundTransparency = 0.08, Position = UDim2.fromOffset(2, 18), Size = UDim2.new(1, -4, 0, 58), Parent = card })
	stroke(slab, 1.5)
	brackets(slab, 8, 2)
	local title = capText(text({
		Text = "",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		Parent = slab,
	}), 40, 12)
	local bar = new("Frame", { Position = UDim2.fromOffset(0, 80), Size = UDim2.new(0, 0, 0, 5), Parent = card })
	setAccent(bar, "BackgroundColor3")
	-- Optional reward line under the bar (level ups).
	local sub = text({
		Text = "",
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0.1,
		BackgroundColor3 = PAPER,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 89),
		Size = UDim2.fromOffset(300, 15),
		Visible = false,
		Parent = card,
	})
	self._zoneCard = { card = card, label = label, title = title, sub = sub, ruleLeft = ruleLeft, ruleRight = ruleRight, bar = bar }
end

function UI._showZoneCard(self, value, heading, subline, duration)
	local z = self._zoneCard
	local token = {}
	z.token = token
	local holdTime = duration or ZONE_CARD_TIME
	z.label.Text = heading or "CHECKPOINT"
	z.sub.Text = subline or ""
	z.sub.Visible = subline ~= nil and subline ~= ""
	z.title.Text = string.upper(value)
	z.card.Visible = true
	z.card.GroupTransparency = 1
	z.card.Position = UDim2.new(0.5, 0, ZONE_CARD_Y, 12)
	z.ruleLeft.Size = UDim2.fromOffset(0, 1)
	z.ruleRight.Size = UDim2.fromOffset(0, 1)
	z.bar.Size = UDim2.new(0, 0, 0, 5)
	tween(z.card, 0.2, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, ZONE_CARD_Y) })
	tween(z.ruleLeft, 0.25, { Size = UDim2.fromOffset(120, 1) })
	tween(z.ruleRight, 0.25, { Size = UDim2.fromOffset(120, 1) })
	tween(z.bar, holdTime, { Size = UDim2.new(1, 0, 0, 5) }, Enum.EasingStyle.Linear)
	task.delay(holdTime, function()
		if z.token ~= token then
			return
		end
		tween(z.card, 0.2, { GroupTransparency = 1, Position = UDim2.new(0.5, 0, ZONE_CARD_Y, -10) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.21, function()
			if z.token == token then
				z.card.Visible = false
			end
		end)
	end)
end

function UI._dismissToast(self, toast)
	if toast.gone then
		return
	end
	toast.gone = true
	local index = table.find(self._toasts, toast)
	if index then
		table.remove(self._toasts, index)
	end
	tween(toast.card, 0.2, { Position = UDim2.new(-1, 0, 0, 0), GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(0.21, function()
		toast.holder:Destroy()
	end)
end

-- Damage vignette ---------------------------------------------------------------------

function UI._buildFx(self)
	local layer = new("Frame", { Name = "Fx", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = self.gui })
	self._vignette = {}
	local fade = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.35, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	-- { size, position, gradient rotation (0 = opaque end first), bleed size, bleed position }
	local edges = {
		{ UDim2.new(1, 0, 0.22, 0), UDim2.new(), 90, UDim2.new(1, 400, 0, 200), UDim2.fromOffset(-200, -200) },
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0.78), -90, UDim2.new(1, 400, 0, 200), UDim2.new(0, -200, 1, 0) },
		{ UDim2.new(0.14, 0, 1, 0), UDim2.new(), 0, UDim2.new(0, 200, 1, 0), UDim2.fromOffset(-200, 0) },
		{ UDim2.new(0.14, 0, 1, 0), UDim2.fromScale(0.86, 0), 180, UDim2.new(0, 200, 1, 0), UDim2.new(1, 0, 0, 0) },
	}
	for _, edge in edges do
		local frame = new("Frame", { BackgroundColor3 = DANGER, BackgroundTransparency = 1, Size = edge[1], Position = edge[2], Parent = layer })
		new("UIGradient", { Rotation = edge[3], Transparency = fade, Parent = frame })
		table.insert(self._vignette, frame)
		local outside = new("Frame", { BackgroundColor3 = DANGER, BackgroundTransparency = 1, Size = edge[4], Position = edge[5], Parent = layer })
		table.insert(self._vignette, outside)
	end

	-- Shield break: a diamond ring bursting outwards (the controller adds the
	-- shards and tint in the world).
	local shield = boostInfo("Shield")
	local color = shield and shield.Color or PAPER
	local ring = new("Frame", {
		Name = "ShieldRing",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(60, 60),
		Rotation = 45,
		Visible = false,
		Parent = layer,
	})
	local ringStroke = stroke(ring, 3, color, 1)
	self._shieldFlash = { ring = ring, ringStroke = ringStroke, last = 0 }

	-- With flashes off, a hit shows as a thin red line around the screen that
	-- fades out, instead of the full red wash.
	local edge = new("Frame", {
		Name = "DamageEdge",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		Parent = layer,
	})
	self._damageEdge = stroke(edge, 3, DANGER, 1)
end

function UI._shake(self, target, strength)
	local token = {}
	self._shakeToken = token
	task.spawn(function()
		for step = 1, 6 do
			if self._shakeToken ~= token then
				return
			end
			local magnitude = strength * (7 - step) / 6
			tween(target, 0.035, {
				Position = UDim2.fromOffset(rng:NextNumber(-magnitude, magnitude), rng:NextNumber(-magnitude, magnitude)),
			}, Enum.EasingStyle.Sine)
			task.wait(0.035)
		end
		if self._shakeToken == token then
			tween(target, 0.08, { Position = UDim2.new() }, Enum.EasingStyle.Sine)
		end
	end)
end

-- Callback plumbing ------------------------------------------------------------------

-- Robux buttons: drawn off until the save loaded; a tap then says why.
function UI._robuxButton(self, button)
	self._robuxButtons[button] = true
	button.onBlocked = function()
		self:_robuxRefused()
	end
	button.setEnabled(saveLoaded())
	return button
end

function UI._robuxRefused(self)
	if saveFailed() then
		self:toast(SAVE_FAILED_TEXT, "error")
	else
		self:toast(SAVE_LOADING_TEXT, "info")
	end
end

-- DataLoaded / DataFailed changed (or anything that shows Robux offers redrew).
function UI._refreshSaveState(self)
	local loaded = saveLoaded()
	local failed = saveFailed()
	for button in self._robuxButtons do
		if button.holder.Parent then
			if button.enabled ~= loaded then
				button.setEnabled(loaded)
			end
		else
			self._robuxButtons[button] = nil -- its row was rebuilt
		end
	end
	local m = self._menu
	if m.saveBanner.Visible ~= failed then
		m.saveBanner.Visible = failed
		local bottom = FOOTER_H + (if failed then SAVE_BANNER_H else 0)
		for _, tab in m.tabs do
			tab.page.Size = UDim2.new(1, 0, 1, -(TAB_H + 1 + bottom))
		end
	end
	self._over.saveWarning.Visible = failed
	if not loaded then
		self:_hideTopUp()
		self:hideRevive()
	end
	self:_refreshStarter()
	self:_refreshSeasonUnlock()
	self:_refreshPremium() -- keeps BUY off while a paid ball is unlocking
end

-- Fire-and-forget callbacks run in their own thread so errors keep their stack trace.
-- Robux prompts are refused (with the reason) until the save has loaded.
function UI._fire(self, name, ...)
	if ROBUX_CALLBACKS[name] and not saveLoaded() then
		self:_robuxRefused()
		return
	end
	local callback = self._callbacks[name]
	if type(callback) == "function" then
		task.spawn(callback, ...)
	end
end

-- Yielding callbacks that answer (ok, message). Errors count as a failure.
function UI._ask(self, name, ...)
	local callback = self._callbacks[name]
	if type(callback) ~= "function" then
		return false, nil
	end
	local results = table.pack(pcall(callback, ...))
	if not results[1] then
		warn("[UI] " .. name .. " failed:", results[2])
		return false, nil
	end
	local message = results[3]
	return results[2] == true, if type(message) == "string" then message else nil
end

function UI._refreshAll(self)
	self:_refreshStats()
	self:_refreshLevel()
	self:_refreshDaily()
	self:_refreshCountdowns()
	self:_rebuildTopRuns()
	self:_rebuildPasses()
	self:_rebuildZones()
	self:_rebuildMissions()
	self:_rebuildSeason()
	self:_refreshStarter()
	self:_refreshSkins()
	self:_refreshFx()
	self:_refreshBoosts()
	self:_refreshSaveState()
end

-- Gamepad selection -------------------------------------------------------------------
-- Nothing here does anything unless the last input came from a controller.

-- Puts the gamepad selection on `target` (a button that is on screen).
function UI._focus(self, target)
	if not self._gamepad or target == nil then
		return
	end
	GuiService.SelectedObject = target
	-- The engine can drop a selection made in the same frame something opens or
	-- closes (B also clears it by default); put it back once things settle.
	task.delay(0.05, function()
		if self._gamepad and GuiService.SelectedObject == nil and onScreen(target) then
			GuiService.SelectedObject = target
		end
	end)
end

-- The button a gamepad player should land on for whatever is showing, or nil
-- during a run (so A / R2 go to the game, not the UI).
function UI._primary(self)
	local settings = self._settings
	if settings and settings.open then
		return settings.sliders.music.holder
	end
	local m = self._menu
	if m.root.Visible then
		if m.modalOpen then
			return self:_modalPrimary()
		end
		local t = self._topUp
		if t and t.strip.Visible then
			return t.buy.holder
		end
		local pop = m.boostPop
		if pop and pop.frame.Visible then
			return pop.gems.holder
		end
		return m.play.holder
	end
	local g = self._over
	if g.root.Visible then
		return if g.reviveGroup.Visible then g.reviveButton.holder else g.playAgain.holder
	end
	return nil
end

-- After `container` closed: if the selection was in it (or got dropped), move it
-- back to `target` (what opened it), or to the screen's main button.
function UI._returnFocus(self, container, target)
	if not self._gamepad then
		return
	end
	local selected = GuiService.SelectedObject
	if selected ~= nil and selected ~= container and not selected:IsDescendantOf(container) then
		return -- the player had already moved on
	end
	if target and target.Selectable and onScreen(target) then
		self:_focus(target)
	else
		self:_focus(self:_primary())
	end
end

-- Rows get rebuilt when data changes (claiming a mission...). Remember where the
-- selection was by name, so it can land in the same place afterwards.
function UI._captureFocus(self, container)
	local selected = GuiService.SelectedObject
	if not self._gamepad or selected == nil or not selected:IsDescendantOf(container) then
		return nil
	end
	local path = {}
	local node = selected
	while node and node ~= container do
		table.insert(path, 1, node.Name)
		node = node.Parent
	end
	return path
end

function UI._restoreFocus(self, container, path, fallback)
	if path == nil or not self._gamepad then
		return
	end
	local node = container
	for _, name in path do
		node = node and node:FindFirstChild(name)
	end
	if node and node:IsA("GuiButton") and node.Selectable and onScreen(node) then
		self:_focus(node)
		return
	end
	-- That button is gone (claimed...): the same row's other button, any row's, or the tab.
	local row = container:FindFirstChild(path[1])
	self:_focus(firstSelectable(row) or firstSelectable(container) or fallback)
end

function UI._popoverOpen(self)
	local settings = self._settings
	if settings and settings.open then
		return true -- over the menu or the run report
	end
	local m = self._menu
	if not m.root.Visible then
		return false
	end
	local t = self._topUp
	local pop = m.boostPop
	return m.modalOpen ~= nil or (pop ~= nil and pop.frame.Visible) or (t ~= nil and t.strip.Visible)
end

-- Gamepad B closes the top-most popover. Bound only while one is open, so B is
-- free for everything else the rest of the time.
function UI._syncBack(self)
	local open = self:_popoverOpen()
	if open ~= (self._backBound == true) then
		self._backBound = open
		if open then
			ContextActionService:BindActionAtPriority(BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					self:_back()
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		else
			ContextActionService:UnbindAction(BACK_ACTION)
		end
	end
end

function UI._back(self)
	local m = self._menu
	local t = self._topUp
	if self._settings and self._settings.open then
		self:_closeSettings() -- always the top-most sheet
	elseif t and t.strip.Visible then
		self:_hideTopUp()
	elseif m.boostPop and m.boostPop.frame.Visible then
		self:_closeBoostPop()
	elseif m.modalOpen then
		self:_closeModal()
	end
end

-- Controller hints: menu footer, and "R2 THROW" under the balls during the first run.
function UI._refreshHints(self)
	local gamepad = self._gamepad == true
	local m = self._menu
	m.footerHint.Visible = gamepad
	m.footerSpec.Visible = not gamepad
	local s = self._settings
	if s then
		s.hint.Visible = gamepad
		s.note.Visible = not gamepad
	end
	local h = self._hud
	local throw = gamepad and h.layer.Visible and self._runsEnded == 0
	h.throwHint.Visible = throw
	if h.boostRail then
		h.boostRail.rail.Position = UDim2.new(0.5, 0, 1, if throw then 22 else 6)
	end
	self:_refreshBarHints()
end

function UI._setGamepad(self, gamepad)
	if gamepad == self._gamepad then
		return
	end
	self._gamepad = gamepad
	if gamepad then
		if GuiService.SelectedObject == nil then
			self:_focus(self:_primary())
		end
	else
		-- Back on touch / mouse: don't leave a selection box hanging around.
		local selected = GuiService.SelectedObject
		if selected and selected:IsDescendantOf(self.gui) then
			GuiService.SelectedObject = nil
		end
	end
	self:_refreshHints()
end

-- Public API ---------------------------------------------------------------------------

function UI.new(callbacks)
	local self = setmetatable({}, UI)
	self._callbacks = callbacks or {}
	self._alive = true
	self._toasts = {}
	self._toastSerial = 0
	self._connections = {}
	self._menuOpens = 0
	self._robuxButtons = setmetatable({}, { __mode = "k" }) -- see _robuxButton
	self._runsEnded = 0 -- game overs this session (the "R2 THROW" hint shows until the first)
	self._gamepad = gamepadAtStart()
	-- Last pointer input was touch (no keycap hints on the boost bar).
	self._touch = UserInputService:GetLastInputType() == Enum.UserInputType.Touch
		or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)

	local playerGui = player:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("ShatterRunUI")
	if old then
		old:Destroy()
	end

	-- CoreUISafeInsets: the usable area starts below Roblox's top bar and inside
	-- the notch / home bar, so no text or button can end up under them.
	-- Not clipping lets the full-screen washes (see `bleed`) still reach every edge.
	self.gui = new("ScreenGui", {
		Name = "ShatterRunUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ClipToDeviceSafeArea = false,
		DisplayOrder = 10,
	})

	-- One blueprint selection box for every gamepad-selected button in PlayerGui.
	local box, boxStroke = selectionBox()
	self._selectionStroke = boxStroke
	playerGui.SelectionImageObject = box

	-- Back to front.
	self:_buildMenu()
	self:_buildHud()
	self:_buildGameOver()
	self:_buildSettings()
	self:_buildToasts()
	self:_buildFx()
	self:_selectTab(1)

	self.gui.Parent = playerGui

	local function refit()
		local size = self.gui.AbsoluteSize
		if size.X < 1 or size.Y < 1 then
			return
		end
		currentScale = math.clamp(math.min(size.X / REF_W, size.Y / REF_H), SCALE_MIN, SCALE_MAX)
		for _, entry in scalers do
			entry[1].Scale = currentScale * entry[2]
		end
		local live = {}
		for _, entry in textCaps do
			if entry[1].Parent then
				applyCap(entry)
				table.insert(live, entry)
			end
		end
		textCaps = live
		self:_layoutSettings()
		self:_layoutBoostBar()
	end
	refit()

	local function connect(signal, handler)
		table.insert(self._connections, signal:Connect(handler))
	end
	connect(self.gui:GetPropertyChangedSignal("AbsoluteSize"), refit)

	-- Live data. Attributes can arrive after the UI exists; every reader handles nil.
	local function onAttribute(name, handler)
		connect(player:GetAttributeChangedSignal(name), handler)
	end
	onAttribute("Best", function()
		self:_refreshStats()
	end)
	onAttribute("Gems", function()
		self:_refreshStats()
	end)
	onAttribute("Checkpoint", function()
		self:_rebuildZones()
		self:_rebuildPasses() -- the CHECKPOINTS card shows once a zone is reached
	end)
	for _, name in { "DataLoaded", "DataFailed" } do
		onAttribute(name, function()
			self:_refreshSaveState()
		end)
	end
	onAttribute("EquippedSkin", function()
		self:_refreshSkins()
		self:_showMenuBall(player:GetAttribute("EquippedSkin"))
	end)
	onAttribute("OwnedSkins", function()
		self:_refreshSkins()
	end)
	for _, name in { "NextDaily", "StreakDay", "StreakExpires" } do
		onAttribute(name, function()
			if name ~= "NextDaily" then
				self._saverPendingUntil = nil -- the streak changed: the saver (if any) has landed
			end
			self:_refreshDaily()
		end)
	end
	-- Streak saver prompt closed: cancelled frees CLAIM now; paid keeps it off
	-- until the server saves the streak (the attribute change above).
	connect(MarketplaceService.PromptProductPurchaseFinished, function(userId, id, purchased)
		if userId ~= player.UserId or id ~= productId("StreakSaver") or self._saverPendingUntil == nil then
			return
		end
		self._saverPendingUntil = if purchased then os.clock() + SAVER_GRANT_WAIT else nil
		self:_refreshDaily()
	end)
	-- Premium ball paid for: BUY shows UNLOCKING... (and can't be pressed) until
	-- OwnedSkins has it (the OwnedSkins handler above refreshes) or the wait ends.
	connect(MarketplaceService.PromptProductPurchaseFinished, function(userId, id, purchased)
		if userId ~= player.UserId or not purchased then
			return
		end
		for _, ballId in Config.PremiumBalls do
			local skin = Config.getSkin(ballId)
			if skin and skin.ProductKey and id == productId(skin.ProductKey) and id ~= 0 then
				self._premiumPendingUntil = self._premiumPendingUntil or {}
				self._premiumPendingUntil[ballId] = os.clock() + PREMIUM_GRANT_WAIT
				self:_refreshPremium()
				task.delay(PREMIUM_GRANT_WAIT + 0.1, function()
					self:_refreshPremium()
				end)
				break
			end
		end
	end)
	for _, name in { "Level", "XP", "XPNeeded" } do
		onAttribute(name, function()
			self:_refreshLevel()
		end)
	end
	for _, name in { "Missions", "MissionRerolls" } do
		onAttribute(name, function()
			self:_rebuildMissions()
		end)
	end
	onAttribute("MissionsReset", function()
		self:_refreshCountdowns()
	end)
	for _, name in { "SeasonTier", "SeasonClaimed", "SeasonPremium", "SeasonId" } do
		onAttribute(name, function()
			self:_rebuildSeason()
		end)
	end
	onAttribute("SeasonXP", function()
		self:_refreshSeasonProgress()
	end)
	for _, name in { "OwnedFx", "EquippedFx" } do
		onAttribute(name, function()
			self:_refreshFx()
		end)
	end
	onAttribute("StarterPackBought", function()
		self:_refreshStarter()
	end)
	onAttribute("BonusBalls", function()
		self:_refreshStats()
	end)
	onAttribute("Boosts", function()
		self:_refreshBoosts()
	end)
	onAttribute("Stats", function()
		self:_checkWelcome()
	end)
	for _, name in { "SeasonName", "SeasonEnds" } do
		connect(ReplicatedStorage:GetAttributeChangedSignal(name), function()
			self:_refreshSeasonProgress()
			self:_refreshCountdowns()
		end)
	end
	for _, key in PASS_ORDER do
		onAttribute("Pass_" .. key, function()
			self:_rebuildPasses()
			if key == "Checkpoints" then
				self:_rebuildZones()
			end
		end)
	end
	connect(ReplicatedStorage:GetAttributeChangedSignal("TopRuns"), function()
		self:_rebuildTopRuns()
	end)

	-- Settings apply live: redraw the sheet, and follow flashes / shake in the HUD.
	connect(Settings.changed, function(key)
		self:_refreshSettings()
		local h = self._hud
		if key == "flashes" then
			if h.low then
				self:_setLow(true) -- pulsing alarm <-> steady tint
			end
			if Settings.get("flashes") == false then
				for _, frame in self._vignette do
					frame.BackgroundTransparency = 1
				end
			end
		elseif key == "shake" and Settings.get("shake") == false then
			self._shakeToken = nil
			h.root.Position = UDim2.new()
		end
	end)

	-- Gamepad: follow the last input, and never leave a gamepad player with
	-- nothing selected on a menu-type screen (B clears the selection by default).
	connect(UserInputService.LastInputTypeChanged, function(inputType)
		local kind = inputKind(inputType)
		if kind then
			-- Touch vs keyboard / mouse only changes the boost bar's key hints.
			local touch = inputType == Enum.UserInputType.Touch
			if kind == "pointer" and touch ~= self._touch then
				self._touch = touch
				self:_refreshBarHints()
			end
			self:_setGamepad(kind == "gamepad" and UserInputService.GamepadEnabled)
		end
	end)
	connect(UserInputService.GamepadDisconnected, function()
		if not UserInputService.GamepadEnabled then
			self:_setGamepad(false)
		end
	end)
	connect(GuiService:GetPropertyChangedSignal("SelectedObject"), function()
		if GuiService.SelectedObject ~= nil or not self._gamepad then
			return
		end
		local token = {}
		self._refocusToken = token
		task.delay(0.15, function()
			if self._refocusToken == token and self._gamepad and GuiService.SelectedObject == nil then
				local target = self:_primary()
				if target and onScreen(target) then
					GuiService.SelectedObject = target
				end
			end
		end)
	end)

	connect(self.gui.Destroying, function()
		self._alive = false
		for _, connection in self._connections do
			connection:Disconnect()
		end
		if self._backBound then
			self._backBound = false
			ContextActionService:UnbindAction(BACK_ACTION)
		end
		if self._settings and self._settings.adjustBound then
			self._settings.adjustBound = false
			ContextActionService:UnbindAction(SETTINGS_ACTION)
		end
	end)

	-- One shared 1s tick drives every countdown, and only while the menu is open.
	task.spawn(function()
		while self._alive do
			if self._menu.root.Visible then
				self:_refreshDaily()
				self:_refreshCountdowns()
			end
			task.wait(1)
		end
	end)

	self:_refreshAll()
	self:_refreshHints()
	return self
end

function UI:showMenu()
	self:hideRevive()
	self._hud.layer.Visible = false
	self._over.root.Visible = false

	local m = self._menu
	m.root.Visible = true
	self._menuOpens += 1
	self:_refreshAll()
	self:_maybeShowOffer()
	-- Passes bought outside the game (or a check that failed on join) show up
	-- without a rejoin. Fire-and-forget: the server sets the Pass_ attributes.
	task.spawn(function()
		self:_ask("onShop", "RecheckPasses")
	end)

	m.left.Position = UDim2.new(0, EDGE - 16, 0.5, 0)
	tween(m.left, 0.35, { Position = UDim2.new(0, EDGE + 4, 0.5, 0) })
	m.panel.Position = UDim2.new(1, -(EDGE - 20), 0.5, 0)
	tween(m.panel, 0.35, { Position = UDim2.new(1, -(EDGE + 4), 0.5, 0) })
	local play = m.play.face
	play.Position = UDim2.fromOffset(2, 2)
	tween(play, 0.3, { Position = UDim2.new() }, Enum.EasingStyle.Back)
	self:_refreshHints()
	self:_focus(self:_primary()) -- PLAY, or the starter offer if it just opened
end

function UI:showHud()
	self:_closeSettings(true)
	self:hideRevive()
	self:_closeModal()
	-- A run is starting (or resuming): picks were handed over with onPlay.
	self:_closeBoostPop()
	self:_hideTopUp()
	if self._menu.boostPicks and #self._menu.boostPicks > 0 then
		table.clear(self._menu.boostPicks)
		self:_refreshBoosts()
	end
	self:_resetBoostRail()
	self._menu.root.Visible = false
	self._over.root.Visible = false
	self._hud.layer.Visible = true
	self:_syncBack()
	self:_refreshHints()
	-- No UI selection during a run, so the controller's buttons throw instead of clicking.
	GuiService.SelectedObject = nil
end

function UI:setHud(state)
	local h = self._hud
	if type(state) ~= "table" then
		return
	end

	local balls = math.max(0, math.floor(tonumber(state.balls) or 0))
	if balls ~= h.balls then
		local previous = h.balls
		h.balls = balls
		self:_setDigits(balls, previous == nil or balls > previous)
		if previous ~= nil and balls > previous then
			h.bump.Scale = 1.16
			tween(h.bump, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		local low = balls <= LOW_BALLS
		if low ~= h.low then
			h.low = low
			self:_setLow(low)
		end
	end

	local level = math.clamp(math.floor(tonumber(state.multiball) or 1), 1, #h.pips)
	if level ~= h.levelValue then
		local previous = h.levelValue
		h.levelValue = level
		h.level.Text = "x" .. level
		for i, pip in h.pips do
			pip.BackgroundTransparency = if i <= level then 0 else 1
		end
		if previous and level > previous then
			local pip = h.pips[level]
			pip.Size = UDim2.fromOffset(17, 17)
			tween(pip, 0.25, { Size = UDim2.fromOffset(11, 11) }, Enum.EasingStyle.Back)
		end
	end

	local streak = math.floor(math.clamp(tonumber(state.streak) or 0, 0, 1) * 100 + 0.5) / 100
	if streak ~= h.streakValue then
		h.streakValue = streak
		tween(h.streak, 0.15, { Size = UDim2.fromScale(streak, 1) })
	end

	local meters = math.max(0, tonumber(state.meters) or 0)
	local whole = math.floor(meters)
	if whole ~= h.metersValue then
		h.metersValue = whole
		h.meters.Text = commas(whole)
	end
	local offset = -math.floor((meters * h.tickPx) % h.tickPeriod + 0.5)
	if offset ~= h.tickOffset then
		h.tickOffset = offset
		h.ticks.Position = UDim2.fromOffset(offset, 0)
	end

	local zone = math.floor(tonumber(state.zone) or 0)
	if zone ~= h.zoneValue then
		h.zoneValue = zone
		h.zone.Text = twoDigits(zone)
	end

	self:_refreshQuickShield()
end

--[[
	Active boosts, called every frame by the controller:
	{ shield = bool, magnet = secondsLeft, slowmo = secondsLeft, megaball = throwsLeft, doubleGems = bool,
	  ready = { Magnet = n, SlowMo = n, MegaBall = n } (boost-bar boosts not tapped yet; optional) }
	Only properties that changed are written.
]]
function UI:setBoosts(state)
	local h = self._hud
	local b = h and h.boostRail
	if type(state) ~= "table" or not b then
		return
	end
	local items = b.items

	local shield = state.shield == true
	if shield ~= b.shield then
		local was = b.shield
		b.shield = shield
		if was == true and not shield and h.layer.Visible then
			self:flashShield()
		end
		self:_refreshQuickShield()
	end
	local justUsed = not shield and b.shieldUsedAt ~= nil and os.clock() - b.shieldUsedAt < SHIELD_USED_HOLD
	if shield then
		self:_setIndicator(items.Shield, true, 1, nil, "ON")
	else
		self:_setIndicator(items.Shield, justUsed, 0, nil, "USED")
	end

	-- Boost-bar boosts show in their bar slot (ready or counting down); the rail
	-- under the odometer only shows them when they're not in the bar (bought mid-run).
	local ready = if type(state.ready) == "table" then state.ready else EMPTY
	local slots = if h.boostBar then h.boostBar.slots else EMPTY
	for _, entry in TIMED_BOOSTS do
		local id = entry[1]
		local seconds = math.max(0, tonumber(state[entry[2]]) or 0)
		local boost = boostInfo(id)
		local duration = math.max(tonumber(boost and boost.Duration) or 1, seconds, 0.001)
		local whole = math.ceil(seconds)
		local fraction = seconds / duration
		local inBar = self:_setBarSlot(slots[id], ready[id], seconds > 0, whole, fraction, whole .. "S")
		self:_setIndicator(items[id], seconds > 0 and not inBar, whole, fraction, whole .. "S")
	end

	local throws = math.max(0, math.floor(tonumber(state.megaball) or 0))
	local mega = boostInfo("MegaBall")
	local maxThrows = math.max(tonumber(mega and mega.Throws) or 1, throws, 1)
	local megaInBar = self:_setBarSlot(slots.MegaBall, ready.MegaBall, throws > 0, throws, throws / maxThrows, "x" .. throws)
	self:_setIndicator(items.MegaBall, throws > 0 and not megaInBar, throws, throws / maxThrows, "x" .. throws)

	self:_setIndicator(items.DoubleGems, state.doubleGems == true, 1, nil, "2X GEMS")
end

-- The shield just absorbed a crash. Safe to call more than once per crash.
function UI:flashShield()
	local f = self._shieldFlash
	if not f then
		return
	end
	local now = os.clock()
	if now - f.last < 0.3 then
		return
	end
	f.last = now
	if Settings.get("flashes") ~= false then
		f.ring.Visible = true
		f.ring.Size = UDim2.fromOffset(60, 60)
		f.ringStroke.Transparency = 0
		tween(f.ring, 0.45, { Size = UDim2.fromOffset(420, 420) })
		tween(f.ringStroke, 0.45, { Transparency = 1 })
	end
	-- setBoosts keeps the shield plate up for a beat, reading USED.
	local rail = self._hud.boostRail
	if rail then
		rail.shieldUsedAt = now
		local item = rail.items.Shield
		if item and item.visible then
			item.scale.Scale = 1.3
			tween(item.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
end

function UI:showGameOver(info)
	info = info or {}
	local g = self._over
	self:_closeSettings(true)
	self._hud.layer.Visible = false
	self._menu.root.Visible = false
	g.root.Visible = true
	self._runsEnded += 1
	self:_syncBack()
	self:_refreshHints()

	local meters = math.max(0, math.floor(tonumber(info.meters) or 0))
	local best = math.max(meters, math.floor(tonumber(info.best) or 0))

	g.wash.BackgroundTransparency = 1
	tween(g.wash, 0.3, { BackgroundTransparency = 0.35 })
	g.sheet.Position = UDim2.new(0.05, -24, 0.5, 0)
	tween(g.sheet, 0.35, { Position = UDim2.new(0.05, 0, 0.5, 0) })

	-- Count the distance up and slide the run marker along the ruler with it.
	local span = math.max(best, 1) * 1.15
	for i, label in g.scaleLabels do
		label.Text = commas(span * i / 4)
	end
	g.bestMarker.Position = UDim2.fromScale(best / span, 0)
	g.runMarker.Position = UDim2.fromScale(0, 0)
	tween(g.runMarker, 0.7, { Position = UDim2.fromScale(meters / span, 0) })
	if g.counter then
		g.counter:Destroy()
	end
	local counter = Instance.new("NumberValue")
	g.counter = counter
	counter.Changed:Connect(function(value)
		g.distance.Text = commas(value)
	end)
	g.distance.Text = "0"
	tween(counter, 0.7, { Value = meters })

	g.best.Text = commas(best) .. " M"
	g.gems.Text = "+" .. commas(info.gemsEarned or 0)

	-- XP line waits for the server's RunSummary (see showProgress).
	local level, xp, needed = levelInfo()
	local token = {}
	g.summaryToken = token
	g.xpToken = nil
	g.xpValue.Text = "TALLYING..."
	g.xpLevel.Text = "LV " .. twoDigits(level)
	g.xpFill.Size = UDim2.fromScale(xp / needed, 1)
	g.xpProgress.Text = commas(xp) .. " / " .. commas(needed) .. " XP"
	g.xpMissions.Text = ""
	g.levelStamp.Visible = false
	if g.xpCounter then
		g.xpCounter:Destroy()
		g.xpCounter = nil
	end
	task.delay(SUMMARY_TIMEOUT, function()
		if g.summaryToken == token then
			g.xpValue.Text = "--" -- still accepted if it shows up later
		end
	end)

	g.stamp.Visible = info.isNewBest == true
	if info.isNewBest then
		g.stampScale.Scale = 1.8
		g.stamp.Rotation = -18
		task.delay(0.5, function()
			if g.stamp.Visible then
				tween(g.stampScale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
				tween(g.stamp, 0.22, { Rotation = -9 }, Enum.EasingStyle.Back)
			end
		end)
	end

	self:hideRevive()
	g.saveWarning.Visible = saveFailed()
	if info.canRevive and Config.Products.Revive.Id ~= 0 and saveLoaded() then
		g.reviveGroup.Visible = true
		g.reviveBar.Size = UDim2.fromScale(1, 1)
		local countdown = TweenService:Create(
			g.reviveBar,
			TweenInfo.new(Config.REVIVE_SECONDS, Enum.EasingStyle.Linear),
			{ Size = UDim2.fromScale(0, 1) }
		)
		g.reviveTween = countdown
		countdown.Completed:Connect(function(playbackState)
			if playbackState == Enum.PlaybackState.Completed and g.reviveTween == countdown then
				self:hideRevive()
			end
		end)
		countdown:Play()
	end
	self:_focus(self:_primary()) -- REVIVE while it's on offer, else PLAY AGAIN
end

function UI:hideRevive()
	local g = self._over
	local countdown = g.reviveTween
	g.reviveTween = nil
	if countdown then
		countdown:Cancel()
	end
	local wasVisible = g.reviveGroup.Visible
	g.reviveGroup.Visible = false
	if wasVisible and g.root.Visible then
		self:_returnFocus(g.reviveGroup, g.playAgain.holder)
	end
end

function UI:toast(value, kind)
	value = string.upper(tostring(value or ""))
	kind = kind or "info"
	if kind == "checkpoint" then
		self:_showZoneCard(value)
		return
	end
	local style = TOAST_KINDS[kind] or TOAST_KINDS.info
	-- The same words twice within a second (e.g. controller + server event) show once.
	local now = os.clock()
	if value == self._lastToastText and now - (self._lastToastAt or 0) < 1 then
		return
	end
	self._lastToastText = value
	self._lastToastAt = now

	while #self._toasts >= MAX_TOASTS do
		self:_dismissToast(self._toasts[1])
	end

	self._toastSerial += 1
	local holder = new("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = self._toastSerial,
		Parent = self._toastStack,
	})
	local card = new("CanvasGroup", {
		BackgroundTransparency = 1,
		Position = UDim2.new(-1, 0, 0, 0),
		Size = UDim2.new(1, -12, 1, 0),
		Parent = holder,
	})
	new("Frame", { BackgroundColor3 = INK, Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -4, 1, -4), Parent = card })
	local face = new("Frame", { BackgroundColor3 = PAPER, Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -5, 1, -5), Parent = card })
	stroke(face, 1)
	if style.hatch then
		hatch(face, { Size = UDim2.new(0, 6, 1, 0) }, INK, 0, 3)
	else
		local bar = new("Frame", { BackgroundColor3 = INK, Size = UDim2.new(0, 5, 1, 0), Parent = face })
		if style.accent then
			setAccent(bar, "BackgroundColor3")
		end
	end
	text({ Text = style.tag, TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(14, 3), Size = UDim2.new(1, -20, 0, 10), Parent = face })
	capText(text({
		Text = value,
		Font = FONT_NUM,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.new(1, -20, 0, 22),
		Parent = face,
	}), 13, 7)

	local toast = { holder = holder, card = card }
	table.insert(self._toasts, toast)
	card.Position = UDim2.new(-1, 0, 0, 0)
	tween(card, 0.3, { Position = UDim2.fromOffset(EDGE, 0) })
	task.delay(TOAST_TIME, function()
		self:_dismissToast(toast)
	end)
end

-- Respects the player's settings: "flashes" off swaps the red wash for a thin
-- fading red edge, "shake" off keeps the HUD still.
function UI:flashDamage()
	if Settings.get("flashes") == false then
		local edge = self._damageEdge
		if edge then
			edge.Transparency = 0.3
			tween(edge, 0.7, { Transparency = 1 }, Enum.EasingStyle.Sine)
		end
	else
		for _, frame in self._vignette do
			frame.BackgroundTransparency = 0.05
			tween(frame, 0.45, { BackgroundTransparency = 1 })
		end
	end
	if Settings.get("shake") ~= false then
		self:_shake(self._hud.root, 7)
	end
end

function UI:setTheme(theme)
	if type(theme) ~= "table" or typeof(theme.Accent) ~= "Color3" then
		return
	end
	accentColor = theme.Accent
	if self._selectionStroke then
		self._selectionStroke.Color = accentColor
	end
	for inst, prop in accentTargets do
		if inst.Parent == nil then
			accentTargets[inst] = nil
		else
			tween(inst, 0.35, { [prop] = accentColor })
		end
	end
end

function UI:isMenuOpen()
	return self._menu.root.Visible
end

-- The equipped ball (RunController calls it at run start and when EquippedSkin
-- changes): tints the HUD swatch next to BALLS and updates the menu's PLAY ball.
function UI:setBallSkin(skinId)
	local skin = Config.getSkin(skinId)
	local h = self._hud
	if h and h.skinSwatch then
		h.skinGradient.Enabled = skin.Rainbow == true
		h.skinSwatch.BackgroundColor3 = if skin.Rainbow then PAPER else skin.Color
		h.skinSwatchTrail.Visible = not skin.Rainbow
		h.skinSwatchTrail.BackgroundColor3 = skin.Trail or skin.Ring or skin.Color
		h.skinName.Text = string.upper(skin.Name or skin.Id)
	end
	self:_showMenuBall(skin.Id)
end

-- Fills in the run report's XP line from the server's RunSummary.
function UI._applyRunSummary(self, event)
	local g = self._over
	if not g.root.Visible or g.summaryToken == nil then
		return -- report already closed (or this summary was for an earlier death)
	end
	local token = {}
	g.summaryToken = nil
	g.xpToken = token

	local gained = math.max(0, math.floor(tonumber(event.xp) or 0))
	local before = math.max(1, math.floor(tonumber(event.levelBefore) or 1))
	local after = math.max(before, math.floor(tonumber(event.levelAfter) or before))
	local missionsDone = math.max(0, math.floor(tonumber(event.missionsCompleted) or 0))
	if tonumber(event.gems) then
		g.gems.Text = "+" .. commas(event.gems)
	end
	g.xpMissions.Text = if missionsDone > 0
		then "+" .. missionsDone .. (if missionsDone == 1 then " MISSION DONE" else " MISSIONS DONE")
		else ""

	local counter = Instance.new("NumberValue")
	g.xpCounter = counter
	counter.Changed:Connect(function(value)
		g.xpValue.Text = "+" .. commas(value) .. " XP"
	end)
	g.xpValue.Text = "+0 XP"
	tween(counter, 0.6, { Value = gained })

	local function settle()
		local _, xp, needed = levelInfo()
		g.xpLevel.Text = "LV " .. twoDigits(after)
		g.xpProgress.Text = commas(xp) .. " / " .. commas(needed) .. " XP"
		tween(g.xpFill, 0.5, { Size = UDim2.fromScale(xp / needed, 1) })
	end

	if after > before then
		-- Fill to the end, roll over to the new level, then fill to the current XP.
		tween(g.xpFill, 0.45, { Size = UDim2.fromScale(1, 1) })
		task.delay(0.5, function()
			if g.xpToken ~= token or not g.root.Visible then
				return
			end
			g.xpFill.Size = UDim2.fromScale(0, 1)
			settle()
			g.levelStamp.Visible = true
			g.levelStampScale.Scale = 1.8
			g.levelStamp.Rotation = -14
			tween(g.levelStampScale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
			tween(g.levelStamp, 0.22, { Rotation = -6 }, Enum.EasingStyle.Back)
		end)
	else
		settle()
	end
end

-- Progress events from the server (forwarded by the controller).
function UI:showProgress(event)
	if type(event) ~= "table" then
		return
	end
	local kind = event.type
	if kind == "RunSummary" then
		self:_applyRunSummary(event)
	elseif kind == "LevelUp" then
		local level = math.max(1, math.floor(tonumber(event.level) or 1))
		local parts = {}
		if tonumber(event.gems) and tonumber(event.gems) > 0 then
			table.insert(parts, "+" .. commas(event.gems) .. " GEMS")
		end
		if type(event.unlock) == "table" then
			local unlocked = rewardText(event.unlock)
			if unlocked ~= "" then
				local cosmetic = event.unlock.Skin ~= nil or event.unlock.Fx ~= nil
				table.insert(parts, if cosmetic then unlocked .. " UNLOCKED" else unlocked)
			end
		end
		local subline = table.concat(parts, " / ")
		-- Mid-run the big center card would hide the glass ahead (and replace the
		-- ZONE card, which often arrives at the same moment), so only the toast shows.
		local running = self._hud.layer.Visible and not self._over.root.Visible
		if not running then
			self:_showZoneCard("LEVEL " .. twoDigits(level), "LEVEL UP", subline, LEVEL_CARD_TIME)
		end
		self:toast("LEVEL " .. twoDigits(level) .. (if subline ~= "" then " / " .. subline else ""), "level")
	elseif kind == "MissionComplete" then
		self:toast("MISSION COMPLETE: " .. tostring(event.text or ""), "reward")
	elseif kind == "SeasonTier" then
		self:toast("SEASON TIER " .. twoDigits(tonumber(event.tier) or 0), "reward")
	elseif kind == "Reward" then
		if event.text ~= nil then
			self:toast(tostring(event.text), "reward")
		end
	elseif kind == "BoostsActivated" then
		-- "SHIELD ON / MAGNET + MEGA BALL READY": boost-bar boosts wait to be tapped.
		local on, waiting = {}, {}
		if type(event.boosts) == "table" then
			for _, id in event.boosts do
				if type(id) == "string" then
					table.insert(if table.find(BAR_IDS, id) then waiting else on, boostName(id))
				end
			end
		end
		local parts = {}
		if #on > 0 then
			table.insert(parts, table.concat(on, " + ") .. " ON")
		end
		if #waiting > 0 then
			table.insert(parts, table.concat(waiting, " + ") .. " READY")
		end
		if #parts > 0 and self._hud.layer.Visible then
			self:toast(table.concat(parts, " / "), "boost")
		end
	end
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Viewmodel</string>
            <string name="Source"><![CDATA[--[[
	Your arms in first person, each holding a ball.

	During a run your avatar's arms (the cleaned-up copy the server builds, see
	Server/ViewmodelRigs.server.luau) come up from the bottom-left and
	bottom-right of the view, each holding the equipped ball (HeldBall.luau).
	Throws alternate right, left, right, left: the throwing arm does a quick
	overhand throw, the ball flies from that hand, and the hand instantly grabs a
	new ball from the pocket (a quick dip, and the ball pops in).

	Balls in hand follow your ball count:
	  2 or more  both hands hold a ball
	  1          only the hand that throws next holds one
	  0          both hands are empty

	Layout: like the old single ball, each hand's ball sits at a fraction of the
	screen and its size is a share of the screen height, so the arms look the
	same on a phone, a PC or a TV at any field of view (the view widens at speed).
	The balls stay above the corner HUD buttons (Ball Pack right, Shield left).
	The arms are 3D parts, so the HUD is always drawn on top of them.

	Feel: a gentle running bob (the arms go up and down in turn, faster at
	higher speed) and a little sway when the camera kicks or shakes. Both are off
	when the player turns camera shake off in Settings.

	Viewmodel.start()           -- once: starts waiting for this player's arms
	Viewmodel.attach(folder)    -- the run's world folder (the balls live there)
	Viewmodel.setSkin(skinId)
	Viewmodel.update(dt, view)  -- every frame, after the camera has moved
		view = {
			show = bool,          -- false in the menu / game over
			balls = number,       -- balls left
			mega = bool,          -- MegaBall throws left (balls drawn bigger)
			avoid = Vector2?,     -- the tutorial pointer ring (viewport pixels)...
			avoidRadius = number?, -- ...a hand hides while it would cover it
			speedShare = number,  -- 0 at the start speed .. 1 at top speed
			worldRate = number,   -- how fast the world runs (slow-mo, hit-stop, frozen = 0)
		}
	Viewmodel.launch(both) -> firstSpot, secondSpot, firstSide, bothThrew
		Throws from the hand whose turn it is (and the other hand too when
		`both`, i.e. multiball, and it has a ball). The spots are the world
		positions of the thrown balls (nil = that hand isn't showing: throw from
		the middle of the view). firstSide: 1 = right hand, -1 = left hand.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ViewmodelRig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ViewmodelRig"))
local HeldBall = require(script.Parent.HeldBall)
local Settings = require(script.Parent.Settings)
local Sounds = require(script.Parent.Sounds)

local player = Players.LocalPlayer

local Viewmodel = {}

-- Arms (camera space: +X right, +Y up, -Z forward; numbers are for the right arm, the left one is mirrored)
local ARM_SCALE = 0.75 -- the R6 arm (1 x 2 x 1) is scaled to this: 0.75 wide, 1.5 long
local ARM_LENGTH = 2 * ARM_SCALE
local SHOULDER_DIRECTION = Vector3.new(0.1, -0.8, 0.6).Unit -- from the hand back to the shoulder: down, toward you, a bit outward
local BALL_FORWARD = 0.4 -- the ball sits this many ball-radii past the fingertips...
local BALL_UP = 1.0 -- ...and this many above the middle of the arm (resting in the hand)
local UP = Vector3.yAxis
local REST_FRONT = (UP - SHOULDER_DIRECTION * UP:Dot(SHOULDER_DIRECTION)).Unit -- the top of the arm at rest

-- Where each hand's ball sits on screen (center, as a fraction of the screen,
-- right hand; the left one is mirrored) and how big it is (diameter as a share
-- of the screen height). The arms are sized to match the ball.
local LAYOUT = {
	wide = { x = 0.78, y = 0.74, share = 0.2 },
	phone = { x = 0.72, y = 0.7, share = 0.24 }, -- short screens: further in, a bit bigger
}
local PHONE_HEIGHT = 600 -- viewport heights below this use the phone layout
local HIGHEST = 0.55 -- a ball's center never goes above this much of the screen height

-- Mirrors of UI.luau's HUD numbers (600x340 sheet, corner buttons 122x52, 12 from the edge)
-- so the balls always sit above the Ball Pack / Shield buttons.
local REF_W, REF_H = 600, 340
local SCALE_MIN, SCALE_MAX = 0.8, 2
local EDGE = 12
local CORNER_BUTTON = Vector2.new(122, 52)
local BUTTON_MARGIN = 10 -- pixels between a ball and the button / tutorial ring

-- Ball look
local MEGA_SCALE = 1.3 -- MegaBall throws left: bigger balls in your hands
local SPIN_RPS = 0.12 -- turns per second
local TILT = math.rad(20) -- tipped toward the camera so the top shows too
local PARTICLE_SHARE = { High = 0.7, Low = 0.5 } -- premium sparkles per hand (two balls on screen)

-- Throw (seconds). pitch: + = hand up and back, - = forward and down (radians,
-- around the shoulder). yaw: + = toward the middle. push: the arm slides along
-- itself (share of its length).
local WIND_TIME = 0.04
local SNAP_TIME = 0.08
local RETURN_TIME = 0.12
local WIND_POSE = { pitch = 0.35, yaw = -0.05, push = -0.1 }
local SNAP_POSE = { pitch = -0.35, yaw = 0.2, push = 0.1 }

-- Reload "from the pocket": once the snap is done the hand dips and a new ball pops in.
local RELOAD_AT = WIND_TIME + SNAP_TIME
local DIP_TIME = 0.05 -- the hand dips this long, then...
local POP_TIME = 0.06 -- ...the new ball grows in this long (while the hand comes back up)
local DIP_DEPTH = 0.07 -- screen-height share the hand dips
local DIP_OUT = 0.02 -- ...and moves out toward the pocket
local DIP_TWIST = 0.3 -- radians the hand flicks down
local DROP_TIME = 0.06 -- a ball put away (fewer balls than hands) shrinks this fast

-- Feel (screen-height shares; only while camera shake is on)
local BOB_STEPS = 1.6 -- running steps per second at the start speed...
local BOB_STEPS_FAST = 2.6 -- ...and at top speed
local BOB_Y = 0.008 -- each arm goes up and down this much, in turn
local BOB_X = 0.003 -- the body sways sideways this much
local LAG = 1.4 -- per radian the camera turns in a frame (throw recoil, crash kick)
local SHAKE_LAG = 0.05 -- per stud the camera jumps sideways (crash shake)
local LAG_MAX = 0.04
local LAG_RETURN = 10

-- Arms model
local RIG_WAIT = 10 -- seconds per wait for the server's rig folder (keeps waiting in the background)

local runFolder = nil
local model = nil -- this player's arms (a clone, parented to the camera)
local rigDirty = true -- rebuild the arms from the newest template
local rigFailed = false
local shakeOn = Settings.get("shake") ~= false
local bobPhase = 0
local lagX, lagY = 0, 0
local lastCamera = nil
local armParts = {} -- BulkMoveTo list: { right arm, left arm }
local armCFrames = {}

local function newHand(side)
	return {
		side = side, -- 1 = right, -1 = left
		ball = HeldBall.new(PARTICLE_SHARE),
		arm = nil, -- arm part in the current model
		visible = false, -- drawn this frame (false while it would cover the tutorial ring)
		wanted = false, -- the ball count says this hand holds a ball
		loaded = false, -- a ball is in the hand (or popping in)
		thrownAt = -math.huge, -- os.clock() of its last throw
		dipAt = -math.huge, -- the reload flick started
		dropAt = -math.huge, -- a ball was put away
		ballPosition = nil, -- world position of its ball last frame
		armVisible = false,
	}
end

local right = newHand(1)
local left = newHand(-1)
local hands = { right, left }

local function firstHand()
	return if Settings.get("leftHanded") == true then left else right
end
local nextHand = firstHand()

local function otherHand(hand)
	return if hand == right then left else right
end

Settings.changed:Connect(function(key, value)
	if key == "shake" then
		shakeOn = value ~= false
		if not shakeOn then
			lagX, lagY = 0, 0
		end
	end
end)

-- Arms model ----------------------------------------------------------------------

local function findTemplate()
	local folder = ReplicatedStorage:FindFirstChild(ViewmodelRig.FOLDER_NAME)
	local template = folder and folder:FindFirstChild(tostring(player.UserId))
	return if template and template:IsA("Model") then template else nil
end

local function destroyModel()
	if model then
		model:Destroy()
		model = nil
	end
	right.arm, left.arm = nil, nil
	right.armVisible, left.armVisible = false, false
	table.clear(armParts)
end

local function setArmVisible(hand, visible)
	if hand.arm and hand.armVisible ~= visible then
		hand.armVisible = visible
		hand.arm.Transparency = if visible then 0 else 1
	end
end

-- Always the same size of arm, whatever the template says.
local function normalizeArms(newModel, rightArm, leftArm)
	local factor = ARM_LENGTH / math.max(rightArm.Size.Y, 0.01)
	if math.abs(factor - 1) > 1e-3 then
		local ok = pcall(function()
			newModel:ScaleTo(newModel:GetScale() * factor)
		end)
		if not ok then
			rightArm.Size *= factor
			leftArm.Size *= factor
		end
	end
	local size = ViewmodelRig.ARM_SIZE * ARM_SCALE
	for _, arm in { rightArm, leftArm } do
		if (arm.Size - size).Magnitude > 0.01 then
			arm.Size = size
		end
	end
end

local function makeModel()
	local newModel = nil
	local template = findTemplate()
	if template then
		local ok, clone = pcall(template.Clone, template)
		if ok and clone then
			newModel = clone
		end
	end
	-- Checked again here: only arms, Humanoid, Shirt and Body Colors stay.
	if newModel and not ViewmodelRig.strip(newModel) then
		newModel:Destroy()
		newModel = nil
	end
	if not newModel then
		newModel = ViewmodelRig.buildDefault("Viewmodel")
		ViewmodelRig.strip(newModel)
	end
	newModel.Name = "Viewmodel"
	local rightArm = newModel:FindFirstChild("Right Arm")
	local leftArm = newModel:FindFirstChild("Left Arm")
	normalizeArms(newModel, rightArm, leftArm)
	for _, arm in { rightArm, leftArm } do
		ViewmodelRig.quietPart(arm)
		arm.Transparency = 1 -- shown by update
	end
	-- The camera keeps it between runs (the run's world folder is rebuilt every run),
	-- and the Humanoid inside lets the classic Shirt show on the arms.
	newModel.Parent = workspace.CurrentCamera
	return newModel, rightArm, leftArm
end

local function buildModel()
	destroyModel()
	rigDirty = false
	local ok, newModel, rightArm, leftArm = pcall(makeModel)
	if not ok then
		rigFailed = true
		warn("[Viewmodel] could not build the arms:", newModel)
		return
	end
	rigFailed = false
	model = newModel
	right.arm, left.arm = rightArm, leftArm
	armParts[1], armParts[2] = rightArm, leftArm
end

-- Layout --------------------------------------------------------------------------

-- The right hand's ball: screen spot (viewport pixels) and size share, kept
-- above the corner button. The left hand's is the mirror image.
local function screenSpot(viewport)
	local layout = if viewport.Y < PHONE_HEIGHT then LAYOUT.phone else LAYOUT.wide
	local radius = layout.share * viewport.Y / 2
	local x = layout.x * viewport.X
	local y = layout.y * viewport.Y

	local insetTop, insetBottom = GuiService:GetGuiInset()
	local safe = viewport - insetTop - insetBottom
	local sheet = math.clamp(math.min(safe.X / REF_W, safe.Y / REF_H), SCALE_MIN, SCALE_MAX)
	local button = CORNER_BUTTON * sheet
	local buttonTop = viewport.Y - insetBottom.Y - EDGE - button.Y - BUTTON_MARGIN
	if x + radius > viewport.X - insetBottom.X - EDGE - button.X - BUTTON_MARGIN then
		y = math.min(y, buttonTop - radius)
	end
	y = math.max(y, HIGHEST * viewport.Y)
	return x, y, layout.share
end

-- Viewport pixels -> a camera-space point `depth` studs in front.
local function cameraPoint(x, y, depth, viewport, tanY)
	local ndcX = x / viewport.X * 2 - 1
	local ndcY = 1 - y / viewport.Y * 2
	return Vector3.new(ndcX * tanY * viewport.X / viewport.Y * depth, ndcY * tanY * depth, -depth)
end

-- Camera-space point -> viewport pixels (nil if it's behind the camera).
local function screenPoint(point, viewport, tanY)
	local depth = -point.Z
	if depth < 0.05 then
		return nil
	end
	local aspect = viewport.X / viewport.Y
	return Vector2.new(
		(0.5 + 0.5 * point.X / (depth * tanY * aspect)) * viewport.X,
		(0.5 - 0.5 * point.Y / (depth * tanY)) * viewport.Y
	)
end

local function distanceToSegment(point, a, b)
	local ab = b - a
	local lengthSquared = ab:Dot(ab)
	local t = if lengthSquared > 0 then math.clamp((point - a):Dot(ab) / lengthSquared, 0, 1) else 0
	return (point - (a + ab * t)).Magnitude
end

local function mirror(v)
	return Vector3.new(-v.X, v.Y, v.Z)
end

local function ease(t)
	return 1 - (1 - t) * (1 - t)
end

-- The throwing arm's pose t seconds after the throw: pitch, yaw, push.
local function throwPose(t)
	local from, to, k
	if t >= WIND_TIME + SNAP_TIME + RETURN_TIME or t < 0 then
		return 0, 0, 0
	elseif t < WIND_TIME then
		from, to, k = nil, WIND_POSE, ease(t / WIND_TIME)
	elseif t < WIND_TIME + SNAP_TIME then
		from, to, k = WIND_POSE, SNAP_POSE, ease((t - WIND_TIME) / SNAP_TIME)
	else
		from, to, k = SNAP_POSE, nil, ease((t - WIND_TIME - SNAP_TIME) / RETURN_TIME)
	end
	local fromPitch = if from then from.pitch else 0
	local fromYaw = if from then from.yaw else 0
	local fromPush = if from then from.push else 0
	local toPitch = if to then to.pitch else 0
	local toYaw = if to then to.yaw else 0
	local toPush = if to then to.push else 0
	return fromPitch + (toPitch - fromPitch) * k, fromYaw + (toYaw - fromYaw) * k, fromPush + (toPush - fromPush) * k
end

-- 0..1: how far down the reload flick is (down and back up again).
local function dipAmount(hand, now)
	local t = (now - hand.dipAt) / (DIP_TIME + POP_TIME)
	if t <= 0 or t >= 1 then
		return 0
	end
	return math.sin(t * math.pi)
end

-- How big the hand's ball is drawn (0 = empty hand).
local function ballScale(hand, now)
	if hand.loaded then
		local t = (now - hand.dipAt - DIP_TIME) / POP_TIME
		if t <= 0 then
			return 0
		elseif t >= 1 then
			return 1
		end
		return math.max(0, 1 + 2.2 * (t - 1) ^ 3 + 1.2 * (t - 1) ^ 2) -- ease-out-back: a little overshoot, like a catch
	end
	local t = (now - hand.dropAt) / DROP_TIME
	return if t < 1 then 1 - t else 0
end

-- Public ----------------------------------------------------------------------------

local function hideAll()
	for _, hand in hands do
		hand.ball.hide()
		setArmVisible(hand, false)
		hand.visible = false
		hand.wanted = false
		hand.loaded = false
		hand.thrownAt = -math.huge
		hand.dipAt = -math.huge
		hand.dropAt = -math.huge
		hand.ballPosition = nil
	end
	nextHand = firstHand()
	lastCamera = nil
	lagX, lagY = 0, 0
end

function Viewmodel.start()
	-- The server builds the arms a moment after joining (it has to load the
	-- avatar). Until they arrive, plain default arms are used; when they
	-- arrive (even mid-run) they're swapped in.
	task.spawn(function()
		local folder = nil
		while not folder do
			folder = ReplicatedStorage:WaitForChild(ViewmodelRig.FOLDER_NAME, RIG_WAIT)
		end
		local myName = tostring(player.UserId)
		folder.ChildAdded:Connect(function(child)
			if child.Name == myName then
				rigDirty = true
			end
		end)
		if folder:FindFirstChild(myName) then
			rigDirty = true
		end
	end)
end

function Viewmodel.attach(folder)
	runFolder = folder
	for _, hand in hands do
		hand.ball.attach(folder)
	end
end

function Viewmodel.setSkin(skinId)
	for _, hand in hands do
		hand.ball.setSkin(skinId)
	end
end

function Viewmodel.update(dt, view)
	if not view.show or not runFolder or runFolder.Parent == nil then
		hideAll()
		return
	end
	if rigDirty or (model and model.Parent ~= workspace.CurrentCamera) or (model == nil and not rigFailed) then
		buildModel()
	end

	local camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize
	if viewport.X < 1 or viewport.Y < 1 then
		hideAll()
		return
	end
	local now = os.clock()
	local tanY = math.tan(math.rad(camera.FieldOfView) / 2)
	local spotX, spotY, share = screenSpot(viewport)
	-- Same size on screen at any field of view: the depth follows the FOV.
	local depth = HeldBall.DIAMETER / (2 * share * tanY)
	local studsPerScreen = 2 * depth * tanY -- studs per screen height at that depth
	local cameraCFrame = camera.CFrame

	-- Feel: running bob + lag behind camera kicks and shakes (only with shake on).
	if shakeOn then
		local steps = BOB_STEPS + (BOB_STEPS_FAST - BOB_STEPS) * math.clamp(view.speedShare or 0, 0, 1)
		bobPhase = (bobPhase + dt * (view.worldRate or 1) * steps * math.pi) % (math.pi * 2)
		if lastCamera then
			local delta = lastCamera:ToObjectSpace(cameraCFrame)
			local pitch, yaw = delta:ToEulerAnglesYXZ()
			local moved = delta.Position
			lagX = math.clamp(lagX + yaw * LAG - moved.X * SHAKE_LAG, -LAG_MAX, LAG_MAX)
			lagY = math.clamp(lagY + pitch * LAG + moved.Y * SHAKE_LAG, -LAG_MAX, LAG_MAX)
		end
		local settle = math.exp(-LAG_RETURN * dt)
		lagX *= settle
		lagY *= settle
	end
	lastCamera = cameraCFrame
	local swayX = if shakeOn then math.cos(bobPhase) * BOB_X else 0
	local bobY = if shakeOn then math.sin(bobPhase) * BOB_Y else 0

	local balls = view.balls or 0
	local megaScale = if view.mega then MEGA_SCALE else 1
	local spin = cameraCFrame.Rotation * CFrame.Angles(TILT, now * SPIN_RPS * math.pi * 2, 0)
	local avoid, avoidRadius = view.avoid, view.avoidRadius or 0

	for i, hand in hands do
		local side = hand.side

		-- Ball count rule, then the reload / put-away state.
		hand.wanted = balls >= 2 or (balls == 1 and hand == nextHand)
		if hand.wanted and not hand.loaded and now - hand.thrownAt >= RELOAD_AT then
			hand.loaded = true
			hand.dipAt = now -- quick flick to the pocket, then the new ball pops in
			if hand.thrownAt > -math.huge then
				Sounds.play("Reload", 0.95 + math.random() * 0.1) -- soft pocket grab
			end
		elseif not hand.wanted and hand.loaded then
			hand.loaded = false
			hand.dropAt = now
		end

		-- Everything below is worked out for the right arm and mirrored for the left.
		local x = spotX + side * (lagX + swayX) * viewport.Y
		local y = spotY + (lagY + side * bobY) * viewport.Y
		local restBall = cameraPoint(x, y, depth, viewport, tanY)
		local radius = HeldBall.DIAMETER / 2
		local restHand = restBall + SHOULDER_DIRECTION * (BALL_FORWARD * radius) - REST_FRONT * (BALL_UP * radius)
		local shoulder = restHand + SHOULDER_DIRECTION * ARM_LENGTH

		-- Throw swing around the shoulder, plus the reload dip.
		local pitch, yaw, push = throwPose(now - hand.thrownAt)
		local dip = dipAmount(hand, now)
		pitch -= DIP_TWIST * dip
		shoulder += Vector3.new(DIP_OUT * dip, -DIP_DEPTH * dip, 0) * studsPerScreen
		local along = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0):VectorToWorldSpace(-SHOULDER_DIRECTION) -- shoulder -> hand
		local handPoint = shoulder + along * (ARM_LENGTH * (1 + push))
		local armCenter = shoulder + along * (ARM_LENGTH * (0.5 + push))
		if side < 0 then
			along = mirror(along)
			handPoint = mirror(handPoint)
			armCenter = mirror(armCenter)
			shoulder = mirror(shoulder)
		end

		-- The arm block: +Y toward the shoulder, its front facing up (like arms raised in front of you).
		local yAxis = -along
		local front = UP - yAxis * UP:Dot(yAxis)
		front = if front.Magnitude > 1e-3 then front.Unit else -Vector3.zAxis
		local zAxis = -front
		local armLocal = CFrame.fromMatrix(armCenter, yAxis:Cross(zAxis), yAxis, zAxis)

		local ballRadius = hand.ball.radius() * megaScale
		local ballPoint = handPoint + along * (BALL_FORWARD * ballRadius) + front * (BALL_UP * ballRadius)

		-- The tutorial's pointer ring: never cover the thing it points at.
		local visible = true
		if avoid then
			local ballSpot = screenPoint(ballPoint, viewport, tanY)
			local handSpot = screenPoint(handPoint, viewport, tanY)
			local shoulderSpot = screenPoint(shoulder, viewport, tanY)
			local pixelsPerStud = viewport.Y / studsPerScreen
			local clear = avoidRadius + BUTTON_MARGIN
			if ballSpot and (avoid - ballSpot).Magnitude < ballRadius * pixelsPerStud + clear then
				visible = false
			elseif handSpot and shoulderSpot then
				-- The arm gets wider toward the bottom of the screen (it's closer).
				local armRadius = ARM_SCALE * 0.75 * pixelsPerStud
				if distanceToSegment(avoid, handSpot, shoulderSpot) < armRadius + clear then
					visible = false
				end
			end
		end
		hand.visible = visible

		-- Draw.
		setArmVisible(hand, visible)
		armCFrames[i] = cameraCFrame * armLocal
		local ballWorld = cameraCFrame * ballPoint
		hand.ballPosition = if visible then ballWorld else nil
		local scale = if visible then ballScale(hand, now) * megaScale else 0
		hand.ball.draw(CFrame.new(ballWorld) * spin, scale, now)
	end

	if right.arm and left.arm and (right.visible or left.visible) then
		workspace:BulkMoveTo(armParts, armCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Starts the throw on one hand. Returns where its ball is (nil = not showing).
local function throwFrom(hand, now)
	local position = if hand.visible then hand.ballPosition else nil
	-- Arm whoosh: right hand slightly higher pitch than the left, plus a little
	-- random wobble, so fast alternating throws don't sound robotic.
	Sounds.play("Swing", (if hand.side > 0 then 1.06 else 0.94) + (math.random() - 0.5) * 0.1)
	hand.thrownAt = now
	hand.loaded = false
	hand.dropAt = -math.huge -- gone at once (it's the ball that was just thrown)
	return position
end

function Viewmodel.launch(both)
	local now = os.clock()
	local first = nextHand
	local second = otherHand(first)
	nextHand = second -- right, left, right, left...
	local firstSpot = throwFrom(first, now)
	local secondSpot = nil
	local bothThrew = false
	-- Multiball: the other hand throws too, if it has a ball.
	if both and second.visible and second.wanted then
		secondSpot = throwFrom(second, now)
		bothThrew = true
	end
	return firstSpot, secondSpot, first.side, bothThrew
end

return Viewmodel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
