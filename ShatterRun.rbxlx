  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point: player data, run results (gems, XP, missions) and the
	global leaderboard.
	The runs themselves happen on each player's device (see Client/RunController).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Monetization = require(script.Parent.Monetization)
local Progression = require(script.Parent.Progression)
local Shop = require(script.Parent.Shop)

local Remotes = ReplicatedStorage.Remotes
local leaderboardStore = DataStoreService:GetOrderedDataStore("BestDistance_v1")

local LEADERBOARD_SIZE = 10
local LEADERBOARD_REFRESH = 60
local MISSION_CHECK_INTERVAL = 30

-- Anti-cheat ------------------------------------------------------------------
-- Highest distance one run can put on the global leaderboard (a sanity cap far
-- above any realistic run).
local MAX_RUN_METERS = 25000
-- A run only counts toward Stats.runs and the "play N runs" mission after this far.
local MIN_COUNTED_RUN_METERS = 50
-- RunEnded reports closer together than this are ignored (spam).
local MIN_RUN_ENDED_GAP = 0.5
-- The fastest a room can be flown through: at top speed, plus 15% for lag.
local MIN_ROOM_SECONDS = Config.ROOM_LENGTH / (Config.MAX_SPEED * 1.15)
-- How far ahead of that pace a player may be, in rooms, so one late network
-- message doesn't block the rest of the run. Waiting can't bank more than this.
local ROOM_LAG_ALLOWANCE = 2

-- Season info for the UI.
ReplicatedStorage:SetAttribute("SeasonName", Config.SEASON_NAME)
ReplicatedStorage:SetAttribute("SeasonEnds", Config.SEASON_ENDS)

-- player -> {
--   startedAt, pausedAt (set while on the game over screen), pausedTotal,
--   startCheckpoint, startMeters, metersRewarded,
--   reported (run stats already paid for), counted (run added to Stats.runs),
--   boosts ({ [boostId] = true } used on this run), doubleGems,
--   lastRoom (last room index accepted from RoomReached), roomClock (active
--   seconds the next room is measured from), pausedMaxStuds (cached time cap
--   while paused), lastEndedAt (os.clock() of the last RunEnded we handled)
-- }
local activeRuns = {}

-- player -> os.clock() when they joined this server (for the "wait! free gift",
-- which needs some real play time first).
local sessionStarts = {}

-- player -> how many RunStarted events they've sent this session. Sent back with
-- BoostsActivated so the client can ignore a confirmation meant for an older run.
local runCounts = {}

-- The furthest anyone can legitimately travel in `seconds`, following the same
-- speed ramp as the client (speeds up every room, capped at MAX_SPEED).
-- The ramp (about 40 rooms) is worked out once here; after it the speed never
-- changes, so longer times are a simple multiplication.
local rampRoomTimes = {} -- seconds to fly through each ramp room
local rampTime, rampStuds = 0, 0
do
	local gain = Config.SPEED_GAIN_PER_ROOM
	local rampRooms = 0
	if gain > 0 and Config.START_SPEED < Config.MAX_SPEED then
		rampRooms = math.ceil((Config.MAX_SPEED - Config.START_SPEED) / gain)
	end
	for room = 0, rampRooms - 1 do
		local speed = math.min(Config.MAX_SPEED, Config.START_SPEED + room * gain)
		local seconds = Config.ROOM_LENGTH / speed
		table.insert(rampRoomTimes, seconds)
		rampTime += seconds
	end
	rampStuds = rampRooms * Config.ROOM_LENGTH
end

local function maxStudsIn(seconds)
	if seconds <= 0 then
		return 0
	end
	if seconds >= rampTime then
		return rampStuds + (seconds - rampTime) * Config.MAX_SPEED
	end
	-- Still speeding up: walk the (at most ~40) ramp rooms.
	local studs, time = 0, 0
	for _, roomSeconds in rampRoomTimes do
		if time + roomSeconds >= seconds then
			local speed = Config.ROOM_LENGTH / roomSeconds
			return studs + (seconds - time) * speed
		end
		studs += Config.ROOM_LENGTH
		time += roomSeconds
	end
	return studs
end

local function activeSeconds(run)
	local now = run.pausedAt or os.clock()
	return now - run.startedAt - run.pausedTotal
end

-- Time cap for the run so far. While paused (game over screen) the run's
-- active time can't change, so it's only worked out once.
local function maxStudsForRun(run)
	if run.pausedAt then
		if not run.pausedMaxStuds then
			run.pausedMaxStuds = maxStudsIn(activeSeconds(run))
		end
		return run.pausedMaxStuds
	end
	return maxStudsIn(activeSeconds(run))
end

local function pauseRun(run)
	if not run.pausedAt then
		run.pausedAt = os.clock()
		run.pausedMaxStuds = nil
	end
end

local function resumeRun(run)
	if run.pausedAt then
		run.pausedTotal += os.clock() - run.pausedAt
		run.pausedAt = nil
		run.pausedMaxStuds = nil
	end
end

local function createLeaderstats(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local best = Instance.new("IntValue")
	best.Name = "Best"
	best.Parent = leaderstats

	local gems = Instance.new("IntValue")
	gems.Name = "Gems"
	gems.Parent = leaderstats

	leaderstats.Parent = player
end

local function onPlayerAdded(player)
	sessionStarts[player] = sessionStarts[player] or os.clock()
	createLeaderstats(player)
	PlayerData.load(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	activeRuns[player] = nil
	runCounts[player] = nil
	sessionStarts[player] = nil
	Shop.release(player)
	PlayerData.release(player)
end)

game:BindToClose(function()
	-- Roblox gives us up to 30 seconds to finish saving.
	PlayerData.releaseAll(25)
end)

Monetization.init()
Shop.init()
PlayerData.startAutosave()

-- Shop action "UseBoostNow"(boostId): the device asks this right after buying a
-- boost with Robux mid-run (the purchase always goes to the inventory first).
-- Takes one from the inventory and turns it on for the current run.
-- Returns true only if it's on; otherwise it stays in the inventory.
Shop.addAction("UseBoostNow", function(player, data, boostId)
	if not Progression.isBoost(boostId) then
		return false, "That boost doesn't exist"
	end
	local run = activeRuns[player]
	if not run or run.pausedAt then
		return false, "No run going"
	end
	if boostId == "DoubleGems" and run.doubleGems then
		return false, "2x gems is already on" -- can't stack
	end
	if not Progression.takeBoost(data, boostId) then
		return false, "You don't have that boost"
	end
	run.boosts[boostId] = true
	if boostId == "DoubleGems" then
		run.doubleGems = true
	end
	PlayerData.publish(player, { "Boosts" })
	return true
end)

-- Shop action "ResumeRun": the device sends this after it has really revived
-- (Revive or ball pack on the game over screen), so the run's clock runs again.
Shop.addAction("ResumeRun", function(player)
	local run = activeRuns[player]
	if not run then
		return false, "No run going"
	end
	resumeRun(run)
	return true
end)

-- Shop action "ClaimLeaveGift": the "wait! free gift" popup's CLAIM button.
-- Progression.claimLeaveGift checks the cooldown and the play time; the client's
-- own check only decides whether to show the popup.
Shop.addAction("ClaimLeaveGift", function(player, data)
	local started = sessionStarts[player]
	local playedSeconds = if started then os.clock() - started else 0
	local ok, message = Progression.claimLeaveGift(data, os.time(), playedSeconds)
	if ok then
		-- Saved by the autosave (publish marks the data as changed).
		PlayerData.publish(player, Progression.LEAVE_GIFT_FIELDS)
		Progression.fire(player, { type = "Reward", text = message, source = "LeaveGift" })
	end
	return ok, message
end)

-- Picks the boosts the player asked for (boostIds, a list of ids) that are real,
-- not repeated and actually owned, up to Config.MAX_BOOSTS_PER_RUN.
local function chooseBoosts(data, boostIds)
	local chosen = {}
	if type(boostIds) ~= "table" then
		return chosen
	end
	for i = 1, Config.MAX_BOOSTS_PER_RUN do
		local boostId = boostIds[i]
		if
			Progression.isBoost(boostId)
			and not table.find(chosen, boostId)
			and Progression.boostCount(data, boostId) >= 1
		then
			table.insert(chosen, boostId)
		end
	end
	return chosen
end

-- RunStarted(startCheckpoint, boostIds?)
-- startCheckpoint lets Checkpoints pass owners skip ahead to a zone they've reached.
-- boostIds: boosts picked from the inventory for this run (older clients send none).
Remotes.RunStarted.OnServerEvent:Connect(function(player, startCheckpoint, boostIds)
	runCounts[player] = (runCounts[player] or 0) + 1
	local data = PlayerData.get(player)
	if not data then
		return
	end

	local checkpoint = 0
	if
		type(startCheckpoint) == "number"
		and startCheckpoint == math.floor(startCheckpoint)
		and startCheckpoint > 0
		and startCheckpoint <= data.Checkpoint
		and Monetization.ownsPass(player, "Checkpoints")
	then
		checkpoint = startCheckpoint
	end

	local startMeters = math.floor(Config.checkpointMeters(checkpoint))
	local run = {
		startedAt = os.clock(),
		pausedAt = nil,
		pausedTotal = 0,
		startCheckpoint = checkpoint,
		startMeters = startMeters,
		metersRewarded = startMeters, -- no gems for the part you skipped
		reported = { glass = 0, crystals = 0, props = 0, maxMultiball = 0 },
		counted = false,
		boosts = {},
		doubleGems = false,
		lastRoom = checkpoint * Config.ROOMS_PER_CHECKPOINT, -- the room the run starts in
		roomClock = 0,
		pausedMaxStuds = nil,
		lastEndedAt = nil,
	}
	activeRuns[player] = run

	-- Bonus balls (from the daily streak) go into this run. The client already
	-- read the attribute when it started the run.
	if data.BonusBalls > 0 then
		PlayerData.update(player, { BonusBalls = 0 })
	end

	-- Boosts: use up one of each, then tell the client which ones really started
	-- (it only turns on what we confirm here).
	local used = {}
	for _, boostId in chooseBoosts(data, boostIds) do
		if Progression.takeBoost(data, boostId) then
			table.insert(used, boostId)
			run.boosts[boostId] = true
			if boostId == "DoubleGems" then
				run.doubleGems = true
			end
		end
	end
	if #used > 0 then
		PlayerData.publish(player, { "Boosts" })
		Progression.fire(player, { type = "BoostsActivated", boosts = used, run = runCounts[player] })
		-- Saved by the autosave (publish marked the data as changed).
	end
end)

-- RoomReached(roomIndex): sent each time the player's camera enters a new room.
-- Rooms must come in order, and no faster than top speed allows (counting only
-- time actually running). RunEnded then pays at most up to the last accepted room.
Remotes.RoomReached.OnServerEvent:Connect(function(player, roomIndex)
	local run = activeRuns[player]
	if not run or type(roomIndex) ~= "number" or roomIndex ~= math.floor(roomIndex) then
		return -- not a whole number (NaN fails this too)
	end
	if roomIndex ~= run.lastRoom + 1 then
		return
	end
	local now = activeSeconds(run)
	local earliest = run.roomClock + MIN_ROOM_SECONDS
	if now < earliest then
		return -- too fast: ignore it (no kick; lag can cause the odd one)
	end
	run.lastRoom = roomIndex
	-- Measure the next room from here, but let a player who is slower than top
	-- speed be up to ROOM_LAG_ALLOWANCE rooms "ahead", so a late message
	-- followed by an on-time one still gets through.
	run.roomClock = math.max(earliest, now - ROOM_LAG_ALLOWANCE * MIN_ROOM_SECONDS)
end)

-- Reads one number from the client's run stats, clamped to what's possible.
local function readStat(runStats, name, maximum)
	local value = runStats[name]
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, math.max(0, math.floor(maximum)))
end

local function gemMultiplier(player)
	local multiplier = 1
	if Monetization.ownsPass(player, "VIP") then
		multiplier = Config.GamePasses.VIP.GemMultiplier
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		multiplier *= 1 + Config.PREMIUM_GEM_BONUS
	end
	return multiplier
end

local function updateLeaderboard(player, meters)
	local ok, err = pcall(leaderboardStore.UpdateAsync, leaderboardStore, tostring(player.UserId), function(old)
		if old and old >= meters then
			return nil -- keep the higher score already stored
		end
		return meters
	end)
	if not ok then
		warn("Could not update leaderboard:", err)
	end
end

-- Sent at every game over: RunEnded(meters, runStats).
-- runStats = { glass, crystals, props, maxMultiball }, counted from the start of
-- the run. A revive continues the same run and reports again with bigger
-- numbers, so we only pay out what was added since the last report.
Remotes.RunEnded.OnServerEvent:Connect(function(player, meters, runStats)
	local run = activeRuns[player]
	local data = PlayerData.get(player)
	if not run or not data or type(meters) ~= "number" or meters ~= meters then
		return
	end
	local now = os.clock()
	if run.lastEndedAt and now - run.lastEndedAt < MIN_RUN_ENDED_GAP then
		return -- spam
	end
	run.lastEndedAt = now
	if type(runStats) ~= "table" then
		runStats = {}
	end

	-- Anti-cheat: the distance is the smallest of
	--  * what the device says,
	--  * how far the speed ramp allows in the time they actually spent running
	--    (time on the game over screen doesn't count),
	--  * the end of the last room the server accepted from RoomReached.
	pauseRun(run)
	local timeCap = run.startMeters + maxStudsForRun(run) / Config.STUDS_PER_METER * 1.1 + 15
	local roomCap = (run.lastRoom + 1) * Config.ROOM_LENGTH / Config.STUDS_PER_METER
	meters = math.clamp(math.floor(meters), 0, math.floor(math.min(timeCap, roomCap)))

	local newMeters = math.max(0, meters - run.metersRewarded)
	run.metersRewarded = math.max(run.metersRewarded, meters)

	-- Run stats, capped by how many rooms they really flew through
	-- (+2 because balls reach rooms ahead of the camera).
	local flownMeters = math.max(0, meters - run.startMeters)
	local rooms = flownMeters * Config.STUDS_PER_METER // Config.ROOM_LENGTH + 2
	local crystals = readStat(runStats, "crystals", rooms * 2 + 5)
	local minimumMultiball = if Monetization.ownsPass(player, "Multiball") then 2 else 1
	local maxMultiballPossible = math.min(
		Config.MAX_MULTIBALL,
		minimumMultiball + crystals // Config.CRYSTALS_PER_MULTIBALL_LEVEL
	)
	local stats = {
		glass = readStat(runStats, "glass", rooms * 12 + 20),
		crystals = crystals,
		props = readStat(runStats, "props", rooms * 10 + 10),
		maxMultiball = readStat(runStats, "maxMultiball", maxMultiballPossible),
	}

	local deltas = {}
	for name, value in stats do
		deltas[name] = math.max(0, value - run.reported[name])
		run.reported[name] = math.max(run.reported[name], value)
	end
	-- Only a real attempt counts as a run (not tapping PLAY then MENU).
	deltas.runs = 0
	if not run.counted and flownMeters >= MIN_COUNTED_RUN_METERS then
		deltas.runs = 1
		run.counted = true
	end

	-- Gems and XP for what was added since the last report.
	local multiplier = gemMultiplier(player)
	if run.doubleGems then
		multiplier *= 2 -- DoubleGems boost
	end
	local gemsEarned = math.floor(newMeters * Config.GEMS_PER_METER * multiplier)
	local xp = Config.XP
	local xpEarned = math.floor(
		newMeters * xp.PerMeter
			+ deltas.glass * xp.PerGlass
			+ deltas.crystals * xp.PerCrystal
			+ deltas.props * xp.PerProp
	)

	-- Zone counts for missions only if they actually flew into it.
	local reachedZone = math.floor(meters / Config.checkpointMeters(1))
	local best = {
		bestZone = if reachedZone > run.startCheckpoint then reachedZone else 0,
		bestRunMeters = flownMeters,
		bestMultiball = run.reported.maxMultiball,
	}

	local missionsReset = Progression.refreshMissions(data, os.time())
	local completed = Progression.trackRun(data, deltas, best)

	local levelBefore = data.Level
	data.Gems += gemsEarned
	local events = Progression.addXP(data, xpEarned)

	local changed = { "Stats", "Missions" }
	if missionsReset then
		changed = { "Stats", "Missions", "MissionRerolls", "MissionsReset" }
	end
	PlayerData.publish(player, changed)
	PlayerData.publish(player, Progression.XP_FIELDS)

	local changes = {}
	if reachedZone > data.Checkpoint then
		changes.Checkpoint = reachedZone
	end

	-- Personal best + global leaderboard only count runs from the very start,
	-- so a Checkpoints pass can't buy a higher score.
	-- One run can never put more than MAX_RUN_METERS on the board.
	if run.startCheckpoint == 0 and meters > data.Best then
		changes.Best = meters
		-- Skip if their data didn't load: their real best is unknown.
		if PlayerData.canSave(player) then
			task.spawn(updateLeaderboard, player, math.min(meters, MAX_RUN_METERS))
		end
	end
	PlayerData.update(player, changes)

	for _, text in completed do
		Progression.fire(player, { type = "MissionComplete", text = text })
	end
	for _, event in events do
		Progression.fire(player, event)
	end
	Progression.fire(player, {
		type = "RunSummary",
		xp = xpEarned,
		gems = gemsEarned,
		levelBefore = levelBefore,
		levelAfter = data.Level,
		missionsCompleted = #completed,
	})
end)

-- New daily missions at midnight UTC, even for players who stay in the game.
task.spawn(function()
	while true do
		task.wait(MISSION_CHECK_INTERVAL)
		local now = os.time()
		PlayerData.forEach(function(player, data)
			if Progression.refreshMissions(data, now) then
				PlayerData.publish(player, Progression.MISSION_FIELDS)
			end
		end)
	end
end)

-- Global leaderboard ---------------------------------------------------------

local nameCache = {}

local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok then
		nameCache[userId] = name
		return name
	end
	return "???"
end

local function refreshLeaderboard()
	local ok, pages = pcall(leaderboardStore.GetSortedAsync, leaderboardStore, false, LEADERBOARD_SIZE)
	if not ok then
		warn("Could not load leaderboard:", pages)
		return
	end

	local top = {}
	for rank, entry in pages:GetCurrentPage() do
		table.insert(top, {
			rank = rank,
			name = getName(tonumber(entry.key)),
			meters = entry.value,
		})
	end
	ReplicatedStorage:SetAttribute("TopRuns", HttpService:JSONEncode(top))
end

task.spawn(function()
	while true do
		refreshLeaderboard()
		task.wait(LEADERBOARD_REFRESH)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">ModelLoader</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Loads the uploaded Blender models (Config.Models) into
	ReplicatedStorage.ModelLibrary so every player's device can clone them.
	Models must be owned by the same account/group that owns the game.
]]

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local library = Instance.new("Folder")
library.Name = "ModelLibrary"
library.Parent = ReplicatedStorage

for name, assetId in Config.Models do
	if assetId ~= 0 then
		task.spawn(function()
			local ok, container = pcall(InsertService.LoadAsset, InsertService, assetId)
			if not ok then
				warn("Could not load model", name, assetId, container)
				return
			end

			-- LoadAsset wraps the asset in a Model; unwrap a single inner Model.
			local model = container
			local children = container:GetChildren()
			if #children == 1 and children[1]:IsA("Model") then
				model = children[1]
				model.Parent = nil
				container:Destroy()
			end

			model.Name = name
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.Anchored = true
				end
			end
			model.Parent = library
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--[[
	Game passes and developer products.
	IDs come from Shared/Config. Anything with an ID of 0 is ignored.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Progression = require(script.Parent.Progression)

local Remotes = ReplicatedStorage.Remotes

local Monetization = {}

-- Gems given instead when a StreakSaver is bought while the streak is fine.
local STREAK_SAVER_FALLBACK_GEMS = 100

-- Products the server delivers itself. Everything else (balls) is delivered
-- to the player's device, because runs happen there.
-- These must not yield: they run inside ProcessReceipt.
local serverRewards = {
	-- One-time offer. If it's somehow bought twice, the gems are still given
	-- (the skin and effect are already owned), so a purchase is never wasted.
	StarterPack = function(player, data)
		local product = Config.Products.StarterPack
		local text = Progression.grantReward(data, { Gems = product.Gems, Skin = product.Skin, Fx = product.Fx })
		data.StarterPackBought = true
		PlayerData.publish(player, Progression.REWARD_FIELDS)
		PlayerData.publish(player, { "StarterPackBought" })
		Progression.fire(player, { type = "Reward", text = "Starter pack: " .. text })
	end,

	-- Unlocks the premium track of the current season (tiers already reached
	-- become claimable right away).
	SeasonPremium = function(player, data)
		Progression.ensureSeason(data)
		data.SeasonPremium = true
		PlayerData.publish(player, { "SeasonId", "SeasonTier", "SeasonXP", "SeasonClaimed", "SeasonPremium" })
		Progression.fire(player, { type = "Reward", text = "Premium season pass unlocked" })
	end,

	-- +1 mission reroll. Bought rerolls don't expire at midnight.
	ExtraReroll = function(player, data)
		if Progression.refreshMissions(data, os.time()) then
			PlayerData.publish(player, Progression.MISSION_FIELDS)
		end
		data.ExtraRerolls += 1
		data.MissionRerolls += 1
		PlayerData.publish(player, { "MissionRerolls", "ExtraRerolls" })
		Progression.fire(player, { type = "Reward", text = "+1 mission reroll" })
	end,

	-- Keeps a broken login streak going. If it wasn't broken (bought twice, or
	-- the client was out of date) they get gems instead: a purchase is never wasted.
	StreakSaver = function(player, data)
		local now = os.time()
		if Progression.saveStreak(data, now) then
			PlayerData.publish(player, Progression.DAILY_FIELDS)
			Progression.fire(player, { type = "Reward", text = "Streak saved: day " .. data.StreakDay .. " is waiting" })
		else
			data.Gems += STREAK_SAVER_FALLBACK_GEMS
			PlayerData.publish(player, { "Gems" })
			Progression.fire(player, {
				type = "Reward",
				text = "Your streak was safe: +" .. STREAK_SAVER_FALLBACK_GEMS .. " gems instead",
			})
		end
	end,
}

-- Boost products (BoostShield, BoostMagnet...): always go to the inventory.
-- If the player is mid-run, their device then asks to use it right away with
-- the "UseBoostNow" shop action (only the device knows for sure that it's running).
local function boostReward(boostId)
	return function(player, data)
		Progression.addBoost(data, boostId, 1)
		PlayerData.publish(player, { "Boosts" })
	end
end

-- Plain gem packs (GemPack, GemPackMedium, GemPackLarge...): any product with
-- Gems that has no special handler above.
local function rewardFor(productKey, product)
	if serverRewards[productKey] then
		return serverRewards[productKey]
	end
	if product.Boost and Progression.isBoost(product.Boost) then
		return boostReward(product.Boost)
	end
	if product.Gems then
		return function(player, data)
			data.Gems += product.Gems
			PlayerData.publish(player, { "Gems" })
		end
	end
	return nil
end

function Monetization.ownsPass(player, passKey)
	return player:GetAttribute("Pass_" .. passKey) == true
end

local function checkPasses(player)
	for passKey, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns then
				player:SetAttribute("Pass_" .. passKey, true)
			end
		end
	end
end

-- Roblox calls this for every developer product purchase, and keeps retrying
-- until we return PurchaseGranted. Each PurchaseId is only ever paid out once.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not PlayerData.get(player) then
		-- Not here (or still loading). Roblox will retry later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not PlayerData.canSave(player) then
		-- Their data failed to load, so we couldn't keep a record of this. Try again later.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Already paid out earlier in this session (an earlier save failed): just retry the save.
	if PlayerData.hasReceipt(player, receipt.PurchaseId) then
		return if PlayerData.save(player)
			then Enum.ProductPurchaseDecision.PurchaseGranted
			else Enum.ProductPurchaseDecision.NotProcessedYet
	end

	for productKey, product in Config.Products do
		if product.Id ~= 0 and product.Id == receipt.ProductId then
			local reward = rewardFor(productKey, product)
			if reward then
				reward(player, PlayerData.get(player))
			end
			PlayerData.addReceipt(player, receipt.PurchaseId)

			-- Deliver right away so the player isn't left waiting on a slow DataStore.
			-- (A revive no longer restarts the run's clock here: the device sends
			-- the "ResumeRun" shop action once it has really revived.)
			Remotes.PurchaseGranted:FireClient(player, productKey)

			-- Only tell Roblox we're done once the receipt is safely saved (purchases are
			-- the one thing saved right away instead of by the autosave).
			-- If the save fails, Roblox retries and hasReceipt() above stops a double payout.
			return if PlayerData.save(player)
				then Enum.ProductPurchaseDecision.PurchaseGranted
				else Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end

	warn("Unknown product purchased:", receipt.ProductId)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function Monetization.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for passKey, pass in Config.GamePasses do
			if pass.Id == passId then
				player:SetAttribute("Pass_" .. passKey, true)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		task.spawn(checkPasses, player)
	end
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	Loads and saves each player's progress (best distance, gems, skins, level,
	missions, season pass...).
	Note: DataStores only work in Studio if "Enable Studio Access to
	API Services" is turned on in Game Settings > Security.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Progression = require(script.Parent.Progression)

local PlayerData = {}

local store = DataStoreService:GetDataStore("PlayerData_v1")

local LOAD_ATTEMPTS = 3
-- Changed profiles are saved about once a minute (spread out over the minute),
-- instead of after every action: DataStores only allow so many writes.
local AUTOSAVE_INTERVAL = 60
local MAX_RECEIPTS = 50 -- remembered purchase IDs, so a retried receipt is never paid twice

-- Every new field needs a default here. Old saves get missing fields filled in.
local DEFAULT_DATA = {
	Best = 0, -- meters (only runs started from the beginning count)
	Gems = 0,
	Checkpoint = 0, -- highest zone reached
	OwnedSkins = { "Default" },
	EquippedSkin = "Default",
	OwnedFx = { "Classic" },
	EquippedFx = "Classic",
	Receipts = {}, -- recent developer product PurchaseIds

	-- Player level
	Level = 1,
	XP = 0, -- progress inside the current level
	Stats = {
		glass = 0,
		crystals = 0,
		props = 0,
		runs = 0,
		bestZone = 0,
		bestRunMeters = 0,
		bestMultiball = 0,
	},

	-- Daily missions: { { id, progress, claimed } }
	Missions = {},
	MissionRerolls = Config.MISSION_REROLLS_PER_DAY, -- left today (includes ExtraRerolls)
	ExtraRerolls = 0, -- bought with the ExtraReroll product; they don't expire at midnight
	MissionsReset = 0, -- os.time() of the next refresh

	-- Daily login streak
	StreakDay = 1, -- which Config.DailyStreak entry the next claim gives
	NextDaily = 0, -- os.time() when the daily reward can be claimed again
	StreakExpires = 0, -- claiming after this restarts at day 1

	-- Season pass
	SeasonId = Config.SEASON_ID,
	SeasonTier = 0,
	SeasonXP = 0,
	SeasonPremium = false,
	SeasonClaimed = { free = {}, premium = {} },

	StarterPackBought = false,
	BonusBalls = 0, -- added to the next run
	Boosts = {}, -- { [boostId] = count }: welcome gift, level ups, streak, season, shop
	WelcomeGiven = false, -- the one-time Config.WELCOME_BOOSTS gift was given
	TutorialDone = false, -- finished or skipped the first-run tutorial
	Hints = {}, -- first-time tips already shown (keys of Config.Hints)

	-- "Wait! Free gift" (Config.LeaveGift)
	LeaveGiftNext = 0, -- os.time() when the gift can be claimed again
	LeaveGiftIndex = 0, -- which Config.LeaveGift.Rewards entry is next (counts from 0, cycles)
}

-- player -> {
--   data = {...}, canSave = bool,
--   dirty = bool (changed since the last save started),
--   saving = bool (a save is running right now), released = bool
-- }
local profiles = {}
local pendingSaves = 0

local function key(player)
	return "player_" .. player.UserId
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function isDictionary(t)
	return next(t) ~= nil and #t == 0
end

-- Defaults + whatever was saved. A saved value of the wrong type is ignored,
-- and dictionaries (like Stats) get any missing keys filled in.
local function merge(defaults, saved)
	local data = deepCopy(defaults)
	if type(saved) ~= "table" then
		return data
	end
	for field, value in saved do
		local default = defaults[field]
		if default == nil then
			data[field] = deepCopy(value) -- unknown field: keep it as-is
		elseif type(value) == type(default) then
			if type(default) == "table" and isDictionary(default) then
				data[field] = merge(default, value)
			else
				data[field] = deepCopy(value)
			end
		end
	end
	return data
end

-- Publishing: attributes replicate to the client, which is how the UI reads progress.
-- Only the fields that changed are published, so JSON is only encoded when needed.

local function setJson(player, name, value)
	player:SetAttribute(name, HttpService:JSONEncode(value))
end

local publishers = {
	Best = function(player, data)
		player:SetAttribute("Best", data.Best)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			leaderstats.Best.Value = data.Best
		end
	end,
	Gems = function(player, data)
		player:SetAttribute("Gems", data.Gems)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			leaderstats.Gems.Value = data.Gems
		end
	end,
	Level = function(player, data)
		player:SetAttribute("Level", data.Level)
		player:SetAttribute("XPNeeded", Config.xpForLevel(data.Level))
	end,
	OwnedSkins = function(player, data)
		setJson(player, "OwnedSkins", data.OwnedSkins)
	end,
	OwnedFx = function(player, data)
		setJson(player, "OwnedFx", data.OwnedFx)
	end,
	Stats = function(player, data)
		setJson(player, "Stats", data.Stats)
	end,
	Boosts = function(player, data)
		setJson(player, "Boosts", data.Boosts)
	end,
	Hints = function(player, data)
		setJson(player, "Hints", data.Hints)
	end,
	SeasonClaimed = function(player, data)
		setJson(player, "SeasonClaimed", data.SeasonClaimed)
	end,
	Missions = function(player, data)
		setJson(player, "Missions", Progression.publicMissions(data))
	end,
	Receipts = function() end, -- private
}

-- Plain number/bool/string fields are copied straight to an attribute.
local function publishField(player, data, field)
	local publisher = publishers[field]
	if publisher then
		publisher(player, data)
	elseif DEFAULT_DATA[field] ~= nil and type(data[field]) ~= "table" then
		player:SetAttribute(field, data[field])
	end
end

local function publishAll(player, data)
	for field in DEFAULT_DATA do
		publishField(player, data, field)
	end
end

local function defaultData()
	return deepCopy(DEFAULT_DATA)
end

function PlayerData.load(player)
	local ok, saved
	for attempt = 1, LOAD_ATTEMPTS do
		ok, saved = pcall(store.GetAsync, store, key(player))
		if ok then
			break
		end
		warn("Could not load data for", player.Name, "attempt", attempt, saved)
		task.wait(attempt * 2)
	end
	if not player.Parent then
		return -- left while we were loading
	end

	local data = if ok then merge(DEFAULT_DATA, saved) else defaultData()
	Progression.normalize(data, os.time())
	-- Players from before the tutorial existed already know how to play.
	if type(saved) == "table" and saved.TutorialDone == nil and data.Stats.runs > 0 then
		data.TutorialDone = true
	end

	-- If loading failed we never save, so we can't wipe their real data.
	profiles[player] = { data = data, canSave = ok, dirty = false, saving = false }
	publishAll(player, data)
end

function PlayerData.get(player)
	local profile = profiles[player]
	return profile and profile.data
end

function PlayerData.canSave(player)
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

-- Marks the player's data as changed, so the next autosave writes it.
-- update/publish/addReceipt do this for you.
function PlayerData.markDirty(player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
	end
end

-- Sets fields and sends them to the client.
function PlayerData.update(player, changes)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.dirty = true
	for field, value in changes do
		profile.data[field] = value
	end
	for field in changes do
		publishField(player, profile.data, field)
	end
end

-- Sends fields to the client after changing the data table directly.
-- fields: a list of field names, e.g. { "Gems", "OwnedSkins" }.
function PlayerData.publish(player, fields)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.dirty = true
	for _, field in fields do
		publishField(player, profile.data, field)
	end
end

function PlayerData.hasReceipt(player, purchaseId)
	local data = PlayerData.get(player)
	return data ~= nil and table.find(data.Receipts, purchaseId) ~= nil
end

function PlayerData.addReceipt(player, purchaseId)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	PlayerData.markDirty(player)
end

-- Returns true only if the data (as it is right now) really reached the DataStore.
-- Only one save per player runs at a time: if one is already running we wait
-- for it, and only save again if something changed after it started.
function PlayerData.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return false
	end

	pendingSaves += 1
	while profile.saving do
		task.wait(0.1)
	end
	if profile.lastSaveOk and not profile.dirty then
		-- The save we waited for already included every change.
		pendingSaves -= 1
		return true
	end

	profile.saving = true
	profile.dirty = false -- changes from now on need another save
	local ok, err = pcall(store.SetAsync, store, key(player), profile.data, { player.UserId })
	profile.saving = false
	profile.lastSaveOk = ok
	pendingSaves -= 1

	if not ok then
		profile.dirty = true -- try again next time
		warn("Could not save data for", player.Name, err)
	end
	return ok
end

function PlayerData.release(player)
	local profile = profiles[player]
	if not profile or profile.released then
		return
	end
	profile.released = true
	profile.dirty = true -- always write once more when they leave
	PlayerData.save(player)
	profiles[player] = nil
end

-- Used when the server shuts down: saves everyone and waits until done.
function PlayerData.releaseAll(timeout)
	for player in profiles do
		task.spawn(PlayerData.release, player)
	end
	local deadline = os.clock() + timeout
	task.wait()
	while pendingSaves > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Saves changed profiles every AUTOSAVE_INTERVAL seconds, spread out over the
-- interval so all players don't hit the DataStore at the same moment.
-- Started once by Main.
local autosaveStarted = false
function PlayerData.startAutosave()
	if autosaveStarted then
		return
	end
	autosaveStarted = true
	task.spawn(function()
		while true do
			local due = {}
			for player, profile in profiles do
				if profile.dirty and profile.canSave and not profile.released and not profile.saving then
					table.insert(due, player)
				end
			end
			if #due == 0 then
				task.wait(AUTOSAVE_INTERVAL)
			else
				local gap = AUTOSAVE_INTERVAL / #due
				for _, player in due do
					local profile = profiles[player]
					if profile and profile.dirty and not profile.released then
						task.spawn(PlayerData.save, player)
					end
					task.wait(gap)
				end
			end
		end
	end)
end

-- Calls fn(player, data) for everyone whose data is loaded.
function PlayerData.forEach(fn)
	for player, profile in profiles do
		if not profile.released then
			fn(player, profile.data)
		end
	end
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--[[
	Progression rules: player levels, the season pass, daily missions and
	rewards. Works directly on a player's data table (from PlayerData) and
	returns what happened, so the caller can publish + save.

	Nothing in here talks to the DataStore. Progression.fire sends a
	Progress event to the player's screen (level up, mission done...).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Progression = {}

local SECONDS_PER_DAY = 24 * 60 * 60
local MAX_TIER = #Config.SeasonTiers
local TIER_XP = math.max(1, Config.SEASON_TIER_XP)
local MAX_LEVEL_UPS_AT_ONCE = 100 -- safety net against a broken xpForLevel

Progression.MAX_TIER = MAX_TIER

local rng = Random.new()

-- The Progress RemoteEvent (created here too in case the Rojo project lacks it).
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local progressRemote = Remotes:FindFirstChild("Progress")
if not progressRemote then
	progressRemote = Instance.new("RemoteEvent")
	progressRemote.Name = "Progress"
	progressRemote.Parent = Remotes
end

function Progression.fire(player, event)
	if player.Parent then
		progressRemote:FireClient(player, event)
	end
end

-- Lookups ----------------------------------------------------------------------

local function findById(list, id)
	for _, item in list do
		if item.Id == id then
			return item
		end
	end
	return nil
end

function Progression.findSkin(skinId)
	return findById(Config.Skins, skinId)
end

function Progression.findFx(fxId)
	return findById(Config.ShatterFx, fxId)
end

function Progression.missionDef(missionId)
	return findById(Config.MissionPool, missionId)
end

-- "Default" skin and "Classic" effect belong to everyone.
function Progression.ownsSkin(data, skinId)
	return skinId == "Default" or table.find(data.OwnedSkins, skinId) ~= nil
end

function Progression.ownsFx(data, fxId)
	return fxId == "Classic" or table.find(data.OwnedFx, fxId) ~= nil
end

-- Boosts -------------------------------------------------------------------------

-- Is this a real boost id from Config.Boosts?
function Progression.isBoost(boostId)
	return type(boostId) == "string" and Config.Boosts[boostId] ~= nil
end

-- Boost inventory: data.Boosts = { [boostId] = count }, picked before a run.
function Progression.boostCount(data, boostId)
	local count = data.Boosts[boostId]
	return if type(count) == "number" then count else 0
end

-- Adds `amount` of a boost to the inventory. Returns false for an unknown id.
function Progression.addBoost(data, boostId, amount)
	if not Progression.isBoost(boostId) then
		return false
	end
	data.Boosts[boostId] = Progression.boostCount(data, boostId) + (amount or 1)
	return true
end

-- Uses up one boost. Returns false (and changes nothing) if they have none.
function Progression.takeBoost(data, boostId)
	if not Progression.isBoost(boostId) then
		return false
	end
	local count = Progression.boostCount(data, boostId)
	if count < 1 then
		return false
	end
	data.Boosts[boostId] = if count > 1 then count - 1 else nil
	return true
end

-- The boost a level up gives: level 2 -> BOOST_ORDER[1], level 3 -> [2]...
function Progression.levelUpBoost(level)
	local order = Config.BOOST_ORDER
	if not Config.LEVEL_UP_BOOST or #order == 0 or level < 2 then
		return nil
	end
	return order[(level - 2) % #order + 1]
end

-- Rewards ------------------------------------------------------------------------

-- Gives a reward table { Gems?, Balls?, Skin?, Fx?, Boost? } (Config format).
-- Returns a short description like "+50 gems, Frost effect".
function Progression.grantReward(data, reward)
	local parts = {}
	if reward.Gems and reward.Gems > 0 then
		data.Gems += reward.Gems
		table.insert(parts, "+" .. reward.Gems .. " gems")
	end
	if reward.Balls and reward.Balls > 0 then
		data.BonusBalls += reward.Balls
		table.insert(parts, "+" .. reward.Balls .. " balls next run")
	end
	if reward.Boost and Progression.addBoost(data, reward.Boost, 1) then
		table.insert(parts, Config.Boosts[reward.Boost].Name .. " boost")
	end
	if reward.Skin then
		local skin = Progression.findSkin(reward.Skin)
		if skin and not Progression.ownsSkin(data, skin.Id) then
			table.insert(data.OwnedSkins, skin.Id)
			table.insert(parts, skin.Name .. " ball")
		end
	end
	if reward.Fx then
		local fx = Progression.findFx(reward.Fx)
		if fx and not Progression.ownsFx(data, fx.Id) then
			table.insert(data.OwnedFx, fx.Id)
			table.insert(parts, fx.Name .. " effect")
		end
	end
	return table.concat(parts, ", ")
end

-- Fields grantReward can touch (for publishing).
Progression.REWARD_FIELDS = { "Gems", "BonusBalls", "OwnedSkins", "OwnedFx", "Boosts" }

-- Levels + season pass ------------------------------------------------------------

-- Adds XP to both the player level and the season pass.
-- Returns a list of Progress events (LevelUp / SeasonTier) to send.
function Progression.addXP(data, amount)
	local events = {}
	amount = math.floor(amount)
	if amount <= 0 then
		return events
	end

	data.XP += amount
	for _ = 1, MAX_LEVEL_UPS_AT_ONCE do
		local needed = Config.xpForLevel(data.Level)
		if data.XP < needed then
			break
		end
		data.XP -= needed
		data.Level += 1
		data.Gems += Config.LEVEL_UP_GEMS

		local unlock = nil
		local unlockDef = Config.LevelUnlocks[data.Level]
		local boostId = Progression.levelUpBoost(data.Level)
		if unlockDef or boostId then
			unlock = {}
			if unlockDef and unlockDef.Skin and Progression.findSkin(unlockDef.Skin) then
				if not Progression.ownsSkin(data, unlockDef.Skin) then
					table.insert(data.OwnedSkins, unlockDef.Skin)
				end
				unlock.Skin = unlockDef.Skin
			end
			if unlockDef and unlockDef.Fx and Progression.findFx(unlockDef.Fx) then
				if not Progression.ownsFx(data, unlockDef.Fx) then
					table.insert(data.OwnedFx, unlockDef.Fx)
				end
				unlock.Fx = unlockDef.Fx
			end
			-- Every level up also gives one boost (shown with the unlocks).
			if boostId and Progression.addBoost(data, boostId, 1) then
				unlock.Boost = boostId
			end
			if next(unlock) == nil then
				unlock = nil
			end
		end
		table.insert(events, { type = "LevelUp", level = data.Level, gems = Config.LEVEL_UP_GEMS, unlock = unlock })
	end

	if data.SeasonTier < MAX_TIER then
		data.SeasonXP += amount
		while data.SeasonTier < MAX_TIER and data.SeasonXP >= TIER_XP do
			data.SeasonXP -= TIER_XP
			data.SeasonTier += 1
			table.insert(events, { type = "SeasonTier", tier = data.SeasonTier })
		end
	end
	if data.SeasonTier >= MAX_TIER then
		data.SeasonXP = 0
	end

	return events
end

-- Fields addXP can touch (for publishing).
Progression.XP_FIELDS = { "Level", "XP", "Gems", "OwnedSkins", "OwnedFx", "Boosts", "SeasonTier", "SeasonXP" }

-- A new season (Config.SEASON_ID bumped) starts everyone from tier 0.
function Progression.ensureSeason(data)
	if data.SeasonId == Config.SEASON_ID then
		return false
	end
	data.SeasonId = Config.SEASON_ID
	data.SeasonTier = 0
	data.SeasonXP = 0
	data.SeasonPremium = false
	data.SeasonClaimed = { free = {}, premium = {} }
	return true
end

-- Daily missions ----------------------------------------------------------------

-- Next midnight (UTC) after `now`.
function Progression.nextReset(now)
	return (now // SECONDS_PER_DAY + 1) * SECONDS_PER_DAY
end

-- Picks a mission that isn't already on the list, preferring a different stat
-- so the three missions of a day feel different.
local function pickMission(current)
	local usedIds, usedStats = {}, {}
	for _, mission in current do
		usedIds[mission.id] = true
		local def = Progression.missionDef(mission.id)
		if def then
			usedStats[def.Stat] = true
		end
	end

	local fresh, fallback = {}, {}
	for _, def in Config.MissionPool do
		if not usedIds[def.Id] then
			table.insert(fallback, def)
			if not usedStats[def.Stat] then
				table.insert(fresh, def)
			end
		end
	end
	local pool = if #fresh > 0 then fresh else fallback
	if #pool == 0 then
		return nil
	end
	return pool[rng:NextInteger(1, #pool)]
end

local function newMission(def)
	return { id = def.Id, progress = 0, claimed = false }
end

local function missionsValid(missions)
	if type(missions) ~= "table" or #missions == 0 then
		return false
	end
	for _, mission in missions do
		if
			type(mission) ~= "table"
			or type(mission.progress) ~= "number"
			or not Progression.missionDef(mission.id)
		then
			return false
		end
	end
	return true
end

-- New missions every day at midnight UTC. Returns true if they changed.
function Progression.refreshMissions(data, now)
	if now < data.MissionsReset and missionsValid(data.Missions) then
		return false
	end
	local missions = {}
	for _ = 1, Config.MISSIONS_PER_DAY do
		local def = pickMission(missions)
		if not def then
			break
		end
		table.insert(missions, newMission(def))
	end
	data.Missions = missions
	-- Bought rerolls (ExtraRerolls) carry over to the next day.
	data.MissionRerolls = Config.MISSION_REROLLS_PER_DAY + data.ExtraRerolls
	data.MissionsReset = Progression.nextReset(now)
	return true
end

Progression.MISSION_FIELDS = { "Missions", "MissionRerolls", "MissionsReset", "ExtraRerolls" }

-- What the client sees (the Missions attribute).
function Progression.publicMissions(data)
	local list = {}
	for _, mission in data.Missions do
		local def = Progression.missionDef(mission.id)
		if def then
			table.insert(list, {
				id = def.Id,
				text = string.format(def.Text, def.Goal),
				stat = def.Stat,
				goal = def.Goal,
				progress = math.min(mission.progress, def.Goal),
				gems = def.Gems,
				xp = def.XP,
				claimed = mission.claimed == true,
			})
		end
	end
	return list
end

local function findMission(data, missionId)
	for index, mission in data.Missions do
		if mission.id == missionId then
			return mission, index
		end
	end
	return nil
end

function Progression.rerollMission(data, missionId)
	local mission, index = findMission(data, missionId)
	local def = mission and Progression.missionDef(mission.id)
	if not mission or not def then
		return false, "Mission not found"
	end
	if data.MissionRerolls <= 0 then
		return false, "No rerolls left today"
	end
	if mission.claimed or mission.progress >= def.Goal then
		return false, "That mission is already done"
	end

	local others = table.clone(data.Missions)
	local replacement = pickMission(others) -- avoids the current one too
	if not replacement then
		return false, "No other missions available"
	end
	data.Missions[index] = newMission(replacement)
	data.MissionRerolls -= 1
	-- The free daily reroll is used first; bought ones only go once it's gone.
	data.ExtraRerolls = math.min(data.ExtraRerolls, data.MissionRerolls)
	return true, "New mission: " .. string.format(replacement.Text, replacement.Goal)
end

-- Returns ok, message, rewardText, events.
function Progression.claimMission(data, missionId)
	local mission = findMission(data, missionId)
	local def = mission and Progression.missionDef(mission.id)
	if not mission or not def then
		return false, "Mission not found"
	end
	if mission.claimed then
		return false, "Already claimed"
	end
	if mission.progress < def.Goal then
		return false, "Not finished yet"
	end

	mission.claimed = true
	data.Gems += def.Gems
	local events = Progression.addXP(data, def.XP)
	local text = "+" .. def.Gems .. " gems, +" .. def.XP .. " XP"
	return true, text, events
end

-- Run results -------------------------------------------------------------------

local CUMULATIVE = { "glass", "crystals", "props", "runs" }
local BEST = { "bestZone", "bestRunMeters", "bestMultiball" }

-- Adds one run report to lifetime stats and mission progress.
-- deltas: { glass, crystals, props, runs } added since the last report.
-- best: { bestZone, bestRunMeters, bestMultiball } values reached this run.
-- Returns the texts of missions that just got completed.
function Progression.trackRun(data, deltas, best)
	local stats = data.Stats
	for _, stat in CUMULATIVE do
		stats[stat] += deltas[stat] or 0
	end
	for _, stat in BEST do
		stats[stat] = math.max(stats[stat], best[stat] or 0)
	end

	local completed = {}
	for _, mission in data.Missions do
		local def = Progression.missionDef(mission.id)
		if def and not mission.claimed then
			local before = mission.progress
			if def.Max then
				mission.progress = math.max(mission.progress, best[def.Stat] or 0)
			else
				mission.progress += deltas[def.Stat] or 0
			end
			if before < def.Goal and mission.progress >= def.Goal then
				table.insert(completed, string.format(def.Text, def.Goal))
			end
		end
	end
	return completed
end

-- Daily streak ------------------------------------------------------------------

-- Returns ok, message.
function Progression.claimDaily(data, now)
	if now < data.NextDaily then
		return false, "Come back later"
	end

	local day = data.StreakDay
	if now > data.StreakExpires then
		day = 1 -- missed a day: the streak starts over
	end
	day = math.clamp(day, 1, #Config.DailyStreak)

	local text = Progression.grantReward(data, Config.DailyStreak[day])
	data.StreakDay = day % #Config.DailyStreak + 1
	data.NextDaily = now + Config.DAILY_REWARD_COOLDOWN
	data.StreakExpires = now + Config.DAILY_STREAK_RESET
	return true, "Day " .. day .. ": " .. text
end

-- A streak is "broken" when the 48h window ran out partway through it
-- (claiming now would restart at day 1).
function Progression.streakBroken(data, now)
	return now > data.StreakExpires and data.StreakDay > 1
end

-- StreakSaver product: reopens the claim window so the streak continues.
-- Returns false if there was nothing to save (the caller gives something else).
function Progression.saveStreak(data, now)
	if not Progression.streakBroken(data, now) then
		return false
	end
	data.StreakExpires = now + Config.DAILY_STREAK_RESET
	return true
end

Progression.DAILY_FIELDS = { "Gems", "BonusBalls", "OwnedSkins", "OwnedFx", "Boosts", "StreakDay", "NextDaily", "StreakExpires" }

-- "Wait! Free gift" ------------------------------------------------------------
-- Shown when a player comes back from the Roblox menu (see client LeaveGift).
-- One claim per Config.LeaveGift.Cooldown, only after MinPlaySeconds of play
-- this session. The rewards take turns (Config.LeaveGift.Rewards).

-- The reward the next claim gives (or nil if none are set up).
function Progression.nextLeaveGift(data)
	local rewards = Config.LeaveGift and Config.LeaveGift.Rewards
	if type(rewards) ~= "table" or #rewards == 0 then
		return nil
	end
	return rewards[data.LeaveGiftIndex % #rewards + 1]
end

-- playedSeconds: how long the player has been in this server. Returns ok, message.
function Progression.claimLeaveGift(data, now, playedSeconds)
	local settings = Config.LeaveGift
	local reward = Progression.nextLeaveGift(data)
	if not settings or not reward then
		return false, "No gift right now"
	end
	if now < data.LeaveGiftNext then
		return false, "Come back later"
	end
	if playedSeconds < settings.MinPlaySeconds then
		return false, "Play a little longer first"
	end

	local text = Progression.grantReward(data, reward)
	if text == "" then
		text = "Gift claimed"
	end
	data.LeaveGiftIndex = (data.LeaveGiftIndex + 1) % #settings.Rewards
	data.LeaveGiftNext = now + settings.Cooldown
	return true, "Free gift: " .. text
end

Progression.LEAVE_GIFT_FIELDS = { "Gems", "BonusBalls", "OwnedSkins", "OwnedFx", "Boosts", "LeaveGiftNext", "LeaveGiftIndex" }

-- Season tiers ------------------------------------------------------------------

-- Returns ok, message.
function Progression.claimSeasonTier(data, request)
	if type(request) ~= "table" then
		return false, "Bad request"
	end
	local track, tier = request.track, request.tier
	if track ~= "Free" and track ~= "Premium" then
		return false, "Bad request"
	end
	if type(tier) ~= "number" or tier ~= math.floor(tier) or tier < 1 or tier > MAX_TIER then
		return false, "That tier doesn't exist"
	end
	if tier > data.SeasonTier then
		return false, "Reach tier " .. tier .. " first"
	end
	if track == "Premium" and not data.SeasonPremium then
		return false, "Needs the premium pass"
	end

	local reward = Config.SeasonTiers[tier][track]
	if not reward then
		return false, "No reward on this tier"
	end
	local claimedList = if track == "Free" then data.SeasonClaimed.free else data.SeasonClaimed.premium
	if table.find(claimedList, tier) then
		return false, "Already claimed"
	end

	table.insert(claimedList, tier)
	local text = Progression.grantReward(data, reward)
	if text == "" then
		text = "Reward claimed"
	end
	return true, "Tier " .. tier .. ": " .. text
end

-- Loading -----------------------------------------------------------------------

local function wholeNumber(value, minimum)
	if type(value) ~= "number" or value ~= value or value == math.huge then
		return minimum
	end
	return math.max(minimum, math.floor(value))
end

-- Fixes up data right after it's loaded (old saves, new season, new day).
function Progression.normalize(data, now)
	data.Level = wholeNumber(data.Level, 1)
	data.XP = wholeNumber(data.XP, 0)
	data.Gems = wholeNumber(data.Gems, 0)
	data.BonusBalls = wholeNumber(data.BonusBalls, 0)
	data.StreakDay = math.clamp(wholeNumber(data.StreakDay, 1), 1, #Config.DailyStreak)
	data.MissionRerolls = wholeNumber(data.MissionRerolls, 0)
	data.ExtraRerolls = wholeNumber(data.ExtraRerolls, 0)
	data.LeaveGiftNext = wholeNumber(data.LeaveGiftNext, 0)
	data.LeaveGiftIndex = wholeNumber(data.LeaveGiftIndex, 0)

	-- Boost inventory: only known boosts with a whole, positive count.
	local boosts = {}
	if type(data.Boosts) == "table" then
		for boostId, count in data.Boosts do
			local amount = wholeNumber(count, 0)
			if Progression.isBoost(boostId) and amount > 0 then
				boosts[boostId] = amount
			end
		end
	end
	data.Boosts = boosts

	-- One free set of boosts for every player, once, so they get a taste.
	if not data.WelcomeGiven then
		data.WelcomeGiven = true
		for boostId, amount in Config.WELCOME_BOOSTS do
			if type(amount) == "number" and amount > 0 then
				Progression.addBoost(data, boostId, math.floor(amount))
			end
		end
	end

	if not table.find(data.OwnedSkins, "Default") then
		table.insert(data.OwnedSkins, 1, "Default")
	end
	if not table.find(data.OwnedFx, "Classic") then
		table.insert(data.OwnedFx, 1, "Classic")
	end
	if not Progression.findSkin(data.EquippedSkin) or not Progression.ownsSkin(data, data.EquippedSkin) then
		data.EquippedSkin = "Default"
	end
	if not Progression.findFx(data.EquippedFx) or not Progression.ownsFx(data, data.EquippedFx) then
		data.EquippedFx = "Classic"
	end

	Progression.ensureSeason(data)
	data.SeasonTier = math.clamp(wholeNumber(data.SeasonTier, 0), 0, MAX_TIER)
	data.SeasonXP = wholeNumber(data.SeasonXP, 0)

	Progression.refreshMissions(data, now)
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--[[
	Gem shop (ball skins + shatter effects + boosts), daily streak, mission and season
	pass claims. The client asks through the ShopRequest RemoteFunction:
	ShopRequest:InvokeServer(action, argument) -> (ok, message).
	Every check happens here; the client is never trusted.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Progression = require(script.Parent.Progression)

local Remotes = ReplicatedStorage.Remotes

local Shop = {}

local function fireAll(player, events)
	for _, event in events do
		Progression.fire(player, event)
	end
end

local function reward(player, text)
	Progression.fire(player, { type = "Reward", text = text })
end

-- Items with Price 0 and a Source (level, season, starter pack...) can't be
-- bought: they're unlocked another way.
local function checkBuyable(item, owned)
	if owned then
		return false, "You already own " .. item.Name
	end
	if item.Source and item.Price <= 0 then
		return false, "Unlocked by " .. item.Source
	end
	return true
end

local actions = {}

function actions.BuySkin(player, data, skinId)
	local skin = Progression.findSkin(skinId)
	if not skin then
		return false, "That skin doesn't exist"
	end
	local ok, message = checkBuyable(skin, Progression.ownsSkin(data, skin.Id))
	if not ok then
		return false, message
	end
	if data.Gems < skin.Price then
		return false, "Not enough gems"
	end

	local ownedSkins = table.clone(data.OwnedSkins)
	table.insert(ownedSkins, skin.Id)
	PlayerData.update(player, {
		Gems = data.Gems - skin.Price,
		OwnedSkins = ownedSkins,
		EquippedSkin = skin.Id,
	})
	return true, skin.Name .. " unlocked"
end

function actions.EquipSkin(player, data, skinId)
	local skin = Progression.findSkin(skinId)
	if not skin or not Progression.ownsSkin(data, skin.Id) then
		return false, "You don't own that skin"
	end
	PlayerData.update(player, { EquippedSkin = skin.Id })
	return true
end

function actions.BuyFx(player, data, fxId)
	local fx = Progression.findFx(fxId)
	if not fx then
		return false, "That effect doesn't exist"
	end
	local ok, message = checkBuyable(fx, Progression.ownsFx(data, fx.Id))
	if not ok then
		return false, message
	end
	if data.Gems < fx.Price then
		return false, "Not enough gems"
	end

	local ownedFx = table.clone(data.OwnedFx)
	table.insert(ownedFx, fx.Id)
	PlayerData.update(player, {
		Gems = data.Gems - fx.Price,
		OwnedFx = ownedFx,
		EquippedFx = fx.Id,
	})
	return true, fx.Name .. " unlocked"
end

function actions.EquipFx(player, data, fxId)
	local fx = Progression.findFx(fxId)
	if not fx or not Progression.ownsFx(data, fx.Id) then
		return false, "You don't own that effect"
	end
	PlayerData.update(player, { EquippedFx = fx.Id })
	return true
end

-- One boost into the inventory, paid with gems (Config.Boosts[id].Gems).
function actions.BuyBoost(player, data, boostId)
	if not Progression.isBoost(boostId) then
		return false, "That boost doesn't exist"
	end
	local boost = Config.Boosts[boostId]
	local price = boost.Gems
	if type(price) ~= "number" or price <= 0 then
		return false, "That boost can't be bought with gems"
	end
	if data.Gems < price then
		return false, "Not enough gems"
	end

	data.Gems -= price
	Progression.addBoost(data, boostId, 1)
	PlayerData.publish(player, { "Gems", "Boosts" })
	return true, boost.Name .. " boost added"
end

function actions.ClaimDaily(player, data)
	local ok, message = Progression.claimDaily(data, os.time())
	if ok then
		PlayerData.publish(player, Progression.DAILY_FIELDS)
		reward(player, message)
	end
	return ok, message
end

-- New missions might be due (the player kept the game open past midnight).
local function refreshMissions(player, data)
	if Progression.refreshMissions(data, os.time()) then
		PlayerData.publish(player, Progression.MISSION_FIELDS)
	end
end

function actions.ClaimMission(player, data, missionId)
	if type(missionId) ~= "string" then
		return false, "Mission not found"
	end
	refreshMissions(player, data)
	local ok, message, events = Progression.claimMission(data, missionId)
	if ok then
		PlayerData.publish(player, { "Missions" })
		PlayerData.publish(player, Progression.XP_FIELDS)
		reward(player, message)
		fireAll(player, events)
	end
	return ok, message
end

function actions.RerollMission(player, data, missionId)
	if type(missionId) ~= "string" then
		return false, "Mission not found"
	end
	refreshMissions(player, data)
	local ok, message = Progression.rerollMission(data, missionId)
	if ok then
		PlayerData.publish(player, Progression.MISSION_FIELDS)
	end
	return ok, message
end

-- argument: { track = "Free" | "Premium", tier = number }
function actions.FinishTutorial(player, data)
	if data.TutorialDone then
		return true
	end
	PlayerData.update(player, { TutorialDone = true })
	return true
end

function actions.SeenHint(player, data, hintId)
	if type(hintId) ~= "string" or not Config.Hints[hintId] then
		return false, "Unknown tip"
	end
	if table.find(data.Hints, hintId) then
		return true
	end
	local hints = table.clone(data.Hints)
	table.insert(hints, hintId)
	PlayerData.update(player, { Hints = hints })
	return true
end

function actions.ClaimSeasonTier(player, data, request)
	local ok, message = Progression.claimSeasonTier(data, request)
	if ok then
		PlayerData.publish(player, { "SeasonClaimed" })
		PlayerData.publish(player, Progression.REWARD_FIELDS)
		reward(player, message)
	end
	return ok, message
end

-- Lets Main add actions that need the player's current run
-- (UseBoostNow, ResumeRun). handler(player, data, argument) -> (ok, message).
-- Like every action here, it must not yield.
function Shop.addAction(name, handler)
	actions[name] = handler
end

-- One request at a time per player, so spamming can't double-spend.
local busy = {}

function Shop.init()
	Remotes.ShopRequest.OnServerInvoke = function(player, action, argument)
		local handler = type(action) == "string" and actions[action]
		local data = PlayerData.get(player)
		if not handler or not data then
			return false, "Try again in a moment"
		end
		if busy[player] then
			return false, "Slow down"
		end

		busy[player] = true
		local ok, success, message = pcall(handler, player, data, argument)
		busy[player] = nil

		if not ok then
			warn("Shop error:", success)
			return false, "Something went wrong"
		end
		-- No save here: changes are marked dirty and the autosave writes them
		-- (saving on every click would use up the DataStore's write budget).
		return success == true, message
	end
end

function Shop.release(player)
	busy[player] = nil
end

return Shop
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[--[[
	Room decoration: gives every room details that match its zone (Config.Themes[].Style).
	TrackBuilder builds the bare shell (floor, ceiling, walls, ribs), then calls Decor.decorate.

	Golden rule: nothing here enters the flight path, the box in the middle of the corridor
	between knee and ceiling height (|x| < 6.5, 2 < y < 12 from the floor). Decor hugs the walls,
	lies on the floor or hangs above y = 12, so the player always sees the obstacles clearly.

	Kinds: "Wall" for solid decoration (balls bounce off), "Prop" for breakable glass.
	A breakable made of several parts is a Model with attribute Breakable = true:
	hitting any of its parts shatters the whole thing.

	Props that have a Blender model (Models.luau) use it through Kit:place / Kit:wallProp;
	when the model isn't loaded (ID 0 in Config.Models) those return nil and the
	part-built version below is made instead, exactly as before.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Models = require(script.Parent.Models)
local ModelStyles = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelStyles"))

local Decor = {}

local BAYS = { 5, 15, 25, 35, 45, 55, 65, 75 } -- wall bays between the ribs (depth into the room)
local SIDES = { -1, 1 }
local GATE_DEPTH = 5 -- where the zone entrance showpiece stands
local MIN_BREAKABLES = 3
local GLOBE_SPOTS = { 15, 35, 55 } -- ceiling spots for extra breakables when a room has too few

local Block = Enum.PartType.Block
local BallShape = Enum.PartType.Ball
local CylinderShape = Enum.PartType.Cylinder
local Material = Enum.Material

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder's axis from X to Y
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- turns a cylinder's axis from X to Z
local QUARTER_TURN = math.rad(90)

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local METAL = Color3.fromRGB(150, 158, 170)

-- Simple line drawings, as segments { u1, v1, u2, v2 }: u = depth (positive = further down
-- the corridor), v = up. Used for neon signs, wall runes and floor runes.
local GLYPHS = {
	Arrow = { { -2, 0, 2, 0 }, { 2, 0, 0.8, 1.2 }, { 2, 0, 0.8, -1.2 } },
	Bolt = { { -1.6, 1.4, 0.3, 0.2 }, { 0.3, 0.2, -0.3, -0.2 }, { -0.3, -0.2, 1.6, -1.4 } },
	Diamond = { { 0, 1.4, 1.4, 0 }, { 1.4, 0, 0, -1.4 }, { 0, -1.4, -1.4, 0 }, { -1.4, 0, 0, 1.4 } },
	Chevrons = { { -1.8, 1.2, -0.6, 0 }, { -0.6, 0, -1.8, -1.2 }, { 0.2, 1.2, 1.4, 0 }, { 1.4, 0, 0.2, -1.2 } },
	Star = { { -1.5, 0, 1.5, 0 }, { 0, -1.5, 0, 1.5 }, { -1, -1, 1, 1 }, { -1, 1, 1, -1 } },
	Eye = { { -1.6, 0, 0, 1 }, { 0, 1, 1.6, 0 }, { 1.6, 0, 0, -1 }, { 0, -1, -1.6, 0 }, { 0, 0.35, 0, -0.35 } },
}
local GLYPH_NAMES = { "Arrow", "Bolt", "Diamond", "Chevrons", "Star", "Eye" }

-- Drawing kit ----------------------------------------------------------------------
-- Wraps builder.newPart with room coordinates: x across (0 = middle), y up from the floor,
-- d depth into the room (0 = room entrance, 80 = room end).

local Kit = {}
Kit.__index = Kit

local function newKit(builder, room, info)
	return setmetatable({
		newPart = builder.newPart,
		origin = builder.ORIGIN,
		half = builder.WIDTH / 2,
		height = builder.HEIGHT,
		length = builder.LENGTH,
		folder = room.folder,
		startZ = info.startZ,
		rng = info.rng,
		theme = info.theme,
		breakables = 0,
		maxBreakables = info.rng:NextInteger(5, 8),
	}, Kit)
end

function Kit:pos(x, y, d)
	return Vector3.new(self.origin.X + x, self.origin.Y + y, self.startZ - d)
end

function Kit:at(x, y, d)
	return CFrame.new(self:pos(x, y, d))
end

-- x of a point `inset` studs in front of the wall on `side` (-1 left, 1 right).
function Kit:wallX(side, inset)
	return side * (self.half - inset)
end

function Kit:random(min, max)
	return self.rng:NextNumber(min, max)
end

function Kit:chance(probability)
	return self.rng:NextNumber() < probability
end

function Kit:pick(list)
	return list[self.rng:NextInteger(1, #list)]
end

-- options = { { weight, value }, ... }
function Kit:pickWeighted(options)
	local total = 0
	for _, option in options do
		total += option[1]
	end
	local roll = self.rng:NextNumber() * total
	for _, option in options do
		roll -= option[1]
		if roll <= 0 then
			return option[2]
		end
	end
	return options[#options][2]
end

function Kit:part(parent, kind, shape, size, cframe, color, material, extra)
	local props = {
		Shape = shape,
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material or Material.SmoothPlastic,
	}
	if extra then
		for name, value in extra do
			props[name] = value
		end
	end
	return self.newPart(parent, kind, props)
end

-- Solid decoration ----------------------------------------------------------------

function Kit:block(size, cframe, color, material)
	return self:part(self.folder, "Wall", Block, size, cframe, color, material)
end

function Kit:glow(size, cframe, color)
	return self:part(self.folder, "Wall", Block, size, cframe, color, Material.Neon)
end

function Kit:ball(diameter, cframe, color, material)
	return self:part(self.folder, "Wall", BallShape, Vector3.one * diameter, cframe, color, material)
end

-- A cylinder lying along the X axis of cframe.
function Kit:rod(length, diameter, cframe, color, material)
	return self:part(self.folder, "Wall", CylinderShape, Vector3.new(length, diameter, diameter), cframe, color, material)
end

-- A standing cylinder from height y0 up to y0 + height.
function Kit:post(x, y0, height, diameter, d, color, material)
	return self:rod(height, diameter, self:at(x, y0 + height / 2, d) * UPRIGHT, color, material)
end

-- A straight bar between two world points. `up` must not be parallel to the bar:
-- it sets which way `depth` faces (Vector3.xAxis for drawings on a wall, yAxis on the floor).
function Kit:bar(p1, p2, width, depth, up, color, material, parent, kind)
	local length = (p2 - p1).Magnitude + width -- a little longer so joints close up
	local cframe = CFrame.lookAt((p1 + p2) / 2, p2, up)
	return self:part(parent or self.folder, kind or "Wall", Block, Vector3.new(width, depth, length), cframe, color, material)
end

-- Same settings newPart uses, for the one shape it can't make.
function Kit:wedge(size, cframe, color, material)
	local wedge = Instance.new("WedgePart")
	wedge.Anchored = true
	wedge.CanCollide = false
	wedge.CanTouch = false
	wedge.CastShadow = false
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Material.SmoothPlastic
	wedge:SetAttribute("Kind", "Wall")
	wedge.Parent = self.folder
	return wedge
end

-- Neon line drawing flat against a wall, centered at depth d and height y.
function Kit:wallGlyph(segments, side, inset, d, y, scale, thickness, color, parent, kind)
	local x = self:wallX(side, inset)
	for _, s in segments do
		local p1 = self:pos(x, y + s[2] * scale, d + s[1] * scale)
		local p2 = self:pos(x, y + s[4] * scale, d + s[3] * scale)
		self:bar(p1, p2, thickness, thickness, Vector3.xAxis, color, Material.Neon, parent, kind)
	end
end

-- Neon line drawing lying on the floor (v becomes x).
function Kit:floorGlyph(segments, x, d, scale, color)
	for _, s in segments do
		local p1 = self:pos(x + s[2] * scale, 0.03, d + s[1] * scale)
		local p2 = self:pos(x + s[4] * scale, 0.03, d + s[3] * scale)
		self:bar(p1, p2, 0.22, 0.04, Vector3.yAxis, color, Material.Neon)
	end
end

-- Models -----------------------------------------------------------------------------

-- Places a Blender model in the room folder, or returns nil if it isn't available
-- (the caller then builds its part version). Breakable models count as breakables.
function Kit:place(name, cframe, options)
	local model = Models.place(name, self.folder, cframe, options)
	if model == nil then
		return nil
	end
	local style = ModelStyles[name]
	if style and style.Breakable then
		self.breakables += 1
	end
	return model
end

-- Places a wall model (origin at the center of its back face, front toward -Z in Blender)
-- with its back `inset` studs off the wall on `side` and its front facing into the corridor.
-- y is the model's anchor point (options.anchor: "floor", "ceiling" or "center").
-- The long side of the model ends up running along the corridor.
function Kit:wallProp(name, side, inset, y, d, options)
	local style = ModelStyles[name]
	if style == nil then
		return nil
	end
	options = options or {}
	local depth = style.Size.Z * (options.scale or 1)
	local cframe = self:at(self:wallX(side, inset + depth / 2), y, d) * CFrame.Angles(0, side * QUARTER_TURN, 0)
	return self:place(name, cframe, options)
end

-- Breakables -----------------------------------------------------------------------

function Kit:canBreak()
	return self.breakables < self.maxBreakables
end

-- Starts a breakable made of several parts; fill it with Kit:glass / Kit:inner.
function Kit:breakable(name)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Breakable", true)
	model.Parent = self.folder
	self.breakables += 1
	return model
end

-- Glass piece. With parent = nil it is a breakable of its own.
function Kit:glass(parent, shape, size, cframe, color, transparency)
	if parent == nil then
		self.breakables += 1
	end
	return self:part(parent or self.folder, "Prop", shape, size, cframe, color, Material.Glass, {
		Name = "GlassProp",
		Transparency = transparency or 0.35,
		Reflectance = 0.25,
	})
end

-- Something inside a glass breakable (a glow, a plant, liquid). Shatters with it.
function Kit:inner(parent, shape, size, cframe, color, material)
	return self:part(parent, "Prop", shape, size, cframe, color, material or Material.Neon)
end

-- Glass tinted toward the zone color.
function Kit:tint(amount)
	return self.theme.Accent:Lerp(WHITE, amount or 0.45)
end

-- Shared props -----------------------------------------------------------------------

-- Round glass vase standing with its base at height y.
local function vase(kit, x, y, d, color, scale)
	if kit:place("GlassVase", kit:at(x, y, d), { anchor = "floor", scale = scale * 0.85, colors = { Glass = color } }) then
		return
	end
	local model = kit:breakable("Vase")
	local body = 1.6 * scale
	kit:glass(model, BallShape, Vector3.one * body, kit:at(x, y + body / 2, d), color)
	kit:glass(model, CylinderShape, Vector3.new(0.9, 0.7, 0.7) * scale, kit:at(x, y + body + 0.3 * scale, d) * UPRIGHT, color)
end

-- Wide-bellied urn with a neck and a lip.
local function urn(kit, x, y, d, color, scale)
	if kit:place("GlassUrn", kit:at(x, y, d), { anchor = "floor", scale = scale * 0.9, colors = { Glass = color } }) then
		return
	end
	local model = kit:breakable("Urn")
	kit:glass(model, BallShape, Vector3.one * 1.8 * scale, kit:at(x, y + 0.9 * scale, d), color, 0.25)
	kit:glass(model, CylinderShape, Vector3.new(0.6, 0.9, 0.9) * scale, kit:at(x, y + 1.95 * scale, d) * UPRIGHT, color, 0.25)
	kit:glass(model, CylinderShape, Vector3.new(0.2, 1.3, 1.3) * scale, kit:at(x, y + 2.3 * scale, d) * UPRIGHT, color, 0.25)
end

-- Glass ball with a glowing heart.
local function orb(kit, x, y, d, size, color)
	local placed = kit:place("GlassOrb", kit:at(x, y, d), {
		anchor = "center",
		scale = size / 2.3,
		colors = { Glass = color, Neon = kit.theme.Accent },
	})
	if placed then
		return
	end
	local model = kit:breakable("Orb")
	kit:glass(model, BallShape, Vector3.one * size, kit:at(x, y, d), color, 0.4)
	kit:inner(model, BallShape, Vector3.one * size * 0.35, kit:at(x, y, d), kit.theme.Accent)
end

-- Glass lantern hanging on a chain from the ceiling; y is its bottom.
local function lantern(kit, x, y, d, color)
	local placed = kit:place("GlassLantern", kit:at(x, y, d), {
		anchor = "floor",
		colors = { Glass = color, Neon = kit.theme.Accent },
	})
	if placed then
		local hook = y + ModelStyles.GlassLantern.Size.Y
		kit:post(x, hook, kit.height - hook, 0.12, d, Color3.fromRGB(60, 55, 50), Material.Metal)
		return
	end
	local top = y + 1.6
	kit:post(x, top, kit.height - top, 0.12, d, Color3.fromRGB(60, 55, 50), Material.Metal)
	local model = kit:breakable("Lantern")
	kit:glass(model, Block, Vector3.new(1.1, 1.6, 1.1), kit:at(x, y + 0.8, d), color, 0.3)
	kit:inner(model, BallShape, Vector3.one * 0.55, kit:at(x, y + 0.8, d), kit.theme.Accent)
end

-- Small glass globe lamp right under the ceiling (stays above the flight path anywhere).
local function ceilingGlobe(kit, x, d)
	kit:post(x, kit.height - 0.45, 0.45, 0.15, d, METAL, Material.Metal)
	orb(kit, x, kit.height - 1.05, d, 1.3, kit:tint(0.6))
end

-- Three crystals growing from a point; y is their base.
local function crystalCluster(kit, x, y, d, color)
	local model = kit:breakable("CrystalCluster")
	local spin = kit:random(0, math.pi)
	kit:glass(model, Block, Vector3.new(0.6, 2, 0.6), kit:at(x, y + 1, d) * CFrame.Angles(0, spin, 0), color, 0.2)
	kit:glass(model, Block, Vector3.new(0.45, 1.3, 0.45), kit:at(x, y + 0.6, d - 0.5) * CFrame.Angles(-0.5, 0, 0), color, 0.2)
	kit:glass(model, Block, Vector3.new(0.45, 1.3, 0.45), kit:at(x, y + 0.6, d + 0.5) * CFrame.Angles(0.5, 0, 0), color, 0.2)
end

-- The zone name painted on a sign, facing the player coming down the corridor.
local function nameplate(kit, part, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- +Z, toward the approaching player
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = kit.theme.Name or ""
	label.TextScaled = true
	label.Font = Enum.Font.Michroma
	label.TextColor3 = color
	label.Parent = gui
	gui.Parent = part
end

local function nothing() end

-- Lab: clean white panels, glass partitions, benches with test tubes ---------------------

local LAB_DARK = Color3.fromRGB(55, 62, 75)
local LAB_ROOM = Color3.fromRGB(38, 52, 66) -- the side labs seen through the windows
local LAB_RACK = Color3.fromRGB(35, 38, 45)
local LAB_YELLOW = Color3.fromRGB(255, 205, 40)
local LAB_LIGHT = Color3.fromRGB(235, 248, 255)
local LIQUIDS = {
	Color3.fromRGB(90, 255, 140),
	Color3.fromRGB(255, 90, 170),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(120, 160, 255),
}
local LED_COLORS = { Color3.fromRGB(80, 255, 140), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 170, 60) }

local Lab = {}

function Lab.room(kit)
	local L, H = kit.length, kit.height
	local seam = kit.theme.Wall:Lerp(BLACK, 0.18)
	for _, side in SIDES do
		-- Panel seams along the walls.
		for _, y in { 4.5, 9.5 } do
			kit:block(Vector3.new(0.06, 0.12, L), kit:at(kit:wallX(side, 0.03), y, L / 2), seam)
		end
		-- Pipes along the ceiling corners.
		if kit:chance(0.75) then
			-- Four pipe segments end to end, hanging from the ceiling corner (the part version is two long rods).
			local segment = L / 4
			local pipeScale = segment / ModelStyles.PipeRun.Size.X
			local placed = 0
			for i = 1, 4 do
				local options = { anchor = "ceiling", scale = pipeScale, colors = { Metal = kit.theme.Accent } }
				if kit:wallProp("PipeRun", side, 0, H, (i - 0.5) * segment, options) then
					placed += 1
				end
			end
			if placed == 0 then
				kit:rod(L, 0.7, kit:at(kit:wallX(side, 1.2), H - 0.6, L / 2) * ALONG_Z, METAL, Material.Metal)
				kit:rod(L, 0.35, kit:at(kit:wallX(side, 2.1), H - 0.35, L / 2) * ALONG_Z, kit.theme.Accent)
			end
		end
		-- Warning stripes along the floor edges.
		kit:block(Vector3.new(0.6, 0.04, L), kit:at(side * 8.7, 0.02, L / 2), LAB_YELLOW)
		kit:block(Vector3.new(0.2, 0.05, L), kit:at(side * 8.7, 0.025, L / 2), LAB_DARK)
	end
	-- Ceiling light panels.
	for d = 10, L - 10, 20 do
		-- 1.25x: 5 wide, 1.14 deep, so its underside stays above the flight path (y = 12).
		local light = kit:place("CeilingLight", kit:at(0, H, d), { anchor = "ceiling", scale = 1.25 })
		if not light then
			kit:glow(Vector3.new(5, 0.12, 2.5), kit:at(0, H - 0.06, d), LAB_LIGHT)
		end
	end
end

local function labPoster(kit, side, d)
	local hazard = kit:chance(0.5)
	local y = kit:random(5.5, 7.5)
	kit:block(Vector3.new(0.08, 2.6, 2), kit:at(kit:wallX(side, 0.04), y, d), if hazard then LAB_YELLOW else kit.theme.Accent)
	local mark = CFrame.Angles(math.rad(45), 0, 0) -- a diamond symbol
	kit:block(Vector3.new(0.06, 0.9, 0.9), kit:at(kit:wallX(side, 0.1), y, d) * mark, if hazard then LAB_DARK else WHITE)
end

-- Glass partition looking into a side lab.
local function labWindow(kit, side, d)
	if not kit:canBreak() then
		return labPoster(kit, side, d)
	end
	local frame = kit.theme.Wall:Lerp(BLACK, 0.25)
	kit:block(Vector3.new(0.1, 6, 7), kit:at(kit:wallX(side, 0.07), 6.5, d), LAB_ROOM)
	kit:glow(Vector3.new(0.08, 0.25, 6.6), kit:at(kit:wallX(side, 0.14), 9.1, d), kit:tint(0.5))
	kit:block(Vector3.new(0.7, 0.3, 7.4), kit:at(kit:wallX(side, 0.35), 3.35, d), frame)
	kit:block(Vector3.new(0.7, 0.3, 7.4), kit:at(kit:wallX(side, 0.35), 9.65, d), frame)
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 6, 7), kit:at(kit:wallX(side, 0.45), 6.5, d), kit:tint(0.6), 0.5)
	pane.Name = "LabWindow"
end

-- Rack of colored test tubes; y is the bench top.
local function testTubes(kit, x, y, d, side)
	if Models.has("TestTubeRack") then -- (checked first so the part version draws the same random numbers)
		local rack = kit:place("TestTubeRack", kit:at(x, y, d) * CFrame.Angles(0, side * QUARTER_TURN, 0), {
			anchor = "floor",
			colors = { Neon = kit:pick(LIQUIDS) },
		})
		if rack then
			return
		end
	end
	kit:block(Vector3.new(0.5, 0.25, 2.4), kit:at(x, y + 1.1, d), LAB_DARK)
	local model = kit:breakable("TestTubes")
	for _, offset in { -0.75, 0, 0.75 } do
		kit:glass(model, CylinderShape, Vector3.new(1.6, 0.32, 0.32), kit:at(x, y + 0.8, d + offset) * UPRIGHT, kit:pick(LIQUIDS), 0.2)
	end
end

-- Round flask with colored liquid; y is the bench top.
local function flask(kit, x, y, d)
	if Models.has("Flask") then
		local placed = kit:place("Flask", kit:at(x, y, d), {
			anchor = "floor",
			colors = { Glass = kit:tint(0.7), Neon = kit:pick(LIQUIDS) },
		})
		if placed then
			return
		end
	end
	local model = kit:breakable("Flask")
	kit:glass(model, BallShape, Vector3.one * 1.3, kit:at(x, y + 0.65, d), kit:tint(0.7), 0.5)
	kit:glass(model, CylinderShape, Vector3.new(0.8, 0.32, 0.32), kit:at(x, y + 1.6, d) * UPRIGHT, kit:tint(0.7), 0.5)
	kit:inner(model, BallShape, Vector3.one * 0.9, kit:at(x, y + 0.55, d), kit:pick(LIQUIDS), Material.SmoothPlastic)
end

local function labBench(kit, side, d)
	-- Scaled so the bench top sits at 3.25, where the glassware stands.
	local benchScale = 3.25 / ModelStyles.LabBench.Size.Y
	local bench = kit:wallProp("LabBench", side, 0, 0, d, { anchor = "floor", scale = benchScale })
	if not bench then
		kit:block(Vector3.new(2.2, 3, 6), kit:at(kit:wallX(side, 1.2), 1.5, d), kit.theme.Wall:Lerp(BLACK, 0.1))
		kit:block(Vector3.new(2.6, 0.25, 6.4), kit:at(kit:wallX(side, 1.35), 3.125, d), LAB_DARK)
	end
	if kit:canBreak() then
		testTubes(kit, kit:wallX(side, 1.6), 3.25, d - 1.5, side)
	end
	if kit:canBreak() then
		flask(kit, kit:wallX(side, 1.5), 3.25, d + 1.5)
	end
end

local function serverRacks(kit, side, d)
	local count = kit:pick({ 1, 2 })
	for i = 1, count do
		local rackD = if count == 1 then d else d + (if i == 1 then -1.9 else 1.9)
		local ledColor = kit:pick(LED_COLORS)
		-- 1.2x makes the rack 8.4 tall and 3.6 long, which still fits two per bay.
		local rack = kit:wallProp("ServerRack", side, 0, 0, rackD, { anchor = "floor", scale = 1.2, colors = { Neon = ledColor } })
		if not rack then
			kit:block(Vector3.new(1.8, 9, 3.4), kit:at(kit:wallX(side, 0.9), 4.5, rackD), LAB_RACK)
			kit:glow(Vector3.new(0.05, 7, 0.2), kit:at(kit:wallX(side, 1.83), 4.8, rackD + 0.9), ledColor)
		end
	end
end

-- Glass case on a pedestal with a glowing sample inside.
local function displayCase(kit, side, d)
	if not kit:canBreak() then
		return labPoster(kit, side, d)
	end
	local x = kit:wallX(side, 1.4)
	kit:block(Vector3.new(2, 2.5, 2), kit:at(x, 1.25, d), LAB_DARK)
	local model = kit:breakable("DisplayCase")
	kit:glass(model, Block, Vector3.new(1.8, 2, 1.8), kit:at(x, 3.5, d), kit:tint(0.7), 0.55)
	local sample = CFrame.Angles(math.rad(45), math.rad(45), 0)
	kit:inner(model, Block, Vector3.one * 0.7, kit:at(x, 3.3, d) * sample, kit:pick(LIQUIDS))
end

Lab.features = {
	{ 3, labWindow },
	{ 3, labBench },
	{ 2, serverRacks },
	{ 2, displayCase },
	{ 1, labPoster },
	{ 3, nothing },
}

-- Airlock frame with blinking beacons.
function Lab.gate(kit, d)
	local H = kit.height
	local frame = kit.theme.Wall:Lerp(BLACK, 0.3)
	for _, side in SIDES do
		kit:block(Vector3.new(3, H, 1.6), kit:at(side * 8.5, H / 2, d), frame)
		kit:glow(Vector3.new(0.2, 11.6, 0.3), kit:at(side * 6.9, 6, d - 0.6), kit.theme.Accent)
		kit:ball(0.8, kit:at(side * 7.6, 12.2, d - 1.1), Color3.fromRGB(255, 120, 40), Material.Neon)
	end
	local header = kit:block(Vector3.new(14, 1.6, 1.6), kit:at(0, H - 0.8, d), frame)
	nameplate(kit, header, kit.theme.Accent)
	kit:glow(Vector3.new(14, 0.2, 0.3), kit:at(0, 12.2, d - 0.6), kit.theme.Accent)
	kit:block(Vector3.new(14, 0.04, 1.6), kit:at(0, 0.02, d), LAB_YELLOW)
end

-- Neon city: dark alley, glowing signs, billboards, cables --------------------------------

local NEON_DARK = Color3.fromRGB(18, 18, 26)
local NEON_CABLE = Color3.fromRGB(12, 12, 16)
local NEON_COLORS = {
	Color3.fromRGB(0, 230, 255),
	Color3.fromRGB(255, 220, 60),
	Color3.fromRGB(120, 255, 110),
	Color3.fromRGB(180, 90, 255),
}

local Neon = {}

local function neonColor(kit)
	return if kit:chance(0.35) then kit.theme.Accent else kit:pick(NEON_COLORS)
end

function Neon.room(kit)
	local L, H = kit.length, kit.height
	local accent = kit.theme.Accent
	local grid = accent:Lerp(BLACK, 0.45)
	-- Glowing floor grid.
	for d = 10, L - 10, 20 do
		kit:glow(Vector3.new(18.6, 0.04, 0.15), kit:at(0, 0.02, d), grid)
	end
	for _, x in { -4, 4 } do
		kit:glow(Vector3.new(0.15, 0.04, L), kit:at(x, 0.02, L / 2), grid)
	end
	for _, side in SIDES do
		-- Guide light low on the walls, like a subway tunnel.
		kit:glow(Vector3.new(0.06, 0.2, L), kit:at(kit:wallX(side, 0.03), 1.2, L / 2), accent)
		-- Cables sagging between the ceiling corners.
		local x = kit:wallX(side, 1.1)
		local d = kit:random(2, 14)
		while d < L - 14 do
			local span = kit:random(8, 12)
			local sag = kit:random(0.8, 1.4)
			local a = kit:pos(x, H - 0.2, d)
			local mid = kit:pos(x, H - 0.2 - sag, d + span / 2)
			local b = kit:pos(x, H - 0.2, d + span)
			kit:bar(a, mid, 0.15, 0.15, Vector3.xAxis, NEON_CABLE)
			kit:bar(mid, b, 0.15, 0.15, Vector3.xAxis, NEON_CABLE)
			d += span + kit:random(14, 26)
		end
	end
	-- Ceiling vents.
	for _, d in { 25, 65 } do
		kit:block(Vector3.new(3, 0.1, 2), kit:at(kit:random(-4, 4), H - 0.05, d), NEON_DARK:Lerp(WHITE, 0.15), Material.DiamondPlate)
	end
end

local function billboard(kit, side, d)
	local y = kit:random(5.5, 7.5)
	local main = neonColor(kit)
	local second = main:Lerp(WHITE, 0.6)
	kit:block(Vector3.new(0.2, 4.6, 7), kit:at(kit:wallX(side, 0.1), y, d), NEON_DARK)
	kit:block(Vector3.new(0.1, 4, 6.4), kit:at(kit:wallX(side, 0.25), y, d), main:Lerp(BLACK, 0.25))
	kit:block(Vector3.new(0.08, 1.2, 3), kit:at(kit:wallX(side, 0.33), y + kit:random(-0.8, 0.8), d + kit:random(-1.2, 1.2)), second)
	kit:glow(Vector3.new(0.3, 0.15, 6.6), kit:at(kit:wallX(side, 0.5), y + 2.45, d), WHITE)
end

-- Neon line drawing behind a glass cover, on a dark board.
local function neonSign(kit, side, d)
	if not kit:canBreak() then
		return billboard(kit, side, d)
	end
	local color = neonColor(kit)
	kit:block(Vector3.new(0.15, 4, 6), kit:at(kit:wallX(side, 0.08), 7, d), NEON_DARK)
	local model = kit:breakable("NeonSign")
	kit:wallGlyph(GLYPHS[kit:pick(GLYPH_NAMES)], side, 0.3, d, 7, 1, 0.22, color, model, "Prop")
	kit:glass(model, Block, Vector3.new(0.08, 3.8, 5.8), kit:at(kit:wallX(side, 0.5), 7, d), color:Lerp(WHITE, 0.7), 0.7)
end

local function wallVent(kit, side, d)
	local y = kit:random(3, 10)
	if kit:wallProp("Vent", side, 0.02, y, d, { anchor = "center", scale = 1.25 }) then
		return
	end
	kit:block(Vector3.new(0.4, 2.4, 3), kit:at(kit:wallX(side, 0.2), y, d), NEON_DARK:Lerp(WHITE, 0.1), Material.Metal)
	for _, offset in { -0.45, 0.45 } do
		kit:block(Vector3.new(0.1, 0.18, 2.8), kit:at(kit:wallX(side, 0.45), y + offset, d), NEON_CABLE)
	end
end

-- Upright glass tubes with a glowing gas core.
local function neonTubes(kit, side, d)
	if not kit:canBreak() then
		return wallVent(kit, side, d)
	end
	local count = if kit.breakables + 1 < kit.maxBreakables and kit:chance(0.5) then 2 else 1
	local x = kit:wallX(side, 0.6)
	for i = 1, count do
		local tubeD = if count == 1 then d else d + (if i == 1 then -1.5 else 1.5)
		local color = neonColor(kit)
		-- The model is a horizontal tube on brackets; two of them stack instead of sitting side by side.
		local tubeY = if count == 1 then 6.5 else 6.5 + (if i == 1 then -1.6 else 1.6)
		local tube = kit:wallProp("NeonTube", side, 0.05, tubeY, d, { anchor = "center", scale = 1.4, colors = { Neon = color } })
		if tube then
			continue
		end
		local cframe = kit:at(x, 6.5, tubeD) * UPRIGHT
		local model = kit:breakable("NeonTube")
		kit:glass(model, CylinderShape, Vector3.new(6, 0.6, 0.6), cframe, color:Lerp(WHITE, 0.6), 0.6)
		kit:inner(model, CylinderShape, Vector3.new(5.8, 0.25, 0.25), cframe, color)
	end
end

-- A locked service hatch with a light stripe.
local function serviceHatch(kit, side, d)
	kit:block(Vector3.new(0.1, 7, 4), kit:at(kit:wallX(side, 0.05), 3.5, d), NEON_DARK)
	kit:glow(Vector3.new(0.12, 0.3, 4), kit:at(kit:wallX(side, 0.1), 5, d), neonColor(kit))
end

Neon.features = {
	{ 3, neonSign },
	{ 2, billboard },
	{ 2, wallVent },
	{ 2, neonTubes },
	{ 1, serviceHatch },
	{ 3, nothing },
}

-- Double neon arch with the zone name on a hanging sign.
function Neon.gate(kit, d)
	local colors = { kit.theme.Accent, NEON_COLORS[1] }
	for i, color in colors do
		local archD = d + (i - 1) * 1.5
		for _, side in SIDES do
			kit:glow(Vector3.new(0.4, 12.3, 0.4), kit:at(kit:wallX(side, 0.6), 6.15, archD), color)
		end
		kit:glow(Vector3.new(19.2, 0.4, 0.4), kit:at(0, 12.5, archD), color)
	end
	local board = kit:block(Vector3.new(10, 1.2, 0.3), kit:at(0, 13.3, d), NEON_DARK)
	nameplate(kit, board, kit.theme.Accent)
	kit:glow(Vector3.new(15, 0.04, 0.3), kit:at(0, 0.02, d), kit.theme.Accent)
end

-- Temple: sandstone pillars and arches, carvings, braziers, urns ---------------------------

local PILLAR_DEPTHS = { 20, 40, 60 }
local TEMPLE_RUNNER = Color3.fromRGB(150, 55, 40)
local TEMPLE_GOLD = Color3.fromRGB(230, 180, 60)
local TEMPLE_BRONZE = Color3.fromRGB(150, 95, 45)
local TEMPLE_FLAME = Color3.fromRGB(255, 230, 120)
local URN_COLORS = {
	Color3.fromRGB(60, 170, 170),
	Color3.fromRGB(70, 110, 220),
	Color3.fromRGB(230, 170, 60),
	Color3.fromRGB(200, 80, 60),
}
-- Raised shapes inside carved panels, as { u, v, width, height }.
local CARVINGS = {
	{ { 0, 0, 3.4, 0.5 }, { 0, 0, 1, 1 } }, -- eye
	{ { 0, -1.2, 3.6, 0.5 }, { 0, -0.4, 2.6, 0.5 }, { 0, 0.4, 1.6, 0.5 } }, -- stepped pyramid
	{ { 0, -0.3, 0.5, 3 }, { 0, 0.6, 2.4, 0.5 } }, -- cross
	{ { -1, 0, 0.5, 3 }, { 1, 0, 0.5, 3 }, { 0, 1.25, 2.5, 0.5 } }, -- gateway
}

local Temple = {}

local function stone(kit, amount)
	return kit.theme.Wall:Lerp(BLACK, amount)
end

function Temple.room(kit)
	local L = kit.length
	-- Red runner with gold borders down the middle of the floor.
	kit:block(Vector3.new(7, 0.04, L), kit:at(0, 0.02, L / 2), TEMPLE_RUNNER:Lerp(kit.theme.Accent, 0.2))
	for _, x in { -3.65, 3.65 } do
		kit:block(Vector3.new(0.3, 0.05, L), kit:at(x, 0.025, L / 2), TEMPLE_GOLD)
	end
	for _, d in PILLAR_DEPTHS do
		for _, side in SIDES do
			-- The model is 14 tall; 13/14 makes it end right under the beam (y = 13).
			local pillar = kit:place("Pillar", kit:at(side * 8.6, 0, d), {
				anchor = "floor",
				scale = 13 / ModelStyles.Pillar.Size.Y,
				colors = { Stone = stone(kit, 0.04) },
			})
			if not pillar then
				kit:post(side * 8.6, 0, 10, 2.2, d, stone(kit, 0.04), Material.Sandstone)
				kit:block(Vector3.new(3, 1, 3), kit:at(side * 8.5, 10.5, d), stone(kit, 0.15))
			end
			-- Arch shoulder: a wedge between the capital and the beam, sloping toward the middle.
			-- Its full faces point up (under the beam) and out (against the wall).
			local shoulder = CFrame.fromMatrix(kit:pos(side * 8.3, 12, d), Vector3.new(0, 0, side), Vector3.new(0, -1, 0))
			kit:wedge(Vector3.new(2.4, 2, 3.4), shoulder, stone(kit, 0.15))
		end
		kit:block(Vector3.new(20, 1, 2.4), kit:at(0, 13.5, d), stone(kit, 0.15))
	end
end

local function carving(kit, side, d)
	local y = kit:random(5.5, 7)
	kit:block(Vector3.new(0.1, 4.4, 4.4), kit:at(kit:wallX(side, 0.05), y, d), stone(kit, 0.22))
	local relief = kit.theme.Wall:Lerp(kit.theme.Accent, 0.25)
	for _, r in kit:pick(CARVINGS) do
		kit:block(Vector3.new(0.12, r[4], r[3]), kit:at(kit:wallX(side, 0.15), y + r[2], d + r[1]), relief)
	end
end

local function brazier(kit, side, d)
	local x = kit:wallX(side, 1.8)
	if kit:place("Brazier", kit:at(x, 0, d), { anchor = "floor", colors = { Neon = kit.theme.Accent } }) then
		return
	end
	kit:post(x, 0, 2.6, 0.5, d, TEMPLE_BRONZE, Material.Metal)
	kit:post(x, 2.6, 0.5, 1.8, d, TEMPLE_BRONZE, Material.Metal)
	kit:ball(1.1, kit:at(x, 3.35, d), kit.theme.Accent, Material.Neon)
	kit:ball(0.6, kit:at(x, 3.85, d), TEMPLE_FLAME, Material.Neon)
end

local function urnOnPedestal(kit, side, d)
	if not kit:canBreak() then
		return carving(kit, side, d)
	end
	local x = kit:wallX(side, 1.6)
	kit:block(Vector3.new(1.8, 1.2, 1.8), kit:at(x, 0.6, d), stone(kit, 0.15))
	urn(kit, x, 1.2, d, kit:pick(URN_COLORS), kit:random(0.9, 1.15))
end

local function vaseShelf(kit, side, d)
	if not kit:canBreak() then
		return carving(kit, side, d)
	end
	kit:block(Vector3.new(1.6, 0.3, 5), kit:at(kit:wallX(side, 0.8), 4.5, d), stone(kit, 0.2))
	for _, offset in { -1.5, 1.5 } do
		if kit:canBreak() then
			vase(kit, kit:wallX(side, 1), 4.65, d + offset, kit:pick(URN_COLORS):Lerp(WHITE, 0.2), 0.75)
		end
	end
end

local function templeLantern(kit, side, d)
	if not kit:canBreak() then
		return carving(kit, side, d)
	end
	lantern(kit, kit:wallX(side, 2), kit:random(8.5, 10), d, kit:tint(0.5))
end

Temple.features = {
	{ 3, carving },
	{ 2, brazier },
	{ 3, urnOnPedestal },
	{ 2, vaseShelf },
	{ 2, templeLantern },
	{ 5, nothing },
}

-- Massive stone gate with the zone name on the lintel, flames on either side.
function Temple.gate(kit, d)
	for _, side in SIDES do
		kit:block(Vector3.new(3.4, 12, 3), kit:at(side * 8.3, 6, d), stone(kit, 0.18))
		kit:glow(Vector3.new(0.6, 11, 0.1), kit:at(side * 7.1, 6, d - 1.55), kit.theme.Accent)
		brazier(kit, side, d + 4)
	end
	local lintel = kit:block(Vector3.new(20, 2, 3.6), kit:at(0, 13, d), stone(kit, 0.25))
	nameplate(kit, lintel, TEMPLE_GOLD)
end

-- Greenhouse: glass roof frames, planters, vines, terrariums ------------------------------

local GH_FRAME = Color3.fromRGB(95, 115, 105)
local GH_SKY = Color3.fromRGB(120, 190, 140)
local GH_OUTSIDE = Color3.fromRGB(70, 150, 95)
local GH_POT = Color3.fromRGB(175, 90, 60)
local GH_TRUNK = Color3.fromRGB(100, 70, 45)
local LEAVES = {
	Color3.fromRGB(60, 170, 80),
	Color3.fromRGB(40, 130, 60),
	Color3.fromRGB(110, 200, 90),
}
local FLOWERS = { Color3.fromRGB(255, 120, 180), Color3.fromRGB(255, 220, 70), Color3.fromRGB(180, 130, 255) }

local Greenhouse = {}

local function leaf(kit)
	return kit:pick(LEAVES)
end

function Greenhouse.room(kit)
	local L, H = kit.length, kit.height
	-- Daylight through the roof, crossed by metal frames.
	kit:glow(Vector3.new(19, 0.05, L), kit:at(0, H - 0.04, L / 2), GH_SKY)
	for d = 10, L - 10, 10 do
		kit:block(Vector3.new(20, 0.4, 0.4), kit:at(0, H - 0.3, d), GH_FRAME, Material.Metal)
	end
	for _, x in { -3.3, 3.3 } do
		kit:block(Vector3.new(0.4, 0.4, L), kit:at(x, H - 0.3, L / 2), GH_FRAME, Material.Metal)
	end
	-- Watering pipe with sprinkler heads along one ceiling corner.
	local pipeX = kit:wallX(kit:pick(SIDES), 0.8)
	kit:rod(L, 0.35, kit:at(pipeX, 12.8, L / 2) * ALONG_Z, GH_FRAME, Material.Metal)
	for d = 25, L - 15, 40 do
		kit:post(pipeX, 12.25, 0.55, 0.25, d, GH_FRAME, Material.Metal)
	end
	-- Vines hanging from the ceiling corners.
	for _, side in SIDES do
		for _ = 1, kit.rng:NextInteger(2, 3) do
			local d = kit:random(3, L - 3)
			local length = kit:random(2.5, 5)
			local x = kit:wallX(side, kit:random(0.4, 0.9))
			-- The model hangs 5.43 long; scaled to this vine's length and set against the wall.
			local vineScale = length / ModelStyles.HangingVine.Size.Y
			local vineX = kit:wallX(side, 0.1 + ModelStyles.HangingVine.Size.X * vineScale / 2)
			local vine = nil
			if Models.has("HangingVine") then -- (checked first so the part version draws the same random numbers)
				vine = kit:place("HangingVine", kit:at(vineX, H, d), {
					anchor = "ceiling",
					scale = vineScale,
					colors = { Plant = leaf(kit) },
				})
			end
			if not vine then
				kit:block(Vector3.new(0.15, length, 0.15), kit:at(x, H - length / 2, d), LEAVES[2], Material.Grass)
				if kit:chance(0.6) then
					kit:ball(0.7, kit:at(x, H - length, d), leaf(kit), Material.Grass)
				end
			end
		end
	end
end

-- A leafy Plant model standing on the floor (or a planter); `scale` 1.2 is 3.1 wide, still clear of the flight path.
local function plantModel(kit, x, y, d, scale)
	if not Models.has("Plant") then
		return nil
	end
	return kit:place("Plant", kit:at(x, y, d), { anchor = "floor", scale = scale, colors = { Plant = leaf(kit) } })
end

local function fern(kit, side, d)
	local x = kit:wallX(side, 1.3)
	local plantX = kit:wallX(side, 1.6) -- far enough off the wall for the model's width
	if plantModel(kit, plantX, 0, d - 1, 1.2) then
		plantModel(kit, plantX, 0, d + 1.2, 0.9)
		return
	end
	kit:ball(2.2, kit:at(x, 1, d - 1), leaf(kit), Material.Grass)
	kit:ball(1.6, kit:at(x, 0.7, d + 1.2), leaf(kit), Material.Grass)
	if kit:chance(0.5) then
		kit:ball(0.5, kit:at(x, 2.05, d - 1), kit:pick(FLOWERS), Material.Neon)
	end
end

local function planter(kit, side, d)
	local x = kit:wallX(side, 1.4)
	-- 1.5x: 6 long, 2.4 deep, 1.8 tall, the same footprint as the block version; two plants grow on top.
	if kit:wallProp("Planter", side, 0, 0, d, { anchor = "floor", scale = 1.5 }) then
		local soil = ModelStyles.Planter.Size.Y * 1.5 - 0.1
		local plantX = kit:wallX(side, 1.8)
		plantModel(kit, plantX, soil, d - 1.5, 1.2)
		plantModel(kit, plantX, soil, d + 1.5, 1.2)
		return
	end
	kit:block(Vector3.new(2.4, 1.4, 6), kit:at(x, 0.7, d), GH_POT)
	kit:post(x, 1.4, 2.8, 0.4, d, GH_TRUNK, Material.Wood)
	kit:ball(2.4, kit:at(x, 4.9, d), leaf(kit), Material.Grass)
	kit:ball(1.8, kit:at(x, 2.2, d + kit:pick({ -1.8, 1.8 })), leaf(kit), Material.Grass)
end

-- Glass box with a little plant inside, on a metal stand.
local function terrarium(kit, side, d)
	if not kit:canBreak() then
		return fern(kit, side, d)
	end
	local x = kit:wallX(side, 1.4)
	kit:block(Vector3.new(1.8, 2.4, 1.8), kit:at(x, 1.2, d), GH_FRAME, Material.Metal)
	local model = kit:breakable("Terrarium")
	kit:glass(model, Block, Vector3.new(1.7, 1.7, 1.7), kit:at(x, 3.25, d), kit:tint(0.6), 0.45)
	kit:inner(model, BallShape, Vector3.one * 0.9, kit:at(x, 2.85, d), leaf(kit), Material.Grass)
	kit:inner(model, BallShape, Vector3.one * 0.35, kit:at(x, 3.35, d), kit:pick(FLOWERS))
end

-- Breakable greenhouse wall panel with the garden glowing behind it.
local function wallPane(kit, side, d)
	if not kit:canBreak() then
		return fern(kit, side, d)
	end
	kit:glow(Vector3.new(0.1, 6.6, 6.6), kit:at(kit:wallX(side, 0.05), 6.5, d), GH_OUTSIDE)
	kit:block(Vector3.new(0.2, 6.8, 0.25), kit:at(kit:wallX(side, 0.2), 6.5, d), GH_FRAME, Material.Metal)
	kit:block(Vector3.new(0.2, 0.25, 6.8), kit:at(kit:wallX(side, 0.2), 6.5, d), GH_FRAME, Material.Metal)
	local pane = kit:glass(nil, Block, Vector3.new(0.15, 6.4, 6.4), kit:at(kit:wallX(side, 0.45), 6.5, d), kit:tint(0.55), 0.5)
	pane.Name = "GreenhousePane"
end

local function hangingBasket(kit, side, d)
	local x = kit:wallX(side, 2.2)
	kit:post(x, 11, 3, 0.1, d, GH_FRAME, Material.Metal)
	kit:post(x, 10.4, 0.6, 1.4, d, GH_TRUNK, Material.Wood)
	kit:ball(1.4, kit:at(x, 10.3, d), leaf(kit), Material.Grass)
	kit:block(Vector3.new(0.15, 2, 0.15), kit:at(x + side * 0.4, 9.6, d + 0.3), LEAVES[2], Material.Grass)
end

Greenhouse.features = {
	{ 3, planter },
	{ 2, terrarium },
	{ 2, wallPane },
	{ 2, fern },
	{ 1, hangingBasket },
	{ 3, nothing },
}

-- Leafy trellis arch with the zone name.
function Greenhouse.gate(kit, d)
	for _, side in SIDES do
		kit:block(Vector3.new(0.6, 12.6, 0.6), kit:at(side * 8, 6.3, d), GH_FRAME, Material.Metal)
		for _, y in { 3, 6.5, 10 } do
			kit:ball(1.6, kit:at(side * 8, y, d), leaf(kit), Material.Grass)
		end
		kit:ball(1.4, kit:at(side * 5.5, 13.2, d), leaf(kit), Material.Grass)
	end
	kit:block(Vector3.new(16.6, 0.6, 0.6), kit:at(0, 12.6, d), GH_FRAME, Material.Metal)
	local board = kit:block(Vector3.new(8, 1.2, 0.2), kit:at(0, 13.3, d - 0.5), GH_TRUNK, Material.Wood)
	nameplate(kit, board, Color3.fromRGB(230, 255, 220))
end

-- Void: windows to space, floating glass orbs and shards, glowing runes -------------------

local VOID_SPACE = Color3.fromRGB(12, 6, 24)
local VOID_ROCK = Color3.fromRGB(45, 35, 60)
local VOID_PLANETS = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 170, 70) }

local Void = {}

function Void.room(kit)
	local L, H = kit.length, kit.height
	-- Starry ceiling.
	kit:block(Vector3.new(19, 0.05, L), kit:at(0, H - 0.03, L / 2), VOID_SPACE)
	for _ = 1, 8 do
		local size = kit:random(0.12, 0.25)
		local color = if kit:chance(0.3) then kit.theme.Accent else WHITE
		kit:glow(Vector3.new(size, 0.04, size), kit:at(kit:random(-9, 9), H - 0.07, kit:random(1, L - 1)), color)
	end
	-- Glowing runes on the floor.
	for _, d in { 25, 55 } do
		kit:floorGlyph(GLYPHS[kit:pick(GLYPH_NAMES)], kit:random(-3, 3), d + kit:random(-4, 4), 0.8, kit.theme.Accent)
	end
end

-- A dark "window" into space with a far planet and drifting rocks.
local function spaceWindow(kit, side, d)
	kit:block(Vector3.new(0.1, 6, 6.5), kit:at(kit:wallX(side, 0.06), 6.5, d), VOID_SPACE)
	for _, y in { 3.4, 9.6 } do
		kit:glow(Vector3.new(0.2, 0.2, 6.9), kit:at(kit:wallX(side, 0.15), y, d), kit.theme.Accent)
	end
	kit:ball(0.9, kit:at(kit:wallX(side, 0.55), kit:random(5, 8), d + kit:random(-2, 2)), kit:pick(VOID_PLANETS), Material.Neon)
	local size = kit:random(0.6, 1.1)
	local spin = CFrame.Angles(kit:random(0, math.pi), kit:random(0, math.pi), kit:random(0, math.pi))
	local cframe = kit:at(kit:wallX(side, 1), kit:random(4, 9), d + kit:random(-2.5, 2.5)) * spin
	kit:block(Vector3.new(size, size * 0.7, size), cframe, VOID_ROCK)
end

local function rune(kit, side, d)
	kit:wallGlyph(GLYPHS[kit:pick(GLYPH_NAMES)], side, 0.1, d, kit:random(5, 8), kit:random(0.7, 0.9), 0.2, kit.theme.Accent)
end

local function floatingOrb(kit, side, d)
	if not kit:canBreak() then
		return rune(kit, side, d)
	end
	local size = kit:random(1.4, 2)
	orb(kit, kit:wallX(side, kit:random(1.6, 2.2)), kit:random(4, 10), d, size, kit:pick(VOID_PLANETS):Lerp(WHITE, 0.5))
end

-- Loose glass shards floating near the wall, each one breakable on its own.
local function shards(kit, side, d)
	if not kit:canBreak() then
		return rune(kit, side, d)
	end
	for _ = 1, kit.rng:NextInteger(2, 3) do
		if not kit:canBreak() then
			break
		end
		local size = Vector3.new(0.15, kit:random(1.4, 2.4), kit:random(0.6, 1.1))
		local spin = CFrame.Angles(kit:random(-0.6, 0.6), kit:random(0, math.pi), kit:random(-0.6, 0.6))
		local cframe = kit:at(kit:wallX(side, kit:random(1.3, 1.8)), kit:random(3.5, 10.5), d + kit:random(-3, 3)) * spin
		local shard = kit:glass(nil, Block, size, cframe, kit:tint(0.55), 0.3)
		shard.Name = "Shard"
	end
end

-- Floating rock with a crystal cluster growing on top.
local function crystalRock(kit, side, d)
	if not kit:canBreak() then
		return spaceWindow(kit, side, d)
	end
	local x = kit:wallX(side, 1.7)
	local y = kit:random(2.5, 7)
	kit:block(Vector3.new(2, 1.1, 2), kit:at(x, y, d) * CFrame.Angles(0, kit:random(0, math.pi), kit:random(-0.2, 0.2)), VOID_ROCK)
	crystalCluster(kit, x, y + 0.4, d, kit:tint(0.35))
end

Void.features = {
	{ 3, spaceWindow },
	{ 3, floatingOrb },
	{ 2, shards },
	{ 2, rune },
	{ 2, crystalRock },
	{ 3, nothing },
}

-- Glowing portal frame with the zone name and two guardian crystals.
function Void.gate(kit, d)
	for _, side in SIDES do
		kit:block(Vector3.new(2, kit.height, 1.2), kit:at(side * 9, kit.height / 2, d), VOID_SPACE)
		kit:glow(Vector3.new(0.5, 12.8, 0.5), kit:at(side * 7.6, 6.4, d), kit.theme.Accent)
		if kit:canBreak() then
			crystalCluster(kit, side * 8.3, 0, d + 3.5, kit:tint(0.35))
		end
	end
	kit:glow(Vector3.new(15.7, 0.5, 0.5), kit:at(0, 12.55, d), kit.theme.Accent)
	local top = kit:block(Vector3.new(16, 1.2, 1.2), kit:at(0, 13.4, d), VOID_SPACE)
	nameplate(kit, top, kit.theme.Accent)
	kit:glow(Vector3.new(15.2, 0.04, 0.5), kit:at(0, 0.02, d), kit.theme.Accent)
end

-- Dispatch --------------------------------------------------------------------------

local STYLES = {
	Lab = Lab,
	Neon = Neon,
	Temple = Temple,
	Greenhouse = Greenhouse,
	Void = Void,
}

function Decor.decorate(builder, room, info)
	local kit = newKit(builder, room, info)
	local style = STYLES[info.theme.Style] or STYLES.Lab

	style.room(kit)
	if info.isZoneStart then
		style.gate(kit, GATE_DEPTH)
	end

	-- One feature per wall bay, never the same twice in a row on one wall.
	local previous = {}
	for _, d in BAYS do
		if info.isZoneStart and d < GATE_DEPTH + 5 then
			continue -- the gate stands here
		end
		for _, side in SIDES do
			local feature = kit:pickWeighted(style.features)
			if feature == previous[side] then
				feature = kit:pickWeighted(style.features)
			end
			previous[side] = feature
			feature(kit, side, d)
		end
	end

	-- Every room gets a few things to smash.
	for _, d in GLOBE_SPOTS do
		if kit.breakables >= MIN_BREAKABLES then
			break
		end
		ceilingGlobe(kit, kit:random(-4, 4), d)
	end
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">GamepadAim</string>
            <string name="Source"><![CDATA[--[[
	Aiming with a controller (Xbox / PlayStation / a gamepad on PC).

	While the player's last input was a gamepad and a run is going, a crosshair
	shows on screen. Either thumbstick moves it (slowly at first, faster the
	longer the stick is held), and it drifts back to the middle when the stick
	is let go. RunController throws at it when R2 or A is pressed.

	The crosshair's ScreenGui covers the whole screen (no insets), so its
	position is in the same pixels as camera.ViewportSize: throw with
	camera:ViewportPointToRay, NOT ScreenPointToRay (that one expects positions
	measured below the Roblox top bar, like mouse/touch input).
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local GamepadAim = {}

-- Look (same "glass lab" palette as UI.luau)
local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local DISPLAY_ORDER = 18 -- above the main UI (10), below the tutorial (19/20)

local RETICLE_SIZE = 48 -- pixels
local TICK_LENGTH = 13
local TICK_WIDTH = 3
local CENTER_SIZE = 8

-- Feel
local DEADZONE = 0.18 -- stick movement smaller than this is ignored (worn sticks drift)
local SPEED = 0.95 -- full stick = this many screen-heights per second (before acceleration)
local CURVE = 1.7 -- > 1: small pushes move very slowly, for fine aiming
local ACCEL_START = 0.5 -- speed multiplier when the stick is first pushed...
local ACCEL_MAX = 1.7 -- ...growing to this...
local ACCEL_TIME = 0.6 -- ...after holding it this many seconds
local RECENTER_DELAY = 0.5 -- seconds after letting go before drifting back
local RECENTER_RATE = 1.2 -- how fast it drifts back (higher = faster)
local EDGE_MARGIN = 24 -- the crosshair stays this far inside the screen

local camera = workspace.CurrentCamera
local accentColor = Color3.fromRGB(90, 200, 255) -- replaced by setAccent with the zone color

local gui
local reticle
local reticleScale
local accentParts = {} -- frames tinted with the zone accent color

local usingGamepad = false
local activeGamepad = Enum.UserInputType.Gamepad1
local position -- Vector2, viewport pixels (nil until the first update)
local lastViewport = Vector2.zero
local holdTime = 0 -- seconds the stick has been pushed
local idleTime = 0 -- seconds since the stick was let go
local shown = false

local function isGamepad(inputType)
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

local function isPointer(inputType)
	return inputType == Enum.UserInputType.Touch
		or inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseButton3
		or inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.MouseWheel
end

local function onInputType(inputType)
	if isGamepad(inputType) then
		usingGamepad = true
		activeGamepad = inputType
	elseif isPointer(inputType) then
		usingGamepad = false
	end
	-- Keyboard / text input / focus changes leave it as it was.
end

local function new(className, props)
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	instance.Parent = props.Parent
	return instance
end

-- One crosshair arm: an ink bar with a paper outline, so it reads on bright
-- glass and on dark walls alike.
local function tick(size, anchor, offset)
	local bar = new("Frame", {
		AnchorPoint = anchor,
		Position = UDim2.new(0.5, offset.X, 0.5, offset.Y),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Parent = reticle,
	})
	new("UIStroke", { Color = PAPER, Thickness = 1, Parent = bar })
	return bar
end

-- Hard ink corner bracket (blueprint registration mark).
local function bracket(anchor, where)
	local holder = new("Frame", {
		AnchorPoint = anchor,
		Position = where,
		Size = UDim2.fromOffset(9, 9),
		BackgroundTransparency = 1,
		Parent = reticle,
	})
	local horizontal = new("Frame", {
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.fromScale(0, anchor.Y),
		AnchorPoint = Vector2.new(0, anchor.Y),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Parent = holder,
	})
	local vertical = new("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.fromScale(anchor.X, 0),
		AnchorPoint = Vector2.new(anchor.X, 0),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Parent = holder,
	})
	horizontal.BackgroundColor3 = accentColor
	vertical.BackgroundColor3 = accentColor
	table.insert(accentParts, horizontal)
	table.insert(accentParts, vertical)
end

local function buildGui()
	gui = Instance.new("ScreenGui")
	gui.Name = "GamepadAim"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = DISPLAY_ORDER
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	-- Whole screen, top bar included: offsets here are viewport pixels.
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.Enabled = false

	reticle = new("Frame", {
		Name = "Reticle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(RETICLE_SIZE, RETICLE_SIZE),
		BackgroundTransparency = 1,
		Active = false,
		Parent = gui,
	})
	reticleScale = new("UIScale", { Parent = reticle })

	-- Four arms with a gap in the middle so the target stays visible.
	local gap = CENTER_SIZE / 2 + 4
	tick(Vector2.new(TICK_WIDTH, TICK_LENGTH), Vector2.new(0.5, 1), Vector2.new(0, -gap))
	tick(Vector2.new(TICK_WIDTH, TICK_LENGTH), Vector2.new(0.5, 0), Vector2.new(0, gap))
	tick(Vector2.new(TICK_LENGTH, TICK_WIDTH), Vector2.new(1, 0.5), Vector2.new(-gap, 0))
	tick(Vector2.new(TICK_LENGTH, TICK_WIDTH), Vector2.new(0, 0.5), Vector2.new(gap, 0))

	-- Zone-colored corner brackets.
	bracket(Vector2.new(0, 0), UDim2.fromScale(0, 0))
	bracket(Vector2.new(1, 0), UDim2.fromScale(1, 0))
	bracket(Vector2.new(0, 1), UDim2.fromScale(0, 1))
	bracket(Vector2.new(1, 1), UDim2.fromScale(1, 1))

	-- Center: small accent square with an ink hairline.
	local center = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(CENTER_SIZE, CENTER_SIZE),
		BackgroundColor3 = accentColor,
		BorderSizePixel = 0,
		Parent = reticle,
	})
	new("UIStroke", { Color = INK, Thickness = 1.5, Parent = center })
	table.insert(accentParts, center)

	-- Annotation tag: which button throws.
	local tag = new("TextLabel", {
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(1, 4, 1, 2),
		Size = UDim2.fromOffset(52, 14),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		Font = Enum.Font.RobotoMono,
		Text = "R2 THROW",
		TextColor3 = INK,
		TextSize = 9,
		Parent = reticle,
	})
	new("UIStroke", { Color = INK, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tag })

	gui.Parent = player:WaitForChild("PlayerGui")
end

local function viewportSize()
	local size = camera.ViewportSize
	if size.X < 1 or size.Y < 1 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function clampToScreen(point, size)
	local margin = math.min(EDGE_MARGIN, size.X / 4, size.Y / 4)
	return Vector2.new(math.clamp(point.X, margin, size.X - margin), math.clamp(point.Y, margin, size.Y - margin))
end

-- The strongest thumbstick push right now (screen direction: y grows downward),
-- with the deadzone taken out. Zero vector when both sticks rest.
local function readSticks()
	local best = Vector2.zero
	local ok, state = pcall(UserInputService.GetGamepadState, UserInputService, activeGamepad)
	if not ok then
		return best
	end
	for _, input in state do
		if input.KeyCode == Enum.KeyCode.Thumbstick1 or input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local stick = Vector2.new(input.Position.X, -input.Position.Y)
			if stick.Magnitude > best.Magnitude then
				best = stick
			end
		end
	end
	local magnitude = best.Magnitude
	if magnitude <= DEADZONE then
		return Vector2.zero
	end
	-- Rescale so movement starts smoothly at the deadzone edge.
	local strength = math.min(1, (magnitude - DEADZONE) / (1 - DEADZONE))
	return best.Unit * strength
end

-- Called once per frame by RunController. running: a run is going (throws allowed).
function GamepadAim.update(dt, running)
	if not gui then
		return
	end
	local size = viewportSize()
	local centre = size / 2
	if not position then
		position = centre
	elseif size ~= lastViewport and lastViewport.X > 0 then
		-- Screen rotated / resized: keep the same relative spot.
		position = Vector2.new(position.X / lastViewport.X * size.X, position.Y / lastViewport.Y * size.Y)
	end
	lastViewport = size

	local visible = running and usingGamepad
	if visible ~= shown then
		shown = visible
		gui.Enabled = visible
		if visible then
			-- Every run starts aiming straight ahead.
			position = centre
			holdTime, idleTime = 0, 0
		end
	end
	if not visible then
		return
	end

	local stick = readSticks()
	if stick.Magnitude > 0 then
		holdTime += dt
		idleTime = 0
		local accel = ACCEL_START + (ACCEL_MAX - ACCEL_START) * math.min(1, holdTime / ACCEL_TIME)
		local pixelsPerSecond = SPEED * size.Y * accel * stick.Magnitude ^ CURVE
		position += stick.Unit * pixelsPerSecond * dt
	else
		holdTime = 0
		idleTime += dt
		if idleTime > RECENTER_DELAY then
			-- Frame-rate independent ease back to the middle.
			position = position:Lerp(centre, 1 - math.exp(-RECENTER_RATE * dt))
		end
	end
	position = clampToScreen(position, size)
	reticle.Position = UDim2.fromOffset(position.X, position.Y)
end

-- Is the crosshair on screen (gamepad player, run going)?
function GamepadAim.isShown()
	return shown
end

-- Was the last input from a gamepad?
function GamepadAim.usingGamepad()
	return usingGamepad
end

-- Where to throw, in viewport pixels (use camera:ViewportPointToRay).
function GamepadAim.viewportPosition()
	return clampToScreen(position or viewportSize() / 2, viewportSize())
end

-- Little kick on the crosshair when a ball is thrown.
function GamepadAim.pulse()
	if not reticleScale then
		return
	end
	reticleScale.Scale = 1.3
	TweenService:Create(reticleScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
end

-- Zone accent color for the corner brackets and center (RunController's applyTheme).
function GamepadAim.setAccent(color)
	accentColor = color
	for _, part in accentParts do
		part.BackgroundColor3 = color
	end
end

local started = false
function GamepadAim.start()
	if started then
		return
	end
	started = true
	buildGui()

	onInputType(UserInputService:GetLastInputType())
	-- Consoles have no mouse or touch: start in gamepad mode even before any press.
	if
		UserInputService.GamepadEnabled
		and not UserInputService.TouchEnabled
		and not UserInputService.MouseEnabled
	then
		usingGamepad = true
	end
	UserInputService.LastInputTypeChanged:Connect(onInputType)

	-- The camera object can be replaced (rare); keep following the current one.
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		camera = workspace.CurrentCamera or camera
	end)
end

return GamepadAim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">LeaveGift</string>
            <string name="Source"><![CDATA[--[[
	"Wait! A free gift for you."

	When a player opens the Roblox menu (Esc / the Roblox button / Start on a
	controller), they might be about to leave. If they close it again and come
	back, we surprise them with a free gift (Config.LeaveGift.Rewards, taking
	turns).

	Rules:
	  * Nothing happens while the menu is open, so leaving is never blocked or slowed.
	  * Only after Config.LeaveGift.MinPlaySeconds of play this session, and only
	    when the server's cooldown (LeaveGiftNext attribute) has run out.
	  * At most once per cooldown window (declining means no more popups this session).
	  * Never in the middle of a run: it waits for the menu / game over screen.
	The server checks everything again when CLAIM is pressed (Shop "ClaimLeaveGift").
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Sounds = require(script.Parent.Sounds)

local player = Players.LocalPlayer

local LeaveGift = {}

-- Look (same "glass lab" palette as UI.luau)
local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local GREY = Color3.fromRGB(112, 108, 100)
local WHITE = Color3.new(1, 1, 1)
local FONT_NUM = Enum.Font.Michroma
local FONT_LABEL = Enum.Font.RobotoMono

local DISPLAY_ORDER = 50 -- above the main UI (10) and the tutorial (20)
local REF_W, REF_H = 600, 340 -- same reference sheet as UI.luau
local SCALE_MIN, SCALE_MAX = 0.8, 2
local CARD_W, CARD_H = 320, 228
local SHADOW = 6
local SHARDS = 28
local CHECK_INTERVAL = 0.5 -- seconds between checks while a gift is waiting for the run to end

local settings = Config.LeaveGift
local sessionStart = os.clock()

local options = {} -- { claim = function() -> (ok, message), canShow = function() -> bool }
local accentColor = Config.Themes[1].Accent
local accentTargets = {} -- instance -> property

local gui, wash, fitScale, popScale, burstLayer
local rewardLabel, claimButton, claimLabel, claimPulseScale, noThanksButton, statusLabel

local menuWasOpened = false
local pending = false -- came back from the menu during a run: show when it ends
local showing = false
local busy = false
local shownWindow = nil -- LeaveGiftNext value when we last showed it (once per window)
local pulseTween = nil

-- Helpers ------------------------------------------------------------------------

local function new(className, props)
	local instance = Instance.new(className)
	if instance:IsA("GuiObject") then
		instance.BorderSizePixel = 0
	end
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	instance.Parent = props.Parent
	return instance
end

local function stroke(parent, thickness, color)
	return new("UIStroke", {
		Thickness = thickness,
		Color = color or INK,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = parent,
	})
end

local function label(props)
	local merged = {
		BackgroundTransparency = 1,
		Font = FONT_LABEL,
		TextColor3 = INK,
		TextSize = 10,
		Text = "",
	}
	for key, value in props do
		merged[key] = value
	end
	return new("TextLabel", merged)
end

local function accent(instance, property)
	instance[property] = accentColor
	accentTargets[instance] = property
	return instance
end

local function tween(instance, time, props, style, direction)
	local t = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function isGamepad(inputType)
	return string.sub(inputType.Name, 1, 7) == "Gamepad"
end

-- Eligibility --------------------------------------------------------------------

local function rewards()
	return if settings and type(settings.Rewards) == "table" then settings.Rewards else {}
end

local function nextReward()
	local list = rewards()
	local index = tonumber(player:GetAttribute("LeaveGiftIndex"))
	if #list == 0 or not index then
		return nil
	end
	return list[math.floor(index) % #list + 1]
end

local function isEligible()
	if not settings or showing then
		return false
	end
	local nextTime = tonumber(player:GetAttribute("LeaveGiftNext"))
	if not nextTime or not nextReward() then
		return false -- data not loaded yet, or no rewards set up
	end
	if shownWindow == nextTime then
		return false -- already offered in this window (claimed windows move LeaveGiftNext on)
	end
	if os.clock() - sessionStart < settings.MinPlaySeconds then
		return false
	end
	return workspace:GetServerTimeNow() >= nextTime
end

-- Popup --------------------------------------------------------------------------

-- Confetti: little glass shards (triangles) flying out of the card.
local function burst(count)
	local colors = { accentColor, INK, WHITE, accentColor }
	for i = 1, count do
		local size = math.random(6, 14)
		local shard = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size * (0.6 + math.random() * 0.8)),
			Rotation = math.random(0, 359),
			BackgroundColor3 = colors[i % #colors + 1],
			ZIndex = 5,
			Parent = burstLayer,
		})
		-- A diagonal hard-edged gradient turns the square into a triangle.
		new("UIGradient", {
			Rotation = 45,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.499, 0),
				NumberSequenceKeypoint.new(0.501, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = shard,
		})

		local angle = (i / count) * math.pi * 2 + (math.random() - 0.5) * 0.5
		local distance = 140 + math.random() * 140
		local target = Vector2.new(math.cos(angle) * distance, math.sin(angle) * distance * 0.75 - 30)
		local time = 0.7 + math.random() * 0.4
		tween(shard, time, {
			Position = UDim2.new(0.5, target.X, 0.5, target.Y),
			Rotation = shard.Rotation + math.random(-360, 360),
		}, Enum.EasingStyle.Quad)
		task.delay(time * 0.5, function()
			if shard.Parent then
				tween(shard, time * 0.5, { BackgroundTransparency = 1 }, Enum.EasingStyle.Linear)
			end
		end)
		task.delay(time + 0.05, function()
			shard:Destroy()
		end)
	end
end

local function refit()
	if not gui then
		return
	end
	local size = gui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return
	end
	fitScale.Scale = math.clamp(math.min(size.X / REF_W, size.Y / REF_H), SCALE_MIN, SCALE_MAX)
end

local function stopPulse()
	if pulseTween then
		pulseTween:Cancel()
		pulseTween = nil
	end
	if claimPulseScale then
		claimPulseScale.Scale = 1
	end
end

local function hide()
	if not showing then
		return
	end
	showing = false
	busy = false
	stopPulse()
	-- Give gamepad selection back if it was on our buttons.
	local selected = GuiService.SelectedObject
	if selected and gui and selected:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
	tween(wash, 0.2, { BackgroundTransparency = 1 })
	local closing = tween(popScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	closing.Completed:Once(function()
		if not showing then
			gui.Enabled = false
		end
	end)
end

local function show()
	local reward = nextReward()
	if not reward or not gui then
		return
	end
	showing = true
	busy = false
	shownWindow = tonumber(player:GetAttribute("LeaveGiftNext"))

	rewardLabel.Text = string.upper(tostring(reward.Text or "FREE GIFT"))
	claimLabel.Text = "CLAIM"
	statusLabel.Text = ""
	gui.Enabled = true
	refit()

	-- Punchy pop-in: overshoot, a little wobble, then shards everywhere.
	wash.BackgroundTransparency = 1
	tween(wash, 0.25, { BackgroundTransparency = 0.3 })
	popScale.Scale = 0.3
	tween(popScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	local pop = popScale.Parent
	pop.Rotation = -6
	tween(pop, 0.5, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	Sounds.play("Gift")
	burst(SHARDS)

	-- The CLAIM button breathes to draw the eye.
	stopPulse()
	pulseTween = TweenService:Create(
		claimPulseScale,
		TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 0.45),
		{ Scale = 1.06 }
	)
	pulseTween:Play()

	if isGamepad(UserInputService:GetLastInputType()) then
		GuiService.SelectedObject = claimButton
	end
end

local function claim()
	if not showing or busy then
		return
	end
	busy = true
	stopPulse()
	claimLabel.Text = "..."
	local ok, message = false, "Try again later"
	if options.claim then
		ok, message = options.claim()
	end
	if not showing then
		return -- closed while we were waiting
	end
	if ok then
		-- The server's "Reward" toast says what was given.
		claimLabel.Text = "CLAIMED!"
		burst(SHARDS)
		task.delay(0.7, hide)
	else
		claimLabel.Text = "CLAIM"
		statusLabel.Text = string.upper(tostring(message or "Try again later"))
		task.delay(1.8, hide)
	end
end

local function buildGui()
	gui = new("ScreenGui", {
		Name = "LeaveGift",
		ResetOnSpawn = false,
		DisplayOrder = DISPLAY_ORDER,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		Enabled = false,
	})
	gui.ScreenInsets = Enum.ScreenInsets.None -- the wash covers the whole screen

	-- Paper wash over the game (also stops taps going through to throws).
	wash = new("TextButton", {
		Name = "Wash",
		AutoButtonColor = false,
		Selectable = false,
		Text = "",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.3,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})

	local fitHolder = new("Frame", {
		Name = "Fit",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	fitScale = new("UIScale", { Parent = fitHolder })

	burstLayer = new("Frame", {
		Name = "Burst",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = fitHolder,
	})

	local popHolder = new("Frame", {
		Name = "Pop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = fitHolder,
	})
	popScale = new("UIScale", { Parent = popHolder })

	-- Hard ink shadow + the paper card.
	new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(SHADOW, SHADOW),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = INK,
		Parent = popHolder,
	})
	local card = new("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PAPER,
		Active = true,
		Parent = popHolder,
	})
	stroke(card, 2)

	-- Header strip.
	local header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = INK,
		Parent = card,
	})
	label({
		Text = "FIG. 00 / SPECIAL DELIVERY",
		TextSize = 9,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(0.7, -10, 1, 0),
		Parent = header,
	})
	accent(label({
		Text = "FREE",
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromScale(0.7, 0),
		Size = UDim2.new(0.3, -10, 1, 0),
		Parent = header,
	}), "TextColor3")

	-- Title.
	label({
		Text = "WAIT!",
		Font = FONT_NUM,
		TextSize = 32,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 36),
		Parent = card,
	})
	label({
		Text = "A FREE GIFT FOR YOU",
		Font = FONT_NUM,
		TextSize = 12,
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = card,
	})

	-- The reward plate: paper with an ink hairline and a zone-accent edge.
	local plate = new("Frame", {
		Name = "Reward",
		Position = UDim2.fromOffset(20, 94),
		Size = UDim2.new(1, -40, 0, 42),
		BackgroundColor3 = PAPER,
		Parent = card,
	})
	stroke(plate, 1.5)
	accent(new("Frame", {
		Name = "Edge",
		Size = UDim2.new(0, 8, 1, 0),
		Parent = plate,
	}), "BackgroundColor3")
	label({
		Text = "ITEM 01",
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.fromOffset(60, 10),
		Parent = plate,
	})
	rewardLabel = label({
		Font = FONT_NUM,
		TextSize = 14,
		TextWrapped = true,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -22, 1, -10),
		Parent = plate,
	})

	-- Big CLAIM button: zone-accent face on a hard ink shadow, breathing.
	local claimHolder = new("Frame", {
		Name = "Claim",
		Position = UDim2.fromOffset(20, 146),
		Size = UDim2.new(1, -40, 0, 46),
		BackgroundTransparency = 1,
		Parent = card,
	})
	claimPulseScale = new("UIScale", { Parent = claimHolder })
	new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundColor3 = INK,
		Parent = claimHolder,
	})
	claimButton = accent(new("TextButton", {
		Name = "Face",
		AutoButtonColor = false,
		Selectable = true,
		Text = "",
		Size = UDim2.new(1, -4, 1, -4),
		Parent = claimHolder,
	}), "BackgroundColor3")
	stroke(claimButton, 2)
	claimLabel = label({
		Text = "CLAIM",
		Font = FONT_NUM,
		TextSize = 20,
		TextColor3 = INK,
		Size = UDim2.fromScale(1, 1),
		Parent = claimButton,
	})
	claimButton.MouseButton1Down:Connect(function()
		claimButton.Position = UDim2.fromOffset(2, 2)
	end)
	claimButton.MouseButton1Up:Connect(function()
		claimButton.Position = UDim2.new()
	end)
	claimButton.MouseLeave:Connect(function()
		claimButton.Position = UDim2.new()
	end)
	claimButton.Activated:Connect(function()
		claimButton.Position = UDim2.new()
		task.spawn(claim)
	end)

	-- Small "no thanks" (a comfortable tap area, quiet text).
	noThanksButton = new("TextButton", {
		Name = "NoThanks",
		AutoButtonColor = false,
		Selectable = true,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 196),
		Size = UDim2.fromOffset(140, 26),
		Font = FONT_LABEL,
		Text = "NO THANKS",
		TextSize = 10,
		TextColor3 = GREY,
		Parent = card,
	})
	noThanksButton.Activated:Connect(function()
		if not busy then
			hide()
		end
	end)
	claimButton.NextSelectionDown = noThanksButton
	noThanksButton.NextSelectionUp = claimButton

	-- Error line (e.g. "COME BACK LATER") under the plate.
	statusLabel = label({
		Text = "",
		TextSize = 8,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(0, 136),
		Size = UDim2.new(1, 0, 0, 10),
		Parent = card,
	})

	gui.Parent = player:WaitForChild("PlayerGui")
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	refit()
end

-- Shows the gift now if everything allows it; otherwise keeps it waiting
-- (pending) only while it's still deserved.
local function tryShow()
	if not pending then
		return
	end
	if not isEligible() then
		pending = false
		return
	end
	if GuiService.MenuIsOpen then
		return -- never while the Roblox menu is up
	end
	if options.canShow and not options.canShow() then
		return -- mid-run: wait for the menu / game over screen
	end
	pending = false
	show()
end

-- Public -------------------------------------------------------------------------

-- Zone accent color (RunController's applyTheme).
function LeaveGift.setAccent(color)
	accentColor = color
	for instance, property in accentTargets do
		if instance.Parent then
			instance[property] = color
		else
			accentTargets[instance] = nil
		end
	end
end

-- opts.claim(): asks the server (Shop "ClaimLeaveGift"), returns ok, message.
-- opts.canShow(): false while a run is going.
local started = false
function LeaveGift.start(opts)
	if started then
		return
	end
	started = true
	options = opts or {}
	if not settings then
		return
	end
	buildGui()

	-- Opening the menu does nothing at all (leaving stays instant).
	GuiService.MenuOpened:Connect(function()
		menuWasOpened = true
	end)
	GuiService.MenuClosed:Connect(function()
		if not menuWasOpened then
			return
		end
		menuWasOpened = false
		if isEligible() then
			pending = true
			-- Next frame, so the menu has fully gone.
			task.defer(tryShow)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			if pending then
				tryShow()
			end
		end
	end)
end

return LeaveGift
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">LightingFx</string>
            <string name="Source"><![CDATA[--[[
	Realistic lighting for each zone, plus real lights inside every room.

	- Each zone style has its own time of day, ambient light, atmosphere haze,
	  color grading and bloom. Crossing a checkpoint fades smoothly to the next.
	- lightRoom() turns a room's biggest glowing (Neon) parts into actual light
	  sources and lets decorations cast shadows, so nothing looks flat.
	Requires Lighting.Technology = Future in the place (set in place.project.json).
	Everything here runs on the player's own device only.
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LightingFx = {}

local FADE = TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local LIGHTS_PER_ROOM = 4
local SHADOW_LIGHTS_PER_ROOM = 1
local SHADOW_CASTER_MAX_SIZE = 15 -- the room shell (80 studs long) never casts
local SHADOW_CASTER_MIN_SIZE = 1.5 -- tiny details (seams, trim, glyph bars) never cast either
-- Phones and tablets: no shadow-casting lights (too heavy for their GPUs).
local TOUCH_ONLY = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Per zone style. Colors are Color3, numbers are the Lighting/effect properties.
local PRESETS = {
	Lab = {
		ClockTime = 14,
		Brightness = 2.4,
		Ambient = Color3.fromRGB(105, 112, 125),
		OutdoorAmbient = Color3.fromRGB(150, 158, 170),
		ExposureCompensation = 0.1,
		Atmosphere = { Density = 0.38, Offset = 0.1, Haze = 1, Glare = 0 },
		Grade = { Brightness = 0.02, Contrast = 0.08, Saturation = 0.05, TintColor = Color3.fromRGB(240, 248, 255) },
		Bloom = { Intensity = 0.55, Size = 24, Threshold = 1.1 },
		LightBrightness = 1.4,
		LightRange = 16,
	},
	Neon = {
		ClockTime = 0,
		Brightness = 0.4,
		Ambient = Color3.fromRGB(38, 36, 58),
		OutdoorAmbient = Color3.fromRGB(50, 45, 75),
		ExposureCompensation = 0.2,
		Atmosphere = { Density = 0.45, Offset = 0.05, Haze = 2, Glare = 0.3 },
		Grade = { Brightness = 0, Contrast = 0.18, Saturation = 0.22, TintColor = Color3.fromRGB(255, 235, 250) },
		Bloom = { Intensity = 1.1, Size = 30, Threshold = 0.85 },
		LightBrightness = 2.2,
		LightRange = 18,
	},
	Temple = {
		ClockTime = 17.6,
		Brightness = 2,
		Ambient = Color3.fromRGB(120, 88, 60),
		OutdoorAmbient = Color3.fromRGB(165, 125, 90),
		ExposureCompensation = 0,
		Atmosphere = { Density = 0.42, Offset = 0.15, Haze = 2.2, Glare = 0.6 },
		Grade = { Brightness = 0.01, Contrast = 0.12, Saturation = 0.12, TintColor = Color3.fromRGB(255, 236, 214) },
		Bloom = { Intensity = 0.8, Size = 28, Threshold = 0.95 },
		LightBrightness = 1.8,
		LightRange = 16,
	},
	Greenhouse = {
		ClockTime = 12.5,
		Brightness = 3,
		Ambient = Color3.fromRGB(95, 120, 95),
		OutdoorAmbient = Color3.fromRGB(150, 175, 145),
		ExposureCompensation = 0,
		Atmosphere = { Density = 0.4, Offset = 0.2, Haze = 2.5, Glare = 0.2 },
		Grade = { Brightness = 0.02, Contrast = 0.06, Saturation = 0.15, TintColor = Color3.fromRGB(245, 255, 235) },
		Bloom = { Intensity = 0.5, Size = 26, Threshold = 1.15 },
		LightBrightness = 1.2,
		LightRange = 14,
	},
	Void = {
		ClockTime = 0,
		Brightness = 0.25,
		Ambient = Color3.fromRGB(48, 30, 70),
		OutdoorAmbient = Color3.fromRGB(60, 40, 90),
		ExposureCompensation = 0.25,
		Atmosphere = { Density = 0.5, Offset = 0, Haze = 1.5, Glare = 0.4 },
		Grade = { Brightness = 0, Contrast = 0.2, Saturation = 0.18, TintColor = Color3.fromRGB(240, 225, 255) },
		Bloom = { Intensity = 1.3, Size = 34, Threshold = 0.8 },
		LightBrightness = 2.4,
		LightRange = 18,
	},
}

local atmosphere
local grade
local bloom
local sunRays

local function presetFor(theme)
	return PRESETS[theme and theme.Style or "Lab"] or PRESETS.Lab
end

-- Replaces whatever the place had (the Baseplate template ships its own
-- Atmosphere/Bloom) with our own effects.
function LightingFx.setup()
	for _, child in Lighting:GetChildren() do
		if
			child:IsA("Atmosphere")
			or child:IsA("BloomEffect")
			or child:IsA("ColorCorrectionEffect")
			or child:IsA("SunRaysEffect")
			or child:IsA("DepthOfFieldEffect")
		then
			child:Destroy()
		end
	end

	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.EnvironmentDiffuseScale = 1 -- PBR ambient from the sky
	Lighting.EnvironmentSpecularScale = 1 -- reflections on glass, metal, marble

	atmosphere = Instance.new("Atmosphere")
	atmosphere.Parent = Lighting

	grade = Instance.new("ColorCorrectionEffect")
	grade.Parent = Lighting

	bloom = Instance.new("BloomEffect")
	bloom.Parent = Lighting

	sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.04
	sunRays.Spread = 0.6
	sunRays.Parent = Lighting

	LightingFx.applyTheme(nil, true)
end

-- Fades the whole look to a zone's preset (instant = true skips the fade).
function LightingFx.applyTheme(theme, instant)
	if not atmosphere then
		return
	end
	local preset = presetFor(theme)

	local fogColor = if theme then theme.Fog else Color3.fromRGB(215, 230, 245)
	local function set(object, goal)
		if instant then
			for property, value in goal do
				object[property] = value
			end
		else
			TweenService:Create(object, FADE, goal):Play()
		end
	end

	set(Lighting, {
		ClockTime = preset.ClockTime,
		Brightness = preset.Brightness,
		Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient,
		ExposureCompensation = preset.ExposureCompensation,
	})
	set(atmosphere, {
		Density = preset.Atmosphere.Density,
		Offset = preset.Atmosphere.Offset,
		Haze = preset.Atmosphere.Haze,
		Glare = preset.Atmosphere.Glare,
		Color = fogColor,
		Decay = fogColor:Lerp(Color3.new(0, 0, 0), 0.35),
	})
	set(grade, preset.Grade)
	set(bloom, preset.Bloom)
end

-- Turns the room's biggest glowing parts into real lights and lets decorations
-- cast shadows. Call after the room (and its decorations) are built.
function LightingFx.lightRoom(roomFolder, theme)
	local preset = presetFor(theme)
	local glowing = {}
	for _, part in roomFolder:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		local size = part.Size
		local kind = part:GetAttribute("Kind")

		if part.Material == Enum.Material.Neon and part.Transparency < 0.8 then
			local area = size.X * size.Y + size.Y * size.Z + size.X * size.Z
			if area > 1.5 and kind ~= "Glass" and kind ~= "Crystal" then
				table.insert(glowing, { part = part, area = area })
			end
		elseif
			(kind == "Wall" or kind == "Prop")
			and math.max(size.X, size.Y, size.Z) < SHADOW_CASTER_MAX_SIZE
			and size.Magnitude > SHADOW_CASTER_MIN_SIZE
			and part.Transparency < 0.5
		then
			part.CastShadow = true
		end
	end

	table.sort(glowing, function(a, b)
		return a.area > b.area
	end)

	-- Spread lights out: skip glowing parts too close to one already lit.
	local lit = {}
	for _, entry in glowing do
		if #lit >= LIGHTS_PER_ROOM then
			break
		end
		local position = entry.part.Position
		local tooClose = false
		for _, other in lit do
			if (other.Position - position).Magnitude < 12 then
				tooClose = true
				break
			end
		end
		if not tooClose then
			local light = Instance.new("PointLight")
			light.Color = entry.part.Color
			light.Brightness = preset.LightBrightness
			light.Range = preset.LightRange
			light.Shadows = not TOUCH_ONLY and #lit < SHADOW_LIGHTS_PER_ROOM
			light.Parent = entry.part
			table.insert(lit, entry.part)
		end
	end
end

return LightingFx
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="27">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point. Everything interesting is in RunController.
]]

local RunController = require(script.Parent.RunController)

RunController.start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Models</string>
            <string name="Source"><![CDATA[--[[
	Places the Blender models loaded by the server (ReplicatedStorage.ModelLibrary).
	If a model isn't uploaded yet (ID 0 in Config.Models) or hasn't loaded,
	Models.place returns nil and the caller builds its block version instead.

	Model parts are named <Model>_<Role> (Glass, Metal, Wood, Stone, Neon, Plant, Body).
	Each role gets its color/material from Shared.ModelStyles, overridable per call.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModelStyles = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelStyles"))

local Models = {}

local function library()
	return ReplicatedStorage:FindFirstChild("ModelLibrary")
end

function Models.has(name)
	local folder = library()
	return folder ~= nil and folder:FindFirstChild(name) ~= nil
end

local function roleOf(part)
	return part.Name:match("_(%w+)$") or "Body"
end

--[[
	options = {
		kind = "Wall" | "Prop",            -- Prop = breakable decoration
		anchor = "floor" | "ceiling" | "center",  -- which point of the model sits at `cframe`
		scale = number?,
		colors = { [Role] = Color3 }?,     -- e.g. tint glass with the zone accent
	}
]]
function Models.place(name, parent, cframe, options)
	local folder = library()
	local template = folder and folder:FindFirstChild(name)
	if not template then
		return nil
	end
	options = options or {}

	local model = template:Clone()
	local style = ModelStyles[name] or {}
	local kind = options.kind or (if style.Breakable then "Prop" else "Wall")

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local role = roleOf(part)
			local roleStyle = style[role]
			if type(roleStyle) == "table" and roleStyle.Material then
				part.Color = roleStyle.Color
				part.Material = roleStyle.Material
				part.Transparency = roleStyle.Transparency
			end
			if options.colors and options.colors[role] then
				part.Color = options.colors[role]
			end
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CastShadow = false
			part:SetAttribute("Kind", kind)
		end
	end
	if kind == "Prop" then
		model:SetAttribute("Breakable", true)
	end

	-- Imported FBX units can come in at the wrong scale; fit the model to its
	-- true height from the manifest, then apply any extra scale asked for.
	local scale = options.scale or 1
	if style.Size then
		local _, importedSize = model:GetBoundingBox()
		if importedSize.Y > 0.01 then
			scale *= style.Size.Y / importedSize.Y
		end
	end
	if math.abs(scale - 1) > 0.001 then
		model:ScaleTo(model:GetScale() * scale)
	end

	-- Line the chosen anchor point of the bounding box up with `cframe`.
	model:PivotTo(CFrame.new(model:GetPivot().Position) * cframe.Rotation)
	local boxCFrame, boxSize = model:GetBoundingBox()
	local anchorOffset = Vector3.zero
	local anchor = options.anchor or style.Anchor
	if anchor == "floor" then
		anchorOffset = Vector3.new(0, boxSize.Y / 2, 0)
	elseif anchor == "ceiling" then
		anchorOffset = Vector3.new(0, -boxSize.Y / 2, 0)
	end
	local target = cframe.Position + anchorOffset
	model:PivotTo(model:GetPivot() + (target - boxCFrame.Position))

	model.Parent = parent
	return model
end

return Models
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RunController</string>
            <string name="Source"><![CDATA[--[[
	The game itself: moves the camera down the corridor, throws balls,
	smashes glass, counts crystals and handles game over / revive.
	Runs entirely on the player's device. The server only gets the distance and
	a few run stats (glass smashed, crystals, props, best multiball), and works
	out gems / XP / missions itself.

	Boosts (Config.Boosts): picked in the menu or bought mid-run. The server
	confirms which ones really started (Progress "BoostsActivated", or the
	"UseBoostNow" answer for a Robux boost bought mid-run) and only those are
	switched on here.
	  Shield     - the next crash costs no balls (buying more stacks: one per crash)
	  Magnet     - crystals near the camera fly to you for a few seconds
	  MegaBall   - the next few throws are giant balls that smash through everything
	  SlowMo     - the world (camera, balls) runs slower for a few seconds
	  DoubleGems - handled by the server, only shown here
]]

local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local GamepadAim = require(script.Parent.GamepadAim)
local LeaveGift = require(script.Parent.LeaveGift)
local Shatter = require(script.Parent.Shatter)
local Sounds = require(script.Parent.Sounds)
local TrackBuilder = require(script.Parent.TrackBuilder)
local LightingFx = require(script.Parent.LightingFx)
local Tutorial = require(script.Parent.Tutorial)
local UI = require(script.Parent.UI)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local ORIGIN = Config.TRACK_ORIGIN
local FORWARD = Vector3.new(0, 0, -1)
local CRASH_MARGIN = 0.8 -- how close to a pane's edge still counts as hitting it
local GRAVITY = Vector3.new(0, -Config.BALL_GRAVITY, 0)
local BALL_STEPS = 3 -- collision checks per ball per frame
local BEHIND_CAMERA = 15 -- normal balls this far behind the camera are removed
local TUTORIAL_MIN_BALL_SPEED = 0.5 -- balls still fly at least half speed while the tutorial slows time
local MEGA_STEPS = 8 -- mega balls can smash through several things in one frame

-- Boosts
local BOOSTS = Config.Boosts
local MAGNET = BOOSTS.Magnet
local MEGA = BOOSTS.MegaBall
local SLOWMO = BOOSTS.SlowMo
local SHIELD = BOOSTS.Shield
local MEGA_RADIUS = Config.BALL_RADIUS * MEGA.Scale
local MEGA_PUSH = 1.6 -- mega balls blast glass shards harder
local MAGNET_PULL_SPEED = 60 -- studs per second a crystal flies at (plus the camera's speed)
local MAGNET_PICKUP = 1.5 -- this close to the camera = collected
local SLOWMO_EASE = 0.35 -- seconds to slow down / speed back up
local WHITE = Color3.new(1, 1, 1)
local SHIELD_FLASH = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local BASE_SATURATION = 0 -- zone grading already sets saturation; this layer stays neutral

-- Roblox's own UI we hide (the game has its own leaderboard, and the player
-- list would cover the distance readout). Chat stays on.
local HIDDEN_CORE_GUI = {
	Enum.CoreGuiType.Backpack,
	Enum.CoreGuiType.Health,
	Enum.CoreGuiType.PlayerList,
	Enum.CoreGuiType.EmotesMenu,
}
local CORE_GUI_ATTEMPTS = 10

local RunController = {}

-- State ----------------------------------------------------------------------

local state = "Menu" -- "Menu" | "Running" | "GameOver"
local world -- Folder holding everything for the current run
local shardFolder
local track
local raycastParams

local cameraZ = ORIGIN.Z
local speed = Config.START_SPEED
local balls = 0
local multiball = 1
local streak = 0
local lastThrow = 0
local lastRoom = 0
local lastReportedRoom = 0 -- last room index sent to the server with RoomReached
local startCheckpoint = 0
local shake = 0
local activeBalls = {}
local pendingBalls = 0 -- balls bought while not in a run, added to the next one
local reportedMeters = 0
local runFx -- shatter effect equipped for this run (Config.ShatterFx entry)
-- Counted from the start of the run (a revive continues it). Sent with RunEnded.
local runStats = { glass = 0, crystals = 0, props = 0, maxMultiball = 1 }
local ui

-- Boosts running in this run (only what the server confirmed).
-- shield = crashes it still absorbs, magnet / slowmo = seconds left,
-- megaball = giant throws left.
local boost = { shield = 0, magnet = 0, slowmo = 0, megaball = 0, doubleGems = false }
local timeScale = 1 -- 1 = normal speed, lower while SlowMo is on
local slowLook = 0 -- how much of the slow-mo color effect is showing (0..1)
local magnetized = {} -- crystals currently flying to the camera
local runSerial = 0 -- RunStarted events sent; the server echoes it with BoostsActivated

-- Helpers --------------------------------------------------------------------

local function ownsPass(passKey)
	return player:GetAttribute("Pass_" .. passKey) == true
end

local function minimumMultiball()
	return if ownsPass("Multiball") then 2 else 1
end

local function meters()
	return math.max(0, math.floor((ORIGIN.Z - cameraZ) / Config.STUDS_PER_METER))
end

local function currentRoom()
	return math.max(0, (ORIGIN.Z - cameraZ) // Config.ROOM_LENGTH)
end

local function cameraPosition()
	return Vector3.new(ORIGIN.X, ORIGIN.Y + Config.CAMERA_HEIGHT, cameraZ)
end

local function updateHud()
	ui:setHud({
		balls = balls,
		multiball = multiball,
		streak = (streak % Config.CRYSTALS_PER_MULTIBALL_LEVEL) / Config.CRYSTALS_PER_MULTIBALL_LEVEL,
		meters = meters(),
		zone = currentRoom() // Config.ROOMS_PER_CHECKPOINT,
	})
end

-- Lighting -------------------------------------------------------------------

-- Zone lighting lives in LightingFx. This extra color layer is only for
-- gameplay effects (slow-mo desaturation, shield flash), stacked on top.
local colorCorrection

local function setupLighting()
	LightingFx.setup()

	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "GameplayGrade"
	colorCorrection.Saturation = BASE_SATURATION
	colorCorrection.Parent = Lighting
end

local function applyTheme(zone)
	local theme = TrackBuilder.themeFor(zone * Config.ROOMS_PER_CHECKPOINT)
	LightingFx.applyTheme(theme)
	ui:setTheme(theme)
	GamepadAim.setAccent(theme.Accent)
	LeaveGift.setAccent(theme.Accent)
end

-- Balls ----------------------------------------------------------------------

-- mega: a giant MegaBall boost ball (bigger, always has a trail).
local function makeBallPart(mega)
	local skin = Config.getSkin(player:GetAttribute("EquippedSkin"))
	local radius = if mega then MEGA_RADIUS else Config.BALL_RADIUS

	local part = Instance.new("Part")
	part.Name = if mega then "MegaBall" else "Ball"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * radius * 2
	part.Material = skin.Material
	part.Color = skin.Color
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false

	if skin.Rainbow then
		part.Color = Color3.fromHSV(os.clock() % 1, 0.8, 1)
	end

	if skin.Trail or skin.Rainbow or mega then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, radius * 0.6, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -radius * 0.6, 0)
		a1.Parent = part

		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.25
		trail.LightEmission = 1
		trail.Color = ColorSequence.new(skin.Trail or (if mega then MEGA.Color else part.Color))
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = part
	end

	part.Parent = shardFolder
	return part
end

local function collectCrystal(crystal)
	Shatter.crystal(crystal, shardFolder)
	balls += Config.CRYSTAL_REWARD
	streak += 1
	runStats.crystals += 1
	if streak % Config.CRYSTALS_PER_MULTIBALL_LEVEL == 0 and multiball < Config.MAX_MULTIBALL then
		multiball += 1
		runStats.maxMultiball = math.max(runStats.maxMultiball, multiball)
		ui:toast("MULTIBALL x" .. multiball, "multiball")
		Tutorial.tip("Multiball")
	end
	Sounds.play("Crystal", 1 + math.min(streak, 10) * 0.03)
	updateHud()
end

-- fx: the player's shatter effect (only for balls they throw), nil = plain glass.
local function smashGlass(glass, hitPoint, push, fx)
	Shatter.glass(glass, hitPoint, push, shardFolder, fx)
	Sounds.play("Shatter", 0.85 + math.random() * 0.3)
end

-- Bounces a ball off a wall/floor/door it just touched. Returns the rest of
-- this frame's movement.
local function bounce(ball, hit, remaining)
	local normal = hit.Normal
	ball.velocity = (ball.velocity - 2 * ball.velocity:Dot(normal) * normal) * 0.6
	ball.position += normal * 0.05
	return ball.velocity.Unit * remaining * 0.6
end

-- MegaBall boost: a giant ball swept as a sphere (workspace:Spherecast), so it
-- hits everything its whole body touches. It smashes glass and decorations,
-- collects crystals and opens doors without slowing down; only walls stop it.
local function stepMegaBall(ball, travel)
	for _ = 1, MEGA_STEPS do
		local distance = travel.Magnitude
		if distance < 1e-3 then
			break
		end
		local hit = workspace:Spherecast(ball.position, MEGA_RADIUS, travel, raycastParams)
		if not hit then
			ball.position += travel
			break
		end

		-- hit.Distance is how far the sphere's center got before touching.
		local direction = travel / distance
		local remaining = distance - hit.Distance
		ball.position += direction * hit.Distance
		local part = hit.Instance
		local kind = part:GetAttribute("Kind")

		if kind == "Glass" then
			runStats.glass += 1
			smashGlass(part, hit.Position, direction * MEGA_PUSH, runFx)
			travel = direction * remaining
		elseif kind == "Prop" then
			runStats.props += 1
			Tutorial.tip("Props")
			Shatter.prop(part, hit.Position, direction * MEGA_PUSH, shardFolder, runFx)
			Sounds.play("Shatter", 0.8 + math.random() * 0.2)
			travel = direction * remaining
		elseif kind == "Crystal" then
			collectCrystal(part)
			travel = direction * remaining
		else
			local door = if kind == "Door" or kind == "Button" then track:doorFor(part) else nil
			if door and not door.open then
				-- Bursts the door open. The panels slide away, so skip collisions
				-- for the rest of this frame instead of hitting them again.
				track:openDoor(door)
				Sounds.play("Checkpoint")
				ball.position += direction * remaining
				break
			end
			travel = bounce(ball, hit, remaining)
		end
	end
end

-- Moves one ball forward, bouncing off walls and breaking what it hits.
-- Returns false when the ball should be removed.
local function stepBall(ball, dt)
	ball.age += dt
	if ball.age > Config.BALL_LIFETIME then
		return false
	end

	-- Normal balls that bounced back well behind the camera can't hit anything useful.
	if not ball.mega and ball.position.Z > cameraZ + BEHIND_CAMERA then
		return false
	end

	ball.velocity += GRAVITY * dt
	local travel = ball.velocity * dt

	if ball.mega then
		stepMegaBall(ball, travel)
		ball.part.CFrame = CFrame.new(ball.position)
		return true
	end

	-- A few iterations so a fast ball can break glass and still bounce this frame.
	for _ = 1, BALL_STEPS do
		local hit = workspace:Raycast(ball.position, travel, raycastParams)
		if not hit then
			ball.position += travel
			break
		end

		local kind = hit.Instance:GetAttribute("Kind")
		local remaining = travel.Magnitude - hit.Distance
		ball.position = hit.Position

		if kind == "Glass" then
			runStats.glass += 1
			smashGlass(hit.Instance, hit.Position, ball.velocity.Unit, runFx)
			ball.velocity *= 0.7 -- the ball keeps going, a bit slower
			travel = ball.velocity.Unit * remaining * 0.7
		elseif kind == "Prop" then
			-- Breakable decoration: just for fun, the ball smashes straight through.
			runStats.props += 1
			Tutorial.tip("Props")
			Shatter.prop(hit.Instance, hit.Position, ball.velocity.Unit, shardFolder, runFx)
			Sounds.play("Shatter", 1.1 + math.random() * 0.3)
			ball.velocity *= 0.85
			travel = ball.velocity.Unit * remaining * 0.85
		elseif kind == "Crystal" then
			collectCrystal(hit.Instance)
			travel = travel.Unit * remaining
		elseif kind == "Button" then
			track:openDoor(track:doorFor(hit.Instance))
			Sounds.play("Checkpoint")
			ball.velocity = -ball.velocity * 0.4
			travel = ball.velocity.Unit * remaining * 0.4
		else
			-- Walls, floor, doors: bounce.
			travel = bounce(ball, hit, remaining)
		end
	end

	ball.part.CFrame = CFrame.new(ball.position)
	return true
end

local function stepBalls(dt)
	for i = #activeBalls, 1, -1 do
		local ball = activeBalls[i]
		if not stepBall(ball, dt) then
			ball.part:Destroy()
			table.remove(activeBalls, i)
		end
	end
end

local function clearBalls()
	for _, ball in activeBalls do
		ball.part:Destroy()
	end
	table.clear(activeBalls)
end

-- preSweep (mega balls only): the ball starts at the camera and is swept this
-- far before its first frame. A sphere cast can't hit something the sphere
-- already overlaps at its start, so starting a giant ball out in front would
-- miss glass, crystals and buttons right in front of the camera.
local function spawnBall(origin, velocity, mega, preSweep)
	-- Too many balls slows phones down: the oldest ones disappear first.
	while #activeBalls >= Config.MAX_LIVE_BALLS do
		local oldest = table.remove(activeBalls, 1)
		oldest.part:Destroy()
	end

	local part = makeBallPart(mega)
	local ball = { part = part, position = origin, velocity = velocity, age = 0, mega = mega }
	table.insert(activeBalls, ball)
	if mega and preSweep then
		stepMegaBall(ball, preSweep)
	end
	part.CFrame = CFrame.new(ball.position)
end

-- Throws along a ray from the camera (see throw / throwAtViewport below).
-- Returns true if a ball was thrown.
local function throwAlong(ray)
	if state ~= "Running" or balls <= 0 then
		return false
	end
	local now = os.clock()
	if now - lastThrow < Config.THROW_COOLDOWN then
		return false
	end
	lastThrow = now
	balls -= 1

	-- MegaBall boost: this whole throw (every ball of the multiball fan) is giant.
	local mega = boost.megaball > 0
	if mega then
		boost.megaball -= 1
	end
	-- Giant balls end up a bit further out so they don't fill the screen.
	local startDistance = if mega then 1.5 + MEGA_RADIUS else 1.5

	local carry = FORWARD * speed -- balls keep the camera's forward momentum
	for i = 1, multiball do
		-- Spread extra balls out in a small fan.
		local angle = (i - (multiball + 1) / 2) * 0.05
		local direction = CFrame.fromAxisAngle(Vector3.yAxis, angle):VectorToWorldSpace(ray.Direction)
		local velocity = direction * Config.BALL_SPEED + carry
		if mega then
			-- Swept from the camera so anything close is still smashed.
			spawnBall(ray.Origin, velocity, true, direction * startDistance)
		else
			spawnBall(ray.Origin + direction * startDistance, velocity, false)
		end
	end

	Sounds.play("Throw", 0.95 + math.random() * 0.1)
	updateHud()
	return true
end

-- Mouse / touch: input.Position is measured below the Roblox top bar, which is
-- what ScreenPointToRay expects.
local function throw(screenPosition)
	if state ~= "Running" then
		return false
	end
	return throwAlong(camera:ScreenPointToRay(screenPosition.X, screenPosition.Y))
end

-- Gamepad crosshair: its position is in full-screen (viewport) pixels, which
-- is what ViewportPointToRay expects.
local function throwAtViewport(viewportPosition)
	if state ~= "Running" then
		return false
	end
	return throwAlong(camera:ViewportPointToRay(viewportPosition.X, viewportPosition.Y))
end

-- Boosts ---------------------------------------------------------------------

local function boostName(boostId)
	local info = BOOSTS[boostId]
	return if info then info.Name else "BOOST"
end

-- The player's boost inventory ({ [boostId] = count }) from the server.
local function ownedBoosts()
	local raw = player:GetAttribute("Boosts")
	if type(raw) ~= "string" then
		return {}
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(decoded) == "table" then decoded else {}
end

-- The boosts picked in the menu that the player really has (distinct, max
-- Config.MAX_BOOSTS_PER_RUN). The server checks again; this just avoids
-- asking for boosts they don't own.
local function pickBoosts(boostIds)
	local picked = {}
	if type(boostIds) ~= "table" then
		return picked
	end
	local owned = ownedBoosts()
	for _, boostId in ipairs(boostIds) do
		if #picked >= Config.MAX_BOOSTS_PER_RUN then
			break
		end
		if
			type(boostId) == "string"
			and BOOSTS[boostId]
			and not table.find(picked, boostId)
			and (tonumber(owned[boostId]) or 0) >= 1
		then
			table.insert(picked, boostId)
		end
	end
	return picked
end

-- Switches one boost on for this run. Buying the same timed boost again adds
-- time; each Shield absorbs one more crash.
local function activateBoost(boostId)
	if boostId == "Shield" then
		boost.shield += 1
	elseif boostId == "Magnet" then
		boost.magnet += MAGNET.Duration
	elseif boostId == "SlowMo" then
		boost.slowmo += SLOWMO.Duration
	elseif boostId == "MegaBall" then
		boost.megaball += MEGA.Throws
	elseif boostId == "DoubleGems" then
		boost.doubleGems = true
	else
		return false
	end
	return true
end

local function setSlowLook(amount)
	if amount ~= slowLook and colorCorrection then
		slowLook = amount
		colorCorrection.Saturation = BASE_SATURATION - 0.45 * amount
	end
end

-- Everything off (new run or back to the menu).
local function resetBoosts()
	boost.shield = 0
	boost.magnet = 0
	boost.slowmo = 0
	boost.megaball = 0
	boost.doubleGems = false
	timeScale = 1
	setSlowLook(0)
	table.clear(magnetized)
end

-- Counts boost timers down (real seconds, so slow-mo doesn't make them last longer)
-- and eases the world's time scale in and out of slow-mo.
local function tickBoosts(dt)
	boost.magnet = math.max(0, boost.magnet - dt)
	boost.slowmo = math.max(0, boost.slowmo - dt)

	local slowest = SLOWMO.TimeScale
	local target = if boost.slowmo > 0 then slowest else 1
	local change = (1 - slowest) / SLOWMO_EASE * dt
	if timeScale > target then
		timeScale = math.max(target, timeScale - change)
	elseif timeScale < target then
		timeScale = math.min(target, timeScale + change)
	end
	setSlowLook(if slowest < 1 then (1 - timeScale) / (1 - slowest) else 0)
end

-- Magnet boost: crystals within range of the camera fly to it and are collected
-- (exactly like hitting them with a ball). Crystals already flying keep going
-- after the magnet runs out.
local function updateMagnet(dt)
	local eye = cameraPosition()
	if boost.magnet > 0 and track then
		local range = MAGNET.Range
		for _, room in track.rooms do
			for _, crystal in room.crystals do
				-- CanQuery is turned off once a crystal is collected or already flying.
				if crystal.CanQuery and crystal.Parent and (crystal.Position - eye).Magnitude <= range then
					crystal.CanQuery = false
					table.insert(magnetized, crystal)
				end
			end
		end
	end

	local pull = (MAGNET_PULL_SPEED + speed) * dt -- how far a crystal flies this frame
	for i = #magnetized, 1, -1 do
		local crystal = magnetized[i]
		if not crystal.Parent then
			table.remove(magnetized, i)
		else
			local offset = eye - crystal.Position
			local distance = offset.Magnitude
			if distance <= pull + MAGNET_PICKUP then
				table.remove(magnetized, i)
				collectCrystal(crystal)
			else
				crystal.Position += offset * (pull / distance)
			end
		end
	end
end

-- Shield boost used up: a burst of blue shards around the view and a quick tint.
local function shieldBreak()
	Shatter.shieldBreak(camera.CFrame, SHIELD.Color, shardFolder, FORWARD * speed * timeScale)
	if colorCorrection then
		colorCorrection.TintColor = WHITE:Lerp(SHIELD.Color, 0.6)
		TweenService:Create(colorCorrection, SHIELD_FLASH, { TintColor = WHITE }):Play()
	end
	Sounds.play("Shatter", 0.6)
	ui:toast("SHIELD BROKEN", "info")
end

-- What the HUD shows for boosts (sent every frame; the UI only redraws changes).
local function updateBoostHud()
	if ui.setBoosts then
		ui:setBoosts({
			shield = boost.shield > 0, -- the UI only shows on / off
			magnet = boost.magnet,
			slowmo = boost.slowmo,
			megaball = boost.megaball,
			doubleGems = boost.doubleGems,
		})
	end
end

-- Run lifecycle ----------------------------------------------------------------

local function gameOver()
	if state ~= "Running" then
		return
	end
	state = "GameOver"

	local distance = meters()
	local best = player:GetAttribute("Best") or 0
	local gemMultiplier = if ownsPass("VIP") then Config.GamePasses.VIP.GemMultiplier else 1
	if player.MembershipType == Enum.MembershipType.Premium then
		gemMultiplier *= 1 + Config.PREMIUM_GEM_BONUS
	end
	if boost.doubleGems then
		gemMultiplier *= 2 -- the server doubles them too
	end
	local newMeters = math.max(0, distance - reportedMeters)
	reportedMeters = math.max(reportedMeters, distance)
	Remotes.RunEnded:FireServer(distance, table.clone(runStats))
	Tutorial.setPaused(true)

	-- Personal best only counts runs started from the beginning (same as the server).
	local countsForBest = startCheckpoint == 0
	ui:showGameOver({
		meters = distance,
		best = if countsForBest then math.max(best, distance) else best,
		isNewBest = countsForBest and distance > best,
		gemsEarned = math.floor(newMeters * Config.GEMS_PER_METER * gemMultiplier),
		canRevive = Config.Products.Revive.Id ~= 0,
	})
end

local function crash(hazard)
	local door = track:doorFor(hazard)
	if door then
		track:openDoor(door)
	else
		smashGlass(hazard, cameraPosition(), FORWARD)
	end

	-- Crashing while learning is free.
	if Tutorial.crashIsFree() then
		shake = 0.2
		Sounds.play("Crash")
		return
	end

	-- Shield boost: this crash is free (no balls lost, multiball kept).
	if boost.shield > 0 then
		boost.shield -= 1
		shake = 0.2
		shieldBreak()
		return
	end

	balls = math.max(0, balls - Config.CRASH_PENALTY)
	multiball = minimumMultiball()
	streak = 0
	shake = 0.35
	Sounds.play("Crash")
	ui:flashDamage()
	updateHud()

	if balls <= 0 then
		gameOver()
	end
end

-- Did the camera fly through any pane between prevZ and newZ?
local function checkCrashes(prevZ, newZ)
	local position = cameraPosition()
	for _, hazard in track:hazards() do
		-- The list was built before the loop, so skip anything an earlier crash already cleared
		-- (both panels of a door would otherwise each cost a crash).
		local door = track:doorFor(hazard)
		if not hazard.Parent or (door and door.open) then
			continue
		end
		local z = hazard.Position.Z
		if prevZ > z and newZ <= z then
			local localPoint = hazard.CFrame:PointToObjectSpace(Vector3.new(position.X, position.Y, z))
			local size = hazard.Size
			if
				math.abs(localPoint.X) <= size.X / 2 + CRASH_MARGIN
				and math.abs(localPoint.Y) <= size.Y / 2 + CRASH_MARGIN
			then
				crash(hazard)
				if state ~= "Running" then
					return
				end
			end
		end
	end
end

-- Throws away the old track and builds a fresh one starting at a checkpoint.
local function resetWorld(checkpoint, tutorial)
	if world then
		world:Destroy()
	end
	clearBalls()
	resetBoosts()

	world = Instance.new("Folder")
	world.Name = "LocalRun"
	world.Parent = workspace

	shardFolder = Instance.new("Folder")
	shardFolder.Name = "Effects"
	shardFolder.Parent = world

	local firstRoom = checkpoint * Config.ROOMS_PER_CHECKPOINT
	track = TrackBuilder.new(world, firstRoom, tutorial)
	cameraZ = TrackBuilder.roomStartZ(firstRoom) + 4
	track:update(cameraZ, 0)

	raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	raycastParams.FilterDescendantsInstances = { track.folder }

	lastRoom = firstRoom
	lastReportedRoom = firstRoom
	applyTheme(checkpoint)
end

-- boostIds: boosts picked in the menu (may be nil/empty). They only switch on
-- once the server confirms them (see onBoostsActivated).
local function startRun(checkpoint, boostIds)
	checkpoint = if type(checkpoint) == "number" then math.max(0, math.floor(checkpoint)) else 0
	if checkpoint > 0 and not ownsPass("Checkpoints") then
		checkpoint = 0
	end
	checkpoint = math.min(checkpoint, player:GetAttribute("Checkpoint") or 0)
	startCheckpoint = checkpoint

	-- Brand-new players get the guided first run.
	local tutorialRun = checkpoint == 0 and Tutorial.isNeeded()
	Tutorial.reset()
	resetWorld(checkpoint, tutorialRun)
	if tutorialRun then
		Tutorial.start(track)
	end

	-- Bonus balls from the daily streak (the server resets them when the run starts).
	local bonusBalls = math.max(0, math.floor(tonumber(player:GetAttribute("BonusBalls")) or 0))

	balls = Config.START_BALLS + pendingBalls + bonusBalls
	if ownsPass("VIP") then
		balls += Config.GamePasses.VIP.ExtraStartBalls
	end
	pendingBalls = 0
	multiball = minimumMultiball()
	streak = 0
	speed = Config.START_SPEED
	reportedMeters = math.floor(Config.checkpointMeters(checkpoint))
	runFx = Config.getFx(player:GetAttribute("EquippedFx"))
	runStats = { glass = 0, crystals = 0, props = 0, maxMultiball = multiball }
	state = "Running"

	local picked = pickBoosts(boostIds)
	runSerial += 1
	if #picked > 0 then
		Remotes.RunStarted:FireServer(checkpoint, picked)
	else
		Remotes.RunStarted:FireServer(checkpoint)
	end
	ui:showHud()
	updateHud()
	Sounds.startMusic()
	if bonusBalls > 0 then
		ui:toast("+" .. bonusBalls .. " BONUS BALLS", "reward")
	end
end

local function revive(extraBalls)
	if state ~= "GameOver" then
		return false
	end

	-- Clear everything right in front of the player so they don't crash instantly.
	for _, hazard in track:hazards() do
		local ahead = cameraZ - hazard.Position.Z
		if ahead > -2 and ahead < 40 then
			local door = track:doorFor(hazard)
			if door then
				track:openDoor(door)
			else
				smashGlass(hazard, hazard.Position, FORWARD)
			end
		end
	end

	balls = extraBalls
	multiball = minimumMultiball()
	streak = 0
	state = "Running"
	Tutorial.setPaused(false)
	ui:hideRevive()
	ui:showHud()
	updateHud()
	return true
end

local function showMenu()
	-- Leaving mid-run still reports it, so the server doesn't think it's still going.
	if state == "Running" then
		gameOver()
	end
	state = "Menu"
	Tutorial.reset()
	resetWorld(0)
	ui:showMenu()
end

-- Frame loop -----------------------------------------------------------------

local function onRoomEntered(room)
	if room > 0 and room % Config.ROOMS_PER_CHECKPOINT == 0 then
		local zone = room // Config.ROOMS_PER_CHECKPOINT
		applyTheme(zone)
		ui:toast(string.format("ZONE %02d", zone), "checkpoint")
		Sounds.play("Checkpoint")
	end
end

-- Tells the server each new room the camera reaches (it checks the distance
-- against these, so it must be every room, in order).
local function reportRoom(roomIndex)
	local remote = Remotes:FindFirstChild("RoomReached")
	if remote then
		remote:FireServer(roomIndex)
	end
end

local menuTime = 0

local function step(dt)
	-- worldDt: game time, slower than real time while SlowMo is on.
	local worldDt = dt
	local ballDt = dt -- balls ignore most of the tutorial's slow-down
	if state == "Running" then
		tickBoosts(dt)
		-- The tutorial slows time while it waits for the player to act.
		local tutorialScale = Tutorial.update(dt, cameraZ)
		worldDt = dt * timeScale * tutorialScale
		ballDt = dt * timeScale * math.max(tutorialScale, TUTORIAL_MIN_BALL_SPEED)
		Tutorial.scanForTips(dt, cameraZ, track)

		local zoneRooms = currentRoom() - startCheckpoint * Config.ROOMS_PER_CHECKPOINT
		speed = math.min(Config.MAX_SPEED, Config.START_SPEED + zoneRooms * Config.SPEED_GAIN_PER_ROOM)

		local prevZ = cameraZ
		cameraZ -= speed * worldDt
		checkCrashes(prevZ, cameraZ)

		local room = currentRoom()
		if room ~= lastRoom and state == "Running" then
			lastRoom = room
			onRoomEntered(room)
		end
		while state == "Running" and room > lastReportedRoom do
			lastReportedRoom += 1
			reportRoom(lastReportedRoom)
		end
	end

	if track then
		track:update(cameraZ, worldDt)
	end
	stepBalls(ballDt)

	if state == "Running" then
		updateMagnet(worldDt)
		if balls <= 0 and #activeBalls == 0 then
			gameOver()
		end
		updateHud()
	end

	-- Camera: gentle sway, wider view at high speed, shake on crash.
	menuTime += dt
	shake = math.max(0, shake - dt)
	local sway = Vector3.new(math.sin(menuTime * 0.7) * 0.15, math.sin(menuTime * 1.3) * 0.1, 0)
	local jitter = Vector3.zero
	if shake > 0 then
		jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake * 2
	end
	local position = cameraPosition() + sway + jitter
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(position, position + FORWARD)
	camera.FieldOfView = 70 + (speed - Config.START_SPEED) / (Config.MAX_SPEED - Config.START_SPEED) * 15

	updateBoostHud()
	GamepadAim.update(dt, state == "Running")
end

-- Purchases ------------------------------------------------------------------

local function promptProduct(productKey)
	local product = Config.Products[productKey]
	-- Don't let anyone pay twice for something they already have.
	if productKey == "StarterPack" and player:GetAttribute("StarterPackBought") == true then
		ui:toast("ALREADY OWNED", "reward")
		return
	end
	if productKey == "SeasonPremium" and player:GetAttribute("SeasonPremium") == true then
		ui:toast("ALREADY UNLOCKED", "reward")
		return
	end
	-- A streak saver only does its real job right after the streak breaks
	-- (the server still gives gems if it's bought anyway).
	if productKey == "StreakSaver" then
		local expires = tonumber(player:GetAttribute("StreakExpires")) or 0
		local day = tonumber(player:GetAttribute("StreakDay")) or 1
		if workspace:GetServerTimeNow() <= expires or day <= 1 then
			ui:toast("YOUR STREAK IS SAFE", "info")
			return
		end
	end
	if product and product.Id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end
end

local function promptPass(passKey)
	local pass = Config.GamePasses[passKey]
	if pass and pass.Id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end
end

local function shopRequest(action, argument)
	local ok, success, message = pcall(function()
		return Remotes.ShopRequest:InvokeServer(action, argument)
	end)
	if not ok then
		return false, "Connection problem"
	end
	return success == true, message
end

-- A Robux boost always goes to the boost inventory first. Bought during a run,
-- we ask the server to use it right away; it's only switched on if the server says yes.
local function useBoostNow(boostId)
	local ok = shopRequest("UseBoostNow", boostId)
	if ok and state ~= "Menu" and activateBoost(boostId) then
		ui:toast(boostName(boostId) .. " ON", "reward")
	else
		ui:toast(boostName(boostId) .. " ADDED TO YOUR BOOSTS", "reward")
	end
end

local function onPurchaseGranted(productKey)
	local product = Config.Products[productKey]
	if product and product.Boost then
		if state == "Running" then
			task.spawn(useBoostNow, product.Boost)
		else
			ui:toast(boostName(product.Boost) .. " ADDED TO YOUR BOOSTS", "reward")
		end
		return
	end
	-- Starter pack / season pass are announced by the server's Progress "Reward" event.
	if product and product.Gems and productKey ~= "StarterPack" then
		ui:toast("+" .. product.Gems .. " GEMS", "reward")
		return
	end
	if not product or not product.Balls then
		return
	end

	if state == "GameOver" then
		if revive(product.Balls) then
			-- The server paused the run's clock at game over; start it again.
			task.spawn(shopRequest, "ResumeRun")
		end
	elseif state == "Running" then
		balls += product.Balls
		updateHud()
	else
		pendingBalls += product.Balls
	end
	ui:toast("+" .. product.Balls .. " BALLS", "reward")
end

-- The server confirmed which picked boosts started (and used them up).
-- event = { type = "BoostsActivated", boosts = { ids }, run = number }
local function onBoostsActivated(event)
	if state == "Menu" or type(event.boosts) ~= "table" then
		return
	end
	-- Meant for an earlier run (the player restarted before it arrived).
	if event.run ~= nil and event.run ~= runSerial then
		return
	end
	-- The UI shows the "... ON" toast for BoostsActivated itself.
	for _, boostId in ipairs(event.boosts) do
		activateBoost(boostId)
	end
end

-- Startup --------------------------------------------------------------------

-- SetCoreGuiEnabled can fail if called before Roblox's UI has loaded, so retry a few times.
local function hideCoreGui()
	for _ = 1, CORE_GUI_ATTEMPTS do
		local allHidden = true
		for _, coreGuiType in HIDDEN_CORE_GUI do
			local ok = pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreGuiType, false)
			if not ok then
				allHidden = false
			end
		end
		if allHidden then
			return
		end
		task.wait(1)
	end
end

-- Controller throw buttons: R2 (the trigger) or A, aimed with the crosshair.
-- A also presses UI buttons, so it only throws when no button is selected.
local function onGamepadThrowButton(keyCode, gameProcessed)
	if state ~= "Running" or GuiService.MenuIsOpen then
		return
	end
	if keyCode == Enum.KeyCode.ButtonA and (gameProcessed or GuiService.SelectedObject ~= nil) then
		return
	end
	if throwAtViewport(GamepadAim.viewportPosition()) then
		GamepadAim.pulse()
	end
end

local function disableCharacterControls()
	local playerScripts = player:WaitForChild("PlayerScripts")
	local ok, playerModule = pcall(function()
		return require(playerScripts:WaitForChild("PlayerModule"))
	end)
	if ok then
		playerModule:GetControls():Disable()
	end
end

function RunController.start()
	task.spawn(hideCoreGui)
	GamepadAim.start()
	LeaveGift.start({
		claim = function()
			return shopRequest("ClaimLeaveGift")
		end,
		-- Never pops up in the middle of a run (it waits for the menu / game over).
		canShow = function()
			return state ~= "Running"
		end,
	})

	ui = UI.new({
		-- boostIds: boosts picked in the menu (may be empty).
		onPlay = function(checkpoint, boostIds)
			startRun(checkpoint, boostIds)
		end,
		onPlayAgain = function(boostIds)
			startRun(startCheckpoint, boostIds)
		end,
		onMenu = showMenu,
		onRevive = function()
			promptProduct("Revive")
		end,
		onBuyProduct = promptProduct,
		onBuyPass = promptPass,
		onBuySkin = function(skinId)
			return shopRequest("BuySkin", skinId)
		end,
		onEquipSkin = function(skinId)
			return shopRequest("EquipSkin", skinId)
		end,
		onClaimDaily = function()
			return shopRequest("ClaimDaily")
		end,
		-- Generic: onShop("BuyFx", id), onShop("BuyBoost", id), onShop("ClaimMission", id),
		-- onShop("ClaimSeasonTier", { track, tier })...
		onShop = shopRequest,
	})

	setupLighting()
	showMenu()
	task.spawn(disableCharacterControls)

	Remotes.PurchaseGranted.OnClientEvent:Connect(onPurchaseGranted)

	-- Level ups, missions done, season tiers, run summaries, rewards.
	task.spawn(function()
		local progress = Remotes:WaitForChild("Progress")
		progress.OnClientEvent:Connect(function(event)
			if type(event) ~= "table" then
				return
			end
			if event.type == "BoostsActivated" then
				onBoostsActivated(event)
			end
			if ui.showProgress then
				ui:showProgress(event)
			end
		end)
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		local keyCode = input.KeyCode
		if keyCode == Enum.KeyCode.ButtonR2 or keyCode == Enum.KeyCode.ButtonA then
			onGamepadThrowButton(keyCode, gameProcessed)
			return
		end
		if gameProcessed then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			throw(input.Position)
		end
	end)

	RunService:BindToRenderStep("ShatterRun", Enum.RenderPriority.Camera.Value + 1, step)
end

return RunController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Shatter</string>
            <string name="Source"><![CDATA[--[[
	Breaking effects.

	Glass panes crack outward from the point the ball hit: cracks run from the
	impact to the edges, a ring of cracks crosses them, and every piece in between
	becomes a real triangle shard. Shards near the impact blast away, the rest
	drop and tumble, bounce off the floor and sparkle.

	Shatter.shieldBreak is the burst shown when a Shield boost absorbs a crash.

	Shard budget: every shard is a physics part, and phones slow down when too
	many are flying at once. We count the live ones; above Config.MAX_LIVE_SHARDS
	new breaks use fewer cracks, only the small pieces around the impact and no
	glitter. Only those inner pieces bounce off things (CanCollide); the big outer
	pieces just fall, which is much cheaper for the physics engine.

	Shatter.glass / Shatter.prop take an optional shatter effect (an entry of
	Config.ShatterFx) that tints the shards. nil or "Classic" = normal glass.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Shatter = {}

local rng = Random.new()
local TAU = math.pi * 2
local GRAVITY_BOOST = Vector3.new(0, -12, 0) -- shards look heavier with a small downward kick
local SMALL_PANE_AREA = 20 -- panes smaller than this (square studs) use few cracks
local FEW_RAYS = 5

-- Shard budget ------------------------------------------------------------------

-- Live shard parts, as batches { expires = os.clock() time, count = parts }.
local liveBatches = {}
local liveCount = 0

local function liveShards()
	local now = os.clock()
	for i = #liveBatches, 1, -1 do
		local batch = liveBatches[i]
		if batch.expires <= now then
			liveCount -= batch.count
			table.remove(liveBatches, i)
		end
	end
	return liveCount
end

local function addLive(count, lifetime)
	if count > 0 then
		liveCount += count
		table.insert(liveBatches, { expires = os.clock() + lifetime, count = count })
	end
end

local function overBudget()
	return liveShards() >= Config.MAX_LIVE_SHARDS
end

-- Effects -------------------------------------------------------------------

-- A short burst of glitter at the impact point.
local function sparkle(position, color, amount, parent)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one * 0.2
	holder.CFrame = CFrame.new(position)

	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.5))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.3, 0.7)
	emitter.Speed = NumberRange.new(8, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Drag = 2
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Parent = holder

	holder.Parent = parent
	emitter:Emit(amount)
	Debris:AddItem(holder, 1.2)
end

local function makePiece(className, template)
	local piece = Instance.new(className)
	piece.Material = template.Material
	piece.Color = template.Color
	piece.Transparency = template.Transparency
	piece.Reflectance = template.Reflectance
	piece.CastShadow = false
	piece.CanQuery = false
	piece.CanTouch = false
	piece.CanCollide = true -- bounce off the floor and walls
	piece.TopSurface = Enum.SurfaceType.Smooth
	piece.BottomSurface = Enum.SurfaceType.Smooth
	return piece
end

-- Shatter effects -----------------------------------------------------------

local function hasFx(fx)
	return fx ~= nil and fx.Id ~= "Classic"
end

-- The look of one shard: a plain table makePiece can read like a Part.
-- Rainbow effects get a new random hue for every shard.
local function styledTemplate(template, fx)
	if not hasFx(fx) then
		return template
	end
	local style = {
		Material = template.Material,
		Color = template.Color,
		Transparency = template.Transparency,
		Reflectance = template.Reflectance,
	}
	if fx.Rainbow then
		style.Color = Color3.fromHSV(rng:NextNumber(), 0.75, 1)
	elseif fx.Color then
		style.Color = fx.Color
	end
	if fx.Neon then
		style.Material = Enum.Material.Neon
		style.Transparency = math.min(style.Transparency, 0.2)
	elseif fx.Metal then
		style.Material = Enum.Material.Foil
		style.Transparency = 0
		style.Reflectance = 0.35
	end
	return style
end

-- Color and amount of the glitter burst.
local function sparkleStyle(baseColor, amount, fx)
	if not hasFx(fx) then
		return baseColor, amount
	end
	local color = fx.Color or baseColor
	if fx.Rainbow then
		color = Color3.fromHSV(rng:NextNumber(), 0.6, 1)
	end
	if fx.Sparkle then
		amount = math.floor(amount * 2.5)
	end
	return color, amount
end

local function launch(part, center, hitPoint, push, reach)
	local away = center - hitPoint
	local distance = away.Magnitude
	local closeness = math.clamp(1 - distance / reach, 0, 1)
	local direction = if distance > 0.01 then away.Unit else rng:NextUnitVector()

	part.AssemblyLinearVelocity = push * (6 + 40 * closeness ^ 1.5)
		+ direction * (3 + 18 * closeness)
		+ rng:NextUnitVector() * 2
		+ GRAVITY_BOOST
	part.AssemblyAngularVelocity = rng:NextUnitVector() * rng:NextNumber(2, 6 + 12 * closeness)
end

-- Triangles ----------------------------------------------------------------

-- Builds a flat triangle a-b-c out of two wedge parts welded together.
-- Returns the root wedge (move/launch that one) or nil for a sliver too thin to draw.
-- collide = false: the piece falls through everything (cheaper physics).
local function triangle(a, b, c, thickness, template, parent, collide)
	-- Make b-c the longest edge.
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b

	local normal = ac:Cross(ab)
	if normal.Magnitude < 0.05 or bc.Magnitude < 0.05 then
		return nil
	end
	local right = normal.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 0.05 then
		return nil
	end

	local first = makePiece("WedgePart", template)
	first.CanCollide = collide
	first.Size = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	first.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)

	local second = makePiece("WedgePart", template)
	second.CanCollide = collide
	second.Size = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	second.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = first
	weld.Part1 = second
	weld.Parent = first

	-- Parented to the first half so both are cleaned up together.
	second.Parent = first
	first.Parent = parent
	return first
end

-- Crack pattern ------------------------------------------------------------

-- Where a ray from p in direction d leaves the rectangle [-hx,hx] x [-hy,hy].
local function toEdge(p, d, hx, hy)
	local t = math.huge
	if d.X > 1e-6 then
		t = math.min(t, (hx - p.X) / d.X)
	elseif d.X < -1e-6 then
		t = math.min(t, (-hx - p.X) / d.X)
	end
	if d.Y > 1e-6 then
		t = math.min(t, (hy - p.Y) / d.Y)
	elseif d.Y < -1e-6 then
		t = math.min(t, (-hy - p.Y) / d.Y)
	end
	return p + d * t, t
end

local function angleOf(p, q)
	return math.atan2(q.Y - p.Y, q.X - p.X) % TAU
end

-- Returns a list of 2D triangles { {a, b, c, inner = bool}, ... } covering the
-- pane, in the pane's local X/Y plane, with the impact point p.
-- innerOnly = true: just the small fan around the impact (shard budget).
local function crackPattern(p, hx, hy, rays, innerOnly)
	local start = rng:NextNumber(0, TAU)
	local angles = {}
	for i = 0, rays - 1 do
		local jitter = rng:NextNumber(-0.35, 0.35) * TAU / rays
		table.insert(angles, (start + i * TAU / rays + jitter) % TAU)
	end
	table.sort(angles)

	local edges, rings = {}, {}
	for i, angle in angles do
		local d = Vector2.new(math.cos(angle), math.sin(angle))
		local edge, length = toEdge(p, d, hx, hy)
		edges[i] = edge
		rings[i] = p + d * length * rng:NextNumber(0.25, 0.55)
	end

	local corners = {
		Vector2.new(hx, hy),
		Vector2.new(-hx, hy),
		Vector2.new(-hx, -hy),
		Vector2.new(hx, -hy),
	}

	local triangles = {}
	for i = 1, rays do
		local j = i % rays + 1
		local a1, a2 = angles[i], angles[j]
		local span = (a2 - a1) % TAU

		-- Inner fan: the small, fast pieces around the impact.
		table.insert(triangles, { p, rings[i], rings[j], inner = true })
		if innerOnly then
			continue
		end

		-- Outer piece: ring crack -> edge, including any pane corners in between.
		local boundary = { edges[i] }
		local between = {}
		for _, corner in corners do
			local offset = (angleOf(p, corner) - a1) % TAU
			if offset > 0 and offset < span then
				table.insert(between, { offset = offset, point = corner })
			end
		end
		table.sort(between, function(x, y)
			return x.offset < y.offset
		end)
		for _, entry in between do
			table.insert(boundary, entry.point)
		end
		table.insert(boundary, edges[j])

		for k = 1, #boundary - 1 do
			table.insert(triangles, { rings[i], boundary[k], boundary[k + 1] })
		end
		table.insert(triangles, { rings[i], edges[j], rings[j] })
	end
	return triangles
end

-- Public -------------------------------------------------------------------

function Shatter.glass(panel, hitPoint, push, parent, fx)
	local size = panel.Size
	local cf = panel.CFrame
	local hx, hy = size.X / 2, size.Y / 2
	local thickness = math.min(size.Z, 0.4)

	-- Impact point in the pane's own 2D space (clamped just inside the edges).
	local localHit = cf:PointToObjectSpace(hitPoint)
	local p = Vector2.new(math.clamp(localHit.X, -hx * 0.95, hx * 0.95), math.clamp(localHit.Y, -hy * 0.95, hy * 0.95))

	-- Bigger panes get a few more cracks, small ones (grid tiles) only a few.
	-- Too many shards already flying: few cracks, inner pieces only, no glitter.
	local area = size.X * size.Y
	local busy = overBudget()
	local rays = math.clamp(Config.SHARD_RAYS + math.floor(area / 120), 5, 12)
	if busy or area < SMALL_PANE_AREA then
		rays = FEW_RAYS
	end
	local reach = math.max(size.X, size.Y) * 0.6
	local worldHit = cf * Vector3.new(p.X, p.Y, 0)

	local made = 0
	for _, tri in crackPattern(p, hx, hy, rays, busy) do
		local a = cf * Vector3.new(tri[1].X, tri[1].Y, 0)
		local b = cf * Vector3.new(tri[2].X, tri[2].Y, 0)
		local c = cf * Vector3.new(tri[3].X, tri[3].Y, 0)
		local shard = triangle(a, b, c, thickness, styledTemplate(panel, fx), parent, tri.inner == true)
		if shard then
			launch(shard, (a + b + c) / 3, worldHit, push, reach)
			Debris:AddItem(shard, Config.SHARD_LIFETIME + rng:NextNumber(0, 0.6))
			made += 2 -- two wedges per triangle
		end
	end
	addLive(made, Config.SHARD_LIFETIME + 0.6)

	if not busy then
		local sparkleColor, sparkleAmount = sparkleStyle(panel.Color, 25, fx)
		sparkle(worldHit, sparkleColor, sparkleAmount, parent)
	end
	panel:Destroy()
end

-- Breakable decorations (vases, bottles, lamps...). Each part bursts into
-- small random shards. Hitting any part of a breakable Model breaks all of it.
function Shatter.prop(part, hitPoint, push, parent, fx)
	-- Walk up to the breakable model this part belongs to (if any).
	local root = part
	local ancestor = part.Parent
	while ancestor and ancestor ~= workspace do
		if ancestor:IsA("Model") and ancestor:GetAttribute("Breakable") then
			root = ancestor
			break
		end
		ancestor = ancestor.Parent
	end

	local pieces = if root:IsA("BasePart") then { root } else {}
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(pieces, descendant)
		end
	end

	local busy = overBudget()
	local made = 0
	for _, piece in pieces do
		local size = piece.Size
		local volume = size.X * size.Y * size.Z
		local count = math.clamp(math.floor(volume / 1.5), 3, if busy then 3 else 10)
		local reach = math.max(size.X, size.Y, size.Z) * 2
		for _ = 1, count do
			local shard = makePiece("WedgePart", styledTemplate(piece, fx))
			shard.Size = Vector3.new(
				math.max(0.1, size.X * rng:NextNumber(0.15, 0.4)),
				math.max(0.1, size.Y * rng:NextNumber(0.15, 0.4)),
				math.max(0.1, size.Z * rng:NextNumber(0.1, 0.3))
			)
			local offset = Vector3.new(
				rng:NextNumber(-0.5, 0.5) * size.X,
				rng:NextNumber(-0.5, 0.5) * size.Y,
				rng:NextNumber(-0.5, 0.5) * size.Z
			)
			shard.CFrame = piece.CFrame * CFrame.new(offset) * CFrame.Angles(
				rng:NextNumber(0, TAU),
				rng:NextNumber(0, TAU),
				rng:NextNumber(0, TAU)
			)
			shard.Parent = parent
			launch(shard, shard.Position, hitPoint, push * 0.5, reach)
			Debris:AddItem(shard, Config.SHARD_LIFETIME + rng:NextNumber(0, 0.6))
			made += 1
		end
		if not busy then
			local sparkleColor, sparkleAmount = sparkleStyle(piece.Color, 10, fx)
			sparkle(piece.Position, sparkleColor, sparkleAmount, parent)
		end
	end
	addLive(made, Config.SHARD_LIFETIME + 0.6)

	root:Destroy()
end

-- Shield boost breaking: a ring of glowing shards bursts outward around the
-- player's view. cameraCFrame = where the camera is, carry = the camera's
-- velocity (so the burst travels along instead of being left behind).
local SHIELD_SHARDS = 16
local SHIELD_DISTANCE = 3.5
local SHIELD_RADIUS = 2.6

function Shatter.shieldBreak(cameraCFrame, color, parent, carry)
	local style = {
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.25,
		Reflectance = 0,
	}
	local center = cameraCFrame * Vector3.new(0, 0, -SHIELD_DISTANCE)
	for i = 1, SHIELD_SHARDS do
		local angle = (i / SHIELD_SHARDS) * TAU + rng:NextNumber(-0.15, 0.15)
		local outward = cameraCFrame:VectorToWorldSpace(Vector3.new(math.cos(angle), math.sin(angle), 0))
		local shard = makePiece("WedgePart", style)
		shard.CanCollide = false
		shard.Size = Vector3.new(0.08, rng:NextNumber(0.4, 0.9), rng:NextNumber(0.3, 0.7))
		shard.CFrame = CFrame.lookAt(center + outward * SHIELD_RADIUS, center + outward * (SHIELD_RADIUS + 1))
			* CFrame.Angles(0, 0, rng:NextNumber(0, TAU))
		shard.Parent = parent
		shard.AssemblyLinearVelocity = carry + outward * rng:NextNumber(14, 24)
		shard.AssemblyAngularVelocity = rng:NextUnitVector() * rng:NextNumber(4, 10)
		Debris:AddItem(shard, 0.7)
	end
	sparkle(center, color, 30, parent)
end

function Shatter.crystal(crystal, parent)
	crystal.CanQuery = false

	-- A pop of glowing chips plus the crystal shrinking away.
	for _ = 1, 6 do
		local chip = makePiece("Part", crystal)
		chip.CanCollide = false
		chip.Size = Vector3.one * rng:NextNumber(0.2, 0.45)
		chip.CFrame = crystal.CFrame * CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), 0)
		chip.Parent = parent
		chip.AssemblyLinearVelocity = rng:NextUnitVector() * rng:NextNumber(10, 20)
		Debris:AddItem(chip, 0.6)
	end
	sparkle(crystal.Position, crystal.Color, 18, parent)

	local tween = TweenService:Create(crystal, TweenInfo.new(0.25), {
		Size = Vector3.zero,
		Transparency = 1,
	})
	tween.Completed:Connect(function()
		crystal:Destroy()
	end)
	tween:Play()
end

return Shatter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Plays the sound IDs from Config.Sounds. IDs left at 0 are silently skipped,
	so the game works before any audio is uploaded.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Sounds = {}

-- Volume per sound (Roblox's Sound.Volume, 0-10). Sounds not listed keep the
-- Roblox default of 0.5. The gift sound is meant to grab attention.
local DEFAULT_VOLUME = 0.5
local VOLUMES = {
	Gift = 1.2,
}

local cache = {}

local function getSound(name)
	local id = Config.Sounds[name]
	if not id or id == 0 then
		return nil
	end
	if not cache[name] then
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = VOLUMES[name] or DEFAULT_VOLUME
		sound.Parent = SoundService
		cache[name] = sound
	end
	return cache[name]
end

-- pitch: optional playback speed (a little random variety).
-- volume: optional, overrides the sound's usual volume for this one play.
function Sounds.play(name, pitch, volume)
	local sound = getSound(name)
	if not sound then
		return
	end
	if pitch or volume then
		-- Varying the pitch a little keeps repeated shatters from sounding robotic.
		local copy = sound:Clone()
		copy.PlaybackSpeed = pitch or 1
		copy.Volume = volume or sound.Volume
		copy.Parent = SoundService
		copy.Ended:Once(function()
			copy:Destroy()
		end)
		copy:Play()
	else
		SoundService:PlayLocalSound(sound)
	end
end

function Sounds.startMusic()
	local music = getSound("Music")
	if music and not music.IsPlaying then
		music.Looped = true
		music.Volume = 0.4
		music:Play()
	end
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">TrackBuilder</string>
            <string name="Source"><![CDATA[--[[
	Builds the corridor rooms in front of the camera and deletes the ones behind it.
	Everything here is created on the player's device only, so nobody else sees it.

	Building a whole room at once takes long enough to make phones stutter, so
	each room is built in steps, a few milliseconds per frame (Config.ROOM_BUILD_BUDGET):
	  1. "Shell"  - floor, walls, trim, AND all glass, doors and crystals
	                (so crash checks never see a room with glass missing)
	  2. "Decor"  - the zone's decorations
	  3. "Lights" - real lights and shadows (needs the decorations to exist)
	The room the camera is about to enter is always finished right away, even
	if that goes over the budget.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Decor = require(script.Parent.Decor)
local Models = require(script.Parent.Models)
local LightingFx = require(script.Parent.LightingFx)

local WIDTH = Config.CORRIDOR_WIDTH
local HEIGHT = Config.CORRIDOR_HEIGHT
local LENGTH = Config.ROOM_LENGTH
local ORIGIN = Config.TRACK_ORIGIN
local EYE_Y = ORIGIN.Y + Config.CAMERA_HEIGHT

local TrackBuilder = {}
TrackBuilder.__index = TrackBuilder

-- kind: "Wall" (balls bounce), "Glass" (hazard), "Crystal", "Door", "Button", "Prop" (breakable decoration)
local function newPart(parent, kind, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for name, value in props do
		part[name] = value
	end
	part:SetAttribute("Kind", kind)
	part.Parent = parent
	return part
end

-- Shell materials per zone style (floor gets its own material and a darker tint).
local SURFACES = {
	Lab = { Wall = Enum.Material.SmoothPlastic, Ceiling = Enum.Material.SmoothPlastic, Floor = Enum.Material.Marble, FloorTint = Color3.fromRGB(120, 125, 135), FloorTintAmount = 0.25 },
	Neon = { Wall = Enum.Material.DiamondPlate, Ceiling = Enum.Material.Metal, Floor = Enum.Material.Slate, FloorTint = Color3.fromRGB(10, 10, 18), FloorTintAmount = 0.5 },
	Temple = { Wall = Enum.Material.Sandstone, Ceiling = Enum.Material.Sandstone, Floor = Enum.Material.Limestone, FloorTint = Color3.fromRGB(150, 110, 70), FloorTintAmount = 0.3 },
	Greenhouse = { Wall = Enum.Material.Concrete, Ceiling = Enum.Material.Glass, Floor = Enum.Material.WoodPlanks, FloorTint = Color3.fromRGB(120, 80, 45), FloorTintAmount = 0.6 },
	Void = { Wall = Enum.Material.Basalt, Ceiling = Enum.Material.Basalt, Floor = Enum.Material.Slate, FloorTint = Color3.fromRGB(10, 5, 20), FloorTintAmount = 0.4 },
}

-- Shared with Decor.luau.
TrackBuilder.newPart = newPart
TrackBuilder.WIDTH = WIDTH
TrackBuilder.HEIGHT = HEIGHT
TrackBuilder.LENGTH = LENGTH
TrackBuilder.ORIGIN = ORIGIN
TrackBuilder.EYE_Y = EYE_Y
TrackBuilder.Models = Models

function TrackBuilder.themeFor(roomIndex)
	local checkpoint = roomIndex // Config.ROOMS_PER_CHECKPOINT
	return Config.Themes[checkpoint % #Config.Themes + 1]
end

function TrackBuilder.roomStartZ(roomIndex)
	return ORIGIN.Z - roomIndex * LENGTH
end

-- tutorial = true builds the scripted first-run rooms (see buildTutorialRoom).
function TrackBuilder.new(parent, firstRoom, tutorial)
	local self = setmetatable({}, TrackBuilder)
	self.tutorial = tutorial == true
	self.tutorialTargets = {} -- step number -> part the player must break/collect
	self.folder = Instance.new("Folder")
	self.folder.Name = "Track"
	self.folder.Parent = parent
	self.rooms = {} -- roomIndex -> { folder, glass = { Part }, doors = { door }, crystals = { Part } }
	self.doorOf = setmetatable({}, { __mode = "k" }) -- door panel / button -> door
	self.nextRoom = firstRoom or 0
	self.rng = Random.new()
	self.buildQueue = {} -- steps still to do, oldest first: { roomIndex, stage, info }
	return self
end

function TrackBuilder:addGlass(room, position, size)
	local glass = newPart(room.folder, "Glass", {
		Name = "Glass",
		Size = size,
		CFrame = CFrame.new(position),
		Material = Enum.Material.Glass,
		Color = Config.GLASS_COLOR,
		Transparency = 0.35,
		Reflectance = 0.15,
	})
	table.insert(room.glass, glass)
	return glass
end

-- Uses the Blender gem when it's uploaded, a rotated neon cube otherwise.
local function meshCrystal(parent, position)
	local model = Models.place("Crystal", parent, CFrame.new(position), { anchor = "center", kind = "Crystal" })
	if not model then
		return nil
	end
	local gem = model:FindFirstChildWhichIsA("BasePart", true)
	if not gem then
		model:Destroy()
		return nil
	end
	gem.Parent = parent
	model:Destroy()
	gem.Name = "Crystal"
	gem.Material = Enum.Material.Neon
	gem.Color = Config.CRYSTAL_COLOR
	return gem
end

function TrackBuilder:addCrystal(room, position)
	local gem = meshCrystal(room.folder, position)
	if gem then
		table.insert(room.crystals, gem)
		return
	end
	local crystal = newPart(room.folder, "Crystal", {
		Name = "Crystal",
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Material = Enum.Material.Neon,
		Color = Config.CRYSTAL_COLOR,
	})
	table.insert(room.crystals, crystal)
end

local function patternsForZone(zone)
	return Config.ZonePatterns[math.min(zone + 1, #Config.ZonePatterns)]
end

-- Loops a part between two CFrames forever. Destroying the part stops it.
local function animate(part, goal, duration, reverses)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverses)
	TweenService:Create(part, info, { CFrame = goal }):Play()
end

TrackBuilder.Patterns = {}
local Patterns = TrackBuilder.Patterns

-- A pane right in front of you, slightly off center.
function Patterns.Window(self, room, z)
	local x = ORIGIN.X + self.rng:NextNumber(-2, 2)
	self:addGlass(room, Vector3.new(x, EYE_Y, z), Vector3.new(8, 8, 0.4))
end

-- Tall panes across the corridor, one always in the middle.
function Patterns.Pillars(self, room, z)
	for _, x in { -7, 0, 7 } do
		self:addGlass(room, Vector3.new(ORIGIN.X + x, ORIGIN.Y + HEIGHT / 2, z), Vector3.new(4, HEIGHT, 0.4))
	end
end

-- A wide horizontal pane at eye level.
function Patterns.Beam(self, room, z)
	self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, z), Vector3.new(WIDTH, 3, 0.4))
end

-- Blocks the whole corridor.
function Patterns.FullWall(self, room, z)
	self:addGlass(room, Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT / 2, z), Vector3.new(WIDTH, HEIGHT, 0.4))
end

-- Two panes close together: one throw won't clear both.
function Patterns.Double(self, room, z)
	self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, z), Vector3.new(10, 8, 0.4))
	self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, z - 6), Vector3.new(10, 8, 0.4))
end

-- A pane sliding side to side.
function Patterns.Moving(self, room, z)
	local rng = self.rng
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	local from = CFrame.new(ORIGIN.X + 6 * side, EYE_Y, z)
	local to = CFrame.new(ORIGIN.X - 6 * side, EYE_Y, z)
	local glass = self:addGlass(room, from.Position, Vector3.new(7, 8, 0.4))
	animate(glass, to, rng:NextNumber(1.4, 2.4), true)
end

-- Spinning glass blades, like a fan.
function Patterns.Spinner(self, room, z)
	local center = CFrame.new(ORIGIN.X, EYE_Y, z)
	local duration = self.rng:NextNumber(2, 3.2)
	for _, startAngle in { 0, math.pi / 2 } do
		local from = center * CFrame.Angles(0, 0, startAngle)
		local blade = self:addGlass(room, from.Position, Vector3.new(HEIGHT - 1, 2.5, 0.4))
		blade.CFrame = from
		-- A blade turned half a circle looks identical, so the loop is seamless.
		animate(blade, from * CFrame.Angles(0, 0, math.pi), duration, false)
	end
end

-- A wall of small panes. You need several throws (or multiball) to clear a hole.
function Patterns.Grid(self, room, z)
	for _, x in { -5, 0, 5 } do
		for _, y in { 2.5, 6.5, 10.5 } do
			self:addGlass(room, Vector3.new(ORIGIN.X + x, ORIGIN.Y + y, z), Vector3.new(4.6, 3.8, 0.4))
		end
	end
end

-- Metal doors you can't break. Hit the red button to open them.
function Patterns.Door(self, room, z)
	local half = WIDTH / 2
	local doorSize = Vector3.new(half, HEIGHT, 1)
	local y = ORIGIN.Y + HEIGHT / 2
	local door = { open = false, panels = {} }

	for _, side in { -1, 1 } do
		local panel = newPart(room.folder, "Door", {
			Name = "Door",
			Size = doorSize,
			CFrame = CFrame.new(ORIGIN.X + side * half / 2, y, z),
			Material = Enum.Material.DiamondPlate,
			Color = Config.DOOR_COLOR,
		})
		panel:SetAttribute("Side", side)
		table.insert(door.panels, panel)
		self.doorOf[panel] = door
	end

	local buttonX = ORIGIN.X + self.rng:NextNumber(-5, 5)
	local buttonY = ORIGIN.Y + self.rng:NextNumber(4, HEIGHT - 4)
	door.button = newPart(room.folder, "Button", {
		Name = "Button",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 3, 3),
		CFrame = CFrame.new(buttonX, buttonY, z + 0.7) * CFrame.Angles(0, math.rad(90), 0),
		Material = Enum.Material.Neon,
		Color = Config.BUTTON_COLOR,
	})
	self.doorOf[door.button] = door
	table.insert(room.doors, door)
end

function TrackBuilder:openDoor(door)
	if door.open then
		return
	end
	door.open = true
	door.button.Color = Color3.fromRGB(80, 255, 120)
	door.button.CanQuery = false
	for _, panel in door.panels do
		local side = panel:GetAttribute("Side")
		local goal = panel.CFrame + Vector3.new(side * WIDTH / 2, 0, 0)
		TweenService:Create(panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { CFrame = goal }):Play()
	end
end

-- Returns the door a button or door panel belongs to.
function TrackBuilder:doorFor(part)
	return self.doorOf[part]
end

-- One group of obstacles at depth z, picked from what this zone allows.
function TrackBuilder:addObstacle(room, z, zone)
	local patterns = patternsForZone(zone)
	local name = patterns[self.rng:NextInteger(1, #patterns)]
	local glassBefore, doorsBefore = #room.glass, #room.doors
	Patterns[name](self, room, z)

	-- Label what was just built so first-time tips know what they're looking at.
	for i = glassBefore + 1, #room.glass do
		room.glass[i]:SetAttribute("Pattern", name)
	end
	for i = doorsBefore + 1, #room.doors do
		for _, panel in room.doors[i].panels do
			panel:SetAttribute("Pattern", name)
		end
	end
end

-- The first-run tutorial: one simple lesson per room. Each lesson's target is
-- remembered so the Tutorial module can slow time and point at it.
function TrackBuilder:buildTutorialRoom(room, roomIndex, startZ)
	local step = table.find(Config.TUTORIAL_ROOMS, roomIndex)
	if step == 1 then
		-- Lesson 1: a single pane right in front of you.
		self.tutorialTargets[1] = self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, startZ - 40), Vector3.new(8, 8, 0.4))
	elseif step == 2 then
		-- Lesson 2: a crystal, then an easy pane.
		self:addCrystal(room, Vector3.new(ORIGIN.X + 2, EYE_Y + 1, startZ - 30))
		self.tutorialTargets[2] = room.crystals[#room.crystals]
		self:addGlass(room, Vector3.new(ORIGIN.X, EYE_Y, startZ - 62), Vector3.new(8, 8, 0.4))
	elseif step == 3 then
		-- Lesson 3: a full wall you must break or crash into.
		self.tutorialTargets[3] =
			self:addGlass(room, Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT / 2, startZ - 40), Vector3.new(WIDTH, HEIGHT, 0.4))
		self:addCrystal(room, Vector3.new(ORIGIN.X - 4, EYE_Y - 1, startZ - 55))
	end
end

-- Step 1: the room's shell plus everything you can crash into or collect.
function TrackBuilder:buildShell(roomIndex)
	local theme = TrackBuilder.themeFor(roomIndex)
	local startZ = TrackBuilder.roomStartZ(roomIndex)
	local centerZ = startZ - LENGTH / 2
	local rng = self.rng

	local zone = roomIndex // Config.ROOMS_PER_CHECKPOINT
	local isZoneStart = roomIndex % Config.ROOMS_PER_CHECKPOINT == 0

	local folder = Instance.new("Folder")
	folder.Name = "Room" .. roomIndex
	local room = { folder = folder, glass = {}, doors = {}, crystals = {} }

	-- Shell parts collide so glass shards can bounce off the floor and walls.
	-- Real surface materials per zone instead of flat plastic.
	local surfaces = SURFACES[theme.Style] or SURFACES.Lab
	local wallProps = { Color = theme.Wall, Material = surfaces.Wall, CanCollide = true }
	local function wall(size, position, material, color)
		local props = table.clone(wallProps)
		props.Size = size
		props.CFrame = CFrame.new(position)
		props.Material = material or props.Material
		props.Color = color or props.Color
		newPart(folder, "Wall", props)
	end
	local floorColor = theme.Wall:Lerp(surfaces.FloorTint, surfaces.FloorTintAmount)
	wall(Vector3.new(WIDTH, 1, LENGTH), Vector3.new(ORIGIN.X, ORIGIN.Y - 0.5, centerZ), surfaces.Floor, floorColor)
	wall(Vector3.new(WIDTH, 1, LENGTH), Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT + 0.5, centerZ), surfaces.Ceiling)
	wall(Vector3.new(1, HEIGHT, LENGTH), Vector3.new(ORIGIN.X - WIDTH / 2 - 0.5, ORIGIN.Y + HEIGHT / 2, centerZ))
	wall(Vector3.new(1, HEIGHT, LENGTH), Vector3.new(ORIGIN.X + WIDTH / 2 + 0.5, ORIGIN.Y + HEIGHT / 2, centerZ))

	-- Glowing door frame at the start of each room gives a sense of speed.
	local accent = { Color = theme.Accent, Material = Enum.Material.Neon }
	local function trim(size, position)
		local props = table.clone(accent)
		props.Size = size
		props.CFrame = CFrame.new(position)
		newPart(folder, "Wall", props)
	end
	trim(Vector3.new(WIDTH, 0.4, 0.4), Vector3.new(ORIGIN.X, ORIGIN.Y + 0.2, startZ))
	trim(Vector3.new(WIDTH, 0.4, 0.4), Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT - 0.2, startZ))
	trim(Vector3.new(0.4, HEIGHT, 0.4), Vector3.new(ORIGIN.X - WIDTH / 2 + 0.2, ORIGIN.Y + HEIGHT / 2, startZ))
	trim(Vector3.new(0.4, HEIGHT, 0.4), Vector3.new(ORIGIN.X + WIDTH / 2 - 0.2, ORIGIN.Y + HEIGHT / 2, startZ))

	-- Glowing strips along the floor edges.
	for _, side in { -1, 1 } do
		trim(Vector3.new(0.3, 0.15, LENGTH), Vector3.new(ORIGIN.X + side * (WIDTH / 2 - 0.4), ORIGIN.Y + 0.08, centerZ))
	end

	-- Ribs along the walls every 10 studs.
	for ribZ = startZ - 10, startZ - LENGTH + 1, -10 do
		for _, side in { -1, 1 } do
			local props = table.clone(wallProps)
			props.Size = Vector3.new(0.6, HEIGHT, 1.2)
			props.CFrame = CFrame.new(ORIGIN.X + side * (WIDTH / 2 - 0.3), ORIGIN.Y + HEIGHT / 2, ribZ)
			props.Color = theme.Wall:Lerp(Color3.new(0, 0, 0), 0.12)
			newPart(folder, "Wall", props)
		end
	end

	-- Big double gate marks the start of every new zone.
	if isZoneStart then
		for _, offset in { 0, -2 } do
			trim(Vector3.new(WIDTH, 1, 1), Vector3.new(ORIGIN.X, ORIGIN.Y + HEIGHT - 0.5, startZ + offset))
			trim(Vector3.new(1, HEIGHT, 1), Vector3.new(ORIGIN.X - WIDTH / 2 + 0.5, ORIGIN.Y + HEIGHT / 2, startZ + offset))
			trim(Vector3.new(1, HEIGHT, 1), Vector3.new(ORIGIN.X + WIDTH / 2 - 0.5, ORIGIN.Y + HEIGHT / 2, startZ + offset))
		end
	end

	if self.tutorial and table.find(Config.TUTORIAL_ROOMS, roomIndex) then
		self:buildTutorialRoom(room, roomIndex, startZ)
	elseif roomIndex >= Config.SAFE_ROOMS and not isZoneStart then
		-- Difficulty climbs inside each zone and keeps climbing zone to zone.
		local inZone = (roomIndex % Config.ROOMS_PER_CHECKPOINT) / Config.ROOMS_PER_CHECKPOINT
		local difficulty = math.min(inZone * 0.6 + zone * 0.15, 1)

		local groups = 1
		if rng:NextNumber() < difficulty then
			groups += 1
		end
		if rng:NextNumber() < difficulty * 0.6 then
			groups += 1
		end
		for group = 1, groups do
			self:addObstacle(room, startZ - LENGTH * group / (groups + 1), zone)
		end

		for _ = 1, rng:NextInteger(1, 2) do
			local position = Vector3.new(
				ORIGIN.X + rng:NextNumber(-7, 7),
				ORIGIN.Y + rng:NextNumber(3, HEIGHT - 3),
				startZ - rng:NextNumber(10, LENGTH - 10)
			)
			self:addCrystal(room, position)
		end
	end

	folder.Parent = self.folder
	self.rooms[roomIndex] = room

	-- Decorations and lights come in later frames.
	local info = {
		roomIndex = roomIndex,
		zone = zone,
		theme = theme,
		startZ = startZ,
		isZoneStart = isZoneStart,
		rng = rng,
	}
	self:queueStep({ roomIndex = roomIndex, stage = "Decor", info = info })
	self:queueStep({ roomIndex = roomIndex, stage = "Lights", info = info })
end

-- Adds a build step, keeping the queue in room order (nearest room first).
function TrackBuilder:queueStep(job)
	local queue = self.buildQueue
	local position = #queue + 1
	while position > 1 and queue[position - 1].roomIndex > job.roomIndex do
		position -= 1
	end
	table.insert(queue, position, job)
end

-- Runs one queued build step.
function TrackBuilder:runBuildStep(job)
	if job.stage == "Shell" then
		self:buildShell(job.roomIndex)
		return
	end
	local room = self.rooms[job.roomIndex]
	if not room then
		return -- already behind the camera and deleted
	end
	if job.stage == "Decor" then
		Decor.decorate(self, room, job.info)
	elseif job.stage == "Lights" then
		-- Real lights from the room's glowing parts, shadows from decorations.
		LightingFx.lightRoom(room.folder, job.info.theme)
	end
end

-- Builds a whole room right now (all steps).
function TrackBuilder:buildRoom(roomIndex)
	self:buildShell(roomIndex)
	self:finishRoomsUpTo(roomIndex)
end

-- Runs every queued step for rooms up to lastRoomIndex, right now.
function TrackBuilder:finishRoomsUpTo(lastRoomIndex)
	local queue = self.buildQueue
	while queue[1] and queue[1].roomIndex <= lastRoomIndex do
		self:runBuildStep(table.remove(queue, 1))
	end
end

-- Call every frame with the camera's Z position.
function TrackBuilder:update(cameraZ, dt)
	local spin = CFrame.Angles(0, dt * 2, 0)
	for _, room in self.rooms do
		for _, crystal in room.crystals do
			if crystal.Parent and crystal.CanQuery then
				crystal.CFrame = crystal.CFrame * spin
			end
		end
	end

	-- Queue new rooms coming into view (built over the next frames).
	while TrackBuilder.roomStartZ(self.nextRoom) > cameraZ - Config.ROOMS_AHEAD * LENGTH do
		self:queueStep({ roomIndex = self.nextRoom, stage = "Shell" })
		self.nextRoom += 1
	end

	-- The room the camera is in and the next one (starting within one room
	-- length plus a margin) must be complete: build them now, whatever it costs.
	local started = os.clock()
	local mustFinish = (ORIGIN.Z - (cameraZ - LENGTH - 20)) // LENGTH
	self:finishRoomsUpTo(mustFinish)

	-- Everything further away: only while this frame's time budget lasts.
	local queue = self.buildQueue
	while queue[1] and os.clock() - started < Config.ROOM_BUILD_BUDGET do
		self:runBuildStep(table.remove(queue, 1))
	end

	for roomIndex, room in self.rooms do
		local endZ = TrackBuilder.roomStartZ(roomIndex) - LENGTH
		if endZ > cameraZ + 10 then
			room.folder:Destroy()
			self.rooms[roomIndex] = nil
		end
	end
end

-- Everything you can crash into: unbroken glass and closed doors.
function TrackBuilder:hazards()
	local result = {}
	for _, room in self.rooms do
		for _, glass in room.glass do
			if glass.Parent then
				table.insert(result, glass)
			end
		end
		for _, door in room.doors do
			if not door.open then
				for _, panel in door.panels do
					table.insert(result, panel)
				end
			end
		end
	end
	return result
end

function TrackBuilder:destroy()
	self.folder:Destroy()
end

return TrackBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--[[
	First-run tutorial and first-time tips.

	Tutorial (first run only): rooms 1-3 each teach one thing. As the lesson's
	target gets close, time slows almost to a stop, a card explains what to do
	and a ring points at the target. Doing it resumes the run. Crashes during
	the tutorial are free. A SKIP button ends it at any time.

	Tips: the first time a new obstacle type shows up (doors, moving glass...),
	a short card explains it once, ever. Seen tips are saved on the server.

	Drawn in the game's blueprint style: paper card, ink outline, hard shadow.

	Layout follows UI.luau: the ScreenGui uses CoreUISafeInsets (nothing under
	Roblox's top bar or a notch). The SKIP button sits under the HUD's distance
	plate; the card sits under the balls plate when the screen is tall enough,
	otherwise (phones) at the bottom between the corner buttons, so it never
	covers the middle of the screen where the targets are.
	On a controller, Y skips (and SKIP is selectable like any other button).
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Tutorial = {}

local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local ACCENT = Color3.fromRGB(90, 200, 255)
local DANGER = Color3.fromRGB(235, 60, 60)

local SLOW_DISTANCE = 34 -- studs before the target where time starts slowing
local FROZEN_DISTANCE = 18 -- closest the camera gets while waiting
local SLOWEST = 0.08
local TIP_SECONDS = 3.2
local TIP_SCAN_INTERVAL = 0.25
local TIP_DISTANCE = 45

-- Mirrors of UI.luau's HUD layout numbers (600x340 sheet, HUD plates at 0.85),
-- so the card and SKIP button can sit just under the HUD plates.
local REF_W, REF_H = 600, 340
local SCALE_MIN, SCALE_MAX = 0.8, 2
local HUD_SCALE = 0.85
local EDGE = 12
local HUD_TOP = EDGE - 4
local BALLS_BLOCK_H = 144 -- balls plate + controller hint + boost rail
local DISTANCE_PLATE_H = 62
local CORNER_BUTTON_W = 122 -- ball pack (bottom-right) / shield (bottom-left)
local CARD_H = 74
local CARD_SHADOW = 5
local SKIP_ACTION = "ShatterRunSkipTutorial"

-- How the player is playing right now: "gamepad", "touch" or "mouse".
-- Asked at lesson time (not at load), so plugging in a controller mid-session counts.
local function inputKind()
	local last = UserInputService:GetLastInputType()
	if string.sub(last.Name, 1, 7) == "Gamepad" then
		return "gamepad"
	elseif last == Enum.UserInputType.Touch then
		return "touch"
	elseif
		last == Enum.UserInputType.Keyboard
		or last == Enum.UserInputType.MouseMovement
		or last == Enum.UserInputType.MouseButton1
		or last == Enum.UserInputType.MouseButton2
		or last == Enum.UserInputType.MouseWheel
	then
		return "mouse"
	end
	-- No telling input yet (or gyro etc.): guess from the device.
	if GuiService:IsTenFootInterface() then
		return "gamepad"
	elseif UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return "touch"
	end
	return "mouse"
end

local THROW_TITLES = { gamepad = "PRESS R2 TO THROW", touch = "TAP TO THROW", mouse = "CLICK TO THROW" }

local LESSONS = {
	{
		title = function()
			return THROW_TITLES[inputKind()]
		end,
		body = "AIM AT THE GLASS AND SMASH IT",
	},
	{ title = "HIT THE CRYSTAL", body = "EVERY CRYSTAL GIVES YOU +" .. Config.CRYSTAL_REWARD .. " BALLS" },
	{ title = "DON'T CRASH!", body = "FLYING INTO GLASS COSTS " .. Config.CRASH_PENALTY .. " BALLS - BREAK IT FIRST" },
}

-- State --------------------------------------------------------------------

local active = false
local step = 0
local track
local scale = 1
local finishedThisSession = false
local seenThisSession = {}
local tipCooldown = 0
local tipScan = 0
local tipToken
local cardHoldUntil = 0 -- os.clock() time until which the card must stay up
local cardRest = UDim2.new(0.5, 0, 0, 92) -- where the card sits (set by layoutUi)
local cardSlide = -22 -- it slides in from this many px above (top) or below (bottom)
local skipBound = false

-- UI -------------------------------------------------------------------------

local gui, pointerGui, card, cardTitle, cardBody, ring, skipButton

local function new(className, props, children)
	local instance = Instance.new(className)
	for name, value in props do
		if name ~= "Parent" then
			instance[name] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

-- Puts the SKIP button under the distance plate and the card where it covers
-- the least: under the balls plate when there is room, else at the bottom.
local function layoutUi()
	local size = gui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return
	end
	local sheet = math.clamp(math.min(size.X / REF_W, size.Y / REF_H), SCALE_MIN, SCALE_MAX)
	local hud = sheet * HUD_SCALE

	skipButton.Position = UDim2.new(1, -EDGE, 0, math.floor(HUD_TOP + DISTANCE_PLATE_H * hud + 8))

	local top = math.floor(HUD_TOP + BALLS_BLOCK_H * hud + 10)
	local width
	if top + CARD_H <= size.Y * 0.4 then
		width = math.clamp(size.X * 0.7, 260, 460)
		card.AnchorPoint = Vector2.new(0.5, 0)
		cardRest = UDim2.new(0.5, 0, 0, top)
		cardSlide = -22
	else
		local corner = EDGE + CORNER_BUTTON_W * sheet + 8
		width = math.clamp(size.X - corner * 2 - CARD_SHADOW, 240, 460)
		card.AnchorPoint = Vector2.new(0.5, 1)
		cardRest = UDim2.new(0.5, 0, 1, -(EDGE + CARD_SHADOW))
		cardSlide = 22
	end
	card.Size = UDim2.fromOffset(math.floor(width), CARD_H)
	card.Position = cardRest
end

local function refreshSkipLabel()
	if skipButton then
		skipButton.Text = if inputKind() == "gamepad" then "Y  SKIP TUTORIAL" else "SKIP TUTORIAL"
	end
end

-- SKIP is shown (and Y bound to it) only while the tutorial is running and not paused.
local function setSkipShown(shown)
	skipButton.Visible = shown
	if shown then
		refreshSkipLabel()
	end
	if shown ~= skipBound then
		skipBound = shown
		if shown then
			ContextActionService:BindAction(SKIP_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					Tutorial.finish(true)
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.KeyCode.ButtonY)
		else
			ContextActionService:UnbindAction(SKIP_ACTION)
		end
	end
end

local function buildUi()
	-- CoreUISafeInsets keeps the card and SKIP clear of Roblox's top bar and notches.
	gui = new("ScreenGui", {
		Name = "TutorialHints",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- The pointer covers the whole screen (no insets), so its coordinates are
	-- exactly what camera:WorldToViewportPoint returns.
	pointerGui = new("ScreenGui", {
		Name = "TutorialPointer",
		ResetOnSpawn = false,
		DisplayOrder = 19,
		ScreenInsets = Enum.ScreenInsets.None,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Instruction card: placed by layoutUi, clear of the middle of the screen.
	local holder = new("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = cardRest,
		Size = UDim2.fromOffset(400, CARD_H),
		BackgroundTransparency = 1,
		Active = false,
		Visible = false,
		Parent = gui,
	})
	-- Hard ink shadow, then the paper card on top.
	new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(CARD_SHADOW, CARD_SHADOW),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = INK,
		BorderSizePixel = 0,
		Active = false,
		Parent = holder,
	})
	card = new("Frame", {
		Name = "Paper",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		Active = false,
		Parent = holder,
	}, {
		new("UIStroke", { Thickness = 2, Color = INK }),
		new("Frame", {
			Name = "Accent",
			Size = UDim2.new(0, 6, 1, 0),
			BackgroundColor3 = ACCENT,
			BorderSizePixel = 0,
		}),
	})
	cardTitle = new("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(18, 8),
		Size = UDim2.new(1, -30, 0, 32),
		BackgroundTransparency = 1,
		Font = Enum.Font.Michroma,
		TextColor3 = INK,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { new("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 12 }) })
	cardBody = new("TextLabel", {
		Name = "Body",
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -30, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.RobotoMono,
		TextColor3 = INK,
		TextTransparency = 0.15,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	}, { new("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8 }) })
	card = holder

	-- Pointer ring over the target (square ring = blueprint style, not a circle).
	ring = new("Frame", {
		Name = "Pointer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(84, 84),
		Rotation = 45,
		BackgroundTransparency = 1,
		Active = false,
		Visible = false,
		Parent = pointerGui,
	}, {
		new("UIStroke", { Thickness = 4, Color = ACCENT }),
	})

	-- 150x44: a full-size tap target; selectable so a controller can reach it too
	-- (it uses the blueprint selection box UI.luau sets on PlayerGui).
	skipButton = new("TextButton", {
		Name = "Skip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -EDGE, 0, 70),
		Size = UDim2.fromOffset(150, 44),
		BackgroundColor3 = PAPER,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Selectable = true,
		Font = Enum.Font.RobotoMono,
		Text = "SKIP TUTORIAL",
		TextColor3 = INK,
		TextScaled = true,
		Visible = false,
		Parent = gui,
	}, {
		new("UIStroke", { Thickness = 2, Color = INK, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		new("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8 }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})
	skipButton.Activated:Connect(function()
		Tutorial.finish(true)
	end)

	layoutUi()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutUi)
	UserInputService.LastInputTypeChanged:Connect(function()
		if skipButton.Visible then
			refreshSkipLabel()
		end
	end)
end

local function showCard(title, body, color)
	cardTitle.Text = title
	cardBody.Text = body
	card.Paper.Accent.BackgroundColor3 = color or ACCENT
	if not card.Visible then
		card.Visible = true
		card.Position = cardRest + UDim2.fromOffset(0, cardSlide)
		TweenService:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = cardRest }):Play()
	end
end

local function hideCard()
	card.Visible = false
	ring.Visible = false
end

-- Cards that hide themselves later (tips, "YOU'RE READY!") use this token so
-- an old timer never hides a newer card.
local function hideLater(seconds)
	local token = {}
	tipToken = token
	task.delay(seconds, function()
		if tipToken == token and not active then
			hideCard()
		end
	end)
end

local function remember(action, argument)
	task.spawn(function()
		pcall(function()
			Remotes.ShopRequest:InvokeServer(action, argument)
		end)
	end)
end

-- Tutorial -----------------------------------------------------------------

-- Only when the server has loaded the player and says they haven't done it.
function Tutorial.isNeeded()
	return not finishedThisSession and player:GetAttribute("TutorialDone") == false
end

function Tutorial.start(trackBuilder)
	if not gui then
		buildUi()
	end
	track = trackBuilder
	active = true
	step = 1
	scale = 1
	setSkipShown(true)
end

function Tutorial.isActive()
	return active
end

function Tutorial.finish(skipped)
	if not active then
		return
	end
	active = false
	finishedThisSession = true
	scale = 1
	setSkipShown(false)
	ring.Visible = false
	remember("FinishTutorial")

	if skipped then
		hideCard()
	else
		showCard("YOU'RE READY!", "GO AS FAR AS YOU CAN. GOOD LUCK!", Color3.fromRGB(80, 220, 120))
		tipCooldown = 2.5 -- don't cover it with a tip straight away
		hideLater(2)
	end
end

-- Game over screen: hide the tutorial (the SKIP button would sit on top of
-- the game over buttons). A revive shows it again.
function Tutorial.setPaused(paused)
	if not gui or not active then
		return
	end
	setSkipShown(not paused)
	if paused then
		hideCard()
	end
end

-- A lesson is done once its target is broken (gone) or collected.
local function targetDone(target)
	return target == nil or target.Parent == nil or not target.CanQuery
end

-- Call every frame while running. Returns the world time multiplier.
function Tutorial.update(dt, cameraZ)
	if not active then
		return 1
	end

	local target = track.tutorialTargets[step]
	-- Done (broken/collected), or missed and already behind the camera: next lesson.
	if step <= #LESSONS and target ~= nil then
		local passed = target.Parent ~= nil and cameraZ - target.Position.Z < -2
		if targetDone(target) or passed then
			step += 1
			target = track.tutorialTargets[step]
		end
	end
	if step > #LESSONS then
		Tutorial.finish(false)
		return 1
	end

	local wanted = 1
	local showing = false
	if target and target.Parent then
		local ahead = cameraZ - target.Position.Z
		if ahead > 0 and ahead < SLOW_DISTANCE then
			showing = true
			local lesson = LESSONS[step]
			local title = if type(lesson.title) == "function" then lesson.title() else lesson.title
			showCard(title, lesson.body, if step == 3 then DANGER else ACCENT)

			-- Ease toward almost-frozen; fully slow once close.
			local t = math.clamp((SLOW_DISTANCE - ahead) / (SLOW_DISTANCE - FROZEN_DISTANCE), 0, 1)
			wanted = 1 + (SLOWEST - 1) * t

			-- Point at the target.
			local screen, onScreen = camera:WorldToViewportPoint(target.Position)
			ring.Visible = onScreen
			if onScreen then
				ring.Position = UDim2.fromOffset(screen.X, screen.Y)
				local pulse = 1 + math.sin(os.clock() * 6) * 0.12
				ring.Size = UDim2.fromOffset(84 * pulse, 84 * pulse)
			end
		end
	end
	-- No lesson target close: hide the card and pointer (an "OOPS!" card stays
	-- up for a moment first).
	if not showing then
		ring.Visible = false
		if card.Visible and os.clock() >= cardHoldUntil then
			card.Visible = false
		end
	end

	-- Smooth so the slow-down never snaps.
	scale += (wanted - scale) * math.min(1, dt * 8)
	return scale
end

-- Crashes during the tutorial don't cost balls.
function Tutorial.crashIsFree()
	if not active then
		return false
	end
	showCard("OOPS!", "THAT WOULD HAVE COST " .. Config.CRASH_PENALTY .. " BALLS - THROW EARLIER", DANGER)
	cardHoldUntil = os.clock() + 1.5
	return true
end

-- Tips -----------------------------------------------------------------------

local function seenHints()
	local ok, list = pcall(function()
		return game:GetService("HttpService"):JSONDecode(player:GetAttribute("Hints") or "[]")
	end)
	return if ok and type(list) == "table" then list else {}
end

-- Shows a first-time tip if this player has never seen it.
function Tutorial.tip(hintId)
	local text = Config.Hints[hintId]
	if not text or active or seenThisSession[hintId] or tipCooldown > 0 then
		return
	end
	if player:GetAttribute("Hints") == nil or table.find(seenHints(), hintId) then
		return
	end
	if not gui then
		buildUi()
	end
	seenThisSession[hintId] = true
	tipCooldown = TIP_SECONDS + 0.5
	remember("SeenHint", hintId)

	showCard("NEW!", text, ACCENT)
	hideLater(TIP_SECONDS)
end

-- Looks ahead for obstacle types the player hasn't been told about yet.
function Tutorial.scanForTips(dt, cameraZ, trackBuilder)
	tipCooldown = math.max(0, tipCooldown - dt)
	tipScan -= dt
	if tipScan > 0 or active or tipCooldown > 0 then
		return
	end
	tipScan = TIP_SCAN_INTERVAL

	for _, hazard in trackBuilder:hazards() do
		local pattern = hazard:GetAttribute("Pattern")
		if pattern and Config.Hints[pattern] and not seenThisSession[pattern] then
			local ahead = cameraZ - hazard.Position.Z
			if ahead > 0 and ahead < TIP_DISTANCE then
				Tutorial.tip(pattern)
				return
			end
		end
	end
end

-- Hides everything (e.g. when going back to the menu).
function Tutorial.reset()
	active = false
	scale = 1
	tipToken = nil
	if gui then
		hideCard()
		setSkipShown(false)
	end
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	All on-screen UI: menu, HUD, game over, toasts and damage effects.

	Look: "Glass Lab" technical annotation laid over the world. Paper panels,
	ink hairlines, sharp corners, hard offset shadows, and one accent color that
	follows the current zone theme (see setTheme). Red is reserved for damage
	and revive.

	Layout is drawn on a 600x340 reference sheet. Every block carries a UIScale
	that is refit whenever the screen changes size, so a 640x360 phone and a
	1080p monitor get the same composition.

	Safe area: the ScreenGui uses CoreUISafeInsets, so nothing we draw can sit
	under Roblox's own top bar (menu / chat / "more" buttons, ~58px tall) or a
	phone notch. Full-screen washes still bleed edge to edge (see `bleed`).
	On a 640x360 phone that leaves about 640x302, so the sheet scales to ~0.89
	and every tappable thing is drawn at least 50 units tall (>= 44px there).

	Gamepad: while the last input is a controller, every screen puts the
	selection on its main button (PLAY, PLAY AGAIN / REVIVE, CLAIM...), B closes
	popovers, and small "A SELECT" style hints appear. The HUD clears the
	selection so the controller's buttons go to the game instead of the UI.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer

local UI = {}
UI.__index = UI

-- Look -----------------------------------------------------------------------
local PAPER = Color3.fromRGB(244, 241, 234)
local INK = Color3.fromRGB(17, 17, 17)
local GREY = Color3.fromRGB(112, 108, 100)
local DANGER = Color3.fromRGB(240, 38, 38)

local FONT_NUM = Enum.Font.Michroma -- numbers, titles, buttons
local FONT_LABEL = Enum.Font.RobotoMono -- small uppercase annotation

local REF_W, REF_H = 600, 340
local SCALE_MIN, SCALE_MAX = 0.8, 2
local HUD_SCALE = 0.85 -- HUD plates are drawn a bit smaller than menus
local SHADOW = 4 -- hard shadow offset behind buttons
local EDGE = 12 -- distance from the safe-area edge
local LOW_BALLS = 5
local TAB_H = 50
local FOOTER_H = 18
local MENU_H = 340 -- height of the left menu column (the full reference sheet)
local ZONE_CARD_Y = 0.3 -- zone / level card top, as a fraction of the screen (clear of the HUD plates)
local BACK_ACTION = "ShatterRunUIBack" -- ContextActionService name for gamepad B (only bound while a popover is open)

local ZONE_CARD_TIME = 1.6
local LEVEL_CARD_TIME = 2.4
local TOAST_TIME = 2
local MAX_TOASTS = 3

local TAB_NAMES = { "PLAY", "MISSIONS", "SEASON", "ZONES", "SHOP" }
local TAB_MISSIONS, TAB_SEASON = 2, 3
local GEM_PACKS = { "GemPack", "GemPackMedium", "GemPackLarge" }
-- The starter offer pops up once per session, the first time the menu opens
-- after a run (never on the very first screen, and never again once closed).
local OFFER_AFTER_MENU_OPENS = 2
local SUMMARY_TIMEOUT = 10 -- game over stops saying "TALLYING" after this
local SEASON_COLUMN_W = 56
local SEASON_COLUMN_GAP = 4
local PASS_ORDER = { "VIP", "Multiball", "Checkpoints" }
local PASS_INFO = {
	VIP = {
		code = "VIP",
		title = "VIP PASS",
		copy = string.format(
			"%dX GEMS + %d EXTRA BALLS EVERY RUN",
			Config.GamePasses.VIP.GemMultiplier or 2,
			Config.GamePasses.VIP.ExtraStartBalls or 0
		),
	},
	Multiball = { code = "x2", title = "MULTIBALL", copy = "NEVER DROP BELOW x2 MULTIBALL" },
	Checkpoints = { code = "CP", title = "CHECKPOINTS", copy = "START FROM ANY ZONE YOU'VE REACHED" },
}

-- Boosts (picked before a run, shown on the HUD while active).
local BOOST_ORDER = Config.BOOST_ORDER or {}
local MAX_PICKS = Config.MAX_BOOSTS_PER_RUN or 3
local LOW_BALLS_OFFER = Config.LOW_BALLS_OFFER or 8
local BOOST_CHIP_H = 50
local BOOST_CHIP_GAP = 1
local BOOST_POP_H = 110
local POP_CLOSE = 50 -- the popover's X is a 50x50 tap area in its top-right corner
local TOPUP_H = 56
local TOPUP_BUY_W = 84
local TOPUP_CLOSE_W = 50
local SHIELD_USED_HOLD = 0.9 -- seconds the HUD shield plate reads USED after a crash

local TOAST_KINDS = {
	boost = { tag = "BOOSTS ACTIVE", accent = true },
	gift = { tag = "WELCOME GIFT", accent = true },
	multiball = { tag = "MULTIBALL", accent = true },
	reward = { tag = "REWARD", accent = true },
	level = { tag = "LEVEL UP", accent = true },
	info = { tag = "NOTE", accent = false },
	error = { tag = "ERROR", accent = false, hatch = true },
}

local rng = Random.new()

-- Shared registries (one UI per client) ---------------------------------------

local accentColor = Config.Themes[1].Accent
local accentTargets = {} -- instance -> property (pruned in setTheme once unparented)
local scalers = {} -- { uiScale, multiplier }
local textCaps = {} -- { constraint, label, max, min }
local currentScale = 1

-- Small helpers ----------------------------------------------------------------

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function commas(n)
	local s = tostring(math.floor(tonumber(n) or 0))
	local sign, digits = string.match(s, "^(-?)(%d+)$")
	if not digits then
		return s
	end
	local out = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return sign .. out
end

local function twoDigits(n)
	return string.format("%02d", math.max(0, math.floor(tonumber(n) or 0)))
end

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

local function themeFor(zone)
	return Config.Themes[zone % #Config.Themes + 1]
end

local function ownedSkins()
	local owned = { Default = true, Classic = true }
	local raw = player:GetAttribute("OwnedSkins")
	if type(raw) == "string" then
		local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(list) == "table" then
			for _, id in list do
				if type(id) == "string" then
					owned[id] = true
				end
			end
		end
	end
	return owned
end

local function hasPass(key)
	return player:GetAttribute("Pass_" .. key) == true
end

-- Progression data ------------------------------------------------------------------
-- The server mirrors progress to attributes (some as JSON). Any of them may be
-- missing before data loads, so every reader falls back to something safe.

local function decodeJson(raw)
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok then
		return value
	end
	return nil
end

local function attrNumber(name, default)
	local value = tonumber(player:GetAttribute(name))
	if value == nil or value ~= value then
		return default
	end
	return value
end

local function ownedFx()
	local owned = { Classic = true }
	local decoded = decodeJson(player:GetAttribute("OwnedFx"))
	if type(decoded) == "table" then
		for _, id in decoded do
			if type(id) == "string" then
				owned[id] = true
			end
		end
	end
	return owned
end

local function levelInfo()
	local level = math.max(1, math.floor(attrNumber("Level", 1)))
	local needed = math.max(1, math.floor(attrNumber("XPNeeded", Config.xpForLevel(level))))
	local xp = math.clamp(math.floor(attrNumber("XP", 0)), 0, needed)
	return level, xp, needed
end

local function skinName(id)
	local skin = Config.getSkin(id)
	return string.upper(if skin and skin.Id == id then skin.Name else tostring(id))
end

local function fxName(id)
	local fx = Config.getFx(id)
	return string.upper(if fx and fx.Id == id then fx.Name else tostring(id))
end

local function boostInfo(id)
	local boosts = Config.Boosts
	return if type(boosts) == "table" then boosts[id] else nil
end

local function boostName(id)
	local boost = boostInfo(id)
	return if boost and boost.Name then string.upper(boost.Name) else string.upper(tostring(id))
end

-- Boost inventory from the Boosts attribute: { [boostId] = count } (unknown ids dropped).
local function ownedBoosts()
	local counts = {}
	local decoded = decodeJson(player:GetAttribute("Boosts"))
	if type(decoded) == "table" then
		for id, count in decoded do
			if type(id) == "string" and boostInfo(id) then
				local n = tonumber(count)
				counts[id] = if n and n == n then math.max(0, math.floor(n)) else 0
			end
		end
	end
	return counts
end

-- A developer product's id, or 0 when it isn't set up (0 hides that offer).
local function productId(key)
	local product = Config.Products[key]
	return if type(product) == "table" and tonumber(product.Id) then product.Id else 0
end

-- "+70 GEMS", "NEONITE SKIN", "SHATTERBORN SKIN + SUPERNOVA FX"...
local function rewardText(reward)
	if type(reward) ~= "table" then
		return ""
	end
	local parts = {}
	if reward.Gems then
		table.insert(parts, "+" .. commas(reward.Gems) .. " GEMS")
	end
	if reward.Skin then
		table.insert(parts, skinName(reward.Skin) .. " SKIN")
	end
	if reward.Fx then
		table.insert(parts, fxName(reward.Fx) .. " FX")
	end
	if reward.Boost then
		table.insert(parts, boostName(reward.Boost) .. " BOOST")
	end
	if reward.Balls then
		table.insert(parts, "+" .. commas(reward.Balls) .. " BALLS")
	end
	return table.concat(parts, " + ")
end

-- The first level unlock above `level`, or nil once they are all earned.
local function nextUnlock(level)
	local best = nil
	for unlockLevel, reward in Config.LevelUnlocks do
		if unlockLevel > level and (best == nil or unlockLevel < best) then
			best = unlockLevel
		end
	end
	return best, best and Config.LevelUnlocks[best]
end

-- "3D 04H", or hh:mm:ss under a day.
local function longClock(seconds)
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 86400 then
		return string.format("%dD %02dH", seconds // 86400, (seconds % 86400) // 3600)
	end
	return clock(seconds)
end

local function rainbowSequence()
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)))
	end
	return ColorSequence.new(keys)
end

-- Prices are fetched once per id and cached; waiters are called when it lands.
local priceCache = {}
local priceWaiters = {}

local function withPrice(id, infoType, onPrice)
	if not id or id == 0 then
		return
	end
	local key = tostring(infoType) .. ":" .. tostring(id)
	local cached = priceCache[key]
	if cached ~= nil then
		if cached then
			onPrice(cached)
		end
		return
	end
	if priceWaiters[key] then
		table.insert(priceWaiters[key], onPrice)
		return
	end
	priceWaiters[key] = { onPrice }
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
		local price = ok and type(info) == "table" and info.PriceInRobux or false
		priceCache[key] = price
		local waiters = priceWaiters[key]
		priceWaiters[key] = nil
		if price then
			for _, waiter in waiters do
				task.spawn(waiter, price)
			end
		end
	end)
end

-- Builders -------------------------------------------------------------------------

-- Creates an instance. Non-button GuiObjects are never Active, so nothing but
-- real buttons can swallow a tap meant for throwing.
local function new(className, props, children)
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
		if not inst:IsA("GuiButton") then
			inst.Active = false
		end
	end
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function text(props)
	local merged = {
		BackgroundTransparency = 1,
		Font = FONT_LABEL,
		TextColor3 = INK,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}
	for key, value in props do
		merged[key] = value
	end
	return new("TextLabel", merged)
end

local function setAccent(inst, prop)
	inst[prop] = accentColor
	accentTargets[inst] = prop
	return inst
end

local function clearAccent(inst)
	accentTargets[inst] = nil
end

local function fit(guiObject, multiplier)
	local s = new("UIScale", { Scale = currentScale * (multiplier or 1), Parent = guiObject })
	table.insert(scalers, { s, multiplier or 1 })
	return s
end

local function effectiveScale(inst)
	local s = 1
	local node = inst
	while node and not node:IsA("LayerCollector") do
		local scale = node:FindFirstChildOfClass("UIScale")
		if scale then
			s *= scale.Scale
		end
		node = node.Parent
	end
	return s
end

local function applyCap(entry)
	local constraint, label, max, min = entry[1], entry[2], entry[3], entry[4]
	if constraint.Parent == nil then
		return
	end
	constraint.MaxTextSize = math.clamp(math.floor(max * effectiveScale(label) + 0.5), min, 100)
end

-- TextScaled that stops at the designed size (scaled with the sheet), so text
-- only ever shrinks to fit and never balloons on big screens.
local function capText(label, max, min)
	label.TextScaled = true
	local constraint = new("UITextSizeConstraint", { MaxTextSize = max, MinTextSize = min or 7, Parent = label })
	local entry = { constraint, label, max, min or 7 }
	-- Menus rebuild rows often; drop entries for labels that were destroyed.
	if #textCaps > 200 then
		local alive = {}
		for _, existing in textCaps do
			if existing[1].Parent ~= nil then
				table.insert(alive, existing)
			end
		end
		textCaps = alive
	end
	table.insert(textCaps, entry)
	task.defer(applyCap, entry)
	return label
end

local function stroke(parent, thickness, color, transparency)
	return new("UIStroke", {
		Thickness = thickness or 1,
		Color = color or INK,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = parent,
	})
end

local function rule(parent, props)
	local merged = { BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 1) }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	return new("Frame", merged)
end

-- Registration ticks just outside each corner, like print crop marks.
local function cropMarks(parent, len, gap, transparency)
	for _, corner in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local sx, sy = corner[1], corner[2]
		local dx, dy = sx * 2 - 1, sy * 2 - 1
		rule(parent, {
			Name = "Crop",
			BackgroundTransparency = transparency or 0,
			AnchorPoint = Vector2.new(1 - sx, 0.5),
			Position = UDim2.new(sx, dx * gap, sy, 0),
			Size = UDim2.fromOffset(len, 1),
		})
		rule(parent, {
			Name = "Crop",
			BackgroundTransparency = transparency or 0,
			AnchorPoint = Vector2.new(0.5, 1 - sy),
			Position = UDim2.new(sx, 0, sy, dy * gap),
			Size = UDim2.fromOffset(1, len),
		})
	end
end

-- L-shaped viewfinder brackets inside each corner.
local function brackets(parent, len, thickness, transparency)
	for _, corner in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		local anchor = Vector2.new(corner[1], corner[2])
		local position = UDim2.fromScale(corner[1], corner[2])
		for _, size in { UDim2.fromOffset(len, thickness), UDim2.fromOffset(thickness, len) } do
			rule(parent, {
				Name = "Bracket",
				BackgroundTransparency = transparency or 0,
				AnchorPoint = anchor,
				Position = position,
				Size = size,
			})
		end
	end
end

-- A solid triangle filling one corner (cx, cy in {0, 1}): the chamfered/cut-corner mark.
-- Built from a square with a hard-stepped diagonal gradient, so it needs no image.
local function notch(parent, size, cx, cy, color)
	local frame = new("Frame", {
		Name = "Notch",
		AnchorPoint = Vector2.new(cx, cy),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or INK,
		Parent = parent,
	})
	if color == nil then
		setAccent(frame, "BackgroundColor3")
	end
	new("UIGradient", {
		Rotation = math.deg(math.atan2(cy * 2 - 1, cx * 2 - 1)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.499, 1),
			NumberSequenceKeypoint.new(0.501, 0),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = frame,
	})
	return frame
end

-- Diagonal hazard hatching from a striped transparency gradient.
local function hatch(parent, props, color, transparency, stripes)
	local frame = new("Frame", props)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Parent = parent
	local keys = {}
	local count = stripes or 4
	local e = 0.001
	for i = 0, count - 1 do
		local a = i / count
		local m = a + 0.5 / count
		table.insert(keys, NumberSequenceKeypoint.new(a, 0))
		table.insert(keys, NumberSequenceKeypoint.new(m - e, 0))
		table.insert(keys, NumberSequenceKeypoint.new(m, 1))
		table.insert(keys, NumberSequenceKeypoint.new((i + 1) / count - e, 1))
	end
	table.insert(keys, NumberSequenceKeypoint.new(1, 0))
	new("UIGradient", { Rotation = 60, Transparency = NumberSequence.new(keys), Parent = frame })
	return frame
end

-- The gem mark: an accent diamond with an ink outline.
local function gemIcon(parent, size, position)
	local diamond = new("Frame", {
		Name = "Gem",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		Rotation = 45,
		Parent = parent,
	})
	setAccent(diamond, "BackgroundColor3")
	stroke(diamond, 1)
	return diamond
end

local function blueprintGrid(parent, columns, rows, transparency)
	local grid = new("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = parent })
	for i = 1, columns - 1 do
		rule(grid, { BackgroundTransparency = transparency, Position = UDim2.fromScale(i / columns, 0), Size = UDim2.new(0, 1, 1, 0) })
	end
	for i = 1, rows - 1 do
		rule(grid, { BackgroundTransparency = transparency, Position = UDim2.fromScale(0, i / rows), Size = UDim2.new(1, 0, 0, 1) })
	end
	return grid
end

-- A full-bleed frame that also covers the notch / home-bar areas outside the safe insets.
local function bleed(parent, props)
	local merged = { Position = UDim2.fromOffset(-200, -200), Size = UDim2.new(1, 400, 1, 400) }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	return new("Frame", merged)
end

-- Ruler strip: ticks every `spacing` px, taller every `major` ticks.
local function rulerTicks(parent, width, height, spacing, major, transparency)
	local count = math.floor(width / spacing)
	for i = 0, count do
		local isMajor = i % major == 0
		rule(parent, {
			BackgroundTransparency = transparency or 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, i * spacing, 1, 0),
			Size = UDim2.fromOffset(1, if isMajor then height else math.floor(height * 0.45)),
		})
	end
end

local FILLS = {
	accent = { text = INK },
	paper = { bg = PAPER, text = INK },
	ink = { bg = INK, text = PAPER },
	danger = { bg = DANGER, text = PAPER },
}

--[[
	Poster-style button: a face with a 2px ink outline sitting on a solid ink
	block offset by SHADOW px. It presses down 2px while held.
	The holder itself is the (invisible) button, so the tap area and the gamepad
	selection cover the face *and* its shadow: a 50-tall button stays >= 44px
	even on the smallest phone sheet.
	opts: Name, Size, Position, AnchorPoint, LayoutOrder, Fill, Text, TextSize,
	Align, Index (small label top-left), Sub (small second line), OnClick
]]
local function hardButton(parent, opts)
	local holder = new("TextButton", {
		Name = opts.Name or "Button",
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundTransparency = 1,
		Size = opts.Size,
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = parent,
	})
	local shadow = new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = INK,
		Position = UDim2.fromOffset(SHADOW, SHADOW),
		Size = UDim2.new(1, -SHADOW, 1, -SHADOW),
		Parent = holder,
	})
	local face = new("Frame", {
		Name = "Face",
		BackgroundColor3 = PAPER,
		Size = UDim2.new(1, -SHADOW, 1, -SHADOW),
		Parent = holder,
	})
	stroke(face, 2)

	local align = opts.Align or Enum.TextXAlignment.Center
	local top = if opts.Index then 11 else 0
	local split = if opts.Sub then 0.6 else 1

	local index = nil
	if opts.Index then
		index = text({
			Name = "Index",
			Text = opts.Index,
			TextSize = 8,
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.new(1, -16, 0, 9),
			Parent = face,
		})
	end
	local label = text({
		Name = "Label",
		Font = FONT_NUM,
		Text = opts.Text or "",
		TextXAlignment = align,
		TextYAlignment = if opts.Sub then Enum.TextYAlignment.Bottom else Enum.TextYAlignment.Center,
		Position = UDim2.new(0, 8, 0, top),
		Size = UDim2.new(1, -16, split, -top),
		Parent = face,
	})
	capText(label, opts.TextSize or 13, 7)
	local sub = nil
	if opts.Sub then
		sub = text({
			Name = "Sub",
			Text = opts.Sub,
			TextSize = 9,
			TextXAlignment = align,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.new(0, 8, split, 1),
			Size = UDim2.new(1, -16, 1 - split, -2),
			Parent = face,
		})
	end

	local button = { holder = holder, face = face, label = label, sub = sub, index = index, enabled = true }

	function button.setFill(kind)
		local fill = FILLS[kind] or FILLS.paper
		if kind == "accent" then
			setAccent(face, "BackgroundColor3")
		else
			clearAccent(face)
			face.BackgroundColor3 = fill.bg
		end
		label.TextColor3 = fill.text
		if sub then
			sub.TextColor3 = fill.text
		end
		if index then
			index.TextColor3 = fill.text
		end
	end

	function button.setEnabled(enabled)
		button.enabled = enabled
		shadow.Visible = enabled
		face.Position = if enabled then UDim2.new() else UDim2.fromOffset(2, 2)
		label.TextTransparency = if enabled then 0 else 0.35
	end

	function button.setText(value)
		label.Text = value
	end

	local function release()
		if button.enabled then
			tween(face, 0.18, { Position = UDim2.new() }, Enum.EasingStyle.Back)
		end
	end

	holder.MouseButton1Down:Connect(function()
		if button.enabled then
			tween(face, 0.06, { Position = UDim2.fromOffset(2, 2) })
		end
	end)
	holder.MouseButton1Up:Connect(release)
	holder.MouseLeave:Connect(release)
	holder.Activated:Connect(function()
		release()
		if button.enabled and opts.OnClick then
			opts.OnClick()
		end
	end)

	button.setFill(opts.Fill or "paper")
	return button
end

local function sectionHeader(parent, order, index, title)
	local row = new("Frame", {
		Name = title,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = order,
		Parent = parent,
	})
	text({ Text = index .. "  " .. title, TextSize = 10, Size = UDim2.new(0.6, 0, 1, -3), Parent = row })
	local right = text({
		Text = "",
		TextSize = 9,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromScale(0.35, 0),
		Size = UDim2.new(0.65, 0, 1, -3),
		Parent = row,
	})
	rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	local tick = new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(18, 3),
		Parent = row,
	})
	setAccent(tick, "BackgroundColor3")
	return row, right
end

local function list(parent, padding)
	return new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, padding or 0),
		Parent = parent,
	})
end

local function clearRows(container)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Thin measurement bar: faint ink track with an accent fill (0..1).
local function meter(parent, props, height)
	local merged = { BackgroundColor3 = INK, BackgroundTransparency = 0.82, Size = UDim2.new(1, 0, 0, height or 4) }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local track = new("Frame", merged)
	local fill = new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), Parent = track })
	setAccent(fill, "BackgroundColor3")
	return track, fill
end

-- Rubber stamp: outlined slab with double rules, like NEW BEST on the run report.
local function stamp(parent, label, props, fill)
	local merged = { Name = "Stamp", AnchorPoint = Vector2.new(0.5, 0.5), Rotation = -8 }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local frame = new("Frame", merged)
	if fill == "accent" then
		setAccent(frame, "BackgroundColor3")
	else
		frame.BackgroundColor3 = PAPER
		frame.BackgroundTransparency = if fill == "clear" then 1 else 0
	end
	stroke(frame, 1.5)
	rule(frame, { Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 0, 1) })
	rule(frame, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 3, 1, -3), Size = UDim2.new(1, -6, 0, 1) })
	local textLabel = capText(text({
		Name = "Label",
		Text = label,
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.new(1, -8, 1, 0),
		Parent = frame,
	}), 11, 6)
	return frame, textLabel
end

-- Small ink tag with paper (or accent) text: "LOCKED", "BEST VALUE"...
local function tag(parent, label, props, accentText)
	local merged = { Name = "Tag", BackgroundColor3 = INK }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local frame = new("Frame", merged)
	local textLabel = text({
		Text = label,
		TextSize = 8,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = frame,
	})
	if accentText then
		setAccent(textLabel, "TextColor3")
	end
	return frame, textLabel
end

-- One triangular glass shard (hard-stepped diagonal gradient, no image).
local function shard(parent, x, y, size, rotation, color)
	local frame = new("Frame", {
		Name = "Shard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(size, size),
		Rotation = rotation,
		BackgroundColor3 = color,
		Parent = parent,
	})
	new("UIGradient", {
		Rotation = 45,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.499, 0),
			NumberSequenceKeypoint.new(0.501, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = frame,
	})
	return frame
end

local SHARD_LAYOUT = {
	{ 0.5, 0.52, 16, 10 },
	{ 0.3, 0.32, 11, 70 },
	{ 0.7, 0.3, 10, -40 },
	{ 0.24, 0.72, 9, 150 },
	{ 0.76, 0.7, 12, 200 },
	{ 0.52, 0.16, 7, 120 },
	{ 0.12, 0.46, 6, 30 },
	{ 0.88, 0.48, 7, -110 },
	{ 0.5, 0.88, 7, 260 },
}

-- Ink sample plate showing shards in an effect's color.
local function fxSwatch(parent, fx, props, scale)
	local merged = { Name = "Swatch", BackgroundColor3 = INK }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local plate = new("Frame", merged)
	plate.ClipsDescendants = true
	scale = scale or 1
	for i, spec in SHARD_LAYOUT do
		local color = fx.Color or Config.GLASS_COLOR
		if fx.Rainbow then
			color = Color3.fromHSV((i - 1) / #SHARD_LAYOUT, 0.7, 1)
		end
		shard(plate, spec[1], spec[2], math.floor(spec[3] * scale + 0.5), spec[4], color)
	end
	if fx.Sparkle then
		for _, spot in { { 0.38, 0.5 }, { 0.62, 0.42 }, { 0.42, 0.22 }, { 0.66, 0.8 }, { 0.2, 0.2 } } do
			new("Frame", {
				BackgroundColor3 = PAPER,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(spot[1], spot[2]),
				Size = UDim2.fromOffset(2, 2),
				Parent = plate,
			})
		end
	end
	return plate
end

-- Tiny color sample for a reward (skin color, fx color, or the gem mark).
local function rewardChip(parent, reward, size, position)
	if type(reward) ~= "table" then
		return nil
	end
	if reward.Skin or reward.Fx then
		local item = if reward.Skin then Config.getSkin(reward.Skin) else Config.getFx(reward.Fx)
		local chip = new("Frame", {
			Name = "Chip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = item.Color or Config.GLASS_COLOR,
			Parent = parent,
		})
		stroke(chip, 1)
		if item.Rainbow then
			new("UIGradient", { Color = rainbowSequence(), Rotation = 20, Parent = chip })
		end
		if reward.Fx and not reward.Skin then
			chip.Rotation = 45 -- effects read as diamonds, skins as squares
		end
		return chip
	end
	if reward.Boost then
		local boost = boostInfo(reward.Boost)
		local chip = new("Frame", {
			Name = "Chip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = boost and boost.Color or INK,
			Parent = parent,
		})
		stroke(chip, 1)
		-- Boosts read as a square with an ink bar through it (a "capsule" mark).
		rule(chip, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 1) })
		return chip
	end
	return gemIcon(parent, math.floor(size * 0.8), position)
end

-- Shield mark: a flat top half over a diamond, which reads as a pointed crest.
local function shieldGlyph(parent, size, position, color)
	local holder = new("Frame", {
		Name = "ShieldGlyph",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	new("Frame", { BackgroundColor3 = color, Size = UDim2.new(1, 0, 0.5, 0), Parent = holder })
	local tip = math.floor(size * 0.707 + 0.5)
	new("Frame", {
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(tip, tip),
		Rotation = 45,
		Parent = holder,
	})
	return holder
end

-- Gamepad helpers ------------------------------------------------------------------------

-- "gamepad", "pointer" (mouse / keyboard / touch), or nil for inputs that say
-- nothing about how the player is playing (gyro, focus, text input...).
local function inputKind(inputType)
	if string.sub(inputType.Name, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	if
		inputType == Enum.UserInputType.Touch
		or inputType == Enum.UserInputType.Keyboard
		or inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseButton3
		or inputType == Enum.UserInputType.MouseWheel
	then
		return "pointer"
	end
	return nil
end

local function gamepadAtStart()
	local kind = inputKind(UserInputService:GetLastInputType())
	if kind then
		return kind == "gamepad" and UserInputService.GamepadEnabled
	end
	return GuiService:IsTenFootInterface() -- console with no input yet
end

-- Visible on screen: itself and every ancestor up to an enabled ScreenGui.
local function onScreen(inst)
	if inst == nil or inst.Parent == nil then
		return false
	end
	local node = inst
	while node do
		if node:IsA("LayerCollector") then
			return node.Enabled
		end
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return false
end

-- The first selectable button under `container` that is showing, or nil.
local function firstSelectable(container)
	if container == nil then
		return nil
	end
	for _, inst in container:GetDescendants() do
		if inst:IsA("GuiButton") and inst.Selectable and onScreen(inst) then
			return inst
		end
	end
	return nil
end

-- Gamepad selection outline: a thick accent box with an ink hairline inside,
-- sharp corners, a few px outside the selected button.
local function selectionBox()
	local box = Instance.new("Frame")
	box.Name = "Selection"
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Position = UDim2.fromOffset(-5, -5)
	box.Size = UDim2.new(1, 10, 1, 10)
	local accentStroke = stroke(box, 3, accentColor)
	local inner = new("Frame", {
		Name = "Hairline",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		Parent = box,
	})
	stroke(inner, 1, INK)
	return box, accentStroke
end

-- Small controller hint row: ink keycap + label per pair, e.g. { {"A", "SELECT"}, {"B", "BACK"} }.
-- Hidden unless the player is on a gamepad (see _refreshHints).
local function inputHint(parent, entries, props, alignment)
	local merged = { Name = "InputHint", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Visible = false }
	for key, value in props do
		merged[key] = value
	end
	merged.Parent = parent
	local row = new("Frame", merged)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = alignment or Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = row,
	})
	for i, pair in entries do
		local cap = new("Frame", {
			Name = "Key",
			BackgroundColor3 = INK,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 14, 1, 0),
			LayoutOrder = i * 2 - 1,
			Parent = row,
		})
		new("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = cap })
		text({
			Text = pair[1],
			TextSize = 8,
			TextColor3 = PAPER,
			TextXAlignment = Enum.TextXAlignment.Center,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 8, 1, 0),
			Parent = cap,
		})
		local word = text({
			Name = "Action",
			Text = pair[2],
			TextSize = 8,
			BackgroundColor3 = PAPER,
			BackgroundTransparency = 0.1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 8, 1, 0),
			LayoutOrder = i * 2,
			Parent = row,
		})
		new("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 5), Parent = word })
	end
	return row
end

-- Explicit gamepad neighbours for a grid of buttons (row-major, `columns` wide).
-- Links left as nil fall back to Roblox's automatic choice.
local function linkGrid(buttons, columns)
	local count = #buttons
	for i, button in buttons do
		local column = (i - 1) % columns
		button.NextSelectionLeft = if column > 0 then buttons[i - 1] else nil
		button.NextSelectionRight = if column < columns - 1 and i < count then buttons[i + 1] else nil
		button.NextSelectionUp = if i > columns then buttons[i - columns] else nil
		local below = buttons[i + columns]
		if below == nil and i + columns - column <= count then
			below = buttons[count] -- short last row: drop to its last button
		end
		button.NextSelectionDown = below
	end
end

-- Menu ---------------------------------------------------------------------------------

function UI._buildMenu(self)
	local m = {}
	self._menu = m

	local root = new("Frame", { Name = "Menu", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	m.root = root

	-- Paper wash on the left so the logotype reads; the corridor stays visible on the right.
	local wash = bleed(root, { Name = "Wash", BackgroundColor3 = PAPER })
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.32, 0.2),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = wash,
	})
	blueprintGrid(root, 12, 8, 0.93)

	-- Vanishing-point crosshair over the track preview.
	local cross = new("Frame", {
		Name = "Crosshair",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 22),
		Parent = root,
	})
	fit(cross)
	rule(cross, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 0.3 })
	rule(cross, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundTransparency = 0.3 })
	text({ Text = "VP / 0 M", TextSize = 8, Position = UDim2.fromOffset(14, 13), Size = UDim2.fromOffset(60, 10), TextTransparency = 0.3, Parent = cross })

	self:_buildMenuLeft(root)
	self:_buildMenuPanel(root)
	self:_buildTopUp(root)
	self:_buildModal(root)
end

function UI._buildMenuLeft(self, root)
	local m = self._menu
	local left = new("Frame", {
		Name = "Left",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, EDGE + 4, 0.5, 0),
		Size = UDim2.fromOffset(256, MENU_H),
		Parent = root,
	})
	fit(left)
	m.left = left

	-- Index line
	local chip = new("Frame", { Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(6, 6), Parent = left })
	setAccent(chip, "BackgroundColor3")
	text({ Text = "SR-01 / GLASS LAB / FIELD TEST", TextSize = 8, Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(244, 12), Parent = left })

	-- Logotype: SHATTER is split along a crack, the right shard knocked out of
	-- register, with an accent misprint behind it. RUN sits in a solid ink block.
	local logo = new("Frame", { Name = "Logo", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 16), Size = UDim2.fromOffset(256, 50), Parent = left })
	local function word(parent, props)
		local merged = { Text = "SHATTER", Font = FONT_NUM, TextYAlignment = Enum.TextYAlignment.Center }
		for key, value in props do
			merged[key] = value
		end
		merged.Parent = parent
		return capText(text(merged), 46, 20)
	end
	local ghost = word(logo, { Position = UDim2.fromOffset(3, 3), Size = UDim2.fromScale(1, 1) })
	setAccent(ghost, "TextColor3")
	local SPLIT = 0.57
	local leftShard = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.fromScale(SPLIT, 1), Parent = logo })
	word(leftShard, { Size = UDim2.fromScale(1 / SPLIT, 1) })
	local rightShard = new("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.new(SPLIT, 2, 0, 3),
		Size = UDim2.fromScale(1 - SPLIT, 1),
		Parent = logo,
	})
	word(rightShard, { Position = UDim2.fromScale(-SPLIT / (1 - SPLIT), 0), Size = UDim2.fromScale(1 / (1 - SPLIT), 1) })
	new("Frame", {
		Name = "Crack",
		BackgroundColor3 = PAPER,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(SPLIT, 1, 0.5, 0),
		Size = UDim2.fromOffset(3, 62),
		Rotation = 16,
		Parent = logo,
	})
	rule(logo, {
		Name = "CrackLine",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(SPLIT, 5, 0.5, 6),
		Size = UDim2.fromOffset(1, 78),
		Rotation = 16,
	})

	local runBlock = new("Frame", { Name = "Run", BackgroundColor3 = INK, Position = UDim2.fromOffset(0, 70), Size = UDim2.fromOffset(112, 40), Parent = left })
	capText(text({ Text = "RUN", Font = FONT_NUM, TextColor3 = PAPER, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = runBlock }), 28, 12)
	notch(runBlock, 10, 1, 0)
	text({
		Text = "GLIDE.\nTHROW.\nSHATTER.",
		TextSize = 9,
		LineHeight = 1.05,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = UDim2.fromOffset(122, 70),
		Size = UDim2.fromOffset(134, 40),
		Parent = left,
	})

	-- Stats strip
	-- Stats strip: BEST | GEMS | LEVEL badge, with the XP bar along the bottom edge.
	local stats = new("Frame", { Name = "Stats", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 120), Size = UDim2.fromOffset(256, 46), Parent = left })
	rule(stats, {})
	rule(stats, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	rule(stats, { Position = UDim2.fromOffset(92, 8), Size = UDim2.new(0, 1, 1, -18) })
	rule(stats, { Position = UDim2.fromOffset(176, 8), Size = UDim2.new(0, 1, 1, -18) })
	text({ Text = "BEST / M", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(0, 5), Size = UDim2.fromOffset(88, 10), Parent = stats })
	m.best = capText(text({ Text = "0", Font = FONT_NUM, Position = UDim2.fromOffset(0, 17), Size = UDim2.fromOffset(88, 22), Parent = stats }), 16, 8)
	gemIcon(stats, 7, UDim2.fromOffset(104, 10))
	text({ Text = "GEMS", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(114, 5), Size = UDim2.fromOffset(60, 10), Parent = stats })
	m.gems = capText(text({ Text = "0", Font = FONT_NUM, Position = UDim2.fromOffset(100, 17), Size = UDim2.fromOffset(72, 22), Parent = stats }), 16, 8)

	local badge = new("Frame", { Name = "Level", BackgroundColor3 = INK, Position = UDim2.fromOffset(184, 6), Size = UDim2.fromOffset(72, 32), Parent = stats })
	notch(badge, 8, 1, 0)
	text({ Text = "LEVEL", TextSize = 7, TextColor3 = PAPER, TextTransparency = 0.35, Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(50, 9), Parent = badge })
	m.level = capText(text({ Text = "LV 01", Font = FONT_NUM, TextColor3 = PAPER, Position = UDim2.fromOffset(6, 11), Size = UDim2.fromOffset(62, 18), Parent = badge }), 13, 7)
	m.levelBump = new("UIScale", { Parent = badge })
	local _, xpFill = meter(stats, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -1) }, 3)
	m.xpFill = xpFill
	m.xpNote = text({
		Text = "",
		TextSize = 7,
		TextColor3 = GREY,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(0, 167),
		Size = UDim2.fromOffset(256, 9),
		Parent = left,
	})

	-- Boost picker: one chip per boost, right above PLAY.
	self:_buildBoostPicker(left, 178)

	-- PLAY
	local play = hardButton(left, {
		Name = "Play",
		Fill = "accent",
		Text = "PLAY",
		TextSize = 26,
		Align = Enum.TextXAlignment.Left,
		Index = "A / START RUN / 0 M",
		Position = UDim2.fromOffset(0, 232),
		Size = UDim2.fromOffset(256, 54),
		OnClick = function()
			self:_fire("onPlay", 0, self:_pickedBoosts())
		end,
	})
	hatch(play.face, { Name = "Hatch", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 46, 1, -16) }, INK, 0, 4)
	m.play = play

	-- DAILY: opens the 7-day streak sheet. The pips on the right show the streak at a glance.
	local daily = hardButton(left, {
		Name = "Daily",
		Fill = "paper",
		Text = "--:--:--",
		TextSize = 13,
		Align = Enum.TextXAlignment.Left,
		Index = "B / DAILY",
		Position = UDim2.fromOffset(0, 290),
		Size = UDim2.fromOffset(256, 50),
		OnClick = function()
			self:_openDaily()
		end,
	})
	daily.label.Size = UDim2.new(1, -104, 1, -11)
	local pipRow = new("Frame", {
		Name = "Streak",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 4),
		Size = UDim2.fromOffset(#Config.DailyStreak * 12 - 2, 12),
		Parent = daily.face,
	})
	m.dailyPips = {}
	for day = 1, #Config.DailyStreak do
		local isBig = day == #Config.DailyStreak
		local pip = new("Frame", {
			Name = "Day" .. day,
			BackgroundColor3 = INK,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((day - 1) * 12 + 5, 6),
			Size = if isBig then UDim2.fromOffset(9, 9) else UDim2.fromOffset(8, 8),
			Rotation = if isBig then 45 else 0,
			Parent = pipRow,
		})
		local pipStroke = stroke(pip, 1)
		m.dailyPips[day] = { frame = pip, stroke = pipStroke }
	end
	m.daily = daily
end

-- Boost picker ------------------------------------------------------------------------------
-- Chips toggle which owned boosts go into the next run (up to MAX_PICKS). A chip
-- with none owned shows a "+" and opens a small buy popover above the strip.

function UI._buildBoostPicker(self, left, y)
	local m = self._menu
	m.boostPicks = {}
	m.boostChips = {}
	m.boostChipList = {}
	local count = #BOOST_ORDER
	if count == 0 then
		return
	end
	local width = 256
	local gap = BOOST_CHIP_GAP -- tight, so 5 chips stay >= 50 wide (44px on a phone)
	local chipW = math.floor((width - gap * (count - 1)) / count)
	local strip = new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.fromOffset(width, BOOST_CHIP_H),
		Parent = left,
	})
	m.boostStrip = strip
	m.boostChipW = chipW

	for i, id in BOOST_ORDER do
		if boostInfo(id) then
			-- The holder is the button, so the whole chip (shadow included) is the tap / selection area.
			local holder = new("TextButton", {
				Name = id,
				AutoButtonColor = false,
				Text = "",
				Selectable = true,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset((i - 1) * (chipW + gap), 0),
				Size = UDim2.fromOffset(chipW, BOOST_CHIP_H),
				Parent = strip,
			})
			local bump = new("UIScale", { Parent = holder })
			local shadow = new("Frame", {
				Name = "Shadow",
				BackgroundColor3 = INK,
				Position = UDim2.fromOffset(2, 2),
				Size = UDim2.new(1, -2, 1, -2),
				Visible = false,
				Parent = holder,
			})
			local face = new("Frame", {
				Name = "Face",
				BackgroundColor3 = PAPER,
				Size = UDim2.new(1, -2, 1, -2),
				Parent = holder,
			})
			local outline = stroke(face, 1, INK, 0.5)
			rewardChip(face, { Boost = id }, 7, UDim2.fromOffset(8, 8))
			local countLabel = text({
				Name = "Count",
				Text = "x0",
				TextSize = 8,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.fromOffset(14, 2),
				Size = UDim2.new(1, -17, 0, 11),
				Parent = face,
			})
			local plus = new("Frame", {
				Name = "Plus",
				BackgroundColor3 = INK,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -3, 0, 3),
				Size = UDim2.fromOffset(11, 11),
				Visible = false,
				Parent = face,
			})
			setAccent(text({
				Text = "+",
				Font = FONT_NUM,
				TextSize = 9,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = plus,
			}), "TextColor3")
			local name = capText(text({
				Name = "Name",
				Text = boostName(id),
				Font = FONT_NUM,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(2, 18),
				Size = UDim2.new(1, -4, 0, 22),
				Parent = face,
			}), 8, 5)
			local chip = {
				id = id,
				order = i,
				holder = holder,
				bump = bump,
				shadow = shadow,
				face = face,
				outline = outline,
				count = countLabel,
				plus = plus,
				name = name,
			}
			holder.Activated:Connect(function()
				self:_tapBoostChip(chip)
			end)
			m.boostChips[id] = chip
			table.insert(m.boostChipList, chip)
		end
	end

	self:_buildBoostPop(left, y)
end

-- The small "buy one" popover that sits above the chip strip.
function UI._buildBoostPop(self, left, chipY)
	local m = self._menu
	local pop = {}
	m.boostPop = pop
	local frame = new("Frame", {
		Name = "BoostPop",
		BackgroundColor3 = PAPER,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromOffset(0, chipY - 6),
		Size = UDim2.fromOffset(256, BOOST_POP_H),
		ZIndex = 3,
		Visible = false,
		Parent = left,
	})
	frame.Active = true -- taps on the popover don't fall through
	-- Gamepad selection stays inside the popover until it closes (B or X).
	frame.SelectionGroup = true
	frame.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
	frame.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
	frame.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
	frame.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
	pop.frame = frame
	pop.y = chipY - 6
	stroke(frame, 1.5)
	cropMarks(frame, 6, 3)

	local header = new("Frame", { Name = "Header", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 24), Parent = frame })
	pop.title = text({
		Text = "",
		TextSize = 8,
		TextColor3 = PAPER,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -(POP_CLOSE + 68), 1, 0),
		Parent = header,
	})
	setAccent(text({
		Text = "BUY 1",
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -(POP_CLOSE + 60), 0, 0),
		Size = UDim2.fromOffset(54, 24),
		Parent = header,
	}), "TextColor3")
	rule(header, { BackgroundColor3 = PAPER, BackgroundTransparency = 0.6, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -POP_CLOSE, 0, 5), Size = UDim2.new(0, 1, 1, -10) })
	-- The X is drawn in the header, but its tap area is a full 50x50 corner
	-- (reaching down past the copy line, which stops short of it).
	local close = new("TextButton", {
		Name = "Close",
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(POP_CLOSE, POP_CLOSE),
		ZIndex = 2,
		Parent = frame,
	})
	text({
		Text = "X",
		Font = FONT_NUM,
		TextSize = 10,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = close,
	})
	close.Activated:Connect(function()
		self:_closeBoostPop()
	end)
	pop.close = close

	pop.copy = text({
		Text = "",
		TextSize = 8,
		TextColor3 = GREY,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(8, 28),
		Size = UDim2.new(1, -(POP_CLOSE + 12), 0, 11),
		Parent = frame,
	})

	-- Leader line from the popover down to the chip it belongs to.
	pop.pointer = rule(frame, { Name = "Pointer", Position = UDim2.new(0, 24, 1, 0), Size = UDim2.fromOffset(1, 6) })

	pop.gems = hardButton(frame, {
		Name = "Gems",
		Fill = "ink",
		Text = "",
		TextSize = 11,
		Align = Enum.TextXAlignment.Left,
		Index = "PAY / GEMS",
		Position = UDim2.fromOffset(8, 54),
		Size = UDim2.fromOffset(120, 50),
		OnClick = function()
			self:_buyBoostWithGems()
		end,
	})
	pop.robux = hardButton(frame, {
		Name = "Robux",
		Fill = "accent",
		Text = "R$ --",
		TextSize = 11,
		Align = Enum.TextXAlignment.Left,
		Index = "PAY / ROBUX",
		Position = UDim2.fromOffset(132, 54),
		Size = UDim2.fromOffset(120, 50),
		OnClick = function()
			if pop.id then
				self:_fire("onBuyProduct", "Boost" .. pop.id)
			end
		end,
	})
	pop.gems.holder.NextSelectionUp = close
	pop.robux.holder.NextSelectionUp = close
	pop.gems.holder.NextSelectionRight = pop.robux.holder
	pop.robux.holder.NextSelectionLeft = pop.gems.holder
	close.NextSelectionDown = pop.robux.holder
end

function UI._pickedBoosts(self)
	local picks = self._menu.boostPicks
	return if picks then table.clone(picks) else {}
end

function UI._tapBoostChip(self, chip)
	local m = self._menu
	local owned = ownedBoosts()[chip.id] or 0
	local index = table.find(m.boostPicks, chip.id)
	if index then
		table.remove(m.boostPicks, index)
	elseif owned <= 0 then
		if m.boostPop.frame.Visible and m.boostPop.id == chip.id then
			self:_closeBoostPop()
		else
			self:_openBoostPop(chip)
		end
		return
	elseif #m.boostPicks >= MAX_PICKS then
		self:toast("MAX " .. MAX_PICKS .. " BOOSTS PER RUN", "info")
		return
	else
		table.insert(m.boostPicks, chip.id)
		chip.bump.Scale = 1.12
		tween(chip.bump, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	self:_closeBoostPop()
	self:_refreshBoosts()
end

-- Chip looks; each chip only re-styles when its state or count changes.
function UI._refreshBoosts(self)
	local m = self._menu
	if not m or not m.boostChips then
		return
	end
	local counts = ownedBoosts()
	-- Drop picks that are no longer owned (spent, or inventory not loaded yet).
	for i = #m.boostPicks, 1, -1 do
		if (counts[m.boostPicks[i]] or 0) <= 0 then
			table.remove(m.boostPicks, i)
		end
	end

	-- A boost just bought from the open popover gets picked for the next run.
	local pop = m.boostPop
	if pop and pop.id and (counts[pop.id] or 0) > 0 then
		local id = pop.id
		self:_closeBoostPop()
		if not table.find(m.boostPicks, id) and #m.boostPicks < MAX_PICKS then
			table.insert(m.boostPicks, id)
		end
	end

	local full = #m.boostPicks >= MAX_PICKS
	for id, chip in m.boostChips do
		local owned = counts[id] or 0
		local picked = table.find(m.boostPicks, id) ~= nil
		local state = if picked then "picked" elseif owned <= 0 then "empty" elseif full then "full" else "owned"
		local key = state .. owned
		if key ~= chip.key then
			chip.key = key
			if picked then
				setAccent(chip.face, "BackgroundColor3")
			else
				clearAccent(chip.face)
				chip.face.BackgroundColor3 = PAPER
			end
			chip.face.BackgroundTransparency = if state == "empty" then 0.35 else 0
			chip.shadow.Visible = picked
			chip.outline.Thickness = if picked then 2 else 1
			chip.outline.Transparency = if picked then 0 elseif state == "empty" then 0.7 else 0.5
			chip.name.TextTransparency = if state == "empty" or state == "full" then 0.45 else 0
			chip.count.Visible = owned > 0
			chip.count.Text = "x" .. owned
			chip.count.TextColor3 = if picked then INK else GREY
			chip.plus.Visible = owned <= 0
		end
	end
	self:_refreshBoostPop()
	self:_refreshPlayIndex()
	self:_checkWelcome(counts)
end

function UI._openBoostPop(self, chip)
	local m = self._menu
	local pop = m.boostPop
	local boost = boostInfo(chip.id)
	if not pop or not boost then
		return
	end
	self:_hideTopUp()
	pop.id = chip.id
	pop.busy = false
	pop.gems.setEnabled(true)
	pop.title.Text = "C-" .. twoDigits(chip.order) .. " / " .. boostName(chip.id) .. " BOOST"
	pop.copy.Text = string.upper(tostring(boost.Text or ""))
	pop.pointer.Position = UDim2.new(0, chip.holder.Position.X.Offset + math.floor((m.boostChipW or 48) / 2) - 1, 1, 0)

	-- Robux option only when that boost's product is set up.
	local key = "Boost" .. chip.id
	local id = productId(key)
	pop.robux.holder.Visible = id ~= 0
	pop.gems.holder.Size = if id ~= 0 then UDim2.fromOffset(120, 50) else UDim2.fromOffset(244, 50)
	pop.close.NextSelectionDown = if id ~= 0 then pop.robux.holder else pop.gems.holder
	pop.robux.setText("R$ --")
	withPrice(id, Enum.InfoType.Product, function(price)
		if pop.id == chip.id and pop.robux.label.Parent then
			pop.robux.setText("R$ " .. commas(price))
		end
	end)

	pop.frame.Visible = true
	pop.frame.Position = UDim2.fromOffset(0, pop.y + 8)
	tween(pop.frame, 0.2, { Position = UDim2.fromOffset(0, pop.y) })
	pop.returnTo = chip.holder
	self:_refreshBoostPop()
	self:_syncBack()
	self:_focus(pop.gems.holder)
end

function UI._closeBoostPop(self)
	local pop = self._menu and self._menu.boostPop
	if not pop then
		return
	end
	if self._topUp and self._topUp.host == pop.frame then
		self:_hideTopUp()
	end
	local wasOpen = pop.frame.Visible
	pop.id = nil
	pop.frame.Visible = false
	if wasOpen then
		self:_syncBack()
		self:_returnFocus(pop.frame, pop.returnTo)
	end
end

-- Gem button: price, or how many gems are missing.
function UI._refreshBoostPop(self)
	local pop = self._menu and self._menu.boostPop
	if not pop or not pop.id or pop.busy then
		return
	end
	local boost = boostInfo(pop.id)
	local price = math.floor(tonumber(boost and boost.Gems) or 0)
	local short = price - math.floor(attrNumber("Gems", 0))
	local key = pop.id .. "|" .. short
	if key == pop.key then
		return
	end
	pop.key = key
	if short > 0 then
		pop.gems.setFill("paper")
		pop.gems.index.Text = "PAY / " .. commas(price) .. " GEMS"
		pop.gems.setText("NEED " .. commas(short) .. " GEMS")
	else
		pop.gems.setFill("ink")
		pop.gems.index.Text = "PAY / GEMS"
		pop.gems.setText(commas(price) .. " GEMS")
	end
end

function UI._buyBoostWithGems(self)
	local pop = self._menu.boostPop
	local id = pop.id
	local boost = id and boostInfo(id)
	if not boost or pop.busy then
		return
	end
	local price = math.floor(tonumber(boost.Gems) or 0)
	local short = price - math.floor(attrNumber("Gems", 0))
	if short > 0 then
		-- Not enough: offer the small gem top-up instead of a doomed request.
		if not self:_offerTopUp(price, pop.frame) then
			self:toast("NEED " .. commas(short) .. " MORE GEMS", "error")
		end
		return
	end
	pop.busy = true
	pop.key = nil
	pop.gems.setEnabled(false)
	pop.gems.setText("BUYING")
	task.spawn(function()
		local ok, message = self:_ask("onShop", "BuyBoost", id)
		pop.busy = false
		pop.gems.setEnabled(true)
		if ok then
			self:toast("+1 " .. boostName(id) .. " BOOST", "reward")
		else
			self:toast(message or "PURCHASE FAILED", "error")
			if pop.id == id then
				self:_offerTopUp(price, pop.frame)
			end
		end
		self:_refreshBoosts()
	end)
end

-- "A / START RUN / +10 BONUS BALLS / 2/3 BOOSTS"
function UI._refreshPlayIndex(self)
	local m = self._menu
	if not m.play then
		return
	end
	local parts = { "A / START RUN" }
	local bonus = math.max(0, math.floor(attrNumber("BonusBalls", 0)))
	if bonus > 0 then
		table.insert(parts, "+" .. bonus .. " BONUS BALLS")
	end
	local picks = if m.boostPicks then #m.boostPicks else 0
	if picks > 0 then
		table.insert(parts, picks .. "/" .. MAX_PICKS .. " BOOSTS")
	end
	if #parts == 1 then
		table.insert(parts, "0 M")
	end
	m.play.index.Text = table.concat(parts, " / ")
end

-- New players arrive with a starter set of boosts: say so once per session.
function UI._checkWelcome(self, counts)
	if self._welcomeDone then
		return
	end
	local stats = decodeJson(player:GetAttribute("Stats"))
	if player:GetAttribute("Level") == nil or type(stats) ~= "table" then
		return -- progress not loaded yet
	end
	local level = levelInfo()
	if level > 1 or (tonumber(stats.runs) or 0) > 0 then
		self._welcomeDone = true
		return
	end
	local total = 0
	for _, n in counts or ownedBoosts() do
		total += n
	end
	if total <= 0 then
		return
	end
	self._welcomeDone = true
	self:toast(total .. (if total == 1 then " FREE BOOST" else " FREE BOOSTS") .. " / PICK ABOVE PLAY", "gift")
	for i, chip in self._menu.boostChipList or {} do
		task.delay(0.08 * i, function()
			if chip.holder.Parent then
				chip.bump.Scale = 1.18
				tween(chip.bump, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
end

-- Gem top-up ------------------------------------------------------------------------------
-- One small inline strip, moved next to whatever purchase just came up short
-- (shop panel or boost popover). No modal and no timer; it closes with X, once
-- the player can afford the item, or when the context goes away.

function UI._buildTopUp(self, root)
	local product = Config.Products.GemTopUp
	local id = productId("GemTopUp")
	if id == 0 or not tonumber(product.Gems) then
		return
	end
	local t = {}
	self._topUp = t
	local strip = new("Frame", {
		Name = "TopUp",
		BackgroundColor3 = INK,
		Size = UDim2.new(1, 0, 0, TOPUP_H),
		ZIndex = 6,
		Visible = false,
		Parent = root,
	})
	strip.Active = true
	t.strip = strip
	notch(strip, 8, 0, 0)
	local textW = -(12 + TOPUP_CLOSE_W + 2 + TOPUP_BUY_W + 8)
	t.short = setAccent(text({ Text = "", TextSize = 8, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, textW, 0, 10), Parent = strip }), "TextColor3")
	t.offer = capText(text({
		Text = "GET +" .. commas(product.Gems) .. " GEMS",
		Font = FONT_NUM,
		TextColor3 = PAPER,
		Position = UDim2.fromOffset(12, 20),
		Size = UDim2.new(1, textW, 0, 26),
		Parent = strip,
	}), 12, 7)
	t.buy = hardButton(strip, {
		Name = "Buy",
		Fill = "accent",
		Text = "GET",
		TextSize = 11,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(TOPUP_CLOSE_W + 2), 0.5, 2),
		Size = UDim2.fromOffset(TOPUP_BUY_W, 50),
		OnClick = function()
			self:_fire("onBuyProduct", "GemTopUp")
		end,
	})
	withPrice(id, Enum.InfoType.Product, function(price)
		t.buy.sub.Text = "R$ " .. commas(price)
	end)
	rule(strip, { BackgroundColor3 = PAPER, BackgroundTransparency = 0.7, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -TOPUP_CLOSE_W, 0, 8), Size = UDim2.new(0, 1, 1, -16) })
	local dismiss = new("TextButton", {
		Name = "Dismiss",
		AutoButtonColor = false,
		Text = "X",
		Font = FONT_NUM,
		TextSize = 10,
		TextColor3 = PAPER,
		Selectable = true,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, TOPUP_CLOSE_W, 1, 0),
		Parent = strip,
	})
	dismiss.Activated:Connect(function()
		self:_hideTopUp()
	end)
	t.buy.holder.NextSelectionRight = dismiss
	dismiss.NextSelectionLeft = t.buy.holder
end

-- Shows the top-up if the player is short for `price` by no more than the pack
-- gives. Returns whether it is showing.
function UI._offerTopUp(self, price, host)
	local t = self._topUp
	if not t or not host then
		return false
	end
	local short = math.floor((tonumber(price) or 0) - attrNumber("Gems", 0))
	if short <= 0 or short > Config.Products.GemTopUp.Gems then
		return false
	end
	t.price = price
	t.host = host
	t.strip.Parent = host
	local y
	if host == self._menu.panel then
		-- Bottom of the panel, just above the footer.
		t.strip.AnchorPoint = Vector2.new(0.5, 1)
		y = -(FOOTER_H + 4)
		t.strip.Position = UDim2.new(0.5, 0, 1, y + 8)
		t.strip.Size = UDim2.new(1, -12, 0, TOPUP_H)
		tween(t.strip, 0.2, { Position = UDim2.new(0.5, 0, 1, y) })
	else
		-- Stacked on top of the boost popover.
		t.strip.AnchorPoint = Vector2.new(0, 1)
		t.strip.Position = UDim2.new(0, 0, 0, 2)
		t.strip.Size = UDim2.new(1, 0, 0, TOPUP_H)
		tween(t.strip, 0.2, { Position = UDim2.new(0, 0, 0, -6) })
	end
	t.shown = nil
	local selected = GuiService.SelectedObject
	if selected == nil or not selected:IsDescendantOf(t.strip) then
		t.returnTo = selected
	end
	t.strip.Visible = true
	self:_refreshTopUp()
	if t.strip.Visible then
		self:_syncBack()
		self:_focus(t.buy.holder)
	end
	return t.strip.Visible
end

function UI._refreshTopUp(self)
	local t = self._topUp
	if not t or not t.strip.Visible or not t.price then
		return
	end
	local short = math.floor(t.price - attrNumber("Gems", 0))
	if short <= 0 or short > Config.Products.GemTopUp.Gems then
		self:_hideTopUp()
		return
	end
	if short ~= t.shown then
		t.shown = short
		t.short.Text = "SHORT BY " .. commas(short) .. " GEMS"
	end
end

function UI._hideTopUp(self)
	local t = self._topUp
	if t then
		local wasOpen = t.strip.Visible
		t.host = nil
		t.price = nil
		t.strip.Visible = false
		if wasOpen then
			self:_syncBack()
			self:_returnFocus(t.strip, t.returnTo)
		end
	end
end

function UI._buildMenuPanel(self, root)
	local m = self._menu
	local panel = new("Frame", {
		Name = "Panel",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.03,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(EDGE + 4), 0.5, 0),
		Size = UDim2.fromOffset(290, 300),
		Parent = root,
	})
	fit(panel)
	stroke(panel, 1.5)
	cropMarks(panel, 8, 4)
	notch(panel, 14, 1, 1)
	m.panel = panel

	-- Tabs
	m.tabs = {}
	local names = TAB_NAMES
	for i, name in names do
		local button = new("TextButton", {
			Name = "Tab" .. name,
			AutoButtonColor = false,
			Text = "",
			Selectable = true,
			BackgroundColor3 = INK,
			BackgroundTransparency = 1,
			Position = UDim2.new((i - 1) / #names, 0, 0, 0),
			Size = UDim2.new(1 / #names, 0, 0, TAB_H),
			Parent = panel,
		})
		local index = text({ Text = twoDigits(i), TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(5, 5), Size = UDim2.fromOffset(30, 9), Parent = button })
		local label = capText(text({
			Text = name,
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(3, 16),
			Size = UDim2.new(1, -6, 0, 20),
			Parent = button,
		}), 11, 5)
		local bar = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3), Visible = false, Parent = button })
		setAccent(bar, "BackgroundColor3")
		-- "Something to claim here" marker.
		local pip = new("Frame", {
			Name = "Pip",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(7, 7),
			Rotation = 45,
			Visible = false,
			Parent = button,
		})
		setAccent(pip, "BackgroundColor3")
		stroke(pip, 1)
		if i > 1 then
			rule(button, { Size = UDim2.new(0, 1, 1, 0), BackgroundTransparency = 0.6 })
		end
		local page = new("ScrollingFrame", {
			Name = name .. "Page",
			Active = true,
			Selectable = false, -- gamepad selection goes to the buttons inside; the page scrolls to follow it
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, TAB_H + 1),
			Size = UDim2.new(1, 0, 1, -(TAB_H + 1 + FOOTER_H)),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = INK,
			VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
			Visible = false,
			Parent = panel,
		})
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 9),
			PaddingRight = UDim.new(0, 6),
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 10),
			Parent = page,
		})
		list(page, 6)
		button.Activated:Connect(function()
			self:_selectTab(i)
		end)
		m.tabs[i] = { button = button, index = index, label = label, bar = bar, pip = pip, page = page, name = name }
	end
	rule(panel, { Position = UDim2.fromOffset(0, TAB_H) })
	-- Gamepad: the tabs row is one straight line; LEFT off the first tab goes back to PLAY.
	for i, tab in m.tabs do
		tab.button.NextSelectionLeft = if i > 1 then m.tabs[i - 1].button else m.play and m.play.holder
		tab.button.NextSelectionRight = if i < #m.tabs then m.tabs[i + 1].button else nil
	end

	-- Footer
	local footer = new("Frame", { Name = "Footer", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, FOOTER_H), Parent = panel })
	rule(footer, { BackgroundTransparency = 0.5 })
	m.footer = text({ Text = "SHEET 01 / " .. twoDigits(#names), TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(9, 1), Size = UDim2.new(0.5, -9, 1, -1), Parent = footer })
	m.footerSpec = text({
		Text = "SHATTER RUN / SPEC",
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 1),
		Size = UDim2.new(0.5, -22, 1, -1),
		Parent = footer,
	})
	-- Same spot, controller only.
	m.footerHint = inputHint(footer, { { "A", "SELECT" }, { "B", "BACK" } }, {
		Position = UDim2.new(0.4, 0, 0, 2),
		Size = UDim2.new(0.6, -22, 1, -4),
	}, Enum.HorizontalAlignment.Right)

	-- 01 PLAY: global top runs + upgrades
	local playPage = m.tabs[1].page
	local _, runsRight = sectionHeader(playPage, 1, "01.1", "TOP RUNS")
	runsRight.Text = "GLOBAL / TOP 10"
	m.runs = new("Frame", { Name = "Runs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = playPage })
	list(m.runs, 0)
	m.passHeader = sectionHeader(playPage, 3, "01.2", "UPGRADES")
	m.passes = new("Frame", { Name = "Passes", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = playPage })
	list(m.passes, 8)

	-- 02 MISSIONS
	self:_buildMissionsPage(m.tabs[TAB_MISSIONS].page)

	-- 03 SEASON
	self:_buildSeasonPage(m.tabs[TAB_SEASON].page)

	-- 04 ZONES
	local zonesPage = m.tabs[4].page
	local _, zonesRight = sectionHeader(zonesPage, 1, "04.1", "ZONES")
	m.zonesRight = zonesRight
	m.zones = new("Frame", { Name = "Zones", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = zonesPage })
	list(m.zones, 0)

	-- 05 SHOP
	local shopPage = m.tabs[5].page
	local starter = Config.Products.StarterPack
	if starter and starter.Id ~= 0 then
		m.starterHeader = sectionHeader(shopPage, 1, "05.0", "STARTER PACK")
		m.starterCard = self:_buildStarterCard(shopPage, 2)
	end
	local _, gemsRight = sectionHeader(shopPage, 3, "05.1", "GEMS")
	m.shopGems = gemsRight
	for i, key in GEM_PACKS do
		local product = Config.Products[key]
		if product and product.Id ~= 0 then
			self:_buildGemPack(shopPage, 3 + i, key)
		end
	end
	local _, skinsRight = sectionHeader(shopPage, 10, "05.2", "BALL SKINS")
	m.skinsRight = skinsRight
	local grid = new("Frame", { Name = "Skins", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 11, Parent = shopPage })
	new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 162),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	m.skinCards = {}
	local skinButtons = {}
	for order, skin in Config.Skins do
		local entry = self:_buildSkinCard(grid, skin, order)
		m.skinCards[skin.Id] = entry
		table.insert(skinButtons, entry.button.holder)
	end
	linkGrid(skinButtons, 2)

	local _, fxRight = sectionHeader(shopPage, 12, "05.3", "SHATTER FX")
	m.fxRight = fxRight
	text({
		Text = "THE COLOR YOUR GLASS SHARDS TURN WHEN YOU BREAK THEM",
		TextSize = 8,
		TextColor3 = GREY,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 12),
		LayoutOrder = 13,
		Parent = shopPage,
	})
	local fxGrid = new("Frame", { Name = "Fx", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 14, Parent = shopPage })
	new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 142),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = fxGrid,
	})
	m.fxCards = {}
	local fxButtons = {}
	for order, fx in Config.ShatterFx do
		local entry = self:_buildFxCard(fxGrid, fx, order)
		m.fxCards[fx.Id] = entry
		table.insert(fxButtons, entry.button.holder)
	end
	linkGrid(fxButtons, 2)
	-- Between the two grids: straight down from the last skins to the first effects and back.
	if #skinButtons > 0 and #fxButtons > 0 then
		local lastRowStart = #skinButtons - (#skinButtons - 1) % 2
		for i = lastRowStart, #skinButtons do
			skinButtons[i].NextSelectionDown = fxButtons[math.min(i - lastRowStart + 1, #fxButtons)]
		end
		for i = 1, math.min(2, #fxButtons) do
			fxButtons[i].NextSelectionUp = skinButtons[math.min(lastRowStart + i - 1, #skinButtons)]
		end
	end
end

function UI._buildGemPack(self, parent, order, key)
	key = key or "GemPack"
	local product = Config.Products[key]
	local card = new("Frame", { Name = key, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = order, Parent = parent })
	stroke(card, 1, INK, if product.Badge then 0 else 0.5)
	notch(card, 10, 0, 0)
	if product.Badge then
		stamp(card, string.upper(product.Badge), {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -92, 0, 1),
			Size = UDim2.fromOffset(78, 17),
			Rotation = -4,
		}, "accent")
	end
	gemIcon(card, 20, UDim2.fromOffset(28, 30))
	capText(text({
		Text = "+" .. commas(product.Gems) .. " GEMS",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(52, 12),
		Size = UDim2.new(1, -140, 0, 20),
		Parent = card,
	}), 14, 8)
	text({ Text = "GEM PACK / INSTANT", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(52, 34), Size = UDim2.new(1, -140, 0, 10), Parent = card })
	local buy = hardButton(card, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY",
		TextSize = 12,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(78, 50),
		OnClick = function()
			self:_fire("onBuyProduct", key)
		end,
	})
	withPrice(product.Id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
end

-- What the starter pack contains, as three annotated lines.
local function starterLines(product)
	local lines = {}
	if product.Gems then
		table.insert(lines, { reward = { Gems = product.Gems }, text = "+" .. commas(product.Gems) .. " GEMS" })
	end
	if product.Skin then
		table.insert(lines, { reward = { Skin = product.Skin }, text = skinName(product.Skin) .. " BALL SKIN" })
	end
	if product.Fx then
		table.insert(lines, { reward = { Fx = product.Fx }, text = fxName(product.Fx) .. " SHATTER FX" })
	end
	return lines
end

-- Shop card for the one-time starter pack. Hidden once bought.
function UI._buildStarterCard(self, parent, order)
	local product = Config.Products.StarterPack
	local card = new("Frame", { Name = "StarterPack", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 92), LayoutOrder = order, Parent = parent })
	notch(card, 12, 1, 0)
	setAccent(text({ Text = "ONE-TIME PACK / NEW PLAYERS", TextSize = 8, Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -110, 0, 10), Parent = card }), "TextColor3")
	for i, line in starterLines(product) do
		local y = 22 + (i - 1) * 22
		rewardChip(card, line.reward, 10, UDim2.fromOffset(16, y + 8))
		capText(text({ Text = line.text, Font = FONT_NUM, TextColor3 = PAPER, Position = UDim2.fromOffset(28, y), Size = UDim2.new(1, -124, 0, 16), Parent = card }), 10, 6)
	end
	local buy = hardButton(card, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY",
		TextSize = 12,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 4),
		Size = UDim2.fromOffset(84, 56),
		OnClick = function()
			self:_fire("onBuyProduct", "StarterPack")
		end,
	})
	withPrice(product.Id, Enum.InfoType.Product, function(price)
		if buy.sub.Parent then
			buy.sub.Text = "R$ " .. commas(price)
		end
	end)
	return card
end

-- Shop card for a shatter effect: same anatomy as the ball skin cards.
function UI._buildFxCard(self, parent, fx, order)
	local card = new("Frame", { Name = fx.Id, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local outline = stroke(card, 1, INK, 0.5)
	local swatch = fxSwatch(card, fx, { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 42) })
	text({ Text = "FX-" .. twoDigits(order), TextSize = 8, TextColor3 = PAPER, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(40, 10), Parent = swatch })
	local finish = if fx.Rainbow then "PRISM" elseif fx.Neon then "NEON" elseif fx.Metal then "METAL" elseif fx.Sparkle then "SPARKLE" else "GLASS"
	text({
		Text = finish,
		TextSize = 8,
		TextColor3 = PAPER,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -64, 0, 2),
		Size = UDim2.fromOffset(60, 10),
		Parent = swatch,
	})
	capText(text({ Text = string.upper(fx.Name), Font = FONT_NUM, Position = UDim2.fromOffset(6, 53), Size = UDim2.new(1, -12, 0, 16), Parent = card }), 12, 7)
	local price = text({
		Text = if fx.Price > 0 then commas(fx.Price) .. " GEMS" else "STANDARD ISSUE",
		TextSize = 9,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(6, 70),
		Size = UDim2.new(1, -12, 0, 12),
		Parent = card,
	})
	local entry = { fx = fx, outline = outline, price = price, busy = false }
	entry.button = hardButton(card, {
		Name = "Action",
		Fill = "ink",
		Text = "BUY",
		TextSize = 11,
		Position = UDim2.fromOffset(6, 86),
		Size = UDim2.new(1, -12, 0, 50),
		OnClick = function()
			self:_fxAction(entry)
		end,
	})
	return entry
end

function UI._buildSkinCard(self, parent, skin, order)
	local card = new("Frame", { Name = skin.Id, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local outline = stroke(card, 1, INK, 0.5)

	local swatch = new("Frame", { Name = "Swatch", BackgroundColor3 = skin.Color, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 58), Parent = card })
	stroke(swatch, 1)
	if skin.Rainbow then
		local keys = {}
		for i = 0, 6 do
			table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)))
		end
		new("UIGradient", { Color = ColorSequence.new(keys), Rotation = 20, Parent = swatch })
	end
	if skin.Trail then
		new("Frame", { Name = "Trail", BackgroundColor3 = skin.Trail, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 6), Parent = swatch })
	end
	-- Sample crosshair
	local dark = (skin.Color.R + skin.Color.G + skin.Color.B) < 1.2
	local markColor = if dark then PAPER else INK
	rule(swatch, { BackgroundColor3 = markColor, BackgroundTransparency = 0.55, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 1) })
	rule(swatch, { BackgroundColor3 = markColor, BackgroundTransparency = 0.55, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1, 14) })
	text({ Text = "S-" .. twoDigits(order), TextSize = 8, TextColor3 = markColor, Position = UDim2.fromOffset(4, 2), Size = UDim2.fromOffset(40, 10), Parent = swatch })
	text({
		Text = string.upper(skin.Material.Name),
		TextSize = 8,
		TextColor3 = markColor,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -64, 0, 2),
		Size = UDim2.fromOffset(60, 10),
		Parent = swatch,
	})

	capText(text({ Text = string.upper(skin.Name), Font = FONT_NUM, Position = UDim2.fromOffset(6, 70), Size = UDim2.new(1, -12, 0, 16), Parent = card }), 12, 7)
	local price = text({
		Text = if skin.Price > 0 then commas(skin.Price) .. " GEMS" elseif skin.Source then "LOCKED" else "STANDARD ISSUE",
		TextSize = 9,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(6, 88),
		Size = UDim2.new(1, -12, 0, 12),
		Parent = card,
	})

	local entry = { skin = skin, outline = outline, price = price, busy = false }
	entry.button = hardButton(card, {
		Name = "Action",
		Fill = "ink",
		Text = "BUY",
		TextSize = 11,
		Position = UDim2.fromOffset(6, 106),
		Size = UDim2.new(1, -12, 0, 50),
		OnClick = function()
			self:_skinAction(entry)
		end,
	})
	return entry
end

function UI._selectTab(self, index)
	local m = self._menu
	m.tab = index
	for i, tab in m.tabs do
		local active = i == index
		tab.button.BackgroundTransparency = if active then 0 else 1
		tab.label.TextColor3 = if active then PAPER else INK
		if active then
			setAccent(tab.index, "TextColor3")
		else
			clearAccent(tab.index)
			tab.index.TextColor3 = GREY
		end
		tab.bar.Visible = active
		tab.page.Visible = active
		if active then
			tab.page.CanvasPosition = Vector2.zero
			tab.page.Position = UDim2.fromOffset(14, TAB_H + 1)
			tween(tab.page, 0.22, { Position = UDim2.fromOffset(0, TAB_H + 1) })
			m.footer.Text = "SHEET " .. twoDigits(i) .. " / " .. twoDigits(#m.tabs) .. " / " .. tab.name
		end
	end
	if index == TAB_SEASON then
		self:_scrollSeasonTrack()
	end
	if self._topUp and self._topUp.host == m.panel then
		self:_hideTopUp()
	end
end

-- Popovers (daily streak, starter offer) ------------------------------------------------

-- A centered sheet with an ink header, like the run report. Active so taps on it
-- don't fall through to the wash (which closes the popover).
local function modalSheet(layer, name, width, height, index, title)
	local sheet = new("Frame", {
		Name = name,
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.02,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		Visible = false,
		Parent = layer,
	})
	sheet.Active = true
	-- Gamepad selection can't wander off the sheet to the menu underneath.
	sheet.SelectionGroup = true
	sheet.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
	sheet.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
	sheet.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
	sheet.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
	fit(sheet)
	stroke(sheet, 1.5)
	cropMarks(sheet, 10, 5)
	notch(sheet, 14, 1, 1, INK)
	local header = new("Frame", { Name = "Header", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 24), Parent = sheet })
	text({ Text = index .. " / " .. title, TextSize = 9, TextColor3 = PAPER, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.6, -10, 1, 0), Parent = header })
	local right = setAccent(text({
		Text = "",
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.4, 0, 0, 0),
		Size = UDim2.new(0.6, -10, 1, 0),
		Parent = header,
	}), "TextColor3")
	return sheet, right
end

function UI._buildModal(self, root)
	local m = self._menu
	local layer = new("Frame", { Name = "Modal", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	local wash = new("TextButton", {
		Name = "Wash",
		AutoButtonColor = false,
		Text = "",
		Selectable = false, -- tap-outside-to-close only; never a gamepad stop
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.25,
		Position = UDim2.fromOffset(-200, -200),
		Size = UDim2.new(1, 400, 1, 400),
		Parent = layer,
	})
	wash.Activated:Connect(function()
		self:_closeModal()
	end)
	blueprintGrid(layer, 12, 8, 0.9)
	m.modal = layer
	m.modalWash = wash
	m.sheets = {}
	self:_buildDailySheet(layer)
	self:_buildOfferSheet(layer)
end

function UI._openModal(self, name)
	local m = self._menu
	local sheet = m.sheets[name]
	if not sheet then
		return
	end
	for key, other in m.sheets do
		other.Visible = key == name
	end
	local selected = GuiService.SelectedObject
	if selected == nil or not selected:IsDescendantOf(m.modal) then
		m.modalReturn = selected
	end
	m.modalOpen = name
	m.modal.Visible = true
	m.modalWash.BackgroundTransparency = 1
	tween(m.modalWash, 0.25, { BackgroundTransparency = 0.25 })
	sheet.Position = UDim2.new(0.5, 0, 0.5, 16)
	tween(sheet, 0.3, { Position = UDim2.fromScale(0.5, 0.5) })
	self:_syncBack()
	self:_focus(self:_modalPrimary())
end

function UI._closeModal(self)
	local m = self._menu
	if not m.modalOpen then
		return
	end
	m.modalOpen = nil
	m.modal.Visible = false
	self:_syncBack()
	self:_returnFocus(m.modal, m.modalReturn)
end

-- The button a popover's gamepad selection starts on.
function UI._modalPrimary(self)
	local m = self._menu
	if m.modalOpen == "daily" then
		local d = self._dailySheet
		return if d.claim.enabled then d.claim.holder else d.close.holder
	elseif m.modalOpen == "offer" then
		return m.offerBuy and m.offerBuy.holder
	end
	return nil
end

function UI._openDaily(self)
	self._menu.dailyKey = nil
	self:_refreshDaily()
	self:_openModal("daily")
end

function UI._buildDailySheet(self, layer)
	local m = self._menu
	local days = #Config.DailyStreak
	local width, height = 400, 216
	local sheet, right = modalSheet(layer, "Daily", width, height, "06", "DAILY STREAK")
	m.sheets.daily = sheet
	local d = { sheet = sheet, right = right, cells = {} }
	self._dailySheet = d

	local gap = 6
	local cellW = math.floor((width - 24 - gap * (days - 1)) / days)
	local startX = math.floor((width - (cellW * days + gap * (days - 1))) / 2)
	for day = 1, days do
		local reward = Config.DailyStreak[day] or {}
		local cell = new("Frame", {
			Name = "Day" .. day,
			BackgroundColor3 = PAPER,
			Position = UDim2.fromOffset(startX + (day - 1) * (cellW + gap), 34),
			Size = UDim2.fromOffset(cellW, 96),
			Parent = sheet,
		})
		local outline = stroke(cell, 1, INK, 0.5)
		local bump = new("UIScale", { Parent = cell })
		local texts = {}
		table.insert(texts, text({ Text = "DAY " .. day, TextSize = 8, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 10), Parent = cell }))
		if reward.Fx then
			fxSwatch(cell, Config.getFx(reward.Fx), { Position = UDim2.fromOffset(4, 17), Size = UDim2.new(1, -8, 0, 26) }, 0.6)
		else
			gemIcon(cell, 12, UDim2.new(0.5, 0, 0, 30))
		end
		table.insert(texts, capText(text({
			Text = "+" .. commas(reward.Gems or 0),
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(2, 46),
			Size = UDim2.new(1, -4, 0, 16),
			Parent = cell,
		}), 11, 6))
		local extra = if reward.Fx
			then fxName(reward.Fx) .. " FX"
			elseif reward.Boost then "+" .. boostName(reward.Boost)
			elseif reward.Balls then "+" .. reward.Balls .. " BALLS"
			else "GEMS"
		table.insert(texts, text({
			Text = extra,
			TextSize = 7,
			TextColor3 = if reward.Fx or reward.Balls or reward.Boost then INK else GREY,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 63),
			Size = UDim2.new(1, 0, 0, 9),
			Parent = cell,
		}))
		local stateTag, stateLabel = tag(cell, "", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 14) })
		d.cells[day] = { frame = cell, outline = outline, bump = bump, tag = stateTag, tagLabel = stateLabel, texts = texts }
	end

	d.note = text({
		Text = "STREAK RESETS IF YOU MISS A DAY",
		TextSize = 8,
		TextColor3 = GREY,
		Position = UDim2.fromOffset(12, 136),
		Size = UDim2.new(1, -24, 0, 10),
		Parent = sheet,
	})
	d.height = height
	d.close = hardButton(sheet, {
		Name = "Close",
		Fill = "paper",
		Text = "CLOSE",
		TextSize = 11,
		Position = UDim2.fromOffset(12, 152),
		Size = UDim2.fromOffset(96, 52),
		OnClick = function()
			self:_closeModal()
		end,
	})
	d.claim = hardButton(sheet, {
		Name = "Claim",
		Fill = "accent",
		Text = "CLAIM",
		TextSize = 13,
		Align = Enum.TextXAlignment.Left,
		Index = "CLAIM",
		Position = UDim2.fromOffset(116, 152),
		Size = UDim2.new(1, -128, 0, 52),
		OnClick = function()
			self:_claimDaily()
		end,
	})
	self:_buildStreakSaver(sheet)
end

-- Shown inside the daily sheet only while a broken streak can still be saved.
-- The sheet grows to make room; the claim row moves down under it.
local SAVER_H = 58

function UI._buildStreakSaver(self, sheet)
	local d = self._dailySheet
	local id = productId("StreakSaver")
	if id == 0 then
		return
	end
	local saver = new("Frame", {
		Name = "StreakSaver",
		BackgroundColor3 = INK,
		Position = UDim2.fromOffset(12, 150),
		Size = UDim2.new(1, -24, 0, SAVER_H - 4),
		Visible = false,
		Parent = sheet,
	})
	-- Text block is vertically centred in the taller strip.
	local textTop = math.floor((SAVER_H - 4 - 32) / 2)
	hatch(saver, { Name = "Hatch", Size = UDim2.new(0, 8, 1, 0) }, PAPER, 0.45, 3)
	notch(saver, 8, 1, 0)
	d.saverTitle = capText(setAccent(text({
		Text = "",
		Font = FONT_NUM,
		Position = UDim2.fromOffset(18, textTop),
		Size = UDim2.new(1, -118, 0, 20),
		Parent = saver,
	}), "TextColor3"), 12, 7)
	text({
		Text = "YOU MISSED A DAY / KEEP YOUR STREAK GOING",
		TextSize = 7,
		TextColor3 = PAPER,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, textTop + 22),
		Size = UDim2.new(1, -118, 0, 10),
		Parent = saver,
	})
	local buy = hardButton(saver, {
		Name = "Save",
		Fill = "accent",
		Text = "SAVE",
		TextSize = 11,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -2, 0.5, 0),
		Size = UDim2.fromOffset(92, 50),
		OnClick = function()
			self:_fire("onBuyProduct", "StreakSaver")
		end,
	})
	d.saverBuy = buy
	withPrice(id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
	d.saver = saver
end

function UI._layoutStreakSaver(self, saveDay)
	local d = self._dailySheet
	local show = saveDay ~= nil and d.saver ~= nil
	if d.saver then
		d.saver.Visible = show
		if show then
			d.saverTitle.Text = "SAVE YOUR DAY " .. saveDay .. " STREAK"
		end
	end
	local extra = if show then SAVER_H else 0
	d.sheet.Size = UDim2.fromOffset(d.sheet.Size.X.Offset, d.height + extra)
	d.close.holder.Position = UDim2.fromOffset(12, 152 + extra)
	d.claim.holder.Position = UDim2.fromOffset(116, 152 + extra)
end

-- Day cell states; only runs when the streak day / readiness changes.
function UI._refreshDailySheet(self, state)
	local d = self._dailySheet
	if not d then
		return
	end
	for day, cell in d.cells do
		local done = day < state.day
		local today = day == state.day
		if today then
			setAccent(cell.frame, "BackgroundColor3")
		else
			clearAccent(cell.frame)
			cell.frame.BackgroundColor3 = PAPER
		end
		cell.outline.Thickness = if today then 2 else 1
		cell.outline.Transparency = if today or done then 0 else 0.5
		for _, label in cell.texts do
			label.TextTransparency = if done then 0.55 else 0
		end
		cell.tag.Visible = done or today
		cell.tagLabel.Text = if done then "DONE" elseif state.ready then "TODAY" else "NEXT"
	end
	d.right.Text = "DAY " .. state.day .. " OF " .. #Config.DailyStreak
	d.note.Text = if state.saveDay
		then "STREAK BROKEN / SAVE IT, OR CLAIMING RESTARTS AT DAY 1"
		elseif state.broken then "STREAK RESTARTED AT DAY 1 / CLAIM EVERY DAY TO KEEP IT"
		else "STREAK RESETS IF YOU MISS A DAY"
	self:_layoutStreakSaver(state.saveDay)
end

-- Claim button / countdown; runs every second while the menu is open.
function UI._tickDailySheet(self, state)
	local d = self._dailySheet
	if not d or self._dailyBusy then
		return
	end
	local reward = Config.DailyStreak[state.day] or {}
	if state.ready ~= d.ready then
		d.ready = state.ready
		d.claim.setFill(if state.ready then "accent" else "paper")
		d.claim.setEnabled(state.ready)
	end
	d.claim.index.Text = if state.ready then "CLAIM / DAY " .. state.day else "NEXT CLAIM IN"
	if state.ready then
		d.claim.setText("CLAIM +" .. commas(reward.Gems or 0) .. " GEMS")
	elseif state.wait then
		d.claim.setText(clock(state.wait))
	else
		d.claim.setText("--:--:--")
	end
end

function UI._buildOfferSheet(self, layer)
	local product = Config.Products.StarterPack
	if not product or product.Id == 0 then
		return
	end
	local m = self._menu
	local sheet, right = modalSheet(layer, "Offer", 400, 218, "07", "STARTER PACK")
	right.Text = "ONE-TIME PACK"
	m.sheets.offer = sheet

	text({ Text = "A HEAD START FOR NEW PLAYERS / ONCE PER ACCOUNT", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(12, 30), Size = UDim2.fromOffset(240, 10), Parent = sheet })
	for i, line in starterLines(product) do
		local row = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 44 + (i - 1) * 30), Size = UDim2.fromOffset(236, 28), Parent = sheet })
		rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.6 })
		rewardChip(row, line.reward, 14, UDim2.fromOffset(10, 14))
		capText(text({ Text = line.text, Font = FONT_NUM, Position = UDim2.fromOffset(26, 4), Size = UDim2.new(1, -26, 0, 20), Parent = row }), 12, 7)
	end

	-- Previews: the skin as a sample plate, the effect as shards.
	local skin = product.Skin and Config.getSkin(product.Skin)
	if skin then
		local plate = new("Frame", { Name = "SkinPreview", BackgroundColor3 = skin.Color, Position = UDim2.fromOffset(260, 34), Size = UDim2.fromOffset(128, 58), Parent = sheet })
		stroke(plate, 1)
		if skin.Trail then
			new("Frame", { BackgroundColor3 = skin.Trail, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 6), Parent = plate })
		end
		tag(plate, "SKIN", { Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(34, 12) })
	end
	if product.Fx then
		local swatch = fxSwatch(sheet, Config.getFx(product.Fx), { Position = UDim2.fromOffset(260, 96), Size = UDim2.fromOffset(128, 40) })
		local _, fxLabel = tag(swatch, "FX", { BackgroundColor3 = PAPER, Size = UDim2.fromOffset(24, 12) })
		fxLabel.TextColor3 = INK
	end

	text({ Text = "YOU CAN ALSO FIND THIS IN THE SHOP", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(12, 140), Size = UDim2.new(1, -24, 0, 10), Parent = sheet })
	hardButton(sheet, {
		Name = "Close",
		Fill = "paper",
		Text = "CLOSE",
		TextSize = 11,
		Position = UDim2.fromOffset(12, 156),
		Size = UDim2.fromOffset(96, 52),
		OnClick = function()
			self:_closeModal()
		end,
	})
	local buy = hardButton(sheet, {
		Name = "Buy",
		Fill = "accent",
		Text = "BUY PACK",
		TextSize = 13,
		Align = Enum.TextXAlignment.Left,
		Sub = "",
		Position = UDim2.fromOffset(116, 156),
		Size = UDim2.new(1, -128, 0, 52),
		OnClick = function()
			self:_fire("onBuyProduct", "StarterPack")
		end,
	})
	withPrice(product.Id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
	m.offerBuy = buy
end

-- Once per session, after the player's first run, if they haven't bought it.
function UI._maybeShowOffer(self)
	local m = self._menu
	if self._offerShown or not m.sheets.offer or m.modalOpen then
		return
	end
	if self._menuOpens < OFFER_AFTER_MENU_OPENS then
		return
	end
	if player:GetAttribute("Gems") == nil then
		return -- data not loaded yet; we don't know if they own it
	end
	if player:GetAttribute("StarterPackBought") == true then
		self._offerShown = true
		return
	end
	self._offerShown = true
	self:_openModal("offer")
end

function UI._refreshStarter(self)
	local m = self._menu
	local bought = player:GetAttribute("StarterPackBought") == true
	if m.starterCard then
		m.starterCard.Visible = not bought
		m.starterHeader.Visible = not bought
	end
	if bought and m.modalOpen == "offer" then
		self:_closeModal()
	end
end

function UI._setTabPip(self, index, on)
	local tab = self._menu.tabs[index]
	if tab then
		tab.pip.Visible = on
	end
end

-- Missions ---------------------------------------------------------------------------------

function UI._buildMissionsPage(self, page)
	local m = self._menu
	local _, right = sectionHeader(page, 1, "02.1", "DAILY MISSIONS")
	m.missionsRight = right
	m.missions = new("Frame", { Name = "Missions", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = page })
	list(m.missions, 6)
	m.missionsReset = text({ Text = "", TextSize = 9, TextColor3 = GREY, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 3, Parent = page })
	local _, roadRight = sectionHeader(page, 4, "02.2", "LEVEL ROAD")
	m.roadRight = roadRight
	m.levelRoad = new("Frame", { Name = "LevelRoad", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = page })
	list(m.levelRoad, 0)
end

local function readMissions()
	local raw = player:GetAttribute("Missions")
	local decoded = decodeJson(raw)
	if type(decoded) ~= "table" then
		return nil, raw
	end
	local missions = {}
	for _, entry in decoded do
		if type(entry) == "table" and entry.id ~= nil then
			local goal = math.max(1, math.floor(tonumber(entry.goal) or 1))
			table.insert(missions, {
				id = entry.id,
				text = string.upper(tostring(entry.text or "MISSION")),
				goal = goal,
				progress = math.clamp(math.floor(tonumber(entry.progress) or 0), 0, goal),
				gems = math.floor(tonumber(entry.gems) or 0),
				xp = math.floor(tonumber(entry.xp) or 0),
				claimed = entry.claimed == true,
			})
		end
	end
	return missions, raw
end

-- Rebuilds only when the Missions JSON or the reroll count actually changed.
function UI._rebuildMissions(self, force)
	local m = self._menu
	local missions, raw = readMissions()
	local rerolls = math.max(0, math.floor(attrNumber("MissionRerolls", 0)))
	local key = tostring(raw) .. "|" .. rerolls
	if not force and key == m.missionsKey then
		return
	end
	m.missionsKey = key
	local focusPath = self:_captureFocus(m.missions)
	clearRows(m.missions)
	m.missionsRight.Text = rerolls .. (if rerolls == 1 then " REROLL" else " REROLLS") .. " LEFT"

	local claimable = 0
	if missions == nil or #missions == 0 then
		text({
			Text = if missions == nil then "LOADING" else "NO MISSIONS / CHECK BACK SOON",
			TextSize = 9,
			TextColor3 = GREY,
			Size = UDim2.new(1, 0, 0, 28),
			Parent = m.missions,
		})
	else
		for i, mission in missions do
			if mission.progress >= mission.goal and not mission.claimed then
				claimable += 1
			end
			self:_buildMissionRow(m.missions, i, mission, rerolls)
		end
	end
	self:_setTabPip(TAB_MISSIONS, claimable > 0)
	self:_restoreFocus(m.missions, focusPath, m.tabs[TAB_MISSIONS].button)
end

function UI._buildMissionRow(self, parent, index, mission, rerolls)
	local complete = mission.progress >= mission.goal
	local ready = complete and not mission.claimed
	local row = new("Frame", { Name = "Mission" .. index, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 72), LayoutOrder = index, Parent = parent })
	stroke(row, if ready then 1.5 else 1, INK, if mission.claimed then 0.75 elseif ready then 0 else 0.5)
	if ready then
		local bar = new("Frame", { Size = UDim2.new(0, 4, 1, 0), Parent = row })
		setAccent(bar, "BackgroundColor3")
	end
	local fade = if mission.claimed then 0.5 else 0

	text({ Text = "M-" .. twoDigits(index), TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(10, 5), Size = UDim2.fromOffset(40, 10), Parent = row })
	text({
		Text = commas(mission.progress) .. " / " .. commas(mission.goal),
		TextSize = 8,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(50, 5),
		Size = UDim2.new(1, -152, 0, 10),
		Parent = row,
	})
	capText(text({
		Text = mission.text,
		Font = FONT_NUM,
		TextTransparency = fade,
		Position = UDim2.fromOffset(10, 16),
		Size = UDim2.new(1, -112, 0, 18),
		Parent = row,
	}), 11, 6)
	local _, fill = meter(row, { Position = UDim2.fromOffset(10, 39), Size = UDim2.new(1, -112, 0, 5) })
	fill.Size = UDim2.fromScale(mission.progress / mission.goal, 1)
	if mission.claimed then
		clearAccent(fill)
		fill.BackgroundColor3 = INK
		fill.BackgroundTransparency = 0.6
	end
	gemIcon(row, 7, UDim2.fromOffset(14, 57))
	text({
		Text = "+" .. commas(mission.gems) .. " GEMS   +" .. commas(mission.xp) .. " XP",
		TextSize = 9,
		TextTransparency = fade,
		Position = UDim2.fromOffset(24, 50),
		Size = UDim2.new(1, -126, 0, 14),
		Parent = row,
	})

	if mission.claimed then
		stamp(row, "CLAIMED", { Position = UDim2.new(1, -50, 0.5, 0), Size = UDim2.fromOffset(82, 24) }, "clear")
	elseif complete then
		local button
		button = hardButton(row, {
			Name = "Claim",
			Fill = "accent",
			Text = "CLAIM",
			TextSize = 12,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 52),
			OnClick = function()
				self:_missionAction("ClaimMission", mission, button, "CLAIMING")
			end,
		})
	elseif rerolls > 0 then
		local button
		button = hardButton(row, {
			Name = "Reroll",
			Fill = "paper",
			Text = "REROLL",
			TextSize = 10,
			Sub = "SWAP MISSION",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 50),
			OnClick = function()
				self:_missionAction("RerollMission", mission, button, "...")
			end,
		})
		button.sub.TextSize = 7
	elseif productId("ExtraReroll") ~= 0 then
		-- Out of free rerolls: one more can be bought.
		local button = hardButton(row, {
			Name = "BuyReroll",
			Fill = "paper",
			Text = "REROLL",
			TextSize = 10,
			Sub = "R$ --",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 50),
			OnClick = function()
				self:_fire("onBuyProduct", "ExtraReroll")
			end,
		})
		button.sub.TextSize = 7
		withPrice(productId("ExtraReroll"), Enum.InfoType.Product, function(price)
			if button.sub.Parent then
				button.sub.Text = "R$ " .. commas(price)
			end
		end)
	else
		capText(text({
			Text = math.floor(mission.progress / mission.goal * 100) .. "%",
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(88, 30),
			Parent = row,
		}), 16, 8)
	end
end

function UI._missionAction(self, action, mission, button, busyText)
	local m = self._menu
	if m.missionBusy then
		return
	end
	m.missionBusy = true
	button.setEnabled(false)
	button.setText(busyText)
	task.spawn(function()
		local ok, message = self:_ask("onShop", action, mission.id)
		m.missionBusy = false
		if not ok then
			self:toast(message or (if action == "ClaimMission" then "COULD NOT CLAIM" else "COULD NOT REROLL"), "error")
		end
		self:_rebuildMissions(true)
	end)
end

-- Every level unlock in order, with how far away it is.
function UI._rebuildLevelRoad(self)
	local m = self._menu
	if not m.levelRoad then
		return
	end
	clearRows(m.levelRoad)
	local level = levelInfo()
	m.roadRight.Text = "+" .. Config.LEVEL_UP_GEMS .. " GEMS EVERY LEVEL"
	local levels = {}
	for unlockLevel in Config.LevelUnlocks do
		table.insert(levels, unlockLevel)
	end
	table.sort(levels)
	local upcoming = nextUnlock(level)
	for i, unlockLevel in levels do
		local reward = Config.LevelUnlocks[unlockLevel]
		local reached = level >= unlockLevel
		local row = new("Frame", { Name = "Lv" .. unlockLevel, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = i, Parent = m.levelRoad })
		rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.8 })
		if unlockLevel == upcoming then
			local bar = new("Frame", { Size = UDim2.new(0, 3, 1, -6), Position = UDim2.fromOffset(0, 3), Parent = row })
			setAccent(bar, "BackgroundColor3")
		end
		capText(text({
			Text = "LV " .. twoDigits(unlockLevel),
			Font = FONT_NUM,
			TextTransparency = if reached or unlockLevel == upcoming then 0 else 0.45,
			Position = UDim2.fromOffset(8, 6),
			Size = UDim2.fromOffset(52, 18),
			Parent = row,
		}), 10, 7)
		rewardChip(row, reward, 10, UDim2.fromOffset(70, 15))
		text({
			Text = rewardText(reward),
			TextSize = 9,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextTransparency = if reached or unlockLevel == upcoming then 0 else 0.45,
			Position = UDim2.fromOffset(82, 0),
			Size = UDim2.new(1, -164, 1, 0),
			Parent = row,
		})
		local status = if reached then "UNLOCKED" elseif unlockLevel == upcoming then (unlockLevel - level) .. " LV TO GO" else "LOCKED"
		local statusTag, statusLabel = tag(row, status, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(76, 16) }, reached)
		if not reached then
			statusTag.BackgroundTransparency = 1
			statusLabel.TextColor3 = if unlockLevel == upcoming then INK else GREY
		end
	end
end

-- Season pass ------------------------------------------------------------------------------

function UI._buildSeasonPage(self, page)
	local m = self._menu
	local s = {}
	m.season = s
	local _, right = sectionHeader(page, 1, "03.1", "SEASON PASS")
	s.right = right

	local info = new("Frame", { Name = "Info", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 2, Parent = page })
	s.name = capText(text({ Text = Config.SEASON_NAME, Font = FONT_NUM, Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, 0, 0, 18), Parent = info }), 12, 7)
	s.tier = text({ Text = "TIER 00", TextSize = 9, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(0.5, 0, 0, 12), Parent = info })
	s.xp = text({
		Text = "",
		TextSize = 9,
		TextColor3 = GREY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 24),
		Size = UDim2.new(0.5, 0, 0, 12),
		Parent = info,
	})
	local _, fill = meter(info, { Position = UDim2.fromOffset(0, 39), Size = UDim2.new(1, 0, 0, 6) })
	s.fill = fill
	text({ Text = "EVERY RUN FILLS THE PASS / FREE ROW IS FOR EVERYONE", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(0, 49), Size = UDim2.new(1, 0, 0, 10), Parent = info })

	-- Premium unlock card (hidden once owned, or when the product isn't set up).
	local product = Config.Products.SeasonPremium
	local unlock = new("Frame", { Name = "Premium", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 3, Visible = false, Parent = page })
	notch(unlock, 10, 1, 0)
	capText(setAccent(text({ Text = "PREMIUM TRACK", Font = FONT_NUM, Position = UDim2.fromOffset(10, 7), Size = UDim2.new(1, -112, 0, 16), Parent = unlock }), "TextColor3"), 11, 7)
	text({
		Text = "UNLOCKS THE PREMIUM ROW FOR THIS SEASON: SKINS, FX AND MORE GEMS. TIERS YOU ALREADY REACHED CAN BE CLAIMED RIGHT AWAY.",
		TextSize = 7,
		TextColor3 = PAPER,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(10, 26),
		Size = UDim2.new(1, -112, 0, 36),
		Parent = unlock,
	})
	local buy = hardButton(unlock, {
		Name = "Unlock",
		Fill = "accent",
		Text = "UNLOCK",
		TextSize = 11,
		Sub = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 2),
		Size = UDim2.fromOffset(92, 54),
		OnClick = function()
			self:_fire("onBuyProduct", "SeasonPremium")
		end,
	})
	withPrice(product and product.Id, Enum.InfoType.Product, function(price)
		buy.sub.Text = "R$ " .. commas(price)
	end)
	s.unlock = unlock
	s.active = tag(page, "PREMIUM TRACK ACTIVE", { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Visible = false }, true)

	local _, trackRight = sectionHeader(page, 4, "03.2", "REWARDS")
	s.trackRight = trackRight
	local holder = new("Frame", { Name = "Track", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 146), LayoutOrder = 5, Parent = page })
	for _, rowInfo in { { "FREE", 23 }, { "PREMIUM", 81 } } do
		local label = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, rowInfo[2]), Size = UDim2.fromOffset(40, 53), Parent = holder })
		rule(label, { Size = UDim2.new(0, 2, 1, 0) })
		text({ Text = rowInfo[1], TextSize = 7, Position = UDim2.fromOffset(5, 0), Size = UDim2.new(1, -5, 1, 0), Parent = label })
	end
	local scroll = new("ScrollingFrame", {
		Name = "Tiers",
		Active = true,
		Selectable = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -42, 1, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = INK,
		HorizontalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Parent = holder,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, SEASON_COLUMN_GAP),
		Parent = scroll,
	})
	s.scroll = scroll
end

local function readSeasonClaimed()
	local decoded = decodeJson(player:GetAttribute("SeasonClaimed"))
	local claimed = { Free = {}, Premium = {} }
	if type(decoded) == "table" then
		for field, trackName in { free = "Free", premium = "Premium" } do
			local tiers = decoded[field]
			if type(tiers) == "table" then
				for _, tier in tiers do
					local n = tonumber(tier)
					if n then
						claimed[trackName][math.floor(n)] = true
					end
				end
			end
		end
	end
	return claimed
end

local function seasonProgress()
	local maxTier = #Config.SeasonTiers
	local tier = math.clamp(math.floor(attrNumber("SeasonTier", 0)), 0, maxTier)
	local need = math.max(1, Config.SEASON_TIER_XP)
	local xp = math.clamp(math.floor(attrNumber("SeasonXP", 0)), 0, need)
	return tier, xp, need, maxTier
end

function UI._refreshSeasonProgress(self)
	local s = self._menu.season
	local tier, xp, need, maxTier = seasonProgress()
	s.name.Text = string.upper(tostring(ReplicatedStorage:GetAttribute("SeasonName") or Config.SEASON_NAME))
	s.tier.Text = "TIER " .. twoDigits(tier) .. " / " .. maxTier
	local fraction = if tier >= maxTier then 1 else xp / need
	s.xp.Text = if tier >= maxTier then "PASS COMPLETE" else commas(xp) .. " / " .. commas(need) .. " XP TO TIER " .. (tier + 1)
	tween(s.fill, 0.4, { Size = UDim2.fromScale(fraction, 1) })
	if s.nextFill and s.nextFill.Parent then
		s.nextFill.Size = UDim2.fromScale(fraction, 1)
	end
end

-- Rebuilds the 30-tier track only when tier, ownership or claims change.
function UI._rebuildSeason(self, force)
	local m = self._menu
	local s = m.season
	self:_refreshSeasonProgress()
	local tier, _, _, maxTier = seasonProgress()
	local premium = player:GetAttribute("SeasonPremium") == true
	local key = tier .. "|" .. tostring(premium) .. "|" .. tostring(player:GetAttribute("SeasonClaimed"))
	if not force and key == s.key then
		return
	end
	s.key = key
	local claimed = readSeasonClaimed()
	local product = Config.Products.SeasonPremium
	s.unlock.Visible = not premium and product ~= nil and product.Id ~= 0
	s.active.Visible = premium

	local focusPath = self:_captureFocus(s.scroll)
	clearRows(s.scroll)
	local faces = { Free = {}, Premium = {} }
	s.nextFill = nil
	local claimable, firstClaimable = 0, nil
	for t = 1, maxTier do
		local rewards = Config.SeasonTiers[t] or {}
		local reached = t <= tier
		local column = new("Frame", { Name = "Tier" .. t, BackgroundTransparency = 1, Size = UDim2.fromOffset(SEASON_COLUMN_W, 138), LayoutOrder = t, Parent = s.scroll })
		local head = new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = if reached then 0 else 1, Size = UDim2.new(1, -3, 0, 18), Parent = column })
		if not reached then
			stroke(head, 1, INK, 0.6)
		end
		text({
			Text = "T" .. twoDigits(t),
			Font = FONT_NUM,
			TextSize = 9,
			TextColor3 = if reached then PAPER else INK,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = head,
		})
		if t == tier + 1 then
			local _, fill = meter(column, { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, -3, 0, 3) })
			s.nextFill = fill
		end
		for _, trackName in { "Free", "Premium" } do
			local reward = rewards[trackName]
			local state
			if reward == nil then
				state = "empty"
			elseif claimed[trackName][t] then
				state = "claimed"
			elseif trackName == "Premium" and not premium then
				state = "premiumLocked"
			elseif reached then
				state = "claimable"
			else
				state = "locked"
			end
			if state == "claimable" then
				claimable += 1
				firstClaimable = firstClaimable or t
			end
			faces[trackName][t] = self:_buildSeasonCell(column, if trackName == "Free" then 23 else 81, trackName, t, reward, state)
		end
	end
	self:_linkSeasonTrack(faces, maxTier)
	self:_restoreFocus(s.scroll, focusPath, m.tabs[TAB_SEASON].button)
	self:_refreshSeasonProgress()
	s.trackRight.Text = if claimable > 0 then claimable .. " TO CLAIM" else "SWIPE FOR ALL " .. maxTier .. " TIERS"
	s.focusTier = firstClaimable or math.min(tier + 1, maxTier)
	self:_setTabPip(TAB_SEASON, claimable > 0)
	self:_scrollSeasonTrack()
end

function UI._buildSeasonCell(self, column, y, trackName, tier, reward, state)
	local holder = new("Frame", { Name = trackName, BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 56), Parent = column })
	if state == "empty" then
		local blank = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -3, 1, -3), Parent = holder })
		stroke(blank, 1, INK, 0.85)
		text({ Text = "--", TextSize = 9, TextColor3 = GREY, TextTransparency = 0.4, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = blank })
		return nil
	end
	local claimable = state == "claimable"
	local locked = state == "locked" or state == "premiumLocked"
	if claimable then
		new("Frame", { Name = "Shadow", BackgroundColor3 = INK, Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -3, 1, -3), Parent = holder })
	end
	local face = new("TextButton", {
		Name = "Face",
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		BackgroundColor3 = PAPER,
		BackgroundTransparency = if locked then 0.4 else 0,
		Size = UDim2.new(1, -3, 1, -3),
		Parent = holder,
	})
	stroke(face, if claimable then 1.5 else 1, INK, if claimable or state == "claimed" then 0 else 0.5)
	if claimable then
		setAccent(face, "BackgroundColor3")
	end
	if state == "premiumLocked" then
		hatch(face, { Name = "Hatch", Size = UDim2.new(0, 5, 1, 0) }, INK, 0.3, 3)
	end
	local dim = if claimable then 0 elseif state == "claimed" then 0.55 else 0.4
	rewardChip(face, reward, 9, UDim2.fromOffset(11, 9))

	local big, small
	if reward.Skin then
		big, small = skinName(reward.Skin), if reward.Fx then "SKIN + FX" else "SKIN"
	elseif reward.Fx then
		big, small = fxName(reward.Fx), "FX"
	elseif reward.Boost and not reward.Gems then
		big, small = boostName(reward.Boost), "BOOST"
	else
		big, small = "+" .. commas(reward.Gems or 0), if reward.Boost then "GEMS + BOOST" else "GEMS"
	end
	capText(text({
		Text = big,
		Font = FONT_NUM,
		TextTransparency = dim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(3, 16),
		Size = UDim2.new(1, -6, 0, 14),
		Parent = face,
	}), 10, 5)
	text({
		Text = small,
		TextSize = 7,
		TextTransparency = dim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 9),
		Parent = face,
	})
	local status = if claimable then "CLAIM" elseif state == "claimed" then "CLAIMED" elseif state == "premiumLocked" then "PREMIUM" else "LOCKED"
	local statusTag, statusLabel = tag(face, status, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -3), Size = UDim2.new(1, -6, 0, 11) })
	statusLabel.TextSize = 7
	if not claimable then
		statusTag.BackgroundTransparency = 1
		statusLabel.TextColor3 = if state == "claimed" then INK else GREY
	end

	face.Activated:Connect(function()
		if state == "claimable" then
			self:_claimSeasonTier(trackName, tier, statusLabel)
		elseif state == "premiumLocked" then
			self:toast("PREMIUM TRACK REWARD", "info")
		elseif state == "locked" then
			self:toast("REACH TIER " .. tier .. " TO CLAIM", "info")
		end
	end)
	return face
end

-- Gamepad: LEFT / RIGHT walk along a row (skipping empty slots), UP / DOWN hop
-- between the free and premium rows. The track scrolls to follow the selection.
function UI._linkSeasonTrack(self, faces, maxTier)
	local function nearest(row, from, step)
		local t = from + step
		while t >= 1 and t <= maxTier do
			if row[t] then
				return row[t]
			end
			t += step
		end
		return nil
	end
	local function closest(row, t)
		if row[t] then
			return row[t]
		end
		return nearest(row, t, -1) or nearest(row, t, 1)
	end
	for trackName, row in faces do
		local other = if trackName == "Free" then faces.Premium else faces.Free
		for t, face in row do
			face.NextSelectionLeft = nearest(row, t, -1)
			face.NextSelectionRight = nearest(row, t, 1)
			if trackName == "Free" then
				face.NextSelectionDown = closest(other, t)
			else
				face.NextSelectionUp = closest(other, t)
			end
		end
	end
end

function UI._claimSeasonTier(self, trackName, tier, statusLabel)
	local s = self._menu.season
	if s.busy then
		return
	end
	s.busy = true
	statusLabel.Text = "..."
	task.spawn(function()
		local ok, message = self:_ask("onShop", "ClaimSeasonTier", { track = trackName, tier = tier })
		s.busy = false
		if not ok then
			self:toast(message or "COULD NOT CLAIM", "error")
		end
		self:_rebuildSeason(true)
	end)
end

-- Bring the first claimable (or next) tier into view, one column of context on the left.
function UI._scrollSeasonTrack(self)
	local s = self._menu.season
	if not s or not s.focusTier then
		return
	end
	local focus = s.focusTier
	task.delay(0.1, function()
		if s.scroll.Parent then
			s.scroll.CanvasPosition = Vector2.new(math.max(0, (focus - 2) * (SEASON_COLUMN_W + SEASON_COLUMN_GAP)), 0)
		end
	end)
end

-- Missions reset + season end countdowns (ticked once a second while the menu is open).
function UI._refreshCountdowns(self)
	local m = self._menu
	local now = math.floor(workspace:GetServerTimeNow()) -- server clock, not the device clock
	local reset = tonumber(player:GetAttribute("MissionsReset"))
	if reset and reset > now then
		m.missionsReset.Text = "NEW MISSIONS IN " .. clock(reset - now)
	elseif reset then
		m.missionsReset.Text = "NEW MISSIONS ARRIVING"
	else
		m.missionsReset.Text = ""
	end
	local ends = tonumber(ReplicatedStorage:GetAttribute("SeasonEnds")) or Config.SEASON_ENDS
	if ends and ends > 0 then
		m.season.right.Text = if ends > now then "ENDS IN " .. longClock(ends - now) else "SEASON ENDED"
	else
		m.season.right.Text = ""
	end
end

-- Menu data ---------------------------------------------------------------------------------

function UI._refreshStats(self)
	local m = self._menu
	m.best.Text = commas(player:GetAttribute("Best") or 0)
	local gems = commas(player:GetAttribute("Gems") or 0)
	m.gems.Text = gems
	m.shopGems.Text = "BALANCE " .. gems
	self:_refreshPlayIndex()
	self:_refreshSkins()
	self:_refreshFx()
	self:_refreshBoostPop()
	self:_refreshTopUp()
end

-- Level badge, XP bar and the "next unlock" note under the stats strip.
function UI._refreshLevel(self)
	local m = self._menu
	local level, xp, needed = levelInfo()
	m.level.Text = "LV " .. twoDigits(level)
	tween(m.xpFill, 0.4, { Size = UDim2.fromScale(xp / needed, 1) })
	local note = "XP " .. commas(xp) .. " / " .. commas(needed)
	local unlockLevel, reward = nextUnlock(level)
	if unlockLevel then
		note ..= " / NEXT: " .. rewardText(reward) .. " AT LV " .. unlockLevel
	end
	m.xpNote.Text = note
	if m.levelValue and level > m.levelValue and m.root.Visible then
		m.levelBump.Scale = 1.25
		tween(m.levelBump, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if level ~= m.levelValue then
		m.levelValue = level
		self:_rebuildLevelRoad()
	end
end

-- Streak state as the UI shows it. Claiming after StreakExpires restarts at day 1.
local function dailyState()
	local now = math.floor(workspace:GetServerTimeNow()) -- server clock, not the device clock
	local nextDaily = tonumber(player:GetAttribute("NextDaily"))
	local expires = tonumber(player:GetAttribute("StreakExpires"))
	local day = math.clamp(math.floor(attrNumber("StreakDay", 1)), 1, #Config.DailyStreak)
	local broken = expires ~= nil and expires > 0 and now > expires
	-- The streak saver only makes sense while the lost streak is still on record.
	-- If the server already reset StreakDay to 1 there is nothing left to save.
	local lostDay = math.floor(attrNumber("StreakDay", 1))
	local saveDay = nil
	if broken and lostDay > 1 and productId("StreakSaver") ~= 0 then
		saveDay = math.min(lostDay, #Config.DailyStreak)
	end
	if broken then
		day = 1
	end
	return {
		now = now,
		day = day,
		broken = broken,
		saveDay = saveDay,
		ready = nextDaily ~= nil and now >= nextDaily,
		wait = if nextDaily then nextDaily - now else nil,
	}
end

function UI._refreshDaily(self)
	local m = self._menu
	local daily = m.daily
	local state = dailyState()
	local reward = Config.DailyStreak[state.day] or {}

	-- Streak pips: done days ink, today accent, the rest outlined.
	local key = state.day .. (if state.ready then "R" else "W") .. (if state.broken then "B" else "") .. (state.saveDay or 0)
	if key ~= m.dailyKey then
		m.dailyKey = key
		for day, pip in m.dailyPips do
			local done = day < state.day
			local today = day == state.day
			if today then
				setAccent(pip.frame, "BackgroundColor3")
				pip.frame.BackgroundTransparency = 0
			else
				clearAccent(pip.frame)
				pip.frame.BackgroundColor3 = INK
				pip.frame.BackgroundTransparency = if done then 0 else 1
			end
			pip.stroke.Transparency = if done or today then 0 else 0.5
		end
		self:_refreshDailySheet(state)
	end

	if not self._dailyBusy then
		if state.ready ~= self._dailyReady then
			self._dailyReady = state.ready
			daily.setFill(if state.ready then "accent" else "paper")
		end
		daily.index.Text = if state.saveDay
			then "B / DAILY / STREAK BROKEN / SAVE IT"
			else "B / DAILY / DAY " .. state.day .. " OF " .. #Config.DailyStreak
		if state.ready then
			daily.setText("CLAIM +" .. commas(reward.Gems or 0))
		elseif state.wait then
			daily.setText(clock(state.wait))
		else
			daily.setText("--:--:--")
		end
	end
	self:_tickDailySheet(state)
end

function UI._claimDaily(self)
	if self._dailyBusy or not dailyState().ready then
		return
	end
	self._dailyBusy = true
	local d = self._dailySheet
	d.claim.setEnabled(false)
	d.claim.setText("CLAIMING")
	self._menu.daily.setText("CLAIMING")
	local claimedDay = dailyState().day
	task.spawn(function()
		local ok, message
		if type(self._callbacks.onClaimDaily) == "function" then
			ok, message = self:_ask("onClaimDaily")
		else
			ok, message = self:_ask("onShop", "ClaimDaily")
		end
		self._dailyBusy = false
		self._dailyReady = nil
		self._menu.dailyKey = nil
		d.ready = nil
		if ok then
			-- The server's Reward event toasts the amount; here the day gets stamped.
			local cell = d.cells[claimedDay]
			if cell then
				cell.bump.Scale = 1.2
				tween(cell.bump, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		else
			self:toast(message or "COULD NOT CLAIM", "error")
		end
		self:_refreshDaily()
	end)
end

function UI._rebuildTopRuns(self)
	local container = self._menu.runs
	clearRows(container)

	local raw = ReplicatedStorage:GetAttribute("TopRuns")
	local runs = nil
	if type(raw) == "string" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(decoded) == "table" then
			runs = decoded
		end
	end

	if runs == nil or #runs == 0 then
		text({
			Text = if runs == nil then "LOADING" else "NO RUNS YET / BE THE FIRST",
			TextSize = 9,
			TextColor3 = GREY,
			Size = UDim2.new(1, 0, 0, 28),
			Parent = container,
		})
		return
	end

	for i, run in runs do
		if i > 10 then
			break
		end
		local name = string.upper(tostring(run.name or "???"))
		local isMe = run.name == player.Name
		local row = new("Frame", {
			Name = "Run" .. i,
			BackgroundColor3 = INK,
			BackgroundTransparency = if isMe then 0 else 1,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = i,
			Parent = container,
		})
		local ink = if isMe then PAPER else INK
		if (tonumber(run.rank) or i) == 1 then
			local bar = new("Frame", { Size = UDim2.new(0, 3, 1, 0), Parent = row })
			setAccent(bar, "BackgroundColor3")
		end
		local rank = text({ Text = twoDigits(run.rank or i), TextSize = 9, TextColor3 = if isMe then PAPER else GREY, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0, 22, 1, 0), Parent = row })
		if isMe then
			setAccent(rank, "TextColor3")
		end
		text({
			Text = name,
			TextSize = 10,
			TextColor3 = ink,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(34, 0),
			Size = UDim2.new(1, -124, 1, 0),
			Parent = row,
		})
		capText(text({
			Text = commas(run.meters or 0) .. " M",
			Font = FONT_NUM,
			TextColor3 = ink,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 0),
			Size = UDim2.new(0, 86, 1, 0),
			Parent = row,
		}), 10, 7)
		if not isMe then
			rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.85 })
		end
	end
end

function UI._rebuildPasses(self)
	local m = self._menu
	local focusPath = self:_captureFocus(m.passes)
	clearRows(m.passes)
	local shown = 0
	for order, key in PASS_ORDER do
		local pass = Config.GamePasses[key]
		if pass and pass.Id ~= 0 and not hasPass(key) then
			shown += 1
			local info = PASS_INFO[key]
			local card = new("Frame", { Name = key, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = order, Parent = m.passes })
			stroke(card, 1, INK, 0.5)
			local code = new("Frame", { BackgroundColor3 = INK, Position = UDim2.fromOffset(6, 8), Size = UDim2.fromOffset(44, 44), Parent = card })
			capText(setAccent(text({
				Text = info.code,
				Font = FONT_NUM,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = code,
			}), "TextColor3"), 12, 7)
			capText(text({ Text = info.title, Font = FONT_NUM, Position = UDim2.fromOffset(58, 8), Size = UDim2.new(1, -146, 0, 16), Parent = card }), 11, 7)
			text({
				Text = info.copy,
				TextSize = 8,
				TextColor3 = GREY,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				Position = UDim2.fromOffset(58, 26),
				Size = UDim2.new(1, -146, 0, 28),
				Parent = card,
			})
			local buy = hardButton(card, {
				Name = "Buy",
				Fill = "accent",
				Text = "GET",
				TextSize = 12,
				Sub = "",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6, 0.5, 0),
				Size = UDim2.fromOffset(78, 50),
				OnClick = function()
					self:_fire("onBuyPass", key)
				end,
			})
			withPrice(pass.Id, Enum.InfoType.GamePass, function(price)
				if buy.sub.Parent then
					buy.sub.Text = "R$ " .. commas(price)
				end
			end)
		end
	end
	m.passHeader.Visible = shown > 0
	m.passes.Visible = shown > 0
	self:_restoreFocus(m.passes, focusPath, m.tabs[1].button)
end

function UI._rebuildZones(self)
	local m = self._menu
	local focusPath = self:_captureFocus(m.zones)
	clearRows(m.zones)
	local reached = math.max(0, math.floor(tonumber(player:GetAttribute("Checkpoint")) or 0))
	local unlocked = hasPass("Checkpoints")
	m.zonesRight.Text = "REACHED " .. twoDigits(reached)

	local passId = Config.GamePasses.Checkpoints.Id
	if not unlocked and reached > 0 and passId ~= 0 then
		local holder = new("Frame", { Name = "Unlock", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 0, Parent = m.zones })
		local unlock = hardButton(holder, {
			Name = "UnlockAll",
			Fill = "accent",
			Text = "UNLOCK ALL ZONES",
			TextSize = 12,
			Sub = "",
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.new(1, 0, 0, 50),
			OnClick = function()
				self:_fire("onBuyPass", "Checkpoints")
			end,
		})
		withPrice(passId, Enum.InfoType.GamePass, function(price)
			if unlock.sub.Parent then
				unlock.sub.Text = "R$ " .. commas(price)
			end
		end)
	end

	local function zoneRow(i, locked, uncharted)
		local theme = themeFor(i)
		local row = new("Frame", { Name = "Zone" .. i, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = i + 1, Parent = m.zones })
		rule(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), BackgroundTransparency = 0.8 })

		-- Two-tone chip: zone accent over its wall color.
		local chip = new("Frame", {
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = if uncharted then 0.7 else 0,
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.fromOffset(36, 36),
			Parent = row,
		})
		stroke(chip, 1.5, INK, if uncharted then 0.6 else 0)
		new("Frame", {
			BackgroundColor3 = theme.Wall,
			BackgroundTransparency = if uncharted then 0.7 else 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 11),
			Parent = chip,
		})

		local title = if i == 0 then "START" else "ZONE " .. twoDigits(i)
		capText(text({
			Text = title,
			Font = FONT_NUM,
			TextTransparency = if uncharted then 0.55 else 0,
			Position = UDim2.fromOffset(46, 12),
			Size = UDim2.new(1, -130, 0, 18),
			Parent = row,
		}), 13, 7)
		text({
			Text = (if uncharted then "UNCHARTED / " else "FROM ") .. commas(math.floor(Config.checkpointMeters(i) + 0.5)) .. " M",
			TextSize = 9,
			TextColor3 = GREY,
			Position = UDim2.fromOffset(46, 32),
			Size = UDim2.new(1, -130, 0, 12),
			Parent = row,
		})

		if uncharted then
			return
		elseif locked then
			local tag = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(70, 24), Parent = row })
			stroke(tag, 1, INK, 0.3)
			text({ Text = "LOCKED", TextSize = 9, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = tag })
		else
			hardButton(row, {
				Name = "Go",
				Fill = if i == 0 then "paper" else "accent",
				Text = "GO",
				TextSize = 12,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(74, 50),
				OnClick = function()
					self:_fire("onPlay", i, self:_pickedBoosts())
				end,
			})
		end
	end

	for i = 0, reached do
		zoneRow(i, i > 0 and not unlocked, false)
	end
	zoneRow(reached + 1, true, true)
	self:_restoreFocus(m.zones, focusPath, m.tabs[4].button)
end

function UI._refreshSkins(self)
	local m = self._menu
	if not m or not m.skinCards then
		return
	end
	local owned = ownedSkins()
	local equipped = player:GetAttribute("EquippedSkin") or "Default"
	local gems = tonumber(player:GetAttribute("Gems")) or 0
	local ownedCount = 0
	for _, skin in Config.Skins do
		if owned[skin.Id] then
			ownedCount += 1
		end
		local card = m.skinCards[skin.Id]
		if card and not card.busy then
			local button = card.button
			if equipped == skin.Id then
				card.state = "equipped"
				button.setFill("accent")
				button.setText("EQUIPPED")
				button.setEnabled(false)
				card.outline.Thickness = 2
				card.outline.Transparency = 0
			elseif owned[skin.Id] then
				card.state = "owned"
				button.setFill("paper")
				button.setText("EQUIP")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			elseif skin.Price <= 0 and skin.Source then
				-- Earned through levels / streak / season / offers, never sold for gems.
				card.state = "locked"
				button.setFill("paper")
				button.setText(skin.Source)
				button.setEnabled(false)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			else
				card.state = "buy"
				button.setFill("ink")
				button.setText("BUY")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			end
			if skin.Price > 0 then
				local short = skin.Price - gems
				card.price.Text = commas(skin.Price)
					.. " GEMS"
					.. (if card.state == "buy" and short > 0 then " / -" .. commas(short) else "")
			elseif skin.Source then
				card.price.Text = if card.state == "locked" then "LOCKED / EARN IT" else "EARNED / " .. skin.Source
			end
		end
	end
	m.skinsRight.Text = ownedCount .. " / " .. #Config.Skins .. " OWNED"
end

function UI._skinAction(self, card)
	if card.busy or card.state == "equipped" or card.state == "locked" then
		return
	end
	local buying = card.state == "buy"
	card.busy = true
	card.button.setEnabled(false)
	card.button.setText(if buying then "BUYING" else "EQUIPPING")
	task.spawn(function()
		local ok, message = self:_ask(if buying then "onBuySkin" else "onEquipSkin", card.skin.Id)
		card.busy = false
		if ok and buying then
			self:toast(string.upper(card.skin.Name) .. " UNLOCKED", "reward")
		elseif not ok then
			self:toast(message or (if buying then "PURCHASE FAILED" else "COULD NOT EQUIP"), "error")
			if buying then
				self:_offerTopUp(card.skin.Price, self._menu.panel)
			end
		end
		self:_refreshSkins()
	end)
end

function UI._refreshFx(self)
	local m = self._menu
	if not m or not m.fxCards then
		return
	end
	local owned = ownedFx()
	local equipped = player:GetAttribute("EquippedFx")
	if type(equipped) ~= "string" or equipped == "" then
		equipped = "Classic"
	end
	local gems = tonumber(player:GetAttribute("Gems")) or 0
	local ownedCount = 0
	for _, fx in Config.ShatterFx do
		if owned[fx.Id] then
			ownedCount += 1
		end
		local card = m.fxCards[fx.Id]
		if card and not card.busy then
			local button = card.button
			if equipped == fx.Id then
				card.state = "equipped"
				button.setFill("accent")
				button.setText("EQUIPPED")
				button.setEnabled(false)
				card.outline.Thickness = 2
				card.outline.Transparency = 0
			elseif owned[fx.Id] then
				card.state = "owned"
				button.setFill("paper")
				button.setText("EQUIP")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			elseif fx.Price <= 0 then
				card.state = "locked"
				button.setFill("paper")
				button.setText(fx.Source or "LOCKED")
				button.setEnabled(false)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			else
				card.state = "buy"
				button.setFill("ink")
				button.setText("BUY")
				button.setEnabled(true)
				card.outline.Thickness = 1
				card.outline.Transparency = 0.5
			end
			if fx.Price > 0 then
				local short = fx.Price - gems
				card.price.Text = commas(fx.Price) .. " GEMS" .. (if card.state == "buy" and short > 0 then " / -" .. commas(short) else "")
			elseif fx.Source then
				card.price.Text = if card.state == "locked" then "LOCKED / EARN IT" else "EARNED / " .. fx.Source
			end
		end
	end
	m.fxRight.Text = ownedCount .. " / " .. #Config.ShatterFx .. " OWNED"
end

function UI._fxAction(self, card)
	if card.busy or card.state == "equipped" or card.state == "locked" then
		return
	end
	local buying = card.state == "buy"
	card.busy = true
	card.button.setEnabled(false)
	card.button.setText(if buying then "BUYING" else "EQUIPPING")
	task.spawn(function()
		local ok, message = self:_ask("onShop", if buying then "BuyFx" else "EquipFx", card.fx.Id)
		card.busy = false
		if ok and buying then
			self:toast(string.upper(card.fx.Name) .. " FX UNLOCKED", "reward")
		elseif not ok then
			self:toast(message or (if buying then "PURCHASE FAILED" else "COULD NOT EQUIP"), "error")
			if buying then
				self:_offerTopUp(card.fx.Price, self._menu.panel)
			end
		end
		self:_refreshFx()
	end)
end

-- HUD -----------------------------------------------------------------------------

function UI._buildHud(self)
	local h = { cells = {}, pips = {} }
	self._hud = h

	local layer = new("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	h.layer = layer
	-- Everything that shakes lives in `root`; the layer itself never moves.
	local root = new("Frame", { Name = "Shake", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = layer })
	h.root = root

	-- Balls odometer -------------------------------------------------------
	local plate = new("Frame", {
		Name = "Balls",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, EDGE - 4),
		Size = UDim2.fromOffset(176, 92),
		Parent = root,
	})
	fit(plate, HUD_SCALE)
	h.plateStroke = stroke(plate, 1.5)
	h.alarm = new("Frame", { Name = "Alarm", BackgroundColor3 = DANGER, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = plate })
	cropMarks(plate, 6, 3)
	local chip = new("Frame", { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(5, 5), Parent = plate })
	setAccent(chip, "BackgroundColor3")
	text({ Text = "BALLS", TextSize = 9, Position = UDim2.fromOffset(17, 2), Size = UDim2.fromOffset(80, 12), Parent = plate })
	text({ Text = "01", TextSize = 8, TextColor3 = GREY, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -48, 0, 2), Size = UDim2.fromOffset(40, 12), Parent = plate })

	local digits = new("Frame", { Name = "Digits", BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 16), Size = UDim2.fromOffset(160, 44), Parent = plate })
	h.bump = new("UIScale", { Parent = digits })
	for i = 1, 4 do
		local cell = new("Frame", {
			Name = "Cell" .. i,
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Position = UDim2.fromOffset((i - 1) * 40, 0),
			Size = UDim2.fromOffset(40, 44),
			Parent = digits,
		})
		if i > 1 then
			rule(cell, { Size = UDim2.new(0, 1, 1, -8), Position = UDim2.fromOffset(0, 4), BackgroundTransparency = 0.82 })
		end
		local label = capText(text({
			Text = "0",
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 0.82,
			Size = UDim2.fromScale(1, 1),
			Parent = cell,
		}), 34, 10)
		h.cells[i] = { label = label, char = "0" }
	end
	rule(plate, { Position = UDim2.fromOffset(8, 62), Size = UDim2.new(1, -16, 0, 1), BackgroundTransparency = 0.6 })

	-- Multiball pips + streak bar
	text({ Text = "MULTI", TextSize = 9, Position = UDim2.fromOffset(8, 65), Size = UDim2.fromOffset(44, 16), Parent = plate })
	for i = 1, Config.MAX_MULTIBALL do
		local pip = new("Frame", {
			Name = "Pip" .. i,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(60 + (i - 1) * 16, 73),
			Size = UDim2.fromOffset(11, 11),
			Parent = plate,
		})
		setAccent(pip, "BackgroundColor3")
		stroke(pip, 1)
		h.pips[i] = pip
	end
	h.level = capText(text({
		Text = "x1",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 65),
		Size = UDim2.fromOffset(36, 16),
		Parent = plate,
	}), 12, 7)
	local track = new("Frame", { BackgroundColor3 = INK, BackgroundTransparency = 0.82, Position = UDim2.fromOffset(8, 84), Size = UDim2.new(1, -16, 0, 3), Parent = plate })
	h.streak = new("Frame", { Size = UDim2.fromScale(0, 1), Parent = track })
	setAccent(h.streak, "BackgroundColor3")

	-- Controller hint under the odometer during the first run ("R2 THROW").
	h.throwHint = inputHint(plate, { { "R2", "THROW" } }, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 5),
		Size = UDim2.new(1, 0, 0, 14),
	})

	-- Active boosts hang under the odometer (children of the plate, so they share its scale).
	self:_buildBoostRail(plate)

	-- Zone (top-left) -------------------------------------------------------
	local zone = new("Frame", { Name = "Zone", BackgroundColor3 = PAPER, BackgroundTransparency = 0.1, Position = UDim2.fromOffset(EDGE, EDGE - 4), Size = UDim2.fromOffset(88, 46), Parent = root })
	fit(zone, HUD_SCALE)
	stroke(zone, 1.5)
	local zoneBar = new("Frame", { Size = UDim2.new(0, 4, 1, 0), Parent = zone })
	setAccent(zoneBar, "BackgroundColor3")
	notch(zone, 9, 1, 0, INK)
	text({ Text = "03 / ZONE", TextSize = 8, Position = UDim2.fromOffset(12, 3), Size = UDim2.fromOffset(70, 10), Parent = zone })
	h.zone = capText(text({ Text = "00", Font = FONT_NUM, Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(70, 28), Parent = zone }), 22, 9)

	-- Distance + ruler (top-right) -----------------------------------------
	local dist = new("Frame", {
		Name = "Distance",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -EDGE, 0, EDGE - 4),
		Size = UDim2.fromOffset(150, 62),
		Parent = root,
	})
	fit(dist, HUD_SCALE)
	stroke(dist, 1.5)
	text({ Text = "02 / DISTANCE", TextSize = 8, Position = UDim2.fromOffset(8, 3), Size = UDim2.fromOffset(120, 10), Parent = dist })
	h.meters = capText(text({
		Text = "0",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(8, 13),
		Size = UDim2.fromOffset(116, 26),
		Parent = dist,
	}), 22, 9)
	text({ Text = "M", TextSize = 11, TextYAlignment = Enum.TextYAlignment.Bottom, Position = UDim2.fromOffset(128, 13), Size = UDim2.fromOffset(14, 22), Parent = dist })
	local ruler = new("Frame", { Name = "Ruler", BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(8, 43), Size = UDim2.fromOffset(134, 14), Parent = dist })
	h.tickPx, h.tickPeriod = 6, 30
	h.ticks = new("Frame", { Name = "Ticks", BackgroundTransparency = 1, Size = UDim2.fromOffset(134 + 36, 14), Parent = ruler })
	rulerTicks(h.ticks, 134 + 36, 12, h.tickPx, 5, 0)
	rule(ruler, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	local marker = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 2, 1, 0), Parent = ruler })
	setAccent(marker, "BackgroundColor3")

	-- Ball pack (bottom-right) ---------------------------------------------
	local pack = Config.Products.BallPack
	if pack.Id ~= 0 then
		local buy = hardButton(root, {
			Name = "BallPack",
			Fill = "accent",
			Text = "+" .. pack.Balls .. " BALLS",
			TextSize = 12,
			Sub = "",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -EDGE, 1, -EDGE),
			Size = UDim2.fromOffset(122, 52),
			OnClick = function()
				self:_fire("onBuyProduct", "BallPack")
			end,
		})
		fit(buy.holder)
		withPrice(pack.Id, Enum.InfoType.Product, function(price)
			buy.sub.Text = "R$ " .. commas(price)
		end)
	end

	-- Shield quick-buy (bottom-left, away from the aim area): only while low on
	-- balls and not already shielded. See _refreshQuickShield.
	local shieldId = productId("BoostShield")
	if shieldId ~= 0 then
		local shieldBoost = boostInfo("Shield")
		local quick = hardButton(root, {
			Name = "QuickShield",
			Fill = "accent",
			Text = "SHIELD",
			TextSize = 12,
			Sub = "R$ --",
			Align = Enum.TextXAlignment.Left,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, EDGE, 1, -EDGE),
			Size = UDim2.fromOffset(122, 52),
			OnClick = function()
				self:_fire("onBuyProduct", "BoostShield")
			end,
		})
		quick.label.Size = UDim2.new(1, -40, 0.6, 0)
		quick.sub.Size = UDim2.new(1, -40, 0.4, -2)
		local block = new("Frame", {
			Name = "Mark",
			BackgroundColor3 = INK,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(26, 34),
			Parent = quick.face,
		})
		shieldGlyph(block, 14, UDim2.fromScale(0.5, 0.5), shieldBoost and shieldBoost.Color or PAPER)
		fit(quick.holder)
		quick.bump = new("UIScale", { Parent = quick.face })
		quick.holder.Visible = false
		withPrice(shieldId, Enum.InfoType.Product, function(price)
			quick.sub.Text = "R$ " .. commas(price)
		end)
		h.quickShield = quick
	end
end

-- One small plate per boost; hidden until setBoosts says it is running.
function UI._buildBoostRail(self, plate)
	local h = self._hud
	local rail = new("Frame", {
		Name = "BoostRail",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.fromOffset(340, 30),
		Parent = plate,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = rail,
	})
	local b = { items = {}, rail = rail }
	h.boostRail = b

	-- { id, small label, has a countdown bar }
	local specs = {
		{ "Shield", "SHIELD", false },
		{ "Magnet", "MAGNET", true },
		{ "SlowMo", "SLOW-MO", true },
		{ "MegaBall", "MEGA BALL", true },
		{ "DoubleGems", "THIS RUN", false },
	}
	for order, spec in specs do
		local id = spec[1]
		local boost = boostInfo(id)
		if boost then
			local color = boost.Color or accentColor
			local frame = new("Frame", {
				Name = id,
				BackgroundColor3 = PAPER,
				BackgroundTransparency = 0.1,
				Size = UDim2.fromOffset(64, 30),
				LayoutOrder = order,
				Visible = false,
				Parent = rail,
			})
			stroke(frame, 1)
			local scale = new("UIScale", { Parent = frame })
			-- Ink icon block on the left.
			local block = new("Frame", { Name = "Mark", BackgroundColor3 = INK, Size = UDim2.new(0, 16, 1, 0), Parent = frame })
			if id == "Shield" then
				shieldGlyph(block, 10, UDim2.fromScale(0.5, 0.5), color)
			elseif id == "DoubleGems" then
				local gem = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(7, 7),
					Rotation = 45,
					BackgroundColor3 = color,
					Parent = block,
				})
				stroke(gem, 1, PAPER, 0.3)
			else
				local swatch = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(8, 8),
					BackgroundColor3 = color,
					Parent = block,
				})
				rule(swatch, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 1) })
			end
			text({ Text = spec[2], TextSize = 7, TextColor3 = GREY, Position = UDim2.fromOffset(20, 2), Size = UDim2.new(1, -22, 0, 9), Parent = frame })
			local value = capText(text({
				Text = "",
				Font = FONT_NUM,
				Position = UDim2.fromOffset(20, 11),
				Size = UDim2.new(1, -22, 0, 14),
				Parent = frame,
			}), 11, 6)
			local fill = nil
			if spec[3] then
				local track = new("Frame", {
					BackgroundColor3 = INK,
					BackgroundTransparency = 0.82,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 16, 1, 0),
					Size = UDim2.new(1, -16, 0, 3),
					Parent = frame,
				})
				fill = new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), Parent = track })
			end
			b.items[id] = { frame = frame, value = value, fill = fill, scale = scale }
		end
	end
end

-- Only touches instances when something visible actually changed.
function UI._setIndicator(self, item, visible, number, fraction, label)
	if not item then
		return
	end
	if visible ~= item.visible then
		item.visible = visible
		item.frame.Visible = visible
		if visible then
			item.scale.Scale = 1.25
			tween(item.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
	if not visible then
		return
	end
	if number ~= item.number then
		item.number = number
		item.value.Text = label
	end
	if item.fill and fraction then
		local rounded = math.floor(math.clamp(fraction, 0, 1) * 100 + 0.5) / 100
		if rounded ~= item.fraction then
			item.fraction = rounded
			item.fill.Size = UDim2.fromScale(rounded, 1)
		end
	end
end

function UI._refreshQuickShield(self)
	local h = self._hud
	local quick = h.quickShield
	if not quick then
		return
	end
	local shielded = h.boostRail ~= nil and h.boostRail.shield == true
	local show = h.balls ~= nil and h.balls <= LOW_BALLS_OFFER and not shielded
	if show ~= quick.shown then
		quick.shown = show
		quick.holder.Visible = show
		if show then
			quick.bump.Scale = 0.8
			tween(quick.bump, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end
end

-- Forget what the rail showed; the next setBoosts redraws it from scratch.
function UI._resetBoostRail(self)
	local h = self._hud
	local b = h.boostRail
	if b then
		b.shield = nil
		b.shieldUsedAt = nil
		for _, item in b.items do
			item.visible = false
			item.number = nil
			item.fraction = nil
			item.frame.Visible = false
		end
	end
	if h.quickShield then
		h.quickShield.shown = nil
	end
end

function UI._setDigits(self, balls, rising)
	local h = self._hud
	local s = string.format("%04d", math.clamp(balls, 0, 9999))
	local firstSignificant = 4
	for i = 1, 4 do
		if string.sub(s, i, i) ~= "0" then
			firstSignificant = i
			break
		end
	end
	for i, cell in h.cells do
		local char = string.sub(s, i, i)
		if char ~= cell.char then
			cell.char = char
			cell.label.Text = char
			cell.label.Position = UDim2.fromOffset(0, if rising then 16 else -16)
			tween(cell.label, 0.18, { Position = UDim2.new() })
		end
		cell.label.TextTransparency = if i < firstSignificant then 0.82 else 0
	end
end

function UI._setLow(self, low)
	local h = self._hud
	if h.pulse then
		h.pulse:Cancel()
		h.pulse = nil
	end
	for _, cell in h.cells do
		cell.label.TextColor3 = if low then DANGER else INK
	end
	h.plateStroke.Color = if low then DANGER else INK
	h.alarm.BackgroundTransparency = 1
	if low then
		h.pulse = TweenService:Create(
			h.alarm,
			TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ BackgroundTransparency = 0.78 }
		)
		h.pulse:Play()
	end
end

-- Game over ---------------------------------------------------------------------------

function UI._buildGameOver(self)
	local g = {}
	self._over = g

	local root = new("Frame", { Name = "GameOver", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.gui })
	g.root = root
	g.wash = bleed(root, { Name = "Wash", BackgroundColor3 = PAPER, BackgroundTransparency = 0.35 })
	blueprintGrid(root, 12, 8, 0.9)

	local sheet = new("Frame", {
		Name = "Sheet",
		BackgroundColor3 = PAPER,
		BackgroundTransparency = 0.02,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.05, 0, 0.5, 0),
		Size = UDim2.fromOffset(540, 282),
		Parent = root,
	})
	fit(sheet)
	stroke(sheet, 1.5)
	cropMarks(sheet, 10, 5)
	notch(sheet, 16, 1, 1, INK)
	g.sheet = sheet

	local header = new("Frame", { Name = "Header", BackgroundColor3 = INK, Size = UDim2.new(1, 0, 0, 24), Parent = sheet })
	text({ Text = "04 / RUN REPORT", TextSize = 9, TextColor3 = PAPER, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.5, 0, 1, 0), Parent = header })
	setAccent(text({
		Text = "SHATTER RUN / GLASS LAB",
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.5, -10, 1, 0),
		Parent = header,
	}), "TextColor3")

	-- Left: the measurement
	text({ Text = "DISTANCE / METERS", TextSize = 9, TextColor3 = GREY, Position = UDim2.fromOffset(12, 32), Size = UDim2.fromOffset(200, 12), Parent = sheet })
	local numberRow = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 44), Size = UDim2.fromOffset(300, 60), Parent = sheet })
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = numberRow,
	})
	g.distance = text({
		Text = "0",
		Font = FONT_NUM,
		TextSize = 48,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 60),
		LayoutOrder = 1,
		Parent = numberRow,
	})
	text({ Text = "M", TextSize = 16, TextYAlignment = Enum.TextYAlignment.Bottom, Size = UDim2.fromOffset(16, 46), LayoutOrder = 2, Parent = numberRow })

	-- Ruler: scale from 0 to a bit past max(run, best) with markers for both.
	local ruler = new("Frame", { Name = "Ruler", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 118), Size = UDim2.fromOffset(300, 30), Parent = sheet })
	local tickBand = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 8), Size = UDim2.fromOffset(300, 12), Parent = ruler })
	rulerTicks(tickBand, 300, 12, 15, 5, 0.2)
	rule(tickBand, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })
	g.scaleLabels = {}
	for i = 0, 4 do
		g.scaleLabels[i] = text({
			Text = "0",
			TextSize = 7,
			TextColor3 = GREY,
			TextXAlignment = if i == 4 then Enum.TextXAlignment.Right elseif i == 0 then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(if i == 4 then 1 elseif i == 0 then 0 else 0.5, 0),
			Position = UDim2.new(i / 4, 0, 0, 21),
			Size = UDim2.fromOffset(50, 9),
			Parent = ruler,
		})
	end
	g.bestMarker = new("Frame", { BackgroundColor3 = INK, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromOffset(1, 20), Parent = ruler })
	text({ Text = "BEST", TextSize = 7, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(3, -2), Size = UDim2.fromOffset(30, 8), Parent = g.bestMarker })
	g.runMarker = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromOffset(3, 20), Parent = ruler })
	setAccent(g.runMarker, "BackgroundColor3")

	-- Data table
	local function dataRow(y, label, withGem)
		rule(sheet, { Position = UDim2.fromOffset(12, y), Size = UDim2.fromOffset(300, 1), BackgroundTransparency = 0.6 })
		local x = 12
		if withGem then
			gemIcon(sheet, 7, UDim2.fromOffset(17, y + 14))
			x = 26
		end
		text({ Text = label, TextSize = 9, Position = UDim2.fromOffset(x, y + 1), Size = UDim2.fromOffset(150, 26), Parent = sheet })
		return capText(text({
			Text = "0",
			Font = FONT_NUM,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.fromOffset(162, y + 4),
			Size = UDim2.fromOffset(150, 20),
			Parent = sheet,
		}), 13, 8)
	end
	g.best = dataRow(162, "BEST")
	g.gems = dataRow(190, "GEMS EARNED", true)
	rule(sheet, { Position = UDim2.fromOffset(12, 218), Size = UDim2.fromOffset(300, 1), BackgroundTransparency = 0.6 })

	-- XP tally: filled in when the server's RunSummary arrives.
	text({ Text = "XP EARNED", TextSize = 9, Position = UDim2.fromOffset(12, 219), Size = UDim2.fromOffset(100, 26), Parent = sheet })
	g.xpValue = capText(text({
		Text = "TALLYING...",
		Font = FONT_NUM,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(192, 223),
		Size = UDim2.fromOffset(120, 20),
		Parent = sheet,
	}), 13, 7)
	g.xpLevel = capText(text({ Text = "LV 01", Font = FONT_NUM, Position = UDim2.fromOffset(12, 246), Size = UDim2.fromOffset(44, 12), Parent = sheet }), 9, 6)
	local _, xpFill = meter(sheet, { Position = UDim2.fromOffset(60, 250), Size = UDim2.fromOffset(252, 5) })
	g.xpFill = xpFill
	g.xpProgress = text({ Text = "", TextSize = 8, TextColor3 = GREY, Position = UDim2.fromOffset(60, 258), Size = UDim2.fromOffset(130, 10), Parent = sheet })
	g.xpMissions = text({
		Text = "",
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(190, 258),
		Size = UDim2.fromOffset(122, 10),
		Parent = sheet,
	})
	rule(sheet, { Position = UDim2.fromOffset(12, 272), Size = UDim2.fromOffset(300, 1), BackgroundTransparency = 0.6 })
	g.levelStamp = stamp(sheet, "LEVEL UP", { Position = UDim2.fromOffset(148, 232), Size = UDim2.fromOffset(84, 22), Rotation = -6, Visible = false }, "accent")
	g.levelStampScale = new("UIScale", { Parent = g.levelStamp })

	-- NEW BEST rubber stamp
	local stamp = new("Frame", {
		Name = "NewBest",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(262, 52),
		Size = UDim2.fromOffset(112, 32),
		Rotation = -9,
		Visible = false,
		Parent = sheet,
	})
	setAccent(stamp, "BackgroundColor3")
	stroke(stamp, 2)
	rule(stamp, { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, 1) })
	rule(stamp, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 4, 1, -4), Size = UDim2.new(1, -8, 0, 1) })
	capText(text({ Text = "NEW BEST", Font = FONT_NUM, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = stamp }), 13, 8)
	g.stamp = stamp
	g.stampScale = new("UIScale", { Parent = stamp })

	-- Divider + right column: actions
	rule(sheet, { Position = UDim2.fromOffset(328, 34), Size = UDim2.new(0, 1, 1, -44), BackgroundTransparency = 0.4 })
	text({ Text = "05 / NEXT", TextSize = 9, TextColor3 = GREY, Position = UDim2.fromOffset(340, 32), Size = UDim2.fromOffset(188, 12), Parent = sheet })
	local actions = new("Frame", { Name = "Actions", BackgroundTransparency = 1, Position = UDim2.fromOffset(340, 48), Size = UDim2.fromOffset(188, 180), Parent = sheet })
	list(actions, 6)

	local revive = Config.Products.Revive
	local reviveGroup = new("Frame", { Name = "Revive", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 1, Visible = false, Parent = actions })
	g.reviveButton = hardButton(reviveGroup, {
		Name = "ReviveButton",
		Fill = "danger",
